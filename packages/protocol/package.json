{
  "name": "@vuagent/protocol",
  "version": "0.7.0-next.0",
  "description": "Shared contract, TypeBox schemas, and stream event protocols for Vuagent",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HelloTomBruce/vuagent.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://hellotombruce.github.io/vuagent",
  "bugs": {
    "url": "https://github.com/HelloTomBruce/vuagent/issues"
  },
  "keywords": [
    "vuagent",
    "agent",
    "protocol",
    "typebox",
    "schema",
    "stream-events",
    "sse",
    "hitl"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./stream": {
      "types": "./src/stream.ts",
      "default": "./src/stream.ts"
    },
    "./tools": {
      "types": "./src/tools.ts",
      "default": "./src/tools.ts"
    },
    "./system-tools": {
      "types": "./src/system-tools.ts",
      "default": "./src/system-tools.ts"
    },
    "./lifecycle": {
      "types": "./src/lifecycle.ts",
      "default": "./src/lifecycle.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./stream": {
        "types": "./dist/stream.d.ts",
        "default": "./dist/stream.js"
      },
      "./tools": {
        "types": "./dist/tools.d.ts",
        "default": "./dist/tools.js"
      },
      "./system-tools": {
        "types": "./dist/system-tools.d.ts",
        "default": "./dist/system-tools.js"
      },
      "./lifecycle": {
        "types": "./dist/lifecycle.d.ts",
        "default": "./dist/lifecycle.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.48"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
