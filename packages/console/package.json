{
  "name": "@vuagent/console-app",
  "version": "0.6.0",
  "private": true,
  "description": "Vuagent Console 应用源码库（Console 组件 + composables + api client）；生产壳 apps/console 与开发壳 apps/playground 共用",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
