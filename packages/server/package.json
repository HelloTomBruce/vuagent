{
  "name": "@vuagent/server",
  "version": "0.7.0",
  "description": "Standard Agent Harness Server with ReAct loop, HITL interrupt, tool sandbox, state checkpoints, progressive streaming and telemetry",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HelloTomBruce/vuagent.git",
    "directory": "packages/server"
  },
  "homepage": "https://hellotombruce.github.io/vuagent",
  "bugs": {
    "url": "https://github.com/HelloTomBruce/vuagent/issues"
  },
  "keywords": [
    "vuagent",
    "agent",
    "harness",
    "react-loop",
    "hitl",
    "server",
    "sse",
    "ai"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:e2e:approval": "tsx scripts/e2e-approval-envelope.mts",
    "typecheck": "tsc --noEmit",
    "verify:redis": "tsx scripts/verify-redis.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@sinclair/typebox": "^0.34.48",
    "@vuagent/protocol": "workspace:*",
    "gpt-tokenizer": "^4.1.2",
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "ioredis": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  }
}
