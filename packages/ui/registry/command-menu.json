      "type": "registry:ui",
      "target": "components/ui/command-menu/types.ts",
      "content": "/** VaCommandMenu 的类型定义 */\n\nexport interface CommandItem {\n  id: string;\n  /** 菜单项文案 */\n  label: string;\n  /** 分组标题；相同 group 相邻渲染为一组 */\n  group?: string;\n  /** 右侧提示（快捷键文案，如 \"⌘K\"） */\n  hint?: string;\n  /** 过滤用关键词（与 label 一起参与匹配） */\n  keywords?: string;\n  disabled?: boolean;\n  /** 危险操作（红色文案） */\n  danger?: boolean;\n}\n\nexport interface CommandMenuProps {\n  commands: CommandItem[];\n  /** 受控开关（配合 @update:open 实现 v-model:open） */\n  open?: boolean;\n  /** 非受控初始开（仅未绑定 open 时生效） */\n  defaultOpen?: boolean;\n  /** 输入框占位 */\n  placeholder?: string;\n  /** 触发按钮上展示的快捷键提示（仅文案，不自动注册全局热键） */\n  hotkey?: string;\n  /** 触发按钮文案，默认 \"命令\" */\n  triggerLabel?: string;\n  /** 隐藏触发按钮（仅保留 ⌘K 等外部快捷键唤起；按钮不入 DOM，避免留下不可见可聚焦项） */\n  hideTrigger?: boolean;\n  /** 空结果文案 */\n  emptyLabel?: string;\n  /** 面板最大高度 px，默认 380 */\n  maxHeight?: number;\n}\n\nexport interface CommandMenuEvents {\n  \"update:open\": [v: boolean];\n  /** 键盘或点击选中某项（disabled 项不可选中） */\n  select: [item: CommandItem];\n}\n"
    },
    {
      "path": "components/ui/command-menu/useCommandMenu.ts",
      "type": "registry:ui",
      "target": "components/ui/command-menu/useCommandMenu.ts",
      "content": "import { computed, nextTick, ref, watch, type Ref } from \"vue\";\nimport type { CommandItem, CommandMenuProps } from \"./types\";\n\n/**\n * VaCommandMenu 的过滤 + 键盘导航 + 开关状态（布尔哨兵：open !== undefined 判定受控）。\n * SSR 安全：document 操作仅在 open 变 true 后执行（必然在客户端）。\n */\nexport function useCommandMenu(\n  props: CommandMenuProps,\n  inputEl: Ref<HTMLInputElement | null>,\n  panelEl: Ref<HTMLElement | null>,\n  emit: { \"update:open\": (v: boolean) => void; select: (item: CommandItem) => void },\n) {\n  /* ---------- 开关：受控优先，touched 哨兵回落 defaultOpen ---------- */\n  const touched = ref(false);\n  const innerOpen = ref(props.defaultOpen ?? false);\n  const isOpen = computed(() => (props.open !== undefined || touched.value ? props.open : innerOpen.value));\n\n  let lastFocus: HTMLElement | null = null;\n\n  function openMenu() {\n    touched.value = true;\n    innerOpen.value = true;\n    emit[\"update:open\"](true);\n  }\n\n  function closeMenu() {\n    touched.value = true;\n    innerOpen.value = false;\n    emit[\"update:open\"](false);\n  }\n\n  // 打开：聚焦输入、记录来源焦点；关闭：恢复焦点\n  watch(isOpen, (v) => {\n    if (v) {\n      if (typeof document !== \"undefined\") lastFocus = document.activeElement as HTMLElement | null;\n      query.value = \"\";\n      activeIdx.value = 0;\n      nextTick(() => inputEl.value?.focus());\n    } else if (lastFocus && typeof lastFocus.focus === \"function\") {\n      lastFocus.focus();\n      lastFocus = null;\n    }\n  });\n\n  /* ---------- 过滤：label/keywords 子串匹配（大小写不敏感） ---------- */\n  const query = ref(\"\");\n  const filtered = computed<CommandItem[]>(() => {\n    const q = query.value.trim().toLowerCase();\n    if (!q) return props.commands;\n    return props.commands.filter(\n      (c) => c.label.toLowerCase().includes(q) || c.keywords?.toLowerCase().includes(q),\n    );\n  });\n\n  /** 渲染分组：[{ group, items }]（group 为 undefined 时归\"常用\"） */\n  const groups = computed(() => {\n    const out: Array<{ group: string | undefined; items: CommandItem[] }> = [];\n    for (const c of filtered.value) {\n      const last = out[out.length - 1];\n      if (last && last.group === c.group) last.items.push(c);\n      else out.push({ group: c.group, items: [c] });\n    }\n    return out;\n  });\n\n  /** 扁平化（含禁用项——占据导航位置但 Enter 无效） */\n  const flat = computed(() => groups.value.flatMap((g) => g.items));\n  const activeIdx = ref(0);\n\n  // 过滤结果变化时收拢高亮\n  watch(filtered, () => {\n    activeIdx.value = 0;\n  });\n\n  function move(delta: number) {\n    const len = flat.value.length;\n    if (!len) return;\n    activeIdx.value = (activeIdx.value + delta + len) % len;\n    nextTick(() => {\n      const el = panelEl.value?.querySelector<HTMLElement>(\"[data-active='true']\");\n      el?.scrollIntoView({ block: \"nearest\" });\n    });\n  }\n\n  function pick(item: CommandItem) {\n    if (item.disabled) return;\n    emit.select(item);\n    closeMenu();\n  }\n\n  /** 输入框键盘：↑↓ 高亮、Enter 选中、Esc 关闭 */\n  function onInputKeydown(e: KeyboardEvent) {\n    if (e.key === \"ArrowDown\") {\n      e.preventDefault();\n      move(1);\n    } else if (e.key === \"ArrowUp\") {\n      e.preventDefault();\n      move(-1);\n    } else if (e.key === \"Enter\") {\n      e.preventDefault();\n      const item = flat.value[activeIdx.value];\n      if (item) pick(item);\n    } else if (e.key === \"Escape\") {\n      e.preventDefault();\n      closeMenu();\n    }\n  }\n\n  /** 面板内 Tab 圈进（输入框 + 面板本身两个焦点位） */\n  function trapTab(e: KeyboardEvent) {\n    if (e.key !== \"Tab\") return;\n    e.preventDefault();\n    inputEl.value?.focus();\n  }\n\n  /** 点击遮罩关闭 */\n  function onBackdropClick() {\n    closeMenu();\n  }\n\n  return {\n    isOpen,\n    openMenu,\n    closeMenu,\n    query,\n    filtered,\n    flat,\n    groups,\n    activeIdx,\n    onInputKeydown,\n    trapTab,\n    onBackdropClick,\n    pick,\n  };\n}\n"
    }
  ]
