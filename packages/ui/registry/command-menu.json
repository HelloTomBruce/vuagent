{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "command-menu",
  "title": "Command Menu",
  "description": "⌘K 命令面板：触发按钮 + 居中对话框，子串过滤、分组渲染、↑↓ 循环高亮、Enter 选中、Esc/遮罩关闭、焦点圈进与恢复。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `commands` (CommandItem[]，默认 -)：id/label/group/hint/keywords/danger\n- `v-model:open` (boolean，默认 false)：受控开关（含 defaultOpen 哨兵回落）\n- `hotkey / triggerLabel` (string，默认 \"⌘K\" / \"命令\")：触发按钮提示\n- `@select` (-，默认 -)：选中命令项",
  "files": [
    {
      "path": "components/ui/command-menu/VaCommandMenu.vue",
      "type": "registry:ui",
      "target": "components/ui/command-menu/VaCommandMenu.vue",
      "content": "<script setup lang=\"ts\">\nimport { useTemplateRef } from \"vue\";\nimport type { CommandMenuEvents, CommandMenuProps } from \"./types\";\nimport { useCommandMenu } from \"./useCommandMenu\";\n\nconst props = defineProps<CommandMenuProps>();\n\nconst emit = defineEmits<CommandMenuEvents>();\n\nconst inputEl = useTemplateRef<HTMLInputElement>(\"input\");\nconst panelEl = useTemplateRef<HTMLElement>(\"panel\");\n\nconst {\n  isOpen,\n  openMenu,\n  query,\n  flat,\n  groups,\n  activeIdx,\n  onInputKeydown,\n  trapTab,\n  onBackdropClick,\n  pick,\n} = useCommandMenu(props, inputEl, panelEl, {\n  \"update:open\": (v) => emit(\"update:open\", v),\n  select: (item) => emit(\"select\", item),\n});\n\nfunction onTriggerKeydown(e: KeyboardEvent) {\n  if (e.key === \"Enter\" || e.key === \" \") {\n    e.preventDefault();\n    openMenu();\n  }\n}\n</script>\n\n<template>\n  <span class=\"va-cmd\">\n    <button\n      v-if=\"!props.hideTrigger\"\n      class=\"va-cmd__trigger\"\n      type=\"button\"\n      :aria-expanded=\"isOpen\"\n      aria-haspopup=\"dialog\"\n      @click=\"openMenu\"\n      @keydown=\"onTriggerKeydown\"\n    >\n      <span class=\"va-cmd__icon\" aria-hidden=\"true\">⌘</span>\n      {{ props.triggerLabel ?? \"命令\" }}\n      <kbd v-if=\"props.hotkey\" class=\"va-cmd__kbd\">{{ props.hotkey }}</kbd>\n    </button>\n\n    <Teleport to=\"body\">\n      <div\n        v-if=\"isOpen\"\n        class=\"va-cmd__backdrop\"\n        @click=\"onBackdropClick\"\n        @keydown=\"trapTab\"\n      />\n      <div\n        v-if=\"isOpen\"\n        ref=\"panel\"\n        class=\"va-cmd__panel\"\n        role=\"dialog\"\n        aria-modal=\"true\"\n        :aria-label=\"'命令面板'\"\n        :style=\"props.maxHeight ? { maxHeight: `${props.maxHeight}px` } : undefined\"\n      >\n        <div class=\"va-cmd__search\">\n          <span class=\"va-cmd__mag\" aria-hidden=\"true\">⌕</span>\n          <input\n            ref=\"input\"\n            v-model=\"query\"\n            class=\"va-cmd__input\"\n            type=\"text\"\n            role=\"combobox\"\n            aria-expanded=\"true\"\n            aria-controls=\"va-cmd-list\"\n            :aria-activedescendant=\"flat[activeIdx] ? `va-cmd-opt-${flat[activeIdx]!.id}` : undefined\"\n            :placeholder=\"props.placeholder ?? '输入命令或搜索…'\"\n            aria-label=\"搜索命令\"\n            autocomplete=\"off\"\n            @keydown=\"onInputKeydown\"\n          >\n          <kbd class=\"va-cmd__kbd va-cmd__kbd--fixed\">esc</kbd>\n        </div>\n\n        <div id=\"va-cmd-list\" class=\"va-cmd__list\" role=\"listbox\" aria-label=\"命令列表\">\n          <p v-if=\"!flat.length\" class=\"va-cmd__empty va-fade-in\">{{ props.emptyLabel ?? \"没有匹配的命令\" }}</p>\n          <template v-for=\"g in groups\" :key=\"g.group ?? ''\">\n            <div v-if=\"g.group\" class=\"va-cmd__group\" aria-hidden=\"true\">{{ g.group }}</div>\n            <button\n              v-for=\"item in g.items\"\n              :id=\"`va-cmd-opt-${item.id}`\"\n              :key=\"item.id\"\n              class=\"va-cmd__item\"\n              type=\"button\"\n              role=\"option\"\n              :aria-selected=\"flat[activeIdx]?.id === item.id\"\n              :aria-disabled=\"item.disabled\"\n              :data-active=\"flat[activeIdx]?.id === item.id\"\n              :data-danger=\"item.danger\"\n              :disabled=\"item.disabled\"\n              @click=\"pick(item)\"\n              @mousemove=\"activeIdx = flat.findIndex((x) => x.id === item.id)\"\n            >\n              <span class=\"va-cmd__label\">{{ item.label }}</span>\n              <kbd v-if=\"item.hint\" class=\"va-cmd__kbd\">{{ item.hint }}</kbd>\n            </button>\n          </template>\n        </div>\n      </div>\n    </Teleport>\n  </span>\n</template>\n\n<style>\n/* VaCommandMenu — ⌘K 命令面板 */\n\n.va-cmd { display: inline-flex; }\n\n.va-cmd__trigger {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--va-s3, 8px);\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-s, 8px);\n  background: var(--va-card, #ffffff);\n  color: var(--va-ink-2, #43413c);\n  font-size: var(--va-fs-md, 13px);\n  padding: var(--va-s3h, 6px) 12px;\n  cursor: pointer;\n  transition: border-color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-cmd__trigger:hover { border-color: var(--va-edge-strong, rgba(26, 25, 23, 0.22)); }\n.va-cmd__trigger:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: 1px; }\n.va-cmd__trigger[aria-expanded=\"true\"] { border-color: var(--va-accent, #c2410c); color: var(--va-accent, #c2410c); }\n\n.va-cmd__icon { color: var(--va-muted, #6f6d66); font-size: var(--va-fs-lg, 14px); }\n\n.va-cmd__kbd {\n  font-family: var(--va-font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);\n  font-size: var(--va-fs-xs, 11px);\n  color: var(--va-muted, #6f6d66);\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: 5px;\n  padding: 1px 5px;\n  background: var(--va-bg-subtle, #efede7);\n}\n\n.va-cmd__backdrop {\n  position: fixed;\n  inset: 0;\n  background: color-mix(in srgb, var(--va-ink, #1a1917) 24%, transparent);\n  backdrop-filter: blur(var(--va-blur-1, 2px));\n  z-index: 60;\n}\n\n.va-cmd__panel {\n  position: fixed;\n  top: 14vh;\n  left: 50%;\n  transform: translateX(-50%);\n  width: min(560px, calc(100vw - 32px));\n  max-height: 380px;\n  display: flex;\n  flex-direction: column;\n  border: 1px solid var(--va-edge-strong, rgba(26, 25, 23, 0.22));\n  border-radius: var(--va-radius-l, 16px);\n  background: var(--va-card, #ffffff);\n  box-shadow: var(--va-shadow-3, 0 12px 32px rgba(26, 25, 23, 0.12));\n  overflow: hidden;\n  z-index: 61;\n  animation: va-cmd-in var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n@keyframes va-cmd-in {\n  from { opacity: 0; transform: translateX(-50%) translateY(-6px) scale(0.98); }\n}\n\n.va-cmd__search {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3, 8px);\n  padding: var(--va-s3, 8px) var(--va-s4, 12px);\n  border-bottom: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n}\n\n.va-cmd__mag { color: var(--va-muted, #6f6d66); font-size: var(--va-fs-lg, 14px); }\n\n.va-cmd__input {\n  flex: 1;\n  border: 0;\n  background: transparent;\n  color: var(--va-ink, #1a1917);\n  font: inherit;\n  font-size: var(--va-fs-lg, 14px);\n}\n\n.va-cmd__input:focus { outline: none; }\n\n/* 焦点补偿：input 裸 outline 由容器统一呈现 focus ring（键盘可达性） */\n.va-cmd__panel:focus-within {\n  border-color: var(--va-accent, #c2410c);\n  box-shadow: 0 0 0 3px var(--va-accent-soft, rgba(194, 65, 12, 0.1));\n}\n.va-cmd__panel:focus-within .va-cmd__search {\n  border-bottom-color: color-mix(in srgb, var(--va-accent, #c2410c) 35%, transparent);\n}\n\n.va-cmd__kbd--fixed { flex: none; }\n\n.va-cmd__list {\n  overflow-y: auto;\n  padding: var(--va-s2, 4px);\n  overscroll-behavior: contain;\n}\n\n.va-cmd__group {\n  padding: var(--va-s3, 8px) var(--va-s3, 8px) var(--va-s2, 4px);\n  font-size: var(--va-fs-xs, 11px);\n  font-weight: var(--va-fw-semibold, 600);\n  letter-spacing: var(--va-tracking-wide, 0.04em);\n  color: var(--va-muted, #6f6d66);\n}\n\n.va-cmd__item {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--va-s4, 12px);\n  width: 100%;\n  border: 0;\n  border-radius: var(--va-radius-s, 8px);\n  background: transparent;\n  color: var(--va-ink-2, #43413c);\n  font-size: var(--va-fs-lg, 14px);\n  padding: 8px var(--va-s3, 8px);\n  cursor: pointer;\n  text-align: left;\n}\n\n.va-cmd__item[data-active=\"true\"] { background: var(--va-accent-soft, rgba(194, 65, 12, 0.1)); color: var(--va-ink, #1a1917); }\n.va-cmd__item[data-danger=\"true\"] { color: var(--va-danger, #d5453c); }\n.va-cmd__item[data-danger=\"true\"][data-active=\"true\"] { background: color-mix(in srgb, var(--va-danger, #d5453c) 12%, transparent); }\n/* 按压口径（选项行）：在高亮面上朝 ink 混 15% 再加深（highlighted 保持色相） */\n.va-cmd__item:active:not(:disabled) { background: color-mix(in srgb, var(--va-accent-soft, rgba(194, 65, 12, 0.1)) 85%, var(--va-ink, #1a1917)); }\n.va-cmd__item[data-danger=\"true\"]:active:not(:disabled) { background: color-mix(in srgb, var(--va-danger, #d5453c) 18%, transparent); }\n.va-cmd__item:disabled { opacity: 0.4; cursor: default; }\n.va-cmd__item:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: -2px; }\n\n.va-cmd__label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n\n.va-cmd__empty {\n  margin: 0;\n  padding: var(--va-s6, 24px) var(--va-s4, 12px);\n  text-align: center;\n  font-size: var(--va-fs-md, 13px);\n  color: var(--va-muted, #6f6d66);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-cmd__panel { animation: none; }\n  .va-cmd__trigger { transition: none; }\n}\n\n/* 动效工具类（自动附带，源码中来自全局 motion.css） */\n/* ============================================================\n   共享动效工具类 —— 进出场/交叉淡入的统一协议（TASK-102 动效基建）。\n   组件不逐个发明入场曲线：统一消费 --va-dur-in/--va-dur-out 骨架时长与\n   --va-dist-* 位移档；每条声明自带字面 fallback（registry 单文件拷贝分发\n   要求，与 tokens.css 门禁一致）。\n\n   接入方式二选一：\n   1. Vue <Transition>：\n      <Transition enter-active-class=\"va-enter-up\" leave-active-class=\"va-exit-up\">\n      动画 fill-mode 为 both（延迟期间保持首帧、播完停在终态），\n      无需再配 enter-from-class / leave-to-class；\n   2. 类切换重挂载：骨架 → 内容换节点时给新节点挂 .va-crossfade（纯淡入），\n      离场节点挂 .va-exit-*（更短更快）。\n\n   列表错峰：v-for 子项 :style=\"useStagger().delayStyle(i)\" 配合 .va-enter-*\n   动画类使用（animation-delay 由 composable 编排——.va-enter-* 为 CSS animation，\n   transition-delay 对其零作用，见 composables/useStagger.ts）。\n   ============================================================ */\n\n/* 入场：上浮（自下方 --va-dist-m 浮起） */\n@keyframes va-motion-in-up {\n  from { opacity: 0; transform: translateY(var(--va-dist-m, 8px)); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* 入场：左滑（自左侧 --va-dist-m 滑入） */\n@keyframes va-motion-in-left {\n  from { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n  to { opacity: 1; transform: translateX(0); }\n}\n\n/* 入场：缩放（96% 起放大至原尺寸） */\n@keyframes va-motion-in-scale {\n  from { opacity: 0; transform: scale(0.96); }\n  to { opacity: 1; transform: scale(1); }\n}\n\n/* 离场：与入场互逆（向上/向左飘出、缩回）；时长/曲线由工具类映射 --va-dur-out 骨架 */\n@keyframes va-motion-out-up {\n  from { opacity: 1; transform: translateY(0); }\n  to { opacity: 0; transform: translateY(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-left {\n  from { opacity: 1; transform: translateX(0); }\n  to { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-scale {\n  from { opacity: 1; transform: scale(1); }\n  to { opacity: 0; transform: scale(0.96); }\n}\n\n/* 交叉淡入/淡出（.va-crossfade 骨架→内容交换专用，无位移，避免占位跳变叠加） */\n@keyframes va-motion-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes va-motion-fade-out {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n/* ---- 工具类：入场走 --va-dur-in + ease-out-quart，离场走 --va-dur-out + ease-in-quad ---- */\n\n.va-enter-up {\n  animation: va-motion-in-up var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-left {\n  animation: va-motion-in-left var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-scale {\n  animation: va-motion-in-scale var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-exit-up {\n  animation: va-motion-out-up var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-left {\n  animation: va-motion-out-left var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-scale {\n  animation: va-motion-out-scale var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n/* 骨架 → 内容交叉过渡：新内容纯淡入 */\n.va-crossfade {\n  animation: va-motion-fade-in var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* 空态/轻量状态渐入（TASK-106 弱化档）：仅 opacity、时长走 --va-dur-2，\n   供列表空态提示与一次性状态块使用（空态清单见 TASK-106 报告）。\n   纯 opacity 即动效分频策略的降级终点形态，reduced-motion 下保持原样即可。 */\n.va-fade-in {\n  animation: va-motion-fade-in var(--va-dur-2, 200ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* ---- 静态光斑基类（TASK-105，决策 5「追光」路线基建）----\n   pointer 坐标由 composables/useSpotlight.ts 以 rAF 节流写入 --va-spot-x/y\n   （元素内百分比，光斑数学在 composable 内可单测）；本类只负责 radial 光斑\n   绘制与显隐（:hover 点亮，无 3D 倾斜， glare 数学对齐 VaTiltCard）。\n   --va-spot-* 为 L3 组件钩子口径（宿主可覆盖尺寸/颜色），不进 tokens.css。\n   双降级对齐 VaTiltCard glare：hover: none（触屏）与 reduced-motion 不绘制。 */\n.va-spotlight { position: relative; }\n\n/* ::after 承载光斑（避开组件自身 ::before 用途）；inset 0 + border-radius inherit\n   使光斑天然裁剪在宿主圆角内，无需 overflow: hidden。\n   注意：此 ::after radial 与 components/spotlight-card/VaSpotlightCard.css 的\n   .va-spot-card--spot::after 为 registry 单文件自含有意复制，改动需两处同步。 */\n.va-spotlight::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n  background: radial-gradient(\n    var(--va-spot-size, 240px) circle at var(--va-spot-x, 50%) var(--va-spot-y, 50%),\n    var(--va-spot-color, rgba(255, 255, 255, 0.14)),\n    transparent 65%\n  );\n}\n\n.va-spotlight:hover::after { opacity: 1; }\n\n@media (hover: none) {\n  .va-spotlight::after { display: none; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-spotlight::after { display: none; }\n}\n\n/* ---- 复制反馈标准（TASK-106）：copy→check 交叉过渡 ----\n   容器 .va-copy 为 inline-grid 双内容同格堆叠（格子宽取较宽子项，切换零跳动）：\n   __idle = copy 态内容（图标/文字），__done = check 态内容。\n   copied 置真挂 .va-copy--done：check 以 ease-spring 微弹入场（进入 done 态时\n   transform 的目标态时序换成 --va-ease-spring → 过冲回弹），交叉时长统一 --va-dur-1。\n   消费方：terminal-log（行复制）、code-diff（复制按钮）、message-actions（复制图标）。 */\n.va-copy { display: inline-grid; place-items: center; }\n\n.va-copy__idle,\n.va-copy__done {\n  grid-area: 1 / 1;\n  transition: opacity var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-copy__idle { opacity: 1; transform: scale(1); }\n.va-copy__done { opacity: 0; transform: scale(0.6); }\n\n.va-copy--done .va-copy__done {\n  opacity: 1;\n  transform: scale(1);\n  /* 时序按 transition 属性顺序映射：opacity 仍 ease，transform 换 ease-spring 微弹 */\n  transition-timing-function: var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), var(--va-ease-spring, cubic-bezier(0.34, 1.56, 0.64, 1));\n}\n\n.va-copy--done .va-copy__idle { opacity: 0; transform: scale(0.6); }\n\n@media (prefers-reduced-motion: reduce) {\n  /* 交叉过渡瞬时完成（无位移动画），copied 状态可感知性不受影响 */\n  .va-copy__idle,\n  .va-copy__done { transition: none; }\n}\n\n/* ---- 错误反馈标准（校验失败横向微振）：目标元素挂 .va-shake 播一次 ±3px 微振 ----\n   时长 --va-dur-2 × 2（两拍四峰，克制的「摇头」量级，rubric 校验失败口径）；\n   重复触发需先移除类、强制 reflow 再挂回（封装见 composables/useShake.ts）。\n   reduced-motion 降级为不播：错误状态的可感知性由错误样式本身（描边/文案）承担，\n   动效只做注意力引导——符合头注释「功能动画降级保留状态可感知」的分频策略。\n   消费方：VaStepperForm / VaOtpInput 经 useShake() 程序化触发（defineExpose shake()）；\n   宿主自绘表单可直接挂类。 */\n@keyframes va-motion-shake {\n  20% { transform: translateX(-3px); }\n  40% { transform: translateX(3px); }\n  60% { transform: translateX(-2px); }\n  80% { transform: translateX(2px); }\n}\n\n.va-shake {\n  animation: va-motion-shake calc(var(--va-dur-2, 200ms) * 2) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-shake { animation: none; }\n}\n\n/* ---- 动效分频（对齐 tokens.css 头注释策略）：\n   功能动画降级为纯 opacity——进/出场整体换成 fade keyframes，\n   位移/缩放不再出现（animation-name 顶替，时长/缓动沿用上面的声明）。 */\n@media (prefers-reduced-motion: reduce) {\n  .va-enter-up,\n  .va-enter-left,\n  .va-enter-scale,\n  .va-crossfade {\n    animation-name: va-motion-fade-in;\n  }\n\n  .va-exit-up,\n  .va-exit-left,\n  .va-exit-scale {\n    animation-name: va-motion-fade-out;\n  }\n}\n</style>\n"
    },
