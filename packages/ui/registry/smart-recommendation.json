{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "smart-recommendation",
  "title": "Smart Recommendation",
  "description": "agent 建议卡：标题 + 理由 + 收益标签 + 主/次操作按钮，可关闭忽略。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `title / description / impact` (string，默认 -)：建议内容与收益标签\n- `actions` (RecommendationAction[]，默认 -)：id/label/primary\n- `@action / @dismiss` (-，默认 -)：操作 / 忽略",
  "files": [
    {
      "path": "components/ui/smart-recommendation/VaSmartRecommendation.vue",
      "type": "registry:ui",
      "target": "components/ui/smart-recommendation/VaSmartRecommendation.vue",
      "content": "<script setup lang=\"ts\">\nimport type { SmartRecommendationEvents, SmartRecommendationProps } from \"./types\";\n\nconst props = withDefaults(defineProps<SmartRecommendationProps>(), { dismissible: true });\n\nconst emit = defineEmits<SmartRecommendationEvents>();\n</script>\n\n<template>\n  <aside class=\"va-rec\" role=\"note\" aria-label=\"agent 建议\">\n    <span class=\"va-rec__spark\" aria-hidden=\"true\">✦</span>\n    <div class=\"va-rec__main\">\n      <header class=\"va-rec__head\">\n        <span class=\"va-rec__title\">{{ props.title }}</span>\n        <span v-if=\"props.impact\" class=\"va-rec__impact\">{{ props.impact }}</span>\n      </header>\n      <p v-if=\"props.description\" class=\"va-rec__desc\">{{ props.description }}</p>\n      <footer class=\"va-rec__ops\">\n        <button\n          v-for=\"a in props.actions\"\n          :key=\"a.id\"\n          class=\"va-rec__btn\"\n          type=\"button\"\n          :data-primary=\"a.primary ?? false\"\n          @click=\"emit('action', a.id)\"\n        >{{ a.label }}</button>\n      </footer>\n    </div>\n    <button\n      v-if=\"props.dismissible\"\n      class=\"va-rec__close\"\n      type=\"button\"\n      :aria-label=\"props.dismissLabel ?? '忽略此建议'\"\n      @click=\"emit('dismiss')\"\n    >×</button>\n  </aside>\n</template>\n\n<style>\n/* VaSmartRecommendation — agent 建议卡 */\n\n.va-rec {\n  display: flex;\n  align-items: flex-start;\n  gap: var(--va-s4);\n  border: 1px solid color-mix(in srgb, var(--va-info) 30%, transparent);\n  border-radius: var(--va-radius-m);\n  background: color-mix(in srgb, var(--va-info) 5%, var(--va-card));\n  padding: var(--va-s4) var(--va-s5);\n}\n\n.va-rec__spark {\n  flex: none;\n  width: 28px;\n  height: 28px;\n  border-radius: 50%;\n  background: color-mix(in srgb, var(--va-info) 14%, transparent);\n  color: var(--va-info);\n  font-size: 14px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.va-rec__main { flex: 1; min-width: 0; }\n\n.va-rec__head {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3);\n  flex-wrap: wrap;\n}\n\n.va-rec__title { font-size: 13.5px; font-weight: 700; color: var(--va-ink); }\n\n.va-rec__impact {\n  font-size: 11px;\n  font-weight: 600;\n  padding: 1px 8px;\n  border-radius: var(--va-radius-pill);\n  background: color-mix(in srgb, var(--va-success) 14%, transparent);\n  color: var(--va-success);\n}\n\n.va-rec__desc {\n  margin: 4px 0 0;\n  font-size: 12.5px;\n  line-height: 1.6;\n  color: var(--va-ink-2);\n}\n\n.va-rec__ops {\n  display: flex;\n  gap: var(--va-s2);\n  margin-top: var(--va-s4);\n}\n\n.va-rec__btn {\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-card);\n  color: var(--va-ink-2);\n  font-size: 12.5px;\n  padding: 4px 12px;\n  cursor: pointer;\n}\n\n.va-rec__btn:hover { border-color: var(--va-edge-strong); }\n.va-rec__btn:focus-visible { outline: 2px solid var(--va-accent); outline-offset: 1px; }\n\n.va-rec__btn[data-primary=\"true\"] {\n  background: var(--va-info);\n  border-color: var(--va-info);\n  color: #fff;\n  font-weight: 600;\n}\n\n.va-rec__close {\n  flex: none;\n  border: 0;\n  background: transparent;\n  color: var(--va-muted);\n  font-size: 16px;\n  line-height: 1;\n  width: 24px;\n  height: 24px;\n  cursor: pointer;\n  border-radius: var(--va-radius-s);\n}\n\n.va-rec__close:hover { color: var(--va-ink); background: var(--va-bg-subtle); }\n.va-rec__close:focus-visible { outline: 2px solid var(--va-accent); }\n</style>\n"
    },
    {
      "path": "components/ui/smart-recommendation/types.ts",
      "type": "registry:ui",
      "target": "components/ui/smart-recommendation/types.ts",
      "content": "/** VaSmartRecommendation 的类型定义 */\n\nexport interface RecommendationAction {\n  id: string;\n  label: string;\n  /** 主要操作（accent 实底）；默认次要样式 */\n  primary?: boolean;\n}\n\nexport interface SmartRecommendationProps {\n  /** 建议标题 */\n  title: string;\n  /** 建议理由/说明 */\n  description?: string;\n  actions: RecommendationAction[];\n  /** 预期收益标签（如 \"预计省 30% tokens\"） */\n  impact?: string;\n  /** 右上角关闭 ×；false 时只显示 actions */\n  dismissible?: boolean;\n  /** 关闭按钮 aria-label */\n  dismissLabel?: string;\n}\n\nexport interface SmartRecommendationEvents {\n  /** 点击某个操作（携带 action id） */\n  action: [id: string];\n  /** 点击关闭 */\n  dismiss: [];\n}\n"
    }
  ]
}
