{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "workspace-blocks",
  "title": "Pricing Plans / AI Workspace",
  "description": "Blocks 两件：PricingPlans 定价卡组（推荐/当前态 + 特性清单 + CTA）；AIWorkspace 文件栏 + 预览区双栏工作块（M/A/D 徽标、选中联动、作用域插槽传当前文件）。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `tiers` (PricingTier[]，默认 -)：PricingPlans：套餐档\n- `@choose` (-，默认 -)：PricingPlans：选择套餐\n- `files / v-model:selected` (WorkspaceFile[] / string，默认 - / 首个)：Workspace：文件与选中\n- `#default（作用域 file）` (-，默认 -)：Workspace：预览区内容",
  "files": [
    {
      "path": "components/ui/workspace-blocks/VaAIWorkspace.vue",
      "type": "registry:ui",
      "target": "components/ui/workspace-blocks/VaAIWorkspace.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, ref } from \"vue\";\nimport type { AIWorkspaceEvents, AIWorkspaceProps } from \"./types\";\nimport type { WorkspaceFile } from \"./types\";\nimport { FILE_STATUS_LABEL } from \"../file-tree/types\";\n\nconst props = defineProps<AIWorkspaceProps>();\n\nconst emit = defineEmits<AIWorkspaceEvents>();\n\nconst touched = ref(false);\nconst inner = ref<string | undefined>(props.defaultSelected ?? props.files[0]?.id);\nconst selectedId = computed(() =>\n  props.selected !== undefined || touched.value ? props.selected : inner.value,\n);\n\nfunction open(f: WorkspaceFile) {\n  touched.value = true;\n  inner.value = f.id;\n  emit(\"update:selected\", f.id);\n  emit(\"openFile\", f);\n}\n\nconst current = computed(() => props.files.find((f) => f.id === selectedId.value));\n</script>\n\n<template>\n  <div class=\"va-ws\">\n    <aside class=\"va-ws__files\" :aria-label=\"props.filesLabel ?? '工作区文件'\">\n      <h3 class=\"va-ws__label\">{{ props.filesLabel ?? \"工作区文件\" }}</h3>\n      <button\n        v-for=\"f in props.files\"\n        :key=\"f.id\"\n        class=\"va-ws__file\"\n        type=\"button\"\n        :data-selected=\"f.id === selectedId\"\n        @click=\"open(f)\"\n      >\n        <span v-if=\"f.status\" class=\"va-ws__status\" :data-status=\"f.status\">{{ FILE_STATUS_LABEL[f.status] }}</span>\n        <span class=\"va-ws__name\">{{ f.name }}</span>\n      </button>\n      <p v-if=\"!props.files.length\" class=\"va-ws__none\">没有文件</p>\n    </aside>\n\n    <section class=\"va-ws__preview\" :aria-label=\"props.previewLabel ?? current?.name ?? '预览'\">\n      <h3 class=\"va-ws__label\">{{ props.previewLabel ?? current?.name ?? \"预览\" }}</h3>\n      <div class=\"va-ws__body\">\n        <slot :file=\"current\" />\n      </div>\n    </section>\n  </div>\n</template>\n\n<style>\n/* VaAIWorkspace — 文件栏 + 预览区双栏工作块 */\n\n.va-ws {\n  display: grid;\n  grid-template-columns: minmax(200px, 260px) 1fr;\n  gap: var(--va-s4);\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-l);\n  background: var(--va-card);\n  overflow: hidden;\n  min-height: 280px;\n}\n\n.va-ws__files {\n  border-right: 1px solid var(--va-edge);\n  background: var(--va-bg-subtle);\n  padding: var(--va-s4);\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  overflow-y: auto;\n}\n\n.va-ws__preview {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n}\n\n.va-ws__label {\n  margin: 0 0 var(--va-s3);\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  color: var(--va-muted);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.va-ws__preview .va-ws__label { padding: var(--va-s4) var(--va-s5) 0; }\n\n.va-ws__file {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3);\n  border: 0;\n  border-radius: var(--va-radius-s);\n  background: transparent;\n  padding: 5px var(--va-s3);\n  cursor: pointer;\n  text-align: left;\n  font: inherit;\n}\n\n.va-ws__file:hover { background: var(--va-card); }\n.va-ws__file:focus-visible { outline: 2px solid var(--va-accent); outline-offset: -2px; }\n.va-ws__file[data-selected=\"true\"] { background: var(--va-card); box-shadow: inset 2px 0 0 var(--va-accent); }\n\n.va-ws__status {\n  flex: none;\n  width: 18px;\n  height: 18px;\n  border-radius: 5px;\n  font-size: 11px;\n  font-weight: 700;\n  line-height: 18px;\n  text-align: center;\n  font-family: var(--va-font-mono);\n}\n\n.va-ws__status[data-status=\"modified\"] { background: color-mix(in srgb, var(--va-warning) 16%, transparent); color: var(--va-warning); }\n.va-ws__status[data-status=\"added\"] { background: color-mix(in srgb, var(--va-success) 16%, transparent); color: var(--va-success); }\n.va-ws__status[data-status=\"deleted\"] { background: color-mix(in srgb, var(--va-danger) 14%, transparent); color: var(--va-danger); }\n.va-ws__status[data-status=\"untracked\"] { background: color-mix(in srgb, var(--va-info) 14%, transparent); color: var(--va-info); }\n\n.va-ws__name {\n  font-family: var(--va-font-mono);\n  font-size: 12px;\n  color: var(--va-ink-2);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.va-ws__file[data-selected=\"true\"] .va-ws__name { color: var(--va-ink); font-weight: 600; }\n\n.va-ws__none {\n  margin: 0;\n  padding: var(--va-s3);\n  font-size: 12px;\n  color: var(--va-muted);\n}\n\n.va-ws__body {\n  flex: 1;\n  padding: var(--va-s4) var(--va-s5) var(--va-s5);\n  min-width: 0;\n  overflow: auto;\n}\n\n@media (max-width: 760px) {\n  .va-ws { grid-template-columns: 1fr; }\n  .va-ws__files { border-right: 0; border-bottom: 1px solid var(--va-edge); max-height: 200px; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/workspace-blocks/VaPricingPlans.vue",
      "type": "registry:ui",
      "target": "components/ui/workspace-blocks/VaPricingPlans.vue",
      "content": "<script setup lang=\"ts\">\nimport type { PricingPlansEvents, PricingPlansProps } from \"./types\";\nimport type { PricingTier } from \"./types\";\n\nconst props = defineProps<PricingPlansProps>();\n\nconst emit = defineEmits<PricingPlansEvents>();\n</script>\n\n<template>\n  <section class=\"va-price\" aria-label=\"定价方案\">\n    <h3 v-if=\"props.title !== ''\" class=\"va-price__title\">{{ props.title ?? \"选择适合的套餐\" }}</h3>\n    <div class=\"va-price__grid\">\n      <article\n        v-for=\"t in props.tiers\"\n        :key=\"t.id\"\n        class=\"va-price__tier\"\n        :data-recommended=\"t.recommended ?? false\"\n        :data-current=\"t.current ?? false\"\n      >\n        <header class=\"va-price__head\">\n          <span class=\"va-price__name\">{{ t.name }}</span>\n          <span v-if=\"t.recommended && !t.current\" class=\"va-price__flag\">推荐</span>\n          <span v-if=\"t.current\" class=\"va-price__flag va-price__flag--current\">当前</span>\n        </header>\n        <p v-if=\"t.description\" class=\"va-price__desc\">{{ t.description }}</p>\n        <p class=\"va-price__price\">\n          <strong>{{ t.price }}</strong>\n          <span v-if=\"t.period\" class=\"va-price__period\">{{ t.period }}</span>\n        </p>\n        <ul class=\"va-price__features\">\n          <li v-for=\"f in t.features\" :key=\"f\">{{ f }}</li>\n        </ul>\n        <button\n          class=\"va-act va-price__cta\"\n          :class=\"t.current || t.recommended ? 'va-act--primary' : ''\"\n          type=\"button\"\n          :disabled=\"t.current\"\n          @click=\"emit('choose', t as PricingTier)\"\n        >{{ t.current ? \"使用中\" : (t.ctaLabel ?? \"选择\") }}</button>\n      </article>\n    </div>\n  </section>\n</template>\n\n<style>\n/* VaPricingPlans — 定价方案区块 */\n\n.va-price {\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s5);\n}\n\n.va-price__title {\n  margin: 0;\n  font-size: 17px;\n  font-weight: 700;\n  color: var(--va-ink);\n  text-align: center;\n}\n\n.va-price__grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n  gap: var(--va-s4);\n  align-items: stretch;\n}\n\n.va-price__tier {\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s3);\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-l);\n  background: var(--va-card);\n  padding: var(--va-s5);\n}\n\n.va-price__tier[data-recommended=\"true\"] {\n  border-color: color-mix(in srgb, var(--va-accent) 45%, transparent);\n  box-shadow: 0 0 0 3px var(--va-accent-soft);\n}\n\n.va-price__tier[data-current=\"true\"] {\n  border-color: color-mix(in srgb, var(--va-success) 45%, transparent);\n}\n\n.va-price__head { display: flex; align-items: center; gap: var(--va-s2); }\n\n.va-price__name { font-size: 14px; font-weight: 700; color: var(--va-ink); }\n\n.va-price__flag {\n  font-size: 10.5px;\n  font-weight: 700;\n  padding: 1px 8px;\n  border-radius: var(--va-radius-pill);\n  background: var(--va-accent-soft);\n  color: var(--va-accent);\n}\n\n.va-price__flag--current {\n  background: color-mix(in srgb, var(--va-success) 14%, transparent);\n  color: var(--va-success);\n}\n\n.va-price__desc { margin: 0; font-size: 12px; color: var(--va-muted); line-height: 1.5; }\n\n.va-price__price { margin: 0; display: flex; align-items: baseline; gap: var(--va-s2); }\n\n.va-price__price strong { font-size: 24px; font-weight: 800; color: var(--va-ink); }\n.va-price__period { font-size: 12px; color: var(--va-muted); }\n\n.va-price__features {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s2);\n  flex: 1;\n}\n\n.va-price__features li {\n  font-size: 12.5px;\n  color: var(--va-ink-2);\n  display: flex;\n  gap: var(--va-s2);\n}\n\n.va-price__features li::before {\n  content: \"✓\";\n  color: var(--va-success);\n  font-weight: 700;\n}\n\n/* 按钮基类（自动附带） */\n/* ============================================================\n   按钮基类 —— 全库动作按钮的单一样式来源。\n   组件叠加使用：class=\"va-act va-act--primary va-xxx__submit\"，\n   组件自己的 CSS 只写布局/色彩覆盖（width、pill 圆角等）。\n   registry 生成器会把本文件自动内联进用了 va-act 的组件拷贝。\n   ============================================================ */\n\n.va-act {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-card);\n  color: var(--va-ink-2);\n  font: inherit;\n  font-size: 13px;\n  line-height: 1.4;\n  padding: 5px 14px;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: border-color var(--va-dur-1) var(--va-ease), background var(--va-dur-1) var(--va-ease),\n    color var(--va-dur-1) var(--va-ease);\n}\n\n.va-act:hover:not(:disabled) { border-color: var(--va-edge-strong); }\n\n.va-act:focus-visible { outline: 2px solid var(--va-accent); outline-offset: 1px; }\n\n.va-act:disabled { opacity: 0.45; cursor: default; }\n\n/* 尺寸 */\n.va-act--sm { font-size: 12px; padding: 3px 10px; }\n.va-act--lg { font-size: 14px; padding: 7px 18px; }\n\n/* 变体 */\n.va-act--primary {\n  background: var(--va-accent);\n  border-color: var(--va-accent);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-act--primary:hover:not(:disabled) {\n  background: var(--va-accent-hover);\n  border-color: var(--va-accent-hover);\n}\n\n.va-act--ghost {\n  border-color: transparent;\n  background: transparent;\n}\n\n.va-act--ghost:hover:not(:disabled) { background: var(--va-bg-subtle); }\n\n.va-act--danger { border-color: transparent; background: transparent; color: var(--va-danger); }\n\n.va-act--danger:hover:not(:disabled) {\n  background: color-mix(in srgb, var(--va-danger) 10%, transparent);\n  border-color: transparent;\n}\n\n/* 语义色实底（成功/危险确认场景，按需叠加） */\n.va-act--success {\n  background: var(--va-success);\n  border-color: var(--va-success);\n  color: #fff;\n  font-weight: 600;\n}\n\n/* 墨色实底：审批/决策/应用这类\"终审\"主操作（区别于 accent 常规主操作） */\n.va-act--ink {\n  background: var(--va-ink);\n  border-color: var(--va-ink);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-act--ink:hover:not(:disabled) { opacity: 0.88; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-act { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/workspace-blocks/types.ts",
      "type": "registry:ui",
      "target": "components/ui/workspace-blocks/types.ts",
      "content": "/** VaPricingPlans / VaAIWorkspace 的类型定义 */\n\nexport interface PricingTier {\n  id: string;\n  name: string;\n  price: string;\n  /** 价格周期注释，如 \"按月\" */\n  period?: string;\n  description?: string;\n  features: string[];\n  current?: boolean;\n  recommended?: boolean;\n  ctaLabel?: string;\n}\n\nexport interface PricingPlansProps {\n  tiers: PricingTier[];\n  /** 区块标题，默认\"选择适合的套餐\" */\n  title?: string;\n}\n\nexport interface PricingPlansEvents {\n  choose: [tier: PricingTier];\n}\n\n/* ---------- AIWorkspace ---------- */\n\nexport interface WorkspaceFile {\n  id: string;\n  name: string;\n  status?: \"modified\" | \"added\" | \"deleted\" | \"untracked\";\n}\n\nexport interface AIWorkspaceProps {\n  files: WorkspaceFile[];\n  /** 受控选中文件 id（默认取第一个） */\n  selected?: string;\n  defaultSelected?: string;\n  /** 左侧文件栏标题，默认\"工作区文件\" */\n  filesLabel?: string;\n  /** 右侧内容区标题（当前选中文件名） */\n  previewLabel?: string;\n}\n\nexport interface AIWorkspaceEvents {\n  \"update:selected\": [id: string];\n  openFile: [file: WorkspaceFile];\n}\n"
    }
  ]
}
