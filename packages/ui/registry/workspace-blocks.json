{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "workspace-blocks",
  "title": "Pricing Plans / AI Workspace",
  "description": "Blocks 两件：PricingPlans 定价卡组（推荐/当前态 + 特性清单 + CTA）；AIWorkspace 文件栏 + 预览区双栏工作块（M/A/D 徽标、选中联动、作用域插槽传当前文件）。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [
    "@vuagent/file-tree"
  ],
  "docs": "- `tiers` (PricingTier[]，默认 -)：PricingPlans：套餐档\n- `@choose` (-，默认 -)：PricingPlans：选择套餐\n- `files / v-model:selected` (WorkspaceFile[] / string，默认 - / 首个)：Workspace：文件与选中\n- `#default（作用域 file）` (-，默认 -)：Workspace：预览区内容",
  "files": [
    {
      "path": "components/ui/workspace-blocks/VaAIWorkspace.vue",
      "type": "registry:ui",
      "target": "components/ui/workspace-blocks/VaAIWorkspace.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, ref } from \"vue\";\nimport type { AIWorkspaceEvents, AIWorkspaceProps } from \"./types\";\nimport type { WorkspaceFile } from \"./types\";\nimport { FILE_STATUS_LABEL } from \"../file-tree/types\";\n\nconst props = defineProps<AIWorkspaceProps>();\n\nconst emit = defineEmits<AIWorkspaceEvents>();\n\nconst touched = ref(false);\nconst inner = ref<string | undefined>(props.defaultSelected ?? props.files[0]?.id);\nconst selectedId = computed(() =>\n  props.selected !== undefined || touched.value ? props.selected : inner.value,\n);\n\nfunction open(f: WorkspaceFile) {\n  touched.value = true;\n  inner.value = f.id;\n  emit(\"update:selected\", f.id);\n  emit(\"openFile\", f);\n}\n\nconst current = computed(() => props.files.find((f) => f.id === selectedId.value));\n</script>\n\n<template>\n  <div class=\"va-ws\">\n    <aside class=\"va-ws__files\" :aria-label=\"props.filesLabel ?? '工作区文件'\">\n      <h3 class=\"va-ws__label\">{{ props.filesLabel ?? \"工作区文件\" }}</h3>\n      <button\n        v-for=\"f in props.files\"\n        :key=\"f.id\"\n        class=\"va-ws__file va-enter-up\"\n        type=\"button\"\n        :data-selected=\"f.id === selectedId\"\n        @click=\"open(f)\"\n      >\n        <span v-if=\"f.status\" class=\"va-ws__status\" :data-status=\"f.status\">{{ FILE_STATUS_LABEL[f.status] }}</span>\n        <span class=\"va-ws__name\">{{ f.name }}</span>\n      </button>\n      <p v-if=\"!props.files.length\" class=\"va-ws__none\">没有文件</p>\n    </aside>\n\n    <section class=\"va-ws__preview\" :aria-label=\"props.previewLabel ?? current?.name ?? '预览'\">\n      <h3 class=\"va-ws__label\">{{ props.previewLabel ?? current?.name ?? \"预览\" }}</h3>\n      <div class=\"va-ws__body\">\n        <slot :file=\"current\" />\n      </div>\n    </section>\n  </div>\n</template>\n\n<style>\n/* VaAIWorkspace — 文件栏 + 预览区双栏工作块 */\n\n.va-ws {\n  display: grid;\n  grid-template-columns: minmax(200px, 260px) 1fr;\n  gap: var(--va-s4, 12px);\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-l, 16px);\n  background: var(--va-card, #ffffff);\n  overflow: hidden;\n  min-height: 280px;\n}\n\n.va-ws__files {\n  border-right: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  background: var(--va-bg-subtle, #efede7);\n  padding: var(--va-s4, 12px);\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  overflow-y: auto;\n}\n\n.va-ws__preview {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n}\n\n.va-ws__label {\n  margin: 0 0 var(--va-s3, 8px);\n  font-size: var(--va-fs-xs, 11px);\n  font-weight: var(--va-fw-bold, 700);\n  letter-spacing: var(--va-tracking-wider, 0.06em);\n  text-transform: uppercase;\n  color: var(--va-muted, #6f6d66);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.va-ws__preview .va-ws__label { padding: var(--va-s4, 12px) var(--va-s5, 16px) 0; }\n\n.va-ws__file {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3, 8px);\n  border: 0;\n  border-radius: var(--va-radius-s, 8px);\n  background: transparent;\n  padding: 5px var(--va-s3, 8px);\n  cursor: pointer;\n  text-align: left;\n  font: inherit;\n}\n\n.va-ws__file:hover { background: var(--va-card, #ffffff); }\n.va-ws__file:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: -2px; }\n.va-ws__file[data-selected=\"true\"] { background: var(--va-card, #ffffff); box-shadow: inset 2px 0 0 var(--va-accent, #c2410c); }\n\n.va-ws__status {\n  flex: none;\n  width: 18px;\n  height: 18px;\n  border-radius: 5px;\n  font-size: var(--va-fs-xs, 11px);\n  font-weight: var(--va-fw-bold, 700);\n  line-height: 18px;\n  text-align: center;\n  font-family: var(--va-font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);\n}\n\n.va-ws__status[data-status=\"modified\"] { background: color-mix(in srgb, var(--va-warning, #b45309) 16%, transparent); color: var(--va-warning, #b45309); }\n.va-ws__status[data-status=\"added\"] { background: color-mix(in srgb, var(--va-success, #1a7f4b) 16%, transparent); color: var(--va-success, #1a7f4b); }\n.va-ws__status[data-status=\"deleted\"] { background: color-mix(in srgb, var(--va-danger, #d5453c) 14%, transparent); color: var(--va-danger, #d5453c); }\n.va-ws__status[data-status=\"untracked\"] { background: color-mix(in srgb, var(--va-info, #2563eb) 14%, transparent); color: var(--va-info, #2563eb); }\n\n.va-ws__name {\n  font-family: var(--va-font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);\n  font-size: var(--va-fs-sm, 12px);\n  color: var(--va-ink-2, #43413c);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.va-ws__file[data-selected=\"true\"] .va-ws__name { color: var(--va-ink, #1a1917); font-weight: var(--va-fw-semibold, 600); }\n\n.va-ws__none {\n  margin: 0;\n  padding: var(--va-s3, 8px);\n  font-size: var(--va-fs-sm, 12px);\n  color: var(--va-muted, #6f6d66);\n}\n\n.va-ws__body {\n  flex: 1;\n  padding: var(--va-s4, 12px) var(--va-s5, 16px) var(--va-s5, 16px);\n  min-width: 0;\n  overflow: auto;\n}\n\n@media (max-width: 760px) {\n  .va-ws { grid-template-columns: 1fr; }\n  .va-ws__files { border-right: 0; border-bottom: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12)); max-height: 200px; }\n}\n\n/* ---- 进出场（TASK-108）：文件行错峰入场（前 6 行 --va-stagger 步长） ---- */\n.va-ws__file:nth-child(2) { animation-delay: var(--va-stagger, 40ms); }\n.va-ws__file:nth-child(3) { animation-delay: calc(var(--va-stagger, 40ms) * 2); }\n.va-ws__file:nth-child(4) { animation-delay: calc(var(--va-stagger, 40ms) * 3); }\n.va-ws__file:nth-child(5) { animation-delay: calc(var(--va-stagger, 40ms) * 4); }\n.va-ws__file:nth-child(6) { animation-delay: calc(var(--va-stagger, 40ms) * 5); }\n\n/* 动效工具类（自动附带，源码中来自全局 motion.css） */\n/* ============================================================\n   共享动效工具类 —— 进出场/交叉淡入的统一协议（TASK-102 动效基建）。\n   组件不逐个发明入场曲线：统一消费 --va-dur-in/--va-dur-out 骨架时长与\n   --va-dist-* 位移档；每条声明自带字面 fallback（registry 单文件拷贝分发\n   要求，与 tokens.css 门禁一致）。\n\n   接入方式二选一：\n   1. Vue <Transition>：\n      <Transition enter-active-class=\"va-enter-up\" leave-active-class=\"va-exit-up\">\n      动画 fill-mode 为 both（延迟期间保持首帧、播完停在终态），\n      无需再配 enter-from-class / leave-to-class；\n   2. 类切换重挂载：骨架 → 内容换节点时给新节点挂 .va-crossfade（纯淡入），\n      离场节点挂 .va-exit-*（更短更快）。\n\n   列表错峰：v-for 子项 :style=\"useStagger().delayStyle(i)\" 配合 .va-enter-*\n   动画类使用（animation-delay 由 composable 编排——.va-enter-* 为 CSS animation，\n   transition-delay 对其零作用，见 composables/useStagger.ts）。\n   ============================================================ */\n\n/* 入场：上浮（自下方 --va-dist-m 浮起） */\n@keyframes va-motion-in-up {\n  from { opacity: 0; transform: translateY(var(--va-dist-m, 8px)); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* 入场：左滑（自左侧 --va-dist-m 滑入） */\n@keyframes va-motion-in-left {\n  from { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n  to { opacity: 1; transform: translateX(0); }\n}\n\n/* 入场：缩放（96% 起放大至原尺寸） */\n@keyframes va-motion-in-scale {\n  from { opacity: 0; transform: scale(0.96); }\n  to { opacity: 1; transform: scale(1); }\n}\n\n/* 离场：与入场互逆（向上/向左飘出、缩回）；时长/曲线由工具类映射 --va-dur-out 骨架 */\n@keyframes va-motion-out-up {\n  from { opacity: 1; transform: translateY(0); }\n  to { opacity: 0; transform: translateY(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-left {\n  from { opacity: 1; transform: translateX(0); }\n  to { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-scale {\n  from { opacity: 1; transform: scale(1); }\n  to { opacity: 0; transform: scale(0.96); }\n}\n\n/* 交叉淡入/淡出（.va-crossfade 骨架→内容交换专用，无位移，避免占位跳变叠加） */\n@keyframes va-motion-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes va-motion-fade-out {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n/* ---- 工具类：入场走 --va-dur-in + ease-out-quart，离场走 --va-dur-out + ease-in-quad ---- */\n\n.va-enter-up {\n  animation: va-motion-in-up var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-left {\n  animation: va-motion-in-left var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-scale {\n  animation: va-motion-in-scale var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-exit-up {\n  animation: va-motion-out-up var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-left {\n  animation: va-motion-out-left var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-scale {\n  animation: va-motion-out-scale var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n/* 骨架 → 内容交叉过渡：新内容纯淡入 */\n.va-crossfade {\n  animation: va-motion-fade-in var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* 空态/轻量状态渐入（TASK-106 弱化档）：仅 opacity、时长走 --va-dur-2，\n   供列表空态提示与一次性状态块使用（空态清单见 TASK-106 报告）。\n   纯 opacity 即动效分频策略的降级终点形态，reduced-motion 下保持原样即可。 */\n.va-fade-in {\n  animation: va-motion-fade-in var(--va-dur-2, 200ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* ---- 静态光斑基类（TASK-105，决策 5「追光」路线基建）----\n   pointer 坐标由 composables/useSpotlight.ts 以 rAF 节流写入 --va-spot-x/y\n   （元素内百分比，光斑数学在 composable 内可单测）；本类只负责 radial 光斑\n   绘制与显隐（:hover 点亮，无 3D 倾斜， glare 数学对齐 VaTiltCard）。\n   --va-spot-* 为 L3 组件钩子口径（宿主可覆盖尺寸/颜色），不进 tokens.css。\n   双降级对齐 VaTiltCard glare：hover: none（触屏）与 reduced-motion 不绘制。 */\n.va-spotlight { position: relative; }\n\n/* ::after 承载光斑（避开组件自身 ::before 用途）；inset 0 + border-radius inherit\n   使光斑天然裁剪在宿主圆角内，无需 overflow: hidden。\n   注意：此 ::after radial 与 components/spotlight-card/VaSpotlightCard.css 的\n   .va-spot-card--spot::after 为 registry 单文件自含有意复制，改动需两处同步。 */\n.va-spotlight::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n  background: radial-gradient(\n    var(--va-spot-size, 240px) circle at var(--va-spot-x, 50%) var(--va-spot-y, 50%),\n    var(--va-spot-color, rgba(255, 255, 255, 0.14)),\n    transparent 65%\n  );\n}\n\n.va-spotlight:hover::after { opacity: 1; }\n\n@media (hover: none) {\n  .va-spotlight::after { display: none; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-spotlight::after { display: none; }\n}\n\n/* ---- 复制反馈标准（TASK-106）：copy→check 交叉过渡 ----\n   容器 .va-copy 为 inline-grid 双内容同格堆叠（格子宽取较宽子项，切换零跳动）：\n   __idle = copy 态内容（图标/文字），__done = check 态内容。\n   copied 置真挂 .va-copy--done：check 以 ease-spring 微弹入场（进入 done 态时\n   transform 的目标态时序换成 --va-ease-spring → 过冲回弹），交叉时长统一 --va-dur-1。\n   消费方：terminal-log（行复制）、code-diff（复制按钮）、message-actions（复制图标）。 */\n.va-copy { display: inline-grid; place-items: center; }\n\n.va-copy__idle,\n.va-copy__done {\n  grid-area: 1 / 1;\n  transition: opacity var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-copy__idle { opacity: 1; transform: scale(1); }\n.va-copy__done { opacity: 0; transform: scale(0.6); }\n\n.va-copy--done .va-copy__done {\n  opacity: 1;\n  transform: scale(1);\n  /* 时序按 transition 属性顺序映射：opacity 仍 ease，transform 换 ease-spring 微弹 */\n  transition-timing-function: var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), var(--va-ease-spring, cubic-bezier(0.34, 1.56, 0.64, 1));\n}\n\n.va-copy--done .va-copy__idle { opacity: 0; transform: scale(0.6); }\n\n@media (prefers-reduced-motion: reduce) {\n  /* 交叉过渡瞬时完成（无位移动画），copied 状态可感知性不受影响 */\n  .va-copy__idle,\n  .va-copy__done { transition: none; }\n}\n\n/* ---- 错误反馈标准（校验失败横向微振）：目标元素挂 .va-shake 播一次 ±3px 微振 ----\n   时长 --va-dur-2 × 2（两拍四峰，克制的「摇头」量级，rubric 校验失败口径）；\n   重复触发需先移除类、强制 reflow 再挂回（封装见 composables/useShake.ts）。\n   reduced-motion 降级为不播：错误状态的可感知性由错误样式本身（描边/文案）承担，\n   动效只做注意力引导——符合头注释「功能动画降级保留状态可感知」的分频策略。\n   消费方：VaStepperForm / VaOtpInput 经 useShake() 程序化触发（defineExpose shake()）；\n   宿主自绘表单可直接挂类。 */\n@keyframes va-motion-shake {\n  20% { transform: translateX(-3px); }\n  40% { transform: translateX(3px); }\n  60% { transform: translateX(-2px); }\n  80% { transform: translateX(2px); }\n}\n\n.va-shake {\n  animation: va-motion-shake calc(var(--va-dur-2, 200ms) * 2) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-shake { animation: none; }\n}\n\n/* ---- 动效分频（对齐 tokens.css 头注释策略）：\n   功能动画降级为纯 opacity——进/出场整体换成 fade keyframes，\n   位移/缩放不再出现（animation-name 顶替，时长/缓动沿用上面的声明）。 */\n@media (prefers-reduced-motion: reduce) {\n  .va-enter-up,\n  .va-enter-left,\n  .va-enter-scale,\n  .va-crossfade {\n    animation-name: va-motion-fade-in;\n  }\n\n  .va-exit-up,\n  .va-exit-left,\n  .va-exit-scale {\n    animation-name: va-motion-fade-out;\n  }\n}\n</style>\n"
    },
    {
      "path": "components/ui/workspace-blocks/VaPricingPlans.vue",
      "type": "registry:ui",
      "target": "components/ui/workspace-blocks/VaPricingPlans.vue",
      "content": "<script setup lang=\"ts\">\nimport type { PricingPlansEvents, PricingPlansProps } from \"./types\";\nimport type { PricingTier } from \"./types\";\n\nconst props = defineProps<PricingPlansProps>();\n\nconst emit = defineEmits<PricingPlansEvents>();\n</script>\n\n<template>\n  <section class=\"va-price\" aria-label=\"定价方案\">\n    <h3 v-if=\"props.title !== ''\" class=\"va-price__title\">{{ props.title ?? \"选择适合的套餐\" }}</h3>\n    <div class=\"va-price__grid\">\n      <article\n        v-for=\"t in props.tiers\"\n        :key=\"t.id\"\n        class=\"va-price__tier va-enter-up\"\n        :data-recommended=\"t.recommended ?? false\"\n        :data-current=\"t.current ?? false\"\n      >\n        <header class=\"va-price__head\">\n          <span class=\"va-price__name\">{{ t.name }}</span>\n          <span v-if=\"t.recommended && !t.current\" class=\"va-price__flag\">推荐</span>\n          <span v-if=\"t.current\" class=\"va-price__flag va-price__flag--current\">当前</span>\n        </header>\n        <p v-if=\"t.description\" class=\"va-price__desc\">{{ t.description }}</p>\n        <p class=\"va-price__price\">\n          <strong>{{ t.price }}</strong>\n          <span v-if=\"t.period\" class=\"va-price__period\">{{ t.period }}</span>\n        </p>\n        <ul class=\"va-price__features\">\n          <li v-for=\"f in t.features\" :key=\"f\">{{ f }}</li>\n        </ul>\n        <button\n          class=\"va-act va-price__cta\"\n          :class=\"t.current || t.recommended ? 'va-act--primary' : ''\"\n          type=\"button\"\n          :disabled=\"t.current\"\n          @click=\"emit('choose', t as PricingTier)\"\n        >{{ t.current ? \"使用中\" : (t.ctaLabel ?? \"选择\") }}</button>\n      </article>\n    </div>\n  </section>\n</template>\n\n<style>\n/* VaPricingPlans — 定价方案区块 */\n\n.va-price {\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s5, 16px);\n}\n\n.va-price__title {\n  margin: 0;\n  font-size: var(--va-fs-xl, 16px);\n  font-weight: var(--va-fw-bold, 700);\n  color: var(--va-ink, #1a1917);\n  text-align: center;\n}\n\n.va-price__grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n  gap: var(--va-s4, 12px);\n  align-items: stretch;\n}\n\n.va-price__tier {\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s3, 8px);\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-l, 16px);\n  background: var(--va-card, #ffffff);\n  padding: var(--va-s5, 16px);\n}\n\n.va-price__tier[data-recommended=\"true\"] {\n  border-color: color-mix(in srgb, var(--va-accent, #c2410c) 45%, transparent);\n  box-shadow: 0 0 0 3px var(--va-accent-soft, rgba(194, 65, 12, 0.1));\n}\n\n.va-price__tier[data-current=\"true\"] {\n  border-color: color-mix(in srgb, var(--va-success, #1a7f4b) 45%, transparent);\n}\n\n.va-price__head { display: flex; align-items: center; gap: var(--va-s2, 4px); }\n\n.va-price__name { font-size: var(--va-fs-lg, 14px); font-weight: var(--va-fw-bold, 700); color: var(--va-ink, #1a1917); }\n\n.va-price__flag {\n  font-size: var(--va-fs-xs, 11px);\n  font-weight: var(--va-fw-bold, 700);\n  padding: 1px 8px;\n  border-radius: var(--va-radius-pill, 999px);\n  background: var(--va-accent-soft, rgba(194, 65, 12, 0.1));\n  color: var(--va-accent, #c2410c);\n}\n\n.va-price__flag--current {\n  background: color-mix(in srgb, var(--va-success, #1a7f4b) 14%, transparent);\n  color: var(--va-success, #1a7f4b);\n}\n\n.va-price__desc { margin: 0; font-size: var(--va-fs-sm, 12px); color: var(--va-muted, #6f6d66); line-height: 1.5; }\n\n.va-price__price { margin: 0; display: flex; align-items: baseline; gap: var(--va-s2, 4px); }\n\n.va-price__price strong { font-size: 24px; /* display 豁免：价格数字 */ font-weight: var(--va-fw-bold, 700); color: var(--va-ink, #1a1917); }\n.va-price__period { font-size: var(--va-fs-sm, 12px); color: var(--va-muted, #6f6d66); }\n\n.va-price__features {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s2, 4px);\n  flex: 1;\n}\n\n.va-price__features li {\n  font-size: var(--va-fs-md, 13px);\n  color: var(--va-ink-2, #43413c);\n  display: flex;\n  gap: var(--va-s2, 4px);\n}\n\n.va-price__features li::before {\n  content: \"✓\";\n  color: var(--va-success, #1a7f4b);\n  font-weight: var(--va-fw-bold, 700);\n}\n\n/* ---- 进出场（TASK-108）：定价卡错峰入场（--va-stagger 步长） ---- */\n.va-price__tier:nth-child(2) { animation-delay: var(--va-stagger, 40ms); }\n.va-price__tier:nth-child(3) { animation-delay: calc(var(--va-stagger, 40ms) * 2); }\n\n/* 按钮基类（自动附带） */\n/* ============================================================\n   按钮基类 —— 全库动作按钮的单一样式来源。\n   组件叠加使用：class=\"va-act va-act--primary va-xxx__submit\"，\n   组件自己的 CSS 只写布局/色彩覆盖（width、pill 圆角等）。\n   registry 生成器会把本文件自动内联进用了 va-act 的组件拷贝。\n   ============================================================ */\n\n.va-act {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--va-s3h, 6px);\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-s, 8px);\n  background: var(--va-card, #ffffff);\n  color: var(--va-ink-2, #43413c);\n  font: inherit;\n  font-size: var(--va-fs-md, 13px);\n  line-height: 1.4;\n  padding: 5px 14px;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: border-color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), background var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-act:hover:not(:disabled) { border-color: var(--va-edge-strong, rgba(26, 25, 23, 0.22)); }\n\n/* 按压反馈（TASK-105 基类口径，对齐 VaButton）：下沉 0.5px + 微缩 0.985，\n   时长走 --va-dur-1。组件不再逐个发明 :active 缩放值。 */\n.va-act:active:not(:disabled) { transform: translateY(0.5px) scale(0.985); }\n\n.va-act:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: 1px; }\n\n.va-act:disabled { opacity: 0.45; cursor: default; }\n\n/* 尺寸 */\n.va-act--sm { font-size: var(--va-fs-sm, 12px); padding: 3px var(--va-s4h, 10px); }\n.va-act--lg { font-size: var(--va-fs-lg, 14px); padding: 7px 18px; }\n\n/* 变体 */\n.va-act--primary {\n  background: var(--va-accent, #c2410c);\n  border-color: var(--va-accent, #c2410c);\n  color: var(--va-card, #ffffff);\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n.va-act--primary:hover:not(:disabled) {\n  background: var(--va-accent-hover, #9a3412);\n  border-color: var(--va-accent-hover, #9a3412);\n}\n\n.va-act--ghost {\n  border-color: transparent;\n  background: transparent;\n}\n\n.va-act--ghost:hover:not(:disabled) { background: var(--va-bg-subtle, #efede7); }\n\n.va-act--danger { border-color: transparent; background: transparent; color: var(--va-danger, #d5453c); }\n\n.va-act--danger:hover:not(:disabled) {\n  background: color-mix(in srgb, var(--va-danger, #d5453c) 10%, transparent);\n  border-color: transparent;\n}\n\n/* 语义色实底（成功/危险确认场景，按需叠加） */\n.va-act--success {\n  background: var(--va-success, #1a7f4b);\n  border-color: var(--va-success, #1a7f4b);\n  color: #fff;\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n/* 墨色实底：审批/决策/应用这类\"终审\"主操作（区别于 accent 常规主操作） */\n.va-act--ink {\n  background: var(--va-ink, #1a1917);\n  border-color: var(--va-ink, #1a1917);\n  color: var(--va-card, #ffffff);\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n.va-act--ink:hover:not(:disabled) { opacity: 0.88; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-act { transition: none; }\n  /* 按压降级：去位移，只留透明度反馈（状态可感知性保留，TASK-105 口径） */\n  .va-act:active:not(:disabled) { transform: none; opacity: 0.7; }\n}\n\n/* 动效工具类（自动附带，源码中来自全局 motion.css） */\n/* ============================================================\n   共享动效工具类 —— 进出场/交叉淡入的统一协议（TASK-102 动效基建）。\n   组件不逐个发明入场曲线：统一消费 --va-dur-in/--va-dur-out 骨架时长与\n   --va-dist-* 位移档；每条声明自带字面 fallback（registry 单文件拷贝分发\n   要求，与 tokens.css 门禁一致）。\n\n   接入方式二选一：\n   1. Vue <Transition>：\n      <Transition enter-active-class=\"va-enter-up\" leave-active-class=\"va-exit-up\">\n      动画 fill-mode 为 both（延迟期间保持首帧、播完停在终态），\n      无需再配 enter-from-class / leave-to-class；\n   2. 类切换重挂载：骨架 → 内容换节点时给新节点挂 .va-crossfade（纯淡入），\n      离场节点挂 .va-exit-*（更短更快）。\n\n   列表错峰：v-for 子项 :style=\"useStagger().delayStyle(i)\" 配合 .va-enter-*\n   动画类使用（animation-delay 由 composable 编排——.va-enter-* 为 CSS animation，\n   transition-delay 对其零作用，见 composables/useStagger.ts）。\n   ============================================================ */\n\n/* 入场：上浮（自下方 --va-dist-m 浮起） */\n@keyframes va-motion-in-up {\n  from { opacity: 0; transform: translateY(var(--va-dist-m, 8px)); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* 入场：左滑（自左侧 --va-dist-m 滑入） */\n@keyframes va-motion-in-left {\n  from { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n  to { opacity: 1; transform: translateX(0); }\n}\n\n/* 入场：缩放（96% 起放大至原尺寸） */\n@keyframes va-motion-in-scale {\n  from { opacity: 0; transform: scale(0.96); }\n  to { opacity: 1; transform: scale(1); }\n}\n\n/* 离场：与入场互逆（向上/向左飘出、缩回）；时长/曲线由工具类映射 --va-dur-out 骨架 */\n@keyframes va-motion-out-up {\n  from { opacity: 1; transform: translateY(0); }\n  to { opacity: 0; transform: translateY(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-left {\n  from { opacity: 1; transform: translateX(0); }\n  to { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-scale {\n  from { opacity: 1; transform: scale(1); }\n  to { opacity: 0; transform: scale(0.96); }\n}\n\n/* 交叉淡入/淡出（.va-crossfade 骨架→内容交换专用，无位移，避免占位跳变叠加） */\n@keyframes va-motion-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes va-motion-fade-out {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n/* ---- 工具类：入场走 --va-dur-in + ease-out-quart，离场走 --va-dur-out + ease-in-quad ---- */\n\n.va-enter-up {\n  animation: va-motion-in-up var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-left {\n  animation: va-motion-in-left var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-scale {\n  animation: va-motion-in-scale var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-exit-up {\n  animation: va-motion-out-up var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-left {\n  animation: va-motion-out-left var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-scale {\n  animation: va-motion-out-scale var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n/* 骨架 → 内容交叉过渡：新内容纯淡入 */\n.va-crossfade {\n  animation: va-motion-fade-in var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* 空态/轻量状态渐入（TASK-106 弱化档）：仅 opacity、时长走 --va-dur-2，\n   供列表空态提示与一次性状态块使用（空态清单见 TASK-106 报告）。\n   纯 opacity 即动效分频策略的降级终点形态，reduced-motion 下保持原样即可。 */\n.va-fade-in {\n  animation: va-motion-fade-in var(--va-dur-2, 200ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* ---- 静态光斑基类（TASK-105，决策 5「追光」路线基建）----\n   pointer 坐标由 composables/useSpotlight.ts 以 rAF 节流写入 --va-spot-x/y\n   （元素内百分比，光斑数学在 composable 内可单测）；本类只负责 radial 光斑\n   绘制与显隐（:hover 点亮，无 3D 倾斜， glare 数学对齐 VaTiltCard）。\n   --va-spot-* 为 L3 组件钩子口径（宿主可覆盖尺寸/颜色），不进 tokens.css。\n   双降级对齐 VaTiltCard glare：hover: none（触屏）与 reduced-motion 不绘制。 */\n.va-spotlight { position: relative; }\n\n/* ::after 承载光斑（避开组件自身 ::before 用途）；inset 0 + border-radius inherit\n   使光斑天然裁剪在宿主圆角内，无需 overflow: hidden。\n   注意：此 ::after radial 与 components/spotlight-card/VaSpotlightCard.css 的\n   .va-spot-card--spot::after 为 registry 单文件自含有意复制，改动需两处同步。 */\n.va-spotlight::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n  background: radial-gradient(\n    var(--va-spot-size, 240px) circle at var(--va-spot-x, 50%) var(--va-spot-y, 50%),\n    var(--va-spot-color, rgba(255, 255, 255, 0.14)),\n    transparent 65%\n  );\n}\n\n.va-spotlight:hover::after { opacity: 1; }\n\n@media (hover: none) {\n  .va-spotlight::after { display: none; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-spotlight::after { display: none; }\n}\n\n/* ---- 复制反馈标准（TASK-106）：copy→check 交叉过渡 ----\n   容器 .va-copy 为 inline-grid 双内容同格堆叠（格子宽取较宽子项，切换零跳动）：\n   __idle = copy 态内容（图标/文字），__done = check 态内容。\n   copied 置真挂 .va-copy--done：check 以 ease-spring 微弹入场（进入 done 态时\n   transform 的目标态时序换成 --va-ease-spring → 过冲回弹），交叉时长统一 --va-dur-1。\n   消费方：terminal-log（行复制）、code-diff（复制按钮）、message-actions（复制图标）。 */\n.va-copy { display: inline-grid; place-items: center; }\n\n.va-copy__idle,\n.va-copy__done {\n  grid-area: 1 / 1;\n  transition: opacity var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-copy__idle { opacity: 1; transform: scale(1); }\n.va-copy__done { opacity: 0; transform: scale(0.6); }\n\n.va-copy--done .va-copy__done {\n  opacity: 1;\n  transform: scale(1);\n  /* 时序按 transition 属性顺序映射：opacity 仍 ease，transform 换 ease-spring 微弹 */\n  transition-timing-function: var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), var(--va-ease-spring, cubic-bezier(0.34, 1.56, 0.64, 1));\n}\n\n.va-copy--done .va-copy__idle { opacity: 0; transform: scale(0.6); }\n\n@media (prefers-reduced-motion: reduce) {\n  /* 交叉过渡瞬时完成（无位移动画），copied 状态可感知性不受影响 */\n  .va-copy__idle,\n  .va-copy__done { transition: none; }\n}\n\n/* ---- 错误反馈标准（校验失败横向微振）：目标元素挂 .va-shake 播一次 ±3px 微振 ----\n   时长 --va-dur-2 × 2（两拍四峰，克制的「摇头」量级，rubric 校验失败口径）；\n   重复触发需先移除类、强制 reflow 再挂回（封装见 composables/useShake.ts）。\n   reduced-motion 降级为不播：错误状态的可感知性由错误样式本身（描边/文案）承担，\n   动效只做注意力引导——符合头注释「功能动画降级保留状态可感知」的分频策略。\n   消费方：VaStepperForm / VaOtpInput 经 useShake() 程序化触发（defineExpose shake()）；\n   宿主自绘表单可直接挂类。 */\n@keyframes va-motion-shake {\n  20% { transform: translateX(-3px); }\n  40% { transform: translateX(3px); }\n  60% { transform: translateX(-2px); }\n  80% { transform: translateX(2px); }\n}\n\n.va-shake {\n  animation: va-motion-shake calc(var(--va-dur-2, 200ms) * 2) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-shake { animation: none; }\n}\n\n/* ---- 动效分频（对齐 tokens.css 头注释策略）：\n   功能动画降级为纯 opacity——进/出场整体换成 fade keyframes，\n   位移/缩放不再出现（animation-name 顶替，时长/缓动沿用上面的声明）。 */\n@media (prefers-reduced-motion: reduce) {\n  .va-enter-up,\n  .va-enter-left,\n  .va-enter-scale,\n  .va-crossfade {\n    animation-name: va-motion-fade-in;\n  }\n\n  .va-exit-up,\n  .va-exit-left,\n  .va-exit-scale {\n    animation-name: va-motion-fade-out;\n  }\n}\n</style>\n"
    },
    {
      "path": "components/ui/workspace-blocks/index.ts",
      "type": "registry:ui",
      "target": "components/ui/workspace-blocks/index.ts",
      "content": "export { default as VaPricingPlans } from \"./VaPricingPlans.vue\";\nexport { default as VaAIWorkspace } from \"./VaAIWorkspace.vue\";\nexport type {\n  AIWorkspaceEvents,\n  AIWorkspaceProps,\n  PricingPlansEvents,\n  PricingPlansProps,\n  PricingTier,\n  WorkspaceFile,\n} from \"./types\";\n"
    },
    {
      "path": "components/ui/workspace-blocks/types.ts",
      "type": "registry:ui",
      "target": "components/ui/workspace-blocks/types.ts",
      "content": "/** VaPricingPlans / VaAIWorkspace 的类型定义 */\n\nexport interface PricingTier {\n  id: string;\n  name: string;\n  price: string;\n  /** 价格周期注释，如 \"按月\" */\n  period?: string;\n  description?: string;\n  features: string[];\n  current?: boolean;\n  recommended?: boolean;\n  ctaLabel?: string;\n}\n\nexport interface PricingPlansProps {\n  tiers: PricingTier[];\n  /** 区块标题，默认\"选择适合的套餐\" */\n  title?: string;\n}\n\nexport interface PricingPlansEvents {\n  choose: [tier: PricingTier];\n}\n\n/* ---------- AIWorkspace ---------- */\n\nexport interface WorkspaceFile {\n  id: string;\n  name: string;\n  status?: \"modified\" | \"added\" | \"deleted\" | \"untracked\";\n}\n\nexport interface AIWorkspaceProps {\n  files: WorkspaceFile[];\n  /** 受控选中文件 id（默认取第一个） */\n  selected?: string;\n  defaultSelected?: string;\n  /** 左侧文件栏标题，默认\"工作区文件\" */\n  filesLabel?: string;\n  /** 右侧内容区标题（当前选中文件名） */\n  previewLabel?: string;\n}\n\nexport interface AIWorkspaceEvents {\n  \"update:selected\": [id: string];\n  openFile: [file: WorkspaceFile];\n}\n"
    }
  ]
}
