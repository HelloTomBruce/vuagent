{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "conversation-header",
  "title": "Conversation Header",
  "description": "会话头：标题行内重命名 + 视图 tabs（聊天/轨迹）+ 运行中/待审批状态徽标。",
  "type": "registry:ui",
  "dependencies": [
    "lucide-vue-next"
  ],
  "registryDependencies": [],
  "docs": "- `title` (string，默认 '')：会话标题（空显示未命名）\n- `running / elapsedLabel` (boolean / string，默认 false / '')：运行中徽标与计时\n- `waitingApproval` (boolean，默认 false)：待审批红标\n- `views / activeView` (HeaderView[] / string，默认 [聊天])：视图 tabs\n- `@update:activeView / @rename` (-，默认 -)：视图切换 / 重命名提交",
  "files": [
    {
      "path": "components/ui/conversation-header/VaConversationHeader.vue",
      "type": "registry:ui",
      "target": "components/ui/conversation-header/VaConversationHeader.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, nextTick, ref, useTemplateRef } from \"vue\";\nimport { Check, Pen, X } from \"lucide-vue-next\";\nimport type { ConversationHeaderEvents, ConversationHeaderProps, HeaderView } from \"./types\";\n\nconst props = withDefaults(defineProps<ConversationHeaderProps>(), {\n  title: \"\",\n  running: false,\n  elapsedLabel: \"\",\n  waitingApproval: false,\n  views: () => [{ id: \"chat\", label: \"聊天\" }],\n  activeView: \"\",\n  renamable: true,\n});\n\nconst emit = defineEmits<ConversationHeaderEvents>();\n\nconst activeId = computed(() => props.activeView || props.views[0]?.id || \"\");\nconst title = computed(() => props.title || \"未命名会话\");\n\n/* 行内重命名 */\nconst editing = ref(false);\nconst draft = ref(\"\");\nconst inputEl = useTemplateRef<HTMLInputElement>(\"input\");\nfunction startRename() {\n  if (!props.renamable) return;\n  draft.value = props.title;\n  editing.value = true;\n  void nextTick(() => inputEl.value?.select());\n}\nfunction commit() {\n  const t = draft.value.trim();\n  if (t && t !== props.title) emit(\"rename\", t);\n  editing.value = false;\n}\nfunction cancel() {\n  editing.value = false;\n}\n</script>\n\n<template>\n  <header class=\"va-chead\">\n    <template v-if=\"editing\">\n      <input\n        ref=\"input\"\n        v-model=\"draft\"\n        class=\"va-chead__input\"\n        type=\"text\"\n        maxlength=\"60\"\n        aria-label=\"重命名会话\"\n        @keydown.enter.prevent=\"commit\"\n        @keydown.escape.prevent=\"cancel\"\n      />\n      <button class=\"va-chead__op\" type=\"button\" aria-label=\"确认重命名\" @click=\"commit\"><Check :size=\"14\" /></button>\n      <button class=\"va-chead__op\" type=\"button\" aria-label=\"取消重命名\" @click=\"cancel\"><X :size=\"14\" /></button>\n    </template>\n    <template v-else>\n      <span class=\"va-chead__title\" :title=\"title\">{{ title }}</span>\n      <button v-if=\"props.renamable\" class=\"va-chead__op\" type=\"button\" aria-label=\"重命名会话\" @click=\"startRename\"><Pen :size=\"13\" /></button>\n    </template>\n\n    <nav v-if=\"props.views.length > 1\" class=\"va-chead__views\" role=\"tablist\" aria-label=\"会话视图\">\n      <button\n        v-for=\"v in props.views as HeaderView[]\"\n        :key=\"v.id\"\n        class=\"va-chead__view\"\n        type=\"button\"\n        role=\"tab\"\n        :aria-selected=\"v.id === activeId\"\n        :data-active=\"v.id === activeId || undefined\"\n        @click=\"emit('update:activeView', v.id)\"\n      >{{ v.label }}</button>\n    </nav>\n\n    <span class=\"va-chead__spacer\" />\n\n    <span v-if=\"props.waitingApproval\" class=\"va-chead__badge va-chead__badge--warn\">待审批</span>\n    <span v-else-if=\"props.running\" class=\"va-chead__badge va-chead__badge--run\">\n      <span class=\"va-chead__run-dot\" aria-hidden=\"true\" />\n      运行中<template v-if=\"props.elapsedLabel\"> {{ props.elapsedLabel }}</template>\n    </span>\n  </header>\n</template>\n\n<style>\n/* VaConversationHeader — 中央会话区头部 */\n.va-chead {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 7px 14px;\n  border-bottom: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  background: var(--va-bg, #f7f6f2);\n  font-family: var(--va-font, system-ui, sans-serif);\n  min-height: 41px;\n  box-sizing: border-box;\n}\n\n.va-chead__title {\n  font-size: 14px;\n  font-weight: 700;\n  color: var(--va-ink, #1a1917);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.va-chead__op {\n  flex: none;\n  width: 24px;\n  height: 24px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border: 0;\n  background: none;\n  color: var(--va-muted, #6f6d66);\n  border-radius: var(--va-radius-s, 8px);\n  cursor: pointer;\n}\n.va-chead__op:hover { background: var(--va-bg-subtle, #efede7); color: var(--va-ink, #1a1917); }\n.va-chead__op:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: -2px; }\n\n.va-chead__input {\n  flex: 0 1 280px;\n  min-width: 0;\n  border: 1px solid var(--va-accent, #c2410c);\n  border-radius: var(--va-radius-s, 8px);\n  background: var(--va-card, #fff);\n  color: var(--va-ink, #1a1917);\n  font: inherit;\n  font-size: 13px;\n  padding: 4px 8px;\n}\n.va-chead__input:focus-visible { outline: none; }\n\n.va-chead__views {\n  display: flex;\n  gap: 2px;\n  background: var(--va-bg-subtle, #efede7);\n  border-radius: var(--va-radius-pill, 999px);\n  padding: 2px;\n  margin-left: 10px;\n}\n.va-chead__view {\n  border: 0;\n  background: none;\n  font: inherit;\n  font-size: 12px;\n  color: var(--va-muted, #6f6d66);\n  padding: 4px 12px;\n  border-radius: var(--va-radius-pill, 999px);\n  cursor: pointer;\n}\n.va-chead__view:hover { color: var(--va-ink, #1a1917); }\n.va-chead__view:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: -2px; }\n.va-chead__view[data-active=\"true\"] {\n  background: var(--va-card, #fff);\n  color: var(--va-ink, #1a1917);\n  font-weight: 600;\n  box-shadow: var(--va-shadow-1, 0 1px 2px rgba(26, 25, 23, 0.06));\n}\n\n.va-chead__spacer { flex: 1; }\n\n.va-chead__badge {\n  flex: none;\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 11.5px;\n  border-radius: var(--va-radius-pill, 999px);\n  padding: 2px 10px;\n}\n.va-chead__badge--run { color: var(--va-warning, #b45309); background: color-mix(in srgb, var(--va-warning, #b45309) 10%, transparent); }\n.va-chead__badge--warn { color: var(--va-danger, #d5484d); font-weight: 700; border: 1px solid var(--va-danger, #d5484d); }\n\n.va-chead__run-dot {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: currentColor;\n  animation: va-chead-pulse 1.2s infinite;\n}\n@keyframes va-chead-pulse { 50% { opacity: 0.35; } }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-chead__run-dot { animation: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/conversation-header/types.ts",
      "type": "registry:ui",
      "target": "components/ui/conversation-header/types.ts",
      "content": "/** VaConversationHeader 的类型定义：中央会话区头部（标题 + 视图 tabs + 状态） */\n\nexport interface HeaderView {\n  id: string;\n  label: string;\n}\n\nexport interface ConversationHeaderProps {\n  /** 会话标题（空串显示「未命名会话」） */\n  title?: string;\n  /** agent 运行中徽标 */\n  running?: boolean;\n  /** 运行计时文案（如 \"00:42\"），running 时展示 */\n  elapsedLabel?: string;\n  /** 待审批徽标 */\n  waitingApproval?: boolean;\n  /** 视图 tabs（聊天 / 轨迹…）；默认仅「聊天」 */\n  views?: HeaderView[];\n  /** 受控当前视图 */\n  activeView?: string;\n  /** 是否可重命名（默认 true） */\n  renamable?: boolean;\n}\n\nexport interface ConversationHeaderEvents {\n  \"update:activeView\": [id: string];\n  /** 提交重命名（空串/同名不触发） */\n  rename: [title: string];\n}\n"
    }
  ]
}
