{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "comment-thread",
  "title": "Comment Thread",
  "description": "评论线程：agent 起草待审条目（采纳/重写/丢弃操作条）、人发评论、首字母头像、⌘/Ctrl+Enter 发布。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `comments` (CommentItem[]，默认 -)：id/author/text/pending…\n- `busy` (boolean，默认 false)：发布中禁发\n- `composer` (boolean，默认 true)：底部输入框开关\n- `@submit / @adopt / @rewrite / @discard` (-，默认 -)：发布与草稿处理",
  "files": [
    {
      "path": "components/ui/comment-thread/VaCommentThread.vue",
      "type": "registry:ui",
      "target": "components/ui/comment-thread/VaCommentThread.vue",
      "content": "<script setup lang=\"ts\">\nimport { useTemplateRef, ref } from \"vue\";\nimport type { CommentThreadEvents, CommentThreadProps } from \"./types\";\nimport { formatRelative } from \"../checkpoint-list/useCheckpointList\";\nimport { useNow } from \"../../composables/useNow\";\nimport { computed } from \"vue\";\n\nconst props = defineProps<CommentThreadProps>();\n\nconst emit = defineEmits<CommentThreadEvents>();\n\nconst alive = computed(() => props.comments.length > 0);\nconst now = useNow(30_000, alive);\n\nconst text = ref(\"\");\nconst area = useTemplateRef<HTMLTextAreaElement>(\"area\");\n\nfunction submit() {\n  const t = text.value.trim();\n  if (!t || props.busy) return;\n  emit(\"submit\", t);\n  text.value = \"\";\n  requestAnimationFrame(() => area.value?.focus());\n}\n\n/** Cmd/Ctrl+Enter 发布；输入法组词中的 Enter 不拦截 */\nfunction onKeydown(e: KeyboardEvent) {\n  if (e.key === \"Enter\" && (e.metaKey || e.ctrlKey)) {\n    e.preventDefault();\n    submit();\n  }\n}\n\n/** 头像色块底色：按作者名 hash 到 6 个柔和色 */\nconst AVATAR_HUES = [16, 145, 210, 268, 34, 190];\nconst avatarStyle = (author: string) => ({\n  background: `hsl(${AVATAR_HUES[author.length % AVATAR_HUES.length]!} 45% 88%)`,\n  color: `hsl(${AVATAR_HUES[author.length % AVATAR_HUES.length]!} 45% 30%)`,\n});\n\nconst initialsOf = (author: string, initials?: string) => initials ?? author.slice(0, 1).toUpperCase();\n</script>\n\n<template>\n  <div class=\"va-cmt\">\n    <div\n      class=\"va-cmt__list\"\n      :style=\"props.maxHeight ? { maxHeight: `${props.maxHeight}px` } : undefined\"\n    >\n      <p v-if=\"!props.comments.length\" class=\"va-cmt__empty\">还没有评论，说点什么吧。</p>\n      <article\n        v-for=\"c in props.comments\"\n        :key=\"c.id\"\n        class=\"va-cmt__item\"\n        :class=\"{ 'va-cmt__item--pending': c.pending }\"\n      >\n        <img v-if=\"c.avatar\" class=\"va-cmt__avatar\" :src=\"c.avatar\" :alt=\"c.author\" />\n        <span v-else class=\"va-cmt__avatar va-cmt__avatar--text\" :style=\"avatarStyle(c.author)\" aria-hidden=\"true\">\n          {{ initialsOf(c.author, c.initials) }}\n        </span>\n        <div class=\"va-cmt__main\">\n          <header class=\"va-cmt__head\">\n            <span class=\"va-cmt__author\">{{ c.author }}</span>\n            <span v-if=\"c.role\" class=\"va-cmt__role\" :data-agent=\"c.pending ?? false\">{{ c.role }}</span>\n            <span v-if=\"c.createdAt\" class=\"va-cmt__time\">{{ formatRelative(c.createdAt, now) }}</span>\n          </header>\n          <p class=\"va-cmt__text\">{{ c.text }}</p>\n          <footer v-if=\"c.pending\" class=\"va-cmt__pending-ops\">\n            <button class=\"va-cmt__op va-cmt__op--primary\" type=\"button\" @click=\"emit('adopt', c.id)\">以此发布</button>\n            <button class=\"va-cmt__op\" type=\"button\" @click=\"emit('rewrite', c.id)\">让 agent 重写</button>\n            <button class=\"va-cmt__op va-cmt__op--ghost\" type=\"button\" @click=\"emit('discard', c.id)\">丢弃</button>\n          </footer>\n        </div>\n      </article>\n    </div>\n\n    <form\n      v-if=\"props.composer !== false\"\n      class=\"va-cmt__composer\"\n      @submit.prevent=\"submit\"\n    >\n      <textarea\n        ref=\"area\"\n        v-model=\"text\"\n        class=\"va-cmt__area\"\n        rows=\"1\"\n        :placeholder=\"props.placeholder ?? '写下评论…'\"\n        :aria-label=\"'评论输入'\"\n        @keydown=\"onKeydown\"\n      />\n      <button\n        class=\"va-cmt__send\"\n        type=\"submit\"\n        :disabled=\"!text.trim() || props.busy\"\n      >{{ props.busy ? \"发布中…\" : \"发布\" }}</button>\n    </form>\n  </div>\n</template>\n\n<style>\n/* VaCommentThread — 评论线程（agent 草稿人审） */\n\n.va-cmt {\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-m);\n  background: var(--va-card);\n  display: flex;\n  flex-direction: column;\n}\n\n.va-cmt__list {\n  overflow-y: auto;\n  padding: var(--va-s5);\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s5);\n}\n\n.va-cmt__empty {\n  margin: 0;\n  padding: var(--va-s3) 0;\n  color: var(--va-muted);\n  font-size: 13px;\n}\n\n.va-cmt__item {\n  display: flex;\n  gap: var(--va-s4);\n}\n\n.va-cmt__avatar {\n  flex: none;\n  width: 30px;\n  height: 30px;\n  border-radius: 50%;\n  object-fit: cover;\n}\n\n.va-cmt__avatar--text {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 13px;\n  font-weight: 700;\n}\n\n.va-cmt__main { flex: 1; min-width: 0; }\n\n.va-cmt__head {\n  display: flex;\n  align-items: baseline;\n  gap: var(--va-s3);\n}\n\n.va-cmt__author { font-size: 13px; font-weight: 600; color: var(--va-ink); }\n.va-cmt__time { font-size: 11.5px; color: var(--va-muted); font-variant-numeric: tabular-nums; }\n\n.va-cmt__role {\n  font-size: 10.5px;\n  font-weight: 600;\n  padding: 1px 7px;\n  border-radius: var(--va-radius-pill);\n  background: var(--va-bg-subtle);\n  color: var(--va-muted);\n}\n\n.va-cmt__role[data-agent=\"true\"] {\n  background: var(--va-accent-soft);\n  color: var(--va-accent);\n}\n\n.va-cmt__text {\n  margin: 3px 0 0;\n  font-size: 13px;\n  line-height: 1.6;\n  color: var(--va-ink-2);\n  white-space: pre-wrap;\n  word-break: break-word;\n}\n\n/* agent 草稿：左侧强调 + 微光等待态 */\n.va-cmt__item--pending .va-cmt__main {\n  background: var(--va-accent-soft);\n  border-radius: 0 var(--va-radius-m) var(--va-radius-m) var(--va-radius-m);\n  padding: var(--va-s3) var(--va-s4);\n  margin: 0 calc(-1 * var(--va-s4)) 0 calc(-1 * var(--va-s3));\n}\n\n.va-cmt__pending-ops {\n  display: flex;\n  gap: var(--va-s2);\n  margin-top: var(--va-s3);\n}\n\n.va-cmt__op {\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-card);\n  color: var(--va-ink-2);\n  font-size: 12px;\n  padding: 3px 10px;\n  cursor: pointer;\n  transition: border-color var(--va-dur-1) var(--va-ease), background var(--va-dur-1) var(--va-ease);\n}\n\n.va-cmt__op:hover { border-color: var(--va-edge-strong); }\n.va-cmt__op:focus-visible { outline: 2px solid var(--va-accent); outline-offset: 1px; }\n\n.va-cmt__op--primary {\n  background: var(--va-accent);\n  border-color: var(--va-accent);\n  color: var(--va-card);\n}\n.va-cmt__op--primary:hover { background: var(--va-accent-hover); }\n\n.va-cmt__op--ghost { border-color: transparent; color: var(--va-muted); }\n.va-cmt__op--ghost:hover { color: var(--va-danger); border-color: transparent; }\n\n/* 底部输入 */\n.va-cmt__composer {\n  display: flex;\n  align-items: flex-end;\n  gap: var(--va-s3);\n  padding: var(--va-s3) var(--va-s4);\n  border-top: 1px solid var(--va-edge);\n  background: var(--va-bg-subtle);\n  border-radius: 0 0 var(--va-radius-m) var(--va-radius-m);\n}\n\n.va-cmt__area {\n  flex: 1;\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-card);\n  color: var(--va-ink);\n  font: inherit;\n  font-size: 13px;\n  line-height: 1.5;\n  padding: 7px 10px;\n  resize: none;\n  min-height: 34px;\n  max-height: 120px;\n  transition: border-color var(--va-dur-1) var(--va-ease);\n}\n\n.va-cmt__area:focus {\n  outline: none;\n  border-color: var(--va-accent);\n}\n\n.va-cmt__send {\n  border: 0;\n  border-radius: var(--va-radius-s);\n  background: var(--va-accent);\n  color: var(--va-card);\n  font-size: 13px;\n  font-weight: 600;\n  padding: 7px 14px;\n  cursor: pointer;\n  transition: background var(--va-dur-1) var(--va-ease);\n}\n\n.va-cmt__send:hover:not(:disabled) { background: var(--va-accent-hover); }\n.va-cmt__send:disabled { opacity: 0.45; cursor: default; }\n.va-cmt__send:focus-visible { outline: 2px solid var(--va-ink); outline-offset: 1px; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-cmt__op,\n  .va-cmt__area,\n  .va-cmt__send { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/comment-thread/types.ts",
      "type": "registry:ui",
      "target": "components/ui/comment-thread/types.ts",
      "content": "/** VaCommentThread 的类型定义 */\n\nexport interface CommentItem {\n  id: string;\n  /** 作者名 */\n  author: string;\n  /** 头像图片地址；缺省用 initials 首字母色块 */\n  avatar?: string;\n  /** 首字母色块文案，缺省取 author 首字符 */\n  initials?: string;\n  /** 身份标注，如 \"Agent\" / \"工程师\" */\n  role?: string;\n  /** 评论正文（保留换行） */\n  text: string;\n  /** 创建时间（ms 时间戳） */\n  createdAt?: number;\n  /** agent 起草待审：展示采纳/重写操作条，视觉区别于人发评论 */\n  pending?: boolean;\n}\n\nexport interface CommentThreadProps {\n  comments: CommentItem[];\n  /** 底部输入框占位文案 */\n  placeholder?: string;\n  /** 提交中（按钮转\"发布中…\"并禁用） */\n  busy?: boolean;\n  /** 显示底部输入框（纯只读线程可关）；默认 true */\n  composer?: boolean;\n  /** 线程最大高度 px，超出滚动（输入框固定在底部之外） */\n  maxHeight?: number;\n}\n\nexport interface CommentThreadEvents {\n  /** 发布评论（携带输入文本，组件随后自动清空输入框） */\n  submit: [text: string];\n  /** 采纳 agent 草稿：宿主把 pending 置 false（或删除草稿并 append 正式评论） */\n  adopt: [id: string];\n  /** 要求 agent 重写草稿 */\n  rewrite: [id: string];\n  /** 丢弃草稿（宿主移除该条） */\n  discard: [id: string];\n}\n"
    }
  ]
}
