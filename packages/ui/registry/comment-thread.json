{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "comment-thread",
  "title": "Comment Thread",
  "description": "评论线程：agent 起草待审条目（采纳/重写/丢弃操作条）、人发评论、首字母头像、⌘/Ctrl+Enter 发布。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [
    "@vuagent/checkpoint-list"
  ],
  "docs": "- `comments` (CommentItem[]，默认 -)：id/author/text/pending…\n- `busy` (boolean，默认 false)：发布中禁发\n- `composer` (boolean，默认 true)：底部输入框开关\n- `@submit / @adopt / @rewrite / @discard` (-，默认 -)：发布与草稿处理",
  "files": [
    {
      "path": "components/ui/comment-thread/VaCommentThread.vue",
      "type": "registry:ui",
      "target": "components/ui/comment-thread/VaCommentThread.vue",
      "content": "<script setup lang=\"ts\">import { useTemplateRef, ref, computed, onBeforeUnmount, watch, type Ref } from \"vue\";\n\nimport type { CommentThreadEvents, CommentThreadProps } from \"./types\";\nimport { formatRelative } from \"../checkpoint-list/useCheckpointList\";\n\n\n\nconst props = withDefaults(defineProps<CommentThreadProps>(), { composer: true });\n\nconst emit = defineEmits<CommentThreadEvents>();\n\nconst alive = computed(() => props.comments.length > 0);\nconst now = useNow(30_000, alive);\n\nconst text = ref(\"\");\nconst area = useTemplateRef<HTMLTextAreaElement>(\"area\");\n\nfunction submit() {\n  const t = text.value.trim();\n  if (!t || props.busy) return;\n  emit(\"submit\", t);\n  text.value = \"\";\n  requestAnimationFrame(() => area.value?.focus());\n}\n\n/** Cmd/Ctrl+Enter 发布；输入法组词中的 Enter 不拦截 */\nfunction onKeydown(e: KeyboardEvent) {\n  if (e.key === \"Enter\" && (e.metaKey || e.ctrlKey)) {\n    e.preventDefault();\n    submit();\n  }\n}\n\n/** 头像色块底色：按作者名 hash 到 6 个柔和色 */\nconst AVATAR_HUES = [16, 145, 210, 268, 34, 190];\nconst avatarStyle = (author: string) => ({\n  background: `hsl(${AVATAR_HUES[author.length % AVATAR_HUES.length]!} 45% 88%)`,\n  color: `hsl(${AVATAR_HUES[author.length % AVATAR_HUES.length]!} 45% 30%)`,\n});\n\nconst initialsOf = (author: string, initials?: string) => initials ?? author.slice(0, 1).toUpperCase();\n\n/* ── 内联自 @vuagent/ui src/composables/useNow.ts（registry 单文件拷贝自包含） ── */\n/**\n * 共享实时时钟：enabled 为 true 期间按 interval 更新 now（ms 时间戳）。\n * 供工具卡计时、计划计时、收件箱时钟等场景复用；SSR 安全。\n */\nfunction useNow(intervalMs: number, enabled: Ref<boolean>): Readonly<Ref<number>> {\n  const now = ref(Date.now());\n  let timer: number | undefined;\n\n  function start() {\n    if (timer !== undefined || typeof window === \"undefined\") return;\n    now.value = Date.now();\n    timer = window.setInterval(() => (now.value = Date.now()), intervalMs);\n  }\n  function stop() {\n    if (timer !== undefined) {\n      window.clearInterval(timer);\n      timer = undefined;\n    }\n  }\n\n  watch(enabled, (v) => (v ? start() : stop()), { immediate: true });\n  onBeforeUnmount(stop);\n\n  return now as Readonly<Ref<number>>;\n}\n</script>\n\n<template>\n  <div class=\"va-cmt\">\n    <div\n      class=\"va-cmt__list\"\n      :style=\"props.maxHeight ? { maxHeight: `${props.maxHeight}px` } : undefined\"\n    >\n      <p v-if=\"!props.comments.length\" class=\"va-cmt__empty va-fade-in\">还没有评论，说点什么吧。</p>\n      <article\n        v-for=\"c in props.comments\"\n        :key=\"c.id\"\n        class=\"va-cmt__item\"\n        :class=\"{ 'va-cmt__item--pending': c.pending }\"\n      >\n        <img v-if=\"c.avatar\" class=\"va-cmt__avatar\" :src=\"c.avatar\" :alt=\"c.author\" />\n        <span v-else class=\"va-cmt__avatar va-cmt__avatar--text\" :style=\"avatarStyle(c.author)\" aria-hidden=\"true\">\n          {{ initialsOf(c.author, c.initials) }}\n        </span>\n        <div class=\"va-cmt__main\">\n          <header class=\"va-cmt__head\">\n            <span class=\"va-cmt__author\">{{ c.author }}</span>\n            <span v-if=\"c.role\" class=\"va-cmt__role\" :data-agent=\"c.pending ?? false\">{{ c.role }}</span>\n            <span v-if=\"c.createdAt\" class=\"va-cmt__time\">{{ formatRelative(c.createdAt, now) }}</span>\n          </header>\n          <p class=\"va-cmt__text\">{{ c.text }}</p>\n          <footer v-if=\"c.pending\" class=\"va-cmt__pending-ops\">\n            <button class=\"va-act va-act--sm va-act--primary va-cmt__op\" type=\"button\" @click=\"emit('adopt', c.id)\">以此发布</button>\n            <button class=\"va-act va-act--sm va-cmt__op\" type=\"button\" @click=\"emit('rewrite', c.id)\">让 agent 重写</button>\n            <button class=\"va-act va-act--sm va-act--ghost va-cmt__op va-cmt__op--discard\" type=\"button\" @click=\"emit('discard', c.id)\">丢弃</button>\n          </footer>\n        </div>\n      </article>\n    </div>\n\n    <form\n      v-if=\"props.composer\"\n      class=\"va-cmt__composer\"\n      @submit.prevent=\"submit\"\n    >\n      <textarea\n        ref=\"area\"\n        v-model=\"text\"\n        class=\"va-cmt__area\"\n        rows=\"1\"\n        :placeholder=\"props.placeholder ?? '写下评论…'\"\n        :aria-label=\"'评论输入'\"\n        @keydown=\"onKeydown\"\n      />\n      <button\n        class=\"va-act va-act--primary va-cmt__send\"\n        type=\"submit\"\n        :disabled=\"!text.trim() || props.busy\"\n      >{{ props.busy ? \"发布中…\" : \"发布\" }}</button>\n    </form>\n  </div>\n</template>\n\n<style>\n/* VaCommentThread — 评论线程（agent 草稿人审） */\n\n.va-cmt {\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-m, 10px);\n  background: var(--va-card, #ffffff);\n  display: flex;\n  flex-direction: column;\n}\n\n.va-cmt__list {\n  overflow-y: auto;\n  padding: var(--va-s5, 16px);\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s5, 16px);\n}\n\n.va-cmt__empty {\n  margin: 0;\n  padding: var(--va-s3, 8px) 0;\n  color: var(--va-muted, #6f6d66);\n  font-size: var(--va-fs-md, 13px);\n}\n\n.va-cmt__item {\n  display: flex;\n  gap: var(--va-s4, 12px);\n}\n\n.va-cmt__avatar {\n  flex: none;\n  width: 30px;\n  height: 30px;\n  border-radius: 50%;\n  object-fit: cover;\n}\n\n.va-cmt__avatar--text {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  font-size: var(--va-fs-md, 13px);\n  font-weight: var(--va-fw-bold, 700);\n}\n\n.va-cmt__main { flex: 1; min-width: 0; }\n\n.va-cmt__head {\n  display: flex;\n  align-items: baseline;\n  gap: var(--va-s3, 8px);\n}\n\n.va-cmt__author { font-size: var(--va-fs-md, 13px); font-weight: var(--va-fw-semibold, 600); color: var(--va-ink, #1a1917); }\n.va-cmt__time { font-size: var(--va-fs-xs, 11px); color: var(--va-muted, #6f6d66); font-variant-numeric: tabular-nums; }\n\n.va-cmt__role {\n  font-size: var(--va-fs-xs, 11px);\n  font-weight: var(--va-fw-semibold, 600);\n  padding: 1px 7px;\n  border-radius: var(--va-radius-pill, 999px);\n  background: var(--va-bg-subtle, #efede7);\n  color: var(--va-muted, #6f6d66);\n}\n\n.va-cmt__role[data-agent=\"true\"] {\n  background: var(--va-accent-soft, rgba(194, 65, 12, 0.1));\n  color: var(--va-accent, #c2410c);\n}\n\n.va-cmt__text {\n  margin: 3px 0 0;\n  font-size: var(--va-fs-md, 13px);\n  line-height: 1.6;\n  color: var(--va-ink-2, #43413c);\n  white-space: pre-wrap;\n  word-break: break-word;\n}\n\n/* agent 草稿：左侧强调 */\n.va-cmt__item--pending .va-cmt__main {\n  background: var(--va-accent-soft, rgba(194, 65, 12, 0.1));\n  border-radius: 0 var(--va-radius-m, 10px) var(--va-radius-m, 10px) var(--va-radius-m, 10px);\n  padding: var(--va-s3, 8px) var(--va-s4, 12px);\n  margin: 0 calc(-1 * var(--va-s4, 12px)) 0 calc(-1 * var(--va-s3, 8px));\n}\n\n.va-cmt__pending-ops {\n  display: flex;\n  gap: var(--va-s2, 4px);\n  margin-top: var(--va-s3, 8px);\n}\n\n\n\n\n\n/* 底部输入 */\n.va-cmt__composer {\n  display: flex;\n  align-items: flex-end;\n  gap: var(--va-s3, 8px);\n  padding: var(--va-s3, 8px) var(--va-s4, 12px);\n  border-top: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  background: var(--va-bg-subtle, #efede7);\n  border-radius: 0 0 var(--va-radius-m, 10px) var(--va-radius-m, 10px);\n}\n\n.va-cmt__area {\n  flex: 1;\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-s, 8px);\n  background: var(--va-card, #ffffff);\n  color: var(--va-ink, #1a1917);\n  font: inherit;\n  font-size: var(--va-fs-md, 13px);\n  line-height: 1.5;\n  padding: 7px var(--va-s4h, 10px);\n  resize: none;\n  min-height: 34px;\n  max-height: 120px;\n  transition: border-color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-cmt__area:focus {\n  outline: none;\n  border-color: var(--va-accent, #c2410c);\n}\n\n\n\n@media (prefers-reduced-motion: reduce) {\n  .va-cmt__area { transition: none; }\n}\n\n/* 按钮基类（自动附带） */\n/* ============================================================\n   按钮基类 —— 全库动作按钮的单一样式来源。\n   组件叠加使用：class=\"va-act va-act--primary va-xxx__submit\"，\n   组件自己的 CSS 只写布局/色彩覆盖（width、pill 圆角等）。\n   registry 生成器会把本文件自动内联进用了 va-act 的组件拷贝。\n   ============================================================ */\n\n.va-act {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--va-s3h, 6px);\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-s, 8px);\n  background: var(--va-card, #ffffff);\n  color: var(--va-ink-2, #43413c);\n  font: inherit;\n  font-size: var(--va-fs-md, 13px);\n  line-height: 1.4;\n  padding: 5px 14px;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: border-color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), background var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-act:hover:not(:disabled) { border-color: var(--va-edge-strong, rgba(26, 25, 23, 0.22)); }\n\n/* 按压反馈（TASK-105 基类口径，对齐 VaButton）：下沉 0.5px + 微缩 0.985，\n   时长走 --va-dur-1。组件不再逐个发明 :active 缩放值。 */\n.va-act:active:not(:disabled) { transform: translateY(0.5px) scale(0.985); }\n\n.va-act:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: 1px; }\n\n.va-act:disabled { opacity: 0.45; cursor: default; }\n\n/* 尺寸 */\n.va-act--sm { font-size: var(--va-fs-sm, 12px); padding: 3px var(--va-s4h, 10px); }\n.va-act--lg { font-size: var(--va-fs-lg, 14px); padding: 7px 18px; }\n\n/* 变体 */\n.va-act--primary {\n  background: var(--va-accent, #c2410c);\n  border-color: var(--va-accent, #c2410c);\n  color: var(--va-card, #ffffff);\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n.va-act--primary:hover:not(:disabled) {\n  background: var(--va-accent-hover, #9a3412);\n  border-color: var(--va-accent-hover, #9a3412);\n}\n\n.va-act--ghost {\n  border-color: transparent;\n  background: transparent;\n}\n\n.va-act--ghost:hover:not(:disabled) { background: var(--va-bg-subtle, #efede7); }\n\n.va-act--danger { border-color: transparent; background: transparent; color: var(--va-danger, #d5453c); }\n\n.va-act--danger:hover:not(:disabled) {\n  background: color-mix(in srgb, var(--va-danger, #d5453c) 10%, transparent);\n  border-color: transparent;\n}\n\n/* 语义色实底（成功/危险确认场景，按需叠加） */\n.va-act--success {\n  background: var(--va-success, #1a7f4b);\n  border-color: var(--va-success, #1a7f4b);\n  color: #fff;\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n/* 墨色实底：审批/决策/应用这类\"终审\"主操作（区别于 accent 常规主操作） */\n.va-act--ink {\n  background: var(--va-ink, #1a1917);\n  border-color: var(--va-ink, #1a1917);\n  color: var(--va-card, #ffffff);\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n.va-act--ink:hover:not(:disabled) { opacity: 0.88; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-act { transition: none; }\n  /* 按压降级：去位移，只留透明度反馈（状态可感知性保留，TASK-105 口径） */\n  .va-act:active:not(:disabled) { transform: none; opacity: 0.7; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/comment-thread/index.ts",
      "type": "registry:ui",
      "target": "components/ui/comment-thread/index.ts",
      "content": "export { default as VaCommentThread } from \"./VaCommentThread.vue\";\nexport type { CommentItem, CommentThreadEvents, CommentThreadProps } from \"./types\";\n"
    },
    {
      "path": "components/ui/comment-thread/types.ts",
      "type": "registry:ui",
      "target": "components/ui/comment-thread/types.ts",
      "content": "/** VaCommentThread 的类型定义 */\n\nexport interface CommentItem {\n  id: string;\n  /** 作者名 */\n  author: string;\n  /** 头像图片地址；缺省用 initials 首字母色块 */\n  avatar?: string;\n  /** 首字母色块文案，缺省取 author 首字符 */\n  initials?: string;\n  /** 身份标注，如 \"Agent\" / \"工程师\" */\n  role?: string;\n  /** 评论正文（保留换行） */\n  text: string;\n  /** 创建时间（ms 时间戳） */\n  createdAt?: number;\n  /** agent 起草待审：展示采纳/重写操作条，视觉区别于人发评论 */\n  pending?: boolean;\n}\n\nexport interface CommentThreadProps {\n  comments: CommentItem[];\n  /** 底部输入框占位文案 */\n  placeholder?: string;\n  /** 提交中（按钮转\"发布中…\"并禁用） */\n  busy?: boolean;\n  /** 显示底部输入框（纯只读线程可关）；默认 true */\n  composer?: boolean;\n  /** 线程最大高度 px，超出滚动（输入框固定在底部之外） */\n  maxHeight?: number;\n}\n\nexport interface CommentThreadEvents {\n  /** 发布评论（携带输入文本，组件随后自动清空输入框） */\n  submit: [text: string];\n  /** 采纳 agent 草稿：宿主把 pending 置 false（或删除草稿并 append 正式评论） */\n  adopt: [id: string];\n  /** 要求 agent 重写草稿 */\n  rewrite: [id: string];\n  /** 丢弃草稿（宿主移除该条） */\n  discard: [id: string];\n}\n"
    }
  ]
}
