{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "tips-panel",
  "title": "Tips Panel",
  "description": "使用技巧面板：高亮小卡承载 1-N 条 tip，单条可关闭。",
  "type": "registry:ui",
  "dependencies": [
    "lucide-vue-next"
  ],
  "registryDependencies": [],
  "docs": "- `tips` (TipItem[]，默认 -)：id/title/body\n- `dismissible` (boolean，默认 false)：显示单条关闭按钮\n- `@dismiss` (-，默认 -)：关闭某条",
  "files": [
    {
      "path": "components/ui/tips-panel/VaTipsPanel.vue",
      "type": "registry:ui",
      "target": "components/ui/tips-panel/VaTipsPanel.vue",
      "content": "<script setup lang=\"ts\">import { Lightbulb } from \"lucide-vue-next\";\n\nimport type { TipsPanelEvents, TipsPanelProps } from \"./types\";\n\nconst props = defineProps<TipsPanelProps>();\n\nconst emit = defineEmits<TipsPanelEvents>();\n\n/**\n * 条目错峰（TASK-108）：统一消费 useStagger（animation-delay 轴，配合 .va-enter-*\n * 动画类使用；默认档位对齐 --va-stagger 40ms 步长、8 档钳制、reduced-motion 归零；\n * SSR 无 window 按正常分支输出，服务端与客户端首帧一致）。\n */\nconst { delayStyle } = useStagger();\n\n/* ── 内联自 @vuagent/ui src/composables/useStagger.ts（registry 单文件拷贝自包含） ── */\n/**\n * 列表子项进出场错峰编排（TASK-102 动效基建）：\n * 返回 delayStyle(index) 供 v-for 子项绑定 :style，配合 .va-enter-* 动画类使用\n * （.va-enter-* 全是 CSS animation，延迟轴为 animation-delay——transition-delay\n * 对 animation 零作用；动画 fill-mode both 保首帧，延迟期间不闪跳）。\n * 步长口径对齐 tokens.css 的 --va-stagger（40ms）；\n * reduced-motion 下延迟归零（动画降级本身由 motion.css 媒体查询处理）。\n *\n * SSR 安全：无 window/matchMedia 时跳过检测、按正常分支返回——服务端与客户端\n * 首帧输出一致，避免 hydration 抖动；reduced-motion 检测照抄现有 composable\n * 范式（window.matchMedia?.() 整链短路），挂载时机一次性读取，不监听系统切换。\n */\ninterface UseStaggerOptions {\n  /** 相邻子项延迟步长 ms（默认 40，同 --va-stagger） */\n  stepMs?: number;\n  /** 错峰档位上限：index 超过后钳制在档顶（默认 8，防长列表末项等待过久） */\n  maxItems?: number;\n  /** 置真时恒返回 0ms 延迟（宿主自行关闭错峰） */\n  disabled?: boolean;\n}\n\nfunction useStagger(options: UseStaggerOptions = {}) {\n  const stepMs = options.stepMs ?? 40;\n  const maxItems = options.maxItems ?? 8;\n  const disabled = options.disabled ?? false;\n\n  const reduced =\n    typeof window !== \"undefined\" &&\n    (window.matchMedia?.(\"(prefers-reduced-motion: reduce)\").matches ?? false);\n\n  /** 配合 .va-enter-* 动画类使用：animation-delay 按 0 起步长递增，超过档位上限后钳制 */\n  function delayStyle(index: number): Record<string, string> {\n    if (reduced || disabled) return { \"animation-delay\": \"0ms\" };\n    const delay = Math.min(Math.max(index, 0), maxItems) * stepMs;\n    return { \"animation-delay\": `${delay}ms` };\n  }\n\n  return { delayStyle };\n}\n</script>\n\n<template>\n  <aside v-if=\"tips.length\" class=\"va-tips\" aria-label=\"使用技巧\">\n    <header class=\"va-tips__head\">\n      <span class=\"va-tips__icon\" aria-hidden=\"true\"><Lightbulb :size=\"14\" /></span>\n      <span class=\"va-tips__title\">{{ props.title ?? \"使用技巧\" }}</span>\n    </header>\n    <ul class=\"va-tips__list\">\n      <li\n        v-for=\"(t, i) in tips\"\n        :key=\"t.id\"\n        class=\"va-tips__item va-enter-up\"\n        :style=\"delayStyle(i)\"\n      >\n        <div class=\"va-tips__main\">\n          <span class=\"va-tips__t\">{{ t.title }}</span>\n          <span class=\"va-tips__b\">{{ t.body }}</span>\n        </div>\n        <button\n          v-if=\"props.dismissible\"\n          class=\"va-tips__close\"\n          type=\"button\"\n          :aria-label=\"`关闭技巧：${t.title}`\"\n          @click=\"emit('dismiss', t.id)\"\n        >×</button>\n      </li>\n    </ul>\n  </aside>\n  <p v-else-if=\"props.emptyLabel\" class=\"va-tips__empty\">{{ props.emptyLabel }}</p>\n</template>\n\n<style>\n/* VaTipsPanel — 使用技巧面板 */\n\n.va-tips {\n  border: 1px solid color-mix(in srgb, var(--va-warning, #b45309) 30%, transparent);\n  border-radius: var(--va-radius-m, 10px);\n  background: color-mix(in srgb, var(--va-warning, #b45309) 5%, var(--va-card, #ffffff));\n  padding: var(--va-s4, 12px) var(--va-s5, 16px);\n}\n\n.va-tips__head {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s2, 4px);\n  margin-bottom: var(--va-s3, 8px);\n}\n\n.va-tips__icon { display: inline-flex; align-items: center; color: var(--va-accent, #c2410c); }\n\n.va-tips__title {\n  font-size: var(--va-fs-md, 13px);\n  font-weight: var(--va-fw-bold, 700);\n  color: var(--va-ink, #1a1917);\n  letter-spacing: 0.02em;\n}\n\n.va-tips__list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.va-tips__item {\n  display: flex;\n  align-items: flex-start;\n  gap: var(--va-s3, 8px);\n  padding: var(--va-s2, 4px) 0;\n}\n\n.va-tips__main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }\n\n.va-tips__t { font-size: var(--va-fs-md, 13px); font-weight: var(--va-fw-semibold, 600); color: var(--va-ink, #1a1917); }\n.va-tips__b { font-size: var(--va-fs-sm, 12px); color: var(--va-ink-2, #43413c); line-height: 1.55; }\n\n.va-tips__close {\n  flex: none;\n  border: 0;\n  background: transparent;\n  color: var(--va-muted, #6f6d66);\n  font-size: var(--va-fs-lg, 14px);\n  line-height: 1;\n  width: 22px;\n  height: 22px;\n  cursor: pointer;\n  border-radius: var(--va-radius-s, 8px);\n}\n\n.va-tips__close:hover { color: var(--va-ink, #1a1917); background: color-mix(in srgb, var(--va-warning, #b45309) 12%, transparent); }\n.va-tips__close:focus-visible { outline: 2px solid var(--va-accent, #c2410c); }\n\n/* TASK-108 交互反馈：关闭按钮 hover 平滑过渡（条目错峰入场由模板 .va-enter-up 编排） */\n.va-tips__close {\n  transition:\n    background-color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-tips__empty {\n  margin: 0;\n  font-size: var(--va-fs-sm, 12px);\n  color: var(--va-muted, #6f6d66);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-tips__close { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/tips-panel/index.ts",
      "type": "registry:ui",
      "target": "components/ui/tips-panel/index.ts",
      "content": "export { default as VaTipsPanel } from \"./VaTipsPanel.vue\";\nexport type { TipItem, TipsPanelEvents, TipsPanelProps } from \"./types\";\n"
    },
    {
      "path": "components/ui/tips-panel/types.ts",
      "type": "registry:ui",
      "target": "components/ui/tips-panel/types.ts",
      "content": "/** VaTipsPanel 的类型定义 */\n\nexport interface TipItem {\n  id: string;\n  title: string;\n  body: string;\n}\n\nexport interface TipsPanelProps {\n  tips: TipItem[];\n  /** 面板标题，默认\"使用技巧\" */\n  title?: string;\n  /** 单条 tip 可关闭 */\n  dismissible?: boolean;\n  /** 全部关闭后显示的文案；空字符串则整卡隐藏 */\n  emptyLabel?: string;\n}\n\nexport interface TipsPanelEvents {\n  dismiss: [id: string];\n}\n"
    }
  ]
}
