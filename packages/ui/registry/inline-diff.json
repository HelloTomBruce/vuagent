{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "inline-diff",
  "title": "Inline Diff",
  "description": "AI 文案修改逐词接受/拒绝：CJK 逐字分词的零依赖 diff、撤销栈、全部决断后应用。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `original / revised` (string，默认 -)：原文与修改稿\n- `@apply` (-，默认 -)：全部决断后回调，携带合成文本",
  "files": [
    {
      "path": "components/ui/inline-diff/VaInlineDiff.vue",
      "type": "registry:ui",
      "target": "components/ui/inline-diff/VaInlineDiff.vue",
      "content": "<script setup lang=\"ts\">\nimport type { InlineDiffProps } from \"./types\";\nimport { useInlineDiff } from \"./useInlineDiff\";\n\nconst props = defineProps<InlineDiffProps>();\n\nconst emit = defineEmits<{ apply: [result: string] }>();\n\nconst {\n  units,\n  decisions,\n  undoStack,\n  changeIdx,\n  pendingCount,\n  toggle,\n  acceptAll,\n  rejectAll,\n  undo,\n  reset,\n  apply,\n} = useInlineDiff(props, { apply: (result) => emit(\"apply\", result) });\n</script>\n\n<template>\n  <div class=\"va-dif\">\n    <header v-if=\"props.title || changeIdx.length\" class=\"va-dif__head\">\n      <h4 v-if=\"props.title\" class=\"va-dif__title\">{{ props.title }}</h4>\n      <span v-if=\"changeIdx.length\" class=\"va-dif__meta\" role=\"status\">\n        {{ changeIdx.length - pendingCount }}/{{ changeIdx.length }} 已决断\n      </span>\n    </header>\n\n    <p class=\"va-dif__text\">\n      <template v-for=\"(u, i) in units\" :key=\"i\">\n        <span v-if=\"u.same !== undefined\" class=\"va-dif__same\">{{ u.same }}</span>\n        <button\n          v-else\n          class=\"va-dif__unit\"\n          type=\"button\"\n          :aria-pressed=\"decisions[i] ?? undefined\"\n          :data-state=\"decisions[i] === undefined ? 'pending' : decisions[i] ? 'accepted' : 'rejected'\"\n          :title=\"decisions[i] === undefined ? '点击接受（再点切换为拒绝）' : decisions[i] ? '已接受，点击改为拒绝' : '已拒绝，点击改为接受'\"\n          @click=\"toggle(i)\"\n        >\n          <del v-if=\"u.del\" class=\"va-dif__del\">{{ u.del }}</del\n          ><ins v-if=\"u.add\" class=\"va-dif__add\">{{ u.add }}</ins>\n        </button>\n      </template>\n    </p>\n\n    <footer v-if=\"changeIdx.length\" class=\"va-dif__foot\">\n      <button class=\"va-btn va-btn--sm va-dif__btn\" type=\"button\" :disabled=\"!undoStack.length\" @click=\"undo\">撤销</button>\n      <button class=\"va-btn va-btn--sm va-dif__btn\" type=\"button\" :disabled=\"!pendingCount\" @click=\"acceptAll\">全部接受</button>\n      <button class=\"va-btn va-btn--sm va-dif__btn\" type=\"button\" :disabled=\"!pendingCount\" @click=\"rejectAll\">全部拒绝</button>\n      <span class=\"va-dif__spacer\" />\n      <button class=\"va-btn va-btn--sm va-btn--ghost va-dif__btn\" type=\"button\" @click=\"reset\">重置</button>\n      <button class=\"va-btn va-btn--sm va-btn--ink va-dif__btn\" type=\"button\" :disabled=\"pendingCount > 0\" @click=\"apply\">\n        应用修改\n      </button>\n    </footer>\n    <p v-else class=\"va-dif__none\">本段没有修改建议。</p>\n  </div>\n</template>\n\n<style>\n/* VaInlineDiff — AI 文案修改的逐词接受/拒绝 */\n.va-dif {\n  --_edge: var(--va-dif-edge, var(--va-edge, rgba(26, 25, 23, 0.12)));\n  --_muted: var(--va-dif-muted, var(--va-muted, #6f6d66));\n  --_ink: var(--va-dif-ink, var(--va-ink, #1a1917));\n  --_accent: var(--va-dif-accent, var(--va-accent, #c2410c));\n  --_success: var(--va-dif-success, var(--va-success, #1a7f4b));\n  --_danger: var(--va-dif-danger, var(--va-danger, #d5453c));\n  font-family: var(--va-font, system-ui, sans-serif);\n}\n\n.va-dif__head { display: flex; align-items: baseline; gap: var(--va-s3, 8px); margin-bottom: var(--va-s2, 4px); }\n.va-dif__title { margin: 0; font-size: 13px; font-weight: 650; color: var(--_ink); }\n.va-dif__meta { font-size: 11.5px; color: var(--_muted); font-variant-numeric: tabular-nums; }\n\n.va-dif__text { margin: 0; font-size: 14px; line-height: 2; color: var(--_ink); }\n\n.va-dif__same { white-space: pre-wrap; }\n\n.va-dif__unit {\n  appearance: none;\n  border: 0;\n  background: none;\n  padding: 1px 2px;\n  margin: 0 -1px;\n  font: inherit;\n  line-height: inherit;\n  cursor: pointer;\n  border-radius: 4px;\n  white-space: pre-wrap;\n  transition: background var(--va-dur-1, 120ms) ease;\n}\n.va-dif__unit:hover { background: var(--va-bg-subtle, #efede7); }\n.va-dif__unit:focus-visible { outline: 2px solid var(--_accent); outline-offset: 1px; }\n\n.va-dif__del { text-decoration-thickness: 1.5px; }\n.va-dif__add { text-decoration: none; }\n\n/* 未决：旧词删除线红、新词下划线绿，并排呈现 */\n.va-dif__unit[data-state=\"pending\"] .va-dif__del { color: var(--_danger); background: color-mix(in srgb, var(--_danger) 8%, transparent); }\n.va-dif__unit[data-state=\"pending\"] .va-dif__add { color: var(--_success); background: color-mix(in srgb, var(--_success) 10%, transparent); text-decoration: underline; text-underline-offset: 3px; }\n\n/* 接受：只留新词 */\n.va-dif__unit[data-state=\"accepted\"] .va-dif__del { display: none; }\n.va-dif__unit[data-state=\"accepted\"] .va-dif__add { color: var(--_success); background: color-mix(in srgb, var(--_success) 10%, transparent); }\n\n/* 拒绝：只留旧词 */\n.va-dif__unit[data-state=\"rejected\"] .va-dif__del { color: var(--_muted); }\n.va-dif__unit[data-state=\"rejected\"] .va-dif__add { display: none; }\n\n.va-dif__foot { display: flex; align-items: center; gap: var(--va-s2, 4px); margin-top: var(--va-s3, 8px); flex-wrap: wrap; }\n.va-dif__spacer { flex: 1; }\n/* va-btn / ghost / ink 基类兜底，仅保留 pill 形态 */\n.va-dif__btn {\n  height: 26px;\n  padding: 0 var(--va-s4, 12px);\n  border-radius: var(--va-radius-pill, 999px);\n}\n\n.va-dif__none { margin: 0; font-size: 12px; color: var(--_muted); }\n\n/* 按钮基类（自动附带） */\n/* ============================================================\n   按钮基类 —— 全库动作按钮的单一样式来源。\n   组件叠加使用：class=\"va-btn va-btn--primary va-xxx__submit\"，\n   组件自己的 CSS 只写布局/色彩覆盖（width、pill 圆角等）。\n   registry 生成器会把本文件自动内联进用了 va-btn 的组件拷贝。\n   ============================================================ */\n\n.va-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-card);\n  color: var(--va-ink-2);\n  font: inherit;\n  font-size: 13px;\n  line-height: 1.4;\n  padding: 5px 14px;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: border-color var(--va-dur-1) var(--va-ease), background var(--va-dur-1) var(--va-ease),\n    color var(--va-dur-1) var(--va-ease);\n}\n\n.va-btn:hover:not(:disabled) { border-color: var(--va-edge-strong); }\n\n.va-btn:focus-visible { outline: 2px solid var(--va-accent); outline-offset: 1px; }\n\n.va-btn:disabled { opacity: 0.45; cursor: default; }\n\n/* 尺寸 */\n.va-btn--sm { font-size: 12px; padding: 3px 10px; }\n.va-btn--lg { font-size: 14px; padding: 7px 18px; }\n\n/* 变体 */\n.va-btn--primary {\n  background: var(--va-accent);\n  border-color: var(--va-accent);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-btn--primary:hover:not(:disabled) {\n  background: var(--va-accent-hover);\n  border-color: var(--va-accent-hover);\n}\n\n.va-btn--ghost {\n  border-color: transparent;\n  background: transparent;\n}\n\n.va-btn--ghost:hover:not(:disabled) { background: var(--va-bg-subtle); }\n\n.va-btn--danger { border-color: transparent; background: transparent; color: var(--va-danger); }\n\n.va-btn--danger:hover:not(:disabled) {\n  background: color-mix(in srgb, var(--va-danger) 10%, transparent);\n  border-color: transparent;\n}\n\n/* 语义色实底（成功/危险确认场景，按需叠加） */\n.va-btn--success {\n  background: var(--va-success);\n  border-color: var(--va-success);\n  color: #fff;\n  font-weight: 600;\n}\n\n/* 墨色实底：审批/决策/应用这类\"终审\"主操作（区别于 accent 常规主操作） */\n.va-btn--ink {\n  background: var(--va-ink);\n  border-color: var(--va-ink);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-btn--ink:hover:not(:disabled) { opacity: 0.88; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-btn { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/inline-diff/types.ts",
      "type": "registry:ui",
      "target": "components/ui/inline-diff/types.ts",
      "content": "/** VaInlineDiff 的类型定义 */\n\nexport interface InlineDiffProps {\n  /** 原文 */\n  original: string;\n  /** AI 修改稿 */\n  revised: string;\n  title?: string;\n}\n\nexport interface InlineDiffEvents {\n  /** 全部决断后应用，携带合成后的最终文本 */\n  apply: [result: string];\n}\n"
    },
    {
      "path": "components/ui/inline-diff/useInlineDiff.ts",
      "type": "registry:ui",
      "target": "components/ui/inline-diff/useInlineDiff.ts",
      "content": "import { computed, ref } from \"vue\";\nimport type { DiffPiece } from \"../../utils/wordDiff\";\nimport { buildDiffUnits, diffResult } from \"../../utils/wordDiff\";\nimport type { InlineDiffProps } from \"./types\";\n\n/**\n * VaInlineDiff 的状态逻辑：\n * buildDiffUnits 产出变更单元 → 逐个接受/拒绝（含撤销栈）→ 全部决断后合成结果。\n * decisions: undefined=未决 · true=接受新稿 · false=保留原文\n */\nexport function useInlineDiff(\n  props: InlineDiffProps,\n  emit: { apply: (result: string) => void },\n) {\n  const units = computed<DiffPiece[]>(() => buildDiffUnits(props.original, props.revised));\n  const decisions = ref<Record<number, boolean>>({});\n  const undoStack = ref<number[]>([]);\n\n  const changeIdx = computed(() =>\n    units.value.map((u, i) => (u.same === undefined ? i : -1)).filter((i) => i >= 0),\n  );\n  const pendingCount = computed(() => changeIdx.value.filter((i) => decisions.value[i] === undefined).length);\n\n  function toggle(i: number) {\n    const cur = decisions.value[i];\n    if (cur === undefined) {\n      decisions.value[i] = true;\n      undoStack.value.push(i);\n    } else {\n      decisions.value[i] = !cur;\n      if (!undoStack.value.includes(i)) undoStack.value.push(i);\n    }\n  }\n\n  function acceptAll() {\n    for (const i of changeIdx.value) decisions.value[i] = true;\n  }\n  function rejectAll() {\n    for (const i of changeIdx.value) decisions.value[i] = false;\n  }\n  function undo() {\n    const i = undoStack.value.pop();\n    if (i !== undefined) delete decisions.value[i];\n  }\n  function reset() {\n    decisions.value = {};\n    undoStack.value = [];\n  }\n\n  const result = computed(() => diffResult(units.value, decisions.value));\n  function apply() {\n    emit.apply(result.value);\n  }\n\n  return {\n    units,\n    decisions,\n    undoStack,\n    changeIdx,\n    pendingCount,\n    toggle,\n    acceptAll,\n    rejectAll,\n    undo,\n    reset,\n    result,\n    apply,\n  };\n}\n"
    }
  ]
}
