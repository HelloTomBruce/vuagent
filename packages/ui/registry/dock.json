{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "dock",
  "title": "Dock",
  "description": "右侧面板停靠容器：tab 胶囊条 + ≤2 分屏（分隔条可拖 20-80%）+ 全屏 + 折叠，面板内容由宿主经作用域插槽注入。",
  "type": "registry:ui",
  "dependencies": [
    "lucide-vue-next"
  ],
  "registryDependencies": [],
  "docs": "- `panes` (DockPaneState[]，默认 -)：1-2 个 pane（tabs + activeId），受控\n- `ratio` (number，默认 0.55)：分屏分隔位置 0.2-0.8\n- `fullscreenPane` (number | null，默认 null)：全屏 pane 下标\n- `#pane` (-，默认 -)：作用域插槽（pane-index / tab-id），宿主渲染面板内容\n- `@select/@close/@add/@split/@unsplit/@fullscreen/@resize/@collapse` (-，默认 -)：停靠操作回调",
  "files": [
    {
      "path": "components/ui/dock/VaDock.vue",
      "type": "registry:ui",
      "target": "components/ui/dock/VaDock.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, ref, watch } from \"vue\";\nimport { Columns2, Maximize2, Minimize2, Minus, Plus, Square, X } from \"lucide-vue-next\";\nimport type { DockEvents, DockProps } from \"./types\";\n\nconst props = withDefaults(defineProps<DockProps>(), {\n  ratio: 0.55,\n  fullscreenPane: null,\n  addDisabled: false,\n  splitDisabled: false,\n});\n\nconst emit = defineEmits<DockEvents>();\n\nconst isSplit = computed(() => props.panes.length > 1);\nconst fullscreen = computed(() => props.fullscreenPane ?? null);\n\n/* 分隔条拖动：受控值本地镜像，拖动中实时 emit */\nconst localRatio = ref(props.ratio);\nwatch(\n  () => props.ratio,\n  (r) => (localRatio.value = r),\n);\nconst dockEl = ref<HTMLElement | null>(null);\nfunction onDividerDown(e: PointerEvent) {\n  const el = dockEl.value;\n  if (!el) return;\n  (e.target as HTMLElement).setPointerCapture(e.pointerId);\n  const move = (ev: PointerEvent) => {\n    const rect = el.getBoundingClientRect();\n    const r = Math.min(0.8, Math.max(0.2, (ev.clientX - rect.left) / rect.width));\n    localRatio.value = r;\n    emit(\"resize\", Math.round(r * 100) / 100);\n  };\n  const up = () => {\n    window.removeEventListener(\"pointermove\", move);\n    window.removeEventListener(\"pointerup\", up);\n  };\n  window.addEventListener(\"pointermove\", move);\n  window.addEventListener(\"pointerup\", up);\n}\n\nconst splitStyle = computed(() =>\n  isSplit.value && fullscreen.value === null\n    ? { gridTemplateColumns: `minmax(0, ${localRatio.value}fr) 5px minmax(0, ${1 - localRatio.value}fr)` }\n    : undefined,\n);\n\nfunction selectPane(i: number, id: string) {\n  if (id !== props.panes[i]!.activeId) emit(\"select\", i, id);\n}\nfunction toggleSplit() {\n  if (isSplit.value) emit(\"unsplit\");\n  else emit(\"split\");\n}\n</script>\n\n<template>\n  <div\n    ref=\"dockEl\"\n    class=\"va-dock\"\n    :data-fullscreen=\"fullscreen !== null || undefined\"\n    :data-split=\"isSplit || undefined\"\n    :style=\"splitStyle\"\n  >\n    <section\n      v-for=\"(pane, i) in props.panes\"\n      v-show=\"fullscreen === null || fullscreen === i\"\n      :key=\"i\"\n      class=\"va-dock__pane va-enter-up\"\n    >\n      <div class=\"va-dock__tabs\">\n        <button\n          v-for=\"tab in pane.tabs\"\n          :key=\"tab.id\"\n          class=\"va-dock__tab\"\n          type=\"button\"\n          :data-active=\"tab.id === pane.activeId || undefined\"\n          @click=\"selectPane(i, tab.id)\"\n        >\n          <component :is=\"tab.icon\" v-if=\"tab.icon\" :size=\"12\" aria-hidden=\"true\" />\n          <span class=\"va-dock__tab-label\">{{ tab.label ?? tab.id }}</span>\n          <span\n            v-if=\"tab.closable !== false\"\n            class=\"va-dock__tabx\"\n            role=\"button\"\n            tabindex=\"0\"\n            aria-label=\"关闭面板\"\n            @click.stop=\"emit('close', i, tab.id)\"\n            @keydown.enter.prevent=\"emit('close', i, tab.id)\"\n          ><X :size=\"11\" aria-hidden=\"true\" /></span>\n        </button>\n\n        <button\n          class=\"va-dock__op va-dock__op--add\"\n          type=\"button\"\n          aria-label=\"添加面板\"\n          :disabled=\"props.addDisabled\"\n          @click=\"emit('add', i)\"\n        ><Plus :size=\"13\" aria-hidden=\"true\" /></button>\n\n        <span class=\"va-dock__spacer\" />\n\n        <!-- 全局操作挂在最后一个可见 pane 的 tab 条尾部 -->\n        <template v-if=\"i === (fullscreen ?? props.panes.length - 1)\">\n          <button v-if=\"!props.splitDisabled\" class=\"va-dock__op\" type=\"button\" :aria-label=\"isSplit ? '取消分屏' : '分屏'\" @click=\"toggleSplit\">\n            <Columns2 v-show=\"!isSplit\" :size=\"13\" aria-hidden=\"true\" />\n            <Square v-show=\"isSplit\" :size=\"11\" aria-hidden=\"true\" />\n          </button>\n          <button\n            v-if=\"fullscreen === null && isSplit\"\n            class=\"va-dock__op\"\n            type=\"button\"\n            :aria-label=\"`全屏面板 ${i + 1}`\"\n            @click=\"emit('fullscreen', i)\"\n          ><Maximize2 :size=\"13\" aria-hidden=\"true\" /></button>\n          <button v-if=\"fullscreen !== null\" class=\"va-dock__op\" type=\"button\" aria-label=\"退出全屏\" @click=\"emit('fullscreen', null)\">\n            <Minimize2 :size=\"13\" aria-hidden=\"true\" />\n          </button>\n          <button class=\"va-dock__op\" type=\"button\" aria-label=\"收起面板区\" @click=\"emit('collapse')\">\n            <Minus :size=\"13\" aria-hidden=\"true\" />\n          </button>\n        </template>\n      </div>\n\n      <div class=\"va-dock__body\">\n        <slot name=\"pane\" :pane-index=\"i\" :tab-id=\"pane.activeId\">\n          <p v-if=\"!pane.tabs.length\" class=\"va-dock__empty va-fade-in\">没有打开的面板，点「＋」添加。</p>\n        </slot>\n      </div>\n    </section>\n\n    <div\n      v-if=\"isSplit && fullscreen === null\"\n      class=\"va-dock__divider\"\n      role=\"separator\"\n      aria-label=\"拖动调整分屏宽度\"\n      @pointerdown.prevent=\"onDividerDown\"\n    />\n  </div>\n</template>\n\n<style>\n/* VaDock — 右侧面板停靠容器（tab 条 + ≤2 分屏 + 全屏） */\n.va-dock {\n  display: flex;\n  flex-direction: column;\n  min-height: 0;\n  min-width: 0;\n  height: 100%;\n  background: var(--va-card, #ffffff);\n  font-family: var(--va-font, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Helvetica Neue\", sans-serif);\n}\n\n.va-dock__pane {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  min-height: 0;\n  flex: 1;\n}\n\n.va-dock__tabs {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  padding: 8px 8px var(--va-s3h, 6px);\n  border-bottom: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  flex-wrap: wrap;\n  min-height: 37px;\n  box-sizing: border-box;\n}\n\n.va-dock__tab {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  border: 0;\n  background: var(--va-bg-subtle, #efede7);\n  color: var(--va-muted, #6f6d66);\n  font: inherit;\n  font-size: var(--va-fs-xs, 11px);\n  border-radius: var(--va-radius-pill, 999px);\n  padding: 3px 9px;\n  cursor: pointer;\n  max-width: 100%;\n}\n.va-dock__tab[data-active=\"true\"] {\n  background: var(--va-ink, #1a1917);\n  color: var(--va-card, #ffffff);\n  font-weight: var(--va-fw-semibold, 600);\n}\n.va-dock__tab-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n\n.va-dock__tabx {\n  display: inline-flex;\n  align-items: center;\n  opacity: 0.55;\n  cursor: pointer;\n  border-radius: 50%;\n}\n.va-dock__tabx:hover { opacity: 1; }\n.va-dock__tab[data-active=\"true\"] .va-dock__tabx:hover { background: rgba(255, 255, 255, 0.18); }\n\n.va-dock__spacer { flex: 1; }\n\n.va-dock__op {\n  flex: none;\n  width: 24px;\n  height: 24px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border: 0;\n  background: none;\n  color: var(--va-muted, #6f6d66);\n  border-radius: var(--va-radius-s, 8px);\n  cursor: pointer;\n}\n.va-dock__op:hover:not(:disabled) { background: var(--va-bg-subtle, #efede7); color: var(--va-ink, #1a1917); }\n.va-dock__op:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: -2px; }\n.va-dock__op:disabled { opacity: 0.4; cursor: default; }\n\n.va-dock__body {\n  flex: 1;\n  min-height: 0;\n  min-width: 0;\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n}\n\n.va-dock__empty {\n  margin: auto;\n  padding: 20px;\n  font-size: var(--va-fs-sm, 12px);\n  color: var(--va-muted, #6f6d66);\n  text-align: center;\n}\n\n/* 分屏：容器转 grid，列宽由 inline style（ratio）控制：pane1 | divider | pane2 */\n.va-dock[data-split=\"true\"] { display: grid; align-items: stretch; }\n.va-dock[data-split=\"true\"] .va-dock__pane { min-height: 0; }\n\n.va-dock__divider {\n  flex: none;\n  align-self: stretch;\n  background: var(--va-edge, rgba(26, 25, 23, 0.12));\n  cursor: col-resize;\n  min-height: 40px;\n}\n.va-dock__divider:hover, .va-dock__divider:active { background: var(--va-accent, #c2410c); }\n\n/* ---- 微交互（TASK-108）：tab/操作钮过渡与分隔条高亮过渡 ---- */\n.va-dock__tab {\n  transition:\n    background-color var(--va-dur-1, 120ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)),\n    color var(--va-dur-1, 120ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-dock__op {\n  transition:\n    background-color var(--va-dur-1, 120ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)),\n    color var(--va-dur-1, 120ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-dock__divider {\n  transition: background-color var(--va-dur-1, 120ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n/* 动效工具类（自动附带，源码中来自全局 motion.css） */\n/* ============================================================\n   共享动效工具类 —— 进出场/交叉淡入的统一协议（TASK-102 动效基建）。\n   组件不逐个发明入场曲线：统一消费 --va-dur-in/--va-dur-out 骨架时长与\n   --va-dist-* 位移档；每条声明自带字面 fallback（registry 单文件拷贝分发\n   要求，与 tokens.css 门禁一致）。\n\n   接入方式二选一：\n   1. Vue <Transition>：\n      <Transition enter-active-class=\"va-enter-up\" leave-active-class=\"va-exit-up\">\n      动画 fill-mode 为 both（延迟期间保持首帧、播完停在终态），\n      无需再配 enter-from-class / leave-to-class；\n   2. 类切换重挂载：骨架 → 内容换节点时给新节点挂 .va-crossfade（纯淡入），\n      离场节点挂 .va-exit-*（更短更快）。\n\n   列表错峰：v-for 子项 :style=\"useStagger().delayStyle(i)\" 配合 .va-enter-*\n   动画类使用（animation-delay 由 composable 编排——.va-enter-* 为 CSS animation，\n   transition-delay 对其零作用，见 composables/useStagger.ts）。\n   ============================================================ */\n\n/* 入场：上浮（自下方 --va-dist-m 浮起） */\n@keyframes va-motion-in-up {\n  from { opacity: 0; transform: translateY(var(--va-dist-m, 8px)); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* 入场：左滑（自左侧 --va-dist-m 滑入） */\n@keyframes va-motion-in-left {\n  from { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n  to { opacity: 1; transform: translateX(0); }\n}\n\n/* 入场：缩放（96% 起放大至原尺寸） */\n@keyframes va-motion-in-scale {\n  from { opacity: 0; transform: scale(0.96); }\n  to { opacity: 1; transform: scale(1); }\n}\n\n/* 离场：与入场互逆（向上/向左飘出、缩回）；时长/曲线由工具类映射 --va-dur-out 骨架 */\n@keyframes va-motion-out-up {\n  from { opacity: 1; transform: translateY(0); }\n  to { opacity: 0; transform: translateY(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-left {\n  from { opacity: 1; transform: translateX(0); }\n  to { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-scale {\n  from { opacity: 1; transform: scale(1); }\n  to { opacity: 0; transform: scale(0.96); }\n}\n\n/* 交叉淡入/淡出（.va-crossfade 骨架→内容交换专用，无位移，避免占位跳变叠加） */\n@keyframes va-motion-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes va-motion-fade-out {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n/* ---- 工具类：入场走 --va-dur-in + ease-out-quart，离场走 --va-dur-out + ease-in-quad ---- */\n\n.va-enter-up {\n  animation: va-motion-in-up var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-left {\n  animation: va-motion-in-left var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-scale {\n  animation: va-motion-in-scale var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-exit-up {\n  animation: va-motion-out-up var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-left {\n  animation: va-motion-out-left var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-scale {\n  animation: va-motion-out-scale var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n/* 骨架 → 内容交叉过渡：新内容纯淡入 */\n.va-crossfade {\n  animation: va-motion-fade-in var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* 空态/轻量状态渐入（TASK-106 弱化档）：仅 opacity、时长走 --va-dur-2，\n   供列表空态提示与一次性状态块使用（空态清单见 TASK-106 报告）。\n   纯 opacity 即动效分频策略的降级终点形态，reduced-motion 下保持原样即可。 */\n.va-fade-in {\n  animation: va-motion-fade-in var(--va-dur-2, 200ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* ---- 静态光斑基类（TASK-105，决策 5「追光」路线基建）----\n   pointer 坐标由 composables/useSpotlight.ts 以 rAF 节流写入 --va-spot-x/y\n   （元素内百分比，光斑数学在 composable 内可单测）；本类只负责 radial 光斑\n   绘制与显隐（:hover 点亮，无 3D 倾斜， glare 数学对齐 VaTiltCard）。\n   --va-spot-* 为 L3 组件钩子口径（宿主可覆盖尺寸/颜色），不进 tokens.css。\n   双降级对齐 VaTiltCard glare：hover: none（触屏）与 reduced-motion 不绘制。 */\n.va-spotlight { position: relative; }\n\n/* ::after 承载光斑（避开组件自身 ::before 用途）；inset 0 + border-radius inherit\n   使光斑天然裁剪在宿主圆角内，无需 overflow: hidden。\n   注意：此 ::after radial 与 components/spotlight-card/VaSpotlightCard.css 的\n   .va-spot-card--spot::after 为 registry 单文件自含有意复制，改动需两处同步。 */\n.va-spotlight::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n  background: radial-gradient(\n    var(--va-spot-size, 240px) circle at var(--va-spot-x, 50%) var(--va-spot-y, 50%),\n    var(--va-spot-color, rgba(255, 255, 255, 0.14)),\n    transparent 65%\n  );\n}\n\n.va-spotlight:hover::after { opacity: 1; }\n\n@media (hover: none) {\n  .va-spotlight::after { display: none; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-spotlight::after { display: none; }\n}\n\n/* ---- 复制反馈标准（TASK-106）：copy→check 交叉过渡 ----\n   容器 .va-copy 为 inline-grid 双内容同格堆叠（格子宽取较宽子项，切换零跳动）：\n   __idle = copy 态内容（图标/文字），__done = check 态内容。\n   copied 置真挂 .va-copy--done：check 以 ease-spring 微弹入场（进入 done 态时\n   transform 的目标态时序换成 --va-ease-spring → 过冲回弹），交叉时长统一 --va-dur-1。\n   消费方：terminal-log（行复制）、code-diff（复制按钮）、message-actions（复制图标）。 */\n.va-copy { display: inline-grid; place-items: center; }\n\n.va-copy__idle,\n.va-copy__done {\n  grid-area: 1 / 1;\n  transition: opacity var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-copy__idle { opacity: 1; transform: scale(1); }\n.va-copy__done { opacity: 0; transform: scale(0.6); }\n\n.va-copy--done .va-copy__done {\n  opacity: 1;\n  transform: scale(1);\n  /* 时序按 transition 属性顺序映射：opacity 仍 ease，transform 换 ease-spring 微弹 */\n  transition-timing-function: var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), var(--va-ease-spring, cubic-bezier(0.34, 1.56, 0.64, 1));\n}\n\n.va-copy--done .va-copy__idle { opacity: 0; transform: scale(0.6); }\n\n@media (prefers-reduced-motion: reduce) {\n  /* 交叉过渡瞬时完成（无位移动画），copied 状态可感知性不受影响 */\n  .va-copy__idle,\n  .va-copy__done { transition: none; }\n}\n\n/* ---- 错误反馈标准（校验失败横向微振）：目标元素挂 .va-shake 播一次 ±3px 微振 ----\n   时长 --va-dur-2 × 2（两拍四峰，克制的「摇头」量级，rubric 校验失败口径）；\n   重复触发需先移除类、强制 reflow 再挂回（封装见 composables/useShake.ts）。\n   reduced-motion 降级为不播：错误状态的可感知性由错误样式本身（描边/文案）承担，\n   动效只做注意力引导——符合头注释「功能动画降级保留状态可感知」的分频策略。\n   消费方：VaStepperForm / VaOtpInput 经 useShake() 程序化触发（defineExpose shake()）；\n   宿主自绘表单可直接挂类。 */\n@keyframes va-motion-shake {\n  20% { transform: translateX(-3px); }\n  40% { transform: translateX(3px); }\n  60% { transform: translateX(-2px); }\n  80% { transform: translateX(2px); }\n}\n\n.va-shake {\n  animation: va-motion-shake calc(var(--va-dur-2, 200ms) * 2) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-shake { animation: none; }\n}\n\n/* ---- 动效分频（对齐 tokens.css 头注释策略）：\n   功能动画降级为纯 opacity——进/出场整体换成 fade keyframes，\n   位移/缩放不再出现（animation-name 顶替，时长/缓动沿用上面的声明）。 */\n@media (prefers-reduced-motion: reduce) {\n  .va-enter-up,\n  .va-enter-left,\n  .va-enter-scale,\n  .va-crossfade {\n    animation-name: va-motion-fade-in;\n  }\n\n  .va-exit-up,\n  .va-exit-left,\n  .va-exit-scale {\n    animation-name: va-motion-fade-out;\n  }\n}\n</style>\n"
    },
