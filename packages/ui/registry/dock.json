    {
      "path": "components/ui/dock/types.ts",
      "type": "registry:ui",
      "target": "components/ui/dock/types.ts",
      "content": "/** VaDock 的类型定义：右侧面板停靠容器（≤2 分屏 + 全屏 + tab 条） */\n\nimport type { Component } from \"vue\";\n\nexport interface DockTab {\n  id: string;\n  /** 展示名（缺省回退 id） */\n  label?: string;\n  /** lucide 图标组件（宿主 markRaw 传入） */\n  icon?: Component;\n  /** 是否可关闭（默认 true） */\n  closable?: boolean;\n}\n\n/** 单个分屏 pane 的受控状态 */\nexport interface DockPaneState {\n  tabs: DockTab[];\n  /** 当前激活 tab（空串 = 空面板） */\n  activeId: string;\n}\n\nexport interface DockProps {\n  /** 1 个 = 单面板；2 个 = 分屏（≤2） */\n  panes: DockPaneState[];\n  /** 分屏分隔位置 0.2–0.8（受控；拖动中实时 emit resize） */\n  ratio?: number;\n  /** 全屏的 pane 下标；null = 非全屏 */\n  fullscreenPane?: number | null;\n  addDisabled?: boolean;\n  splitDisabled?: boolean;\n}\n\nexport interface DockEvents {\n  /** 点击某 pane 的 tab */\n  select: [paneIndex: number, tabId: string];\n  /** 关闭某 pane 的 tab */\n  close: [paneIndex: number, tabId: string];\n  /** 点击某 pane 的「＋」（宿主弹出可添加面板菜单） */\n  add: [paneIndex: number];\n  /** 请求分屏 / 取消分屏 */\n  split: [];\n  unsplit: [];\n  /** 请求某 pane 全屏；再次传 null 退出 */\n  fullscreen: [paneIndex: number | null];\n  /** 拖动分隔条（实时） */\n  resize: [ratio: number];\n  /** 折叠整个 Dock（宿主收起右侧栏） */\n  collapse: [];\n}\n"
    }
