{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "prompt-library",
  "title": "Prompt Library",
  "description": "提示词库：搜索（标题/正文/标签）+ 分类 tab + 卡片网格 + 使用按钮。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `prompts` (PromptItem[]，默认 -)：id/title/body/category/tags\n- `query` (string，默认 内部维护)：受控搜索词\n- `@use` (-，默认 -)：点击使用（携带完整条目）",
  "files": [
    {
      "path": "components/ui/prompt-library/VaPromptLibrary.vue",
      "type": "registry:ui",
      "target": "components/ui/prompt-library/VaPromptLibrary.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, ref } from \"vue\";\nimport type { PromptLibraryEvents, PromptLibraryProps } from \"./types\";\n\nconst props = defineProps<PromptLibraryProps>();\n\nconst emit = defineEmits<PromptLibraryEvents>();\n\nconst innerQuery = ref(\"\");\nconst query = computed(() => props.query ?? innerQuery.value);\n\nfunction onInput(v: string) {\n  innerQuery.value = v;\n  emit(\"update:query\", v);\n}\n\nconst activeCat = ref<string>(\"__all\");\nconst categories = computed(() => {\n  const set = new Set<string>();\n  for (const p of props.prompts) if (p.category) set.add(p.category);\n  return [...set];\n});\n\nconst filtered = computed(() => {\n  const q = query.value.trim().toLowerCase();\n  return props.prompts.filter((p) => {\n    if (activeCat.value !== \"__all\" && p.category !== activeCat.value) return false;\n    if (!q) return true;\n    return (\n      p.title.toLowerCase().includes(q) ||\n      p.body.toLowerCase().includes(q) ||\n      p.tags?.some((t) => t.toLowerCase().includes(q))\n    );\n  });\n});\n</script>\n\n<template>\n  <div class=\"va-pl\">\n    <div class=\"va-pl__bar\">\n      <input\n        class=\"va-pl__search\"\n        type=\"search\"\n        :value=\"query\"\n        :placeholder=\"props.placeholder ?? '搜索提示词…'\"\n        aria-label=\"搜索提示词\"\n        @input=\"onInput(($event.target as HTMLInputElement).value)\"\n      >\n      <div v-if=\"categories.length\" class=\"va-pl__cats\" role=\"tablist\" aria-label=\"分类\">\n        <button\n          class=\"va-pl__cat\"\n          type=\"button\"\n          role=\"tab\"\n          :aria-selected=\"activeCat === '__all'\"\n          :data-active=\"activeCat === '__all'\"\n          @click=\"activeCat = '__all'\"\n        >全部</button>\n        <button\n          v-for=\"c in categories\"\n          :key=\"c\"\n          class=\"va-pl__cat\"\n          type=\"button\"\n          role=\"tab\"\n          :aria-selected=\"activeCat === c\"\n          :data-active=\"activeCat === c\"\n          @click=\"activeCat = c\"\n        >{{ c }}</button>\n      </div>\n    </div>\n\n    <p v-if=\"!filtered.length\" class=\"va-pl__empty\">{{ props.emptyLabel ?? \"没有匹配的提示词\" }}</p>\n    <ul v-else class=\"va-pl__list\">\n      <li v-for=\"p in filtered\" :key=\"p.id\" class=\"va-pl__card\">\n        <header class=\"va-pl__head\">\n          <span class=\"va-pl__title\">{{ p.title }}</span>\n          <span v-if=\"p.category\" class=\"va-pl__badge\">{{ p.category }}</span>\n        </header>\n        <p\n          class=\"va-pl__body\"\n          :style=\"{ maxHeight: `${props.bodyClamp ?? 88}px` }\"\n        >{{ p.body }}</p>\n        <footer class=\"va-pl__foot\">\n          <span v-if=\"p.tags?.length\" class=\"va-pl__tags\">\n            <span v-for=\"t in p.tags\" :key=\"t\" class=\"va-pl__tag\">#{{ t }}</span>\n          </span>\n          <button class=\"va-act va-act--sm va-act--primary va-pl__use\" type=\"button\" @click=\"emit('use', p)\">使用</button>\n        </footer>\n      </li>\n    </ul>\n  </div>\n</template>\n\n<style>\n/* VaPromptLibrary — 提示词库 */\n\n.va-pl {\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s4);\n}\n\n.va-pl__bar {\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s3);\n}\n\n.va-pl__search {\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-card);\n  color: var(--va-ink);\n  font: inherit;\n  font-size: 13px;\n  padding: 8px 12px;\n}\n\n.va-pl__search:focus {\n  outline: none;\n  border-color: var(--va-accent);\n  box-shadow: 0 0 0 3px var(--va-accent-soft);\n}\n\n.va-pl__cats { display: flex; gap: var(--va-s2); flex-wrap: wrap; }\n\n.va-pl__cat {\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-pill);\n  background: var(--va-card);\n  color: var(--va-muted);\n  font-size: 12px;\n  padding: 3px 12px;\n  cursor: pointer;\n}\n\n.va-pl__cat[data-active=\"true\"] {\n  background: var(--va-ink);\n  border-color: var(--va-ink);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-pl__cat:focus-visible { outline: 2px solid var(--va-accent); outline-offset: 1px; }\n\n.va-pl__list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));\n  gap: var(--va-s4);\n}\n\n.va-pl__card {\n  display: flex;\n  flex-direction: column;\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-m);\n  background: var(--va-card);\n  padding: var(--va-s4);\n  transition: border-color var(--va-dur-1) var(--va-ease), box-shadow var(--va-dur-1) var(--va-ease);\n}\n\n.va-pl__card:hover { border-color: var(--va-edge-strong); box-shadow: var(--va-shadow-1); }\n\n.va-pl__head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--va-s3);\n}\n\n.va-pl__title { font-size: 13.5px; font-weight: 600; color: var(--va-ink); }\n\n.va-pl__badge {\n  flex: none;\n  font-size: 10.5px;\n  padding: 1px 8px;\n  border-radius: var(--va-radius-pill);\n  background: var(--va-bg-subtle);\n  color: var(--va-muted);\n}\n\n.va-pl__body {\n  flex: 1;\n  margin: var(--va-s3) 0;\n  font-size: 12.5px;\n  line-height: 1.6;\n  color: var(--va-ink-2);\n  white-space: pre-wrap;\n  overflow: hidden;\n}\n\n.va-pl__foot {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--va-s3);\n}\n\n.va-pl__tags { display: flex; gap: var(--va-s2); flex-wrap: wrap; min-width: 0; }\n\n.va-pl__tag {\n  font-size: 11px;\n  color: var(--va-accent);\n  background: var(--va-accent-soft);\n  border-radius: var(--va-radius-pill);\n  padding: 1px 7px;\n}\n\n\n\n.va-pl__empty {\n  margin: 0;\n  padding: var(--va-s7) var(--va-s4);\n  text-align: center;\n  font-size: 13px;\n  color: var(--va-muted);\n  border: 1px dashed var(--va-edge);\n  border-radius: var(--va-radius-m);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-pl__card { transition: none; }\n}\n\n/* 按钮基类（自动附带） */\n/* ============================================================\n   按钮基类 —— 全库动作按钮的单一样式来源。\n   组件叠加使用：class=\"va-act va-act--primary va-xxx__submit\"，\n   组件自己的 CSS 只写布局/色彩覆盖（width、pill 圆角等）。\n   registry 生成器会把本文件自动内联进用了 va-act 的组件拷贝。\n   ============================================================ */\n\n.va-act {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-card);\n  color: var(--va-ink-2);\n  font: inherit;\n  font-size: 13px;\n  line-height: 1.4;\n  padding: 5px 14px;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: border-color var(--va-dur-1) var(--va-ease), background var(--va-dur-1) var(--va-ease),\n    color var(--va-dur-1) var(--va-ease);\n}\n\n.va-act:hover:not(:disabled) { border-color: var(--va-edge-strong); }\n\n.va-act:focus-visible { outline: 2px solid var(--va-accent); outline-offset: 1px; }\n\n.va-act:disabled { opacity: 0.45; cursor: default; }\n\n/* 尺寸 */\n.va-act--sm { font-size: 12px; padding: 3px 10px; }\n.va-act--lg { font-size: 14px; padding: 7px 18px; }\n\n/* 变体 */\n.va-act--primary {\n  background: var(--va-accent);\n  border-color: var(--va-accent);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-act--primary:hover:not(:disabled) {\n  background: var(--va-accent-hover);\n  border-color: var(--va-accent-hover);\n}\n\n.va-act--ghost {\n  border-color: transparent;\n  background: transparent;\n}\n\n.va-act--ghost:hover:not(:disabled) { background: var(--va-bg-subtle); }\n\n.va-act--danger { border-color: transparent; background: transparent; color: var(--va-danger); }\n\n.va-act--danger:hover:not(:disabled) {\n  background: color-mix(in srgb, var(--va-danger) 10%, transparent);\n  border-color: transparent;\n}\n\n/* 语义色实底（成功/危险确认场景，按需叠加） */\n.va-act--success {\n  background: var(--va-success);\n  border-color: var(--va-success);\n  color: #fff;\n  font-weight: 600;\n}\n\n/* 墨色实底：审批/决策/应用这类\"终审\"主操作（区别于 accent 常规主操作） */\n.va-act--ink {\n  background: var(--va-ink);\n  border-color: var(--va-ink);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-act--ink:hover:not(:disabled) { opacity: 0.88; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-act { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/prompt-library/types.ts",
      "type": "registry:ui",
      "target": "components/ui/prompt-library/types.ts",
      "content": "/** VaPromptLibrary 的类型定义 */\n\nexport interface PromptItem {\n  id: string;\n  title: string;\n  /** 提示词正文 */\n  body: string;\n  category?: string;\n  /** 用途标签 */\n  tags?: string[];\n}\n\nexport interface PromptLibraryProps {\n  prompts: PromptItem[];\n  /** 受控搜索词（不绑则组件内部维护） */\n  query?: string;\n  placeholder?: string;\n  /** 卡片正文折叠高度 px，默认 88 */\n  bodyClamp?: number;\n  /** 空态文案 */\n  emptyLabel?: string;\n}\n\nexport interface PromptLibraryEvents {\n  /** 点击\"使用\" */\n  use: [prompt: PromptItem];\n  /** 搜索词变化（仅宿主受控 query 时需要处理） */\n  \"update:query\": [v: string];\n}\n"
    }
  ]
}
