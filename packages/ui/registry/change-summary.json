{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "change-summary",
  "title": "Change Summary",
  "description": "agent 一轮工作摘要卡：N 文件 +adds −dels、耗时与工具调用次数、逐文件行（M/A/D 徽章 + 增删计数），可折叠长列表。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `files` (SummaryFile[]，默认 -)：path/status/additions/deletions\n- `duration / toolCalls` (number，默认 -)：耗时 ms / 工具调用次数\n- `maxFiles` (number，默认 -)：超出折叠（展开按钮）\n- `@openFile` (-，默认 -)：点击文件行（联动 CodeDiff）",
  "files": [
    {
      "path": "components/ui/change-summary/VaChangeSummary.vue",
      "type": "registry:ui",
      "target": "components/ui/change-summary/VaChangeSummary.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, ref } from \"vue\";\nimport type { ChangeSummaryEvents, ChangeSummaryProps } from \"./types\";\nimport { FILE_STATUS_LABEL } from \"../file-tree/types\";\nimport { formatMs } from \"../../utils/format\";\n\nconst props = defineProps<ChangeSummaryProps>();\n\nconst emit = defineEmits<ChangeSummaryEvents>();\n\nconst totals = computed(() =>\n  props.files.reduce(\n    (acc, f) => ({ additions: acc.additions + (f.additions ?? 0), deletions: acc.deletions + (f.deletions ?? 0) }),\n    { additions: 0, deletions: 0 },\n  ),\n);\n\n/** 超过 maxFiles 时默认折叠 */\nconst collapsed = ref(true);\nconst overflow = computed(() =>\n  props.maxFiles !== undefined ? Math.max(0, props.files.length - props.maxFiles) : 0,\n);\nconst shown = computed(() =>\n  overflow.value && collapsed.value ? props.files.slice(0, props.maxFiles) : props.files,\n);\n</script>\n\n<template>\n  <section class=\"va-cs\" aria-label=\"变更摘要\">\n    <header class=\"va-cs__head\">\n      <span class=\"va-cs__title\">{{ props.title ?? \"本轮变更\" }}</span>\n      <span class=\"va-cs__stats\" role=\"status\">\n        {{ files.length }} 个文件\n        <template v-if=\"totals.additions || totals.deletions\">\n          · <b class=\"va-cs__add\">+{{ totals.additions }}</b> <b class=\"va-cs__del\">−{{ totals.deletions }}</b>\n        </template>\n        <template v-if=\"props.duration\"> · {{ formatMs(props.duration) }}</template>\n        <template v-if=\"props.toolCalls\"> · {{ props.toolCalls }} 次工具调用</template>\n      </span>\n    </header>\n\n    <ul class=\"va-cs__files\">\n      <li v-for=\"f in shown\" :key=\"f.path\">\n        <button class=\"va-cs__file\" type=\"button\" @click=\"emit('openFile', f)\">\n          <span v-if=\"f.status\" class=\"va-cs__status\" :data-status=\"f.status\">{{ FILE_STATUS_LABEL[f.status] }}</span>\n          <span class=\"va-cs__path\">{{ f.path }}</span>\n          <span v-if=\"f.additions || f.deletions\" class=\"va-cs__diff\">\n            <b class=\"va-cs__add\">+{{ f.additions ?? 0 }}</b>\n            <b class=\"va-cs__del\">−{{ f.deletions ?? 0 }}</b>\n          </span>\n        </button>\n      </li>\n    </ul>\n\n    <button v-if=\"overflow\" class=\"va-cs__more\" type=\"button\" @click=\"collapsed = !collapsed; emit('toggleAll')\">\n      {{ collapsed ? `展开其余 ${overflow} 个文件` : `收起，只看前 ${props.maxFiles} 个` }}\n    </button>\n  </section>\n</template>\n\n<style>\n/* VaChangeSummary — agent 一轮工作变更摘要 */\n\n.va-cs {\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-m);\n  background: var(--va-card);\n  padding: var(--va-s4) var(--va-s5);\n}\n\n.va-cs__head {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: var(--va-s4);\n  flex-wrap: wrap;\n  margin-bottom: var(--va-s3);\n}\n\n.va-cs__title { font-size: 14px; font-weight: 700; color: var(--va-ink); }\n\n.va-cs__stats { font-size: 12px; color: var(--va-muted); font-variant-numeric: tabular-nums; }\n\n.va-cs__add { color: var(--va-success); font-weight: 700; }\n.va-cs__del { color: var(--va-danger); font-weight: 700; }\n\n.va-cs__files { list-style: none; margin: 0; padding: 0; }\n\n.va-cs__file {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3);\n  width: 100%;\n  border: 0;\n  border-radius: var(--va-radius-s);\n  background: transparent;\n  padding: 5px var(--va-s2);\n  cursor: pointer;\n  text-align: left;\n  font: inherit;\n}\n\n.va-cs__file:hover { background: var(--va-bg-subtle); }\n.va-cs__file:focus-visible { outline: 2px solid var(--va-accent); outline-offset: -2px; }\n\n.va-cs__status {\n  flex: none;\n  width: 18px;\n  height: 18px;\n  border-radius: 5px;\n  font-size: 11px;\n  font-weight: 700;\n  line-height: 18px;\n  text-align: center;\n  font-family: var(--va-font-mono);\n}\n\n.va-cs__status[data-status=\"modified\"] { background: color-mix(in srgb, var(--va-warning) 16%, transparent); color: var(--va-warning); }\n.va-cs__status[data-status=\"added\"] { background: color-mix(in srgb, var(--va-success) 16%, transparent); color: var(--va-success); }\n.va-cs__status[data-status=\"deleted\"] { background: color-mix(in srgb, var(--va-danger) 14%, transparent); color: var(--va-danger); }\n.va-cs__status[data-status=\"untracked\"] { background: color-mix(in srgb, var(--va-info) 14%, transparent); color: var(--va-info); }\n\n.va-cs__path {\n  flex: 1;\n  min-width: 0;\n  font-family: var(--va-font-mono);\n  font-size: 12px;\n  color: var(--va-ink-2);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.va-cs__diff {\n  flex: none;\n  display: flex;\n  gap: var(--va-s2);\n  font-size: 11px;\n  font-variant-numeric: tabular-nums;\n}\n\n.va-cs__more {\n  display: block;\n  width: 100%;\n  border: 0;\n  border-top: 1px dashed var(--va-edge);\n  background: transparent;\n  color: var(--va-info);\n  font-size: 12px;\n  line-height: 26px;\n  cursor: pointer;\n  margin-top: var(--va-s2);\n}\n\n.va-cs__more:hover { background: color-mix(in srgb, var(--va-info) 6%, transparent); }\n.va-cs__more:focus-visible { outline: 2px solid var(--va-accent); }\n</style>\n"
    },
    {
      "path": "components/ui/change-summary/types.ts",
      "type": "registry:ui",
      "target": "components/ui/change-summary/types.ts",
      "content": "/** VaChangeSummary 的类型定义 */\n\nimport type { FileStatus } from \"../file-tree/types\";\n\nexport interface SummaryFile {\n  path: string;\n  status?: FileStatus;\n  additions?: number;\n  deletions?: number;\n}\n\nexport interface ChangeSummaryProps {\n  /** 本轮运行的标题，如\"重构用户列表页\" */\n  title?: string;\n  files: SummaryFile[];\n  /** 总耗时 ms */\n  duration?: number;\n  /** 使用的工具调用次数 */\n  toolCalls?: number;\n  /** 完成时间（ms 时间戳） */\n  finishedAt?: number;\n  /** 折叠展示文件列表（超过该数量时；默认全部展示） */\n  maxFiles?: number;\n}\n\nexport interface ChangeSummaryEvents {\n  /** 点击文件行（配合 FileTree/CodeDiff 联动） */\n  openFile: [file: SummaryFile];\n  /** 展开/收起长列表 */\n  toggleAll: [];\n}\n"
    }
  ]
}
