{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "change-summary",
  "title": "Change Summary",
  "description": "agent 一轮工作摘要卡：N 文件 +adds −dels、耗时与工具调用次数、逐文件行（M/A/D 徽章 + 增删计数），可折叠长列表。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [
    "@vuagent/file-tree"
  ],
  "docs": "- `files` (SummaryFile[]，默认 -)：path/status/additions/deletions\n- `duration / toolCalls` (number，默认 -)：耗时 ms / 工具调用次数\n- `maxFiles` (number，默认 -)：超出折叠（展开按钮）\n- `@openFile` (-，默认 -)：点击文件行（联动 CodeDiff）",
  "files": [
    {
      "path": "components/ui/change-summary/VaChangeSummary.vue",
      "type": "registry:ui",
      "target": "components/ui/change-summary/VaChangeSummary.vue",
      "content": "<script setup lang=\"ts\">import { computed, ref } from \"vue\";\n\nimport type { ChangeSummaryEvents, ChangeSummaryProps } from \"./types\";\nimport { FILE_STATUS_LABEL } from \"../file-tree/types\";\n\n\nconst props = defineProps<ChangeSummaryProps>();\n\nconst emit = defineEmits<ChangeSummaryEvents>();\n\nconst totals = computed(() =>\n  props.files.reduce(\n    (acc, f) => ({ additions: acc.additions + (f.additions ?? 0), deletions: acc.deletions + (f.deletions ?? 0) }),\n    { additions: 0, deletions: 0 },\n  ),\n);\n\n/** 超过 maxFiles 时默认折叠 */\nconst collapsed = ref(true);\nconst overflow = computed(() =>\n  props.maxFiles !== undefined ? Math.max(0, props.files.length - props.maxFiles) : 0,\n);\nconst shown = computed(() =>\n  overflow.value && collapsed.value ? props.files.slice(0, props.maxFiles) : props.files,\n);\n\n/**\n * 文件行错峰（TASK-108）：统一消费 useStagger（animation-delay 轴，配合 .va-enter-*\n * 动画类使用；默认档位对齐 --va-stagger 40ms 步长、8 档钳制、reduced-motion 归零；\n * SSR 无 window 按正常分支输出，服务端与客户端首帧一致）。\n */\nconst { delayStyle } = useStagger();\n\n/* ── 内联自 @vuagent/ui src/composables/useStagger.ts（registry 单文件拷贝自包含） ── */\n/**\n * 列表子项进出场错峰编排（TASK-102 动效基建）：\n * 返回 delayStyle(index) 供 v-for 子项绑定 :style，配合 .va-enter-* 动画类使用\n * （.va-enter-* 全是 CSS animation，延迟轴为 animation-delay——transition-delay\n * 对 animation 零作用；动画 fill-mode both 保首帧，延迟期间不闪跳）。\n * 步长口径对齐 tokens.css 的 --va-stagger（40ms）；\n * reduced-motion 下延迟归零（动画降级本身由 motion.css 媒体查询处理）。\n *\n * SSR 安全：无 window/matchMedia 时跳过检测、按正常分支返回——服务端与\n * 非 reduced 客户端的首帧输出一致，避免 hydration 抖动；reduced-motion 客户端\n * 首帧为全 0ms、与服务端错峰值有差异，由 Vue hydration 后补丁收敛（轻微）。\n * reduced-motion 检测照抄现有 composable\n * 范式（window.matchMedia?.() 整链短路），挂载时机一次性读取，不监听系统切换。\n */\ninterface UseStaggerOptions {\n  /** 相邻子项延迟步长 ms（默认 40，同 --va-stagger） */\n  stepMs?: number;\n  /** 错峰档位上限：index 超过后钳制在档顶（默认 8，防长列表末项等待过久） */\n  maxItems?: number;\n  /** 置真时恒返回 0ms 延迟（宿主自行关闭错峰） */\n  disabled?: boolean;\n}\n\nfunction useStagger(options: UseStaggerOptions = {}) {\n  const stepMs = options.stepMs ?? 40;\n  const maxItems = options.maxItems ?? 8;\n  const disabled = options.disabled ?? false;\n\n  const reduced =\n    typeof window !== \"undefined\" &&\n    (window.matchMedia?.(\"(prefers-reduced-motion: reduce)\").matches ?? false);\n\n  /** 配合 .va-enter-* 动画类使用：animation-delay 按 0 起步长递增，超过档位上限后钳制 */\n  function delayStyle(index: number): Record<string, string> {\n    if (reduced || disabled) return { \"animation-delay\": \"0ms\" };\n    const delay = Math.min(Math.max(index, 0), maxItems) * stepMs;\n    return { \"animation-delay\": `${delay}ms` };\n  }\n\n  return { delayStyle };\n}\n\n/* ── 内联自 @vuagent/ui src/utils/format.ts（registry 单文件拷贝自包含） ── */\n/** 共享格式化工具（零依赖，SSR 安全） */\n\n/** 1420 → \"1.4s\" · 830 → \"830ms\" · 65_000 → \"1m 05s\" · 3_600_000 → \"1h 00m\" */\nfunction formatMs(ms: number): string {\n  if (!Number.isFinite(ms) || ms < 0) return \"0ms\";\n  if (ms < 1000) return `${Math.round(ms)}ms`;\n  const s = ms / 1000;\n  if (s < 60) return `${s < 10 ? s.toFixed(1) : Math.round(s)}s`;\n  const m = Math.floor(s / 60);\n  if (m < 60) return `${m}m ${String(Math.round(s % 60)).padStart(2, \"0\")}s`;\n  const h = Math.floor(m / 60);\n  if (h < 24) return `${h}h ${String(m % 60).padStart(2, \"0\")}m`;\n  return `${Math.floor(h / 24)}d ${h % 24}h`;\n}\n\n/** 980 → \"980\" · 12_400 → \"12.4K\" · 99_500 → \"99.5K\" · 1_240_000 → \"1.2M\" */\nfunction formatTokens(n: number): string {\n  if (!Number.isFinite(n) || n < 0) return \"0\";\n  if (n < 1000) return String(Math.round(n));\n  if (n < 1_000_000) {\n    const k = n / 1000;\n    const text = k < 100 ? k.toFixed(1).replace(/\\.0$/, \"\") : String(Math.round(k));\n    return `${text}K`;\n  }\n  const m = n / 1_000_000;\n  return m < 100 ? m.toFixed(1).replace(/\\.0$/, \"\") + \"M\" : `${Math.round(m)}M`;\n}\n\n/** 任意值 → 可展示文本：对象美化、JSON 字符串解析后美化、其余原样 */\nfunction toDisplayText(v: unknown): string {\n  if (v == null) return \"\";\n  if (typeof v === \"string\") {\n    const t = v.trim();\n    if (t.startsWith(\"{\") || t.startsWith(\"[\")) {\n      try {\n        return JSON.stringify(JSON.parse(t), null, 2);\n      } catch {\n        return v;\n      }\n    }\n    return v;\n  }\n  if (typeof v === \"object\") {\n    try {\n      return JSON.stringify(v, null, 2);\n    } catch {\n      return String(v);\n    }\n  }\n  return String(v);\n}\n</script>\n\n<template>\n  <!-- 入场（TASK-108）：根卡片上浮，文件行错峰跟随（motion.css 统一协议） -->\n  <section class=\"va-cs va-enter-up\" aria-label=\"变更摘要\">\n    <header class=\"va-cs__head\">\n      <span class=\"va-cs__title\">{{ props.title ?? \"本轮变更\" }}</span>\n      <span class=\"va-cs__stats\" role=\"status\">\n        {{ files.length }} 个文件\n        <template v-if=\"totals.additions || totals.deletions\">\n          · <b class=\"va-cs__add\">+{{ totals.additions }}</b> <b class=\"va-cs__del\">−{{ totals.deletions }}</b>\n        </template>\n        <template v-if=\"props.duration\"> · {{ formatMs(props.duration) }}</template>\n        <template v-if=\"props.toolCalls\"> · {{ props.toolCalls }} 次工具调用</template>\n      </span>\n    </header>\n\n    <ul class=\"va-cs__files\">\n      <li v-for=\"(f, i) in shown\" :key=\"f.path\" class=\"va-enter-up\" :style=\"delayStyle(i)\">\n        <button class=\"va-cs__file\" type=\"button\" @click=\"emit('openFile', f)\">\n          <span v-if=\"f.status\" class=\"va-cs__status\" :data-status=\"f.status\">{{ FILE_STATUS_LABEL[f.status] }}</span>\n          <span class=\"va-cs__path\">{{ f.path }}</span>\n          <span v-if=\"f.additions || f.deletions\" class=\"va-cs__diff\">\n            <b class=\"va-cs__add\">+{{ f.additions ?? 0 }}</b>\n            <b class=\"va-cs__del\">−{{ f.deletions ?? 0 }}</b>\n          </span>\n        </button>\n      </li>\n    </ul>\n\n    <button v-if=\"overflow\" class=\"va-cs__more\" type=\"button\" @click=\"collapsed = !collapsed; emit('toggleAll')\">\n      {{ collapsed ? `展开其余 ${overflow} 个文件` : `收起，只看前 ${props.maxFiles} 个` }}\n    </button>\n  </section>\n</template>\n\n<style>\n/* VaChangeSummary — agent 一轮工作变更摘要 */\n\n.va-cs {\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-m, 10px);\n  background: var(--va-card, #ffffff);\n  padding: var(--va-s4, 12px) var(--va-s5, 16px);\n}\n\n.va-cs__head {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: var(--va-s4, 12px);\n  flex-wrap: wrap;\n  margin-bottom: var(--va-s3, 8px);\n}\n\n.va-cs__title { font-size: var(--va-fs-lg, 14px); font-weight: var(--va-fw-bold, 700); color: var(--va-ink, #1a1917); }\n\n.va-cs__stats { font-size: var(--va-fs-sm, 12px); color: var(--va-muted, #6f6d66); font-variant-numeric: tabular-nums; }\n\n.va-cs__add { color: var(--va-success, #1a7f4b); font-weight: var(--va-fw-bold, 700); }\n.va-cs__del { color: var(--va-danger, #d5453c); font-weight: var(--va-fw-bold, 700); }\n\n.va-cs__files { list-style: none; margin: 0; padding: 0; }\n\n.va-cs__file {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3, 8px);\n  width: 100%;\n  border: 0;\n  border-radius: var(--va-radius-s, 8px);\n  background: transparent;\n  padding: 5px var(--va-s2, 4px);\n  cursor: pointer;\n  text-align: left;\n  font: inherit;\n}\n\n.va-cs__file:hover { background: var(--va-bg-subtle, #efede7); }\n.va-cs__file:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: -2px; }\n\n.va-cs__status {\n  flex: none;\n  width: 18px;\n  height: 18px;\n  border-radius: 5px;\n  font-size: var(--va-fs-xs, 11px);\n  font-weight: var(--va-fw-bold, 700);\n  line-height: 18px;\n  text-align: center;\n  font-family: var(--va-font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);\n}\n\n.va-cs__status[data-status=\"modified\"] { background: color-mix(in srgb, var(--va-warning, #b45309) 16%, transparent); color: var(--va-warning, #b45309); }\n.va-cs__status[data-status=\"added\"] { background: color-mix(in srgb, var(--va-success, #1a7f4b) 16%, transparent); color: var(--va-success, #1a7f4b); }\n.va-cs__status[data-status=\"deleted\"] { background: color-mix(in srgb, var(--va-danger, #d5453c) 14%, transparent); color: var(--va-danger, #d5453c); }\n.va-cs__status[data-status=\"untracked\"] { background: color-mix(in srgb, var(--va-info, #2563eb) 14%, transparent); color: var(--va-info, #2563eb); }\n\n.va-cs__path {\n  flex: 1;\n  min-width: 0;\n  font-family: var(--va-font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);\n  font-size: var(--va-fs-sm, 12px);\n  color: var(--va-ink-2, #43413c);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.va-cs__diff {\n  flex: none;\n  display: flex;\n  gap: var(--va-s2, 4px);\n  font-size: var(--va-fs-xs, 11px);\n  font-variant-numeric: tabular-nums;\n}\n\n.va-cs__more {\n  display: block;\n  width: 100%;\n  border: 0;\n  border-top: 1px dashed var(--va-edge, rgba(26, 25, 23, 0.12));\n  background: transparent;\n  color: var(--va-info, #2563eb);\n  font-size: var(--va-fs-sm, 12px);\n  line-height: 26px;\n  cursor: pointer;\n  margin-top: var(--va-s2, 4px);\n}\n\n.va-cs__more:hover { background: color-mix(in srgb, var(--va-info, #2563eb) 6%, transparent); }\n.va-cs__more:focus-visible { outline: 2px solid var(--va-accent, #c2410c); }\n\n/* TASK-108 交互反馈：展开/收起按钮 hover 平滑过渡 */\n.va-cs__more {\n  transition: background-color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-cs__more { transition: none; }\n}\n\n/* 动效工具类（自动附带，源码中来自全局 motion.css） */\n/* ============================================================\n   共享动效工具类 —— 进出场/交叉淡入的统一协议（TASK-102 动效基建）。\n   组件不逐个发明入场曲线：统一消费 --va-dur-in/--va-dur-out 骨架时长与\n   --va-dist-* 位移档；每条声明自带字面 fallback（registry 单文件拷贝分发\n   要求，与 tokens.css 门禁一致）。\n\n   接入方式二选一：\n   1. Vue <Transition>：\n      <Transition enter-active-class=\"va-enter-up\" leave-active-class=\"va-exit-up\">\n      动画 fill-mode 为 both（延迟期间保持首帧、播完停在终态），\n      无需再配 enter-from-class / leave-to-class；\n   2. 类切换重挂载：骨架 → 内容换节点时给新节点挂 .va-crossfade（纯淡入），\n      离场节点挂 .va-exit-*（更短更快）。\n\n   列表错峰：v-for 子项 :style=\"useStagger().delayStyle(i)\" 配合 .va-enter-*\n   动画类使用（animation-delay 由 composable 编排——.va-enter-* 为 CSS animation，\n   transition-delay 对其零作用，见 composables/useStagger.ts）。\n   ============================================================ */\n\n/* 入场：上浮（自下方 --va-dist-m 浮起） */\n@keyframes va-motion-in-up {\n  from { opacity: 0; transform: translateY(var(--va-dist-m, 8px)); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* 入场：左滑（自左侧 --va-dist-m 滑入） */\n@keyframes va-motion-in-left {\n  from { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n  to { opacity: 1; transform: translateX(0); }\n}\n\n/* 入场：缩放（96% 起放大至原尺寸） */\n@keyframes va-motion-in-scale {\n  from { opacity: 0; transform: scale(0.96); }\n  to { opacity: 1; transform: scale(1); }\n}\n\n/* 离场：与入场互逆（向上/向左飘出、缩回）；时长/曲线由工具类映射 --va-dur-out 骨架 */\n@keyframes va-motion-out-up {\n  from { opacity: 1; transform: translateY(0); }\n  to { opacity: 0; transform: translateY(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-left {\n  from { opacity: 1; transform: translateX(0); }\n  to { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-scale {\n  from { opacity: 1; transform: scale(1); }\n  to { opacity: 0; transform: scale(0.96); }\n}\n\n/* 交叉淡入/淡出（.va-crossfade 骨架→内容交换专用，无位移，避免占位跳变叠加） */\n@keyframes va-motion-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes va-motion-fade-out {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n/* ---- 工具类：入场走 --va-dur-in + ease-out-quart，离场走 --va-dur-out + ease-in-quad ---- */\n\n.va-enter-up {\n  animation: va-motion-in-up var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-left {\n  animation: va-motion-in-left var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-scale {\n  animation: va-motion-in-scale var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-exit-up {\n  animation: va-motion-out-up var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-left {\n  animation: va-motion-out-left var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-scale {\n  animation: va-motion-out-scale var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n/* 骨架 → 内容交叉过渡：新内容纯淡入 */\n.va-crossfade {\n  animation: va-motion-fade-in var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* 空态/轻量状态渐入（TASK-106 弱化档）：仅 opacity、时长走 --va-dur-2，\n   供列表空态提示与一次性状态块使用（空态清单见 TASK-106 报告）。\n   纯 opacity 即动效分频策略的降级终点形态，reduced-motion 下保持原样即可。 */\n.va-fade-in {\n  animation: va-motion-fade-in var(--va-dur-2, 200ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* ---- 静态光斑基类（TASK-105，决策 5「追光」路线基建）----\n   pointer 坐标由 composables/useSpotlight.ts 以 rAF 节流写入 --va-spot-x/y\n   （元素内百分比，光斑数学在 composable 内可单测）；本类只负责 radial 光斑\n   绘制与显隐（:hover 点亮，无 3D 倾斜， glare 数学对齐 VaTiltCard）。\n   --va-spot-* 为 L3 组件钩子口径（宿主可覆盖尺寸/颜色），不进 tokens.css。\n   双降级对齐 VaTiltCard glare：hover: none（触屏）与 reduced-motion 不绘制。 */\n.va-spotlight { position: relative; }\n\n/* ::after 承载光斑（避开组件自身 ::before 用途）；inset 0 + border-radius inherit\n   使光斑天然裁剪在宿主圆角内，无需 overflow: hidden。\n   注意：此 ::after radial 与 components/spotlight-card/VaSpotlightCard.css 的\n   .va-spot-card--spot::after 为 registry 单文件自含有意复制，改动需两处同步。 */\n.va-spotlight::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n  background: radial-gradient(\n    var(--va-spot-size, 240px) circle at var(--va-spot-x, 50%) var(--va-spot-y, 50%),\n    var(--va-spot-color, rgba(255, 255, 255, 0.14)),\n    transparent 65%\n  );\n}\n\n.va-spotlight:hover::after { opacity: 1; }\n\n@media (hover: none) {\n  .va-spotlight::after { display: none; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-spotlight::after { display: none; }\n}\n\n/* ---- 复制反馈标准（TASK-106）：copy→check 交叉过渡 ----\n   容器 .va-copy 为 inline-grid 双内容同格堆叠（格子宽取较宽子项，切换零跳动）：\n   __idle = copy 态内容（图标/文字），__done = check 态内容。\n   copied 置真挂 .va-copy--done：check 以 ease-spring 微弹入场（进入 done 态时\n   transform 的目标态时序换成 --va-ease-spring → 过冲回弹），交叉时长统一 --va-dur-1。\n   消费方：terminal-log（行复制）、code-diff（复制按钮）、message-actions（复制图标）。 */\n.va-copy { display: inline-grid; place-items: center; }\n\n.va-copy__idle,\n.va-copy__done {\n  grid-area: 1 / 1;\n  transition: opacity var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-copy__idle { opacity: 1; transform: scale(1); }\n.va-copy__done { opacity: 0; transform: scale(0.6); }\n\n.va-copy--done .va-copy__done {\n  opacity: 1;\n  transform: scale(1);\n  /* 时序按 transition 属性顺序映射：opacity 仍 ease，transform 换 ease-spring 微弹 */\n  transition-timing-function: var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), var(--va-ease-spring, cubic-bezier(0.34, 1.56, 0.64, 1));\n}\n\n.va-copy--done .va-copy__idle { opacity: 0; transform: scale(0.6); }\n\n@media (prefers-reduced-motion: reduce) {\n  /* 交叉过渡瞬时完成（无位移动画），copied 状态可感知性不受影响 */\n  .va-copy__idle,\n  .va-copy__done { transition: none; }\n}\n\n/* ---- 错误反馈标准（校验失败横向微振）：目标元素挂 .va-shake 播一次 ±3px 微振 ----\n   时长 --va-dur-2 × 2（两拍四峰，克制的「摇头」量级，rubric 校验失败口径）；\n   重复触发需先移除类、强制 reflow 再挂回（封装见 composables/useShake.ts）。\n   reduced-motion 降级为不播：错误状态的可感知性由错误样式本身（描边/文案）承担，\n   动效只做注意力引导——符合头注释「功能动画降级保留状态可感知」的分频策略。\n   消费方：VaStepperForm / VaOtpInput 经 useShake() 程序化触发（defineExpose shake()）