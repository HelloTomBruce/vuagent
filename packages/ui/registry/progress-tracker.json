{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "progress-tracker",
  "title": "Progress Tracker",
  "description": "步骤进度条（横/竖）：done/current/pending/error 四态节点 + 完成段连线填充，点击节点回调。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `steps` (TrackerStep[]，默认 -)：label/status（缺省按 current 推断）\n- `current` (number，默认 0)：当前步下标\n- `orientation` (\"horizontal\" | \"vertical\"，默认 \"horizontal\")：方向",
  "files": [
    {
      "path": "components/ui/progress-tracker/VaProgressTracker.vue",
      "type": "registry:ui",
      "target": "components/ui/progress-tracker/VaProgressTracker.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from \"vue\";\nimport type { ProgressTrackerEvents, ProgressTrackerProps, TrackerStepStatus } from \"./types\";\n\nconst props = defineProps<ProgressTrackerProps>();\n\nconst emit = defineEmits<ProgressTrackerEvents>();\n\nconst statusOf = (i: number): TrackerStepStatus => {\n  const s = props.steps[i]!.status;\n  if (s) return s;\n  const cur = props.current ?? 0;\n  if (i < cur) return \"done\";\n  if (i === cur) return \"current\";\n  return \"pending\";\n};\n\n/** 完成比例（连接线填充），0-1 */\nconst ratio = computed(() => {\n  const n = props.steps.length - 1;\n  if (n <= 0) return 0;\n  const doneCount = props.steps.filter((_, i) => statusOf(i) === \"done\").length;\n  return doneCount / n;\n});\n</script>\n\n<template>\n  <ol\n    class=\"va-pt\"\n    :data-orientation=\"props.orientation ?? 'horizontal'\"\n    :style=\"ratio ? { '--va-pt-fill': `${ratio * 100}%` } : { '--va-pt-fill': '0%' }\"\n  >\n    <li\n      v-for=\"(s, i) in props.steps\"\n      :key=\"i\"\n      class=\"va-pt__step\"\n      :data-status=\"statusOf(i)\"\n    >\n      <button class=\"va-pt__node\" type=\"button\" :aria-current=\"statusOf(i) === 'current' ? 'step' : undefined\" @click=\"emit('select', i)\">\n        <span class=\"va-pt__dot\" aria-hidden=\"true\">\n          <template v-if=\"statusOf(i) === 'done'\">✓</template>\n          <template v-else-if=\"statusOf(i) === 'error'\">!</template>\n        </span>\n        <span class=\"va-pt__label\">{{ s.label }}</span>\n      </button>\n    </li>\n  </ol>\n</template>\n\n<style>\n/* VaProgressTracker — 步骤进度条（横/竖） */\n\n.va-pt {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  --va-pt-fill: 0%;\n}\n\n.va-pt[data-orientation=\"vertical\"] { flex-direction: column; gap: var(--va-s2); }\n.va-pt[data-orientation=\"horizontal\"] { align-items: flex-start; }\n\n.va-pt__step {\n  flex: 1;\n  display: flex;\n  position: relative;\n}\n\n/* 横向：节点间连接线（完成段高亮） */\n.va-pt[data-orientation=\"horizontal\"] .va-pt__step:not(:first-child)::before {\n  content: \"\";\n  position: absolute;\n  top: 12px;\n  right: calc(50% + 14px);\n  left: calc(-50% + 14px);\n  height: 2px;\n  background: linear-gradient(\n    to right,\n    var(--va-accent) min(var(--va-pt-fill), 100%),\n    var(--va-edge) min(var(--va-pt-fill), 100%)\n  );\n}\n\n/* 竖向：节点下连接线 */\n.va-pt[data-orientation=\"vertical\"] .va-pt__step:not(:last-child)::before {\n  content: \"\";\n  position: absolute;\n  left: 11px;\n  top: 26px;\n  bottom: -6px;\n  width: 2px;\n  background: var(--va-edge);\n}\n\n.va-pt[data-orientation=\"vertical\"] .va-pt__step[data-status=\"done\"]:not(:last-child)::before {\n  background: var(--va-accent);\n}\n\n.va-pt__node {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3);\n  border: 0;\n  background: transparent;\n  padding: 0;\n  cursor: pointer;\n  font: inherit;\n  width: 100%;\n}\n\n.va-pt[data-orientation=\"horizontal\"] .va-pt__node {\n  flex-direction: column;\n  gap: 6px;\n  align-items: center;\n  text-align: center;\n}\n\n.va-pt__node:focus-visible { outline: none; }\n.va-pt__node:focus-visible .va-pt__dot { box-shadow: 0 0 0 3px var(--va-accent-soft); }\n\n.va-pt__dot {\n  width: 24px;\n  height: 24px;\n  border-radius: 50%;\n  border: 2px solid var(--va-edge-strong);\n  background: var(--va-card);\n  color: transparent;\n  font-size: 12px;\n  font-weight: 700;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex: none;\n  transition: all var(--va-dur-2) var(--va-ease);\n  box-sizing: border-box;\n}\n\n.va-pt__step[data-status=\"done\"] .va-pt__dot {\n  border-color: var(--va-success);\n  background: var(--va-success);\n  color: #fff;\n}\n\n.va-pt__step[data-status=\"current\"] .va-pt__dot {\n  border-color: var(--va-accent);\n  box-shadow: 0 0 0 4px var(--va-accent-soft);\n}\n\n.va-pt__step[data-status=\"error\"] .va-pt__dot {\n  border-color: var(--va-danger);\n  color: var(--va-danger);\n}\n\n.va-pt__label {\n  font-size: 12.5px;\n  color: var(--va-muted);\n}\n\n.va-pt__step[data-status=\"current\"] .va-pt__label { color: var(--va-ink); font-weight: 600; }\n.va-pt__step[data-status=\"done\"] .va-pt__label { color: var(--va-ink-2); }\n.va-pt__step[data-status=\"error\"] .va-pt__label { color: var(--va-danger); }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-pt__dot { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/progress-tracker/types.ts",
      "type": "registry:ui",
      "target": "components/ui/progress-tracker/types.ts",
      "content": "/** VaProgressTracker 的类型定义 */\n\nexport type TrackerStepStatus = \"pending\" | \"current\" | \"done\" | \"error\";\n\nexport interface TrackerStep {\n  label: string;\n  /** 缺省按位置推断：当前位置 current、之前 done、之后 pending */\n  status?: TrackerStepStatus;\n}\n\nexport interface ProgressTrackerProps {\n  steps: TrackerStep[];\n  /** 当前步下标（steps 未显式给 status 时按此推断） */\n  current?: number;\n  orientation?: \"horizontal\" | \"vertical\";\n}\n\nexport interface ProgressTrackerEvents {\n  /** 点击步骤节点（横向可作跳转；携带下标） */\n  select: [index: number];\n}\n"
    }
  ]
}
