{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "user-bubble",
  "title": "User Bubble",
  "description": "用户提问气泡：支持头像、文本排版，以及多模态图片和文档附件的即时预览。",
  "type": "registry:ui",
  "dependencies": [
    "lucide-vue-next"
  ],
  "registryDependencies": [],
  "docs": "- `content` (string，默认 \"\")：提问文本内容\n- `attachments` (UserAttachment[]，默认 [])：多模态附件列表\n- `avatar` (string，默认 \"你\")：用户头像文字/图片链接",
  "files": [
    {
      "path": "components/ui/user-bubble/VaUserBubble.vue",
      "type": "registry:ui",
      "target": "components/ui/user-bubble/VaUserBubble.vue",
      "content": "<script setup lang=\"ts\">\nimport { User } from \"lucide-vue-next\";\nimport type { UserBubbleProps } from \"./types\";\n\nconst props = withDefaults(defineProps<UserBubbleProps>(), {\n  content: \"\",\n  attachments: () => [],\n  avatar: \"你\",\n  time: undefined,\n});\n</script>\n\n<template>\n  <div class=\"va-user-bubble-row\">\n    <div class=\"va-user-bubble\">\n      <div class=\"va-user-bubble__body\">\n        <!-- 附件列表插槽或默认渲染 -->\n        <slot name=\"attachments\" :attachments=\"props.attachments\">\n          <div v-if=\"props.attachments?.length\" class=\"va-user-bubble__atts\">\n            <template v-for=\"(att, idx) in props.attachments\" :key=\"`${att.name}-${idx}`\">\n              <a\n                v-if=\"att.kind === 'image' && (att.dataUrl || att.url)\"\n                :href=\"att.dataUrl || att.url\"\n                target=\"_blank\"\n                rel=\"noopener\"\n                class=\"va-user-bubble__att-img-link\"\n                :title=\"`${att.name}（点击查看原图）`\"\n              >\n                <img :src=\"att.dataUrl || att.url\" :alt=\"att.name\" class=\"va-user-bubble__att-img\" />\n              </a>\n              <span\n                v-else\n                class=\"va-user-bubble__att-chip\"\n                :title=\"att.size ? `${att.name} · ${att.size} B` : att.name\"\n              >\n                📎 {{ att.name }}\n              </span>\n            </template>\n          </div>\n        </slot>\n\n        <!-- 正文文本 -->\n        <slot>\n          <p class=\"va-user-bubble__text\">{{ props.content }}</p>\n        </slot>\n      </div>\n\n      <!-- 头像 -->\n      <slot name=\"avatar\">\n        <div class=\"va-user-bubble__avatar\">\n          <img v-if=\"props.avatar && props.avatar.startsWith('http')\" :src=\"props.avatar\" alt=\"User\" />\n          <User v-else-if=\"props.avatar === 'icon'\" :size=\"16\" />\n          <span v-else>{{ props.avatar || \"你\" }}</span>\n        </div>\n      </slot>\n    </div>\n  </div>\n</template>\n\n<style>\n.va-user-bubble-row {\n  display: flex;\n  justify-content: flex-end;\n  margin-bottom: 16px;\n  width: 100%;\n}\n\n.va-user-bubble {\n  display: flex;\n  align-items: flex-start;\n  gap: 10px;\n  max-width: 85%;\n}\n\n.va-user-bubble__body {\n  background: var(--va-accent-soft, rgba(194, 65, 12, 0.08));\n  border: 1px solid var(--va-accent-subtle, rgba(194, 65, 12, 0.18));\n  border-radius: var(--va-radius-l, 14px);\n  border-top-right-radius: 4px;\n  padding: 10px 14px;\n  color: var(--va-ink, #1c1917);\n  font-size: 14px;\n  line-height: 1.6;\n}\n\n.va-user-bubble__text {\n  margin: 0;\n  white-space: pre-wrap;\n  word-break: break-word;\n}\n\n.va-user-bubble__avatar {\n  width: 32px;\n  height: 32px;\n  border-radius: 50%;\n  background: var(--va-ink, #1c1917);\n  color: var(--va-bg, #ffffff);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 13px;\n  font-weight: 600;\n  flex-shrink: 0;\n  overflow: hidden;\n}\n\n.va-user-bubble__avatar img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n/* 附件区域 */\n.va-user-bubble__atts {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  margin-bottom: 8px;\n}\n\n.va-user-bubble__att-img-link {\n  display: inline-block;\n  border-radius: var(--va-radius-s, 8px);\n  overflow: hidden;\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.15));\n}\n\n.va-user-bubble__att-img {\n  display: block;\n  max-width: 160px;\n  max-height: 120px;\n  object-fit: cover;\n}\n\n.va-user-bubble__att-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  padding: 2px 8px;\n  background: var(--va-bg-subtle, rgba(0, 0, 0, 0.05));\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-s, 6px);\n  font-size: 11.5px;\n  color: var(--va-ink-2, #57534e);\n}\n</style>\n"
    },
    {
      "path": "components/ui/user-bubble/index.ts",
      "type": "registry:ui",
      "target": "components/ui/user-bubble/index.ts",
      "content": "export { default as VaUserBubble } from \"./VaUserBubble.vue\";\nexport type { UserBubbleProps, UserAttachment } from \"./types\";\n"
    },
    {
      "path": "components/ui/user-bubble/types.ts",
      "type": "registry:ui",
      "target": "components/ui/user-bubble/types.ts",
      "content": "export interface UserAttachment {\n  /** 附件类型：图片或通用文件 */\n  kind: \"image\" | \"file\";\n  /** 附件文件名 */\n  name: string;\n  /** 文件大小（字节） */\n  size?: number;\n  /** 图片 base64 / data URL，用于即时预览 */\n  dataUrl?: string;\n  /** 外部链接地址 */\n  url?: string;\n}\n\nexport interface UserBubbleProps {\n  /** 用户提问正文 */\n  content?: string;\n  /** 多模态附件列表（图片、文本、文档） */\n  attachments?: UserAttachment[];\n  /** 用户头像或名称缩写 */\n  avatar?: string;\n  /** 发送时间戳或可读时间文本 */\n  time?: string | number;\n}\n"
    }
  ]
}
