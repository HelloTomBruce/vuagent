{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "form",
  "title": "Form",
  "description": "L2 值采集表单卡（ui_form）：六型字段（text/textarea/number/boolean/select/date）、必填星标、敏感字段密码态与显隐切换、单位后缀、server 422 fieldErrors 就地回显（用户修正后重提，§4.2 重填闭环）。resultSchema 由 fields 派生（deriveFormResultSchema，模型不允许自行声明）。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [
    "@vuagent/button",
    "@vuagent/select"
  ],
  "docs": "- `title / description` (string / string，默认 -)：表单标题 / 为什么需要这些信息\n- `fields` (FormFieldItem[]，默认 -)：字段定义（key/label/type/required/default/options/unit/secret/placeholder）\n- `fieldErrors` (Record<string, string>，默认 -)：server 422 回填的逐字段错误\n- `disabled / loading` (boolean / boolean，默认 false / false)：非 executing 态禁用整表 / 提交中\n- `@submit` ((values, editedFields) => void，默认 -)：提交：类型收敛后的值集合 + 用户亲自修改的字段 key\n- `@cancel` (()，默认 -)：取消（cancel 信封：一等公民而非错误）",
  "files": [
    {
      "path": "components/ui/form/VaForm.vue",
      "type": "registry:ui",
      "target": "components/ui/form/VaForm.vue",
      "content": "<script setup lang=\"ts\">\nimport { ref, watch } from \"vue\";\nimport { VaButton } from \"../button\";\nimport { VaSelect } from \"../select\";\nimport type { FormFieldItem, VaFormProps } from \"./types\";\n\nconst props = withDefaults(defineProps<VaFormProps>(), {\n  title: undefined,\n  description: undefined,\n  submitLabel: \"提交\",\n  cancelLabel: \"取消\",\n  disabled: false,\n  loading: false,\n  fieldErrors: undefined,\n});\n\nconst emit = defineEmits<{\n  (e: \"submit\", values: Record<string, unknown>, editedFields: string[]): void;\n  (e: \"cancel\"): void;\n}>();\n\n/** 类型化初值：default 优先，按字段类型兜底（args 为不可信输入，default 需类型核验） */\nfunction typedInitial(field: FormFieldItem): unknown {\n  const d = field.default;\n  switch (field.type) {\n    case \"number\":\n      return typeof d === \"number\" && Number.isFinite(d) ? d : undefined;\n    case \"boolean\":\n      return typeof d === \"boolean\" ? d : false;\n    case \"select\":\n      return typeof d === \"string\" ? d : \"\";\n    default:\n      // text / textarea / date：字符串类，default 允许 string，其余不透传脏值\n      return typeof d === \"string\" ? d : \"\";\n  }\n}\n\nconst values = ref<Record<string, unknown>>({});\nconst editedKeys = ref<Record<string, true>>({});\n/** 用户提交后的本地校验错误（required/类型收敛）；server fieldErrors 走 props */\nconst localErrors = ref<Record<string, string>>({});\n/** 用户在提交后修改过的字段：其 server 错误视为已过期，就地隐藏 */\nconst editedSinceSubmit = ref<Record<string, true>>({});\n\nconst reset = () => {\n  const next: Record<string, unknown> = {};\n  // 保留键防御（评审 N-12）：字段 key 来自模型 args，过滤原型污染键\n  const safe = props.fields.filter((f) => !/^(?:__proto__|constructor|prototype)$/.test(f.key));\n  for (const field of safe) next[field.key] = typedInitial(field);\n  values.value = next;\n  editedKeys.value = {};\n  localErrors.value = {};\n  editedSinceSubmit.value = {};\n};\n\n// 按字段集**结构签名**监听（评审 C-2 修复）：propAdapter 每次 recompute 产出新数组\n// 引用（如 422 回填 formFieldErrors 触发 computed 重算），按引用比较会 reset() 清空\n// 用户全部已填值——击穿 §4.2「校验失败是重填的新输入」承诺。仅当字段集真正变化\n// （key+type 序列化）才重置。\nconst fieldsSignature = () => props.fields.map((f) => `${f.key}:${f.type}`).join(\"|\");\nwatch(fieldsSignature, reset, { immediate: true });\n\nconst markEdited = (key: string) => {\n  editedKeys.value[key] = true;\n  editedSinceSubmit.value[key] = true;\n  if (localErrors.value[key]) {\n    const { [key]: _dropped, ...rest } = localErrors.value;\n    localErrors.value = rest;\n  }\n};\n\n/** 展示错误优先级：本地即时校验 > server 回填（用户已改过的 server 错误就地隐藏） */\nconst errorOf = (key: string): string | undefined => {\n  if (localErrors.value[key]) return localErrors.value[key];\n  if (editedSinceSubmit.value[key]) return undefined;\n  return props.fieldErrors?.[key];\n};\n\nconst secretVisible = ref<Record<string, boolean>>({});\nconst inputTypeOf = (field: FormFieldItem): string => {\n  if (field.type === \"number\") return \"number\";\n  if (field.type === \"date\") return \"date\";\n  if (field.secret) return secretVisible.value[field.key] ? \"text\" : \"password\";\n  return \"text\";\n};\n\nconst isEmpty = (v: unknown): boolean =>\n  v === undefined || v === null || (typeof v === \"string\" && v.trim() === \"\");\n\n/** 提交前类型收敛 + required 校验（UX 层；权威校验在 server 边界，设计文档 §8） */\nconst converge = (): { values: Record<string, unknown>; errors: Record<string, string> } => {\n  const out: Record<string, unknown> = {};\n  const errors: Record<string, string> = {};\n  for (const field of props.fields) {\n    // 保留键防御（与 reset 同口径）\n    if (/^(?:__proto__|constructor|prototype)$/.test(field.key)) continue;\n    const raw = values.value[field.key];\n    if (field.type === \"boolean\") {\n      out[field.key] = raw === true;\n      continue;\n    }\n    if (isEmpty(raw)) {\n      if (field.required) errors[field.key] = \"必填项\";\n      out[field.key] = field.type === \"number\" ? undefined : \"\";\n      continue;\n    }\n    if (field.type === \"number\") {\n      const n = typeof raw === \"number\" ? raw : Number(String(raw).trim());\n      if (!Number.isFinite(n)) {\n        errors[field.key] = \"必须是数字\";\n        out[field.key] = undefined;\n        continue;\n      }\n      out[field.key] = n;\n      continue;\n    }\n    out[field.key] = String(raw).trim();\n  }\n  return { values: out, errors };\n};\n\nconst onSubmit = () => {\n  if (props.disabled || props.loading) return;\n  const { values: converged, errors } = converge();\n  if (Object.keys(errors).length > 0) {\n    localErrors.value = errors;\n    return;\n  }\n  localErrors.value = {};\n  editedSinceSubmit.value = {};\n  emit(\"submit\", converged, Object.keys(editedKeys.value));\n};\n</script>\n\n<template>\n  <section class=\"va-form\" :class=\"{ 'va-form--disabled': disabled }\">\n    <header v-if=\"title || description\" class=\"va-form__head\">\n      <h4 v-if=\"title\" class=\"va-form__title\">{{ title }}</h4>\n      <p v-if=\"description\" class=\"va-form__desc\">{{ description }}</p>\n    </header>\n\n    <div class=\"va-form__fields\">\n      <div\n        v-for=\"field in fields\"\n        :key=\"field.key\"\n        class=\"va-form__field\"\n      >\n        <label\n          v-if=\"field.type !== 'select'\"\n          :for=\"`va-form-${field.key}`\"\n          class=\"va-form__label\"\n        >\n          {{ field.label }}\n          <span v-if=\"field.required\" class=\"va-form__req\" aria-hidden=\"true\">*</span>\n          <span v-if=\"field.secret\" class=\"va-form__badge\">敏感</span>\n        </label>\n        <span v-else :id=\"`va-form-lbl-${field.key}`\" class=\"va-form__label\">\n          {{ field.label }}\n          <span v-if=\"field.required\" class=\"va-form__req\" aria-hidden=\"true\">*</span>\n          <span v-if=\"field.secret\" class=\"va-form__badge\">敏感</span>\n        </span>\n\n        <div class=\"va-form__control-row\">\n          <textarea\n            v-if=\"field.type === 'textarea'\"\n            :id=\"`va-form-${field.key}`\"\n            v-model=\"values[field.key] as string\"\n            class=\"va-form__control va-form__control--area\"\n            :class=\"{ 'va-form__control--error': errorOf(field.key) }\"\n            :placeholder=\"field.placeholder\"\n            :disabled=\"disabled\"\n            rows=\"3\"\n            maxlength=\"2000\"\n            :aria-invalid=\"errorOf(field.key) ? 'true' : undefined\"\n            :aria-describedby=\"errorOf(field.key) ? `va-form-err-${field.key}` : undefined\"\n            @input=\"markEdited(field.key)\"\n          ></textarea>\n\n          <!-- TASK-092 方案 A：select 组合库内 VaSelect（combobox 触发器 + 弹层，\n               可搜索/键盘导航与全库交互一致）；label 转 aria（触发器是 button 形态） -->\n          <VaSelect\n            v-else-if=\"field.type === 'select'\"\n            class=\"va-form__select\"\n            :model-value=\"(values[field.key] as string) || ''\"\n            :options=\"field.options || []\"\n            :disabled=\"disabled\"\n            :invalid=\"!!errorOf(field.key)\"\n            :placeholder=\"field.placeholder || '请选择'\"\n            :label=\"field.label\"\n            @update:model-value=\"(v) => { values[field.key] = v; markEdited(field.key); }\"\n          />\n\n          <template v-else-if=\"field.type === 'boolean'\">\n            <label class=\"va-form__switch\">\n              <input\n                :id=\"`va-form-${field.key}`\"\n                type=\"checkbox\"\n                :checked=\"values[field.key] === true\"\n                :disabled=\"disabled\"\n                @change=\"values[field.key] = ($event.target as HTMLInputElement).checked; markEdited(field.key)\"\n              />\n              <span>{{ values[field.key] === true ? \"是\" : \"否\" }}</span>\n            </label>\n          </template>\n\n          <template v-else>\n            <input\n              :id=\"`va-form-${field.key}`\"\n              v-model=\"values[field.key] as string\"\n              class=\"va-form__control\"\n              :class=\"{ 'va-form__control--error': errorOf(field.key) }\"\n              :type=\"inputTypeOf(field)\"\n              :placeholder=\"field.placeholder\"\n              :disabled=\"disabled\"\n              :step=\"field.type === 'number' ? 'any' : undefined\"\n              maxlength=\"2000\"\n              :aria-invalid=\"errorOf(field.key) ? 'true' : undefined\"\n              :aria-describedby=\"errorOf(field.key) ? `va-form-err-${field.key}` : undefined\"\n              @input=\"markEdited(field.key)\"\n            />\n            <VaButton\n              v-if=\"field.secret\"\n              variant=\"ghost\"\n              size=\"sm\"\n              :disabled=\"disabled\"\n              @click=\"secretVisible[field.key] = !secretVisible[field.key]\"\n            >\n              {{ secretVisible[field.key] ? \"隐藏\" : \"显示\" }}\n            </VaButton>\n            <span v-if=\"field.unit\" class=\"va-form__unit\">{{ field.unit }}</span>\n          </template>\n        </div>\n\n        <p v-if=\"errorOf(field.key)\" :id=\"`va-form-err-${field.key}`\" class=\"va-form__error\">\n          {{ errorOf(field.key) }}\n        </p>\n        <p v-else-if=\"field.description\" class=\"va-form__hint\">{{ field.description }}</p>\n      </div>\n    </div>\n\n    <footer class=\"va-form__actions\">\n      <VaButton variant=\"primary\" :disabled=\"disabled || loading\" @click=\"onSubmit\">\n        {{ submitLabel }}\n      </VaButton>\n      <VaButton variant=\"secondary\" :disabled=\"disabled\" @click=\"emit('cancel')\">\n        {{ cancelLabel }}\n      </VaButton>\n    </footer>\n\n    <!-- 收口/附加信息插槽（如「已提交」「已超时关闭」回执说明） -->\n    <slot name=\"after-actions\" />\n  </section>\n</template>\n\n<style>\n/* VaForm — 表单卡片（TASK-092，设计文档 §7）\n * 局部覆盖变量（全部带 fallback，单文件拷走可用）；token 约定对齐 VaButton 等既有组件 */\n\n.va-form {\n  --_ink: var(--va-form-ink, var(--va-ink, #1a1917));\n  --_ink2: var(--va-form-ink-2, var(--va-ink-2, #43413c));\n  --_card: var(--va-form-card, var(--va-card, #ffffff));\n  --_edge: var(--va-form-edge, var(--va-edge, rgba(26, 25, 23, 0.12)));\n  --_edge-strong: var(--va-form-edge-strong, var(--va-edge-strong, rgba(26, 25, 23, 0.22)));\n  --_subtle: var(--va-form-bg-subtle, var(--va-bg-subtle, #efede7));\n  --_danger: var(--va-form-danger, var(--va-danger, #d5453c));\n  --_accent: var(--va-form-accent, var(--va-accent, #c2410c));\n\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s4, 12px);\n  padding: var(--va-s5, 16px);\n  background: var(--_card);\n  border: 1px solid var(--_edge);\n  border-radius: var(--va-radius-m, 10px);\n  font-family: var(--va-font, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Helvetica Neue\", sans-serif);\n  color: var(--_ink);\n  font-size: var(--va-fs-md, 13px);\n  line-height: 1.5;\n}\n\n.va-form--disabled {\n  opacity: 0.55;\n}\n\n/* 头部 */\n.va-form__head { display: flex; flex-direction: column; gap: 2px; }\n.va-form__title {\n  margin: 0;\n  font-size: var(--va-fs-lg, 14px);\n  font-weight: var(--va-fw-medium, 500);\n}\n.va-form__desc { margin: 0; color: var(--_ink2); font-size: var(--va-fs-md, 13px); }\n\n/* 字段区 */\n.va-form__fields { display: flex; flex-direction: column; gap: var(--va-s4, 12px); }\n.va-form__field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }\n\n.va-form__label {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  font-weight: var(--va-fw-medium, 500);\n}\n.va-form__req { color: var(--_danger); }\n.va-form__badge {\n  font-size: var(--va-fs-sm, 12px);\n  font-weight: var(--va-fw-medium, 500);\n  color: var(--_accent);\n  border: 1px solid color-mix(in srgb, var(--_accent) 35%, transparent);\n  border-radius: 4px;\n  padding: 0 4px;\n  line-height: 1.4;\n}\n\n.va-form__control-row { display: flex; align-items: center; gap: var(--va-s3, 8px); min-width: 0; }\n\n.va-form__control {\n  flex: 1 1 auto;\n  min-width: 0;\n  height: var(--va-h-md, 36px);\n  padding: 0 var(--va-s4, 12px);\n  border: 1px solid var(--_edge);\n  border-radius: var(--va-radius-m, 10px);\n  background: var(--_card);\n  color: var(--_ink);\n  font: inherit;\n  transition:\n    border-color var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    box-shadow var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n.va-form__control:focus-visible {\n  outline: 2px solid var(--_accent);\n  outline-offset: 1px;\n  border-color: var(--_edge-strong);\n}\n.va-form__control:disabled { cursor: not-allowed; opacity: 0.6; }\n.va-form__control--error { border-color: var(--_danger); }\n\n.va-form__control--area {\n  height: auto;\n  min-height: calc(var(--va-s6, 24px) * 3);\n  padding: var(--va-s3, 8px) var(--va-s4, 12px);\n  resize: vertical;\n}\n\n/* 方案 A：select 字段组合 VaSelect——弹层组件在行内弹性占满（触发器行高对齐输入控件） */\n.va-form__select {\n  flex: 1 1 auto;\n  width: 100%;\n  min-width: 0;\n}\n.va-form__select .va-sel__trigger { min-height: var(--va-h-md, 36px); }\n\n/* boolean 开关行 */\n.va-form__switch {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--va-s3, 8px);\n  cursor: pointer;\n  user-select: none;\n}\n.va-form__switch input { accent-color: var(--_ink); width: 16px; height: 16px; cursor: pointer; }\n.va-form__switch input:disabled { cursor: not-allowed; }\n\n/* secret 可见性切换：VaButton ghost（组件库组合，方案 A） */\n\n/* 单位后缀 */\n.va-form__unit { flex: none; color: var(--_ink2); }\n\n/* 错误与提示 */\n.va-form__error { margin: 0; color: var(--_danger); font-size: var(--va-fs-md, 13px); }\n.va-form__hint { margin: 0; color: var(--_ink2); font-size: var(--va-fs-md, 13px); }\n\n/* 动作区 */\n.va-form__actions {\n  display: flex;\n  gap: var(--va-s3, 8px);\n  justify-content: flex-end;\n  padding-top: var(--va-s3, 8px);\n  border-top: 1px solid var(--_edge);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-form__control { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/form/index.ts",
      "type": "registry:ui",
      "target": "components/ui/form/index.ts",
      "content": "export { default as VaForm } from \"./VaForm.vue\";\nexport type { FormFieldItem, FormFieldOption, FormFieldType, VaFormEvents, VaFormProps } from \"./types\";\n"
    },
    {
      "path": "components/ui/form/types.ts",
      "type": "registry:ui",
      "target": "components/ui/form/types.ts",
      "content": "/**\n * @vuagent/ui - VaForm 类型定义（TASK-092，设计文档 §7）\n */\n\nexport type FormFieldType = \"text\" | \"textarea\" | \"number\" | \"boolean\" | \"select\" | \"date\";\n\nexport interface FormFieldOption {\n  /** 机器值（回传 values 中的取值） */\n  value: string;\n  /** 人类文案（界面展示与摘要回映） */\n  label: string;\n}\n\n/** 表单字段（与 @vuagent/protocol FormFieldSchema 结构化兼容；args 为不可信输入，渲染前已由 propAdapter 守卫收敛） */\nexport interface FormFieldItem {\n  key: string;\n  label: string;\n  type: FormFieldType;\n  /** 字段含义说明（摘要词汇表同源） */\n  description?: string;\n  required?: boolean;\n  /** 预填默认值（模型上一轮 values 回显的载体） */\n  default?: unknown;\n  options?: FormFieldOption[];\n  /** 数值单位后缀 */\n  unit?: string;\n  /** 敏感字段：密码态输入，值走 secret 通道（模型只见 ref/masked 占位） */\n  secret?: boolean;\n  placeholder?: string;\n}\n\nexport interface VaFormProps {\n  title?: string;\n  /** 为什么需要这些信息（模型给用户的说明） */\n  description?: string;\n  fields: FormFieldItem[];\n  submitLabel?: string;\n  cancelLabel?: string;\n  /** 非 executing 态禁用整表（渲染层守卫的双保险视觉位） */\n  disabled?: boolean;\n  loading?: boolean;\n  /** server 422 / 本地预校验回填的逐字段错误（form-errors 通道） */\n  fieldErrors?: Record<string, string>;\n}\n\nexport interface VaFormEvents {\n  /** 用户提交：values 为类型收敛后的值集合；editedFields 为用户亲自修改过的字段 key（meta.editedFields 同源） */\n  (e: \"submit\", values: Record<string, unknown>, editedFields: string[]): void;\n  (e: \"cancel\"): void;\n}\n"
    }
  ]
}
