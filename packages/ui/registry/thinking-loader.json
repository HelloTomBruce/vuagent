{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "thinking-loader",
  "title": "Thinking Loader",
  "description": "思考态加载器：阶段轮播 + 微光标签；完成后转为对勾与用时。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `phases` (string[]，默认 [\"思考中\", …])：轮播的阶段文案\n- `interval` (number，默认 1600)：每阶段毫秒数\n- `done / doneLabel` (boolean / string，默认 -)：完成态",
  "files": [
    {
      "path": "components/ui/thinking-loader/VaThinkingLoader.vue",
      "type": "registry:ui",
      "target": "components/ui/thinking-loader/VaThinkingLoader.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from \"vue\";\nimport type { ThinkingLoaderProps } from \"./types\";\nimport { useThinkingLoader } from \"./useThinkingLoader\";\n\nconst props = withDefaults(defineProps<ThinkingLoaderProps>(), {\n  phases: undefined,\n  interval: 1600,\n  done: false,\n  doneLabel: \"已完成\",\n  loop: false,\n  size: \"md\",\n});\n\nconst { current, maxPhaseChars } = useThinkingLoader(props);\n\nconst labelText = computed(() => (props.done ? props.doneLabel : current.value));\n/** key 驱动阶段切换过渡；done 与轮播文案共用一条切换通道 */\nconst labelKey = computed(() => (props.done ? \"__done\" : current.value));\n/** 最长文案定宽：轮播不再因文案长短变化引起胶囊宽度抖动（CJK 1 字 ≈ 1em） */\nconst labelStyle = computed(() => ({ minWidth: `${maxPhaseChars.value}em` }));\n</script>\n\n<template>\n  <div class=\"va-think\" :class=\"[`va-think--${props.size}`, { 'va-think--done': props.done }]\" role=\"status\">\n    <span class=\"va-think__icon\" aria-hidden=\"true\">\n      <svg v-if=\"props.done\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\">\n        <path d=\"M5.5 12.5l4 4L18.5 8\" />\n      </svg>\n      <span v-else class=\"va-think__spin\" />\n    </span>\n    <span class=\"va-think__label\" :style=\"labelStyle\" aria-live=\"polite\">\n      <!-- 过渡时长由 CSS（--va-dur-1）驱动、Vue 自动探测；shine 无限动画放在内层\n           span——若挂在过渡子节点自身，Vue 按 computed 时长等 animationend（永不\n           触发）会滞留旧节点，被迫显式 :duration 硬编码绕过 token -->\n      <Transition name=\"va-think-phase\" mode=\"out-in\">\n        <span :key=\"labelKey\" class=\"va-think__label-text\">\n          <span class=\"va-think__label-shine\" :data-shine=\"!props.done || undefined\">{{ labelText }}</span>\n        </span>\n      </Transition>\n    </span>\n  </div>\n</template>\n\n<style>\n/* VaThinkingLoader — 思考态加载胶囊 */\n.va-think {\n  --_accent: var(--va-think-accent, var(--va-accent, #c2410c));\n  --_muted: var(--va-think-muted, var(--va-muted, #6f6d66));\n  --_success: var(--va-think-success, var(--va-success, #1a7f4b));\n\n  display: inline-flex;\n  align-items: center;\n  gap: var(--va-s3, 8px);\n  padding: 5px 12px;\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-pill, 999px);\n  background: var(--va-card, #ffffff);\n  font-family: var(--va-font, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Helvetica Neue\", sans-serif);\n  /* 挂载入场：轻微上浮淡入（v-if 出现时跑一遍；首 token 到达即消失不做退场） */\n  animation: va-think-in var(--va-dur-2, 200ms) ease-out;\n}\n@keyframes va-think-in {\n  from { opacity: 0; transform: translateY(3px); }\n}\n.va-think--sm { padding: 3px var(--va-s4h, 10px); }\n.va-think--sm .va-think__label { font-size: var(--va-fs-sm, 12px); }\n\n.va-think__icon {\n  flex: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 14px;\n  height: 14px;\n  color: var(--_accent);\n}\n.va-think--done .va-think__icon { color: var(--_success); }\n.va-think__icon svg { width: 14px; height: 14px; }\n\n.va-think__spin {\n  width: 12px;\n  height: 12px;\n  border-radius: 50%;\n  border: 2px solid color-mix(in srgb, var(--_accent) 25%, transparent);\n  border-top-color: var(--_accent);\n  animation: va-spin calc(var(--va-dur-loop, 1.8s) * 0.5) linear infinite;\n}\n@keyframes va-spin { to { transform: rotate(360deg); } }\n\n/* label 定宽（min-width 由模板按最长阶段文案注入），轮播不再引起宽度抖动 */\n.va-think__label {\n  font-size: var(--va-fs-md, 13px);\n  color: var(--va-ink-2, #43413c);\n  line-height: 1.5;\n}\n/* shine 承载在内层 span（va-think__label-shine）：过渡子节点（外层 label-text）\n   自身只带 transition，Vue 的过渡时长自动探测不被无限动画干扰 */\n/* 过渡子节点必须非 inline（inline-block）：transform 对纯 inline 元素不生效，\n   va-think-phase 的 translateY 上浮/下浮会静默失效 */\n.va-think__label-text {\n  display: inline-block;\n  white-space: nowrap;\n}\n.va-think__label-shine {\n  display: inline-block;\n  white-space: nowrap;\n}\n.va-think__label-shine[data-shine] {\n  background: linear-gradient(100deg, var(--_muted) 40%, var(--va-ink, #1a1917) 50%, var(--_muted) 60%);\n  background-size: 200% 100%;\n  background-position: 200% 0;\n  -webkit-background-clip: text;\n  background-clip: text;\n  color: transparent;\n  animation: va-think-shine calc(var(--va-dur-loop, 1.8s) * 5 / 6) linear infinite; /* 1.5s = 底速 × 5/6 */\n}\n.va-think--done .va-think__label { color: var(--_success); font-weight: var(--va-fw-semibold, 600); }\n\n/* 阶段切换过渡：旧文案上浮淡出、新文案下浮淡入（mode=out-in 串行，不叠字） */\n.va-think-phase-enter-active,\n.va-think-phase-leave-active {\n  transition: opacity var(--va-dur-1, 120ms) ease, transform var(--va-dur-1, 120ms) ease;\n}\n.va-think-phase-enter-from { opacity: 0; transform: translateY(3px); }\n.va-think-phase-leave-to { opacity: 0; transform: translateY(-3px); }\n@keyframes va-think-shine {\n  from { background-position: 200% 0; }\n  to { background-position: -200% 0; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-think { animation: none; }\n  .va-think__spin { animation-duration: calc(var(--va-dur-loop, 1.8s) * 10 / 9); } /* 2s：减速不停，加载态可感知 */\n  .va-think-phase-enter-active,\n  .va-think-phase-leave-active { transition: none; }\n  .va-think__label-shine[data-shine] { animation: none; color: var(--_muted); background: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/thinking-loader/index.ts",
      "type": "registry:ui",
      "target": "components/ui/thinking-loader/index.ts",
      "content": "export { default as VaThinkingLoader } from \"./VaThinkingLoader.vue\";\nexport type { ThinkingLoaderProps } from \"./types\";\n"
    },
    {
      "path": "components/ui/thinking-loader/types.ts",
      "type": "registry:ui",
      "target": "components/ui/thinking-loader/types.ts",
      "content": "/** VaThinkingLoader 的类型定义 */\n\nexport interface ThinkingLoaderProps {\n  /** 轮播的阶段文案 */\n  phases?: string[];\n  /** 每阶段毫秒数 */\n  interval?: number;\n  /** 完成态：spinner 转为对勾 */\n  done?: boolean;\n  /** 完成后的文案 */\n  doneLabel?: string;\n  /** 走完一轮后从头再来 */\n  loop?: boolean;\n  size?: \"sm\" | \"md\";\n}\n"
    },
    {
      "path": "components/ui/thinking-loader/useThinkingLoader.ts",
      "type": "registry:ui",
      "target": "components/ui/thinking-loader/useThinkingLoader.ts",
      "content": "import { computed, onBeforeUnmount, ref, watch } from \"vue\";\nimport type { ThinkingLoaderProps } from \"./types\";\n\nconst DEFAULT_PHASES = [\"思考中\", \"检索资料\", \"整理要点\", \"撰写回答\"];\n\n/** VaThinkingLoader 的状态逻辑：阶段轮播 + 完成态 */\nexport function useThinkingLoader(props: ThinkingLoaderProps) {\n  const phases = computed(() => (props.phases?.length ? props.phases : DEFAULT_PHASES));\n  const step = ref(0);\n  let timer: number | undefined;\n\n  function stop() {\n    if (timer !== undefined) {\n      window.clearInterval(timer);\n      timer = undefined;\n    }\n  }\n  function start() {\n    stop();\n    if (typeof window === \"undefined\") return;\n    timer = window.setInterval(() => {\n      const last = phases.value.length - 1;\n      if (step.value >= last) {\n        if (props.loop) step.value = 0;\n        else stop();\n      } else {\n        step.value++;\n      }\n    }, Math.max(200, props.interval ?? 1600));\n  }\n\n  watch(\n    () => [props.done, phases.value] as const,\n    () => {\n      stop();\n      if (!props.done) {\n        step.value = 0;\n        start();\n      }\n    },\n    { immediate: true },\n  );\n  onBeforeUnmount(stop);\n\n  // reduced-motion / 无 JS 环境（SSR）直接停在第一阶段文案\n  const current = computed(() => phases.value[Math.min(step.value, phases.value.length - 1)] ?? \"\");\n\n  /**\n   * 最长阶段文案字符数（含 doneLabel）：模板据此设 label min-width，\n   * 文案长短不一的轮播不再引起胶囊宽度抖动（CJK 1 字 ≈ 1em）。\n   */\n  const maxPhaseChars = computed(() =>\n    Math.max(1, ...phases.value.map((p) => p.length), props.doneLabel?.length ?? 0),\n  );\n\n  return { current, maxPhaseChars, stop };\n}\n"
    }
  ]
}
