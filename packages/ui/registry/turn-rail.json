{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "turn-rail",
  "title": "Turn Rail",
  "description": "多轮对话右侧快速跳转轨（turn rail + scroll-spy）：一列轮次标记，点击/键盘直跳某一轮，滚动跟随高亮当前轮并填充进度轨，悬停出「#N + 文案」预览卡；轮次过少自动隐藏。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `items` (TurnRailItem[]，默认 [])：轮次标记（id / label / role / status）\n- `container` (HTMLElement | null，默认 null)：滚动容器元素；传入才启用点击跳转与滚动跟随\n- `anchorAttr` (string，默认 \"data-turn-id\")：容器内锚点属性名，取值须等于 item.id\n- `offset` (number，默认 16)：跳转后锚点距容器顶部留白（px）\n- `minItems` (number，默认 1)：轮次数 ≤ 该值自动隐藏（0 = 始终显示）\n- `preview / floating` (boolean，默认 true)：悬停预览卡 / 悬浮定位（父级 position: relative）\n- `v-model:active-id` (string，默认 -)：受控当前轮次 id；不传则由滚动位置自算\n- `@select / @update:activeId` (-，默认 -)：选中轮次(id, index) / 当前轮次变化(id)",
  "files": [
    {
      "path": "components/ui/turn-rail/VaTurnRail.vue",
      "type": "registry:ui",
      "target": "components/ui/turn-rail/VaTurnRail.vue",
      "content": "<script setup lang=\"ts\">\n/**\n * VaTurnRail —— 多轮对话右侧「快速跳转轨」（harness 客户端的 turn rail / scroll-spy 轨）。\n *\n * 解决的问题：长会话里只能靠滚动找某一轮提问。本组件在消息流右侧渲染一列轮次标记：\n * - 点击 / 回车 → 平滑定位到对应轮次锚点（容器内 [data-turn-id=\"<id>\"]）；\n * - 阅读位置变化 → 滚动监听取当前轮次，高亮（aria-current）并填充进度轨；\n * - ↑/↓/Home/End → 在轨内移动并直接跳转（焦点跟随，纯键盘可用）；\n * - 悬停/聚焦 → 左侧预览卡显示「#N + 文案」。\n *\n * 与贴底跟随（useStickToBottom）的协作：跳转会写入 scrollTop，父级的 scroll 监听到\n * 「离底」后自然解除钉底，无需本组件额外通知；跳到底部附近父级自行恢复跟随。\n *\n * 定位方式：组件不猜 DOM 结构，锚点由消费方在轮次行上挂属性（默认 data-turn-id），\n * 与 items[].id 一一对应；找不到锚点的轮次静默跳过（只渲染标记，不可跳）。\n */\nimport { computed, nextTick, onBeforeUnmount, ref, watch } from \"vue\";\nimport type { TurnRailEvents, TurnRailProps, TurnRailItem } from \"./types\";\n\nconst props = withDefaults(defineProps<TurnRailProps>(), {\n  items: () => [],\n  container: null,\n  anchorAttr: \"data-turn-id\",\n  offset: 16,\n  minItems: 1,\n  preview: true,\n  floating: true,\n  activeId: \"\",\n  ariaLabel: \"对话轮次快速跳转\",\n});\n\nconst emit = defineEmits<TurnRailEvents>();\n\n/** 锚点顶边越过容器顶边该距离即视为「当前轮」（与轮次行间距同量级） */\nconst SPY_TOP_PX = 96;\n\n/**\n * 距底该距离内视为贴底（与 useStickToBottom 的 64px 阈值无关：这里只判「已到末尾」）。\n * 取 1px 而非更宽的手感值：末尾轮次的跳转常被夹到最大 scrollTop 附近，阈值放宽会把\n * 「跳到倒数第二轮、恰好离底 2px」误判成最后一轮，出现点 A 高亮 B 的错位。\n */\nconst BOTTOM_EPSILON_PX = 1;\n\nconst rootRef = ref<HTMLElement | null>(null);\nconst buttons = ref<(HTMLElement | null)[]>([]);\n\n/** 非受控模式下的自算当前项；受控（activeId 非空）时以后者为准 */\nconst selfActiveId = ref(\"\");\nconst activeId = computed(() => props.activeId || selfActiveId.value);\nconst activeIndex = computed(() => Math.max(0, props.items.findIndex((item) => item.id === activeId.value)));\n\n/** 轮次太少时轨道只是噪音：≤ minItems 直接隐藏（minItems=0 可强制常显） */\nconst visible = computed(() => props.items.length > props.minItems);\n\n/** 进度轨填充比例（当前项在轮次序列中的位置，0..1） */\nconst progress = computed(() => {\n  const total = props.items.length;\n  if (total <= 1) return 0;\n  return Math.min(1, Math.max(0, activeIndex.value / (total - 1)));\n});\n\nfunction labelOf(item: TurnRailItem, index: number) {\n  const text = (item.label ?? \"\").replace(/\\s+/g, \" \").trim();\n  return text || `第 ${index + 1} 轮`;\n}\n\n/* ---------------- 锚点查找与几何 ---------------- */\n\n/** 属性选择器取值转义（id 含引号/反斜杠时不至于拼出非法选择器） */\nfunction escapeAttr(value: string) {\n  return value.replace(/[\"\\\\]/g, \"\\\\$&\");\n}\n\nfunction anchorOf(id: string): HTMLElement | null {\n  const el = props.container;\n  if (!el) return null;\n  return el.querySelector<HTMLElement>(`[${props.anchorAttr}=\"${escapeAttr(id)}\"]`);\n}\n\n/* ---------------- 滚动跟随（scroll-spy） ---------------- */\n\nlet rafId: number | null = null;\nlet boundEl: HTMLElement | null = null;\nlet observer: ResizeObserver | null = null;\n\nfunction measure() {\n  const el = props.container;\n  if (!el || props.items.length === 0) return;\n  const containerTop = el.getBoundingClientRect().top;\n  let next = props.items[0].id;\n  // 贴底时直接取最后一轮：末尾轮次的锚点可能永远无法滚到阈值以内（内容不够长 /\n  // 跳转被夹到最大 scrollTop），若仍按几何判定，点最后一枚标记会「点了没反应」。\n  // 仅在容器确实可滚（内容超出视口）时启用：内容一屏放得下时不存在「贴底」语义，\n  // 应回落到锚点几何（第一轮即当前），否则短对话一进来就高亮最后一轮。\n  const scrollable = el.scrollHeight - el.clientHeight > BOTTOM_EPSILON_PX;\n  if (scrollable && el.scrollHeight - el.scrollTop - el.clientHeight <= BOTTOM_EPSILON_PX) {\n    next = props.items[props.items.length - 1].id;\n  } else {\n    for (const item of props.items) {\n      const node = anchorOf(item.id);\n      if (!node) continue;\n      // 顺序即文档顺序：第一个尚未越过阈值的锚点之后的都不可能是「当前」\n      if (node.getBoundingClientRect().top - containerTop > SPY_TOP_PX) break;\n      next = item.id;\n    }\n  }\n  if (next === selfActiveId.value) return;\n  selfActiveId.value = next;\n  emit(\"update:activeId\", next);\n}\n\nfunction scheduleMeasure() {\n  if (rafId !== null) return;\n  if (typeof requestAnimationFrame !== \"function\") {\n    measure();\n    return;\n  }\n  rafId = requestAnimationFrame(() => {\n    rafId = null;\n    measure();\n  });\n}\n\nfunction onScroll() {\n  scheduleMeasure();\n}\n\nfunction unbind() {\n  if (boundEl) boundEl.removeEventListener(\"scroll\", onScroll);\n  boundEl = null;\n  observer?.disconnect();\n  observer = null;\n  if (rafId !== null && typeof cancelAnimationFrame === \"function\") {\n    cancelAnimationFrame(rafId);\n    rafId = null;\n  }\n}\n\nfunction bind() {\n  unbind();\n  const el = props.container;\n  if (!el) return;\n  boundEl = el;\n  el.addEventListener(\"scroll\", onScroll, { passive: true });\n  // 容器高度变化（窗口缩放 / 面板拖拽）与内容增高（流式输出）都要重算当前轮；\n  // 内容层通常是容器的唯一子元素，一并观察（元素盒不变也能收到内容尺寸变化）\n  if (typeof ResizeObserver !== \"undefined\") {\n    observer = new ResizeObserver(() => scheduleMeasure());\n    observer.observe(el);\n    const content = el.firstElementChild;\n    if (content instanceof HTMLElement) observer.observe(content);\n  }\n  scheduleMeasure();\n}\n\nwatch(() => props.container, bind, { immediate: true });\nwatch(\n  () => props.items.map((item) => item.id).join(\"|\"),\n  () => scheduleMeasure(),\n);\nonBeforeUnmount(unbind);\n\n/* ---------------- 跳转与选中 ---------------- */\n\nfunction prefersReducedMotion() {\n  return typeof matchMedia === \"function\" && matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n}\n\nfunction scrollToAnchor(id: string) {\n  const el = props.container;\n  const node = anchorOf(id);\n  if (!el || !node) return;\n  const top = el.scrollTop + (node.getBoundingClientRect().top - el.getBoundingClientRect().top) - props.offset;\n  const target = Math.max(0, top);\n  if (typeof el.scrollTo === \"function\") {\n    el.scrollTo({ top: target, behavior: prefersReducedMotion() ? \"auto\" : \"smooth\" });\n    return;\n  }\n  el.scrollTop = target; // 老宿主 / 测试替身没有 scrollTo 时退回直赋值\n}\n\nfunction select(item: TurnRailItem, index: number) {\n  selfActiveId.value = item.id;\n  emit(\"update:activeId\", item.id);\n  emit(\"select\", item.id, index);\n  scrollToAnchor(item.id);\n}\n\n/* ---------------- 键盘：轨内上下移动即跳转 ---------------- */\n\nfunction setButton(el: unknown, index: number) {\n  buttons.value[index] = (el as HTMLElement | null) ?? null;\n}\n\nfunction onKeydown(event: KeyboardEvent) {\n  const total = props.items.length;\n  if (total === 0) return;\n  let next = -1;\n  if (event.key === \"Home\") next = 0;\n  else if (event.key === \"End\") next = total - 1;\n  else if (event.key === \"ArrowUp\") next = Math.max(0, activeIndex.value - 1);\n  else if (event.key === \"ArrowDown\") next = Math.min(total - 1, activeIndex.value + 1);\n  if (next < 0) return;\n  event.preventDefault();\n  const item = props.items[next];\n  if (!item) return;\n  select(item, next);\n  buttons.value[next]?.focus();\n}\n\n/* ---------------- 预览卡 ---------------- */\n\nconst hoverId = ref(\"\");\nconst focusId = ref(\"\");\nconst previewId = computed(() => (props.preview ? hoverId.value || focusId.value : \"\"));\nconst previewItem = computed<TurnRailItem | null>(\n  () => props.items.find((item) => item.id === previewId.value) ?? null,\n);\nconst previewIndex = computed(() => props.items.findIndex((item) => item.id === previewId.value));\n/** 预览卡顶边：相对轨根节点，跟随所属标记垂直居中（轨外渲染，避免被列表裁切） */\nconst previewTop = ref(0);\n\nfunction syncPreviewTop() {\n  const id = previewId.value;\n  const root = rootRef.value;\n  const button = buttons.value[previewIndex.value];\n  if (!id || !root || !button) return;\n  const anchor = button.getBoundingClientRect();\n  const base = root.getBoundingClientRect();\n  previewTop.value = anchor.top + anchor.height / 2 - base.top;\n}\n\nwatch(previewId, async () => {\n  // 预览卡是轨根节点的兄弟层，等 DOM 挂载后再量位置\n  await nextTick();\n  syncPreviewTop();\n});\n\nfunction onListScroll() {\n  if (previewId.value) syncPreviewTop();\n}\n\n/* ---------------- 对外能力 ---------------- */\n\ndefineExpose({\n  /** 手动重算当前轮（宿主内容变化但未触发 scroll/resize 时调用） */\n  measure,\n  /** 跳到某轮（等价于点击该标记） */\n  scrollTo: scrollToAnchor,\n  /** 当前轮次 id */\n  activeId,\n});\n</script>\n\n<template>\n  <nav\n    v-if=\"visible\"\n    ref=\"rootRef\"\n    class=\"va-turn-rail\"\n    :class=\"{ 'va-turn-rail--floating': props.floating }\"\n    :aria-label=\"props.ariaLabel\"\n    @keydown=\"onKeydown\"\n  >\n    <div class=\"va-turn-rail__track\" aria-hidden=\"true\">\n      <span class=\"va-turn-rail__track-fill\" :style=\"{ transform: `scaleY(${progress})` }\"></span>\n    </div>\n\n    <ol class=\"va-turn-rail__list\" @scroll.passive=\"onListScroll\">\n      <li v-for=\"(item, index) in props.items\" :key=\"item.id\" class=\"va-turn-rail__item\">\n        <button\n          :ref=\"(el) => setButton(el, index)\"\n          type=\"button\"\n          class=\"va-turn-rail__dot\"\n          :class=\"[\n            `va-turn-rail__dot--${item.role === 'assistant' ? 'assistant' : 'user'}`,\n            {\n              'va-turn-rail__dot--active': item.id === activeId,\n              'va-turn-rail__dot--streaming': item.status === 'streaming',\n              'va-turn-rail__dot--error': item.status === 'error',\n            },\n          ]\"\n          :aria-current=\"item.id === activeId ? 'true' : undefined\"\n          :aria-label=\"`跳到${labelOf(item, index)}`\"\n          @click=\"select(item, index)\"\n          @mouseenter=\"hoverId = item.id\"\n          @mouseleave=\"hoverId = ''\"\n          @focus=\"focusId = item.id\"\n          @blur=\"focusId = ''\"\n        >\n          <span class=\"va-turn-rail__pip\" aria-hidden=\"true\"></span>\n        </button>\n      </li>\n    </ol>\n\n    <div v-if=\"previewItem\" class=\"va-turn-rail__preview\" role=\"tooltip\" :style=\"{ top: `${previewTop}px` }\">\n      <span class=\"va-turn-rail__preview-index\">#{{ previewIndex + 1 }}</span>\n      <span class=\"va-turn-rail__preview-text\">{{ labelOf(previewItem, previewIndex) }}</span>\n    </div>\n  </nav>\n</template>\n\n<style>\n/**\n * VaTurnRail —— 右侧轮次快速跳转轨\n * 结构：nav（定位根 + 预览层）> 进度轨 + ol 标记列表\n * 令牌纪律：--va-* 一律带与 tokens.css 同值的 fallback（单文件拷贝托管时生效）；\n * 时长/缓动走 --va-dur-* / --va-ease，禁止裸字面量（tokens:check 门禁）。\n */\n.va-turn-rail {\n  --va-turn-rail-pip: 7px;\n  --va-turn-rail-pip-active: 3px;\n  --va-turn-rail-hit: 16px;\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: var(--va-s3, 8px) var(--va-s2, 4px);\n  max-height: 100%;\n}\n\n/* 悬浮形态：靠右垂直居中（父级需 position: relative），不占据流内空间 */\n.va-turn-rail--floating {\n  position: absolute;\n  top: 50%;\n  right: var(--va-s3, 8px);\n  transform: translateY(-50%);\n  z-index: var(--va-z-raised, 10);\n}\n\n/* 进度轨：细线贯穿标记列，填充高度 = 当前轮在序列中的位置 */\n.va-turn-rail__track {\n  position: absolute;\n  top: var(--va-s4, 12px);\n  bottom: var(--va-s4, 12px);\n  left: 50%;\n  /* 1px + 12% 边线色在实际渲染里几乎不可见（轨道概念就丢了）；升到 2px + 22% 后\n     作为装饰轴线足够清晰，又不抢标记的注意力 */\n  width: 2px;\n  margin-left: -1px;\n  border-radius: var(--va-radius-pill, 999px);\n  background: var(--va-edge-strong, rgba(26, 25, 23, 0.22));\n  overflow: hidden;\n  pointer-events: none;\n}\n\n.va-turn-rail__track-fill {\n  position: absolute;\n  inset: 0;\n  transform-origin: top center;\n  background: var(--va-accent, #c2410c);\n  opacity: 0.55;\n  transition: transform var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-turn-rail__list {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: var(--va-s3h, 6px);\n  margin: 0;\n  padding: 0;\n  list-style: none;\n  max-height: 52vh;\n  overflow-y: auto;\n  overflow-x: hidden;\n  scrollbar-width: none;\n}\n\n.va-turn-rail__list::-webkit-scrollbar {\n  width: 0;\n  height: 0;\n}\n\n.va-turn-rail__item {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex: none;\n}\n\n.va-turn-rail__dot {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: var(--va-turn-rail-hit);\n  height: var(--va-turn-rail-hit);\n  padding: 0;\n  border: 0;\n  border-radius: var(--va-radius-pill, 999px);\n  background: transparent;\n  cursor: pointer;\n  -webkit-tap-highlight-color: transparent;\n}\n\n.va-turn-rail__dot:focus-visible {\n  outline: 2px solid var(--va-accent, #c2410c);\n  outline-offset: 2px;\n}\n\n.va-turn-rail__pip {\n  width: var(--va-turn-rail-pip);\n  height: var(--va-turn-rail-pip);\n  border-radius: var(--va-radius-pill, 999px);\n  /* 用 muted 而非 edge-strong：22% 的边线色在白卡上对比度约 1.7:1，低到像装饰；\n     导航标记属可交互非文本元素，取 muted（≈4.9:1）保证可辨识 */\n  background: var(--va-muted, #6f6d66);\n  transition:\n    width var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    height var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    background-color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n/* 助手轮次：空心点（与用户提问区分，便于一眼看出提问/回复节奏） */\n.va-turn-rail__dot--assistant .va-turn-rail__pip {\n  background: transparent;\n  box-shadow: inset 0 0 0 1.5px var(--va-muted, #6f6d66);\n}\n\n.va-turn-rail__dot:hover .va-turn-rail__pip {\n  background: var(--va-ink-2, #43413c);\n}\n\n.va-turn-rail__dot--assistant:hover .va-turn-rail__pip {\n  background: transparent;\n  box-shadow: inset 0 0 0 1.5px var(--va-ink-2, #43413c);\n}\n\n/* 当前轮：竖条高亮（比圆点更醒目且不吃垂直空间） */\n.va-turn-rail__dot--active .va-turn-rail__pip {\n  width: var(--va-turn-rail-pip-active);\n  height: calc(var(--va-turn-rail-hit) - 2px);\n  background: var(--va-accent, #c2410c);\n  box-shadow: none;\n}\n\n.va-turn-rail__dot--active .va-turn-rail__pip,\n.va-turn-rail__dot--active:hover .va-turn-rail__pip {\n  background: var(--va-accent, #c2410c);\n  box-shadow: none;\n}\n\n/* 流式中的那一轮：呼吸脉冲提示「还在写」 */\n.va-turn-rail__dot--streaming .va-turn-rail__pip {\n  animation: va-turn-rail-pulse calc(var(--va-dur-loop, 1.8s) * 0.8) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)) infinite;\n}\n\n.va-turn-rail__dot--error .va-turn-rail__pip {\n  background: var(--va-danger, #d5453c);\n  box-shadow: none;\n}\n\n/* 预览卡：挂在轨根节点（不在滚动列表内），向右溢出不被裁切 */\n.va-turn-rail__preview {\n  position: absolute;\n  right: 100%;\n  margin-right: var(--va-s3h, 6px);\n  transform: translateY(-50%);\n  z-index: var(--va-z-dropdown, 70);\n  display: flex;\n  align-items: baseline;\n  gap: var(--va-s3h, 6px);\n  max-width: 260px;\n  padding: var(--va-s3h, 6px) var(--va-s4, 12px);\n  background: var(--va-card, #ffffff);\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-s, 8px);\n  box-shadow: var(--va-shadow-2, 0 4px 12px rgba(26, 25, 23, 0.08));\n  pointer-events: none;\n  animation: va-turn-rail-preview-in var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-turn-rail__preview-index {\n  flex: none;\n  font-size: var(--va-fs-xs, 11px);\n  line-height: var(--va-lh-normal, 1.5);\n  color: var(--va-muted, #6f6d66);\n  font-variant-numeric: tabular-nums;\n}\n\n.va-turn-rail__preview-text {\n  min-width: 0;\n  font-size: var(--va-fs-sm, 12px);\n  line-height: var(--va-lh-normal, 1.5);\n  color: var(--va-ink-2, #43413c);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n@keyframes va-turn-rail-pulse {\n  0%,\n  100% {\n    opacity: 1;\n    transform: scale(1);\n  }\n  50% {\n    opacity: 0.45;\n    transform: scale(0.78);\n  }\n}\n\n@keyframes va-turn-rail-preview-in {\n  from {\n    opacity: 0;\n    transform: translateY(-50%) translateX(4px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(-50%) translateX(0);\n  }\n}\n\n/* 动效敏感用户：脉冲/过渡/入场一律关掉（位置信息仍由静态样式表达） */\n@media (prefers-reduced-motion: reduce) {\n  .va-turn-rail__dot--streaming .va-turn-rail__pip {\n    animation: none;\n  }\n\n  .va-turn-rail__track-fill,\n  .va-turn-rail__pip {\n    transition: none;\n  }\n\n  .va-turn-rail__preview {\n    animation: none;\n  }\n}\n</style>\n"
    },
