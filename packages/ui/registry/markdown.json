{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "markdown",
  "title": "Markdown",
  "description": "轻量高质量 Markdown 渲染器：基于 markdown-it，支持流式光标、代码块、表格、列表及排版样式。",
  "type": "registry:ui",
  "dependencies": [
    "markdown-it"
  ],
  "registryDependencies": [],
  "docs": "- `content` (string，默认 \"\")：Markdown 原文\n- `streaming` (boolean，默认 false)：流式输出中（在文末显示呼吸跳动光标）\n- `linkify` (boolean，默认 true)：自动将 URL 识别为可点击超链接\n- `breaks` (boolean，默认 true)：软换行转换为 <br>",
  "files": [
    {
      "path": "components/ui/markdown/VaMarkdown.vue",
      "type": "registry:ui",
      "target": "components/ui/markdown/VaMarkdown.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from \"vue\";\nimport MarkdownIt from \"markdown-it\";\nimport type { MarkdownProps } from \"./types\";\n\nconst props = withDefaults(defineProps<MarkdownProps>(), {\n  content: \"\",\n  streaming: false,\n  linkify: true,\n  breaks: true,\n});\n\nconst md = new MarkdownIt({\n  html: false, // 防范 XSS 注入\n  linkify: props.linkify,\n  breaks: props.breaks,\n  typographer: false,\n});\n\nconst renderedHtml = computed(() => {\n  if (!props.content) return \"\";\n  return md.render(props.content);\n});\n</script>\n\n<template>\n  <div class=\"va-md\" :data-streaming=\"streaming || undefined\">\n    <div class=\"va-md__body\" v-html=\"renderedHtml\" />\n    <span v-if=\"streaming\" class=\"va-md__caret\" aria-hidden=\"true\" />\n  </div>\n</template>\n\n<style>\n/* VaMarkdown — Agent 消息 Markdown 排版渲染器 */\n\n.va-md {\n  font-family: var(--va-font, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\",\n    \"Microsoft YaHei\", \"Helvetica Neue\", sans-serif);\n  font-size: var(--va-fs-md, 13px);\n  line-height: 1.65;\n  color: var(--va-ink, #1a1917);\n  position: relative;\n  word-break: break-word;\n}\n\n.va-md .va-md__body {\n  overflow-wrap: break-word;\n}\n\n/* 段落与标题 */\n.va-md .va-md__body p {\n  margin: 0 0 var(--va-s3, 8px) 0;\n  line-height: inherit; /* 防宿主 p 规则（如 .vp-doc p{line-height:28px}）注入行高 */\n}\n.va-md .va-md__body p:last-child {\n  margin-bottom: 0;\n}\n\n.va-md .va-md__body h1,\n.va-md .va-md__body h2,\n.va-md .va-md__body h3,\n.va-md .va-md__body h4,\n.va-md .va-md__body h5,\n.va-md .va-md__body h6 {\n  margin: var(--va-s4, 12px) 0 var(--va-s2, 4px) 0;\n  font-weight: var(--va-fw-semibold, 600);\n  line-height: 1.35;\n  letter-spacing: normal; /* 防宿主 heading 规则注入紧缩字距 */\n  color: var(--va-ink, #1a1917);\n}\n\n.va-md .va-md__body h1 { font-size: 16px; }\n.va-md .va-md__body h2 { font-size: 15px; }\n.va-md .va-md__body h3 { font-size: 14px; }\n.va-md .va-md__body h4 { font-size: 13px; }\n\n/* 列表 */\n.va-md .va-md__body ul,\n.va-md .va-md__body ol {\n  margin: 0 0 var(--va-s3, 8px) 0;\n  padding-left: 20px;\n}\n.va-md .va-md__body ul:last-child,\n.va-md .va-md__body ol:last-child {\n  margin-bottom: 0;\n}\n\n.va-md .va-md__body li {\n  margin: 2px 0;\n}\n.va-md .va-md__body li > p {\n  margin: 0;\n}\n\n/* 行内代码与代码块 */\n.va-md .va-md__body code {\n  font-family: var(--va-font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);\n  font-size: 0.9em;\n  padding: 1px 5px;\n  border-radius: var(--va-radius-xs, 4px);\n  background: var(--va-bg-subtle, #efede7);\n  color: var(--va-ink, #1a1917);\n  border: 1px solid var(--va-edge-subtle, rgba(26, 25, 23, 0.08));\n}\n\n.va-md .va-md__body pre {\n  margin: var(--va-s3, 8px) 0;\n  padding: 10px 12px;\n  border-radius: var(--va-radius-s, 8px);\n  background: var(--va-bg-subtle, #efede7);\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  overflow-x: auto;\n  line-height: 1.5;\n}\n.va-md .va-md__body pre:last-child {\n  margin-bottom: 0;\n}\n\n.va-md .va-md__body pre code {\n  padding: 0;\n  background: none;\n  border: none;\n  border-radius: 0;\n  font-size: 12px;\n  color: var(--va-ink, #1a1917);\n}\n\n/* 引用块 */\n.va-md .va-md__body blockquote {\n  margin: var(--va-s3, 8px) 0;\n  padding: 4px 12px;\n  border-left: 3px solid var(--va-accent, #c2410c);\n  background: var(--va-bg-subtle, #efede7);\n  border-radius: 0 var(--va-radius-xs, 4px) var(--va-radius-xs, 4px) 0;\n  color: var(--va-muted, #6f6d66);\n}\n.va-md .va-md__body blockquote p:last-child {\n  margin-bottom: 0;\n}\n.va-md .va-md__body blockquote > p {\n  font-size: inherit; /* 防宿主 blockquote>p 规则放大字号 */\n}\n\n/* 表格 */\n.va-md .va-md__body table {\n  width: 100%;\n  border-collapse: collapse;\n  margin: var(--va-s3, 8px) 0;\n  font-size: 12px;\n}\n.va-md .va-md__body table:last-child {\n  margin-bottom: 0;\n}\n\n.va-md .va-md__body th,\n.va-md .va-md__body td {\n  padding: 6px 10px;\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  background: transparent; /* 防宿主 table 斑马纹渗入 */\n  text-align: left;\n}\n\n.va-md .va-md__body th {\n  background: var(--va-bg-subtle, #efede7);\n  font-weight: 600;\n  color: var(--va-ink, #1a1917);\n}\n\n/* 超链接 */\n.va-md .va-md__body a {\n  color: var(--va-accent, #c2410c);\n  font-weight: inherit; /* 防宿主链接规则加粗 */\n  text-decoration: none;\n}\n.va-md .va-md__body a:hover {\n  text-decoration: underline;\n}\n\n/* 分割线 */\n.va-md .va-md__body hr {\n  border: none;\n  border-top: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  margin: var(--va-s4, 12px) 0;\n}\n\n/* 粗体：锁定字重，不随宿主 strong 规则漂移 */\n.va-md .va-md__body strong {\n  font-weight: var(--va-fw-bold, 700);\n}\n\n/* 流式光标指示器 */\n.va-md__caret {\n  display: inline-block;\n  width: 6px;\n  height: 14px;\n  vertical-align: -2px;\n  margin-left: 2px;\n  background: var(--va-accent, #c2410c);\n  border-radius: 1px;\n  animation: va-stream-caret 1s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n}\n\n/* 流光标闪烁共享关键帧（TASK-103 统一，规范名 va-stream-caret）：\n   与 stream-answer/VaStreamAnswer.css 同名同 body——单文件拷贝分发要求\n   各文件自含，跨文件一致性由 scripts/check-tokens.mjs 的同名同 body 门禁锁定 */\n@keyframes va-stream-caret {\n  0%, 100% { opacity: 1; }\n  50% { opacity: 0; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-md__caret { animation: none; opacity: 0.8; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/markdown/index.ts",
      "type": "registry:ui",
      "target": "components/ui/markdown/index.ts",
      "content": "export { default as VaMarkdown } from \"./VaMarkdown.vue\";\nexport type { MarkdownProps } from \"./types\";\n"
    },
    {
      "path": "components/ui/markdown/types.ts",
      "type": "registry:ui",
      "target": "components/ui/markdown/types.ts",
      "content": "export interface MarkdownProps {\n  /** Markdown 原始字符串 */\n  content?: string;\n  /** 是否处于流式生成中（结尾追加呼吸感光标） */\n  streaming?: boolean;\n  /** 自动将 URL 识别为可点击超链接，默认 true */\n  linkify?: boolean;\n  /** 将 \\n 转换为 <br>（对话场景友好），默认 true */\n  breaks?: boolean;\n}\n"
    }
  ]
}
