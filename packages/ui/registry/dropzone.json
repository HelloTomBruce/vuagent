{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "dropzone",
  "title": "Dropzone",
  "description": "拖放上传区：拖入高亮（计数防抖）、点击/键盘选择、大小校验拒绝、文件列表带进度条与错误回显、受控列表由宿主驱动。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `files` (DropzoneFile[]，默认 -)：受控列表（progress/status/error 由宿主更新）\n- `accept / multiple / maxSizeMb` (string / boolean / number，默认 - / false / -)：选择约束\n- `@add / @remove / @reject` (-，默认 -)：添加 / 移除 / 超大小拒绝",
  "files": [
    {
      "path": "components/ui/dropzone/VaDropzone.vue",
      "type": "registry:ui",
      "target": "components/ui/dropzone/VaDropzone.vue",
      "content": "<script setup lang=\"ts\">\nimport { useTemplateRef } from \"vue\";\nimport type { DropzoneEvents, DropzoneProps } from \"./types\";\nimport { useDropzone } from \"./useDropzone\";\n\nconst props = defineProps<DropzoneProps>();\n\nconst emit = defineEmits<DropzoneEvents>();\n\nconst inputEl = useTemplateRef<HTMLInputElement>(\"input\");\nconst {\n  dragging,\n  onDragenter,\n  onDragover,\n  onDragleave,\n  onDrop,\n  openPicker,\n  onInputChange,\n  formatBytes,\n} = useDropzone(props, inputEl, {\n  add: (files) => emit(\"add\", files),\n  reject: (files, reason) => emit(\"reject\", files, reason),\n});\n\nfunction onZoneKeydown(e: KeyboardEvent) {\n  if (e.key === \"Enter\" || e.key === \" \") {\n    e.preventDefault();\n    openPicker();\n  }\n}\n</script>\n\n<template>\n  <div class=\"va-drop\">\n    <div\n      class=\"va-drop__zone\"\n      :class=\"{ 'va-drop__zone--over': dragging, 'va-drop__zone--busy': props.busy }\"\n      role=\"button\"\n      tabindex=\"0\"\n      :aria-label=\"props.label ?? '点击或拖入文件上传'\"\n      :aria-disabled=\"props.busy\"\n      @click=\"openPicker\"\n      @keydown=\"onZoneKeydown\"\n      @dragenter=\"onDragenter\"\n      @dragover=\"onDragover\"\n      @dragleave=\"onDragleave\"\n      @drop=\"onDrop\"\n    >\n      <span class=\"va-drop__arrow\" aria-hidden=\"true\">↑</span>\n      <p class=\"va-drop__label\">{{ props.label ?? (props.multiple ? \"拖入或点击选择文件\" : \"拖入或点击选择文件\") }}</p>\n      <p class=\"va-drop__hint\">\n        {{ props.accept ? `支持 ${props.accept}` : \"任意文件类型\" }}\n        {{ props.maxSizeMb ? ` · 单个 ≤ ${props.maxSizeMb}MB` : \"\" }}\n      </p>\n      <input\n        ref=\"input\"\n        class=\"va-drop__input\"\n        type=\"file\"\n        :accept=\"props.accept\"\n        :multiple=\"props.multiple\"\n        aria-hidden=\"true\"\n        tabindex=\"-1\"\n        @change=\"onInputChange\"\n      >\n    </div>\n\n    <ul v-if=\"props.files.length\" class=\"va-drop__list\">\n      <li\n        v-for=\"f in props.files\"\n        :key=\"f.id\"\n        class=\"va-drop__file\"\n        :data-status=\"f.status ?? (f.error ? 'error' : f.progress !== undefined && f.progress < 100 ? 'uploading' : 'done')\"\n      >\n        <span class=\"va-drop__icon\" aria-hidden=\"true\">\n          <template v-if=\"f.status === 'error' || f.error\">!</template>\n          <template v-else-if=\"(f.status ?? 'done') === 'done' && (f.progress ?? 100) >= 100\">✓</template>\n          <template v-else>↑</template>\n        </span>\n        <div class=\"va-drop__meta\">\n          <div class=\"va-drop__line\">\n            <span class=\"va-drop__name\">{{ f.name }}</span>\n            <span class=\"va-drop__size\">{{ formatBytes(f.size) }}</span>\n            <span v-if=\"f.error\" class=\"va-drop__err\" role=\"alert\">{{ f.error }}</span>\n            <span v-else-if=\"(f.progress ?? 100) < 100\" class=\"va-drop__pct\">{{ Math.round(f.progress ?? 0) }}%</span>\n          </div>\n          <div v-if=\"!f.error && (f.progress ?? 100) < 100\" class=\"va-drop__track\">\n            <span class=\"va-drop__bar\" :style=\"{ width: `${f.progress ?? 0}%` }\" />\n          </div>\n        </div>\n        <button\n          class=\"va-drop__remove\"\n          type=\"button\"\n          :aria-label=\"`移除 ${f.name}`\"\n          @click=\"emit('remove', f.id)\"\n        >×</button>\n      </li>\n    </ul>\n  </div>\n</template>\n\n<style>\n/* VaDropzone — 拖放上传区 */\n\n.va-drop {\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s4);\n}\n\n.va-drop__zone {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: var(--va-s2);\n  padding: var(--va-s7) var(--va-s5);\n  border: 1.5px dashed var(--va-edge-strong);\n  border-radius: var(--va-radius-l);\n  background: var(--va-card);\n  cursor: pointer;\n  transition: border-color var(--va-dur-2) var(--va-ease), background var(--va-dur-2) var(--va-ease);\n}\n\n.va-drop__zone:hover,\n.va-drop__zone:focus-visible {\n  border-color: var(--va-accent);\n  outline: none;\n}\n\n.va-drop__zone--over {\n  border-color: var(--va-accent);\n  border-style: solid;\n  background: var(--va-accent-soft);\n}\n\n.va-drop__zone--busy { opacity: 0.55; cursor: default; }\n.va-drop__zone--busy:hover { border-color: var(--va-edge-strong); }\n\n.va-drop__arrow {\n  width: 36px;\n  height: 36px;\n  border-radius: 50%;\n  background: var(--va-bg-subtle);\n  color: var(--va-ink-2);\n  font-size: 17px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  transition: transform var(--va-dur-2) var(--va-ease);\n}\n\n.va-drop__zone--over .va-drop__arrow {\n  transform: translateY(-3px);\n  background: var(--va-accent);\n  color: var(--va-card);\n}\n\n.va-drop__label { margin: 0; font-size: 13.5px; font-weight: 600; color: var(--va-ink); }\n.va-drop__hint { margin: 0; font-size: 12px; color: var(--va-muted); }\n\n.va-drop__input {\n  position: absolute;\n  inset: 0;\n  opacity: 0;\n  pointer-events: none;\n}\n\n.va-drop__list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s2);\n}\n\n.va-drop__file {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3);\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-card);\n  padding: var(--va-s3) var(--va-s4);\n}\n\n.va-drop__file[data-status=\"error\"] { border-color: color-mix(in srgb, var(--va-danger) 45%, transparent); }\n\n.va-drop__icon {\n  flex: none;\n  width: 22px;\n  height: 22px;\n  border-radius: 50%;\n  background: var(--va-bg-subtle);\n  color: var(--va-ink-2);\n  font-size: 12px;\n  font-weight: 700;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.va-drop__file[data-status=\"done\"] .va-drop__icon { background: color-mix(in srgb, var(--va-success) 16%, transparent); color: var(--va-success); }\n.va-drop__file[data-status=\"error\"] .va-drop__icon { background: color-mix(in srgb, var(--va-danger) 14%, transparent); color: var(--va-danger); }\n.va-drop__file[data-status=\"uploading\"] .va-drop__icon { background: var(--va-accent-soft); color: var(--va-accent); }\n\n.va-drop__meta { flex: 1; min-width: 0; }\n\n.va-drop__line {\n  display: flex;\n  align-items: baseline;\n  gap: var(--va-s3);\n}\n\n.va-drop__name {\n  font-size: 13px;\n  color: var(--va-ink);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.va-drop__size { flex: none; font-size: 11.5px; color: var(--va-muted); font-variant-numeric: tabular-nums; }\n.va-drop__pct { flex: none; font-size: 11.5px; color: var(--va-accent); font-variant-numeric: tabular-nums; }\n.va-drop__err { flex: none; font-size: 11.5px; color: var(--va-danger); }\n\n.va-drop__track {\n  margin-top: 6px;\n  height: 4px;\n  border-radius: var(--va-radius-pill);\n  background: var(--va-bg-subtle);\n  overflow: hidden;\n}\n\n.va-drop__bar {\n  display: block;\n  height: 100%;\n  border-radius: inherit;\n  background: var(--va-accent);\n  transition: width var(--va-dur-2) var(--va-ease);\n}\n\n.va-drop__remove {\n  flex: none;\n  border: 0;\n  border-radius: var(--va-radius-s);\n  background: transparent;\n  color: var(--va-muted);\n  font-size: 15px;\n  line-height: 1;\n  width: 24px;\n  height: 24px;\n  cursor: pointer;\n}\n\n.va-drop__remove:hover { background: var(--va-bg-subtle); color: var(--va-danger); }\n.va-drop__remove:focus-visible { outline: 2px solid var(--va-accent); }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-drop__zone,\n  .va-drop__arrow,\n  .va-drop__bar { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/dropzone/formatSize.ts",
      "type": "registry:ui",
      "target": "components/ui/dropzone/formatSize.ts",
      "content": "/** 字节数人性化（B/KB/MB/GB），零依赖 */\nexport function formatBytes(bytes: number): string {\n  if (!Number.isFinite(bytes) || bytes < 0) return \"0 B\";\n  const units = [\"B\", \"KB\", \"MB\", \"GB\"];\n  let v = bytes;\n  let i = 0;\n  while (v >= 1024 && i < units.length - 1) {\n    v /= 1024;\n    i++;\n  }\n  const text = Number.isInteger(v) || v >= 100 ? String(Math.round(v)) : v.toFixed(1);\n  return `${text} ${units[i]}`;\n}\n"
    },
    {
      "path": "components/ui/dropzone/types.ts",
      "type": "registry:ui",
      "target": "components/ui/dropzone/types.ts",
      "content": "/** VaDropzone 的类型定义 */\n\nexport type DropzoneFileStatus = \"uploading\" | \"done\" | \"error\";\n\nexport interface DropzoneFile {\n  id: string;\n  name: string;\n  /** 字节数 */\n  size: number;\n  /** 上传进度 0-100；<100 且无 error 视为进行中 */\n  progress?: number;\n  status?: DropzoneFileStatus;\n  /** 校验/上传错误文案 */\n  error?: string;\n}\n\nexport interface DropzoneProps {\n  /** 受控文件列表（上传进度由宿主驱动更新） */\n  files: DropzoneFile[];\n  /** input accept 属性，如 \".csv,image/*\" */\n  accept?: string;\n  /** 多选；默认 false */\n  multiple?: boolean;\n  /** 单文件大小上限 MB；超出拒绝并 emit reject */\n  maxSizeMb?: number;\n  /** 拖放区文案 */\n  label?: string;\n  /** 上传中禁用新选择 */\n  busy?: boolean;\n}\n\nexport interface DropzoneEvents {\n  /** 用户添加了文件（已通过 accept/maxSize 前置校验的原始 File 对象） */\n  add: [files: File[]];\n  /** 移除列表项 */\n  remove: [id: string];\n  /** 被拒文件（超大小） */\n  reject: [files: File[], reason: \"too-large\"];\n}\n"
    },
    {
      "path": "components/ui/dropzone/useDropzone.ts",
      "type": "registry:ui",
      "target": "components/ui/dropzone/useDropzone.ts",
      "content": "import { ref, type Ref } from \"vue\";\nimport type { DropzoneProps } from \"./types\";\nimport { formatBytes } from \"./formatSize\";\n\n/**\n * VaDropzone 的拖放状态机 + 文件选择。\n * 组件不持有文件列表（受控 files），只发出 add/remove/reject；inputEl 由组件 useTemplateRef 传入。\n */\nexport function useDropzone(\n  props: DropzoneProps,\n  inputEl: Ref<HTMLInputElement | null>,\n  emit: {\n    add: (files: File[]) => void;\n    reject: (files: File[], reason: \"too-large\") => void;\n  },\n) {\n  const dragging = ref(false);\n  /** dragenter/leave 计数（子元素会交替触发成对事件） */\n  let depth = 0;\n\n  function onDragenter(e: DragEvent) {\n    if (!hasFiles(e)) return;\n    e.preventDefault();\n    depth++;\n    dragging.value = true;\n  }\n\n  function onDragover(e: DragEvent) {\n    if (!hasFiles(e)) return;\n    e.preventDefault(); // 允许 drop\n  }\n\n  function onDragleave() {\n    depth = Math.max(0, depth - 1);\n    if (depth === 0) dragging.value = false;\n  }\n\n  function onDrop(e: DragEvent) {\n    if (!hasFiles(e)) return;\n    e.preventDefault();\n    depth = 0;\n    dragging.value = false;\n    ingest(Array.from(e.dataTransfer?.files ?? []));\n  }\n\n  function openPicker() {\n    if (props.busy) return;\n    inputEl.value?.click();\n  }\n\n  function onInputChange(e: Event) {\n    const input = e.target as HTMLInputElement;\n    ingest(Array.from(input.files ?? []));\n    input.value = \"\"; // 允许重复选同一文件\n  }\n\n  function ingest(files: File[]) {\n    if (!files.length || props.busy) return;\n    if (!props.multiple) files = files.slice(0, 1);\n    const limit = props.maxSizeMb ? props.maxSizeMb * 1024 * 1024 : Infinity;\n    const ok = files.filter((f) => f.size <= limit);\n    const bad = files.filter((f) => f.size > limit);\n    if (ok.length) emit.add(ok);\n    if (bad.length) emit.reject(bad, \"too-large\");\n  }\n\n  return { dragging, inputEl, onDragenter, onDragover, onDragleave, onDrop, openPicker, onInputChange, formatBytes };\n}\n\nfunction hasFiles(e: DragEvent) {\n  return Array.from(e.dataTransfer?.types ?? []).includes(\"Files\");\n}\n"
    }
  ]
}
