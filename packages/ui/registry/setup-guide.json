{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "setup-guide",
  "title": "Setup Guide",
  "description": "上手引导清单：逐项完成/跳过（optional 步骤）、进度计数、全部就绪收尾提示，完成时触发 allDone。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `steps` (SetupStep[]，默认 -)：id/title/description/status/optional\n- `@complete / @skip / @allDone` (-，默认 -)：步骤处理回调",
  "files": [
    {
      "path": "components/ui/setup-guide/VaSetupGuide.vue",
      "type": "registry:ui",
      "target": "components/ui/setup-guide/VaSetupGuide.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, watch, ref } from \"vue\";\nimport type { SetupGuideEvents, SetupGuideProps } from \"./types\";\n\nconst props = defineProps<SetupGuideProps>();\n\nconst emit = defineEmits<SetupGuideEvents>();\n\nconst pending = computed(() => props.steps.filter((s) => !s.status));\nconst progress = computed(() => props.steps.length - pending.value.length);\n\nconst allDoneNotified = ref(false);\nwatch(\n  () => props.steps.every((s) => s.status),\n  (done, was) => {\n    if (done && !was && !allDoneNotified.value) {\n      allDoneNotified.value = true;\n      emit(\"allDone\");\n    }\n  },\n  { immediate: true },\n);\n</script>\n\n<template>\n  <section class=\"va-sg\" :aria-label=\"props.title ?? '开始准备'\">\n    <header class=\"va-sg__head\">\n      <h3 class=\"va-sg__title\">{{ props.title ?? \"开始准备\" }}</h3>\n      <span class=\"va-sg__progress\" role=\"status\">{{ progress }}/{{ steps.length }}</span>\n    </header>\n\n    <ol class=\"va-sg__list\">\n      <li\n        v-for=\"s in steps\"\n        :key=\"s.id\"\n        class=\"va-sg__item\"\n        :data-status=\"s.status ?? 'pending'\"\n      >\n        <span class=\"va-sg__mark\" aria-hidden=\"true\">\n          <template v-if=\"s.status === 'done'\">✓</template>\n          <template v-else-if=\"s.status === 'skipped'\">–</template>\n        </span>\n        <div class=\"va-sg__main\">\n          <span class=\"va-sg__name\">{{ s.title }}</span>\n          <span v-if=\"s.description\" class=\"va-sg__desc\">{{ s.description }}</span>\n        </div>\n        <div v-if=\"!s.status\" class=\"va-sg__ops\">\n          <button class=\"va-sg__btn va-sg__btn--primary\" type=\"button\" @click=\"emit('complete', s.id)\">\n            {{ s.actionLabel ?? \"完成\" }}\n          </button>\n          <button v-if=\"s.optional\" class=\"va-sg__btn\" type=\"button\" @click=\"emit('skip', s.id)\">跳过</button>\n        </div>\n        <span v-else class=\"va-sg__state\">{{ s.status === \"done\" ? \"已完成\" : \"已跳过\" }}</span>\n      </li>\n    </ol>\n\n    <p v-if=\"!pending.length\" class=\"va-sg__done\">\n      {{ props.finishLabel ?? \"全部就绪，开始使用吧！\" }}\n    </p>\n  </section>\n</template>\n\n<style>\n/* VaSetupGuide — 上手引导清单 */\n\n.va-sg {\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-m);\n  background: var(--va-card);\n  padding: var(--va-s5);\n}\n\n.va-sg__head {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  margin-bottom: var(--va-s4);\n}\n\n.va-sg__title { margin: 0; font-size: 15px; font-weight: 700; color: var(--va-ink); }\n\n.va-sg__progress {\n  font-size: 12px;\n  color: var(--va-muted);\n  font-variant-numeric: tabular-nums;\n}\n\n.va-sg__list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n}\n\n.va-sg__item {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s4);\n  padding: var(--va-s4) 0;\n}\n\n.va-sg__item + .va-sg__item { border-top: 1px solid var(--va-edge); }\n.va-sg__item[data-status=\"done\"],\n.va-sg__item[data-status=\"skipped\"] { opacity: 0.62; }\n\n.va-sg__mark {\n  flex: none;\n  width: 26px;\n  height: 26px;\n  border-radius: 50%;\n  border: 2px solid var(--va-edge-strong);\n  color: transparent;\n  font-size: 12px;\n  font-weight: 700;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  box-sizing: border-box;\n}\n\n.va-sg__item[data-status=\"done\"] .va-sg__mark {\n  border-color: var(--va-success);\n  background: var(--va-success);\n  color: #fff;\n}\n\n.va-sg__item[data-status=\"skipped\"] .va-sg__mark { border-style: dashed; color: var(--va-muted); }\n\n.va-sg__main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }\n\n.va-sg__name { font-size: 13.5px; font-weight: 600; color: var(--va-ink); }\n.va-sg__desc { font-size: 12px; color: var(--va-muted); line-height: 1.5; }\n\n.va-sg__ops { display: flex; gap: var(--va-s2); flex: none; }\n\n.va-sg__btn {\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-card);\n  color: var(--va-ink-2);\n  font-size: 12.5px;\n  padding: 4px 12px;\n  cursor: pointer;\n}\n\n.va-sg__btn:hover { border-color: var(--va-edge-strong); }\n.va-sg__btn:focus-visible { outline: 2px solid var(--va-accent); outline-offset: 1px; }\n\n.va-sg__btn--primary {\n  background: var(--va-accent);\n  border-color: var(--va-accent);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-sg__btn--primary:hover { background: var(--va-accent-hover); border-color: var(--va-accent-hover); }\n\n.va-sg__state { flex: none; font-size: 12px; color: var(--va-muted); }\n\n.va-sg__done {\n  margin: var(--va-s4) 0 0;\n  padding: var(--va-s4);\n  border-radius: var(--va-radius-s);\n  background: color-mix(in srgb, var(--va-success) 10%, transparent);\n  color: var(--va-success);\n  font-size: 13px;\n  font-weight: 600;\n}\n</style>\n"
    },
    {
      "path": "components/ui/setup-guide/types.ts",
      "type": "registry:ui",
      "target": "components/ui/setup-guide/types.ts",
      "content": "/** VaSetupGuide 的类型定义 */\n\nexport interface SetupStep {\n  id: string;\n  title: string;\n  description?: string;\n  /** 宿主维护的完成态：undefined 进行中 */\n  status?: \"done\" | \"skipped\";\n  /** 可跳过（显示\"跳过\"按钮） */\n  optional?: boolean;\n  /** 步骤完成动作文案，默认\"完成\" */\n  actionLabel?: string;\n}\n\nexport interface SetupGuideProps {\n  steps: SetupStep[];\n  /** 标题，默认\"开始准备\" */\n  title?: string;\n  /** 完成全部后展示的收尾文案 */\n  finishLabel?: string;\n}\n\nexport interface SetupGuideEvents {\n  /** 点击步骤完成动作 */\n  complete: [id: string];\n  /** 点击跳过 */\n  skip: [id: string];\n  /** 全部处理完（无进行中步骤）时触发一次 */\n  allDone: [];\n}\n"
    }
  ]
}
