{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "setup-guide",
  "title": "Setup Guide",
  "description": "上手引导清单：逐项完成/跳过（optional 步骤）、进度计数、全部就绪收尾提示，完成时触发 allDone。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `steps` (SetupStep[]，默认 -)：id/title/description/status/optional\n- `@complete / @skip / @allDone` (-，默认 -)：步骤处理回调",
  "files": [
    {
      "path": "components/ui/setup-guide/VaSetupGuide.vue",
      "type": "registry:ui",
      "target": "components/ui/setup-guide/VaSetupGuide.vue",
      "content": "<script setup lang=\"ts\">import { computed, watch, ref } from \"vue\";\n\nimport type { SetupGuideEvents, SetupGuideProps } from \"./types\";\n\nconst props = defineProps<SetupGuideProps>();\n\nconst emit = defineEmits<SetupGuideEvents>();\n\nconst pending = computed(() => props.steps.filter((s) => !s.status));\nconst progress = computed(() => props.steps.length - pending.value.length);\n\nconst allDoneNotified = ref(false);\nwatch(\n  () => props.steps.every((s) => s.status),\n  (done, was) => {\n    if (done && !was && !allDoneNotified.value) {\n      allDoneNotified.value = true;\n      emit(\"allDone\");\n    }\n  },\n  { immediate: true },\n);\n\n/**\n * 步骤行错峰（TASK-108）：统一消费 useStagger（animation-delay 轴，配合 .va-enter-*\n * 动画类使用；默认档位对齐 --va-stagger 40ms 步长、8 档钳制、reduced-motion 归零；\n * SSR 无 window 按正常分支输出，服务端与客户端首帧一致）。\n */\nconst { delayStyle } = useStagger();\n\n/* ── 内联自 @vuagent/ui src/composables/useStagger.ts（registry 单文件拷贝自包含） ── */\n/**\n * 列表子项进出场错峰编排（TASK-102 动效基建）：\n * 返回 delayStyle(index) 供 v-for 子项绑定 :style，配合 .va-enter-* 动画类使用\n * （.va-enter-* 全是 CSS animation，延迟轴为 animation-delay——transition-delay\n * 对 animation 零作用；动画 fill-mode both 保首帧，延迟期间不闪跳）。\n * 步长口径对齐 tokens.css 的 --va-stagger（40ms）；\n * reduced-motion 下延迟归零（动画降级本身由 motion.css 媒体查询处理）。\n *\n * SSR 安全：无 window/matchMedia 时跳过检测、按正常分支返回——服务端与客户端\n * 首帧输出一致，避免 hydration 抖动；reduced-motion 检测照抄现有 composable\n * 范式（window.matchMedia?.() 整链短路），挂载时机一次性读取，不监听系统切换。\n */\ninterface UseStaggerOptions {\n  /** 相邻子项延迟步长 ms（默认 40，同 --va-stagger） */\n  stepMs?: number;\n  /** 错峰档位上限：index 超过后钳制在档顶（默认 8，防长列表末项等待过久） */\n  maxItems?: number;\n  /** 置真时恒返回 0ms 延迟（宿主自行关闭错峰） */\n  disabled?: boolean;\n}\n\nfunction useStagger(options: UseStaggerOptions = {}) {\n  const stepMs = options.stepMs ?? 40;\n  const maxItems = options.maxItems ?? 8;\n  const disabled = options.disabled ?? false;\n\n  const reduced =\n    typeof window !== \"undefined\" &&\n    (window.matchMedia?.(\"(prefers-reduced-motion: reduce)\").matches ?? false);\n\n  /** 配合 .va-enter-* 动画类使用：animation-delay 按 0 起步长递增，超过档位上限后钳制 */\n  function delayStyle(index: number): Record<string, string> {\n    if (reduced || disabled) return { \"animation-delay\": \"0ms\" };\n    const delay = Math.min(Math.max(index, 0), maxItems) * stepMs;\n    return { \"animation-delay\": `${delay}ms` };\n  }\n\n  return { delayStyle };\n}\n</script>\n\n<template>\n  <section class=\"va-sg\" :aria-label=\"props.title ?? '开始准备'\">\n    <header class=\"va-sg__head\">\n      <h3 class=\"va-sg__title\">{{ props.title ?? \"开始准备\" }}</h3>\n      <span class=\"va-sg__progress\" role=\"status\">{{ progress }}/{{ steps.length }}</span>\n    </header>\n\n    <ol class=\"va-sg__list\">\n      <li\n        v-for=\"(s, i) in steps\"\n        :key=\"s.id\"\n        class=\"va-sg__item va-enter-up\"\n        :style=\"delayStyle(i)\"\n        :data-status=\"s.status ?? 'pending'\"\n      >\n        <span class=\"va-sg__mark\" aria-hidden=\"true\">\n          <template v-if=\"s.status === 'done'\">✓</template>\n          <template v-else-if=\"s.status === 'skipped'\">–</template>\n        </span>\n        <div class=\"va-sg__main\">\n          <span class=\"va-sg__name\">{{ s.title }}</span>\n          <span v-if=\"s.description\" class=\"va-sg__desc\">{{ s.description }}</span>\n        </div>\n        <div v-if=\"!s.status\" class=\"va-sg__ops\">\n          <button class=\"va-act va-act--sm va-act--primary va-sg__btn\" type=\"button\" @click=\"emit('complete', s.id)\">\n            {{ s.actionLabel ?? \"完成\" }}\n          </button>\n          <button v-if=\"s.optional\" class=\"va-act va-act--sm va-sg__btn\" type=\"button\" @click=\"emit('skip', s.id)\">跳过</button>\n        </div>\n        <span v-else class=\"va-sg__state\">{{ s.status === \"done\" ? \"已完成\" : \"已跳过\" }}</span>\n      </li>\n    </ol>\n\n    <p v-if=\"!pending.length\" class=\"va-sg__done va-enter-up\">\n      {{ props.finishLabel ?? \"全部就绪，开始使用吧！\" }}\n    </p>\n  </section>\n</template>\n\n<style>\n/* VaSetupGuide — 上手引导清单 */\n\n.va-sg {\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-m, 10px);\n  background: var(--va-card, #ffffff);\n  padding: var(--va-s5, 16px);\n}\n\n.va-sg__head {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  margin-bottom: var(--va-s4, 12px);\n}\n\n.va-sg__title { margin: 0; font-size: var(--va-fs-lg, 14px); font-weight: var(--va-fw-bold, 700); color: var(--va-ink, #1a1917); }\n\n.va-sg__progress {\n  font-size: var(--va-fs-sm, 12px);\n  color: var(--va-muted, #6f6d66);\n  font-variant-numeric: tabular-nums;\n}\n\n.va-sg__list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n}\n\n.va-sg__item {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s4, 12px);\n  padding: var(--va-s4, 12px) 0;\n}\n\n.va-sg__item + .va-sg__item { border-top: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12)); }\n.va-sg__item[data-status=\"done\"],\n.va-sg__item[data-status=\"skipped\"] { opacity: 0.62; }\n\n.va-sg__mark {\n  flex: none;\n  width: 26px;\n  height: 26px;\n  border-radius: 50%;\n  border: 2px solid var(--va-edge-strong, rgba(26, 25, 23, 0.22));\n  color: transparent;\n  font-size: var(--va-fs-sm, 12px);\n  font-weight: var(--va-fw-bold, 700);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  box-sizing: border-box;\n  transition:\n    border-color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    background-color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-sg__item[data-status=\"done\"] .va-sg__mark {\n  border-color: var(--va-success, #1a7f4b);\n  background: var(--va-success, #1a7f4b);\n  color: var(--va-success-contrast, #fff);\n}\n\n.va-sg__item[data-status=\"skipped\"] .va-sg__mark { border-style: dashed; color: var(--va-muted, #6f6d66); }\n\n.va-sg__main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }\n\n.va-sg__name { font-size: var(--va-fs-lg, 14px); font-weight: var(--va-fw-semibold, 600); color: var(--va-ink, #1a1917); }\n.va-sg__desc { font-size: var(--va-fs-sm, 12px); color: var(--va-muted, #6f6d66); line-height: 1.5; }\n\n.va-sg__ops { display: flex; gap: var(--va-s2, 4px); flex: none; }\n\n\n\n\n\n.va-sg__state { flex: none; font-size: var(--va-fs-sm, 12px); color: var(--va-muted, #6f6d66); }\n\n.va-sg__done {\n  margin: var(--va-s4, 12px) 0 0;\n  padding: var(--va-s4, 12px);\n  border-radius: var(--va-radius-s, 8px);\n  background: color-mix(in srgb, var(--va-success, #1a7f4b) 10%, transparent);\n  color: var(--va-success, #1a7f4b);\n  font-size: var(--va-fs-md, 13px);\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n/* ---- TASK-108 完成勾选动画 ----\n   status 翻到 done 时 data-status 选择器新命中 → 动画启动（pop 一次）；\n   mark 底色/描边同步平滑过渡（pending → done 的颜色渐变）。 */\n.va-sg__item[data-status=\"done\"] .va-sg__mark {\n  animation: va-sg-check-pop var(--va-dur-2, 200ms) var(--va-ease-spring, cubic-bezier(0.34, 1.56, 0.64, 1)) both;\n}\n\n@keyframes va-sg-check-pop {\n  0% { transform: scale(0.5); }\n  60% { transform: scale(1.15); }\n  100% { transform: scale(1); }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-sg__mark {\n    transition: none;\n    animation: none;\n  }\n}\n\n/* 按钮基类（自动附带） */\n/* ============================================================\n   按钮基类 —— 全库动作按钮的单一样式来源。\n   组件叠加使用：class=\"va-act va-act--primary va-xxx__submit\"，\n   组件自己的 CSS 只写布局/色彩覆盖（width、pill 圆角等）。\n   registry 生成器会把本文件自动内联进用了 va-act 的组件拷贝。\n   ============================================================ */\n\n.va-act {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--va-s3h, 6px);\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-s, 8px);\n  background: var(--va-card, #ffffff);\n  color: var(--va-ink-2, #43413c);\n  font: inherit;\n  font-size: var(--va-fs-md, 13px);\n  line-height: 1.4;\n  padding: 5px 14px;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: border-color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), background var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-act:hover:not(:disabled) { border-color: var(--va-edge-strong, rgba(26, 25, 23, 0.22)); }\n\n/* 按压反馈（TASK-105 基类口径，对齐 VaButton）：下沉 0.5px + 微缩 0.985，\n   时长走 --va-dur-1。组件不再逐个发明 :active 缩放值。 */\n.va-act:active:not(:disabled) { transform: translateY(0.5px) scale(0.985); }\n\n.va-act:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: 1px; }\n\n.va-act:disabled { opacity: 0.45; cursor: default; }\n\n/* 尺寸 */\n.va-act--sm { font-size: var(--va-fs-sm, 12px); padding: 3px var(--va-s4h, 10px); }\n.va-act--lg { font-size: var(--va-fs-lg, 14px); padding: 7px 18px; }\n\n/* 变体 */\n.va-act--primary {\n  background: var(--va-accent, #c2410c);\n  border-color: var(--va-accent, #c2410c);\n  color: var(--va-card, #ffffff);\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n.va-act--primary:hover:not(:disabled) {\n  background: var(--va-accent-hover, #9a3412);\n  border-color: var(--va-accent-hover, #9a3412);\n}\n\n.va-act--ghost {\n  border-color: transparent;\n  background: transparent;\n}\n\n.va-act--ghost:hover:not(:disabled) { background: var(--va-bg-subtle, #efede7); }\n\n.va-act--danger { border-color: transparent; background: transparent; color: var(--va-danger, #d5453c); }\n\n.va-act--danger:hover:not(:disabled) {\n  background: color-mix(in srgb, var(--va-danger, #d5453c) 10%, transparent);\n  border-color: transparent;\n}\n\n/* 语义色实底（成功/危险确认场景，按需叠加） */\n.va-act--success {\n  background: var(--va-success, #1a7f4b);\n  border-color: var(--va-success, #1a7f4b);\n  color: #fff;\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n/* 墨色实底：审批/决策/应用这类\"终审\"主操作（区别于 accent 常规主操作） */\n.va-act--ink {\n  background: var(--va-ink, #1a1917);\n  border-color: var(--va-ink, #1a1917);\n  color: var(--va-card, #ffffff);\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n.va-act--ink:hover:not(:disabled) { opacity: 0.88; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-act { transition: none; }\n  /* 按压降级：去位移，只留透明度反馈（状态可感知性保留，TASK-105 口径） */\n  .va-act:active:not(:disabled) { transform: none; opacity: 0.7; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/setup-guide/index.ts",
      "type": "registry:ui",
      "target": "components/ui/setup-guide/index.ts",
      "content": "export { default as VaSetupGuide } from \"./VaSetupGuide.vue\";\nexport type { SetupGuideEvents, SetupGuideProps, SetupStep } from \"./types\";\n"
    },
    {
      "path": "components/ui/setup-guide/types.ts",
      "type": "registry:ui",
      "target": "components/ui/setup-guide/types.ts",
      "content": "/** VaSetupGuide 的类型定义 */\n\nexport interface SetupStep {\n  id: string;\n  title: string;\n  description?: string;\n  /** 宿主维护的完成态：undefined 进行中 */\n  status?: \"done\" | \"skipped\";\n  /** 可跳过（显示\"跳过\"按钮） */\n  optional?: boolean;\n  /** 步骤完成动作文案，默认\"完成\" */\n  actionLabel?: string;\n}\n\nexport interface SetupGuideProps {\n  steps: SetupStep[];\n  /** 标题，默认\"开始准备\" */\n  title?: string;\n  /** 完成全部后展示的收尾文案 */\n  finishLabel?: string;\n}\n\nexport interface SetupGuideEvents {\n  /** 点击步骤完成动作 */\n  complete: [id: string];\n  /** 点击跳过 */\n  skip: [id: string];\n  /** 全部处理完（无进行中步骤）时触发一次 */\n  allDone: [];\n}\n"
    }
  ]
}
