      "content": "/** VaOnboarding 的类型定义 */\n\nexport interface OnboardingProps {\n  /** 主标题 */\n  title: string;\n  /** 副标题 */\n  subtitle?: string;\n  /** 主 CTA 文案与事件 */\n  ctaLabel?: string;\n  /** 次 CTA（如\"看文档\"） */\n  secondaryCtaLabel?: string;\n  /** 品牌小字 */\n  brand?: string;\n}\n\nexport interface OnboardingEvents {\n  /** 点击主 CTA */\n  cta: [];\n  /** 点击次 CTA */\n  secondaryCta: [];\n}\n"
    }
  ]
