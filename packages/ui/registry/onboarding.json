      "target": "components/ui/onboarding/VaOnboarding.vue",
      "content": "<script setup lang=\"ts\">\nimport type { OnboardingEvents, OnboardingProps } from \"./types\";\n\nconst props = defineProps<OnboardingProps>();\n\nconst emit = defineEmits<OnboardingEvents>();\n</script>\n\n<template>\n  <section class=\"va-ob\" aria-label=\"开始使用\">\n    <div class=\"va-ob__hero\">\n      <span v-if=\"props.brand\" class=\"va-ob__brand\"><span class=\"va-ob__dot\" aria-hidden=\"true\" />{{ props.brand }}</span>\n      <h1 class=\"va-ob__title\">{{ props.title }}</h1>\n      <p v-if=\"props.subtitle\" class=\"va-ob__subtitle\">{{ props.subtitle }}</p>\n      <div class=\"va-ob__ctas\">\n        <button class=\"va-act va-act--lg va-act--primary va-ob__cta\" type=\"button\" @click=\"emit('cta')\">\n          {{ props.ctaLabel ?? \"开始使用\" }}\n        </button>\n        <button\n          v-if=\"props.secondaryCtaLabel\"\n          class=\"va-act va-act--lg va-ob__cta\"\n          type=\"button\"\n          @click=\"emit('secondaryCta')\"\n        >{{ props.secondaryCtaLabel }}</button>\n      </div>\n      <slot name=\"hero-foot\" />\n    </div>\n\n    <div v-if=\"$slots.default\" class=\"va-ob__steps\">\n      <slot />\n    </div>\n  </section>\n</template>\n\n<style>\n/* VaOnboarding — 上手引导页（hero + 步骤区） */\n\n.va-ob {\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s7);\n  align-items: center;\n  padding: var(--va-s7) var(--va-s5);\n  text-align: center;\n}\n\n.va-ob__hero {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: var(--va-s4);\n  max-width: 560px;\n}\n\n.va-ob__brand {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--va-s2);\n  font-size: 12.5px;\n  font-weight: 600;\n  color: var(--va-muted);\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-pill);\n  padding: 3px 12px;\n  background: var(--va-card);\n}\n\n.va-ob__dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: var(--va-accent);\n}\n\n.va-ob__title {\n  margin: 0;\n  font-size: clamp(26px, 5vw, 38px);\n  font-weight: 800;\n  letter-spacing: -0.02em;\n  color: var(--va-ink);\n}\n\n.va-ob__subtitle {\n  margin: 0;\n  font-size: 14.5px;\n  line-height: 1.7;\n  color: var(--va-ink-2);\n}\n\n.va-ob__ctas {\n  display: flex;\n  gap: var(--va-s3);\n  flex-wrap: wrap;\n  justify-content: center;\n  margin-top: var(--va-s2);\n}\n\n.va-ob__cta { min-width: 140px; }\n\n.va-ob__steps {\n  width: min(640px, 100%);\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s5);\n  text-align: left;\n}\n\n/* 按钮基类（自动附带） */\n/* ============================================================\n   按钮基类 —— 全库动作按钮的单一样式来源。\n   组件叠加使用：class=\"va-act va-act--primary va-xxx__submit\"，\n   组件自己的 CSS 只写布局/色彩覆盖（width、pill 圆角等）。\n   registry 生成器会把本文件自动内联进用了 va-act 的组件拷贝。\n   ============================================================ */\n\n.va-act {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-card);\n  color: var(--va-ink-2);\n  font: inherit;\n  font-size: 13px;\n  line-height: 1.4;\n  padding: 5px 14px;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: border-color var(--va-dur-1) var(--va-ease), background var(--va-dur-1) var(--va-ease),\n    color var(--va-dur-1) var(--va-ease);\n}\n\n.va-act:hover:not(:disabled) { border-color: var(--va-edge-strong); }\n\n.va-act:focus-visible { outline: 2px solid var(--va-accent); outline-offset: 1px; }\n\n.va-act:disabled { opacity: 0.45; cursor: default; }\n\n/* 尺寸 */\n.va-act--sm { font-size: 12px; padding: 3px 10px; }\n.va-act--lg { font-size: 14px; padding: 7px 18px; }\n\n/* 变体 */\n.va-act--primary {\n  background: var(--va-accent);\n  border-color: var(--va-accent);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-act--primary:hover:not(:disabled) {\n  background: var(--va-accent-hover);\n  border-color: var(--va-accent-hover);\n}\n\n.va-act--ghost {\n  border-color: transparent;\n  background: transparent;\n}\n\n.va-act--ghost:hover:not(:disabled) { background: var(--va-bg-subtle); }\n\n.va-act--danger { border-color: transparent; background: transparent; color: var(--va-danger); }\n\n.va-act--danger:hover:not(:disabled) {\n  background: color-mix(in srgb, var(--va-danger) 10%, transparent);\n  border-color: transparent;\n}\n\n/* 语义色实底（成功/危险确认场景，按需叠加） */\n.va-act--success {\n  background: var(--va-success);\n  border-color: var(--va-success);\n  color: #fff;\n  font-weight: 600;\n}\n\n/* 墨色实底：审批/决策/应用这类\"终审\"主操作（区别于 accent 常规主操作） */\n.va-act--ink {\n  background: var(--va-ink);\n  border-color: var(--va-ink);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-act--ink:hover:not(:disabled) { opacity: 0.88; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-act { transition: none; }\n}\n</style>\n"
    },
