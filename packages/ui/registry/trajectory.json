{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "trajectory",
  "title": "Trajectory",
  "description": "轨迹视图（dsh 形态）：时长/轮次/调用指标条 + 输入/模型/工具三泳道时间线 + 扁平事件台账（角色彩签、第N轮分组、工具 args→result、搜索）。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `events` (TrajEvent[]，默认 -)：lane/role/title/detail/result/at/endAt/turn\n- `ledgerMaxHeight` (number，默认 -)：台账区最大高度\n- `@toggle` (-，默认 -)：展开/收起某行",
  "files": [
    {
      "path": "components/ui/trajectory/VaTrajectory.vue",
      "type": "registry:ui",
      "target": "components/ui/trajectory/VaTrajectory.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, ref } from \"vue\";\nimport type { TrajEvent, TrajectoryEvents, TrajectoryProps } from \"./types\";\n\nconst props = withDefaults(defineProps<TrajectoryProps>(), {});\n\nconst emit = defineEmits<TrajectoryEvents>();\n\n/* ---------- 指标 ---------- */\nconst t0 = computed(() => props.events[0]?.at ?? 0);\nconst t1 = computed(() => {\n  const last = props.events.at(-1);\n  if (!last) return 0;\n  return Math.max(last.endAt ?? last.at, props.events[0]?.at ?? 0);\n});\nconst span = computed(() => Math.max(t1.value - t0.value, 1));\nconst stats = computed(() => ({\n  durationMs: Math.max(t1.value - t0.value, 0),\n  turns: new Set(props.events.map((e) => e.turn)).size,\n  calls: props.events.filter((e) => e.lane === \"tool\").length,\n  subcalls: 0,\n}));\n\nconst fmtDur = (ms: number) => (ms < 1000 ? `${ms}ms` : `${(ms / 1000).toFixed(1)}s`);\n\n/* ---------- 泳道 ---------- */\nconst LANES: Array<{ key: string; label: string }> = [\n  { key: \"input\", label: \"输入\" },\n  { key: \"model\", label: \"模型\" },\n  { key: \"tool\", label: \"工具\" },\n];\nconst laneEvents = (key: string) => props.events.filter((e) => e.lane === key);\nfunction blockStyle(e: TrajEvent) {\n  const left = ((e.at - t0.value) / span.value) * 100;\n  const w = e.endAt !== undefined ? ((e.endAt - e.at) / span.value) * 100 : 0;\n  return {\n    left: `${Math.min(Math.max(left, 0), 99)}%`,\n    width: e.endAt !== undefined ? `${Math.min(Math.max(w, 0.8), 60)}%` : \"10px\",\n  };\n}\n\n/* ---------- 台账（搜索 + 展开） ---------- */\nconst keyword = ref(\"\");\nconst expandedIds = ref<Set<string>>(new Set());\nfunction toggleRow(id: string) {\n  const open = !expandedIds.value.has(id);\n  const next = new Set(expandedIds.value);\n  if (open) next.add(id);\n  else next.delete(id);\n  expandedIds.value = next;\n  emit(\"toggle\", id, open);\n}\nconst filtered = computed(() => {\n  const kw = keyword.value.trim().toLowerCase();\n  if (!kw) return props.events;\n  return props.events.filter(\n    (e) => e.title.toLowerCase().includes(kw) || (e.detail ?? \"\").toLowerCase().includes(kw) || (e.result ?? \"\").toLowerCase().includes(kw),\n  );\n});\n\n/** 台账行分组：turn 首行（或搜索命中首行）标 第N轮 */\nconst turnStartIds = computed(() => {\n  const seen = new Set<number>();\n  const ids = new Set<string>();\n  for (const e of filtered.value) {\n    if (!seen.has(e.turn)) {\n      seen.add(e.turn);\n      ids.add(e.id);\n    }\n  }\n  return ids;\n});\n\nconst fmtTime = (at: number) =>\n  new Date(at).toLocaleTimeString(\"zh-CN\", { hour12: false, hour: \"2-digit\", minute: \"2-digit\", second: \"2-digit\" });\n\nconst ROLE_LABEL: Record<string, string> = {\n  user: \"用户\",\n  assistant: \"助手\",\n  tool: \"工具\",\n  system: \"系统\",\n  context: \"上下文\",\n};\n\nfunction snippet(e: TrajEvent): string {\n  if (e.lane === \"tool\") {\n    const d = e.detail && e.detail.length > 90 ? `${e.detail.slice(0, 90)}…` : (e.detail ?? \"\");\n    const r = e.result && e.result.length > 90 ? `${e.result.slice(0, 90)}…` : (e.result ?? \"\");\n    return d ? `${d}  →  ${r}` : r;\n  }\n  return e.title;\n}\n</script>\n\n<template>\n  <div class=\"va-traj\">\n    <!-- 指标条：时长/轮次/调用/子调用 + 搜索 -->\n    <div class=\"va-traj__bar\">\n      <span class=\"va-traj__chip\">⏱ {{ fmtDur(stats.durationMs) }}</span>\n      <span class=\"va-traj__chip\">轮次 {{ stats.turns }}</span>\n      <span class=\"va-traj__chip\">调用 {{ stats.calls }}</span>\n      <span v-if=\"stats.subcalls\" class=\"va-traj__chip\">子调用 {{ stats.subcalls }}</span>\n      <span class=\"va-traj__spacer\" />\n      <label class=\"va-traj__search\">\n        <input v-model=\"keyword\" type=\"text\" placeholder=\"搜索\" aria-label=\"搜索轨迹事件\" />\n      </label>\n    </div>\n\n    <!-- 三泳道时间线 -->\n    <div class=\"va-traj__lanes\">\n      <div v-for=\"lane in LANES\" :key=\"lane.key\" class=\"va-traj__lane\">\n        <span class=\"va-traj__lane-label\">{{ lane.label }}</span>\n        <div class=\"va-traj__track\">\n          <span\n            v-for=\"e in laneEvents(lane.key)\"\n            :key=\"e.id\"\n            class=\"va-traj__block\"\n            :data-lane=\"lane.key\"\n            :style=\"blockStyle(e)\"\n            :title=\"`${fmtTime(e.at)} ${e.title}`\"\n          />\n        </div>\n      </div>\n    </div>\n\n    <!-- 扁平事件台账 -->\n    <div class=\"va-traj__ledger\" :style=\"props.ledgerMaxHeight ? { maxHeight: `${props.ledgerMaxHeight}px` } : undefined\">\n      <p v-if=\"!filtered.length\" class=\"va-traj__empty\">\n        {{ props.events.length ? \"没有匹配的事件。\" : \"还没有轨迹。发一条任务，这里会按轮记录全部事件。\" }}\n      </p>\n      <div\n        v-for=\"e in filtered\"\n        :key=\"e.id\"\n        class=\"va-traj__row\"\n        :data-open=\"expandedIds.has(e.id) || undefined\"\n        role=\"button\"\n        tabindex=\"0\"\n        @click=\"toggleRow(e.id)\"\n        @keydown.enter.prevent=\"toggleRow(e.id)\"\n      >\n        <span class=\"va-traj__rail\">\n          <span v-if=\"turnStartIds.has(e.id)\" class=\"va-traj__turn\">第{{ e.turn }}轮</span>\n          <i class=\"va-traj__dot\" aria-hidden=\"true\" />\n        </span>\n        <span class=\"va-traj__role\" :data-role=\"e.role\">{{ ROLE_LABEL[e.role] ?? e.role }}</span>\n        <span class=\"va-traj__time\">{{ fmtTime(e.at) }}</span>\n        <span class=\"va-traj__content\" :data-tool=\"e.lane === 'tool' || undefined\">\n          <template v-if=\"e.lane === 'tool'\"><b class=\"va-traj__toolname\">{{ e.title }}</b> {{ snippet(e) }}</template>\n          <template v-else>{{ e.title }}</template>\n        </span>\n      </div>\n    </div>\n  </div>\n</template>\n\n<style>\n/* VaTrajectory — 轨迹（三泳道时间线 + 扁平事件台账，对齐 dsh 形态） */\n.va-traj {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  font-family: var(--va-font, system-ui, sans-serif);\n  min-height: 0;\n  min-width: 0;\n}\n\n/* ---- 指标条 ---- */\n.va-traj__bar { display: flex; align-items: center; gap: 10px; }\n.va-traj__chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  font-size: 11.5px;\n  color: var(--va-muted, #6f6d66);\n  background: var(--va-bg-subtle, #efede7);\n  border-radius: var(--va-radius-s, 8px);\n  padding: 2px 8px;\n  font-variant-numeric: tabular-nums;\n}\n.va-traj__spacer { flex: 1; }\n.va-traj__search input {\n  width: 180px;\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-pill, 999px);\n  background: var(--va-card, #fff);\n  color: var(--va-ink, #1a1917);\n  font: inherit;\n  font-size: 12px;\n  padding: 4px 12px;\n  outline: none;\n}\n.va-traj__search input:focus { border-color: var(--va-accent, #c2410c); }\n\n/* ---- 三泳道 ---- */\n.va-traj__lanes {\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-m, 10px);\n  background: var(--va-card, #fff);\n  padding: 8px 10px;\n}\n.va-traj__lane { display: flex; align-items: center; gap: 8px; }\n.va-traj__lane + .va-traj__lane { border-top: 1px dashed var(--va-edge, rgba(26, 25, 23, 0.12)); }\n.va-traj__lane-label {\n  flex: none;\n  width: 34px;\n  font-size: 11px;\n  color: var(--va-muted, #6f6d66);\n  text-align: right;\n}\n.va-traj__track {\n  position: relative;\n  flex: 1;\n  height: 16px;\n  background:\n    linear-gradient(to right, var(--va-edge, rgba(26, 25, 23, 0.12)) 1px, transparent 1px) left center / 10% 100% no-repeat;\n}\n.va-traj__block {\n  position: absolute;\n  top: 50%;\n  transform: translateY(-50%);\n  height: 9px;\n  border-radius: 2px;\n  min-width: 6px;\n}\n.va-traj__block[data-lane=\"input\"] { background: color-mix(in srgb, var(--va-ink, #1a1917) 78%, transparent); }\n.va-traj__block[data-lane=\"model\"] { background: color-mix(in srgb, #7c6fb0 72%, transparent); }\n.va-traj__block[data-lane=\"tool\"] { background: color-mix(in srgb, var(--va-warning, #b45309) 82%, transparent); }\n\n/* ---- 台账 ---- */\n.va-traj__ledger {\n  display: flex;\n  flex-direction: column;\n  min-height: 0;\n  overflow-y: auto;\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-m, 10px);\n  background: var(--va-card, #fff);\n}\n\n.va-traj__row {\n  display: grid;\n  grid-template-columns: 44px 52px 64px minmax(0, 1fr);\n  align-items: center;\n  gap: 8px;\n  padding: 6px 10px 6px 0;\n  border-bottom: 1px solid color-mix(in srgb, var(--va-edge, rgba(26, 25, 23, 0.12)) 45%, transparent);\n  cursor: pointer;\n  min-width: 0;\n}\n.va-traj__row:hover { background: var(--va-bg-subtle, #efede7); }\n.va-traj__row:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: -2px; }\n\n.va-traj__rail {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  align-self: stretch;\n}\n.va-traj__rail::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  left: 50%;\n  width: 1px;\n  background: var(--va-edge, rgba(26, 25, 23, 0.12));\n}\n.va-traj__dot {\n  position: relative;\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: var(--va-muted, #6f6d66);\n  z-index: 1;\n}\n.va-traj__row:first-child .va-traj__rail::before { top: 50%; }\n.va-traj__row:last-child .va-traj__rail::before { bottom: 50%; }\n\n.va-traj__turn {\n  position: relative;\n  z-index: 1;\n  font-size: 10px;\n  color: var(--va-muted, #6f6d66);\n  background: var(--va-card, #fff);\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-s, 8px);\n  padding: 0 4px;\n  line-height: 15px;\n  white-space: nowrap;\n}\n\n.va-traj__role {\n  flex: none;\n  font-size: 10.5px;\n  font-weight: 700;\n  text-align: center;\n  border-radius: var(--va-radius-s, 8px);\n  padding: 1px 0;\n  line-height: 17px;\n}\n.va-traj__role[data-role=\"user\"] { background: var(--va-ink, #1a1917); color: var(--va-card, #fff); }\n.va-traj__role[data-role=\"assistant\"] { background: color-mix(in srgb, #7c6fb0 16%, transparent); color: #5c5288; }\n.va-traj__role[data-role=\"tool\"] { background: color-mix(in srgb, var(--va-warning, #b45309) 14%, transparent); color: var(--va-warning, #b45309); }\n.va-traj__role[data-role=\"system\"] { background: var(--va-bg-subtle, #efede7); color: var(--va-muted, #6f6d66); }\n.va-traj__role[data-role=\"context\"] { background: color-mix(in srgb, var(--va-success, #1a7f4b) 14%, transparent); color: var(--va-success, #1a7f4b); }\n\n.va-traj__time { flex: none; font-size: 10.5px; color: var(--va-muted, #6f6d66); font-variant-numeric: tabular-nums; }\n\n.va-traj__content {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-size: 12.5px;\n  color: var(--va-ink-2, #43413c);\n}\n.va-traj__row[data-open=\"true\"] .va-traj__content {\n  white-space: normal;\n  word-break: break-all;\n}\n.va-traj__toolname { font-weight: 700; color: var(--va-warning, #b45309); font-family: var(--va-font-mono, ui-monospace, monospace); }\n\n.va-traj__empty {\n  margin: 0;\n  padding: 18px;\n  text-align: center;\n  font-size: 12.5px;\n  color: var(--va-muted, #6f6d66);\n}\n</style>\n"
    },
    {
      "path": "components/ui/trajectory/types.ts",
      "type": "registry:ui",
      "target": "components/ui/trajectory/types.ts",
      "content": "/** VaTrajectory 的类型定义：对齐 dsh 轨迹形态 —— 三泳道时间线 + 扁平事件台账（G15） */\n\nexport type TrajLane = \"input\" | \"model\" | \"tool\";\nexport type TrajRole = \"user\" | \"assistant\" | \"tool\" | \"system\" | \"context\";\n\nexport interface TrajEvent {\n  id: string;\n  /** 开始时间戳 */\n  at: number;\n  /** 工具调用结束时间（泳道块宽度用） */\n  endAt?: number;\n  lane: TrajLane;\n  role: TrajRole;\n  /** 用户/助手：正文片段；工具：工具名 */\n  title: string;\n  /** 工具参数 JSON */\n  detail?: string;\n  /** 工具结果 / 错误 */\n  result?: string;\n  /** 第 N 轮（从 1，按用户消息切分） */\n  turn: number;\n}\n\nexport interface TrajStats {\n  /** 首/末事件跨度 */\n  durationMs: number;\n  turns: number;\n  calls: number;\n  subcalls: number;\n}\n\nexport interface TrajectoryProps {\n  events: TrajEvent[];\n  /** 台账区最大高度 px（默认none，随容器） */\n  ledgerMaxHeight?: number;\n}\n\nexport interface TrajectoryEvents {\n  toggle: [id: string, open: boolean];\n}\n"
    }
  ]
}
