{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "trajectory",
  "title": "Trajectory",
  "description": "轨迹视图（dsh 形态）：时长/轮次/调用指标条 + 输入/模型/工具三泳道时间线 + 扁平事件台账（角色彩签、第N轮分组、工具 args→result、搜索）。",
  "type": "registry:ui",
  "dependencies": [
    "lucide-vue-next"
  ],
  "registryDependencies": [],
  "docs": "- `events` (TrajEvent[]，默认 -)：lane/role/title/detail/result/at/endAt/turn\n- `ledgerMaxHeight` (number，默认 -)：台账区最大高度\n- `@toggle` (-，默认 -)：展开/收起某行",
  "files": [
    {
      "path": "components/ui/trajectory/VaTrajectory.vue",
      "type": "registry:ui",
      "target": "components/ui/trajectory/VaTrajectory.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, ref, type PropType } from \"vue\";\nimport { Clock3, Layers, Repeat2, Search, Wrench, X } from \"lucide-vue-next\";\nimport type { TrajEvent, TrajectoryEvents } from \"./types\";\nimport { useTrajectoryReveal } from \"./useTrajectoryReveal\";\n\n/**\n * 运行时 props 声明（而非类型导入式声明）：\n * 类型式声明的 props 元数据依赖编译期对 types.ts 的解析，dev HMR 场景下\n * types.ts 的增量变更偶尔不会触发 SFC 重编译，导致新增 prop 不生效；\n * 运行时声明与类型文件解耦，热更后必然生效。\n * 契约类型仍由 types.ts 的 TrajectoryProps 对外导出。\n */\nconst props = defineProps({\n  events: { type: Array as PropType<TrajEvent[]>, required: true },\n  /** 台账区最大高度 px（默认 none，随容器） */\n  ledgerMaxHeight: { type: Number, default: undefined },\n  /** 是否渲染外层面板卡片（宽幅主区嵌入传 false 去卡片化） */\n  bordered: { type: Boolean, default: true },\n  /** 主从模式：点击台账行在右侧详情区展示完整内容 */\n  splitDetail: { type: Boolean, default: false },\n});\n\nconst emit = defineEmits<TrajectoryEvents>();\n\n/* ---------- 指标 ---------- */\nconst t0 = computed(() => props.events[0]?.at ?? 0);\nconst t1 = computed(() => {\n  const last = props.events.at(-1);\n  if (!last) return 0;\n  return Math.max(last.endAt ?? last.at, props.events[0]?.at ?? 0);\n});\nconst span = computed(() => Math.max(t1.value - t0.value, 1));\nconst stats = computed(() => ({\n  durationMs: Math.max(t1.value - t0.value, 0),\n  turns: new Set(props.events.map((e) => e.turn)).size,\n  calls: props.events.filter((e) => e.lane === \"tool\").length,\n  subcalls: 0,\n}));\n\nconst fmtDur = (ms: number) => (ms < 1000 ? `${ms}ms` : `${(ms / 1000).toFixed(1)}s`);\n\n/* ---------- 泳道 ---------- */\nconst LANES: Array<{ key: string; label: string }> = [\n  { key: \"input\", label: \"输入\" },\n  { key: \"model\", label: \"模型\" },\n  { key: \"tool\", label: \"工具\" },\n];\nconst laneEvents = (key: string) => props.events.filter((e) => e.lane === key);\nfunction blockStyle(e: TrajEvent) {\n  const left = ((e.at - t0.value) / span.value) * 100;\n  return { left: `${Math.min(Math.max(left, 0), 99)}%` };\n}\n\n/* ---------- 台账（搜索 + 展开 / 主从详情） ---------- */\nconst keyword = ref(\"\");\nconst expandedIds = ref<Set<string>>(new Set());\nfunction toggleRow(id: string) {\n  const open = !expandedIds.value.has(id);\n  const next = new Set(expandedIds.value);\n  if (open) next.add(id);\n  else next.delete(id);\n  expandedIds.value = next;\n  emit(\"toggle\", id, open);\n}\n\n/** 主从模式：右侧详情区当前选中的事件；再点同一条或点关闭即收起 */\nconst selectedId = ref<string | null>(null);\nconst selectedEvent = computed(\n  () => props.events.find((e) => e.id === selectedId.value) ?? null\n);\nfunction selectRow(id: string) {\n  selectedId.value = selectedId.value === id ? null : id;\n  emit(\"select\", selectedId.value);\n}\nfunction closeDetail() {\n  selectedId.value = null;\n  emit(\"select\", null);\n}\n\n/** 行激活分发：主从模式 → 右侧详情；传统模式 → 行内展开 */\nfunction onRowActivate(e: TrajEvent) {\n  if (props.splitDetail) selectRow(e.id);\n  else toggleRow(e.id);\n}\nconst filtered = computed(() => {\n  const kw = keyword.value.trim().toLowerCase();\n  if (!kw) return props.events;\n  return props.events.filter(\n    (e) => e.title.toLowerCase().includes(kw) || (e.detail ?? \"\").toLowerCase().includes(kw) || (e.result ?? \"\").toLowerCase().includes(kw),\n  );\n});\n\n/** 台账行分组：turn 首行（或搜索命中首行）标 第N轮 */\nconst turnStartIds = computed(() => {\n  const seen = new Set<number>();\n  const ids = new Set<string>();\n  for (const e of filtered.value) {\n    if (!seen.has(e.turn)) {\n      seen.add(e.turn);\n      ids.add(e.id);\n    }\n  }\n  return ids;\n});\n\nconst fmtTime = (at: number) =>\n  new Date(at).toLocaleTimeString(\"zh-CN\", { hour12: false, hour: \"2-digit\", minute: \"2-digit\", second: \"2-digit\" });\n\n/* ---------- 渐进揭示（TASK-107）：IO 进视口逐节点点亮，逻辑见 useTrajectoryReveal ---------- */\nconst rootEl = ref<HTMLElement | null>(null);\nconst { active: revealActive, rowVisible, blocksVisible } = useTrajectoryReveal(rootEl, filtered);\n\nconst ROLE_LABEL: Record<string, string> = {\n  user: \"用户\",\n  assistant: \"助手\",\n  tool: \"工具\",\n  system: \"系统\",\n  context: \"上下文\",\n};\n\nfunction snippet(e: TrajEvent): string {\n  if (e.lane === \"tool\") {\n    const d = e.detail && e.detail.length > 240 ? `${e.detail.slice(0, 240)}…` : (e.detail ?? \"\");\n    const r = e.result && e.result.length > 240 ? `${e.result.slice(0, 240)}…` : (e.result ?? \"\");\n    return d ? `${d}  →  ${r}` : r;\n  }\n  return e.title;\n}\n</script>\n\n<template>\n  <div\n    ref=\"rootEl\"\n    class=\"va-traj\"\n    :class=\"{\n      'va-traj--plain': props.bordered === false,\n      'va-traj--split': props.splitDetail,\n    }\"\n    :data-reveal=\"revealActive ? 'on' : undefined\"\n  >\n    <div class=\"va-traj__panel\">\n    <!-- 指标条：时长/轮次/调用/子调用 + 搜索 -->\n    <div class=\"va-traj__bar\">\n      <span class=\"va-traj__chip\"><Clock3 :size=\"12\" aria-hidden=\"true\" />时长 {{ fmtDur(stats.durationMs) }}</span>\n      <span class=\"va-traj__chip\"><Repeat2 :size=\"12\" aria-hidden=\"true\" />轮次 {{ stats.turns }}</span>\n      <span class=\"va-traj__chip\"><Wrench :size=\"12\" aria-hidden=\"true\" />调用 {{ stats.calls }}</span>\n      <span class=\"va-traj__chip\"><Layers :size=\"12\" aria-hidden=\"true\" />子调用 {{ stats.subcalls }}</span>\n      <span class=\"va-traj__spacer\" />\n      <label class=\"va-traj__search\">\n        <Search :size=\"13\" aria-hidden=\"true\" />\n        <input v-model=\"keyword\" type=\"text\" placeholder=\"搜索\" aria-label=\"搜索轨迹事件\" />\n      </label>\n    </div>\n\n    <!-- 三泳道时间线 -->\n    <div class=\"va-traj__lanes\">\n      <div v-for=\"lane in LANES\" :key=\"lane.key\" class=\"va-traj__lane\">\n        <span class=\"va-traj__lane-label\">{{ lane.label }}</span>\n        <div class=\"va-traj__track\">\n          <span\n            v-for=\"e in laneEvents(lane.key)\"\n            :key=\"e.id\"\n            class=\"va-traj__block\"\n            :data-lane=\"lane.key\"\n            :data-shown=\"blocksVisible ? 'true' : undefined\"\n            :style=\"blockStyle(e)\"\n            :title=\"`${fmtTime(e.at)} ${e.title}`\"\n          />\n        </div>\n      </div>\n    </div>\n\n    <!-- 扁平事件台账 -->\n    <div class=\"va-traj__ledger\" :style=\"props.ledgerMaxHeight ? { maxHeight: `${props.ledgerMaxHeight}px` } : undefined\">\n      <p v-if=\"!filtered.length\" class=\"va-traj__empty\">\n        {{ props.events.length ? \"没有匹配的事件。\" : \"还没有轨迹。发一条任务，这里会按轮记录全部事件。\" }}\n      </p>\n      <div\n        v-for=\"e in filtered\"\n        :key=\"e.id\"\n        class=\"va-traj__row\"\n        :data-id=\"e.id\"\n        :data-shown=\"rowVisible(e.id) ? 'true' : undefined\"\n        :title=\"`${fmtTime(e.at)}${e.endAt ? ` · ${fmtDur(e.endAt - e.at)}` : ''}`\"\n        :data-open=\"(!props.splitDetail && expandedIds.has(e.id)) || undefined\"\n        :data-selected=\"(props.splitDetail && selectedId === e.id) || undefined\"\n        role=\"button\"\n        tabindex=\"0\"\n        @click=\"onRowActivate(e)\"\n        @keydown.enter.prevent=\"onRowActivate(e)\"\n      >\n        <span class=\"va-traj__rail\">\n          <span v-if=\"turnStartIds.has(e.id)\" class=\"va-traj__turn\">第{{ e.turn }}轮</span>\n          <i class=\"va-traj__dot\" aria-hidden=\"true\" />\n        </span>\n        <span class=\"va-traj__role\" :data-role=\"e.role\">{{ ROLE_LABEL[e.role] ?? e.role }}</span>\n        <span class=\"va-traj__content\" :data-tool=\"e.lane === 'tool' || undefined\">\n          <template v-if=\"e.lane === 'tool'\"><b class=\"va-traj__toolname\">{{ e.title }}</b> {{ snippet(e) }}</template>\n          <template v-else>{{ e.title }}</template>\n        </span>\n      </div>\n    </div>\n    </div>\n\n    <!-- 主从模式：右侧详情区（完整参数 / 结果） -->\n    <aside v-if=\"props.splitDetail && selectedEvent\" class=\"va-traj__detail\">\n      <header class=\"va-traj__detail-head\">\n        <span class=\"va-traj__role\" :data-role=\"selectedEvent.role\">\n          {{ ROLE_LABEL[selectedEvent.role] ?? selectedEvent.role }}\n        </span>\n        <span class=\"va-traj__detail-meta\">\n          {{ fmtTime(selectedEvent.at) }}<template v-if=\"selectedEvent.endAt\"> · {{ fmtDur(selectedEvent.endAt - selectedEvent.at) }}</template> · 第{{ selectedEvent.turn }}轮\n        </span>\n        <button\n          class=\"va-traj__detail-close\"\n          type=\"button\"\n          title=\"关闭详情\"\n          aria-label=\"关闭详情\"\n          @click=\"closeDetail\"\n        >\n          <X :size=\"14\" />\n        </button>\n      </header>\n\n      <div class=\"va-traj__detail-title\">{{ selectedEvent.title }}</div>\n\n      <section v-if=\"selectedEvent.detail\">\n        <h4>输入 / 参数</h4>\n        <pre>{{ selectedEvent.detail }}</pre>\n      </section>\n      <section v-if=\"selectedEvent.result\">\n        <h4>结果 / 输出</h4>\n        <pre>{{ selectedEvent.result }}</pre>\n      </section>\n      <p v-if=\"!selectedEvent.detail && !selectedEvent.result\" class=\"va-traj__detail-none\">\n        该事件没有更多详情\n      </p>\n    </aside>\n  </div>\n</template>\n\n<style>\n/* VaTrajectory — 轨迹（三泳道时间线 + 扁平事件台账，对齐 dsh 形态） */\n.va-traj {\n  display: flex;\n  flex-direction: column;\n  gap: 0;\n  font-family: var(--va-font, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Helvetica Neue\", sans-serif);\n  min-height: 0;\n  min-width: 0;\n}\n\n/* ---- 面板：泳道 + 台账连体 ---- */\n.va-traj__panel {\n  flex: 1;\n  min-height: 0;\n  display: flex;\n  flex-direction: column;\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-m, 10px);\n  background: var(--va-card, #ffffff);\n  overflow: hidden;\n}\n\n/* ---- 指标条 ---- */\n.va-traj__bar {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  padding: 8px 12px;\n  border-bottom: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n}\n.va-traj__chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  font-size: var(--va-fs-xs, 11px);\n  color: var(--va-muted, #6f6d66);\n  font-variant-numeric: tabular-nums;\n}\n.va-traj__chip > svg { opacity: 0.75; }\n.va-traj__spacer { flex: 1; }\n.va-traj__search {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n}\n.va-traj__search > svg {\n  position: absolute;\n  left: 10px;\n  color: var(--va-muted, #6f6d66);\n  pointer-events: none;\n}\n.va-traj__search input {\n  width: 200px;\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-pill, 999px);\n  background: var(--va-bg, #f7f6f2);\n  color: var(--va-ink, #1a1917);\n  font: inherit;\n  font-size: var(--va-fs-sm, 12px);\n  padding: 4px 12px 4px 30px;\n  outline: none;\n}\n.va-traj__search input:focus { border-color: var(--va-accent, #c2410c); background: var(--va-card, #ffffff); }\n\n/* ---- 三泳道 ---- */\n.va-traj__lanes {\n  display: flex;\n  flex-direction: column;\n  padding: var(--va-s4h, 10px) 12px var(--va-s4h, 10px) 0;\n  border-bottom: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n}\n.va-traj__lane { display: flex; align-items: center; gap: var(--va-s4h, 10px); }\n.va-traj__lane + .va-traj__lane { border-top: 1px dashed var(--va-edge, rgba(26, 25, 23, 0.12)); }\n.va-traj__lane-label {\n  flex: none;\n  width: 36px;\n  font-size: var(--va-fs-xs, 11px);\n  color: var(--va-muted, #6f6d66);\n  text-align: right;\n}\n.va-traj__track {\n  position: relative;\n  flex: 1;\n  height: 24px;\n  background:\n    linear-gradient(to right, var(--va-edge, rgba(26, 25, 23, 0.12)) 1px, transparent 1px) left center / 10% 100% no-repeat;\n}\n.va-traj__block {\n  position: absolute;\n  top: 50%;\n  transform: translateY(-50%);\n  width: 10px;\n  height: 10px;\n  border-radius: 2px;\n}\n.va-traj__block[data-lane=\"input\"] { background: color-mix(in srgb, var(--va-ink, #1a1917) 80%, transparent); }\n.va-traj__block[data-lane=\"model\"] { background: color-mix(in srgb, #7c6fb0 75%, transparent); }\n.va-traj__block[data-lane=\"tool\"] { background: color-mix(in srgb, var(--va-warning, #b45309) 85%, transparent); }\n\n/* ---- 台账 ---- */\n.va-traj__ledger {\n  flex: 1 1 0;\n  min-height: 0;\n  display: flex;\n  flex-direction: column;\n  overflow-y: auto;\n}\n\n.va-traj__row {\n  display: grid;\n  grid-template-columns: 44px 48px minmax(0, 1fr);\n  align-items: center;\n  gap: var(--va-s4h, 10px);\n  padding: 12px 12px 12px 0;\n  min-height: 44px;\n  border-bottom: 1px solid color-mix(in srgb, var(--va-edge, rgba(26, 25, 23, 0.12)) 45%, transparent);\n  cursor: pointer;\n  min-width: 0;\n}\n.va-traj__row:last-child { border-bottom: 0; }\n.va-traj__row:hover { background: var(--va-bg-subtle, #efede7); }\n.va-traj__row:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: -2px; }\n\n.va-traj__rail {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  align-self: stretch;\n}\n.va-traj__rail::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  left: 50%;\n  width: 1px;\n  background: var(--va-edge, rgba(26, 25, 23, 0.12));\n}\n.va-traj__dot {\n  position: relative;\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: var(--va-muted, #6f6d66);\n  z-index: 1;\n}\n.va-traj__row:first-child .va-traj__rail::before { top: 50%; }\n.va-traj__row:last-child .va-traj__rail::before { bottom: 50%; }\n\n.va-traj__turn {\n  position: relative;\n  z-index: 1;\n  font-size: var(--va-fs-2xs, 10px);\n  color: var(--va-muted, #6f6d66);\n  background: var(--va-card, #ffffff);\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-s, 8px);\n  padding: 0 4px;\n  line-height: 15px;\n  white-space: nowrap;\n}\n\n.va-traj__role {\n  flex: none;\n  font-size: var(--va-fs-xs, 11px);\n  font-weight: var(--va-fw-bold, 700);\n  text-align: center;\n  border-radius: var(--va-radius-s, 8px);\n  padding: 1px 0;\n  line-height: 17px;\n}\n.va-traj__role[data-role=\"user\"] { background: var(--va-ink, #1a1917); color: var(--va-card, #ffffff); }\n.va-traj__role[data-role=\"assistant\"] { background: color-mix(in srgb, #7c6fb0 15%, transparent); color: #5c5288; }\n.va-traj__role[data-role=\"tool\"] { background: color-mix(in srgb, var(--va-warning, #b45309) 13%, transparent); color: var(--va-warning, #b45309); }\n.va-traj__role[data-role=\"system\"] { background: var(--va-bg-subtle, #efede7); color: var(--va-muted, #6f6d66); }\n.va-traj__role[data-role=\"context\"] { background: color-mix(in srgb, var(--va-success, #1a7f4b) 14%, transparent); color: var(--va-success, #1a7f4b); }\n\n.va-traj__content {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-size: var(--va-fs-md, 13px);\n  line-height: 1.5;\n  color: var(--va-ink-2, #43413c);\n}\n.va-traj__row[data-open=\"true\"] .va-traj__content {\n  white-space: normal;\n  word-break: break-all;\n}\n.va-traj__toolname { font-weight: var(--va-fw-bold, 700); color: var(--va-warning, #b45309); font-family: var(--va-font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace); }\n\n.va-traj__empty {\n  margin: 0;\n  padding: 18px;\n  text-align: center;\n  font-size: var(--va-fs-md, 13px);\n  color: var(--va-muted, #6f6d66);\n}\n\n/* ---- 去卡片化形态（宽幅主区嵌入，bordered=false） ---- */\n.va-traj--plain .va-traj__panel {\n  border: none;\n  border-radius: 0;\n  background: transparent;\n}\n.va-traj--plain .va-traj__turn {\n  background: var(--va-bg-subtle, #efede7);\n}\n\n/* ---- 主从模式：左台账 + 右详情区 ---- */\n.va-traj--split {\n  flex-direction: row;\n  align-items: stretch;\n  gap: 14px;\n}\n.va-traj--split .va-traj__panel {\n  flex: 1;\n  min-width: 0;\n}\n\n.va-traj__detail {\n  width: 360px;\n  flex-shrink: 0;\n  min-height: 0;\n  overflow-y: auto;\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s4h, 10px);\n  padding: 14px 16px;\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-m, 10px);\n  background: var(--va-card, #ffffff);\n}\n\n.va-traj__detail-head {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.va-traj__detail-meta {\n  flex: 1;\n  min-width: 0;\n  font-size: var(--va-fs-xs, 11px);\n  color: var(--va-muted, #6f6d66);\n  font-variant-numeric: tabular-nums;\n}\n.va-traj__detail-close {\n  border: none;\n  background: none;\n  padding: 2px;\n  display: flex;\n  color: var(--va-muted, #6f6d66);\n  cursor: pointer;\n  border-radius: var(--va-radius-s, 8px);\n}\n.va-traj__detail-close:hover {\n  color: var(--va-ink, #1a1917);\n  background: var(--va-bg-subtle, #efede7);\n}\n\n.va-traj__detail-title {\n  font-size: var(--va-fs-md, 13px);\n  font-weight: var(--va-fw-bold, 700);\n  color: var(--va-ink, #1a1917);\n  word-break: break-all;\n  font-family: var(--va-font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);\n}\n\n.va-traj__detail section {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  min-width: 0;\n}\n.va-traj__detail h4 {\n  margin: 0;\n  font-size: var(--va-fs-xs, 11px);\n  font-weight: var(--va-fw-bold, 700);\n  color: var(--va-muted, #6f6d66);\n}\n.va-traj__detail pre {\n  margin: 0;\n  padding: var(--va-s4h, 10px) 12px;\n  background: var(--va-bg, #f7f6f2);\n  border: 1px solid color-mix(in srgb, var(--va-edge, rgba(26, 25, 23, 0.12)) 60%, transparent);\n  border-radius: var(--va-radius-s, 8px);\n  font-family: var(--va-font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);\n  font-size: var(--va-fs-xs, 11px);\n  line-height: 1.6;\n  white-space: pre-wrap;\n  word-break: break-all;\n}\n\n.va-traj__detail-none {\n  margin: 0;\n  font-size: var(--va-fs-sm, 12px);\n  color: var(--va-muted, #6f6d66);\n}\n\n/* 主从模式：行选中态 */\n.va-traj__row[data-selected=\"true\"] {\n  background: var(--va-accent-soft, rgba(194, 65, 12, 0.1));\n}\n.va-traj__row[data-selected=\"true\"] .va-traj__dot {\n  background: var(--va-accent, #c2410c);\n}\n\n/* ---- TASK-107 渐进揭示（克制版 scroll 驱动：IO 一次性触发，无 scroll-jack）----\n   逻辑见 useTrajectoryReveal.ts：挂载后 data-reveal=\"on\" 才应用初始隐藏态\n   （SSR / 无 IO / reduced-motion 不挂 attr，内容直接全显，渐进增强）。\n   台账行 opacity/translateY 过渡 + 左侧连接线 scaleY 渐进描线 + 节点点亮；\n   泳道块随泳道区进视口一次性浮现。仅动 opacity/transform，不改布局，\n   不引起滚动抖动（stick-to-bottom 契约安全）。 */\n.va-traj[data-reveal=\"on\"] .va-traj__row {\n  opacity: 0;\n  transform: translateY(var(--va-dist-s, 4px));\n  transition:\n    opacity var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1));\n}\n.va-traj[data-reveal=\"on\"] .va-traj__row[data-shown=\"true\"] {\n  opacity: 1;\n  transform: translateY(0);\n}\n\n/* 连接线渐进描线：行点亮时线段自上而下 scaleY 展开 */\n.va-traj[data-reveal=\"on\"] .va-traj__rail::before {\n  transform: scaleY(0);\n  transform-origin: top;\n  transition: transform calc(var(--va-dur-in, 180ms) * 1.6) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1));\n}\n.va-traj[data-reveal=\"on\"] .va-traj__row[data-shown=\"true\"] .va-traj__rail::before {\n  transform: scaleY(1);\n}\n\n/* 节点点亮 */\n.va-traj[data-reveal=\"on\"] .va-traj__dot {\n  opacity: 0;\n  transform: scale(0.4);\n  transition:\n    opacity var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1));\n}\n.va-traj[data-reveal=\"on\"] .va-traj__row[data-shown=\"true\"] .va-traj__dot {\n  opacity: 1;\n  transform: scale(1);\n}\n\n/* 泳道块：泳道区进视口一次性浮现（保留 translateY(-50%) 垂直居中） */\n.va-traj[data-reveal=\"on\"] .va-traj__block {\n  opacity: 0;\n  transform: translateY(-50%) scale(0.5);\n  transition:\n    opacity var(--va-dur-2, 200ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-2, 200ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1));\n}\n.va-traj[data-reveal=\"on\"] .va-traj__block[data-shown=\"true\"] {\n  opacity: 1;\n  transform: translateY(-50%) scale(1);\n}\n\n/* 主从详情区入场（选中行挂载即播一次） */\n.va-traj__detail {\n  animation: va-traj-detail-in var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n@keyframes va-traj-detail-in {\n  from { opacity: 0; transform: translateX(var(--va-dist-m, 8px)); }\n  to { opacity: 1; transform: translateX(0); }\n}\n\n/* reduced-motion 兜底：即使 data-reveal 已挂载（极端时序）也强制全显、无过渡 */\n@media (prefers-reduced-motion: reduce) {\n  .va-traj[data-reveal=\"on\"] .va-traj__row,\n  .va-traj[data-reveal=\"on\"] .va-traj__dot {\n    opacity: 1;\n    transform: none;\n    transition: none;\n  }\n  .va-traj[data-reveal=\"on\"] .va-traj__block {\n    opacity: 1;\n    transform: translateY(-50%);\n    transition: none;\n  }\n  .va-traj[data-reveal=\"on\"] .va-traj__rail::before {\n    transform: none;\n    transition: none;\n  }\n  .va-traj__detail {\n    animation: none;\n  }\n}\n</style>\n"
    },
    {
      "path": "components/ui/trajectory/index.ts",
      "type": "registry:ui",
      "target": "components/ui/trajectory/index.ts",
      "content": "export { default as VaTrajectory } from \"./VaTrajectory.vue\";\nexport type { TrajEvent, TrajLane, TrajRole, TrajectoryEvents, TrajectoryProps, TrajStats } from \"./types\";\n"
    },
    {
      "path": "components/ui/trajectory/types.ts",
      "type": "registry:ui",
      "target": "components/ui/trajectory/types.ts",
      "content": "/** VaTrajectory 的类型定义：对齐 dsh 轨迹形态 —— 三泳道时间线 + 扁平事件台账（G15） */\n\nexport type TrajLane = \"input\" | \"model\" | \"tool\";\nexport type TrajRole = \"user\" | \"assistant\" | \"tool\" | \"system\" | \"context\";\n\nexport interface TrajEvent {\n  id: string;\n  /** 开始时间戳 */\n  at: number;\n  /** 工具调用结束时间（泳道块宽度用） */\n  endAt?: number;\n  lane: TrajLane;\n  role: TrajRole;\n  /** 用户/助手：正文片段；工具：工具名 */\n  title: string;\n  /** 工具参数 JSON */\n  detail?: string;\n  /** 工具结果 / 错误 */\n  result?: string;\n  /** 第 N 轮（从 1，按用户消息切分） */\n  turn: number;\n}\n\nexport interface TrajStats {\n  /** 首/末事件跨度 */\n  durationMs: number;\n  turns: number;\n  calls: number;\n  subcalls: number;\n}\n\nexport interface TrajectoryProps {\n  events: TrajEvent[];\n  /** 台账区最大高度 px（默认none，随容器） */\n  ledgerMaxHeight?: number;\n  /** 是否渲染外层面板卡片（边框/底色）。宽幅主区嵌入时传 false 去卡片化；默认 true 保持原形态 */\n  bordered?: boolean;\n  /** 主从模式：点击台账行在右侧详情区展示完整内容（替代行内展开）；默认 false */\n  splitDetail?: boolean;\n}\n\nexport interface TrajectoryEvents {\n  toggle: [id: string, open: boolean];\n  /** splitDetail 模式下选中变化；null 表示关闭详情区 */\n  select: [id: string | null];\n}\n"
    },
    {
      "path": "components/ui/trajectory/useTrajectoryReveal.ts",
      "type": "registry:ui",
      "target": "components/ui/trajectory/useTrajectoryReveal.ts",
      "content": "import { computed, nextTick, onBeforeUnmount, onMounted, ref, watch, type Ref } from \"vue\";\nimport type { TrajEvent } from \"./types\";\n\n/**\n * VaTrajectory 渐进揭示（TASK-107 零动效补齐，克制版 scroll 驱动）：\n * IntersectionObserver 进视口逐节点点亮——台账行 opacity/translateY 过渡 +\n * 左侧连接线 scaleY 渐进描线 + 节点 scale 点亮；泳道块随泳道区进入视口一次性浮现。\n * IO 一次性触发（点亮即 unobserve），不监听滚动、不做 scroll-jack，不改变布局\n * （仅 opacity/transform，不引起滚动抖动，stick-to-bottom 契约安全）。\n *\n * 降级：reduced-motion / 无 IntersectionObserver / SSR 时不激活（data-reveal 不挂载，\n * CSS 仅在 [data-reveal=\"on\"] 下生效）——内容直接全显，服务端与客户端首帧输出一致。\n * IO 守卫范式照抄 composables 同族（useNumberTicker/useTextReveal 的 matchMedia 短链）。\n */\nexport function useTrajectoryReveal(root: Ref<HTMLElement | null>, filtered: Ref<TrajEvent[]>) {\n  /** 渐进揭示是否激活（挂载后 IO 可用且未 reduced-motion 才为 true） */\n  const active = ref(false);\n  /** 已点亮的台账行事件 id 集合（搜索过滤往返不重放：点亮后保持） */\n  const shownIds = ref(new Set<string>());\n  /** 泳道区是否已进入视口（泳道块整体一次性浮现） */\n  const lanesShown = ref(false);\n  let io: IntersectionObserver | null = null;\n\n  /** 台账行是否已点亮（未激活时恒 true → 模板 data-shown 不挂载，全显） */\n  function rowVisible(id: string): boolean {\n    return !active.value || shownIds.value.has(id);\n  }\n  /** 泳道块是否可见（未激活时恒 true） */\n  const blocksVisible = computed(() => !active.value || lanesShown.value);\n\n  /** 对当前 DOM 重建观察：泳道区（未点亮时）+ 全部尚未点亮的台账行 */\n  async function observeAll() {\n    await nextTick();\n    const el = root.value;\n    if (!el || !io) return;\n    io.disconnect();\n    if (!lanesShown.value) {\n      const lanes = el.querySelector<HTMLElement>(\".va-traj__lanes\");\n      if (lanes) io.observe(lanes);\n    }\n    for (const row of el.querySelectorAll<HTMLElement>(\".va-traj__row[data-id]\")) {\n      const id = row.dataset.id;\n      if (id && !shownIds.value.has(id)) io.observe(row);\n    }\n  }\n\n  onMounted(() => {\n    const el = root.value;\n    if (!el) return;\n    if (window.matchMedia?.(\"(prefers-reduced-motion: reduce)\").matches) return;\n    if (typeof IntersectionObserver === \"undefined\") return;\n    active.value = true;\n    io = new IntersectionObserver(\n      (entries) => {\n        for (const entry of entries) {\n          if (!entry.isIntersecting) continue;\n          const target = entry.target as HTMLElement;\n          if (target.classList.contains(\"va-traj__lanes\")) {\n            lanesShown.value = true;\n          } else if (target.dataset.id) {\n            const next = new Set(shownIds.value);\n            next.add(target.dataset.id);\n            shownIds.value = next;\n          }\n          io?.unobserve(target);\n        }\n      },\n      { threshold: 0.15 },\n    );\n    void observeAll();\n  });\n\n  // 搜索过滤 / events 追加后，对新增（尚未点亮）的行重建观察\n  watch(filtered, () => {\n    if (active.value) void observeAll();\n  });\n\n  onBeforeUnmount(() => {\n    io?.disconnect();\n    io = null;\n  });\n\n  return { active, rowVisible, blocksVisible };\n}\n"
    }
  ]
}
