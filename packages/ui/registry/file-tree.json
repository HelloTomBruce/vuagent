      "target": "components/ui/file-tree/types.ts",
      "content": "/** VaFileTree 的类型定义 */\n\nexport type FileStatus = \"modified\" | \"added\" | \"deleted\" | \"untracked\";\n\n/** 状态单字母徽章 */\nexport const FILE_STATUS_LABEL: Record<FileStatus, string> = {\n  modified: \"M\",\n  added: \"A\",\n  deleted: \"D\",\n  untracked: \"U\",\n};\n\nexport interface FileNode {\n  /** 完整路径（默认作为 id 与选中值） */\n  path: string;\n  /** 节点类型；缺省按有无 children 推断 */\n  type?: \"file\" | \"dir\";\n  /** 变更标记（目录上通常不设，由子节点聚合展示计数） */\n  status?: FileStatus;\n  children?: FileNode[];\n}\n\nexport interface FileTreeProps {\n  /** 顶层节点：根目录单元素，或直接的文件/目录列表 */\n  tree: FileNode[];\n  /** 初始展开深度：0 = 只显示第一层，默认 1 */\n  defaultExpandDepth?: number;\n  /** 受控选中路径（配合 @update:selected 实现 v-model:selected） */\n  selected?: string;\n  /** 非受控默认选中 */\n  defaultSelected?: string;\n  /** 头部统计条文案；空字符串隐藏 */\n  title?: string;\n  /** 内容区最大高度 px，超出滚动 */\n  maxHeight?: number;\n  /** 懒加载模式（G16）：展开无 children 的目录时发 @load，由宿主按层异步填充 */\n  lazy?: boolean;\n}\n\nexport interface FileTreeEvents {\n  \"update:selected\": [path: string | undefined];\n  select: [node: FileNode];\n  toggle: [node: FileNode, expanded: boolean];\n  /** lazy 模式：目录首次展开且未加载（children === undefined）时触发，宿主异步填 children */\n  load: [node: FileNode];\n  /** 文件行被激活（点击/Enter；静态模式同样触发，宿主决定是否打开预览） */\n  open: [node: FileNode];\n}\n"
    },
    {
      "path": "components/ui/file-tree/useFileTree.ts",
      "type": "registry:ui",
      "target": "components/ui/file-tree/useFileTree.ts",
      "content": "import { computed, ref, watch } from \"vue\";\nimport type { FileTreeProps } from \"./types\";\nimport { flattenTree } from \"./tree\";\n\n/** VaFileTree 的状态：展开集合（非受控）+ 选中（受控/非受控哨兵）+ 可见行 + roving focus */\nexport function useFileTree(props: FileTreeProps) {\n  /* ---------- 展开集合 ---------- */\n  const expanded = ref<Set<string>>(new Set());\n  watch(\n    () => props.tree,\n    (tree) => {\n      const next = new Set<string>();\n      const depth = props.defaultExpandDepth ?? 1;\n      const walk = (nodes: typeof tree, level: number) => {\n        for (const n of nodes) {\n          if (n.children?.length && level <= depth) {\n            next.add(n.path);\n            walk(n.children, level + 1);\n          }\n        }\n      };\n      walk(tree, 1);\n      expanded.value = next;\n    },\n    { immediate: true },\n  );\n\n  function toggleDir(path: string, value?: boolean) {\n    const next = new Set(expanded.value);\n    const target = value ?? !next.has(path);\n    if (target) next.add(path);\n    else next.delete(path);\n    expanded.value = next;\n    return target;\n  }\n\n  /* ---------- 选中（受控优先，touched 哨兵回落 defaultSelected） ---------- */\n  const touched = ref(false);\n  const innerSelected = ref<string | undefined>(props.defaultSelected);\n  const currentSelected = computed(() =>\n    props.selected !== undefined || touched.value ? props.selected : innerSelected.value,\n  );\n\n  function select(path: string | undefined) {\n    touched.value = true;\n    innerSelected.value = path;\n    return path;\n  }\n\n  /* ---------- 可见行 ---------- */\n  const rows = computed(() => flattenTree(props.tree, (p) => expanded.value.has(p)));\n\n  /* ---------- roving focus：↑↓ 移动的\"当前项\" ---------- */\n  const focusedPath = ref<string | undefined>(rows.value[0]?.node.path);\n  watch(rows, (r) => {\n    if (!r.some((x) => x.node.path === focusedPath.value)) focusedPath.value = r[0]?.node.path;\n  });\n\n  function moveFocus(delta: number) {\n    const list = rows.value;\n    const idx = list.findIndex((r) => r.node.path === focusedPath.value);\n    const next = list[Math.min(list.length - 1, Math.max(0, idx + delta))];\n    if (next) focusedPath.value = next.node.path;\n  }\n\n  /** 聚焦当前项（keydown 后由模板 focus()） */\n  function isActive(path: string) {\n    return focusedPath.value === path;\n  }\n\n  return {\n    expanded,\n    toggleDir,\n    currentSelected,\n    select,\n    rows,\n    focusedPath,\n    moveFocus,\n    isActive,\n  };\n}\n"
    }
