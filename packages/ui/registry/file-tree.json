{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "file-tree",
  "title": "File Tree",
  "description": "带变更标记的文件树：M/A/D/U 徽章、目录折叠、目录变更计数、完整方向键导航；buildFileTree() 可从扁平 git 变更列表直接建树。",
  "type": "registry:ui",
  "dependencies": [
    "lucide-vue-next"
  ],
  "registryDependencies": [],
  "docs": "- `tree` (FileNode[]，默认 -)：层级树（path/type/status/children）\n- `defaultExpandDepth` (number，默认 1)：初始展开深度\n- `v-model:selected` (string，默认 -)：选中文件完整路径\n- `@select / @toggle` (-，默认 -)：点击文件 / 目录折叠展开",
  "files": [
    {
      "path": "components/ui/file-tree/VaFileTree.vue",
      "type": "registry:ui",
      "target": "components/ui/file-tree/VaFileTree.vue",
      "content": "<script setup lang=\"ts\">\nimport { nextTick, ref } from \"vue\";\nimport { ChevronDown } from \"lucide-vue-next\";\nimport type { FileNode, FileTreeEvents, FileTreeProps } from \"./types\";\nimport { FILE_STATUS_LABEL } from \"./types\";\nimport { countStatus } from \"./tree\";\nimport { useFileTree } from \"./useFileTree\";\n\nconst props = withDefaults(defineProps<FileTreeProps>(), {\n  lazy: false,\n});\n\nconst emit = defineEmits<FileTreeEvents>();\n\nconst STATUS_TITLE: Record<string, string> = {\n  modified: \"已修改\",\n  added: \"新增\",\n  deleted: \"删除\",\n  untracked: \"未跟踪\",\n};\n\nconst { toggleDir, currentSelected, select, rows, moveFocus, isActive } = useFileTree(props);\n\nconst rootEl = ref<HTMLElement | null>(null);\n\n/** lazy：目录未加载（children === undefined）且将展开 → 请求宿主按层加载 */\nfunction requestLoad(row: { node: FileNode; isDir: boolean; expanded: boolean }) {\n  if (props.lazy && row.isDir && !row.expanded && row.node.children === undefined) {\n    emit(\"load\", row.node);\n  }\n}\n\nfunction activate(row: { node: FileNode; isDir: boolean; expanded: boolean }) {\n  if (row.isDir) {\n    requestLoad(row);\n    const value = toggleDir(row.node.path);\n    emit(\"toggle\", row.node, value);\n    return;\n  }\n  emit(\"update:selected\", select(row.node.path));\n  emit(\"select\", row.node);\n  emit(\"open\", row.node);\n}\n\n/** 把焦点移回\"当前项\"（键盘操作后） */\nfunction refocus() {\n  nextTick(() => rootEl.value?.querySelector<HTMLElement>(\"[data-active='true']\")?.focus());\n}\n\n/** 行级键盘：↑↓ 移动，← 折叠/回父级，→ 展开，Enter/Space 激活 */\nfunction onKeydown(e: KeyboardEvent, row: { node: FileNode; isDir: boolean; expanded: boolean }) {\n  switch (e.key) {\n    case \"ArrowUp\":\n      e.preventDefault();\n      moveFocus(-1);\n      refocus();\n      break;\n    case \"ArrowDown\":\n      e.preventDefault();\n      moveFocus(1);\n      refocus();\n      break;\n    case \"ArrowRight\":\n      if (row.isDir && !row.expanded) {\n        e.preventDefault();\n        requestLoad(row);\n        emit(\"toggle\", row.node, toggleDir(row.node.path, true));\n      }\n      break;\n    case \"ArrowLeft\":\n      if (row.isDir && row.expanded) {\n        e.preventDefault();\n        emit(\"toggle\", row.node, toggleDir(row.node.path, false));\n      } else {\n        const parent = row.node.path.split(\"/\").slice(0, -1).join(\"/\");\n        if (parent) {\n          e.preventDefault();\n          moveFocusTo(parent);\n        }\n      }\n      break;\n    case \"Enter\":\n    case \" \":\n      e.preventDefault();\n      activate(row);\n      break;\n  }\n}\n\nfunction moveFocusTo(path: string) {\n  // useFileTree 只暴露相对移动：按可见行重定位（父目录一定在上方，找到即可）\n  const idx = rows.value.findIndex((r) => r.node.path === path);\n  if (idx >= 0) {\n    const cur = rows.value.findIndex((r) => isActive(r.node.path));\n    if (cur >= 0) moveFocus(idx - cur);\n    refocus();\n  }\n}\n</script>\n\n<template>\n  <div class=\"va-ftree\">\n    <header v-if=\"props.title\" class=\"va-ftree__head\">{{ props.title }}</header>\n    <div\n      ref=\"rootEl\"\n      class=\"va-ftree__body\"\n      role=\"tree\"\n      :aria-label=\"props.title || '文件树'\"\n      :style=\"props.maxHeight ? { maxHeight: `${props.maxHeight}px` } : undefined\"\n    >\n      <div\n        v-for=\"row in rows\"\n        :key=\"row.node.path\"\n        role=\"treeitem\"\n        :aria-level=\"row.level\"\n        :aria-expanded=\"row.isDir ? row.expanded : undefined\"\n        :aria-selected=\"row.isDir ? undefined : currentSelected === row.node.path\"\n        :data-active=\"isActive(row.node.path)\"\n        :tabindex=\"isActive(row.node.path) ? 0 : -1\"\n        class=\"va-ftree__row\"\n        :class=\"{\n          'va-ftree__row--dir': row.isDir,\n          'va-ftree__row--selected': !row.isDir && currentSelected === row.node.path,\n        }\"\n        :style=\"{ paddingLeft: `${(row.level - 1) * 16 + 8}px` }\"\n        @click=\"activate(row)\"\n        @keydown=\"onKeydown($event, row)\"\n      >\n        <span v-if=\"row.isDir\" class=\"va-ftree__caret\" aria-hidden=\"true\" :data-open=\"row.expanded || undefined\">\n          <ChevronDown :size=\"12\" />\n        </span>\n        <span v-else class=\"va-ftree__dot\" aria-hidden=\"true\" />\n        <span class=\"va-ftree__name\">{{ row.node.path.split(\"/\").pop() }}</span>\n        <span class=\"va-ftree__spacer\" />\n        <span v-if=\"row.isDir && countStatus(row.node)\" class=\"va-ftree__count\" aria-label=\"含变更文件\">{{ countStatus(row.node) }}</span>\n        <span\n          v-if=\"row.node.status\"\n          class=\"va-ftree__status\"\n          :data-status=\"row.node.status\"\n          :title=\"`${FILE_STATUS_LABEL[row.node.status]} · ${STATUS_TITLE[row.node.status]}`\"\n        >{{ FILE_STATUS_LABEL[row.node.status] }}</span>\n      </div>\n      <p v-if=\"!rows.length\" class=\"va-ftree__empty va-fade-in\">没有文件。</p>\n    </div>\n  </div>\n</template>\n\n<style>\n/* VaFileTree — 带变更标记的文件树 */\n\n.va-ftree {\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-m, 10px);\n  background: var(--va-card, #ffffff);\n  overflow: hidden;\n}\n\n.va-ftree__head {\n  padding: var(--va-s2, 4px) var(--va-s4, 12px);\n  border-bottom: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  background: var(--va-bg-subtle, #efede7);\n  font-size: var(--va-fs-sm, 12px);\n  color: var(--va-muted, #6f6d66);\n}\n\n.va-ftree__body {\n  overflow: auto;\n  padding: var(--va-s2, 4px) 0;\n  font-size: var(--va-fs-md, 13px);\n}\n\n.va-ftree__row {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3h, 6px);\n  padding-right: var(--va-s4, 12px);\n  height: 28px;\n  cursor: pointer;\n  color: var(--va-ink-2, #43413c);\n  user-select: none;\n  transition: background var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-ftree__row:hover { background: var(--va-bg-subtle, #efede7); }\n\n/* 按压口径（行级分轨）：表面自 hover 态朝 ink 混 15% 加深——ink 随主题翻转，\n   亮色变深/暗色变浅方向自适应；全宽行不做位移/缩放（区别 .va-act 按钮口径） */\n.va-ftree__row:active { background: color-mix(in srgb, var(--va-bg-subtle, #efede7) 85%, var(--va-ink, #1a1917)); }\n\n.va-ftree__row[data-active=\"true\"] { outline: none; }\n.va-ftree__row:focus-visible {\n  outline: 2px solid var(--va-accent, #c2410c);\n  outline-offset: -2px;\n  border-radius: var(--va-radius-s, 8px);\n}\n\n.va-ftree__caret {\n  width: 12px;\n  flex: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--va-muted, #6f6d66);\n  /* 收起态旋转 -90°（指向右），展开态归位（指向下）；随行 hover 提亮 */\n  transition: transform var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n.va-ftree__caret:not([data-open]) { transform: rotate(-90deg); }\n.va-ftree__row:hover .va-ftree__caret { color: var(--va-ink-2, #43413c); }\n\n.va-ftree__dot {\n  width: 12px;\n  flex: none;\n  position: relative;\n}\n.va-ftree__dot::before {\n  content: \"\";\n  position: absolute;\n  left: 4px;\n  top: 50%;\n  width: 4px;\n  height: 4px;\n  border-radius: 1px;\n  transform: translateY(-50%);\n  background: var(--va-edge-strong, rgba(26, 25, 23, 0.22));\n}\n\n.va-ftree__name {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-family: var(--va-font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);\n  font-size: var(--va-fs-md, 13px);\n}\n\n.va-ftree__row--dir .va-ftree__name { font-weight: var(--va-fw-semibold, 600); color: var(--va-ink, #1a1917); }\n\n.va-ftree__spacer { flex: 1; }\n\n.va-ftree__row--selected {\n  background: var(--va-accent-soft, rgba(194, 65, 12, 0.1));\n  box-shadow: inset 2px 0 0 var(--va-accent, #c2410c);\n}\n/* 选中行按压：保持 accent 色相加深（不跳中性灰） */\n.va-ftree__row--selected:active { background: color-mix(in srgb, var(--va-accent-soft, rgba(194, 65, 12, 0.1)) 85%, var(--va-ink, #1a1917)); }\n\n.va-ftree__count {\n  font-size: var(--va-fs-xs, 11px);\n  color: var(--va-muted, #6f6d66);\n  font-variant-numeric: tabular-nums;\n}\n\n.va-ftree__status {\n  flex: none;\n  width: 18px;\n  height: 18px;\n  border-radius: var(--va-radius-s, 8px);\n  font-size: var(--va-fs-xs, 11px);\n  font-weight: var(--va-fw-bold, 700);\n  line-height: 18px;\n  text-align: center;\n  font-family: var(--va-font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);\n}\n\n.va-ftree__status[data-status=\"modified\"] { background: color-mix(in srgb, var(--va-warning, #b45309) 16%, transparent); color: var(--va-warning, #b45309); }\n.va-ftree__status[data-status=\"added\"] { background: color-mix(in srgb, var(--va-success, #1a7f4b) 16%, transparent); color: var(--va-success, #1a7f4b); }\n.va-ftree__status[data-status=\"deleted\"] { background: color-mix(in srgb, var(--va-danger, #d5453c) 14%, transparent); color: var(--va-danger, #d5453c); }\n.va-ftree__status[data-status=\"untracked\"] { background: color-mix(in srgb, var(--va-info, #2563eb) 14%, transparent); color: var(--va-info, #2563eb); }\n\n.va-ftree__empty {\n  margin: 0;\n  padding: var(--va-s4, 12px);\n  color: var(--va-muted, #6f6d66);\n  font-size: var(--va-fs-md, 13px);\n}\n\n/* 动效工具类（自动附带，源码中来自全局 motion.css） */\n/* ============================================================\n   共享动效工具类 —— 进出场/交叉淡入的统一协议（TASK-102 动效基建）。\n   组件不逐个发明入场曲线：统一消费 --va-dur-in/--va-dur-out 骨架时长与\n   --va-dist-* 位移档；每条声明自带字面 fallback（registry 单文件拷贝分发\n   要求，与 tokens.css 门禁一致）。\n\n   接入方式二选一：\n   1. Vue <Transition>：\n      <Transition enter-active-class=\"va-enter-up\" leave-active-class=\"va-exit-up\">\n      动画 fill-mode 为 both（延迟期间保持首帧、播完停在终态），\n      无需再配 enter-from-class / leave-to-class；\n   2. 类切换重挂载：骨架 → 内容换节点时给新节点挂 .va-crossfade（纯淡入），\n      离场节点挂 .va-exit-*（更短更快）。\n\n   列表错峰：v-for 子项 :style=\"useStagger().delayStyle(i)\" 配合 .va-enter-*\n   动画类使用（animation-delay 由 composable 编排——.va-enter-* 为 CSS animation，\n   transition-delay 对其零作用，见 composables/useStagger.ts）。\n   ============================================================ */\n\n/* 入场：上浮（自下方 --va-dist-m 浮起） */\n@keyframes va-motion-in-up {\n  from { opacity: 0; transform: translateY(var(--va-dist-m, 8px)); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* 入场：左滑（自左侧 --va-dist-m 滑入） */\n@keyframes va-motion-in-left {\n  from { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n  to { opacity: 1; transform: translateX(0); }\n}\n\n/* 入场：缩放（96% 起放大至原尺寸） */\n@keyframes va-motion-in-scale {\n  from { opacity: 0; transform: scale(0.96); }\n  to { opacity: 1; transform: scale(1); }\n}\n\n/* 离场：与入场互逆（向上/向左飘出、缩回）；时长/曲线由工具类映射 --va-dur-out 骨架 */\n@keyframes va-motion-out-up {\n  from { opacity: 1; transform: translateY(0); }\n  to { opacity: 0; transform: translateY(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-left {\n  from { opacity: 1; transform: translateX(0); }\n  to { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-scale {\n  from { opacity: 1; transform: scale(1); }\n  to { opacity: 0; transform: scale(0.96); }\n}\n\n/* 交叉淡入/淡出（.va-crossfade 骨架→内容交换专用，无位移，避免占位跳变叠加） */\n@keyframes va-motion-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes va-motion-fade-out {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n/* ---- 工具类：入场走 --va-dur-in + ease-out-quart，离场走 --va-dur-out + ease-in-quad ---- */\n\n.va-enter-up {\n  animation: va-motion-in-up var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-left {\n  animation: va-motion-in-left var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-scale {\n  animation: va-motion-in-scale var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-exit-up {\n  animation: va-motion-out-up var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-left {\n  animation: va-motion-out-left var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-scale {\n  animation: va-motion-out-scale var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n/* 骨架 → 内容交叉过渡：新内容纯淡入 */\n.va-crossfade {\n  animation: va-motion-fade-in var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* 空态/轻量状态渐入（TASK-106 弱化档）：仅 opacity、时长走 --va-dur-2，\n   供列表空态提示与一次性状态块使用（空态清单见 TASK-106 报告）。\n   纯 opacity 即动效分频策略的降级终点形态，reduced-motion 下保持原样即可。 */\n.va-fade-in {\n  animation: va-motion-fade-in var(--va-dur-2, 200ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* ---- 静态光斑基类（TASK-105，决策 5「追光」路线基建）----\n   pointer 坐标由 composables/useSpotlight.ts 以 rAF 节流写入 --va-spot-x/y\n   （元素内百分比，光斑数学在 composable 内可单测）；本类只负责 radial 光斑\n   绘制与显隐（:hover 点亮，无 3D 倾斜， glare 数学对齐 VaTiltCard）。\n   --va-spot-* 为 L3 组件钩子口径（宿主可覆盖尺寸/颜色），不进 tokens.css。\n   双降级对齐 VaTiltCard glare：hover: none（触屏）与 reduced-motion 不绘制。 */\n.va-spotlight { position: relative; }\n\n/* ::after 承载光斑（避开组件自身 ::before 用途）；inset 0 + border-radius inherit\n   使光斑天然裁剪在宿主圆角内，无需 overflow: hidden。\n   注意：此 ::after radial 与 components/spotlight-card/VaSpotlightCard.css 的\n   .va-spot-card--spot::after 为 registry 单文件自含有意复制，改动需两处同步。 */\n.va-spotlight::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n  background: radial-gradient(\n    var(--va-spot-size, 240px) circle at var(--va-spot-x, 50%) var(--va-spot-y, 50%),\n    var(--va-spot-color, rgba(255, 255, 255, 0.14)),\n    transparent 65%\n  );\n}\n\n.va-spotlight:hover::after { opacity: 1; }\n\n@media (hover: none) {\n  .va-spotlight::after { display: none; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-spotlight::after { display: none; }\n}\n\n/* ---- 复制反馈标准（TASK-106）：copy→check 交叉过渡 ----\n   容器 .va-copy 为 inline-grid 双内容同格堆叠（格子宽取较宽子项，切换零跳动）：\n   __idle = copy 态内容（图标/文字），__done = check 态内容。\n   copied 置真挂 .va-copy--done：check 以 ease-spring 微弹入场（进入 done 态时\n   transform 的目标态时序换成 --va-ease-spring → 过冲回弹），交叉时长统一 --va-dur-1。\n   消费方：terminal-log（行复制）、code-diff（复制按钮）、message-actions（复制图标）。 */\n.va-copy { display: inline-grid; place-items: center; }\n\n.va-copy__idle,\n.va-copy__done {\n  grid-area: 1 / 1;\n  transition: opacity var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-copy__idle { opacity: 1; transform: scale(1); }\n.va-copy__done { opacity: 0; transform: scale(0.6); }\n\n.va-copy--done .va-copy__done {\n  opacity: 1;\n  transform: scale(1);\n  /* 时序按 transition 属性顺序映射：opacity 仍 ease，transform 换 ease-spring 微弹 */\n  transition-timing-function: var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), var(--va-ease-spring, cubic-bezier(0.34, 1.56, 0.64, 1));\n}\n\n.va-copy--done .va-copy__idle { opacity: 0; transform: scale(0.6); }\n\n@media (prefers-reduced-motion: reduce) {\n  /* 交叉过渡瞬时完成（无位移动画），copied 状态可感知性不受影响 */\n  .va-copy__idle,\n  .va-copy__done { transition: none; }\n}\n\n/* ---- 错误反馈标准（校验失败横向微振）：目标元素挂 .va-shake 播一次 ±3px 微振 ----\n   时长 --va-dur-2 × 2（两拍四峰，克制的「摇头」量级，rubric 校验失败口径）；\n   重复触发需先移除类、强制 reflow 再挂回（封装见 composables/useShake.ts）。\n   reduced-motion 降级为不播：错误状态的可感知性由错误样式本身（描边/文案）承担，\n   动效只做注意力引导——符合头注释「功能动画降级保留状态可感知」的分频策略。\n   消费方：VaStepperForm / VaOtpInput 经 useShake() 程序化触发（defineExpose shake()）；\n   宿主自绘表单可直接挂类。 */\n@keyframes va-motion-shake {\n  20% { transform: translateX(-3px); }\n  40% { transform: translateX(3px); }\n  60% { transform: translateX(-2px); }\n  80% { transform: translateX(2px); }\n}\n\n.va-shake {\n  animation: va-motion-shake calc(var(--va-dur-2, 200ms) * 2) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-shake { animation: none; }\n}\n\n/* ---- 动效分频（对齐 tokens.css 头注释策略）：\n   功能动画降级为纯 opacity——进/出场整体换成 fade keyframes，\n   位移/缩放不再出现（animation-name 顶替，时长/缓动沿用上面的声明）。 */\n@media (prefers-reduced-motion: reduce) {\n  .va-enter-up,\n  .va-enter-left,\n  .va-enter-scale,\n  .va-crossfade {\n    animation-name: va-motion-fade-in;\n  }\n\n  .va-exit-up,\n  .va-exit-left,\n  .va-exit-scale {\n    animation-name: va-motion-fade-out;\n  }\n}\n</style>\n"
    },
    {
      "path": "components/ui/file-tree/index.ts",
      "type": "registry:ui",
      "target": "components/ui/file-tree/index.ts",
      "content": "export { default as VaFileTree } from \"./VaFileTree.vue\";\nexport { buildFileTree } from \"./tree\";\nexport type { FileNode, FileStatus, FileTreeEvents, FileTreeProps } from \"./types\";\nexport { FILE_STATUS_LABEL } from \"./types\";\n"
