{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "agent-inbox",
  "title": "Agent Inbox",
  "description": "后台任务收件箱：过滤 tab 带计数、live 时钟、行展开看步骤与操作，排序变化平滑滑动。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `tasks` (AgentTask[]，默认 -)：queued/running/waiting/done/error\n- `@open / @retry / @cancel` (-，默认 -)：行内操作",
  "files": [
    {
      "path": "components/ui/agent-inbox/VaAgentInbox.vue",
      "type": "registry:ui",
      "target": "components/ui/agent-inbox/VaAgentInbox.vue",
      "content": "<script setup lang=\"ts\">\n\nimport type { AgentInboxProps, AgentTask } from \"./types\";\nimport { AGENT_STATUS_LABEL } from \"./types\";\nimport { useAgentInbox } from \"./useAgentInbox\";\n\n\nconst props = defineProps<AgentInboxProps>();\n\nconst emit = defineEmits<{\n  open: [task: AgentTask];\n  retry: [task: AgentTask];\n  cancel: [task: AgentTask];\n}>();\n\nconst { filter, tabs, counts, visible, elapsedOf, expandedId, toggle } = useAgentInbox(props);\n\n/* ── 内联自 @vuagent/ui src/utils/format.ts（registry 单文件拷贝自包含） ── */\n/** 共享格式化工具（零依赖，SSR 安全） */\n\n/** 1420 → \"1.4s\" · 830 → \"830ms\" · 65_000 → \"1m 05s\" · 3_600_000 → \"1h 00m\" */\nfunction formatMs(ms: number): string {\n  if (!Number.isFinite(ms) || ms < 0) return \"0ms\";\n  if (ms < 1000) return `${Math.round(ms)}ms`;\n  const s = ms / 1000;\n  if (s < 60) return `${s < 10 ? s.toFixed(1) : Math.round(s)}s`;\n  const m = Math.floor(s / 60);\n  if (m < 60) return `${m}m ${String(Math.round(s % 60)).padStart(2, \"0\")}s`;\n  const h = Math.floor(m / 60);\n  if (h < 24) return `${h}h ${String(m % 60).padStart(2, \"0\")}m`;\n  return `${Math.floor(h / 24)}d ${h % 24}h`;\n}\n\n/** 980 → \"980\" · 12_400 → \"12.4K\" · 99_500 → \"99.5K\" · 1_240_000 → \"1.2M\" */\nfunction formatTokens(n: number): string {\n  if (!Number.isFinite(n) || n < 0) return \"0\";\n  if (n < 1000) return String(Math.round(n));\n  if (n < 1_000_000) {\n    const k = n / 1000;\n    const text = k < 100 ? k.toFixed(1).replace(/\\.0$/, \"\") : String(Math.round(k));\n    return `${text}K`;\n  }\n  const m = n / 1_000_000;\n  return m < 100 ? m.toFixed(1).replace(/\\.0$/, \"\") + \"M\" : `${Math.round(m)}M`;\n}\n\n/** 任意值 → 可展示文本：对象美化、JSON 字符串解析后美化、其余原样 */\nfunction toDisplayText(v: unknown): string {\n  if (v == null) return \"\";\n  if (typeof v === \"string\") {\n    const t = v.trim();\n    if (t.startsWith(\"{\") || t.startsWith(\"[\")) {\n      try {\n        return JSON.stringify(JSON.parse(t), null, 2);\n      } catch {\n        return v;\n      }\n    }\n    return v;\n  }\n  if (typeof v === \"object\") {\n    try {\n      return JSON.stringify(v, null, 2);\n    } catch {\n      return String(v);\n    }\n  }\n  return String(v);\n}\n</script>\n\n<template>\n  <div class=\"va-inb\" role=\"list\">\n    <div class=\"va-inb__tabs\" role=\"tablist\" aria-label=\"任务过滤\">\n      <button\n        v-for=\"tab in tabs\"\n        :key=\"tab.key\"\n        class=\"va-inb__tab\"\n        :class=\"{ 'va-inb__tab--on': filter === tab.key }\"\n        type=\"button\"\n        role=\"tab\"\n        :aria-selected=\"filter === tab.key\"\n        @click=\"filter = tab.key\"\n      >\n        {{ tab.label }}\n        <span class=\"va-inb__count\">{{ counts[tab.key] }}</span>\n      </button>\n    </div>\n\n    <TransitionGroup tag=\"div\" class=\"va-inb__list\" name=\"va-inb\">\n      <article\n        v-for=\"t in visible\"\n        :key=\"t.id\"\n        class=\"va-inb__row\"\n        role=\"listitem\"\n        :class=\"{ 'va-inb__row--open': expandedId === t.id }\"\n        :data-status=\"t.status\"\n      >\n        <button class=\"va-inb__main\" type=\"button\" :aria-expanded=\"expandedId === t.id\" @click=\"toggle(t)\">\n          <span class=\"va-inb__dot\" aria-hidden=\"true\" />\n          <span class=\"va-inb__text\">\n            <span class=\"va-inb__title\">{{ t.title }}</span>\n            <span class=\"va-inb__sub\">\n              <span v-if=\"t.agent\" class=\"va-inb__agent\">{{ t.agent }}</span>\n              <span class=\"va-inb__status\">{{ AGENT_STATUS_LABEL[t.status] }}</span>\n              <span v-if=\"elapsedOf(t) !== undefined\" class=\"va-inb__time\">{{ formatMs(elapsedOf(t)!) }}</span>\n            </span>\n          </span>\n          <svg class=\"va-inb__chevron\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\">\n            <path d=\"m9.5 7 5 5-5 5\" />\n          </svg>\n        </button>\n\n        <div v-if=\"expandedId === t.id\" class=\"va-inb__detail\">\n          <p v-if=\"t.error\" class=\"va-inb__error\">{{ t.error }}</p>\n          <ol v-if=\"t.steps?.length\" class=\"va-inb__steps\">\n            <li v-for=\"(s, i) in t.steps\" :key=\"i\">{{ s }}</li>\n          </ol>\n          <div class=\"va-inb__actions\">\n            <button class=\"va-inb__act\" type=\"button\" @click=\"emit('open', t)\">打开</button>\n            <button v-if=\"t.status === 'error' || t.status === 'done'\" class=\"va-inb__act\" type=\"button\" @click=\"emit('retry', t)\">重试</button>\n            <button\n              v-if=\"t.status === 'queued' || t.status === 'running' || t.status === 'waiting'\"\n              class=\"va-inb__act va-inb__act--danger\"\n              type=\"button\"\n              @click=\"emit('cancel', t)\"\n            >取消</button>\n          </div>\n        </div>\n      </article>\n    </TransitionGroup>\n\n    <p v-if=\"!visible.length\" class=\"va-inb__empty va-fade-in\">这个视图下没有任务。</p>\n  </div>\n</template>\n\n<style>\n/* VaAgentInbox — 后台 agent 任务收件箱 */\n.va-inb {\n  --_edge: var(--va-inb-edge, var(--va-edge, rgba(26, 25, 23, 0.12)));\n  --_muted: var(--va-inb-muted, var(--va-muted, #6f6d66));\n  --_ink: var(--va-inb-ink, var(--va-ink, #1a1917));\n  --_accent: var(--va-inb-accent, var(--va-accent, #c2410c));\n  --_danger: var(--va-inb-danger, var(--va-danger, #d5453c));\n  font-family: var(--va-font, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Helvetica Neue\", sans-serif);\n}\n\n/* 过滤 tab */\n.va-inb__tabs { display: flex; gap: 2px; margin-bottom: var(--va-s3, 8px); }\n.va-inb__tab {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  border: 0;\n  background: none;\n  padding: 5px var(--va-s4h, 10px);\n  border-radius: var(--va-radius-pill, 999px);\n  font-size: var(--va-fs-md, 13px);\n  color: var(--_muted);\n  cursor: pointer;\n  font-family: inherit;\n  transition: background var(--va-dur-1, 120ms) ease, color var(--va-dur-1, 120ms) ease;\n}\n.va-inb__tab:hover { color: var(--_ink); background: var(--va-bg-subtle, #efede7); }\n.va-inb__tab:focus-visible { outline: 2px solid var(--_accent); outline-offset: 1px; }\n.va-inb__tab--on { background: var(--va-bg-subtle, #efede7); color: var(--_ink); font-weight: var(--va-fw-semibold, 600); }\n.va-inb__count { font-size: var(--va-fs-xs, 11px); color: var(--_muted); font-variant-numeric: tabular-nums; }\n\n/* 列表 */\n.va-inb__list { display: grid; gap: var(--va-s2, 4px); position: relative; }\n\n.va-inb__row {\n  background: var(--va-card, #ffffff);\n  border: 1px solid var(--_edge);\n  border-radius: var(--va-radius-m, 10px);\n  overflow: hidden;\n}\n.va-inb__row--open { border-color: var(--va-edge-strong, rgba(26, 25, 23, 0.22)); }\n\n.va-inb__main {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3, 8px);\n  width: 100%;\n  padding: var(--va-s3, 8px) var(--va-s4, 12px);\n  background: none;\n  border: 0;\n  cursor: pointer;\n  text-align: left;\n  font-family: inherit;\n}\n.va-inb__main:focus-visible { outline: 2px solid var(--_accent); outline-offset: -2px; }\n\n.va-inb__dot {\n  flex: none;\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: var(--_muted);\n}\n.va-inb__row[data-status=\"running\"] .va-inb__dot {\n  background: var(--_accent);\n  animation: va-inb-pulse calc(var(--va-dur-loop, 1.8s) * 8 / 9) ease-in-out infinite; /* 1.6s = 底速 × 8/9 */\n}\n.va-inb__row[data-status=\"waiting\"] .va-inb__dot { background: var(--va-warning, #b45309); }\n.va-inb__row[data-status=\"done\"] .va-inb__dot { background: var(--va-success, #1a7f4b); }\n.va-inb__row[data-status=\"error\"] .va-inb__dot { background: var(--_danger); }\n@keyframes va-inb-pulse {\n  0%, 100% { opacity: 1; }\n  50% { opacity: 0.35; }\n}\n\n.va-inb__text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; }\n.va-inb__title { font-size: var(--va-fs-md, 13px); color: var(--_ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.va-inb__sub { display: flex; gap: var(--va-s2, 4px); font-size: var(--va-fs-xs, 11px); color: var(--_muted); align-items: baseline; }\n.va-inb__agent { color: var(--va-ink-2, #43413c); }\n.va-inb__time { font-family: var(--va-font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace); font-variant-numeric: tabular-nums; }\n\n.va-inb__chevron {\n  flex: none;\n  width: 14px;\n  height: 14px;\n  color: var(--_muted);\n  transition: transform var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n.va-inb__row--open .va-inb__chevron { transform: rotate(90deg); }\n\n.va-inb__detail { border-top: 1px solid var(--_edge); padding: var(--va-s3, 8px) var(--va-s4, 12px); }\n.va-inb__error { margin: 0 0 var(--va-s2, 4px); font-size: var(--va-fs-sm, 12px); color: var(--_danger); }\n.va-inb__steps { margin: 0; padding: 0 0 0 var(--va-s5, 16px); display: grid; gap: 2px; }\n.va-inb__steps li { font-size: var(--va-fs-sm, 12px); color: var(--va-ink-2, #43413c); }\n\n.va-inb__actions { display: flex; gap: var(--va-s2, 4px); margin-top: var(--va-s3, 8px); }\n.va-inb__act {\n  height: 26px;\n  padding: 0 var(--va-s4, 12px);\n  border-radius: var(--va-radius-pill, 999px);\n  border: 1px solid var(--_edge);\n  background: var(--va-card, #ffffff);\n  color: var(--_ink);\n  font-size: var(--va-fs-sm, 12px);\n  cursor: pointer;\n  font-family: inherit;\n}\n.va-inb__act:hover { border-color: var(--va-edge-strong, rgba(26, 25, 23, 0.22)); }\n.va-inb__act:focus-visible { outline: 2px solid var(--_accent); outline-offset: 1px; }\n.va-inb__act--danger { color: var(--_danger); border-color: color-mix(in srgb, var(--_danger) 40%, transparent); }\n.va-inb__act--danger:hover { background: color-mix(in srgb, var(--_danger) 8%, transparent); }\n\n.va-inb__empty { margin: 0; font-size: var(--va-fs-md, 13px); color: var(--_muted); padding: var(--va-s4, 12px); text-align: center; }\n\n/* FLIP 滑动与进出 */\n.va-inb-move { transition: transform var(--va-dur-3, 300ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)); }\n.va-inb-leave-active { position: absolute; left: 0; right: 0; transition: opacity var(--va-dur-2, 200ms) ease; }\n.va-inb-leave-to { opacity: 0; }\n.va-inb-enter-active { transition: opacity var(--va-dur-2, 200ms) ease; }\n.va-inb-enter-from { opacity: 0; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-inb-move, .va-inb-leave-active, .va-inb-enter-active { transition: none; }\n  .va-inb__row[data-status=\"running\"] .va-inb__dot { animation: none; }\n  .va-inb__chevron { transition: none; }\n}\n\n/* 动效工具类（自动附带，源码中来自全局 motion.css） */\n/* ============================================================\n   共享动效工具类 —— 进出场/交叉淡入的统一协议（TASK-102 动效基建）。\n   组件不逐个发明入场曲线：统一消费 --va-dur-in/--va-dur-out 骨架时长与\n   --va-dist-* 位移档；每条声明自带字面 fallback（registry 单文件拷贝分发\n   要求，与 tokens.css 门禁一致）。\n\n   接入方式二选一：\n   1. Vue <Transition>：\n      <Transition enter-active-class=\"va-enter-up\" leave-active-class=\"va-exit-up\">\n      动画 fill-mode 为 both（延迟期间保持首帧、播完停在终态），\n      无需再配 enter-from-class / leave-to-class；\n   2. 类切换重挂载：骨架 → 内容换节点时给新节点挂 .va-crossfade（纯淡入），\n      离场节点挂 .va-exit-*（更短更快）。\n\n   列表错峰：v-for 子项 :style=\"useStagger().delayStyle(i)\" 配合 .va-enter-*\n   动画类使用（animation-delay 由 composable 编排——.va-enter-* 为 CSS animation，\n   transition-delay 对其零作用，见 composables/useStagger.ts）。\n   ============================================================ */\n\n/* 入场：上浮（自下方 --va-dist-m 浮起） */\n@keyframes va-motion-in-up {\n  from { opacity: 0; transform: translateY(var(--va-dist-m, 8px)); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* 入场：左滑（自左侧 --va-dist-m 滑入） */\n@keyframes va-motion-in-left {\n  from { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n  to { opacity: 1; transform: translateX(0); }\n}\n\n/* 入场：缩放（96% 起放大至原尺寸） */\n@keyframes va-motion-in-scale {\n  from { opacity: 0; transform: scale(0.96); }\n  to { opacity: 1; transform: scale(1); }\n}\n\n/* 离场：与入场互逆（向上/向左飘出、缩回）；时长/曲线由工具类映射 --va-dur-out 骨架 */\n@keyframes va-motion-out-up {\n  from { opacity: 1; transform: translateY(0); }\n  to { opacity: 0; transform: translateY(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-left {\n  from { opacity: 1; transform: translateX(0); }\n  to { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-scale {\n  from { opacity: 1; transform: scale(1); }\n  to { opacity: 0; transform: scale(0.96); }\n}\n\n/* 交叉淡入/淡出（.va-crossfade 骨架→内容交换专用，无位移，避免占位跳变叠加） */\n@keyframes va-motion-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes va-motion-fade-out {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n/* ---- 工具类：入场走 --va-dur-in + ease-out-quart，离场走 --va-dur-out + ease-in-quad ---- */\n\n.va-enter-up {\n  animation: va-motion-in-up var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-left {\n  animation: va-motion-in-left var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-scale {\n  animation: va-motion-in-scale var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-exit-up {\n  animation: va-motion-out-up var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-left {\n  animation: va-motion-out-left var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-scale {\n  animation: va-motion-out-scale var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n/* 骨架 → 内容交叉过渡：新内容纯淡入 */\n.va-crossfade {\n  animation: va-motion-fade-in var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* 空态/轻量状态渐入（TASK-106 弱化档）：仅 opacity、时长走 --va-dur-2，\n   供列表空态提示与一次性状态块使用（空态清单见 TASK-106 报告）。\n   纯 opacity 即动效分频策略的降级终点形态，reduced-motion 下保持原样即可。 */\n.va-fade-in {\n  animation: va-motion-fade-in var(--va-dur-2, 200ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* ---- 静态光斑基类（TASK-105，决策 5「追光」路线基建）----\n   pointer 坐标由 composables/useSpotlight.ts 以 rAF 节流写入 --va-spot-x/y\n   （元素内百分比，光斑数学在 composable 内可单测）；本类只负责 radial 光斑\n   绘制与显隐（:hover 点亮，无 3D 倾斜， glare 数学对齐 VaTiltCard）。\n   --va-spot-* 为 L3 组件钩子口径（宿主可覆盖尺寸/颜色），不进 tokens.css。\n   双降级对齐 VaTiltCard glare：hover: none（触屏）与 reduced-motion 不绘制。 */\n.va-spotlight { position: relative; }\n\n/* ::after 承载光斑（避开组件自身 ::before 用途）；inset 0 + border-radius inherit\n   使光斑天然裁剪在宿主圆角内，无需 overflow: hidden。\n   注意：此 ::after radial 与 components/spotlight-card/VaSpotlightCard.css 的\n   .va-spot-card--spot::after 为 registry 单文件自含有意复制，改动需两处同步。 */\n.va-spotlight::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n  background: radial-gradient(\n    var(--va-spot-size, 240px) circle at var(--va-spot-x, 50%) var(--va-spot-y, 50%),\n    var(--va-spot-color, rgba(255, 255, 255, 0.14)),\n    transparent 65%\n  );\n}\n\n.va-spotlight:hover::after { opacity: 1; }\n\n@media (hover: none) {\n  .va-spotlight::after { display: none; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-spotlight::after { display: none; }\n}\n\n/* ---- 复制反馈标准（TASK-106）：copy→check 交叉过渡 ----\n   容器 .va-copy 为 inline-grid 双内容同格堆叠（格子宽取较宽子项，切换零跳动）：\n   __idle = copy 态内容（图标/文字），__done = check 态内容。\n   copied 置真挂 .va-copy--done：check 以 ease-spring 微弹入场（进入 done 态时\n   transform 的目标态时序换成 --va-ease-spring → 过冲回弹），交叉时长统一 --va-dur-1。\n   消费方：terminal-log（行复制）、code-diff（复制按钮）、message-actions（复制图标）。 */\n.va-copy { display: inline-grid; place-items: center; }\n\n.va-copy__idle,\n.va-copy__done {\n  grid-area: 1 / 1;\n  transition: opacity var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-copy__idle { opacity: 1; transform: scale(1); }\n.va-copy__done { opacity: 0; transform: scale(0.6); }\n\n.va-copy--done .va-copy__done {\n  opacity: 1;\n  transform: scale(1);\n  /* 时序按 transition 属性顺序映射：opacity 仍 ease，transform 换 ease-spring 微弹 */\n  transition-timing-function: var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), var(--va-ease-spring, cubic-bezier(0.34, 1.56, 0.64, 1));\n}\n\n.va-copy--done .va-copy__idle { opacity: 0; transform: scale(0.6); }\n\n@media (prefers-reduced-motion: reduce) {\n  /* 交叉过渡瞬时完成（无位移动画），copied 状态可感知性不受影响 */\n  .va-copy__idle,\n  .va-copy__done { transition: none; }\n}\n\n/* ---- 错误反馈标准（校验失败横向微振）：目标元素挂 .va-shake 播一次 ±3px 微振 ----\n   时长 --va-dur-2 × 2（两拍四峰，克制的「摇头」量级，rubric 校验失败口径）；\n   重复触发需先移除类、强制 reflow 再挂回（封装见 composables/useShake.ts）。\n   reduced-motion 降级为不播：错误状态的可感知性由错误样式本身（描边/文案）承担，\n   动效只做注意力引导——符合头注释「功能动画降级保留状态可感知」的分频策略。\n   消费方：VaStepperForm / VaOtpInput 经 useShake() 程序化触发（defineExpose shake()）；\n   宿主自绘表单可直接挂类。 */\n@keyframes va-motion-shake {\n  20% { transform: translateX(-3px); }\n  40% { transform: translateX(3px); }\n  60% { transform: translateX(-2px); }\n  80% { transform: translateX(2px); }\n}\n\n.va-shake {\n  animation: va-motion-shake calc(var(--va-dur-2, 200ms) * 2) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-shake { animation: none; }\n}\n\n/* ---- 动效分频（对齐 tokens.css 头注释策略）：\n   功能动画降级为纯 opacity——进/出场整体换成 fade keyframes，\n   位移/缩放不再出现（animation-name 顶替，时长/缓动沿用上面的声明）。 */\n@media (prefers-reduced-motion: reduce) {\n  .va-enter-up,\n  .va-enter-left,\n  .va-enter-scale,\n  .va-crossfade {\n    animation-name: va-motion-fade-in;\n  }\n\n  .va-exit-up,\n  .va-exit-left,\n  .va-exit-scale {\n    animation-name: va-motion-fade-out;\n  }\n}\n</style>\n"
    },
    {
      "path": "components/ui/agent-inbox/index.ts",
      "type": "registry:ui",
      "target": "components/ui/agent-inbox/index.ts",
      "content": "export { default as VaAgentInbox } from \"./VaAgentInbox.vue\";\nexport {\n  AGENT_STATUS_LABEL,\n} from \"./types\";\nexport type {\n  AgentInboxEvents,\n  AgentInboxProps,\n  AgentTask,\n  AgentTaskStatus,\n  InboxFilter,\n} from \"./types\";\n"
    },
    {
      "path": "components/ui/agent-inbox/types.ts",
      "type": "registry:ui",
      "target": "components/ui/agent-inbox/types.ts",
      "content": "/** VaAgentInbox 的类型定义 */\n\nexport type AgentTaskStatus = \"queued\" | \"running\" | \"waiting\" | \"done\" | \"error\";\nexport type InboxFilter = \"all\" | \"active\" | \"waiting\" | \"done\";\n\nexport interface AgentTask {\n  id: string;\n  title: string;\n  /** 执行该任务的 agent 名 */\n  agent?: string;\n  status: AgentTaskStatus;\n  startedAt?: number;\n  /** 结束任务（done/error）的最终耗时 ms */\n  duration?: number;\n  /** 最近步骤摘要（按数组顺序展示） */\n  steps?: string[];\n  error?: string;\n}\n\nexport interface AgentInboxProps {\n  tasks: AgentTask[];\n}\n\nexport interface AgentInboxEvents {\n  open: [task: AgentTask];\n  retry: [task: AgentTask];\n  cancel: [task: AgentTask];\n}\n\n/** 状态的中文标签 */\nexport const AGENT_STATUS_LABEL: Record<AgentTaskStatus, string> = {\n  queued: \"排队中\",\n  running: \"进行中\",\n  waiting: \"待审\",\n  done: \"已完成\",\n  error: \"失败\",\n};\n"
    },
    {
      "path": "components/ui/agent-inbox/useAgentInbox.ts",
      "type": "registry:ui",
      "target": "components/ui/agent-inbox/useAgentInbox.ts",
      "content": "import { computed, ref, onBeforeUnmount, watch, type Ref } from \"vue\";\n\nimport type { AgentInboxProps, InboxFilter, AgentTask } from \"./types\";\n\n\n/** VaAgentInbox 的状态逻辑：过滤 tab、计数、live 时钟、行展开 */\nexport function useAgentInbox(props: AgentInboxProps) {\n  /* ---------- 过滤 ---------- */\n  const filter = ref<InboxFilter>(\"all\");\n\n  const counts = computed(() => ({\n    all: props.tasks.length,\n    active: props.tasks.filter((t) => t.status === \"queued\" || t.status === \"running\").length,\n    waiting: props.tasks.filter((t) => t.status === \"waiting\").length,\n    done: props.tasks.filter((t) => t.status === \"done\" || t.status === \"error\").length,\n  }));\n\n  const tabs: Array<{ key: InboxFilter; label: string }> = [\n    { key: \"all\", label: \"全部\" },\n    { key: \"active\", label: \"进行中\" },\n    { key: \"waiting\", label: \"待审\" },\n    { key: \"done\", label: \"已结束\" },\n  ];\n\n  const visible = computed(() => {\n    switch (filter.value) {\n      case \"active\":\n        return props.tasks.filter((t) => t.status === \"queued\" || t.status === \"running\");\n      case \"waiting\":\n        return props.tasks.filter((t) => t.status === \"waiting\");\n      case \"done\":\n        return props.tasks.filter((t) => t.status === \"done\" || t.status === \"error\");\n      default:\n        return props.tasks;\n    }\n  });\n\n  /* ---------- live 计时 ---------- */\n  const needsClock = computed(() =>\n    props.tasks.some((t) => t.status === \"running\" || t.status === \"waiting\"),\n  );\n  const now = useNow(1000, needsClock);\n\n  function elapsedOf(t: AgentTask): number | undefined {\n    if (t.status === \"running\" || t.status === \"waiting\") {\n      return t.startedAt != null ? now.value - t.startedAt : undefined;\n    }\n    if (t.status === \"done\" || t.status === \"error\") return t.duration;\n    return undefined;\n  }\n\n  /* ---------- 展开 ---------- */\n  const expandedId = ref<string | null>(null);\n  function toggle(t: AgentTask) {\n    expandedId.value = expandedId.value === t.id ? null : t.id;\n  }\n\n  return { filter, tabs, counts, visible, elapsedOf, expandedId, toggle };\n}\n\n/* ── 内联自 @vuagent/ui src/composables/useNow.ts（registry 单文件拷贝自包含） ── */\n/**\n * 共享实时时钟：enabled 为 true 期间按 interval 更新 now（ms 时间戳）。\n * 供工具卡计时、计划计时、收件箱时钟等场景复用；SSR 安全。\n */\nfunction useNow(intervalMs: number, enabled: Ref<boolean>): Readonly<Ref<number>> {\n  const now = ref(Date.now());\n  let timer: number | undefined;\n\n  function start() {\n    if (timer !== undefined || typeof window === \"undefined\") return;\n    now.value = Date.now();\n    timer = window.setInterval(() => (now.value = Date.now()), intervalMs);\n  }\n  function stop() {\n    if (timer !== undefined) {\n      window.clearInterval(timer);\n      timer = undefined;\n    }\n  }\n\n  watch(enabled, (v) => (v ? start() : stop()), { immediate: true });\n  onBeforeUnmount(stop);\n\n  return now as Readonly<Ref<number>>;\n}\n"
    }
  ]
