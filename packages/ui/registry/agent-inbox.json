{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "agent-inbox",
  "title": "Agent Inbox",
  "description": "后台任务收件箱：过滤 tab 带计数、live 时钟、行展开看步骤与操作，排序变化平滑滑动。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `tasks` (AgentTask[]，默认 -)：queued/running/waiting/done/error\n- `@open / @retry / @cancel` (-，默认 -)：行内操作",
  "files": [
    {
      "path": "components/ui/agent-inbox/VaAgentInbox.vue",
      "type": "registry:ui",
      "target": "components/ui/agent-inbox/VaAgentInbox.vue",
      "content": "<script setup lang=\"ts\">\nimport type { AgentInboxProps, AgentTask } from \"./types\";\nimport { AGENT_STATUS_LABEL } from \"./types\";\nimport { useAgentInbox } from \"./useAgentInbox\";\nimport { formatMs } from \"../../utils/format\";\n\nconst props = defineProps<AgentInboxProps>();\n\nconst emit = defineEmits<{\n  open: [task: AgentTask];\n  retry: [task: AgentTask];\n  cancel: [task: AgentTask];\n}>();\n\nconst { filter, tabs, counts, visible, elapsedOf, expandedId, toggle } = useAgentInbox(props);\n</script>\n\n<template>\n  <div class=\"va-inb\" role=\"list\">\n    <div class=\"va-inb__tabs\" role=\"tablist\" aria-label=\"任务过滤\">\n      <button\n        v-for=\"tab in tabs\"\n        :key=\"tab.key\"\n        class=\"va-inb__tab\"\n        :class=\"{ 'va-inb__tab--on': filter === tab.key }\"\n        type=\"button\"\n        role=\"tab\"\n        :aria-selected=\"filter === tab.key\"\n        @click=\"filter = tab.key\"\n      >\n        {{ tab.label }}\n        <span class=\"va-inb__count\">{{ counts[tab.key] }}</span>\n      </button>\n    </div>\n\n    <TransitionGroup tag=\"div\" class=\"va-inb__list\" name=\"va-inb\">\n      <article\n        v-for=\"t in visible\"\n        :key=\"t.id\"\n        class=\"va-inb__row\"\n        role=\"listitem\"\n        :class=\"{ 'va-inb__row--open': expandedId === t.id }\"\n        :data-status=\"t.status\"\n      >\n        <button class=\"va-inb__main\" type=\"button\" :aria-expanded=\"expandedId === t.id\" @click=\"toggle(t)\">\n          <span class=\"va-inb__dot\" aria-hidden=\"true\" />\n          <span class=\"va-inb__text\">\n            <span class=\"va-inb__title\">{{ t.title }}</span>\n            <span class=\"va-inb__sub\">\n              <span v-if=\"t.agent\" class=\"va-inb__agent\">{{ t.agent }}</span>\n              <span class=\"va-inb__status\">{{ AGENT_STATUS_LABEL[t.status] }}</span>\n              <span v-if=\"elapsedOf(t) !== undefined\" class=\"va-inb__time\">{{ formatMs(elapsedOf(t)!) }}</span>\n            </span>\n          </span>\n          <svg class=\"va-inb__chevron\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\">\n            <path d=\"m9.5 7 5 5-5 5\" />\n          </svg>\n        </button>\n\n        <div v-if=\"expandedId === t.id\" class=\"va-inb__detail\">\n          <p v-if=\"t.error\" class=\"va-inb__error\">{{ t.error }}</p>\n          <ol v-if=\"t.steps?.length\" class=\"va-inb__steps\">\n            <li v-for=\"(s, i) in t.steps\" :key=\"i\">{{ s }}</li>\n          </ol>\n          <div class=\"va-inb__actions\">\n            <button class=\"va-inb__act\" type=\"button\" @click=\"emit('open', t)\">打开</button>\n            <button v-if=\"t.status === 'error' || t.status === 'done'\" class=\"va-inb__act\" type=\"button\" @click=\"emit('retry', t)\">重试</button>\n            <button\n              v-if=\"t.status === 'queued' || t.status === 'running' || t.status === 'waiting'\"\n              class=\"va-inb__act va-inb__act--danger\"\n              type=\"button\"\n              @click=\"emit('cancel', t)\"\n            >取消</button>\n          </div>\n        </div>\n      </article>\n    </TransitionGroup>\n\n    <p v-if=\"!visible.length\" class=\"va-inb__empty\">这个视图下没有任务。</p>\n  </div>\n</template>\n\n<style>\n/* VaAgentInbox — 后台 agent 任务收件箱 */\n.va-inb {\n  --_edge: var(--va-inb-edge, var(--va-edge, rgba(26, 25, 23, 0.12)));\n  --_muted: var(--va-inb-muted, var(--va-muted, #6f6d66));\n  --_ink: var(--va-inb-ink, var(--va-ink, #1a1917));\n  --_accent: var(--va-inb-accent, var(--va-accent, #c2410c));\n  --_danger: var(--va-inb-danger, var(--va-danger, #d5453c));\n  font-family: var(--va-font, system-ui, sans-serif);\n}\n\n/* 过滤 tab */\n.va-inb__tabs { display: flex; gap: 2px; margin-bottom: var(--va-s3, 8px); }\n.va-inb__tab {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  border: 0;\n  background: none;\n  padding: 5px 10px;\n  border-radius: var(--va-radius-pill, 999px);\n  font-size: 12.5px;\n  color: var(--_muted);\n  cursor: pointer;\n  font-family: inherit;\n  transition: background var(--va-dur-1, 120ms) ease, color var(--va-dur-1, 120ms) ease;\n}\n.va-inb__tab:hover { color: var(--_ink); background: var(--va-bg-subtle, #efede7); }\n.va-inb__tab:focus-visible { outline: 2px solid var(--_accent); outline-offset: 1px; }\n.va-inb__tab--on { background: var(--va-bg-subtle, #efede7); color: var(--_ink); font-weight: 600; }\n.va-inb__count { font-size: 11px; color: var(--_muted); font-variant-numeric: tabular-nums; }\n\n/* 列表 */\n.va-inb__list { display: grid; gap: var(--va-s2, 4px); position: relative; }\n\n.va-inb__row {\n  background: var(--va-card, #fff);\n  border: 1px solid var(--_edge);\n  border-radius: var(--va-radius-m, 10px);\n  overflow: hidden;\n}\n.va-inb__row--open { border-color: var(--va-edge-strong, rgba(26, 25, 23, 0.22)); }\n\n.va-inb__main {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3, 8px);\n  width: 100%;\n  padding: var(--va-s3, 8px) var(--va-s4, 12px);\n  background: none;\n  border: 0;\n  cursor: pointer;\n  text-align: left;\n  font-family: inherit;\n}\n.va-inb__main:focus-visible { outline: 2px solid var(--_accent); outline-offset: -2px; }\n\n.va-inb__dot {\n  flex: none;\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: var(--_muted);\n}\n.va-inb__row[data-status=\"running\"] .va-inb__dot {\n  background: var(--_accent);\n  animation: va-inb-pulse 1.6s ease-in-out infinite;\n}\n.va-inb__row[data-status=\"waiting\"] .va-inb__dot { background: var(--va-warning, #b45309); }\n.va-inb__row[data-status=\"done\"] .va-inb__dot { background: var(--va-success, #1a7f4b); }\n.va-inb__row[data-status=\"error\"] .va-inb__dot { background: var(--_danger); }\n@keyframes va-inb-pulse {\n  0%, 100% { opacity: 1; }\n  50% { opacity: 0.35; }\n}\n\n.va-inb__text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; }\n.va-inb__title { font-size: 13px; color: var(--_ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.va-inb__sub { display: flex; gap: var(--va-s2, 4px); font-size: 11.5px; color: var(--_muted); align-items: baseline; }\n.va-inb__agent { color: var(--va-ink-2, #43413c); }\n.va-inb__time { font-family: var(--va-font-mono, monospace); font-variant-numeric: tabular-nums; }\n\n.va-inb__chevron {\n  flex: none;\n  width: 14px;\n  height: 14px;\n  color: var(--_muted);\n  transition: transform var(--va-dur-2, 200ms) var(--va-ease, ease);\n}\n.va-inb__row--open .va-inb__chevron { transform: rotate(90deg); }\n\n.va-inb__detail { border-top: 1px solid var(--_edge); padding: var(--va-s3, 8px) var(--va-s4, 12px); }\n.va-inb__error { margin: 0 0 var(--va-s2, 4px); font-size: 12px; color: var(--_danger); }\n.va-inb__steps { margin: 0; padding: 0 0 0 var(--va-s5, 16px); display: grid; gap: 2px; }\n.va-inb__steps li { font-size: 12px; color: var(--va-ink-2, #43413c); }\n\n.va-inb__actions { display: flex; gap: var(--va-s2, 4px); margin-top: var(--va-s3, 8px); }\n.va-inb__act {\n  height: 26px;\n  padding: 0 var(--va-s4, 12px);\n  border-radius: var(--va-radius-pill, 999px);\n  border: 1px solid var(--_edge);\n  background: var(--va-card, #fff);\n  color: var(--_ink);\n  font-size: 12px;\n  cursor: pointer;\n  font-family: inherit;\n}\n.va-inb__act:hover { border-color: var(--va-edge-strong, rgba(26, 25, 23, 0.22)); }\n.va-inb__act:focus-visible { outline: 2px solid var(--_accent); outline-offset: 1px; }\n.va-inb__act--danger { color: var(--_danger); border-color: color-mix(in srgb, var(--_danger) 40%, transparent); }\n.va-inb__act--danger:hover { background: color-mix(in srgb, var(--_danger) 8%, transparent); }\n\n.va-inb__empty { margin: 0; font-size: 12.5px; color: var(--_muted); padding: var(--va-s4, 12px); text-align: center; }\n\n/* FLIP 滑动与进出 */\n.va-inb-move { transition: transform var(--va-dur-3, 300ms) var(--va-ease, ease); }\n.va-inb-leave-active { position: absolute; left: 0; right: 0; transition: opacity var(--va-dur-2, 200ms) ease; }\n.va-inb-leave-to { opacity: 0; }\n.va-inb-enter-active { transition: opacity var(--va-dur-2, 200ms) ease; }\n.va-inb-enter-from { opacity: 0; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-inb-move, .va-inb-leave-active, .va-inb-enter-active { transition: none; }\n  .va-inb__row[data-status=\"running\"] .va-inb__dot { animation: none; }\n  .va-inb__chevron { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/agent-inbox/types.ts",
      "type": "registry:ui",
      "target": "components/ui/agent-inbox/types.ts",
      "content": "/** VaAgentInbox 的类型定义 */\n\nexport type AgentTaskStatus = \"queued\" | \"running\" | \"waiting\" | \"done\" | \"error\";\nexport type InboxFilter = \"all\" | \"active\" | \"waiting\" | \"done\";\n\nexport interface AgentTask {\n  id: string;\n  title: string;\n  /** 执行该任务的 agent 名 */\n  agent?: string;\n  status: AgentTaskStatus;\n  startedAt?: number;\n  /** 结束任务（done/error）的最终耗时 ms */\n  duration?: number;\n  /** 最近步骤摘要（按数组顺序展示） */\n  steps?: string[];\n  error?: string;\n}\n\nexport interface AgentInboxProps {\n  tasks: AgentTask[];\n}\n\nexport interface AgentInboxEvents {\n  open: [task: AgentTask];\n  retry: [task: AgentTask];\n  cancel: [task: AgentTask];\n}\n\n/** 状态的中文标签 */\nexport const AGENT_STATUS_LABEL: Record<AgentTaskStatus, string> = {\n  queued: \"排队中\",\n  running: \"进行中\",\n  waiting: \"待审\",\n  done: \"已完成\",\n  error: \"失败\",\n};\n"
    },
    {
      "path": "components/ui/agent-inbox/useAgentInbox.ts",
      "type": "registry:ui",
      "target": "components/ui/agent-inbox/useAgentInbox.ts",
      "content": "import { computed, ref } from \"vue\";\nimport type { AgentInboxProps, InboxFilter, AgentTask } from \"./types\";\nimport { useNow } from \"../../composables/useNow\";\n\n/** VaAgentInbox 的状态逻辑：过滤 tab、计数、live 时钟、行展开 */\nexport function useAgentInbox(props: AgentInboxProps) {\n  /* ---------- 过滤 ---------- */\n  const filter = ref<InboxFilter>(\"all\");\n\n  const counts = computed(() => ({\n    all: props.tasks.length,\n    active: props.tasks.filter((t) => t.status === \"queued\" || t.status === \"running\").length,\n    waiting: props.tasks.filter((t) => t.status === \"waiting\").length,\n    done: props.tasks.filter((t) => t.status === \"done\" || t.status === \"error\").length,\n  }));\n\n  const tabs: Array<{ key: InboxFilter; label: string }> = [\n    { key: \"all\", label: \"全部\" },\n    { key: \"active\", label: \"进行中\" },\n    { key: \"waiting\", label: \"待审\" },\n    { key: \"done\", label: \"已结束\" },\n  ];\n\n  const visible = computed(() => {\n    switch (filter.value) {\n      case \"active\":\n        return props.tasks.filter((t) => t.status === \"queued\" || t.status === \"running\");\n      case \"waiting\":\n        return props.tasks.filter((t) => t.status === \"waiting\");\n      case \"done\":\n        return props.tasks.filter((t) => t.status === \"done\" || t.status === \"error\");\n      default:\n        return props.tasks;\n    }\n  });\n\n  /* ---------- live 计时 ---------- */\n  const needsClock = computed(() =>\n    props.tasks.some((t) => t.status === \"running\" || t.status === \"waiting\"),\n  );\n  const now = useNow(1000, needsClock);\n\n  function elapsedOf(t: AgentTask): number | undefined {\n    if (t.status === \"running\" || t.status === \"waiting\") {\n      return t.startedAt != null ? now.value - t.startedAt : undefined;\n    }\n    if (t.status === \"done\" || t.status === \"error\") return t.duration;\n    return undefined;\n  }\n\n  /* ---------- 展开 ---------- */\n  const expandedId = ref<string | null>(null);\n  function toggle(t: AgentTask) {\n    expandedId.value = expandedId.value === t.id ? null : t.id;\n  }\n\n  return { filter, tabs, counts, visible, elapsedOf, expandedId, toggle };\n}\n"
    }
  ]
}
