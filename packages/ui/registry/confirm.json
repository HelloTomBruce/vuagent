{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "confirm",
  "title": "Confirm",
  "description": "命令式确认框：await vaConfirm() 返回 Promise<boolean>，宿主 VaConfirmHost 渲染（基于 VaDialog，role=alertdialog）；tone=danger/warning 时确认按钮危险配色且初始聚焦取消（安全默认），requireText 需逐字输入才可确认，checkboxLabel 勾选态经 vaConfirm.details 返回；并发调用按队列串行，closeAll() 一键拒绝；无宿主时开发期警告并 fail-closed 返回 false。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [
    "@vuagent/dialog"
  ],
  "docs": "- `title / description` (string，默认 -)：标题（兼作可访问名）/ 补充说明\n- `confirmText / cancelText` (string，默认 \"确认\" / \"取消\")：按钮文案\n- `tone` (\"default\" | \"danger\" | \"warning\"，默认 \"default\")：语气：danger/warning 用危险配色并初始聚焦取消按钮\n- `icon` (boolean，默认 false)：标题前置语气图标\n- `requireText` (string，默认 -)：开启手输确认：输入需逐字匹配，否则确认按钮 disabled\n- `checkboxLabel` (string，默认 -)：可选勾选项；勾选态经 vaConfirm.details.checked 返回\n- `vaConfirm.details` ({ ok, checked } | null，默认 -)：最近一次确认结果（Promise 只返回 ok）\n- `vaConfirm.closeAll()` (-，默认 -)：拒绝全部待确认项并关闭当前弹窗（均 resolve false）",
  "files": [
    {
      "path": "components/ui/confirm/VaConfirmHost.vue",
      "type": "registry:ui",
      "target": "components/ui/confirm/VaConfirmHost.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, nextTick, onBeforeUnmount, onMounted, ref, watch } from \"vue\";\nimport VaDialog from \"../dialog/VaDialog.vue\";\nimport type { ConfirmItem } from \"./types\";\nimport {\n  registerConfirmHost,\n  settleConfirm,\n  unregisterConfirmHost,\n  vaConfirm,\n} from \"./confirm\";\n\n/**\n * VaConfirmHost — 命令式确认框宿主（挂在应用根节点一次即可）。\n *\n * 队列串行：只把队首放进 display 渲染；当前项 settle 后先播放 VaDialog 退出动画，\n * 收到 closed 再展示下一个，因此并发调用不会互相覆盖。\n * 安全默认：danger / warning 初始聚焦取消按钮；requireText 时聚焦输入框。\n */\nconst display = ref<ConfirmItem | null>(null);\nconst open = ref(false);\nconst checked = ref(false);\nconst typed = ref(\"\");\n\nconst requireMismatch = computed(() => {\n  const need = display.value?.requireText;\n  return Boolean(need) && typed.value !== need;\n});\nconst canConfirm = computed(() => !requireMismatch.value);\n\n/** 初始焦点：手输确认优先输入框；危险操作落在取消（安全默认）；其余落在确认 */\nconst initialFocus = computed(() => {\n  const current = display.value;\n  if (!current) return undefined;\n  if (current.requireText) return \".va-confirm__input\";\n  if (current.tone === \"danger\" || current.tone === \"warning\") return \".va-confirm__btn--cancel\";\n  return \".va-confirm__btn--confirm\";\n});\n\nfunction resetLocalState() {\n  checked.value = false;\n  typed.value = \"\";\n}\n\nfunction showHead() {\n  const head = vaConfirm.state.queue[0];\n  if (!head || display.value) return;\n  resetLocalState();\n  display.value = head;\n  // 先以 closed 落一帧，再置 open 触发 VaDialog 进入过渡\n  void nextTick(() => {\n    open.value = true;\n  });\n}\n\n/* 队首变化或当前项清空后，接上下一个（flush: post 保证 DOM 已更新） */\nwatch(\n  () => [vaConfirm.state.queue[0]?.id ?? null, display.value?.id ?? null] as const,\n  ([headId, shownId]) => {\n    if (shownId === null && headId !== null) showHead();\n  },\n  { flush: \"post\" },\n);\n\n/* closeAll 等外部清空队列时，当前弹窗也要退出 */\nwatch(\n  () =>\n    display.value\n      ? vaConfirm.state.queue.some((item) => item.id === display.value!.id)\n      : true,\n  (stillQueued) => {\n    if (!stillQueued && display.value && open.value) open.value = false;\n  },\n  { flush: \"post\" },\n);\n\n/** 确认或取消：settle Promise（出队）+ 请求关闭，等待 closed 再清空 display */\nfunction finish(ok: boolean) {\n  const current = display.value;\n  if (!current) return;\n  settleConfirm(current.id, ok, checked.value);\n  open.value = false;\n}\n\nfunction onClosed() {\n  if (!display.value) return;\n  display.value = null; // 队首 watcher 会在下一 tick 接上下一个\n}\n\nfunction onInputEnter() {\n  if (canConfirm.value) finish(true);\n}\n\nonMounted(registerConfirmHost);\nonBeforeUnmount(() => {\n  unregisterConfirmHost();\n  // 宿主卸载时关闭全部待确认项，避免调用方 Promise 永久挂起\n  vaConfirm.closeAll();\n});\n</script>\n\n<template>\n  <VaDialog\n    v-if=\"display\"\n    :open=\"open\"\n    :title=\"display.title\"\n    :description=\"display.description\"\n    :initial-focus=\"initialFocus\"\n    :closable=\"false\"\n    role=\"alertdialog\"\n    size=\"sm\"\n    @close=\"finish(false)\"\n    @closed=\"onClosed\"\n  >\n    <template #title>\n      <span class=\"va-confirm__heading\" :data-tone=\"display.tone\">\n        <span v-if=\"display.icon\" class=\"va-confirm__icon\" aria-hidden=\"true\">\n          <svg\n            v-if=\"display.tone === 'danger'\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n          >\n            <circle cx=\"12\" cy=\"12\" r=\"9\" />\n            <path d=\"M12 8v4.5M12 16h.01\" />\n          </svg>\n          <svg\n            v-else-if=\"display.tone === 'warning'\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.8\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          >\n            <path d=\"M12 9v4M12 16.5h.01M10.3 3.9 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z\" />\n          </svg>\n          <svg\n            v-else\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n          >\n            <circle cx=\"12\" cy=\"12\" r=\"9\" />\n            <path d=\"M9.6 9.3a2.4 2.4 0 0 1 4.7.5c0 1.6-2.3 2-2.3 3.4\" />\n            <path d=\"M12 16.5h.01\" />\n          </svg>\n        </span>\n        <span class=\"va-confirm__title\">{{ display.title }}</span>\n      </span>\n    </template>\n\n    <div class=\"va-confirm__body\">\n      <label v-if=\"display.requireText\" class=\"va-confirm__field\">\n        <span class=\"va-confirm__hint\">\n          请输入 <code class=\"va-confirm__need\">{{ display.requireText }}</code> 以确认\n        </span>\n        <input\n          v-model=\"typed\"\n          class=\"va-confirm__input\"\n          type=\"text\"\n          autocomplete=\"off\"\n          spellcheck=\"false\"\n          :placeholder=\"display.requireText\"\n          @keydown.enter=\"onInputEnter\"\n        />\n      </label>\n\n      <label v-if=\"display.checkboxLabel\" class=\"va-confirm__check\">\n        <input v-model=\"checked\" type=\"checkbox\" />\n        <span>{{ display.checkboxLabel }}</span>\n      </label>\n    </div>\n\n    <template #footer>\n      <button\n        type=\"button\"\n        class=\"va-act va-confirm__btn va-confirm__btn--cancel\"\n        @click=\"finish(false)\"\n      >\n        {{ display.cancelText }}\n      </button>\n      <button\n        type=\"button\"\n        class=\"va-act va-confirm__btn va-confirm__btn--confirm\"\n        :class=\"{\n          'va-act--primary': display.tone === 'default',\n          'va-confirm__btn--danger': display.tone === 'danger',\n          'va-confirm__btn--warning': display.tone === 'warning',\n        }\"\n        :disabled=\"!canConfirm\"\n        @click=\"finish(true)\"\n      >\n        {{ display.confirmText }}\n      </button>\n    </template>\n  </VaDialog>\n</template>\n\n<style>\n/* VaConfirm — 命令式确认框宿主（内容样式；弹窗外壳来自 VaDialog） */\n\n/* 标题行：图标 + 文案 */\n.va-confirm__heading {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--va-s3, 8px);\n  min-width: 0;\n}\n\n.va-confirm__icon {\n  flex: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 20px;\n  height: 20px;\n  color: var(--va-muted, #6f6d66);\n}\n\n.va-confirm__icon svg {\n  width: 20px;\n  height: 20px;\n}\n\n.va-confirm__heading[data-tone=\"danger\"] .va-confirm__icon {\n  color: var(--va-danger, #d5453c);\n}\n\n.va-confirm__heading[data-tone=\"warning\"] .va-confirm__icon {\n  color: var(--va-warning, #b45309);\n}\n\n.va-confirm__title {\n  min-width: 0;\n}\n\n/* 主体：手输确认 + 勾选项 */\n.va-confirm__body {\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s4, 12px);\n  font-family: var(--va-font, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Helvetica Neue\", sans-serif);\n}\n\n.va-confirm__field {\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s2, 4px);\n  font-size: var(--va-fs-md, 13px);\n  line-height: 1.5;\n  color: var(--va-muted, #6f6d66);\n}\n\n.va-confirm__need {\n  padding: 1px 5px;\n  border-radius: var(--va-radius-s, 8px);\n  background: var(--va-bg-subtle, #efede7);\n  color: var(--va-ink, #1a1917);\n  font-family: var(--va-font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);\n  font-size: var(--va-fs-sm, 12px);\n}\n\n.va-confirm__input {\n  width: 100%;\n  padding: 5px var(--va-s4h, 10px);\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-s, 8px);\n  background: var(--va-card, #ffffff);\n  color: var(--va-ink, #1a1917);\n  font: inherit;\n  font-size: var(--va-fs-md, 13px);\n  line-height: 1.4;\n  transition:\n    border-color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    box-shadow var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-confirm__input::placeholder {\n  color: var(--va-muted, #6f6d66);\n  opacity: 0.7;\n}\n\n.va-confirm__input:focus {\n  outline: none;\n  border-color: var(--va-accent, #c2410c);\n  box-shadow: 0 0 0 3px var(--va-accent-soft, rgba(194, 65, 12, 0.1));\n}\n\n.va-confirm__check {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--va-s2, 4px);\n  font-size: var(--va-fs-md, 13px);\n  line-height: 1.5;\n  color: var(--va-ink-2, #43413c);\n  cursor: pointer;\n  user-select: none;\n}\n\n.va-confirm__check input {\n  flex: none;\n  width: 14px;\n  height: 14px;\n  margin: 0;\n  accent-color: var(--va-accent, #c2410c);\n  cursor: pointer;\n}\n\n/* 按钮：基类 va-act 负责形状/焦点环，这里只补语气配色 */\n.va-confirm__btn--danger {\n  border-color: var(--va-danger, #d5453c);\n  background: var(--va-danger, #d5453c);\n  color: var(--va-danger-contrast, #fff);\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n.va-confirm__btn--danger:hover:not(:disabled) {\n  border-color: var(--va-danger, #d5453c);\n  background: var(--va-danger, #d5453c);\n  opacity: 0.88;\n}\n\n.va-confirm__btn--warning {\n  border-color: var(--va-warning, #b45309);\n  background: var(--va-warning, #b45309);\n  color: var(--va-warning-contrast, #fff);\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n.va-confirm__btn--warning:hover:not(:disabled) {\n  border-color: var(--va-warning, #b45309);\n  background: var(--va-warning, #b45309);\n  opacity: 0.88;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-confirm__input {\n    transition: none;\n  }\n}\n\n/* 按钮基类（自动附带） */\n/* ============================================================\n   按钮基类 —— 全库动作按钮的单一样式来源。\n   组件叠加使用：class=\"va-act va-act--primary va-xxx__submit\"，\n   组件自己的 CSS 只写布局/色彩覆盖（width、pill 圆角等）。\n   registry 生成器会把本文件自动内联进用了 va-act 的组件拷贝。\n   ============================================================ */\n\n.va-act {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--va-s3h, 6px);\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-s, 8px);\n  background: var(--va-card, #ffffff);\n  color: var(--va-ink-2, #43413c);\n  font: inherit;\n  font-size: var(--va-fs-md, 13px);\n  line-height: 1.4;\n  padding: 5px 14px;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: border-color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), background var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-act:hover:not(:disabled) { border-color: var(--va-edge-strong, rgba(26, 25, 23, 0.22)); }\n\n.va-act:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: 1px; }\n\n.va-act:disabled { opacity: 0.45; cursor: default; }\n\n/* 尺寸 */\n.va-act--sm { font-size: var(--va-fs-sm, 12px); padding: 3px var(--va-s4h, 10px); }\n.va-act--lg { font-size: var(--va-fs-lg, 14px); padding: 7px 18px; }\n\n/* 变体 */\n.va-act--primary {\n  background: var(--va-accent, #c2410c);\n  border-color: var(--va-accent, #c2410c);\n  color: var(--va-card, #ffffff);\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n.va-act--primary:hover:not(:disabled) {\n  background: var(--va-accent-hover, #9a3412);\n  border-color: var(--va-accent-hover, #9a3412);\n}\n\n.va-act--ghost {\n  border-color: transparent;\n  background: transparent;\n}\n\n.va-act--ghost:hover:not(:disabled) { background: var(--va-bg-subtle, #efede7); }\n\n.va-act--danger { border-color: transparent; background: transparent; color: var(--va-danger, #d5453c); }\n\n.va-act--danger:hover:not(:disabled) {\n  background: color-mix(in srgb, var(--va-danger, #d5453c) 10%, transparent);\n  border-color: transparent;\n}\n\n/* 语义色实底（成功/危险确认场景，按需叠加） */\n.va-act--success {\n  background: var(--va-success, #1a7f4b);\n  border-color: var(--va-success, #1a7f4b);\n  color: #fff;\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n/* 墨色实底：审批/决策/应用这类\"终审\"主操作（区别于 accent 常规主操作） */\n.va-act--ink {\n  background: var(--va-ink, #1a1917);\n  border-color: var(--va-ink, #1a1917);\n  color: var(--va-card, #ffffff);\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n.va-act--ink:hover:not(:disabled) { opacity: 0.88; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-act { transition: none; }\n}\n</style>\n"
    },
