{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "integration",
  "title": "Integration Picker / Settings",
  "description": "集成对接两件套：Picker 是服务卡片网格（已连接态、点击切换）；Settings 是配置面板（开关 + API key 等字段 + 保存/断开）。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `items` (IntegrationItem[]，默认 -)：Picker：服务列表\n- `v-model:enabled / v-model:values` (boolean / Record，默认 -)：Settings：开关与表单值\n- `fields` (IntegrationField[]，默认 -)：Settings：label/secret/required/error\n- `@toggle / @save / @disconnect` (-，默认 -)：连接切换 / 保存 / 断开",
  "files": [
    {
      "path": "components/ui/integration/VaIntegrationPicker.vue",
      "type": "registry:ui",
      "target": "components/ui/integration/VaIntegrationPicker.vue",
      "content": "<script setup lang=\"ts\">\nimport type { IntegrationPickerEvents, IntegrationPickerProps } from \"./types\";\n\nconst props = defineProps<IntegrationPickerProps>();\n\nconst emit = defineEmits<IntegrationPickerEvents>();\n\nfunction onClick(item: (typeof props.items)[number]) {\n  emit(\"select\", item);\n  emit(\"toggle\", item);\n}\n\nconst AVATAR_HUES = [16, 145, 210, 268, 34, 190];\nconst hueOf = (id: string) => AVATAR_HUES[[...id].reduce((s, c) => s + c.charCodeAt(0), 0) % AVATAR_HUES.length]!;\n</script>\n\n<template>\n  <ul\n    class=\"va-ipk\"\n    :class=\"{ 'va-ipk--stacked': props.stacked }\"\n    :style=\"!props.stacked && props.minCardWidth ? { gridTemplateColumns: `repeat(auto-fill, minmax(${props.minCardWidth}px, 1fr))` } : undefined\"\n    role=\"list\"\n    aria-label=\"集成服务\"\n  >\n    <li v-for=\"item in props.items\" :key=\"item.id\">\n      <button\n        class=\"va-ipk__card\"\n        type=\"button\"\n        :data-connected=\"item.connected ?? false\"\n        :aria-pressed=\"item.connected ?? false\"\n        @click=\"onClick(item)\"\n      >\n        <img v-if=\"item.icon\" class=\"va-ipk__icon\" :src=\"item.icon\" :alt=\"''\">\n        <span\n          v-else\n          class=\"va-ipk__icon va-ipk__icon--text\"\n          :style=\"{ background: `hsl(${hueOf(item.id)} 45% 88%)`, color: `hsl(${hueOf(item.id)} 45% 30%)` }\"\n          aria-hidden=\"true\"\n        >{{ item.name.slice(0, 1) }}</span>\n        <span class=\"va-ipk__main\">\n          <span class=\"va-ipk__name\">{{ item.name }}</span>\n          <span v-if=\"item.description\" class=\"va-ipk__desc\">{{ item.description }}</span>\n        </span>\n        <span class=\"va-ipk__state\" :data-connected=\"item.connected ?? false\">\n          {{ item.connected ? \"已连接\" : \"连接\" }}\n        </span>\n      </button>\n    </li>\n  </ul>\n</template>\n\n<style>\n/* VaIntegrationPicker — 集成服务网格 */\n\n.va-ipk {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));\n  gap: var(--va-s4);\n}\n\n.va-ipk--stacked { grid-template-columns: 1fr; }\n\n.va-ipk__card {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s4);\n  width: 100%;\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-m);\n  background: var(--va-card);\n  padding: var(--va-s4);\n  cursor: pointer;\n  text-align: left;\n  font: inherit;\n  transition: border-color var(--va-dur-1) var(--va-ease), box-shadow var(--va-dur-1) var(--va-ease);\n}\n\n.va-ipk__card:hover { border-color: var(--va-edge-strong); box-shadow: var(--va-shadow-1); }\n.va-ipk__card:focus-visible { outline: 2px solid var(--va-accent); outline-offset: 1px; }\n.va-ipk__card[data-connected=\"true\"] { border-color: color-mix(in srgb, var(--va-success) 45%, transparent); }\n\n.va-ipk__icon {\n  flex: none;\n  width: 38px;\n  height: 38px;\n  border-radius: var(--va-radius-m);\n  object-fit: cover;\n}\n\n.va-ipk__icon--text {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 16px;\n  font-weight: 700;\n}\n\n.va-ipk__main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }\n\n.va-ipk__name { font-size: 13.5px; font-weight: 600; color: var(--va-ink); }\n.va-ipk__desc {\n  font-size: 11.5px;\n  color: var(--va-muted);\n  line-height: 1.4;\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}\n\n.va-ipk__state {\n  flex: none;\n  font-size: 11.5px;\n  font-weight: 600;\n  padding: 3px 10px;\n  border-radius: var(--va-radius-pill);\n  background: var(--va-accent-soft);\n  color: var(--va-accent);\n}\n\n.va-ipk__state[data-connected=\"true\"] {\n  background: color-mix(in srgb, var(--va-success) 14%, transparent);\n  color: var(--va-success);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-ipk__card { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/integration/VaIntegrationSettings.vue",
      "type": "registry:ui",
      "target": "components/ui/integration/VaIntegrationSettings.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, ref } from \"vue\";\nimport type { IntegrationSettingsEvents, IntegrationSettingsProps } from \"./types\";\n\nconst props = defineProps<IntegrationSettingsProps>();\n\nconst emit = defineEmits<IntegrationSettingsEvents>();\n\n/* 受控（touched 哨兵回落 default*） */\nconst enabledTouched = ref(false);\nconst innerEnabled = ref(props.defaultEnabled ?? false);\nconst enabled = computed(() =>\n  props.enabled !== undefined || enabledTouched.value ? (props.enabled ?? false) : innerEnabled.value,\n);\n\nconst valuesTouched = ref(false);\nconst innerValues = ref(props.defaultValues ?? {});\nconst values = computed(() =>\n  props.values !== undefined || valuesTouched.value ? (props.values ?? {}) : innerValues.value,\n);\n\nfunction setEnabled(v: boolean) {\n  enabledTouched.value = true;\n  innerEnabled.value = v;\n  emit(\"update:enabled\", v);\n}\n\nfunction setField(id: string, v: string) {\n  const next = { ...values.value, [id]: v };\n  valuesTouched.value = true;\n  innerValues.value = next;\n  emit(\"update:values\", next);\n}\n\nconst missingRequired = computed(() =>\n  (props.fields ?? []).filter((f) => f.required && !(values.value[f.id] ?? \"\").trim()),\n);\n\nfunction save() {\n  if (props.saving || missingRequired.value.length) return;\n  emit(\"save\", { enabled: enabled.value, values: values.value });\n}\n</script>\n\n<template>\n  <section class=\"va-is\" :data-enabled=\"enabled\">\n    <header class=\"va-is__head\">\n      <div class=\"va-is__titlewrap\">\n        <h3 class=\"va-is__name\">{{ props.name }}</h3>\n        <p v-if=\"props.description\" class=\"va-is__desc\">{{ props.description }}</p>\n      </div>\n      <button\n        class=\"va-is__switch\"\n        type=\"button\"\n        role=\"switch\"\n        :aria-checked=\"enabled\"\n        :aria-label=\"`启用${props.name}`\"\n        @click=\"setEnabled(!enabled)\"\n      >\n        <span class=\"va-is__knob\" />\n      </button>\n    </header>\n\n    <div v-if=\"enabled && props.fields?.length\" class=\"va-is__fields\">\n      <label v-for=\"f in props.fields\" :key=\"f.id\" class=\"va-is__field\">\n        <span class=\"va-is__label\">\n          {{ f.label }}\n          <em v-if=\"f.required\" class=\"va-is__req\" aria-hidden=\"true\">*</em>\n        </span>\n        <input\n          class=\"va-is__input\"\n          :type=\"f.secret ? 'password' : 'text'\"\n          :value=\"values[f.id] ?? ''\"\n          :placeholder=\"f.placeholder\"\n          :aria-invalid=\"!!f.error\"\n          @input=\"setField(f.id, ($event.target as HTMLInputElement).value)\"\n        >\n        <span v-if=\"f.error\" class=\"va-is__err\" role=\"alert\">{{ f.error }}</span>\n      </label>\n    </div>\n\n    <footer v-if=\"enabled\" class=\"va-is__foot\">\n      <span v-if=\"props.savedLabel\" class=\"va-is__saved\" role=\"status\">{{ props.savedLabel }}</span>\n      <span class=\"va-is__spacer\" />\n      <button class=\"va-act va-act--ghost va-act--sm va-is__disc\" type=\"button\" @click=\"emit('disconnect')\">断开连接</button>\n      <button\n        class=\"va-act va-act--primary va-is__save\"\n        type=\"button\"\n        :disabled=\"props.saving || !!missingRequired.length\"\n        @click=\"save\"\n      >{{ props.saving ? \"保存中…\" : \"保存\" }}</button>\n    </footer>\n  </section>\n</template>\n\n<style>\n/* VaIntegrationSettings — 集成配置面板 */\n\n.va-is {\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-m);\n  background: var(--va-card);\n  padding: var(--va-s5);\n}\n\n.va-is__head {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: var(--va-s4);\n}\n\n.va-is__titlewrap { display: flex; flex-direction: column; gap: 2px; min-width: 0; }\n\n.va-is__name { margin: 0; font-size: 14.5px; font-weight: 700; color: var(--va-ink); }\n.va-is__desc { margin: 0; font-size: 12.5px; color: var(--va-muted); line-height: 1.5; }\n\n/* 开关 */\n.va-is__switch {\n  flex: none;\n  width: 42px;\n  height: 24px;\n  border-radius: var(--va-radius-pill);\n  border: 0;\n  background: var(--va-edge-strong);\n  position: relative;\n  cursor: pointer;\n  transition: background var(--va-dur-2) var(--va-ease);\n  padding: 0;\n}\n\n.va-is__switch[aria-checked=\"true\"] { background: var(--va-success); }\n\n.va-is__switch:focus-visible { outline: 2px solid var(--va-accent); outline-offset: 2px; }\n\n.va-is__knob {\n  position: absolute;\n  top: 2px;\n  left: 2px;\n  width: 20px;\n  height: 20px;\n  border-radius: 50%;\n  background: #fff;\n  box-shadow: var(--va-shadow-1);\n  transition: transform var(--va-dur-2) var(--va-ease);\n}\n\n.va-is__switch[aria-checked=\"true\"] .va-is__knob { transform: translateX(18px); }\n\n.va-is__disc:hover:not(:disabled) { color: var(--va-danger); }\n\n.va-is__fields {\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s4);\n  margin-top: var(--va-s5);\n}\n\n.va-is__field { display: flex; flex-direction: column; gap: var(--va-s2); }\n\n.va-is__label { font-size: 12px; font-weight: 600; color: var(--va-muted); }\n\n.va-is__req { color: var(--va-danger); font-style: normal; }\n\n.va-is__input {\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-bg);\n  color: var(--va-ink);\n  font: inherit;\n  font-size: 13px;\n  padding: 8px 10px;\n}\n\n.va-is__input:focus {\n  outline: none;\n  border-color: var(--va-accent);\n  box-shadow: 0 0 0 3px var(--va-accent-soft);\n}\n\n.va-is__input[aria-invalid=\"true\"] { border-color: var(--va-danger); }\n\n.va-is__err { font-size: 11.5px; color: var(--va-danger); }\n\n.va-is__foot {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3);\n  margin-top: var(--va-s5);\n  padding-top: var(--va-s4);\n  border-top: 1px solid var(--va-edge);\n}\n\n.va-is__spacer { flex: 1; }\n\n.va-is__saved { font-size: 12px; color: var(--va-success); }\n\n\n\n\n\n@media (prefers-reduced-motion: reduce) {\n  .va-is__switch,\n  .va-is__knob { transition: none; }\n}\n\n/* 按钮基类（自动附带） */\n/* ============================================================\n   按钮基类 —— 全库动作按钮的单一样式来源。\n   组件叠加使用：class=\"va-act va-act--primary va-xxx__submit\"，\n   组件自己的 CSS 只写布局/色彩覆盖（width、pill 圆角等）。\n   registry 生成器会把本文件自动内联进用了 va-act 的组件拷贝。\n   ============================================================ */\n\n.va-act {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-card);\n  color: var(--va-ink-2);\n  font: inherit;\n  font-size: 13px;\n  line-height: 1.4;\n  padding: 5px 14px;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: border-color var(--va-dur-1) var(--va-ease), background var(--va-dur-1) var(--va-ease),\n    color var(--va-dur-1) var(--va-ease);\n}\n\n.va-act:hover:not(:disabled) { border-color: var(--va-edge-strong); }\n\n.va-act:focus-visible { outline: 2px solid var(--va-accent); outline-offset: 1px; }\n\n.va-act:disabled { opacity: 0.45; cursor: default; }\n\n/* 尺寸 */\n.va-act--sm { font-size: 12px; padding: 3px 10px; }\n.va-act--lg { font-size: 14px; padding: 7px 18px; }\n\n/* 变体 */\n.va-act--primary {\n  background: var(--va-accent);\n  border-color: var(--va-accent);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-act--primary:hover:not(:disabled) {\n  background: var(--va-accent-hover);\n  border-color: var(--va-accent-hover);\n}\n\n.va-act--ghost {\n  border-color: transparent;\n  background: transparent;\n}\n\n.va-act--ghost:hover:not(:disabled) { background: var(--va-bg-subtle); }\n\n.va-act--danger { border-color: transparent; background: transparent; color: var(--va-danger); }\n\n.va-act--danger:hover:not(:disabled) {\n  background: color-mix(in srgb, var(--va-danger) 10%, transparent);\n  border-color: transparent;\n}\n\n/* 语义色实底（成功/危险确认场景，按需叠加） */\n.va-act--success {\n  background: var(--va-success);\n  border-color: var(--va-success);\n  color: #fff;\n  font-weight: 600;\n}\n\n/* 墨色实底：审批/决策/应用这类\"终审\"主操作（区别于 accent 常规主操作） */\n.va-act--ink {\n  background: var(--va-ink);\n  border-color: var(--va-ink);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-act--ink:hover:not(:disabled) { opacity: 0.88; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-act { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/integration/types.ts",
      "type": "registry:ui",
      "target": "components/ui/integration/types.ts",
      "content": "/** VaIntegrationPicker / VaIntegrationSettings 的类型定义 */\n\nexport interface IntegrationItem {\n  id: string;\n  name: string;\n  description?: string;\n  /** 已连接态 */\n  connected?: boolean;\n  /** 图标地址；缺省首字母色块 */\n  icon?: string;\n}\n\nexport interface IntegrationPickerProps {\n  items: IntegrationItem[];\n  /** 卡片网格最小宽度 px，默认 200 */\n  minCardWidth?: number;\n  /** 单列布局（设置页嵌内时用） */\n  stacked?: boolean;\n}\n\nexport interface IntegrationPickerEvents {\n  /** 点击卡片：切换连接/断开 */\n  toggle: [item: IntegrationItem];\n  select: [item: IntegrationItem];\n}\n\n/* ---------- IntegrationSettings ---------- */\n\nexport interface IntegrationField {\n  id: string;\n  label: string;\n  /** 值由宿主维护（v-model:values） */\n  placeholder?: string;\n  /** 密文输入（密码/API key） */\n  secret?: boolean;\n  required?: boolean;\n  /** 校验错误文案（宿主侧校验后传入） */\n  error?: string;\n}\n\nexport interface IntegrationSettingsProps {\n  name: string;\n  description?: string;\n  /** v-model:enabled 总开关 */\n  enabled?: boolean;\n  defaultEnabled?: boolean;\n  fields?: IntegrationField[];\n  /** v-model:values 表单值 */\n  values?: Record<string, string>;\n  defaultValues?: Record<string, string>;\n  /** 保存中 */\n  saving?: boolean;\n  /** 已保存状态提示文案（保存成功后宿主置一个短文案） */\n  savedLabel?: string;\n}\n\nexport interface IntegrationSettingsEvents {\n  \"update:enabled\": [v: boolean];\n  \"update:values\": [v: Record<string, string>];\n  /** 点击保存（携带当前 enabled + values） */\n  save: [payload: { enabled: boolean; values: Record<string, string> }];\n  /** 断开连接 */\n  disconnect: [];\n}\n"
    }
  ]
}
