{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "message-actions",
  "title": "Message Actions / Text",
  "description": "AI 消息的操作条：复制、再生成、点赞点踩（拒绝附原因输入）、版本切换；MessageText 提供版本交叉淡入。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `text` (string，默认 -)：复制的内容\n- `versions` (number，默认 -)：版本数，≥2 显示切换器\n- `v-model:version` (number，默认 -)：当前版本下标\n- `@copy / @regenerate / @feedback` (-，默认 -)：操作回调",
  "files": [
    {
      "path": "components/ui/message-actions/VaMessageActions.vue",
      "type": "registry:ui",
      "target": "components/ui/message-actions/VaMessageActions.vue",
      "content": "<script setup lang=\"ts\">\nimport type { MessageActionsProps } from \"./types\";\nimport { useMessageActions } from \"./useMessageActions\";\n\nconst props = withDefaults(defineProps<MessageActionsProps>(), {\n  text: undefined,\n  versions: undefined,\n  regenerating: false,\n  quiet: false,\n  reasons: undefined,\n});\n\nconst emit = defineEmits<{\n  copy: [text?: string];\n  regenerate: [];\n  versionChange: [index: number];\n  feedback: [kind: null | \"up\" | \"down\", reason?: string];\n}>();\n\nconst version = defineModel<number>(\"version\");\n\nconst {\n  copied,\n  copy,\n  chosen,\n  panelOpen,\n  reasons,\n  customReason,\n  thumb,\n  sendDown,\n  takeBack,\n  count,\n  effective,\n  showVersions,\n  go,\n} = useMessageActions(props, version, {\n  copy: (t) => emit(\"copy\", t),\n  regenerate: () => emit(\"regenerate\"),\n  versionChange: (i) => emit(\"versionChange\", i),\n  feedback: (kind, reason) => emit(\"feedback\", kind, reason),\n});\n</script>\n\n<template>\n  <div class=\"va-msg\" :class=\"{ 'va-msg--quiet': props.quiet, 'va-msg--panel': panelOpen }\">\n    <div class=\"va-msg__bar\">\n      <!-- 复制：.va-copy 交叉结构（TASK-106 标准，copy→check 120ms 交叉 + spring 微弹） -->\n      <button class=\"va-msg__act\" type=\"button\" :aria-label=\"copied ? '已复制' : '复制'\" @click=\"copy\">\n        <span class=\"va-copy\" :class=\"{ 'va-copy--done': copied }\" aria-hidden=\"true\">\n          <svg class=\"va-copy__idle\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 9.5A1.5 1.5 0 0 1 10.5 8h8A1.5 1.5 0 0 1 20 9.5v9a1.5 1.5 0 0 1-1.5 1.5h-8A1.5 1.5 0 0 1 9 18.5zM15 8V5.5A1.5 1.5 0 0 0 13.5 4h-8A1.5 1.5 0 0 0 4 5.5v9A1.5 1.5 0 0 0 5.5 16H9\" /></svg>\n          <svg class=\"va-copy__done\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><path d=\"M5.5 12.5l4 4L18.5 8\" /></svg>\n        </span>\n      </button>\n\n      <!-- 再生成 -->\n      <button class=\"va-msg__act\" type=\"button\" :aria-label=\"props.regenerating ? '再生成中' : '再生成'\" @click=\"emit('regenerate')\">\n        <svg :class=\"{ 'va-msg__spin': props.regenerating }\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M19.5 12a7.5 7.5 0 1 1-2.2-5.3L19.5 9M19.5 4.5V9H15\" /></svg>\n      </button>\n\n      <!-- 版本切换 -->\n      <span v-if=\"showVersions\" class=\"va-msg__versions\">\n        <button class=\"va-msg__act\" type=\"button\" aria-label=\"上一版本\" :disabled=\"effective <= 0\" @click=\"go(-1)\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"m14.5 7-5 5 5 5\" /></svg>\n        </button>\n        <span class=\"va-msg__ver-label\">{{ effective + 1 }} / {{ count }}</span>\n        <button class=\"va-msg__act\" type=\"button\" aria-label=\"下一版本\" :disabled=\"effective >= count - 1\" @click=\"go(1)\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"m9.5 7 5 5-5 5\" /></svg>\n        </button>\n      </span>\n\n      <span class=\"va-msg__sep\" aria-hidden=\"true\" />\n\n      <!-- 反馈 -->\n      <button\n        class=\"va-msg__act\"\n        :class=\"{ 'va-msg__act--on': chosen === 'up' }\"\n        type=\"button\"\n        aria-label=\"赞\"\n        :aria-pressed=\"chosen === 'up'\"\n        @click=\"thumb('up')\"\n      >\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7.5 10.5v9M7.5 10.5l3.3-6a1.8 1.8 0 0 1 3.3 1.2l-.6 3.8H18a2 2 0 0 1 2 2.3l-1.2 6.4a2 2 0 0 1-2 1.8H5a1 1 0 0 1-1-1v-7.5a1 1 0 0 1 1-1z\" /></svg>\n      </button>\n      <button\n        class=\"va-msg__act\"\n        :class=\"{ 'va-msg__act--on': chosen === 'down' }\"\n        type=\"button\"\n        aria-label=\"踩\"\n        :aria-pressed=\"chosen === 'down'\"\n        @click=\"thumb('down')\"\n      >\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"transform: rotate(180deg)\"><path d=\"M7.5 10.5v9M7.5 10.5l3.3-6a1.8 1.8 0 0 1 3.3 1.2l-.6 3.8H18a2 2 0 0 1 2 2.3l-1.2 6.4a2 2 0 0 1-2 1.8H5a1 1 0 0 1-1-1v-7.5a1 1 0 0 1 1-1z\" /></svg>\n      </button>\n    </div>\n\n    <!-- 点踩原因面板 -->\n    <Transition name=\"va-msg-panel\">\n      <div v-if=\"panelOpen\" class=\"va-msg__panel\">\n        <p class=\"va-msg__panel-title\">哪里不满意？</p>\n        <div class=\"va-msg__reasons\">\n          <button v-for=\"r in reasons\" :key=\"r\" class=\"va-msg__reason\" type=\"button\" @click=\"sendDown(r)\">{{ r }}</button>\n        </div>\n        <div class=\"va-msg__other\">\n          <input v-model=\"customReason\" class=\"va-msg__other-input\" type=\"text\" placeholder=\"其他原因…\" @keydown.enter=\"sendDown(customReason)\" />\n          <button class=\"va-msg__reason va-msg__reason--go\" type=\"button\" :disabled=\"!customReason.trim()\" @click=\"sendDown(customReason)\">发送</button>\n          <button class=\"va-msg__reason\" type=\"button\" @click=\"takeBack\">撤回反馈</button>\n        </div>\n      </div>\n    </Transition>\n  </div>\n</template>\n\n<style>\n/* VaMessageActions — AI 消息操作条 */\n.va-msg {\n  --_edge: var(--va-msg-edge, var(--va-edge, rgba(26, 25, 23, 0.12)));\n  --_muted: var(--va-msg-muted, var(--va-muted, #6f6d66));\n  --_ink: var(--va-msg-ink, var(--va-ink, #1a1917));\n  --_success: var(--va-msg-success, var(--va-success, #1a7f4b));\n  --_danger: var(--va-msg-danger, var(--va-danger, #d5453c));\n  font-family: var(--va-font, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Helvetica Neue\", sans-serif);\n}\n\n/* 安静模式：淡显，悬停本条时显现 */\n.va-msg--quiet { opacity: 0.4; transition: opacity var(--va-dur-2, 200ms) ease; }\n.va-msg--quiet:hover, .va-msg--quiet:focus-within, .va-msg--panel { opacity: 1; }\n\n.va-msg__bar { display: flex; align-items: center; gap: 2px; }\n\n.va-msg__act {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 26px;\n  height: 26px;\n  border: 0;\n  border-radius: var(--va-radius-s, 8px);\n  background: none;\n  color: var(--_muted);\n  cursor: pointer;\n  transition: color var(--va-dur-1, 120ms) ease, background var(--va-dur-1, 120ms) ease;\n}\n.va-msg__act:hover:not(:disabled) { background: var(--va-bg-subtle, #efede7); color: var(--_ink); }\n.va-msg__act:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: 1px; }\n.va-msg__act:disabled { opacity: 0.35; cursor: default; }\n.va-msg__act--on { color: var(--va-accent, #c2410c); }\n.va-msg__act svg { width: 15px; height: 15px; }\n\n.va-msg__spin { animation: va-spin calc(var(--va-dur-loop, 1.8s) * 0.5) linear infinite; }\n@keyframes va-spin { to { transform: rotate(360deg); } }\n\n/* 版本切换 */\n.va-msg__versions { display: inline-flex; align-items: center; gap: 0; }\n.va-msg__ver-label {\n  min-width: 34px;\n  text-align: center;\n  font-family: var(--va-font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);\n  font-size: var(--va-fs-xs, 11px);\n  color: var(--_muted);\n  font-variant-numeric: tabular-nums;\n}\n.va-msg__sep { width: 1px; height: 14px; background: var(--_edge); margin: 0 var(--va-s3h, 6px); }\n\n/* 原因面板 */\n.va-msg__panel {\n  margin-top: var(--va-s2, 4px);\n  padding: var(--va-s3, 8px);\n  border: 1px solid var(--_edge);\n  border-radius: var(--va-radius-m, 10px);\n  background: var(--va-card, #ffffff);\n  box-shadow: var(--va-shadow-2, 0 4px 12px rgba(26, 25, 23, 0.08));\n}\n.va-msg__panel-title { margin: 0 0 var(--va-s2, 4px); font-size: var(--va-fs-sm, 12px); font-weight: var(--va-fw-semibold, 600); color: var(--_ink); }\n.va-msg__reasons { display: flex; gap: 4px; flex-wrap: wrap; }\n.va-msg__reason {\n  height: 24px;\n  padding: 0 var(--va-s4h, 10px);\n  border: 1px solid var(--_edge);\n  border-radius: var(--va-radius-pill, 999px);\n  background: var(--va-card, #ffffff);\n  color: var(--va-ink-2, #43413c);\n  font-size: var(--va-fs-sm, 12px);\n  cursor: pointer;\n  font-family: inherit;\n}\n.va-msg__reason:hover { border-color: var(--va-edge-strong, rgba(26, 25, 23, 0.22)); }\n.va-msg__reason:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: 1px; }\n.va-msg__reason--go { color: var(--_ink); font-weight: var(--va-fw-semibold, 600); }\n.va-msg__reason--go:disabled { opacity: 0.4; cursor: default; }\n\n.va-msg__other { display: flex; align-items: center; gap: 4px; margin-top: var(--va-s2, 4px); }\n.va-msg__other-input {\n  flex: 1;\n  min-width: 0;\n  border: 1px solid var(--_edge);\n  border-radius: var(--va-radius-pill, 999px);\n  padding: 3px var(--va-s4h, 10px);\n  font: inherit;\n  font-size: var(--va-fs-sm, 12px);\n  color: var(--_ink);\n  background: var(--va-card, #ffffff);\n}\n.va-msg__other-input:focus { outline: none; border-color: var(--va-accent, #c2410c); }\n\n.va-msg-panel-enter-active, .va-msg-panel-leave-active { transition: opacity var(--va-dur-1, 120ms) ease, transform var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)); }\n.va-msg-panel-enter-from, .va-msg-panel-leave-to { opacity: 0; transform: translateY(-2px); }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-msg--quiet { transition: none; }\n  /* 减速不停：加载态必须保持可感知（2s = 底速 × 10/9） */\n  .va-msg__spin { animation-duration: calc(var(--va-dur-loop, 1.8s) * 10 / 9); }\n  .va-msg-panel-enter-active, .va-msg-panel-leave-active { transition: none; }\n}\n\n/* 动效工具类（自动附带，源码中来自全局 motion.css） */\n/* ============================================================\n   共享动效工具类 —— 进出场/交叉淡入的统一协议（TASK-102 动效基建）。\n   组件不逐个发明入场曲线：统一消费 --va-dur-in/--va-dur-out 骨架时长与\n   --va-dist-* 位移档；每条声明自带字面 fallback（registry 单文件拷贝分发\n   要求，与 tokens.css 门禁一致）。\n\n   接入方式二选一：\n   1. Vue <Transition>：\n      <Transition enter-active-class=\"va-enter-up\" leave-active-class=\"va-exit-up\">\n      动画 fill-mode 为 both（延迟期间保持首帧、播完停在终态），\n      无需再配 enter-from-class / leave-to-class；\n   2. 类切换重挂载：骨架 → 内容换节点时给新节点挂 .va-crossfade（纯淡入），\n      离场节点挂 .va-exit-*（更短更快）。\n\n   列表错峰：v-for 子项 :style=\"useStagger().delayStyle(i)\" 配合 .va-enter-*\n   动画类使用（animation-delay 由 composable 编排——.va-enter-* 为 CSS animation，\n   transition-delay 对其零作用，见 composables/useStagger.ts）。\n   ============================================================ */\n\n/* 入场：上浮（自下方 --va-dist-m 浮起） */\n@keyframes va-motion-in-up {\n  from { opacity: 0; transform: translateY(var(--va-dist-m, 8px)); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* 入场：左滑（自左侧 --va-dist-m 滑入） */\n@keyframes va-motion-in-left {\n  from { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n  to { opacity: 1; transform: translateX(0); }\n}\n\n/* 入场：缩放（96% 起放大至原尺寸） */\n@keyframes va-motion-in-scale {\n  from { opacity: 0; transform: scale(0.96); }\n  to { opacity: 1; transform: scale(1); }\n}\n\n/* 离场：与入场互逆（向上/向左飘出、缩回）；时长/曲线由工具类映射 --va-dur-out 骨架 */\n@keyframes va-motion-out-up {\n  from { opacity: 1; transform: translateY(0); }\n  to { opacity: 0; transform: translateY(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-left {\n  from { opacity: 1; transform: translateX(0); }\n  to { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-scale {\n  from { opacity: 1; transform: scale(1); }\n  to { opacity: 0; transform: scale(0.96); }\n}\n\n/* 交叉淡入/淡出（.va-crossfade 骨架→内容交换专用，无位移，避免占位跳变叠加） */\n@keyframes va-motion-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes va-motion-fade-out {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n/* ---- 工具类：入场走 --va-dur-in + ease-out-quart，离场走 --va-dur-out + ease-in-quad ---- */\n\n.va-enter-up {\n  animation: va-motion-in-up var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-left {\n  animation: va-motion-in-left var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-scale {\n  animation: va-motion-in-scale var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-exit-up {\n  animation: va-motion-out-up var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-left {\n  animation: va-motion-out-left var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-scale {\n  animation: va-motion-out-scale var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n/* 骨架 → 内容交叉过渡：新内容纯淡入 */\n.va-crossfade {\n  animation: va-motion-fade-in var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* 空态/轻量状态渐入（TASK-106 弱化档）：仅 opacity、时长走 --va-dur-2，\n   供列表空态提示与一次性状态块使用（空态清单见 TASK-106 报告）。\n   纯 opacity 即动效分频策略的降级终点形态，reduced-motion 下保持原样即可。 */\n.va-fade-in {\n  animation: va-motion-fade-in var(--va-dur-2, 200ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* ---- 静态光斑基类（TASK-105，决策 5「追光」路线基建）----\n   pointer 坐标由 composables/useSpotlight.ts 以 rAF 节流写入 --va-spot-x/y\n   （元素内百分比，光斑数学在 composable 内可单测）；本类只负责 radial 光斑\n   绘制与显隐（:hover 点亮，无 3D 倾斜， glare 数学对齐 VaTiltCard）。\n   --va-spot-* 为 L3 组件钩子口径（宿主可覆盖尺寸/颜色），不进 tokens.css。\n   双降级对齐 VaTiltCard glare：hover: none（触屏）与 reduced-motion 不绘制。 */\n.va-spotlight { position: relative; }\n\n/* ::after 承载光斑（避开组件自身 ::before 用途）；inset 0 + border-radius inherit\n   使光斑天然裁剪在宿主圆角内，无需 overflow: hidden。\n   注意：此 ::after radial 与 components/spotlight-card/VaSpotlightCard.css 的\n   .va-spot-card--spot::after 为 registry 单文件自含有意复制，改动需两处同步。 */\n.va-spotlight::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n  background: radial-gradient(\n    var(--va-spot-size, 240px) circle at var(--va-spot-x, 50%) var(--va-spot-y, 50%),\n    var(--va-spot-color, rgba(255, 255, 255, 0.14)),\n    transparent 65%\n  );\n}\n\n.va-spotlight:hover::after { opacity: 1; }\n\n@media (hover: none) {\n  .va-spotlight::after { display: none; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-spotlight::after { display: none; }\n}\n\n/* ---- 复制反馈标准（TASK-106）：copy→check 交叉过渡 ----\n   容器 .va-copy 为 inline-grid 双内容同格堆叠（格子宽取较宽子项，切换零跳动）：\n   __idle = copy 态内容（图标/文字），__done = check 态内容。\n   copied 置真挂 .va-copy--done：check 以 ease-spring 微弹入场（进入 done 态时\n   transform 的目标态时序换成 --va-ease-spring → 过冲回弹），交叉时长统一 --va-dur-1。\n   消费方：terminal-log（行复制）、code-diff（复制按钮）、message-actions（复制图标）。 */\n.va-copy { display: inline-grid; place-items: center; }\n\n.va-copy__idle,\n.va-copy__done {\n  grid-area: 1 / 1;\n  transition: opacity var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-copy__idle { opacity: 1; transform: scale(1); }\n.va-copy__done { opacity: 0; transform: scale(0.6); }\n\n.va-copy--done .va-copy__done {\n  opacity: 1;\n  transform: scale(1);\n  /* 时序按 transition 属性顺序映射：opacity 仍 ease，transform 换 ease-spring 微弹 */\n  transition-timing-function: var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), var(--va-ease-spring, cubic-bezier(0.34, 1.56, 0.64, 1));\n}\n\n.va-copy--done .va-copy__idle { opacity: 0; transform: scale(0.6); }\n\n@media (prefers-reduced-motion: reduce) {\n  /* 交叉过渡瞬时完成（无位移动画），copied 状态可感知性不受影响 */\n  .va-copy__idle,\n  .va-copy__done { transition: none; }\n}\n\n/* ---- 错误反馈标准（校验失败横向微振）：目标元素挂 .va-shake 播一次 ±3px 微振 ----\n   时长 --va-dur-2 × 2（两拍四峰，克制的「摇头」量级，rubric 校验失败口径）；\n   重复触发需先移除类、强制 reflow 再挂回（封装见 composables/useShake.ts）。\n   reduced-motion 降级为不播：错误状态的可感知性由错误样式本身（描边/文案）承担，\n   动效只做注意力引导——符合头注释「功能动画降级保留状态可感知」的分频策略。\n   消费方：VaStepperForm / VaOtpInput 经 useShake() 程序化触发（defineExpose shake()）；\n   宿主自绘表单可直接挂类。 */\n@keyframes va-motion-shake {\n  20% { transform: translateX(-3px); }\n  40% { transform: translateX(3px); }\n  60% { transform: translateX(-2px); }\n  80% { transform: translateX(2px); }\n}\n\n.va-shake {\n  animation: va-motion-shake calc(var(--va-dur-2, 200ms) * 2) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-shake { animation: none; }\n}\n\n/* ---- 动效分频（对齐 tokens.css 头注释策略）：\n   功能动画降级为纯 opacity——进/出场整体换成 fade keyframes，\n   位移/缩放不再出现（animation-name 顶替，时长/缓动沿用上面的声明）。 */\n@media (prefers-reduced-motion: reduce) {\n  .va-enter-up,\n  .va-enter-left,\n  .va-enter-scale,\n  .va-crossfade {\n    animation-name: va-motion-fade-in;\n  }\n\n  .va-exit-up,\n  .va-exit-left,\n  .va-exit-scale {\n    animation-name: va-motion-fade-out;\n  }\n}\n</style>\n"
    },
