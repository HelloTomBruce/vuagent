    {
      "path": "components/ui/message-actions/index.ts",
      "type": "registry:ui",
      "target": "components/ui/message-actions/index.ts",
      "content": "export { default as VaMessageActions } from \"./VaMessageActions.vue\";\nexport { default as VaMessageText } from \"./VaMessageText.vue\";\nexport { DEFAULT_FEEDBACK_REASONS } from \"./types\";\nexport type {\n  FeedbackKind,\n  MessageActionKind,\n  MessageActionsEvents,\n  MessageActionsProps,\n  MessageTextProps,\n} from \"./types\";\n"
    },
    {
      "path": "components/ui/message-actions/types.ts",
      "type": "registry:ui",
      "target": "components/ui/message-actions/types.ts",
      "content": "/** VaMessageActions / VaMessageText 的类型定义 */\n\nexport type MessageActionKind = \"copy\" | \"regenerate\" | \"feedback\";\nexport type FeedbackKind = \"up\" | \"down\";\n\nexport interface MessageActionsProps {\n  /** 复制按钮携带的文本 */\n  text?: string;\n  /** 版本总数；≥ 2 时显示版本切换器 */\n  versions?: number;\n  /** 再生成进行中：按钮旋转 */\n  regenerating?: boolean;\n  /** 安静模式：默认半透明，悬停本组件时显现 */\n  quiet?: boolean;\n  /** 点踩的快捷原因（默认内置四项 + 其他） */\n  reasons?: string[];\n}\n\nexport interface MessageActionsEvents {\n  copy: [text?: string];\n  regenerate: [];\n  versionChange: [index: number];\n  /** kind=null 表示撤回反馈 */\n  feedback: [kind: FeedbackKind | null, reason?: string];\n}\n\nexport interface MessageTextProps {\n  /** 版本 key：变化时交叉淡入 */\n  version: string | number;\n}\n\nexport const DEFAULT_FEEDBACK_REASONS = [\"不够准确\", \"太啰嗦\", \"没听懂指令\"];\n"
    },
    {
      "path": "components/ui/message-actions/useMessageActions.ts",
      "type": "registry:ui",
      "target": "components/ui/message-actions/useMessageActions.ts",
      "content": "import { computed, ref, type Ref, onBeforeUnmount } from \"vue\";\n\nimport type { FeedbackKind, MessageActionsProps } from \"./types\";\nimport { DEFAULT_FEEDBACK_REASONS } from \"./types\";\n\n\n/**\n * VaMessageActions 的状态逻辑：复制 / 再生成 / 反馈（含原因面板）/ 版本切换。\n * version 由 SFC 的 defineModel 创建后传入（未绑定父层时组件内部自持）。\n * 复制统一走共享 useCopyable（TASK-106：copied 1.5s 置真口径与库内其他组件一致），\n * 图标交叉过渡由模板挂 styles/motion.css 的 .va-copy 结构承接。\n */\nexport function useMessageActions(\n  props: MessageActionsProps,\n  version: Ref<number | undefined>,\n  emit: {\n    copy: (text?: string) => void;\n    regenerate: () => void;\n    versionChange: (index: number) => void;\n    feedback: (kind: FeedbackKind | null, reason?: string) => void;\n  },\n) {\n  /* ---------- 复制（useCopyable：剪贴板写入 + copied 1.5s 置真） ---------- */\n  const { copied, copy } = useCopyable(\n    () => props.text ?? \"\",\n    (t) => emit.copy(t),\n  );\n\n  /* ---------- 反馈 ---------- */\n  const chosen = ref<FeedbackKind | null>(null);\n  const panelOpen = ref(false);\n  const reasons = computed(() => props.reasons ?? DEFAULT_FEEDBACK_REASONS);\n  const customReason = ref(\"\");\n\n  function thumb(kind: FeedbackKind) {\n    if (kind === \"up\") {\n      chosen.value = chosen.value === \"up\" ? null : \"up\";\n      panelOpen.value = false;\n      emit.feedback(chosen.value);\n      return;\n    }\n    // down：首次打开原因面板，再点收起\n    if (panelOpen.value) {\n      panelOpen.value = false;\n      return;\n    }\n    chosen.value = \"down\";\n    panelOpen.value = true;\n    customReason.value = \"\";\n  }\n  function sendDown(reason: string) {\n    chosen.value = \"down\";\n    panelOpen.value = false;\n    emit.feedback(\"down\", reason || undefined);\n  }\n  function takeBack() {\n    chosen.value = null;\n    panelOpen.value = false;\n    emit.feedback(null);\n  }\n\n  /* ---------- 版本 ---------- */\n  const count = computed(() => (typeof props.versions === \"number\" ? Math.max(1, props.versions) : 1));\n  const showVersions = computed(() => count.value >= 2);\n  /** 未绑定（undefined）时视为\"跟随最新\" */\n  const effective = computed(() => {\n    const v = version.value;\n    if (v == null || v < 0 || v >= count.value) return count.value - 1;\n    return v;\n  });\n  function go(dir: -1 | 1) {\n    const next = Math.min(count.value - 1, Math.max(0, effective.value + dir));\n    version.value = next;\n    emit.versionChange(next);\n  }\n\n  return {\n    copied,\n    copy,\n    chosen,\n    panelOpen,\n    reasons,\n    customReason,\n    thumb,\n    sendDown,\n    takeBack,\n    count,\n    effective,\n    showVersions,\n    go,\n  };\n}\n\n/* ── 内联自 @vuagent/ui src/composables/useCopyable.ts（registry 单文件拷贝自包含） ── */\n/**\n * 复制到剪贴板 + copied 短暂置真反馈。\n * SSR 安全：navigator/document 均有守卫；失败静默（宿主可监听回调自行提示）。\n */\nfunction useCopyable(getText: () => string, onCopy?: (text: string) => void) {\n  const copied = ref(false);\n  let timer: number | undefined;\n\n  async function copy() {\n    const t = getText();\n    try {\n      if (typeof navigator !== \"undefined\" && navigator.clipboard) {\n        await navigator.clipboard.writeText(t);\n      } else if (typeof document !== \"undefined\") {\n        const ta = document.createElement(\"textarea\");\n        ta.value = t;\n        document.body.appendChild(ta);\n        ta.select();\n        document.execCommand(\"copy\");\n        ta.remove();\n      }\n    } catch {\n      /* 剪贴板不可用 */\n    }\n    copied.value = true;\n    onCopy?.(t);\n    if (timer !== undefined) window.clearTimeout(timer);\n    timer = window.setTimeout(() => (copied.value = false), 1500);\n  }\n\n  onBeforeUnmount(() => {\n    if (timer !== undefined) window.clearTimeout(timer);\n  });\n\n  return { copied, copy };\n}\n"
    }
  ]
