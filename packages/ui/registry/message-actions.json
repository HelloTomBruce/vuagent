{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "message-actions",
  "title": "Message Actions / Text",
  "description": "AI 消息的操作条：复制、再生成、点赞点踩（拒绝附原因输入）、版本切换；MessageText 提供版本交叉淡入。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `text` (string，默认 -)：复制的内容\n- `versions` (number，默认 -)：版本数，≥2 显示切换器\n- `v-model:version` (number，默认 -)：当前版本下标\n- `@copy / @regenerate / @feedback` (-，默认 -)：操作回调",
  "files": [
    {
      "path": "components/ui/message-actions/VaMessageActions.vue",
      "type": "registry:ui",
      "target": "components/ui/message-actions/VaMessageActions.vue",
      "content": "<script setup lang=\"ts\">\nimport type { MessageActionsProps } from \"./types\";\nimport { useMessageActions } from \"./useMessageActions\";\n\nconst props = withDefaults(defineProps<MessageActionsProps>(), {\n  text: undefined,\n  versions: undefined,\n  regenerating: false,\n  quiet: false,\n  reasons: undefined,\n});\n\nconst emit = defineEmits<{\n  copy: [text?: string];\n  regenerate: [];\n  versionChange: [index: number];\n  feedback: [kind: null | \"up\" | \"down\", reason?: string];\n}>();\n\nconst version = defineModel<number>(\"version\");\n\nconst {\n  copied,\n  copy,\n  chosen,\n  panelOpen,\n  reasons,\n  customReason,\n  thumb,\n  sendDown,\n  takeBack,\n  count,\n  effective,\n  showVersions,\n  go,\n} = useMessageActions(props, version, {\n  copy: (t) => emit(\"copy\", t),\n  regenerate: () => emit(\"regenerate\"),\n  versionChange: (i) => emit(\"versionChange\", i),\n  feedback: (kind, reason) => emit(\"feedback\", kind, reason),\n});\n</script>\n\n<template>\n  <div class=\"va-msg\" :class=\"{ 'va-msg--quiet': props.quiet, 'va-msg--panel': panelOpen }\">\n    <div class=\"va-msg__bar\">\n      <!-- 复制 -->\n      <button class=\"va-msg__act\" type=\"button\" :aria-label=\"copied ? '已复制' : '复制'\" @click=\"copy\">\n        <svg v-if=\"copied\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M5.5 12.5l4 4L18.5 8\" /></svg>\n        <svg v-else viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 9.5A1.5 1.5 0 0 1 10.5 8h8A1.5 1.5 0 0 1 20 9.5v9a1.5 1.5 0 0 1-1.5 1.5h-8A1.5 1.5 0 0 1 9 18.5zM15 8V5.5A1.5 1.5 0 0 0 13.5 4h-8A1.5 1.5 0 0 0 4 5.5v9A1.5 1.5 0 0 0 5.5 16H9\" /></svg>\n      </button>\n\n      <!-- 再生成 -->\n      <button class=\"va-msg__act\" type=\"button\" :aria-label=\"props.regenerating ? '再生成中' : '再生成'\" @click=\"emit('regenerate')\">\n        <svg :class=\"{ 'va-msg__spin': props.regenerating }\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M19.5 12a7.5 7.5 0 1 1-2.2-5.3L19.5 9M19.5 4.5V9H15\" /></svg>\n      </button>\n\n      <!-- 版本切换 -->\n      <span v-if=\"showVersions\" class=\"va-msg__versions\">\n        <button class=\"va-msg__act\" type=\"button\" aria-label=\"上一版本\" :disabled=\"effective <= 0\" @click=\"go(-1)\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"m14.5 7-5 5 5 5\" /></svg>\n        </button>\n        <span class=\"va-msg__ver-label\">{{ effective + 1 }} / {{ count }}</span>\n        <button class=\"va-msg__act\" type=\"button\" aria-label=\"下一版本\" :disabled=\"effective >= count - 1\" @click=\"go(1)\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"m9.5 7 5 5-5 5\" /></svg>\n        </button>\n      </span>\n\n      <span class=\"va-msg__sep\" aria-hidden=\"true\" />\n\n      <!-- 反馈 -->\n      <button\n        class=\"va-msg__act\"\n        :class=\"{ 'va-msg__act--on': chosen === 'up' }\"\n        type=\"button\"\n        aria-label=\"赞\"\n        :aria-pressed=\"chosen === 'up'\"\n        @click=\"thumb('up')\"\n      >\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7.5 10.5v9M7.5 10.5l3.3-6a1.8 1.8 0 0 1 3.3 1.2l-.6 3.8H18a2 2 0 0 1 2 2.3l-1.2 6.4a2 2 0 0 1-2 1.8H5a1 1 0 0 1-1-1v-7.5a1 1 0 0 1 1-1z\" /></svg>\n      </button>\n      <button\n        class=\"va-msg__act\"\n        :class=\"{ 'va-msg__act--on': chosen === 'down' }\"\n        type=\"button\"\n        aria-label=\"踩\"\n        :aria-pressed=\"chosen === 'down'\"\n        @click=\"thumb('down')\"\n      >\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"transform: rotate(180deg)\"><path d=\"M7.5 10.5v9M7.5 10.5l3.3-6a1.8 1.8 0 0 1 3.3 1.2l-.6 3.8H18a2 2 0 0 1 2 2.3l-1.2 6.4a2 2 0 0 1-2 1.8H5a1 1 0 0 1-1-1v-7.5a1 1 0 0 1 1-1z\" /></svg>\n      </button>\n    </div>\n\n    <!-- 点踩原因面板 -->\n    <Transition name=\"va-msg-panel\">\n      <div v-if=\"panelOpen\" class=\"va-msg__panel\">\n        <p class=\"va-msg__panel-title\">哪里不满意？</p>\n        <div class=\"va-msg__reasons\">\n          <button v-for=\"r in reasons\" :key=\"r\" class=\"va-msg__reason\" type=\"button\" @click=\"sendDown(r)\">{{ r }}</button>\n        </div>\n        <div class=\"va-msg__other\">\n          <input v-model=\"customReason\" class=\"va-msg__other-input\" type=\"text\" placeholder=\"其他原因…\" @keydown.enter=\"sendDown(customReason)\" />\n          <button class=\"va-msg__reason va-msg__reason--go\" type=\"button\" :disabled=\"!customReason.trim()\" @click=\"sendDown(customReason)\">发送</button>\n          <button class=\"va-msg__reason\" type=\"button\" @click=\"takeBack\">撤回反馈</button>\n        </div>\n      </div>\n    </Transition>\n  </div>\n</template>\n\n<style>\n/* VaMessageActions — AI 消息操作条 */\n.va-msg {\n  --_edge: var(--va-msg-edge, var(--va-edge, rgba(26, 25, 23, 0.12)));\n  --_muted: var(--va-msg-muted, var(--va-muted, #6f6d66));\n  --_ink: var(--va-msg-ink, var(--va-ink, #1a1917));\n  --_success: var(--va-msg-success, var(--va-success, #1a7f4b));\n  --_danger: var(--va-msg-danger, var(--va-danger, #d5453c));\n  font-family: var(--va-font, system-ui, sans-serif);\n}\n\n/* 安静模式：淡显，悬停本条时显现 */\n.va-msg--quiet { opacity: 0.4; transition: opacity var(--va-dur-2, 200ms) ease; }\n.va-msg--quiet:hover, .va-msg--quiet:focus-within, .va-msg--panel { opacity: 1; }\n\n.va-msg__bar { display: flex; align-items: center; gap: 2px; }\n\n.va-msg__act {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 26px;\n  height: 26px;\n  border: 0;\n  border-radius: var(--va-radius-s, 8px);\n  background: none;\n  color: var(--_muted);\n  cursor: pointer;\n  transition: color var(--va-dur-1, 120ms) ease, background var(--va-dur-1, 120ms) ease;\n}\n.va-msg__act:hover:not(:disabled) { background: var(--va-bg-subtle, #efede7); color: var(--_ink); }\n.va-msg__act:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: 1px; }\n.va-msg__act:disabled { opacity: 0.35; cursor: default; }\n.va-msg__act--on { color: var(--va-accent, #c2410c); }\n.va-msg__act svg { width: 15px; height: 15px; }\n\n.va-msg__spin { animation: va-msg-spin 0.9s linear infinite; }\n@keyframes va-msg-spin { to { transform: rotate(360deg); } }\n\n/* 版本切换 */\n.va-msg__versions { display: inline-flex; align-items: center; gap: 0; }\n.va-msg__ver-label {\n  min-width: 34px;\n  text-align: center;\n  font-family: var(--va-font-mono, monospace);\n  font-size: 11px;\n  color: var(--_muted);\n  font-variant-numeric: tabular-nums;\n}\n.va-msg__sep { width: 1px; height: 14px; background: var(--_edge); margin: 0 6px; }\n\n/* 原因面板 */\n.va-msg__panel {\n  margin-top: var(--va-s2, 4px);\n  padding: var(--va-s3, 8px);\n  border: 1px solid var(--_edge);\n  border-radius: var(--va-radius-m, 10px);\n  background: var(--va-card, #fff);\n  box-shadow: var(--va-shadow-2, none);\n}\n.va-msg__panel-title { margin: 0 0 var(--va-s2, 4px); font-size: 12px; font-weight: 600; color: var(--_ink); }\n.va-msg__reasons { display: flex; gap: 4px; flex-wrap: wrap; }\n.va-msg__reason {\n  height: 24px;\n  padding: 0 10px;\n  border: 1px solid var(--_edge);\n  border-radius: var(--va-radius-pill, 999px);\n  background: var(--va-card, #fff);\n  color: var(--va-ink-2, #43413c);\n  font-size: 12px;\n  cursor: pointer;\n  font-family: inherit;\n}\n.va-msg__reason:hover { border-color: var(--va-edge-strong, rgba(26, 25, 23, 0.22)); }\n.va-msg__reason:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: 1px; }\n.va-msg__reason--go { color: var(--_ink); font-weight: 600; }\n.va-msg__reason--go:disabled { opacity: 0.4; cursor: default; }\n\n.va-msg__other { display: flex; align-items: center; gap: 4px; margin-top: var(--va-s2, 4px); }\n.va-msg__other-input {\n  flex: 1;\n  min-width: 0;\n  border: 1px solid var(--_edge);\n  border-radius: var(--va-radius-pill, 999px);\n  padding: 3px 10px;\n  font: inherit;\n  font-size: 12px;\n  color: var(--_ink);\n  background: var(--va-card, #fff);\n}\n.va-msg__other-input:focus { outline: none; border-color: var(--va-accent, #c2410c); }\n\n.va-msg-panel-enter-active, .va-msg-panel-leave-active { transition: opacity var(--va-dur-1, 120ms) ease, transform var(--va-dur-1, 120ms) var(--va-ease, ease); }\n.va-msg-panel-enter-from, .va-msg-panel-leave-to { opacity: 0; transform: translateY(-2px); }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-msg--quiet { transition: none; }\n  .va-msg__spin { animation-duration: 2s; }\n  .va-msg-panel-enter-active, .va-msg-panel-leave-active { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/message-actions/VaMessageText.vue",
      "type": "registry:ui",
      "target": "components/ui/message-actions/VaMessageText.vue",
      "content": "<script setup lang=\"ts\">\nimport type { MessageTextProps } from \"./types\";\n\ndefineProps<MessageTextProps>();\n</script>\n\n<template>\n  <div class=\"va-msg-text\">\n    <Transition name=\"va-msg-text\" mode=\"out-in\">\n      <div :key=\"version\" class=\"va-msg-text__inner\" dir=\"auto\">\n        <slot />\n      </div>\n    </Transition>\n  </div>\n</template>\n\n<style>\n/* VaMessageText — 版本交叉淡入的消息正文 */\n.va-msg-text { min-width: 0; }\n\n.va-msg-text__inner { font-size: 14px; line-height: 1.8; color: var(--va-ink, #1a1917); white-space: pre-wrap; word-break: break-word; }\n\n.va-msg-text-enter-active, .va-msg-text-leave-active { transition: opacity var(--va-dur-2, 200ms) ease; }\n.va-msg-text-enter-from, .va-msg-text-leave-to { opacity: 0; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-msg-text-enter-active, .va-msg-text-leave-active { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/message-actions/types.ts",
      "type": "registry:ui",
      "target": "components/ui/message-actions/types.ts",
      "content": "/** VaMessageActions / VaMessageText 的类型定义 */\n\nexport type MessageActionKind = \"copy\" | \"regenerate\" | \"feedback\";\nexport type FeedbackKind = \"up\" | \"down\";\n\nexport interface MessageActionsProps {\n  /** 复制按钮携带的文本 */\n  text?: string;\n  /** 版本总数；≥ 2 时显示版本切换器 */\n  versions?: number;\n  /** 再生成进行中：按钮旋转 */\n  regenerating?: boolean;\n  /** 安静模式：默认半透明，悬停本组件时显现 */\n  quiet?: boolean;\n  /** 点踩的快捷原因（默认内置四项 + 其他） */\n  reasons?: string[];\n}\n\nexport interface MessageActionsEvents {\n  copy: [text?: string];\n  regenerate: [];\n  versionChange: [index: number];\n  /** kind=null 表示撤回反馈 */\n  feedback: [kind: FeedbackKind | null, reason?: string];\n}\n\nexport interface MessageTextProps {\n  /** 版本 key：变化时交叉淡入 */\n  version: string | number;\n}\n\nexport const DEFAULT_FEEDBACK_REASONS = [\"不够准确\", \"太啰嗦\", \"没听懂指令\"];\n"
    },
    {
      "path": "components/ui/message-actions/useMessageActions.ts",
      "type": "registry:ui",
      "target": "components/ui/message-actions/useMessageActions.ts",
      "content": "import { computed, onBeforeUnmount, ref, type Ref } from \"vue\";\nimport type { FeedbackKind, MessageActionsProps } from \"./types\";\nimport { DEFAULT_FEEDBACK_REASONS } from \"./types\";\n\n/**\n * VaMessageActions 的状态逻辑：复制 / 再生成 / 反馈（含原因面板）/ 版本切换。\n * version 由 SFC 的 defineModel 创建后传入（未绑定父层时组件内部自持）。\n */\nexport function useMessageActions(\n  props: MessageActionsProps,\n  version: Ref<number | undefined>,\n  emit: {\n    copy: (text?: string) => void;\n    regenerate: () => void;\n    versionChange: (index: number) => void;\n    feedback: (kind: FeedbackKind | null, reason?: string) => void;\n  },\n) {\n  /* ---------- 复制 ---------- */\n  const copied = ref(false);\n  let copiedTimer: number | undefined;\n  async function copy() {\n    const t = props.text ?? \"\";\n    try {\n      if (typeof navigator !== \"undefined\" && navigator.clipboard) {\n        await navigator.clipboard.writeText(t);\n      } else if (typeof document !== \"undefined\") {\n        const ta = document.createElement(\"textarea\");\n        ta.value = t;\n        document.body.appendChild(ta);\n        ta.select();\n        document.execCommand(\"copy\");\n        ta.remove();\n      }\n    } catch {\n      /* 剪贴板不可用时静默（宿主可监听 copy 事件自行提示） */\n    }\n    copied.value = true;\n    if (copiedTimer !== undefined) window.clearTimeout(copiedTimer);\n    copiedTimer = window.setTimeout(() => (copied.value = false), 1500);\n    emit.copy(t);\n  }\n  onBeforeUnmount(() => {\n    if (copiedTimer !== undefined) window.clearTimeout(copiedTimer);\n  });\n\n  /* ---------- 反馈 ---------- */\n  const chosen = ref<FeedbackKind | null>(null);\n  const panelOpen = ref(false);\n  const reasons = computed(() => props.reasons ?? DEFAULT_FEEDBACK_REASONS);\n  const customReason = ref(\"\");\n\n  function thumb(kind: FeedbackKind) {\n    if (kind === \"up\") {\n      chosen.value = chosen.value === \"up\" ? null : \"up\";\n      panelOpen.value = false;\n      emit.feedback(chosen.value);\n      return;\n    }\n    // down：首次打开原因面板，再点收起\n    if (panelOpen.value) {\n      panelOpen.value = false;\n      return;\n    }\n    chosen.value = \"down\";\n    panelOpen.value = true;\n    customReason.value = \"\";\n  }\n  function sendDown(reason: string) {\n    chosen.value = \"down\";\n    panelOpen.value = false;\n    emit.feedback(\"down\", reason || undefined);\n  }\n  function takeBack() {\n    chosen.value = null;\n    panelOpen.value = false;\n    emit.feedback(null);\n  }\n\n  /* ---------- 版本 ---------- */\n  const count = computed(() => (typeof props.versions === \"number\" ? Math.max(1, props.versions) : 1));\n  const showVersions = computed(() => count.value >= 2);\n  /** 未绑定（undefined）时视为\"跟随最新\" */\n  const effective = computed(() => {\n    const v = version.value;\n    if (v == null || v < 0 || v >= count.value) return count.value - 1;\n    return v;\n  });\n  function go(dir: -1 | 1) {\n    const next = Math.min(count.value - 1, Math.max(0, effective.value + dir));\n    version.value = next;\n    emit.versionChange(next);\n  }\n\n  return {\n    copied,\n    copy,\n    chosen,\n    panelOpen,\n    reasons,\n    customReason,\n    thumb,\n    sendDown,\n    takeBack,\n    count,\n    effective,\n    showVersions,\n    go,\n  };\n}\n"
    }
  ]
}
