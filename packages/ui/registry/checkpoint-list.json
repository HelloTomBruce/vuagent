{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "checkpoint-list",
  "title": "Checkpoint List",
  "description": "检查点/回滚时间线：每步快照摘要与相对时间、当前位标记、diff 预览入口、二次确认的一键恢复（3 秒武器化窗口）。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `checkpoints` (Checkpoint[]，默认 -)：id/label/createdAt/summary/current\n- `restoring` (string，默认 -)：恢复进行中的检查点 id\n- `@restore / @preview` (-，默认 -)：确认恢复 / 打开 diff 预览",
  "files": [
    {
      "path": "components/ui/checkpoint-list/VaCheckpointList.vue",
      "type": "registry:ui",
      "target": "components/ui/checkpoint-list/VaCheckpointList.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from \"vue\";\nimport type { CheckpointListEvents, CheckpointListProps } from \"./types\";\nimport type { Checkpoint } from \"./types\";\nimport { formatRelative, useConfirmArmed } from \"./useCheckpointList\";\nimport { useNow } from \"../../composables/useNow\";\n\nconst props = defineProps<CheckpointListProps>();\n\nconst emit = defineEmits<CheckpointListEvents>();\n\n// 列表非空时 30s 心跳刷新相对时间\nconst alive = computed(() => props.checkpoints.length > 0);\nconst now = useNow(30_000, alive);\nconst { armed, arm } = useConfirmArmed();\n\nconst timeOf = (c: Checkpoint) => (c.createdAt ? formatRelative(c.createdAt, now.value) : \"\");\n\nconst summaryOf = (c: Checkpoint) => {\n  if (c.summary) return c.summary;\n  const parts: string[] = [];\n  if (c.files) parts.push(`${c.files} 个文件`);\n  if (c.additions) parts.push(`+${c.additions}`);\n  if (c.deletions) parts.push(`−${c.deletions}`);\n  return parts.join(\" · \");\n};\n\n/** 恢复：首次点击进入确认态，3s 内再点才真正 emit */\nfunction onRestore(id: string) {\n  if (props.confirmLabel === \"\") {\n    emit(\"restore\", id);\n    return;\n  }\n  if (armed.value === id) {\n    arm(null);\n    emit(\"restore\", id);\n  } else {\n    arm(id);\n  }\n}\n</script>\n\n<template>\n  <div class=\"va-ckpt\">\n    <div\n      class=\"va-ckpt__list\"\n      :style=\"props.maxHeight ? { maxHeight: `${props.maxHeight}px` } : undefined\"\n    >\n      <p v-if=\"!props.checkpoints.length\" class=\"va-ckpt__empty\">还没有检查点。</p>\n      <div\n        v-for=\"c in props.checkpoints\"\n        :key=\"c.id\"\n        class=\"va-ckpt__item\"\n        :class=\"{ 'va-ckpt__item--current': c.current, 'va-ckpt__item--restoring': props.restoring === c.id }\"\n      >\n        <span class=\"va-ckpt__pin\" aria-hidden=\"true\" />\n        <div class=\"va-ckpt__main\">\n          <div class=\"va-ckpt__line\">\n            <span class=\"va-ckpt__label\">{{ c.label }}</span>\n            <span v-if=\"c.current\" class=\"va-ckpt__badge\">当前</span>\n          </div>\n          <div class=\"va-ckpt__meta\">\n            <span v-if=\"summaryOf(c)\" class=\"va-ckpt__sum\">{{ summaryOf(c) }}</span>\n            <span v-if=\"c.createdAt\" class=\"va-ckpt__time\">{{ timeOf(c) }}</span>\n          </div>\n        </div>\n        <div class=\"va-ckpt__ops\">\n          <button class=\"va-btn va-btn--sm va-ckpt__btn\" type=\"button\" @click=\"emit('preview', c.id)\">diff</button>\n          <button\n            v-if=\"!c.current\"\n            class=\"va-btn va-btn--sm va-ckpt__btn va-ckpt__btn--restore\"\n            type=\"button\"\n            :disabled=\"props.restoring !== undefined\"\n            :data-armed=\"armed === c.id\"\n            @click=\"onRestore(c.id)\"\n          >\n            <template v-if=\"props.restoring === c.id\">恢复中…</template>\n            <template v-else-if=\"armed === c.id\">{{ props.confirmLabel || \"确认恢复？\" }}</template>\n            <template v-else>恢复</template>\n          </button>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<style>\n/* VaCheckpointList — 检查点/回滚时间线 */\n\n.va-ckpt {\n  position: relative;\n}\n\n.va-ckpt__list {\n  overflow-y: auto;\n  position: relative;\n}\n\n/* 时间线竖线 */\n.va-ckpt__list::before {\n  content: \"\";\n  position: absolute;\n  left: 7px;\n  top: 14px;\n  bottom: 14px;\n  width: 2px;\n  background: var(--va-edge);\n  border-radius: 1px;\n}\n\n.va-ckpt__item {\n  position: relative;\n  display: flex;\n  align-items: center;\n  gap: var(--va-s4);\n  padding: var(--va-s3) var(--va-s3) var(--va-s3) 0;\n}\n\n.va-ckpt__pin {\n  flex: none;\n  width: 16px;\n  height: 16px;\n  border-radius: 50%;\n  border: 2px solid var(--va-edge-strong);\n  background: var(--va-card);\n  z-index: 1;\n  box-sizing: border-box;\n}\n\n.va-ckpt__item--current .va-ckpt__pin {\n  border-color: var(--va-accent);\n  background: var(--va-accent-soft);\n  box-shadow: 0 0 0 4px var(--va-accent-soft);\n}\n\n.va-ckpt__main { flex: 1; min-width: 0; }\n\n.va-ckpt__line {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3);\n}\n\n.va-ckpt__label {\n  font-size: 13.5px;\n  font-weight: 600;\n  color: var(--va-ink);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.va-ckpt__badge {\n  flex: none;\n  font-size: 11px;\n  padding: 1px 8px;\n  border-radius: var(--va-radius-pill);\n  background: var(--va-accent-soft);\n  color: var(--va-accent);\n  font-weight: 600;\n}\n\n.va-ckpt__meta {\n  display: flex;\n  gap: var(--va-s4);\n  margin-top: 2px;\n  font-size: 12px;\n  color: var(--va-muted);\n}\n\n.va-ckpt__sum { font-family: var(--va-font-mono); font-size: 11.5px; }\n.va-ckpt__time { font-variant-numeric: tabular-nums; }\n\n.va-ckpt__ops {\n  display: flex;\n  gap: var(--va-s2);\n  opacity: 0;\n  transition: opacity var(--va-dur-1) var(--va-ease);\n}\n\n.va-ckpt__item:hover .va-ckpt__ops,\n.va-ckpt__ops:focus-within,\n.va-ckpt__item--current .va-ckpt__ops { opacity: 1; }\n\n\n\n.va-ckpt__btn--restore { color: var(--va-accent); border-color: color-mix(in srgb, var(--va-accent) 35%, transparent); }\n.va-ckpt__btn--restore[data-armed=\"true\"] {\n  background: var(--va-accent);\n  border-color: var(--va-accent);\n  color: var(--va-card);\n}\n\n.va-ckpt__item--restoring \n.va-ckpt__empty {\n  margin: 0;\n  padding: var(--va-s4);\n  font-size: 13px;\n  color: var(--va-muted);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-ckpt__ops { transition: none; }\n}\n\n/* 按钮基类（自动附带） */\n/* ============================================================\n   按钮基类 —— 全库动作按钮的单一样式来源。\n   组件叠加使用：class=\"va-btn va-btn--primary va-xxx__submit\"，\n   组件自己的 CSS 只写布局/色彩覆盖（width、pill 圆角等）。\n   registry 生成器会把本文件自动内联进用了 va-btn 的组件拷贝。\n   ============================================================ */\n\n.va-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-card);\n  color: var(--va-ink-2);\n  font: inherit;\n  font-size: 13px;\n  line-height: 1.4;\n  padding: 5px 14px;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: border-color var(--va-dur-1) var(--va-ease), background var(--va-dur-1) var(--va-ease),\n    color var(--va-dur-1) var(--va-ease);\n}\n\n.va-btn:hover:not(:disabled) { border-color: var(--va-edge-strong); }\n\n.va-btn:focus-visible { outline: 2px solid var(--va-accent); outline-offset: 1px; }\n\n.va-btn:disabled { opacity: 0.45; cursor: default; }\n\n/* 尺寸 */\n.va-btn--sm { font-size: 12px; padding: 3px 10px; }\n.va-btn--lg { font-size: 14px; padding: 7px 18px; }\n\n/* 变体 */\n.va-btn--primary {\n  background: var(--va-accent);\n  border-color: var(--va-accent);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-btn--primary:hover:not(:disabled) {\n  background: var(--va-accent-hover);\n  border-color: var(--va-accent-hover);\n}\n\n.va-btn--ghost {\n  border-color: transparent;\n  background: transparent;\n}\n\n.va-btn--ghost:hover:not(:disabled) { background: var(--va-bg-subtle); }\n\n.va-btn--danger { border-color: transparent; background: transparent; color: var(--va-danger); }\n\n.va-btn--danger:hover:not(:disabled) {\n  background: color-mix(in srgb, var(--va-danger) 10%, transparent);\n  border-color: transparent;\n}\n\n/* 语义色实底（成功/危险确认场景，按需叠加） */\n.va-btn--success {\n  background: var(--va-success);\n  border-color: var(--va-success);\n  color: #fff;\n  font-weight: 600;\n}\n\n/* 墨色实底：审批/决策/应用这类\"终审\"主操作（区别于 accent 常规主操作） */\n.va-btn--ink {\n  background: var(--va-ink);\n  border-color: var(--va-ink);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-btn--ink:hover:not(:disabled) { opacity: 0.88; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-btn { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/checkpoint-list/types.ts",
      "type": "registry:ui",
      "target": "components/ui/checkpoint-list/types.ts",
      "content": "/** VaCheckpointList 的类型定义 */\n\nexport interface Checkpoint {\n  id: string;\n  /** 检查点名称，如\"安装依赖后\" */\n  label: string;\n  /** 创建时间（ms 时间戳） */\n  createdAt?: number;\n  /** 变更摘要，如 \"3 个文件 · +12 −4\"；不传则用 files/additions/deletions 合成 */\n  summary?: string;\n  files?: number;\n  additions?: number;\n  deletions?: number;\n  /** 该检查点是否为当前所在位置 */\n  current?: boolean;\n}\n\nexport interface CheckpointListProps {\n  checkpoints: Checkpoint[];\n  /** 正在恢复的检查点 id（对应项显示进行态）；新→旧排列由宿主决定 */\n  restoring?: string;\n  /** 恢复按钮的二次确认文案；空字符串关闭确认 */\n  confirmLabel?: string;\n  /** 内容区最大高度 px，超出滚动 */\n  maxHeight?: number;\n}\n\nexport interface CheckpointListEvents {\n  /** 点击恢复（携带检查点 id） */\n  restore: [id: string];\n  /** 点击 diff 预览 */\n  preview: [id: string];\n}\n"
    },
    {
      "path": "components/ui/checkpoint-list/useCheckpointList.ts",
      "type": "registry:ui",
      "target": "components/ui/checkpoint-list/useCheckpointList.ts",
      "content": "import { ref } from \"vue\";\n\n/** 相对时间：刚刚 / N 分钟前 / 今天 HH:mm / 昨天 HH:mm / M-D HH:mm（无 Intl 依赖） */\nexport function formatRelative(ts: number, now = Date.now()): string {\n  const diff = Math.max(0, now - ts);\n  const min = Math.floor(diff / 60_000);\n  if (min < 1) return \"刚刚\";\n  if (min < 60) return `${min} 分钟前`;\n  const d = new Date(ts);\n  const hm = `${String(d.getHours()).padStart(2, \"0\")}:${String(d.getMinutes()).padStart(2, \"0\")}`;\n  const today = new Date(now);\n  const yesterday = new Date(now - 86_400_000);\n  if (d.toDateString() === today.toDateString()) return `今天 ${hm}`;\n  if (d.toDateString() === yesterday.toDateString()) return `昨天 ${hm}`;\n  return `${d.getMonth() + 1}-${d.getDate()} ${hm}`;\n}\n\n/** 恢复按钮的二次确认（防误触）：armed = 已进入确认态的检查点 id */\nexport function useConfirmArmed() {\n  const armed = ref<string | null>(null);\n  let timer: number | undefined;\n\n  function arm(id: string | null) {\n    armed.value = id;\n    if (timer !== undefined) window.clearTimeout(timer);\n    if (id !== null) timer = window.setTimeout(() => (armed.value = null), 3000);\n  }\n\n  return { armed, arm };\n}\n"
    }
  ]
}
