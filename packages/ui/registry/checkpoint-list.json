{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "checkpoint-list",
  "title": "Checkpoint List",
  "description": "检查点/回滚时间线：每步快照摘要与相对时间、当前位标记、diff 预览入口、二次确认的一键恢复（3 秒武器化窗口）。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `checkpoints` (Checkpoint[]，默认 -)：id/label/createdAt/summary/current\n- `restoring` (string，默认 -)：恢复进行中的检查点 id\n- `@restore / @preview` (-，默认 -)：确认恢复 / 打开 diff 预览",
  "files": [
    {
      "path": "components/ui/checkpoint-list/VaCheckpointList.vue",
      "type": "registry:ui",
      "target": "components/ui/checkpoint-list/VaCheckpointList.vue",
      "content": "<script setup lang=\"ts\">import { computed, onBeforeUnmount, ref, watch, type Ref } from \"vue\";\n\nimport type { CheckpointListEvents, CheckpointListProps } from \"./types\";\nimport type { Checkpoint } from \"./types\";\nimport { formatRelative, useConfirmArmed } from \"./useCheckpointList\";\n\n\nconst props = defineProps<CheckpointListProps>();\n\nconst emit = defineEmits<CheckpointListEvents>();\n\n// 列表非空时 30s 心跳刷新相对时间\nconst alive = computed(() => props.checkpoints.length > 0);\nconst now = useNow(30_000, alive);\nconst { armed, arm } = useConfirmArmed();\n\nconst timeOf = (c: Checkpoint) => (c.createdAt ? formatRelative(c.createdAt, now.value) : \"\");\n\nconst summaryOf = (c: Checkpoint) => {\n  if (c.summary) return c.summary;\n  const parts: string[] = [];\n  if (c.files) parts.push(`${c.files} 个文件`);\n  if (c.additions) parts.push(`+${c.additions}`);\n  if (c.deletions) parts.push(`−${c.deletions}`);\n  return parts.join(\" · \");\n};\n\n/** 恢复：首次点击进入确认态，3s 内再点才真正 emit */\nfunction onRestore(id: string) {\n  if (props.confirmLabel === \"\") {\n    emit(\"restore\", id);\n    return;\n  }\n  if (armed.value === id) {\n    arm(null);\n    emit(\"restore\", id);\n  } else {\n    arm(id);\n  }\n}\n\n/* ── 内联自 @vuagent/ui src/composables/useNow.ts（registry 单文件拷贝自包含） ── */\n/**\n * 共享实时时钟：enabled 为 true 期间按 interval 更新 now（ms 时间戳）。\n * 供工具卡计时、计划计时、收件箱时钟等场景复用；SSR 安全。\n */\nfunction useNow(intervalMs: number, enabled: Ref<boolean>): Readonly<Ref<number>> {\n  const now = ref(Date.now());\n  let timer: number | undefined;\n\n  function start() {\n    if (timer !== undefined || typeof window === \"undefined\") return;\n    now.value = Date.now();\n    timer = window.setInterval(() => (now.value = Date.now()), intervalMs);\n  }\n  function stop() {\n    if (timer !== undefined) {\n      window.clearInterval(timer);\n      timer = undefined;\n    }\n  }\n\n  watch(enabled, (v) => (v ? start() : stop()), { immediate: true });\n  onBeforeUnmount(stop);\n\n  return now as Readonly<Ref<number>>;\n}\n</script>\n\n<template>\n  <div class=\"va-ckpt\">\n    <div\n      class=\"va-ckpt__list\"\n      :style=\"props.maxHeight ? { maxHeight: `${props.maxHeight}px` } : undefined\"\n    >\n      <p v-if=\"!props.checkpoints.length\" class=\"va-ckpt__empty\">还没有检查点。</p>\n      <div\n        v-for=\"c in props.checkpoints\"\n        :key=\"c.id\"\n        class=\"va-ckpt__item\"\n        :class=\"{ 'va-ckpt__item--current': c.current, 'va-ckpt__item--restoring': props.restoring === c.id }\"\n      >\n        <span class=\"va-ckpt__pin\" aria-hidden=\"true\" />\n        <div class=\"va-ckpt__main\">\n          <div class=\"va-ckpt__line\">\n            <span class=\"va-ckpt__label\">{{ c.label }}</span>\n            <span v-if=\"c.current\" class=\"va-ckpt__badge\">当前</span>\n          </div>\n          <div class=\"va-ckpt__meta\">\n            <span v-if=\"summaryOf(c)\" class=\"va-ckpt__sum\">{{ summaryOf(c) }}</span>\n            <span v-if=\"c.createdAt\" class=\"va-ckpt__time\">{{ timeOf(c) }}</span>\n          </div>\n        </div>\n        <div class=\"va-ckpt__ops\">\n          <button class=\"va-act va-act--sm va-ckpt__btn\" type=\"button\" @click=\"emit('preview', c.id)\">diff</button>\n          <button\n            v-if=\"!c.current\"\n            class=\"va-act va-act--sm va-ckpt__btn va-ckpt__btn--restore\"\n            type=\"button\"\n            :disabled=\"props.restoring !== undefined\"\n            :data-armed=\"armed === c.id\"\n            @click=\"onRestore(c.id)\"\n          >\n            <template v-if=\"props.restoring === c.id\">恢复中…</template>\n            <template v-else-if=\"armed === c.id\">{{ props.confirmLabel || \"确认恢复？\" }}</template>\n            <template v-else>恢复</template>\n          </button>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<style>\n/* VaCheckpointList — 检查点/回滚时间线 */\n\n.va-ckpt {\n  position: relative;\n}\n\n.va-ckpt__list {\n  overflow-y: auto;\n  position: relative;\n}\n\n/* 时间线竖线 */\n.va-ckpt__list::before {\n  content: \"\";\n  position: absolute;\n  left: 7px;\n  top: 14px;\n  bottom: 14px;\n  width: 2px;\n  background: var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: 1px;\n}\n\n.va-ckpt__item {\n  position: relative;\n  display: flex;\n  align-items: center;\n  gap: var(--va-s4, 12px);\n  padding: var(--va-s3, 8px) var(--va-s3, 8px) var(--va-s3, 8px) 0;\n}\n\n.va-ckpt__pin {\n  flex: none;\n  width: 16px;\n  height: 16px;\n  border-radius: 50%;\n  border: 2px solid var(--va-edge-strong, rgba(26, 25, 23, 0.22));\n  background: var(--va-card, #ffffff);\n  z-index: 1;\n  box-sizing: border-box;\n}\n\n.va-ckpt__item--current .va-ckpt__pin {\n  border-color: var(--va-accent, #c2410c);\n  background: var(--va-accent-soft, rgba(194, 65, 12, 0.1));\n  box-shadow: 0 0 0 4px var(--va-accent-soft, rgba(194, 65, 12, 0.1));\n}\n\n.va-ckpt__main { flex: 1; min-width: 0; }\n\n.va-ckpt__line {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3, 8px);\n}\n\n.va-ckpt__label {\n  font-size: var(--va-fs-lg, 14px);\n  font-weight: var(--va-fw-semibold, 600);\n  color: var(--va-ink, #1a1917);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.va-ckpt__badge {\n  flex: none;\n  font-size: var(--va-fs-xs, 11px);\n  padding: 1px 8px;\n  border-radius: var(--va-radius-pill, 999px);\n  background: var(--va-accent-soft, rgba(194, 65, 12, 0.1));\n  color: var(--va-accent, #c2410c);\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n.va-ckpt__meta {\n  display: flex;\n  gap: var(--va-s4, 12px);\n  margin-top: 2px;\n  font-size: var(--va-fs-sm, 12px);\n  color: var(--va-muted, #6f6d66);\n}\n\n.va-ckpt__sum { font-family: var(--va-font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace); font-size: var(--va-fs-xs, 11px); }\n.va-ckpt__time { font-variant-numeric: tabular-nums; }\n\n.va-ckpt__ops {\n  display: flex;\n  gap: var(--va-s2, 4px);\n  opacity: 0;\n  transition: opacity var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-ckpt__item:hover .va-ckpt__ops,\n.va-ckpt__ops:focus-within,\n.va-ckpt__item--current .va-ckpt__ops { opacity: 1; }\n\n\n\n.va-ckpt__btn--restore { color: var(--va-accent, #c2410c); border-color: color-mix(in srgb, var(--va-accent, #c2410c) 35%, transparent); }\n.va-ckpt__btn--restore[data-armed=\"true\"] {\n  background: var(--va-accent, #c2410c);\n  border-color: var(--va-accent, #c2410c);\n  color: var(--va-card, #ffffff);\n}\n\n.va-ckpt__item--restoring \n.va-ckpt__empty {\n  margin: 0;\n  padding: var(--va-s4, 12px);\n  font-size: var(--va-fs-md, 13px);\n  color: var(--va-muted, #6f6d66);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-ckpt__ops { transition: none; }\n}\n\n/* 按钮基类（自动附带） */\n/* ============================================================\n   按钮基类 —— 全库动作按钮的单一样式来源。\n   组件叠加使用：class=\"va-act va-act--primary va-xxx__submit\"，\n   组件自己的 CSS 只写布局/色彩覆盖（width、pill 圆角等）。\n   registry 生成器会把本文件自动内联进用了 va-act 的组件拷贝。\n   ============================================================ */\n\n.va-act {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--va-s3h, 6px);\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-s, 8px);\n  background: var(--va-card, #ffffff);\n  color: var(--va-ink-2, #43413c);\n  font: inherit;\n  font-size: var(--va-fs-md, 13px);\n  line-height: 1.4;\n  padding: 5px 14px;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: border-color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), background var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-act:hover:not(:disabled) { border-color: var(--va-edge-strong, rgba(26, 25, 23, 0.22)); }\n\n.va-act:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: 1px; }\n\n.va-act:disabled { opacity: 0.45; cursor: default; }\n\n/* 尺寸 */\n.va-act--sm { font-size: var(--va-fs-sm, 12px); padding: 3px var(--va-s4h, 10px); }\n.va-act--lg { font-size: var(--va-fs-lg, 14px); padding: 7px 18px; }\n\n/* 变体 */\n.va-act--primary {\n  background: var(--va-accent, #c2410c);\n  border-color: var(--va-accent, #c2410c);\n  color: var(--va-card, #ffffff);\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n.va-act--primary:hover:not(:disabled) {\n  background: var(--va-accent-hover, #9a3412);\n  border-color: var(--va-accent-hover, #9a3412);\n}\n\n.va-act--ghost {\n  border-color: transparent;\n  background: transparent;\n}\n\n.va-act--ghost:hover:not(:disabled) { background: var(--va-bg-subtle, #efede7); }\n\n.va-act--danger { border-color: transparent; background: transparent; color: var(--va-danger, #d5453c); }\n\n.va-act--danger:hover:not(:disabled) {\n  background: color-mix(in srgb, var(--va-danger, #d5453c) 10%, transparent);\n  border-color: transparent;\n}\n\n/* 语义色实底（成功/危险确认场景，按需叠加） */\n.va-act--success {\n  background: var(--va-success, #1a7f4b);\n  border-color: var(--va-success, #1a7f4b);\n  color: #fff;\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n/* 墨色实底：审批/决策/应用这类\"终审\"主操作（区别于 accent 常规主操作） */\n.va-act--ink {\n  background: var(--va-ink, #1a1917);\n  border-color: var(--va-ink, #1a1917);\n  color: var(--va-card, #ffffff);\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n.va-act--ink:hover:not(:disabled) { opacity: 0.88; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-act { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/checkpoint-list/index.ts",
      "type": "registry:ui",
      "target": "components/ui/checkpoint-list/index.ts",
      "content": "export { default as VaCheckpointList } from \"./VaCheckpointList.vue\";\nexport { formatRelative } from \"./useCheckpointList\";\nexport type { Checkpoint, CheckpointListEvents, CheckpointListProps } from \"./types\";\n"
    },
    {
      "path": "components/ui/checkpoint-list/types.ts",
      "type": "registry:ui",
      "target": "components/ui/checkpoint-list/types.ts",
      "content": "/** VaCheckpointList 的类型定义 */\n\nexport interface Checkpoint {\n  id: string;\n  /** 检查点名称，如\"安装依赖后\" */\n  label: string;\n  /** 创建时间（ms 时间戳） */\n  createdAt?: number;\n  /** 变更摘要，如 \"3 个文件 · +12 −4\"；不传则用 files/additions/deletions 合成 */\n  summary?: string;\n  files?: number;\n  additions?: number;\n  deletions?: number;\n  /** 该检查点是否为当前所在位置 */\n  current?: boolean;\n}\n\nexport interface CheckpointListProps {\n  checkpoints: Checkpoint[];\n  /** 正在恢复的检查点 id（对应项显示进行态）；新→旧排列由宿主决定 */\n  restoring?: string;\n  /** 恢复按钮的二次确认文案；空字符串关闭确认 */\n  confirmLabel?: string;\n  /** 内容区最大高度 px，超出滚动 */\n  maxHeight?: number;\n}\n\nexport interface CheckpointListEvents {\n  /** 点击恢复（携带检查点 id） */\n  restore: [id: string];\n  /** 点击 diff 预览 */\n  preview: [id: string];\n}\n"
    },
    {
      "path": "components/ui/checkpoint-list/useCheckpointList.ts",
      "type": "registry:ui",
      "target": "components/ui/checkpoint-list/useCheckpointList.ts",
      "content": "import { ref } from \"vue\";\n\n/** 相对时间：刚刚 / N 分钟前 / 今天 HH:mm / 昨天 HH:mm / M-D HH:mm（无 Intl 依赖） */\nexport function formatRelative(ts: number, now = Date.now()): string {\n  const diff = Math.max(0, now - ts);\n  const min = Math.floor(diff / 60_000);\n  if (min < 1) return \"刚刚\";\n  if (min < 60) return `${min} 分钟前`;\n  const d = new Date(ts);\n  const hm = `${String(d.getHours()).padStart(2, \"0\")}:${String(d.getMinutes()).padStart(2, \"0\")}`;\n  const today = new Date(now);\n  const yesterday = new Date(now - 86_400_000);\n  if (d.toDateString() === today.toDateString()) return `今天 ${hm}`;\n  if (d.toDateString() === yesterday.toDateString()) return `昨天 ${hm}`;\n  return `${d.getMonth() + 1}-${d.getDate()} ${hm}`;\n}\n\n/** 恢复按钮的二次确认（防误触）：armed = 已进入确认态的检查点 id */\nexport function useConfirmArmed() {\n  const armed = ref<string | null>(null);\n  let timer: number | undefined;\n\n  function arm(id: string | null) {\n    armed.value = id;\n    if (timer !== undefined) window.clearTimeout(timer);\n    if (id !== null) timer = window.setTimeout(() => (armed.value = null), 3000);\n  }\n\n  return { armed, arm };\n}\n"
    }
  ]
}
