{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "model-picker",
  "title": "Model Picker",
  "description": "模型选择菜单：触发按钮 + 键盘可导航的下拉列表。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `models` (ModelItem[]，默认 内置主流模型)：id/name/tag\n- `v-model:selected` (string，默认 -)：选中模型 id",
  "files": [
    {
      "path": "components/ui/model-picker/VaModelPicker.vue",
      "type": "registry:ui",
      "target": "components/ui/model-picker/VaModelPicker.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, useTemplateRef } from \"vue\";\nimport type { ModelItem, ModelPickerProps } from \"./types\";\nimport { useModelPicker } from \"./useModelPicker\";\n\nconst props = withDefaults(defineProps<ModelPickerProps>(), {\n  models: undefined,\n  align: \"left\",\n  ariaLabel: \"选择模型\",\n});\n\nconst selected = defineModel<string>(\"selected\", { default: \"\" });\n\nconst root = useTemplateRef<HTMLElement>(\"root\");\nconst { models, open, activeIdx, current, onTriggerClick, pick, onKeydown } = useModelPicker(props, selected, root);\n\ninterface ModelPickerGroup {\n  provider: string;\n  items: Array<{\n    model: ModelItem;\n    flatIndex: number;\n  }>;\n}\n\n/** 按 Provider 组织分组（一个 Provider 下会有多个模型） */\nconst groups = computed<ModelPickerGroup[]>(() => {\n  const result: ModelPickerGroup[] = [];\n  const map = new Map<string, ModelPickerGroup>();\n\n  models.value.forEach((m, idx) => {\n    let prov = (m.provider || \"\").trim();\n    if (!prov && m.tag && m.tag.includes(\"·\")) {\n      prov = m.tag.split(\"·\")[0].trim();\n    }\n    const groupKey = prov || \"默认\";\n\n    let grp = map.get(groupKey);\n    if (!grp) {\n      grp = { provider: groupKey, items: [] };\n      map.set(groupKey, grp);\n      result.push(grp);\n    }\n    grp.items.push({ model: m, flatIndex: idx });\n  });\n\n  return result;\n});\n\n/** 判定是否启用分组展示 */\nconst hasGroups = computed(() => {\n  return groups.value.length > 1 || (groups.value.length === 1 && groups.value[0].provider !== \"默认\");\n});\n\n/** 计算右侧展示标签（展示真实模型标识） */\nfunction displayTag(m: ModelItem, grouped: boolean): string {\n  const tag = m.model || (grouped && m.tag?.includes(\"·\") ? m.tag.split(\"·\").slice(1).join(\"·\").trim() : m.tag) || \"\";\n  if (tag === m.name) return \"\";\n  return tag;\n}\n</script>\n\n<template>\n  <div ref=\"root\" class=\"va-mpk\" @keydown=\"onKeydown\">\n    <!-- 自定义触发器（宿主注入座位样式等）；slot props: { current, open, toggle } -->\n    <slot name=\"trigger\" :current=\"current\" :open=\"open\" :toggle=\"onTriggerClick\">\n      <button\n        class=\"va-mpk__btn\"\n        type=\"button\"\n        :aria-expanded=\"open\"\n        :aria-label=\"props.ariaLabel\"\n        @click=\"onTriggerClick\"\n      >\n        {{ current?.name ?? \"选择模型\" }}\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\">\n          <path d=\"m7 9.5 5 5 5-5\" />\n        </svg>\n      </button>\n    </slot>\n\n    <Transition name=\"va-mpk\">\n      <div v-if=\"open\" class=\"va-mpk__menu\" :class=\"`va-mpk__menu--${props.align}`\" role=\"listbox\">\n        <!-- 分组展示形态（按 Provider 聚类，一个 Provider 下支持多个模型） -->\n        <template v-if=\"hasGroups\">\n          <div v-for=\"g in groups\" :key=\"g.provider\" class=\"va-mpk__group\">\n            <div class=\"va-mpk__group-header\">\n              <span class=\"va-mpk__group-title\">{{ g.provider }}</span>\n              <span class=\"va-mpk__group-count\">{{ g.items.length }}</span>\n            </div>\n            <ul class=\"va-mpk__list\" role=\"group\" :aria-label=\"g.provider\">\n              <li v-for=\"item in g.items\" :key=\"item.model.id\">\n                <button\n                  class=\"va-mpk__item\"\n                  :class=\"{\n                    'va-mpk__item--active': item.flatIndex === activeIdx,\n                    'va-mpk__item--selected': item.model.id === selected,\n                  }\"\n                  type=\"button\"\n                  role=\"option\"\n                  :aria-selected=\"item.model.id === selected\"\n                  @mouseenter=\"activeIdx = item.flatIndex\"\n                  @click=\"pick(item.model)\"\n                >\n                  <span class=\"va-mpk__check\" aria-hidden=\"true\">\n                    <svg v-if=\"item.model.id === selected\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\">\n                      <path d=\"M5.5 12.5l4 4L18.5 8\" />\n                    </svg>\n                  </span>\n                  <span class=\"va-mpk__name\" :title=\"item.model.name\">{{ item.model.name }}</span>\n                  <span\n                    v-if=\"displayTag(item.model, true)\"\n                    class=\"va-mpk__tag\"\n                    :title=\"item.model.tag || item.model.model\"\n                  >\n                    {{ displayTag(item.model, true) }}\n                  </span>\n                </button>\n              </li>\n            </ul>\n          </div>\n        </template>\n\n        <!-- 扁平无 Provider 时的回退单列表展示 -->\n        <template v-else>\n          <ul class=\"va-mpk__list\" role=\"listbox\">\n            <li v-for=\"(m, i) in models\" :key=\"m.id\">\n              <button\n                class=\"va-mpk__item\"\n                :class=\"{ 'va-mpk__item--active': i === activeIdx, 'va-mpk__item--selected': m.id === selected }\"\n                type=\"button\"\n                role=\"option\"\n                :aria-selected=\"m.id === selected\"\n                @mouseenter=\"activeIdx = i\"\n                @click=\"pick(m)\"\n              >\n                <span class=\"va-mpk__check\" aria-hidden=\"true\">\n                  <svg v-if=\"m.id === selected\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\">\n                    <path d=\"M5.5 12.5l4 4L18.5 8\" />\n                  </svg>\n                </span>\n                <span class=\"va-mpk__name\" :title=\"m.name\">{{ m.name }}</span>\n                <span v-if=\"displayTag(m, false)\" class=\"va-mpk__tag\" :title=\"m.tag || m.model\">\n                  {{ displayTag(m, false) }}\n                </span>\n              </button>\n            </li>\n          </ul>\n        </template>\n      </div>\n    </Transition>\n  </div>\n</template>\n\n<style>\n/* VaModelPicker — 模型选择菜单 */\n.va-mpk {\n  position: relative;\n  display: inline-flex;\n  font-family: var(--va-font, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Helvetica Neue\", sans-serif);\n}\n\n.va-mpk__btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  height: 26px;\n  padding: 0 var(--va-s3, 8px);\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-pill, 999px);\n  background: var(--va-card, #ffffff);\n  color: var(--va-ink-2, #43413c);\n  font-size: var(--va-fs-sm, 12px);\n  cursor: pointer;\n  font-family: inherit;\n  transition: border-color var(--va-dur-1, 120ms) ease;\n}\n.va-mpk__btn:hover { border-color: var(--va-edge-strong, rgba(26, 25, 23, 0.22)); }\n.va-mpk__btn:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: 1px; }\n.va-mpk__btn svg { width: 12px; height: 12px; color: var(--va-muted, #6f6d66); }\n\n.va-mpk__menu {\n  position: absolute;\n  bottom: calc(100% + 6px);\n  left: 0;\n  margin: 0;\n  padding: 6px 0;\n  min-width: 280px;\n  max-width: 380px;\n  max-height: 340px;\n  overflow-y: auto;\n  overscroll-behavior: contain;\n  background: var(--va-card, #ffffff);\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-m, 10px);\n  box-shadow: var(--va-shadow-2, 0 4px 12px rgba(26, 25, 23, 0.08));\n  z-index: 50;\n  scrollbar-width: thin;\n}\n.va-mpk__menu--right { left: auto; right: 0; }\n\n.va-mpk__group {\n  display: flex;\n  flex-direction: column;\n}\n.va-mpk__group:not(:first-child) {\n  border-top: 1px solid var(--va-edge-subtle, rgba(26, 25, 23, 0.08));\n  margin-top: 4px;\n  padding-top: 4px;\n}\n\n.va-mpk__group-header {\n  padding: 5px 10px 3px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n.va-mpk__group-title {\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0.02em;\n  color: var(--va-muted, #6f6d66);\n}\n.va-mpk__group-count {\n  font-size: 10px;\n  font-family: var(--va-font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);\n  color: var(--va-ink-tertiary, #8a8580);\n  background: var(--va-bg-subtle, #efede7);\n  padding: 0 5px;\n  border-radius: 999px;\n  line-height: 16px;\n}\n\n.va-mpk__list {\n  margin: 0;\n  padding: 0 4px;\n  list-style: none;\n  display: flex;\n  flex-direction: column;\n  gap: 1px;\n}\n\n.va-mpk__item {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  width: 100%;\n  height: 32px;\n  padding: 0 8px;\n  border: 0;\n  border-radius: var(--va-radius-s, 8px);\n  background: none;\n  color: var(--va-ink, #1a1917);\n  cursor: pointer;\n  font-family: inherit;\n  text-align: left;\n  white-space: nowrap;\n  box-sizing: border-box;\n  transition: background var(--va-dur-1, 120ms) ease;\n}\n.va-mpk__item--active { background: var(--va-bg-subtle, #efede7); }\n.va-mpk__item--selected {\n  font-weight: 500;\n}\n.va-mpk__item:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: -2px; }\n\n.va-mpk__check {\n  flex: none;\n  width: 14px;\n  height: 14px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--va-accent, #c2410c);\n}\n.va-mpk__check svg { width: 14px; height: 14px; }\n\n.va-mpk__name {\n  flex: 1;\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-size: var(--va-fs-md, 13px);\n}\n\n.va-mpk__tag {\n  margin-left: auto;\n  flex-shrink: 0;\n  max-width: 150px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-size: 11px;\n  font-family: var(--va-font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);\n  color: var(--va-ink-tertiary, #6f6d66);\n  background: var(--va-bg-subtle, #efede7);\n  border-radius: 4px;\n  padding: 1px 6px;\n}\n.va-mpk__item--selected .va-mpk__tag {\n  color: var(--va-accent, #c2410c);\n  background: var(--va-accent-soft, rgba(194, 65, 12, 0.1));\n}\n\n.va-mpk-enter-active, .va-mpk-leave-active {\n  transition: opacity var(--va-dur-1, 120ms) ease, transform var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n.va-mpk-enter-from, .va-mpk-leave-to {\n  opacity: 0;\n  transform: translateY(3px);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-mpk-enter-active, .va-mpk-leave-active { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/model-picker/index.ts",
      "type": "registry:ui",
      "target": "components/ui/model-picker/index.ts",
      "content": "export { default as VaModelPicker } from \"./VaModelPicker.vue\";\nexport { DEFAULT_MODELS } from \"./useModelPicker\";\nexport type { ModelItem, ModelPickerEvents, ModelPickerProps } from \"./types\";\n"
    },
    {
      "path": "components/ui/model-picker/types.ts",
      "type": "registry:ui",
      "target": "components/ui/model-picker/types.ts",
      "content": "/** VaModelPicker 的类型定义 */\n\nexport interface ModelItem {\n  id: string;\n  name: string;\n  /** 右侧小标签，如 \"推荐\" / \"快\" */\n  tag?: string;\n  /** 所属供应商标识（如 \"DEEPSEEK\", \"OPENAI\"），提供后自动启用 Provider 分组展示 */\n  provider?: string;\n  /** 真实底层模型标识（如 \"deepseek-chat\", \"gpt-4o\"） */\n  model?: string;\n}\n\nexport interface ModelPickerProps {\n  models?: ModelItem[];\n  /** 菜单对齐方向 */\n  align?: \"left\" | \"right\";\n  ariaLabel?: string;\n}\n\nexport interface ModelPickerEvents {\n  \"update:selected\": [id: string];\n}\n"
    },
    {
      "path": "components/ui/model-picker/useModelPicker.ts",
      "type": "registry:ui",
      "target": "components/ui/model-picker/useModelPicker.ts",
      "content": "import { computed, onBeforeUnmount, onMounted, ref, type Ref } from \"vue\";\nimport type { ModelItem, ModelPickerProps } from \"./types\";\n\nexport const DEFAULT_MODELS: ModelItem[] = [\n  { id: \"claude\", name: \"Claude\", tag: \"推荐\" },\n  { id: \"gpt\", name: \"GPT\" },\n  { id: \"gemini\", name: \"Gemini\" },\n  { id: \"deepseek\", name: \"DeepSeek\" },\n  { id: \"qwen\", name: \"Qwen\" },\n];\n\n/** VaModelPicker 的状态逻辑：开合、点外关闭、上下键导航、Enter 选中。root 由 SFC 传入 */\nexport function useModelPicker(props: ModelPickerProps, selected: Ref<string>, root: Ref<HTMLElement | null>) {\n  const models = computed(() => (props.models?.length ? props.models : DEFAULT_MODELS));\n  const open = ref(false);\n  const activeIdx = ref(0);\n\n  const current = computed(() => models.value.find((m) => m.id === selected.value) ?? models.value[0]);\n\n  function onOutside(e: Event) {\n    const el = root.value;\n    if (el && !el.contains(e.target as Node)) closeMenu();\n  }\n\n  function openMenu() {\n    open.value = true;\n    activeIdx.value = Math.max(0, models.value.findIndex((m) => m.id === selected.value));\n    if (typeof document !== \"undefined\") {\n      document.addEventListener(\"pointerdown\", onOutside, true);\n    }\n  }\n  function closeMenu() {\n    open.value = false;\n    if (typeof document !== \"undefined\") {\n      document.removeEventListener(\"pointerdown\", onOutside, true);\n    }\n  }\n  function toggle() {\n    open.value ? closeMenu() : openMenu();\n  }\n\n  /** 触发按钮的 click：键盘 Enter/Space 合成的 click（detail===0）已由 onKeydown 处理，跳过避免\"关了又开\" */\n  function onTriggerClick(e: MouseEvent) {\n    if (e.detail === 0) return;\n    toggle();\n  }\n\n  function pick(m: ModelItem) {\n    selected.value = m.id;\n    closeMenu();\n  }\n\n  function onKeydown(e: KeyboardEvent) {\n    if (e.key === \"Escape\") {\n      e.preventDefault();\n      closeMenu();\n      return;\n    }\n    if (!open.value) return;\n    if (e.key === \"ArrowDown\" || e.key === \"ArrowUp\") {\n      e.preventDefault();\n      const dir = e.key === \"ArrowDown\" ? 1 : -1;\n      activeIdx.value = (activeIdx.value + dir + models.value.length) % models.value.length;\n    } else if (e.key === \"Enter\") {\n      e.preventDefault();\n      const m = models.value[activeIdx.value];\n      if (m) pick(m);\n    }\n  }\n\n  onMounted(() => {\n    // 卫语句：selected 不在列表里时回落到第一个\n    if (!models.value.some((m) => m.id === selected.value)) {\n      selected.value = models.value[0]?.id ?? \"\";\n    }\n  });\n  onBeforeUnmount(closeMenu);\n\n  return { models, open, activeIdx, current, toggle, onTriggerClick, closeMenu, pick, onKeydown };\n}\n"
    }
  ]
}
