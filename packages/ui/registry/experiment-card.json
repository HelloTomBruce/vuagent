{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "experiment-card",
  "title": "Experiment Card",
  "description": "A/B 实验对比卡：变体并列（胜者描边 + ✓）、置信度条与结论（未达显著给「继续观察」）、running 态实时时长 + 结束/重开。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `variants` (ExperimentVariant[]，默认 -)：id/name/value/format/delta/winner\n- `metric / status` (string / \"running\"|\"success\"|\"error\"，默认 - / \"running\")：对比指标与状态\n- `confidence / confidenceThreshold` (number / number，默认 - / 0.95)：置信度与显著阈值\n- `@stop / @reopen` (-，默认 -)：结束 / 重新开始",
  "files": [
    {
      "path": "components/ui/experiment-card/VaExperimentCard.vue",
      "type": "registry:ui",
      "target": "components/ui/experiment-card/VaExperimentCard.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from \"vue\";\nimport type { ExperimentCardEvents, ExperimentCardProps } from \"./types\";\nimport { useNow } from \"../../composables/useNow\";\n\nconst props = defineProps<ExperimentCardProps>();\n\nconst emit = defineEmits<ExperimentCardEvents>();\n\nconst running = computed(() => props.status === \"running\" || props.status === undefined);\nconst alive = computed(() => running.value && props.startedAt !== undefined);\nconst now = useNow(1000, alive);\n\nconst fmt = (v: number, f?: Intl.NumberFormatOptions) =>\n  v.toLocaleString(\"en-US\", f ?? { maximumFractionDigits: 2 });\n\n/** 胜者：显式标记优先，否则取 value 最大 */\nconst winnerId = computed(() => {\n  const explicit = props.variants.find((v) => v.winner);\n  if (explicit) return explicit.id;\n  if (running.value || props.variants.length < 2) return undefined;\n  return [...props.variants].sort((a, b) => b.value - a.value)[0]!.id;\n});\n\nconst threshold = computed(() => props.confidenceThreshold ?? 0.95);\nconst concluded = computed(() => !running.value && props.confidence !== undefined && props.confidence >= threshold.value);\n\nconst verdict = computed(() => {\n  const w = props.variants.find((v) => v.id === winnerId.value);\n  if (!w || running.value) return null;\n  if (props.confidence !== undefined && props.confidence < threshold.value) {\n    return \"差异未达显著，继续观察或加大样本\";\n  }\n  const delta = w.delta !== undefined ? `（+${Math.round(w.delta * 100)}%）` : \"\";\n  return `「${w.name}」胜出${delta}`;\n});\n\nconst elapsed = computed(() => {\n  if (!running.value || props.startedAt === undefined) return null;\n  const ms = Math.max(0, now.value - props.startedAt);\n  const m = Math.floor(ms / 60_000);\n  return m < 60 ? `${m} 分钟` : `${Math.floor(m / 60)} 小时 ${m % 60} 分`;\n});\n</script>\n\n<template>\n  <section class=\"va-exp\" :data-status=\"props.status ?? 'running'\">\n    <header class=\"va-exp__head\">\n      <span class=\"va-exp__title\">{{ props.title }}</span>\n      <span class=\"va-exp__status\" :data-status=\"props.status ?? 'running'\" role=\"status\">\n        {{ running ? \"进行中\" : props.status === \"error\" ? \"已中止\" : \"已完成\" }}\n      </span>\n      <span v-if=\"elapsed\" class=\"va-exp__time\">已运行 {{ elapsed }}</span>\n      <span class=\"va-exp__spacer\" />\n      <button\n        v-if=\"running\"\n        class=\"va-act va-act--sm va-act--ghost va-exp__op\"\n        type=\"button\"\n        @click=\"emit('stop')\"\n      >结束实验</button>\n      <button\n        v-else\n        class=\"va-act va-act--sm va-act--ghost va-exp__op\"\n        type=\"button\"\n        @click=\"emit('reopen')\"\n      >重新开始</button>\n    </header>\n\n    <div class=\"va-exp__grid\" role=\"list\" :aria-label=\"`${props.metric}对比`\">\n      <div\n        v-for=\"v in props.variants\"\n        :key=\"v.id\"\n        class=\"va-exp__variant\"\n        :data-winner=\"v.id === winnerId\"\n        role=\"listitem\"\n      >\n        <span class=\"va-exp__name\">{{ v.name }}<em v-if=\"v.id === winnerId\" class=\"va-exp__crown\" aria-label=\"胜出\">✓</em></span>\n        <strong class=\"va-exp__value\">{{ fmt(v.value, v.format) }}</strong>\n        <span v-if=\"v.delta !== undefined\" class=\"va-exp__delta\">+{{ Math.round(v.delta * 100) }}%</span>\n        <span class=\"va-exp__metric\">{{ props.metric }}</span>\n      </div>\n    </div>\n\n    <footer v-if=\"props.confidence !== undefined\" class=\"va-exp__foot\">\n      <div class=\"va-exp__conf\" aria-hidden=\"true\">\n        <span class=\"va-exp__conf-bar\">\n          <span class=\"va-exp__conf-fill\" :data-enough=\"concluded\" :style=\"{ width: `${Math.min(100, props.confidence * 100)}%` }\" />\n        </span>\n        <span class=\"va-exp__conf-text\">置信度 {{ Math.round(props.confidence * 100) }}%（阈值 {{ Math.round(threshold * 100) }}%）</span>\n      </div>\n      <p v-if=\"verdict\" class=\"va-exp__verdict\" :data-enough=\"concluded\" role=\"status\">{{ verdict }}</p>\n    </footer>\n  </section>\n</template>\n\n<style>\n/* VaExperimentCard — A/B 实验对比卡 */\n\n.va-exp {\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-m);\n  background: var(--va-card);\n  padding: var(--va-s4) var(--va-s5);\n}\n\n.va-exp__head {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3);\n  margin-bottom: var(--va-s4);\n}\n\n.va-exp__title { font-size: 14px; font-weight: 700; color: var(--va-ink); }\n\n.va-exp__status {\n  font-size: 11px;\n  font-weight: 600;\n  padding: 1px 8px;\n  border-radius: var(--va-radius-pill);\n}\n\n.va-exp__status[data-status=\"running\"] { background: var(--va-accent-soft); color: var(--va-accent); }\n.va-exp__status[data-status=\"success\"] { background: color-mix(in srgb, var(--va-success) 14%, transparent); color: var(--va-success); }\n.va-exp__status[data-status=\"error\"] { background: color-mix(in srgb, var(--va-danger) 12%, transparent); color: var(--va-danger); }\n\n.va-exp__time { font-size: 11.5px; color: var(--va-muted); font-variant-numeric: tabular-nums; }\n.va-exp__spacer { flex: 1; }\n\n.va-exp__grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));\n  gap: var(--va-s3);\n}\n\n.va-exp__variant {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-m);\n  background: var(--va-bg);\n  padding: var(--va-s4);\n}\n\n.va-exp__variant[data-winner=\"true\"] {\n  border-color: color-mix(in srgb, var(--va-success) 55%, transparent);\n  box-shadow: 0 0 0 3px color-mix(in srgb, var(--va-success) 10%, transparent);\n}\n\n.va-exp__name {\n  font-size: 12px;\n  color: var(--va-muted);\n  display: inline-flex;\n  align-items: center;\n  gap: var(--va-s2);\n}\n\n.va-exp__crown {\n  font-style: normal;\n  color: var(--va-success);\n  font-weight: 700;\n}\n\n.va-exp__value {\n  font-size: 21px;\n  font-weight: 700;\n  color: var(--va-ink);\n  font-variant-numeric: tabular-nums;\n  line-height: 1.25;\n}\n\n.va-exp__delta { font-size: 12px; color: var(--va-success); font-weight: 600; }\n.va-exp__metric { font-size: 11px; color: var(--va-muted); }\n\n.va-exp__foot {\n  margin-top: var(--va-s4);\n  padding-top: var(--va-s3);\n  border-top: 1px solid var(--va-edge);\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s2);\n}\n\n.va-exp__conf { display: flex; align-items: center; gap: var(--va-s3); }\n\n.va-exp__conf-bar {\n  flex: none;\n  width: 130px;\n  height: 6px;\n  border-radius: var(--va-radius-pill);\n  background: var(--va-bg-subtle);\n  overflow: hidden;\n}\n\n.va-exp__conf-fill {\n  display: block;\n  height: 100%;\n  border-radius: inherit;\n  background: var(--va-muted);\n  transition: width var(--va-dur-3) var(--va-ease);\n}\n\n.va-exp__conf-fill[data-enough=\"true\"] { background: var(--va-success); }\n\n.va-exp__conf-text { font-size: 11.5px; color: var(--va-muted); font-variant-numeric: tabular-nums; }\n\n.va-exp__verdict {\n  margin: 0;\n  font-size: 13px;\n  font-weight: 600;\n  color: var(--va-muted);\n}\n\n.va-exp__verdict[data-enough=\"true\"] { color: var(--va-success); }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-exp__conf-fill { transition: none; }\n}\n\n/* 按钮基类（自动附带） */\n/* ============================================================\n   按钮基类 —— 全库动作按钮的单一样式来源。\n   组件叠加使用：class=\"va-act va-act--primary va-xxx__submit\"，\n   组件自己的 CSS 只写布局/色彩覆盖（width、pill 圆角等）。\n   registry 生成器会把本文件自动内联进用了 va-act 的组件拷贝。\n   ============================================================ */\n\n.va-act {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-card);\n  color: var(--va-ink-2);\n  font: inherit;\n  font-size: 13px;\n  line-height: 1.4;\n  padding: 5px 14px;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: border-color var(--va-dur-1) var(--va-ease), background var(--va-dur-1) var(--va-ease),\n    color var(--va-dur-1) var(--va-ease);\n}\n\n.va-act:hover:not(:disabled) { border-color: var(--va-edge-strong); }\n\n.va-act:focus-visible { outline: 2px solid var(--va-accent); outline-offset: 1px; }\n\n.va-act:disabled { opacity: 0.45; cursor: default; }\n\n/* 尺寸 */\n.va-act--sm { font-size: 12px; padding: 3px 10px; }\n.va-act--lg { font-size: 14px; padding: 7px 18px; }\n\n/* 变体 */\n.va-act--primary {\n  background: var(--va-accent);\n  border-color: var(--va-accent);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-act--primary:hover:not(:disabled) {\n  background: var(--va-accent-hover);\n  border-color: var(--va-accent-hover);\n}\n\n.va-act--ghost {\n  border-color: transparent;\n  background: transparent;\n}\n\n.va-act--ghost:hover:not(:disabled) { background: var(--va-bg-subtle); }\n\n.va-act--danger { border-color: transparent; background: transparent; color: var(--va-danger); }\n\n.va-act--danger:hover:not(:disabled) {\n  background: color-mix(in srgb, var(--va-danger) 10%, transparent);\n  border-color: transparent;\n}\n\n/* 语义色实底（成功/危险确认场景，按需叠加） */\n.va-act--success {\n  background: var(--va-success);\n  border-color: var(--va-success);\n  color: #fff;\n  font-weight: 600;\n}\n\n/* 墨色实底：审批/决策/应用这类\"终审\"主操作（区别于 accent 常规主操作） */\n.va-act--ink {\n  background: var(--va-ink);\n  border-color: var(--va-ink);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-act--ink:hover:not(:disabled) { opacity: 0.88; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-act { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/experiment-card/types.ts",
      "type": "registry:ui",
      "target": "components/ui/experiment-card/types.ts",
      "content": "/** VaExperimentCard 的类型定义 */\n\nexport type ExperimentStatus = \"running\" | \"success\" | \"error\";\n\nexport interface ExperimentVariant {\n  id: string;\n  /** 变体名，如「对照组」/「改写提示词」 */\n  name: string;\n  /** 指标值（如 0.342 的完成率） */\n  value: number;\n  /** 指标格式化（如 { style: \"percent\", maximumFractionDigits: 1 }） */\n  format?: Intl.NumberFormatOptions;\n  /** 相对基线的提升（小数）；胜者上色 */\n  delta?: number;\n  /** 显式标记胜者（不传时由组件按 value 最大者标记） */\n  winner?: boolean;\n}\n\nexport interface ExperimentCardProps {\n  title: string;\n  status?: ExperimentStatus;\n  /** 对比的指标名，如「任务完成率」 */\n  metric: string;\n  /** 通常 2 个变体 */\n  variants: ExperimentVariant[];\n  /** 置信度 0-1（如 0.95）；≥ 阈值时显示结论 */\n  confidence?: number;\n  /** 结论阈值，默认 0.95 */\n  confidenceThreshold?: number;\n  /** 开始时间 ms 时间戳（running 态展示已运行时长） */\n  startedAt?: number;\n}\n\nexport interface ExperimentCardEvents {\n  stop: [];\n  reopen: [];\n}\n"
    }
  ]
}
