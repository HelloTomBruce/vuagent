{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "queue-dock",
  "title": "Queue Dock",
  "description": "排队消息 dock：运行中入队的消息逐条展示，支持插队（zap 置顶）、行内编辑、移除。",
  "type": "registry:ui",
  "dependencies": [
    "lucide-vue-next"
  ],
  "registryDependencies": [],
  "docs": "- `items` (QueueItem[]，默认 -)：id/text\n- `disabled` (boolean，默认 false)：审批接管期禁操作\n- `@sendNow / @edit / @remove` (-，默认 -)：插队 / 行内编辑 / 移除（按下标）",
  "files": [
    {
      "path": "components/ui/queue-dock/VaQueueDock.vue",
      "type": "registry:ui",
      "target": "components/ui/queue-dock/VaQueueDock.vue",
      "content": "<script setup lang=\"ts\">\nimport { nextTick, ref, useTemplateRef } from \"vue\";\nimport { Check, Pen, X, Zap } from \"lucide-vue-next\";\nimport type { QueueDockEvents, QueueDockProps } from \"./types\";\n\nconst props = withDefaults(defineProps<QueueDockProps>(), {\n  disabled: false,\n});\n\nconst emit = defineEmits<QueueDockEvents>();\n\n/* 行内编辑 */\nconst editingIndex = ref<number | null>(null);\nconst draft = ref(\"\");\nconst inputEl = useTemplateRef<HTMLInputElement>(\"input\");\nfunction startEdit(i: number, text: string) {\n  if (props.disabled) return;\n  editingIndex.value = i;\n  draft.value = text;\n  void nextTick(() => inputEl.value?.focus());\n}\nfunction commitEdit(i: number) {\n  const t = draft.value.trim();\n  if (t && t !== props.items[i]?.text) emit(\"edit\", i, t);\n  editingIndex.value = null;\n}\nfunction cancelEdit() {\n  editingIndex.value = null;\n}\n</script>\n\n<template>\n  <div class=\"va-queuedock\" role=\"list\" aria-label=\"排队消息\">\n    <div v-for=\"(item, i) in props.items\" :key=\"item.id\" class=\"va-queuedock__row\" role=\"listitem\">\n      <span class=\"va-queuedock__tag\">排队 {{ i + 1 }}</span>\n\n      <template v-if=\"editingIndex === i\">\n        <input\n          ref=\"input\"\n          v-model=\"draft\"\n          class=\"va-queuedock__input\"\n          type=\"text\"\n          maxlength=\"2000\"\n          @keydown.enter.prevent=\"commitEdit(i)\"\n          @keydown.escape.prevent=\"cancelEdit\"\n        />\n        <button class=\"va-queuedock__op\" type=\"button\" aria-label=\"确认编辑\" @click=\"commitEdit(i)\"><Check :size=\"13\" /></button>\n        <button class=\"va-queuedock__op\" type=\"button\" aria-label=\"取消编辑\" @click=\"cancelEdit\"><X :size=\"13\" /></button>\n      </template>\n      <template v-else>\n        <span class=\"va-queuedock__text\" :title=\"item.text\">{{ item.text }}</span>\n        <button class=\"va-queuedock__op\" type=\"button\" :aria-label=\"`插队：立即发送第 ${i + 1} 条`\" title=\"插队：run 结束后立即下发\" :disabled=\"props.disabled\" @click=\"emit('sendNow', i)\">\n          <Zap :size=\"13\" />\n        </button>\n        <button class=\"va-queuedock__op\" type=\"button\" aria-label=\"编辑\" :disabled=\"props.disabled\" @click=\"startEdit(i, item.text)\"><Pen :size=\"12\" /></button>\n        <button class=\"va-queuedock__op\" type=\"button\" aria-label=\"移除排队\" :disabled=\"props.disabled\" @click=\"emit('remove', i)\"><X :size=\"13\" /></button>\n      </template>\n    </div>\n  </div>\n</template>\n\n<style>\n/* VaQueueDock — 排队消息 dock */\n.va-queuedock {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  font-family: var(--va-font, system-ui, sans-serif);\n}\n\n.va-queuedock__row {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  background: var(--va-card, #fff);\n  border: 1px dashed var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-pill, 999px);\n  padding: 3px 6px 3px 10px;\n  max-width: 100%;\n}\n\n.va-queuedock__tag {\n  flex: none;\n  color: var(--va-accent, #c2410c);\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.va-queuedock__text {\n  flex: 1;\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-size: 12px;\n  color: var(--va-muted, #6f6d66);\n}\n\n.va-queuedock__input {\n  flex: 1;\n  min-width: 0;\n  border: 1px solid var(--va-accent, #c2410c);\n  border-radius: var(--va-radius-s, 8px);\n  background: var(--va-card, #fff);\n  color: var(--va-ink, #1a1917);\n  font: inherit;\n  font-size: 12px;\n  padding: 2px 8px;\n}\n.va-queuedock__input:focus-visible { outline: none; }\n\n.va-queuedock__op {\n  flex: none;\n  width: 22px;\n  height: 22px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border: 0;\n  background: none;\n  color: var(--va-muted, #6f6d66);\n  border-radius: var(--va-radius-s, 8px);\n  cursor: pointer;\n}\n.va-queuedock__op:hover:not(:disabled) { background: var(--va-bg-subtle, #efede7); color: var(--va-ink, #1a1917); }\n.va-queuedock__op:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: -2px; }\n.va-queuedock__op:disabled { opacity: 0.4; cursor: default; }\n</style>\n"
    },
    {
      "path": "components/ui/queue-dock/types.ts",
      "type": "registry:ui",
      "target": "components/ui/queue-dock/types.ts",
      "content": "/** VaQueueDock 的类型定义：排队消息 dock（G11：编辑/移除/插队） */\n\nexport interface QueueItem {\n  id: string;\n  text: string;\n}\n\nexport interface QueueDockProps {\n  items: QueueItem[];\n  disabled?: boolean;\n}\n\nexport interface QueueDockEvents {\n  remove: [index: number];\n  /** 插队：移动到队首（run 结束后立即下发） */\n  sendNow: [index: number];\n  /** 行内编辑文本（空串不提交） */\n  edit: [index: number, text: string];\n}\n"
    }
  ]
}
