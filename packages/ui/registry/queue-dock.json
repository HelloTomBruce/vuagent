{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "queue-dock",
  "title": "Queue Dock",
  "description": "排队消息 dock：运行中入队的消息逐条展示，支持插队（zap 置顶）、行内编辑、移除。",
  "type": "registry:ui",
  "dependencies": [
    "lucide-vue-next"
  ],
  "registryDependencies": [],
  "docs": "- `items` (QueueItem[]，默认 -)：id/text\n- `disabled` (boolean，默认 false)：审批接管期禁操作\n- `@sendNow / @edit / @remove` (-，默认 -)：插队 / 行内编辑 / 移除（按下标）",
  "files": [
    {
      "path": "components/ui/queue-dock/VaQueueDock.vue",
      "type": "registry:ui",
      "target": "components/ui/queue-dock/VaQueueDock.vue",
      "content": "<script setup lang=\"ts\">\nimport { nextTick, ref, useTemplateRef } from \"vue\";\nimport { Check, Pen, X, Zap } from \"lucide-vue-next\";\nimport type { QueueDockEvents, QueueDockProps } from \"./types\";\n\nconst props = withDefaults(defineProps<QueueDockProps>(), {\n  disabled: false,\n});\n\nconst emit = defineEmits<QueueDockEvents>();\n\n/* 行内编辑 */\nconst editingIndex = ref<number | null>(null);\nconst draft = ref(\"\");\nconst inputEl = useTemplateRef<HTMLInputElement>(\"input\");\nfunction startEdit(i: number, text: string) {\n  if (props.disabled) return;\n  editingIndex.value = i;\n  draft.value = text;\n  void nextTick(() => inputEl.value?.focus());\n}\nfunction commitEdit(i: number) {\n  const t = draft.value.trim();\n  if (t && t !== props.items[i]?.text) emit(\"edit\", i, t);\n  editingIndex.value = null;\n}\nfunction cancelEdit() {\n  editingIndex.value = null;\n}\n</script>\n\n<template>\n  <!-- 进出场（TASK-108）：排队项入队/出队走 TransitionGroup——\n       .va-enter-up 上浮入场 / .va-exit-left 左移离场 / move 平移补位\n       （motion.css 统一协议，reduced-motion 由其媒体块降级为纯 fade） -->\n  <TransitionGroup\n    tag=\"div\"\n    class=\"va-queuedock\"\n    role=\"list\"\n    aria-label=\"排队消息\"\n    enter-active-class=\"va-enter-up\"\n    leave-active-class=\"va-exit-left\"\n    move-class=\"va-queuedock-move\"\n  >\n    <div v-for=\"(item, i) in props.items\" :key=\"item.id\" class=\"va-queuedock__row\" role=\"listitem\">\n      <span class=\"va-queuedock__tag\">排队 {{ i + 1 }}</span>\n\n      <template v-if=\"editingIndex === i\">\n        <input\n          ref=\"input\"\n          v-model=\"draft\"\n          class=\"va-queuedock__input\"\n          type=\"text\"\n          maxlength=\"2000\"\n          @keydown.enter.prevent=\"commitEdit(i)\"\n          @keydown.escape.prevent=\"cancelEdit\"\n        />\n        <button class=\"va-queuedock__op\" type=\"button\" aria-label=\"确认编辑\" @click=\"commitEdit(i)\"><Check :size=\"13\" /></button>\n        <button class=\"va-queuedock__op\" type=\"button\" aria-label=\"取消编辑\" @click=\"cancelEdit\"><X :size=\"13\" /></button>\n      </template>\n      <template v-else>\n        <span class=\"va-queuedock__text\" :title=\"item.text\">{{ item.text }}</span>\n        <button class=\"va-queuedock__op\" type=\"button\" :aria-label=\"`插队：立即发送第 ${i + 1} 条`\" title=\"插队：run 结束后立即下发\" :disabled=\"props.disabled\" @click=\"emit('sendNow', i)\">\n          <Zap :size=\"13\" />\n        </button>\n        <button class=\"va-queuedock__op\" type=\"button\" aria-label=\"编辑\" :disabled=\"props.disabled\" @click=\"startEdit(i, item.text)\"><Pen :size=\"12\" /></button>\n        <button class=\"va-queuedock__op\" type=\"button\" aria-label=\"移除排队\" :disabled=\"props.disabled\" @click=\"emit('remove', i)\"><X :size=\"13\" /></button>\n      </template>\n    </div>\n  </TransitionGroup>\n</template>\n\n<style>\n/* VaQueueDock — 排队消息 dock */\n.va-queuedock {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  font-family: var(--va-font, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Helvetica Neue\", sans-serif);\n}\n\n.va-queuedock__row {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3h, 6px);\n  background: var(--va-card, #ffffff);\n  border: 1px dashed var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-pill, 999px);\n  padding: 3px var(--va-s3h, 6px) 3px var(--va-s4h, 10px);\n  max-width: 100%;\n}\n\n.va-queuedock__tag {\n  flex: none;\n  color: var(--va-accent, #c2410c);\n  font-size: var(--va-fs-sm, 12px);\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n.va-queuedock__text {\n  flex: 1;\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-size: var(--va-fs-sm, 12px);\n  color: var(--va-muted, #6f6d66);\n}\n\n.va-queuedock__input {\n  flex: 1;\n  min-width: 0;\n  border: 1px solid var(--va-accent, #c2410c);\n  border-radius: var(--va-radius-s, 8px);\n  background: var(--va-card, #ffffff);\n  color: var(--va-ink, #1a1917);\n  font: inherit;\n  font-size: var(--va-fs-sm, 12px);\n  padding: 2px 8px;\n}\n.va-queuedock__input:focus-visible { outline: none; }\n\n.va-queuedock__op {\n  flex: none;\n  width: 22px;\n  height: 22px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border: 0;\n  background: none;\n  color: var(--va-muted, #6f6d66);\n  border-radius: var(--va-radius-s, 8px);\n  cursor: pointer;\n}\n.va-queuedock__op:hover:not(:disabled) { background: var(--va-bg-subtle, #efede7); color: var(--va-ink, #1a1917); }\n.va-queuedock__op:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: -2px; }\n.va-queuedock__op:disabled { opacity: 0.4; cursor: default; }\n\n/* ---- TASK-108 进出场/交互反馈 ----\n   进出场类由模板 TransitionGroup 挂 motion.css 的 .va-enter-up/.va-exit-left\n   （reduced-motion 由 motion.css 媒体块降级）；move 补位平移在此定义。 */\n.va-queuedock-move {\n  transition: transform var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n/* 操作按钮 hover 平滑过渡（既有 hover 反馈的过渡化） */\n.va-queuedock__op {\n  transition:\n    background-color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-queuedock-move { transition: none; }\n  .va-queuedock__op { transition: none; }\n}\n\n/* 动效工具类（自动附带，源码中来自全局 motion.css） */\n/* ============================================================\n   共享动效工具类 —— 进出场/交叉淡入的统一协议（TASK-102 动效基建）。\n   组件不逐个发明入场曲线：统一消费 --va-dur-in/--va-dur-out 骨架时长与\n   --va-dist-* 位移档；每条声明自带字面 fallback（registry 单文件拷贝分发\n   要求，与 tokens.css 门禁一致）。\n\n   接入方式二选一：\n   1. Vue <Transition>：\n      <Transition enter-active-class=\"va-enter-up\" leave-active-class=\"va-exit-up\">\n      动画 fill-mode 为 both（延迟期间保持首帧、播完停在终态），\n      无需再配 enter-from-class / leave-to-class；\n   2. 类切换重挂载：骨架 → 内容换节点时给新节点挂 .va-crossfade（纯淡入），\n      离场节点挂 .va-exit-*（更短更快）。\n\n   列表错峰：v-for 子项 :style=\"useStagger().delayStyle(i)\" 配合 .va-enter-*\n   动画类使用（animation-delay 由 composable 编排——.va-enter-* 为 CSS animation，\n   transition-delay 对其零作用，见 composables/useStagger.ts）。\n   ============================================================ */\n\n/* 入场：上浮（自下方 --va-dist-m 浮起） */\n@keyframes va-motion-in-up {\n  from { opacity: 0; transform: translateY(var(--va-dist-m, 8px)); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* 入场：左滑（自左侧 --va-dist-m 滑入） */\n@keyframes va-motion-in-left {\n  from { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n  to { opacity: 1; transform: translateX(0); }\n}\n\n/* 入场：缩放（96% 起放大至原尺寸） */\n@keyframes va-motion-in-scale {\n  from { opacity: 0; transform: scale(0.96); }\n  to { opacity: 1; transform: scale(1); }\n}\n\n/* 离场：与入场互逆（向上/向左飘出、缩回）；时长/曲线由工具类映射 --va-dur-out 骨架 */\n@keyframes va-motion-out-up {\n  from { opacity: 1; transform: translateY(0); }\n  to { opacity: 0; transform: translateY(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-left {\n  from { opacity: 1; transform: translateX(0); }\n  to { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-scale {\n  from { opacity: 1; transform: scale(1); }\n  to { opacity: 0; transform: scale(0.96); }\n}\n\n/* 交叉淡入/淡出（.va-crossfade 骨架→内容交换专用，无位移，避免占位跳变叠加） */\n@keyframes va-motion-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes va-motion-fade-out {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n/* ---- 工具类：入场走 --va-dur-in + ease-out-quart，离场走 --va-dur-out + ease-in-quad ---- */\n\n.va-enter-up {\n  animation: va-motion-in-up var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-left {\n  animation: va-motion-in-left var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-scale {\n  animation: va-motion-in-scale var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-exit-up {\n  animation: va-motion-out-up var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-left {\n  animation: va-motion-out-left var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-scale {\n  animation: va-motion-out-scale var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n/* 骨架 → 内容交叉过渡：新内容纯淡入 */\n.va-crossfade {\n  animation: va-motion-fade-in var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* 空态/轻量状态渐入（TASK-106 弱化档）：仅 opacity、时长走 --va-dur-2，\n   供列表空态提示与一次性状态块使用（空态清单见 TASK-106 报告）。\n   纯 opacity 即动效分频策略的降级终点形态，reduced-motion 下保持原样即可。 */\n.va-fade-in {\n  animation: va-motion-fade-in var(--va-dur-2, 200ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* ---- 静态光斑基类（TASK-105，决策 5「追光」路线基建）----\n   pointer 坐标由 composables/useSpotlight.ts 以 rAF 节流写入 --va-spot-x/y\n   （元素内百分比，光斑数学在 composable 内可单测）；本类只负责 radial 光斑\n   绘制与显隐（:hover 点亮，无 3D 倾斜， glare 数学对齐 VaTiltCard）。\n   --va-spot-* 为 L3 组件钩子口径（宿主可覆盖尺寸/颜色），不进 tokens.css。\n   双降级对齐 VaTiltCard glare：hover: none（触屏）与 reduced-motion 不绘制。 */\n.va-spotlight { position: relative; }\n\n/* ::after 承载光斑（避开组件自身 ::before 用途）；inset 0 + border-radius inherit\n   使光斑天然裁剪在宿主圆角内，无需 overflow: hidden。\n   注意：此 ::after radial 与 components/spotlight-card/VaSpotlightCard.css 的\n   .va-spot-card--spot::after 为 registry 单文件自含有意复制，改动需两处同步。 */\n.va-spotlight::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n  background: radial-gradient(\n    var(--va-spot-size, 240px) circle at var(--va-spot-x, 50%) var(--va-spot-y, 50%),\n    var(--va-spot-color, rgba(255, 255, 255, 0.14)),\n    transparent 65%\n  );\n}\n\n.va-spotlight:hover::after { opacity: 1; }\n\n@media (hover: none) {\n  .va-spotlight::after { display: none; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-spotlight::after { display: none; }\n}\n\n/* ---- 复制反馈标准（TASK-106）：copy→check 交叉过渡 ----\n   容器 .va-copy 为 inline-grid 双内容同格堆叠（格子宽取较宽子项，切换零跳动）：\n   __idle = copy 态内容（图标/文字），__done = check 态内容。\n   copied 置真挂 .va-copy--done：check 以 ease-spring 微弹入场（进入 done 态时\n   transform 的目标态时序换成 --va-ease-spring → 过冲回弹），交叉时长统一 --va-dur-1。\n   消费方：terminal-log（行复制）、code-diff（复制按钮）、message-actions（复制图标）。 */\n.va-copy { display: inline-grid; place-items: center; }\n\n.va-copy__idle,\n.va-copy__done {\n  grid-area: 1 / 1;\n  transition: opacity var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-copy__idle { opacity: 1; transform: scale(1); }\n.va-copy__done { opacity: 0; transform: scale(0.6); }\n\n.va-copy--done .va-copy__done {\n  opacity: 1;\n  transform: scale(1);\n  /* 时序按 transition 属性顺序映射：opacity 仍 ease，transform 换 ease-spring 微弹 */\n  transition-timing-function: var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), var(--va-ease-spring, cubic-bezier(0.34, 1.56, 0.64, 1));\n}\n\n.va-copy--done .va-copy__idle { opacity: 0; transform: scale(0.6); }\n\n@media (prefers-reduced-motion: reduce) {\n  /* 交叉过渡瞬时完成（无位移动画），copied 状态可感知性不受影响 */\n  .va-copy__idle,\n  .va-copy__done { transition: none; }\n}\n\n/* ---- 错误反馈标准（校验失败横向微振）：目标元素挂 .va-shake 播一次 ±3px 微振 ----\n   时长 --va-dur-2 × 2（两拍四峰，克制的「摇头」量级，rubric 校验失败口径）；\n   重复触发需先移除类、强制 reflow 再挂回（封装见 composables/useShake.ts）。\n   reduced-motion 降级为不播：错误状态的可感知性由错误样式本身（描边/文案）承担，\n   动效只做注意力引导——符合头注释「功能动画降级保留状态可感知」的分频策略。\n   消费方：VaStepperForm / VaOtpInput 经 useShake() 程序化触发（defineExpose shake()）；\n   宿主自绘表单可直接挂类。 */\n@keyframes va-motion-shake {\n  20% { transform: translateX(-3px); }\n  40% { transform: translateX(3px); }\n  60% { transform: translateX(-2px); }\n  80% { transform: translateX(2px); }\n}\n\n.va-shake {\n  animation: va-motion-shake calc(var(--va-dur-2, 200ms) * 2) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-shake { animation: none; }\n}\n\n/* ---- 动效分频（对齐 tokens.css 头注释策略）：\n   功能动画降级为纯 opacity——进/出场整体换成 fade keyframes，\n   位移/缩放不再出现（animation-name 顶替，时长/缓动沿用上面的声明）。 */\n@media (prefers-reduced-motion: reduce) {\n  .va-enter-up,\n  .va-enter-left,\n  .va-enter-scale,\n  .va-crossfade {\n    animation-name: va-motion-fade-in;\n  }\n\n  .va-exit-up,\n  .va-exit-left,\n  .va-exit-scale {\n    animation-name: va-motion-fade-out;\n  }\n}\n</style>\n"
    },
    {
      "path": "components/ui/queue-dock/index.ts",
      "type": "registry:ui",
      "target": "components/ui/queue-dock/index.ts",
      "content": "export { default as VaQueueDock } from \"./VaQueueDock.vue\";\nexport type { QueueDockEvents, QueueDockProps, QueueItem } from \"./types\";\n"
    },
    {
      "path": "components/ui/queue-dock/types.ts",
      "type": "registry:ui",
      "target": "components/ui/queue-dock/types.ts",
      "content": "/** VaQueueDock 的类型定义：排队消息 dock（G11：编辑/移除/插队） */\n\nexport interface QueueItem {\n  id: string;\n  text: string;\n}\n\nexport interface QueueDockProps {\n  items: QueueItem[];\n  disabled?: boolean;\n}\n\nexport interface QueueDockEvents {\n  remove: [index: number];\n  /** 插队：移动到队首（run 结束后立即下发） */\n  sendNow: [index: number];\n  /** 行内编辑文本（空串不提交） */\n  edit: [index: number, text: string];\n}\n"
    }
  ]
}
