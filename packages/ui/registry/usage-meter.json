{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "usage-meter",
  "title": "Usage Meter",
  "description": "用量仪表：多段堆叠条（fast/slow tokens、credits）+ 图例 + 限额预警（默认 80%）/超限态与「管理额度」入口。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `segments` (UsageSegment[]，默认 -)：label/used/color 多段用量\n- `limit` (number，默认 -)：周期限额（分母）\n- `unit / period` (string，默认 -)：单位与周期文案\n- `warnAt` (number，默认 0.8)：预警阈值（占比）\n- `@manage` (-，默认 -)：预警/超限时的管理入口",
  "files": [
    {
      "path": "components/ui/usage-meter/VaUsageMeter.vue",
      "type": "registry:ui",
      "target": "components/ui/usage-meter/VaUsageMeter.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from \"vue\";\nimport type { UsageMeterEvents, UsageMeterProps } from \"./types\";\n\nconst props = defineProps<UsageMeterProps>();\n\nconst emit = defineEmits<UsageMeterEvents>();\n\nconst PALETTE = [\"var(--va-info)\", \"var(--va-accent)\", \"var(--va-success)\", \"var(--va-warning)\"];\n\nconst total = computed(() => props.segments.reduce((s, x) => s + x.used, 0));\nconst ratio = computed(() => (props.limit > 0 ? total.value / props.limit : 0));\nconst warnAt = computed(() => props.warnAt ?? 0.8);\nconst level = computed(() => {\n  if (ratio.value >= 1) return \"exceeded\";\n  if (ratio.value >= warnAt.value) return \"warn\";\n  return \"ok\";\n});\n\nconst fmt = (n: number) => n.toLocaleString(\"en-US\");\n\nconst segStyle = (i: number, used: number) => ({\n  width: props.limit > 0 ? `${Math.min(100, (used / props.limit) * 100)}%` : \"0%\",\n  background: props.segments[i]!.color ?? PALETTE[i % PALETTE.length]!,\n});\n</script>\n\n<template>\n  <div class=\"va-usage\" :data-level=\"level\">\n    <header class=\"va-usage__head\">\n      <span class=\"va-usage__amount\">\n        <strong>{{ fmt(total) }}</strong>\n        <span class=\"va-usage__limit\">/ {{ fmt(props.limit) }} {{ props.unit ?? \"\" }}</span>\n      </span>\n      <span class=\"va-usage__period\">{{ props.period }}</span>\n    </header>\n\n    <div\n      class=\"va-usage__bar\"\n      role=\"meter\"\n      :aria-valuemin=\"0\"\n      :aria-valuemax=\"props.limit\"\n      :aria-valuenow=\"total\"\n      :aria-label=\"`已用 ${fmt(total)} / ${fmt(props.limit)} ${props.unit ?? ''}`\"\n      :style=\"{ height: `${props.barHeight ?? 10}px` }\"\n    >\n      <span\n        v-for=\"(seg, i) in props.segments\"\n        :key=\"seg.label\"\n        class=\"va-usage__seg\"\n        :style=\"segStyle(i, seg.used)\"\n      />\n    </div>\n\n    <p v-if=\"level !== 'ok'\" class=\"va-usage__alert\" role=\"status\">\n      <template v-if=\"level === 'exceeded'\">已超出限额，新任务将被限流</template>\n      <template v-else>已用 {{ Math.round(ratio * 100) }}%，接近本期限额</template>\n      <button class=\"va-btn va-btn--sm va-usage__manage\" type=\"button\" @click=\"emit('manage')\">管理额度</button>\n    </p>\n\n    <ul v-else class=\"va-usage__legend\">\n      <li v-for=\"(seg, i) in props.segments\" :key=\"seg.label\" class=\"va-usage__item\">\n        <span class=\"va-usage__swatch\" :style=\"{ background: seg.color ?? PALETTE[i % PALETTE.length]! }\" />\n        <span class=\"va-usage__label\">{{ seg.label }}</span>\n        <span class=\"va-usage__value\">{{ fmt(seg.used) }}</span>\n        <span class=\"va-usage__pct\">{{ props.limit > 0 ? Math.round((seg.used / props.limit) * 100) : 0 }}%</span>\n      </li>\n    </ul>\n  </div>\n</template>\n\n<style>\n/* VaUsageMeter — 用量与限额 */\n\n.va-usage {\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-m);\n  background: var(--va-card);\n  padding: var(--va-s5);\n}\n\n.va-usage__head {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: var(--va-s4);\n  margin-bottom: var(--va-s4);\n}\n\n.va-usage__amount strong {\n  font-size: 20px;\n  font-weight: 700;\n  color: var(--va-ink);\n  font-variant-numeric: tabular-nums;\n}\n\n.va-usage__limit {\n  margin-left: var(--va-s2);\n  font-size: 12.5px;\n  color: var(--va-muted);\n  font-variant-numeric: tabular-nums;\n}\n\n.va-usage__period { font-size: 12px; color: var(--va-muted); }\n\n.va-usage__bar {\n  display: flex;\n  width: 100%;\n  border-radius: var(--va-radius-pill);\n  background: var(--va-bg-subtle);\n  overflow: hidden;\n}\n\n.va-usage__seg {\n  display: block;\n  height: 100%;\n  min-width: 2px;\n  transition: width var(--va-dur-3) var(--va-ease);\n}\n\n.va-usage[data-level=\"warn\"] .va-usage__seg { filter: saturate(1.3); }\n.va-usage[data-level=\"exceeded\"] .va-usage__bar { box-shadow: inset 0 0 0 2px var(--va-danger); }\n.va-usage[data-level=\"exceeded\"] .va-usage__amount strong { color: var(--va-danger); }\n\n.va-usage__legend {\n  list-style: none;\n  margin: var(--va-s4) 0 0;\n  padding: 0;\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--va-s3) var(--va-s6);\n}\n\n.va-usage__item {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s2);\n  font-size: 12px;\n}\n\n.va-usage__swatch {\n  width: 9px;\n  height: 9px;\n  border-radius: 3px;\n}\n\n.va-usage__label { color: var(--va-ink-2); }\n.va-usage__value { color: var(--va-muted); font-variant-numeric: tabular-nums; }\n.va-usage__pct { color: var(--va-muted); opacity: 0.8; }\n\n.va-usage__alert {\n  margin: var(--va-s4) 0 0;\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3);\n  font-size: 12.5px;\n  color: var(--va-warning);\n}\n\n.va-usage[data-level=\"exceeded\"] .va-usage__alert { color: var(--va-danger); }\n\n\n.va-usage__manage { border-color: currentColor; }\n.va-usage__manage:hover:not(:disabled) { background: color-mix(in srgb, currentColor 10%, transparent); border-color: currentColor; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-usage__seg { transition: none; }\n}\n\n/* 按钮基类（自动附带） */\n/* ============================================================\n   按钮基类 —— 全库动作按钮的单一样式来源。\n   组件叠加使用：class=\"va-btn va-btn--primary va-xxx__submit\"，\n   组件自己的 CSS 只写布局/色彩覆盖（width、pill 圆角等）。\n   registry 生成器会把本文件自动内联进用了 va-btn 的组件拷贝。\n   ============================================================ */\n\n.va-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-card);\n  color: var(--va-ink-2);\n  font: inherit;\n  font-size: 13px;\n  line-height: 1.4;\n  padding: 5px 14px;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: border-color var(--va-dur-1) var(--va-ease), background var(--va-dur-1) var(--va-ease),\n    color var(--va-dur-1) var(--va-ease);\n}\n\n.va-btn:hover:not(:disabled) { border-color: var(--va-edge-strong); }\n\n.va-btn:focus-visible { outline: 2px solid var(--va-accent); outline-offset: 1px; }\n\n.va-btn:disabled { opacity: 0.45; cursor: default; }\n\n/* 尺寸 */\n.va-btn--sm { font-size: 12px; padding: 3px 10px; }\n.va-btn--lg { font-size: 14px; padding: 7px 18px; }\n\n/* 变体 */\n.va-btn--primary {\n  background: var(--va-accent);\n  border-color: var(--va-accent);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-btn--primary:hover:not(:disabled) {\n  background: var(--va-accent-hover);\n  border-color: var(--va-accent-hover);\n}\n\n.va-btn--ghost {\n  border-color: transparent;\n  background: transparent;\n}\n\n.va-btn--ghost:hover:not(:disabled) { background: var(--va-bg-subtle); }\n\n.va-btn--danger { border-color: transparent; background: transparent; color: var(--va-danger); }\n\n.va-btn--danger:hover:not(:disabled) {\n  background: color-mix(in srgb, var(--va-danger) 10%, transparent);\n  border-color: transparent;\n}\n\n/* 语义色实底（成功/危险确认场景，按需叠加） */\n.va-btn--success {\n  background: var(--va-success);\n  border-color: var(--va-success);\n  color: #fff;\n  font-weight: 600;\n}\n\n/* 墨色实底：审批/决策/应用这类\"终审\"主操作（区别于 accent 常规主操作） */\n.va-btn--ink {\n  background: var(--va-ink);\n  border-color: var(--va-ink);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-btn--ink:hover:not(:disabled) { opacity: 0.88; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-btn { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/usage-meter/types.ts",
      "type": "registry:ui",
      "target": "components/ui/usage-meter/types.ts",
      "content": "/** VaUsageMeter 的类型定义 */\n\nexport interface UsageSegment {\n  label: string;\n  used: number;\n  /** 段色（CSS 色）；缺省按序取内置色 */\n  color?: string;\n}\n\nexport interface UsageMeterProps {\n  /** 多段用量（如 fast/slow tokens、credits），堆叠展示 */\n  segments: UsageSegment[];\n  /** 周期限额（分母） */\n  limit: number;\n  /** 计数单位文案，如 \"tokens\" / \"credits\" */\n  unit?: string;\n  /** 周期文案，如 \"今日 · 明早 8 点重置\" */\n  period?: string;\n  /** 占限额比例超过该值显示预警（0-1，默认 0.8） */\n  warnAt?: number;\n  /** 用量条高度 px（默认 10） */\n  barHeight?: number;\n}\n\nexport interface UsageMeterEvents {\n  /** 点击\"管理/升级\"入口 */\n  manage: [];\n}\n"
    }
  ]
}
