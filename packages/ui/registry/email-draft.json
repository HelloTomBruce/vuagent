{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "email-draft",
  "title": "Email Draft",
  "description": "agent 起草邮件、人工确认发送：收件人/主题/正文可就地编辑、语气 chips、起草骨架、发送校验与错误回显、重新起草。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `to / subject / body` (string，默认 -)：三字段受控（v-model:to 等）\n- `tones / tone` (ToneOption[] / string，默认 -)：语气选项与当前值\n- `drafting / sending` (boolean，默认 false)：起草骨架 / 发送中\n- `@send / @regenerate` (-，默认 -)：发送（携带完整草稿）/ 重新起草",
  "files": [
    {
      "path": "components/ui/email-draft/VaEmailDraft.vue",
      "type": "registry:ui",
      "target": "components/ui/email-draft/VaEmailDraft.vue",
      "content": "<script setup lang=\"ts\">\nimport type { EmailDraftEvents, EmailDraftProps } from \"./types\";\n\nconst props = defineProps<EmailDraftProps>();\n\nconst emit = defineEmits<EmailDraftEvents>();\n\nfunction send() {\n  if (props.sending) return;\n  emit(\"send\", {\n    to: props.to ?? \"\",\n    subject: props.subject ?? \"\",\n    body: props.body ?? \"\",\n    tone: props.tone,\n  });\n}\n\n/** 内容为空判定（drafting 态发送按钮一律禁用） */\nconst empty = () => !(props.body ?? \"\").trim() || !(props.subject ?? \"\").trim() || !(props.to ?? \"\").trim();\n</script>\n\n<template>\n  <form class=\"va-mail\" @submit.prevent=\"send\">\n    <header class=\"va-mail__head\">\n      <span class=\"va-mail__title\">邮件草稿</span>\n      <span class=\"va-mail__badge\">Agent 起草 · 人工确认</span>\n      <span class=\"va-mail__spacer\" />\n      <button class=\"va-btn va-btn--sm va-mail__regen\" type=\"button\" :disabled=\"props.drafting\" @click=\"emit('regenerate')\">\n        重新起草\n      </button>\n    </header>\n\n    <div class=\"va-mail__fields\">\n      <!-- 起草中骨架 -->\n      <template v-if=\"props.drafting\">\n        <div class=\"va-mail__skel va-mail__skel--to\" />\n        <div class=\"va-mail__skel va-mail__skel--subject\" />\n        <div class=\"va-mail__skel va-mail__skel--body\" />\n      </template>\n      <template v-else>\n        <label class=\"va-mail__field\">\n          <span class=\"va-mail__label\">收件人</span>\n          <input\n            class=\"va-mail__input\"\n            type=\"text\"\n            :value=\"props.to\"\n            placeholder=\"name@example.com\"\n            @input=\"emit('update:to', ($event.target as HTMLInputElement).value)\"\n          >\n        </label>\n        <label class=\"va-mail__field\">\n          <span class=\"va-mail__label\">主题</span>\n          <input\n            class=\"va-mail__input\"\n            type=\"text\"\n            :value=\"props.subject\"\n            placeholder=\"邮件主题\"\n            @input=\"emit('update:subject', ($event.target as HTMLInputElement).value)\"\n          >\n        </label>\n        <div v-if=\"props.tones?.length\" class=\"va-mail__tones\" role=\"radiogroup\" aria-label=\"语气\">\n          <button\n            v-for=\"t in props.tones\"\n            :key=\"t.value\"\n            class=\"va-mail__tone\"\n            type=\"button\"\n            role=\"radio\"\n            :aria-checked=\"props.tone === t.value\"\n            :data-active=\"props.tone === t.value\"\n            @click=\"emit('update:tone', t.value)\"\n          >{{ t.label }}</button>\n        </div>\n        <label class=\"va-mail__field va-mail__field--body\">\n          <span class=\"va-mail__label\">正文</span>\n          <textarea\n            class=\"va-mail__input va-mail__body\"\n            rows=\"7\"\n            :value=\"props.body\"\n            placeholder=\"agent 将在这里生成草稿，你可以直接修改…\"\n            @input=\"emit('update:body', ($event.target as HTMLTextAreaElement).value)\"\n          />\n        </label>\n      </template>\n    </div>\n\n    <footer class=\"va-mail__foot\">\n      <p v-if=\"props.error\" class=\"va-mail__error\" role=\"alert\">{{ props.error }}</p>\n      <span v-else class=\"va-mail__hint\">发送前请核对收件人与内容</span>\n      <span class=\"va-mail__spacer\" />\n      <button\n        class=\"va-btn va-btn--primary va-mail__send\"\n        type=\"submit\"\n        :disabled=\"props.sending || props.drafting || empty()\"\n      >{{ props.sending ? \"发送中…\" : \"发送\" }}</button>\n    </footer>\n  </form>\n</template>\n\n<style>\n/* VaEmailDraft — agent 起草、人工确认发送的邮件卡片 */\n\n.va-mail {\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-l);\n  background: var(--va-card);\n  overflow: hidden;\n}\n\n.va-mail__head {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3);\n  padding: var(--va-s4) var(--va-s5);\n  border-bottom: 1px solid var(--va-edge);\n  background: var(--va-bg-subtle);\n}\n\n.va-mail__title { font-size: 14px; font-weight: 700; color: var(--va-ink); }\n\n.va-mail__badge {\n  font-size: 11px;\n  padding: 2px 8px;\n  border-radius: var(--va-radius-pill);\n  background: var(--va-accent-soft);\n  color: var(--va-accent);\n  font-weight: 600;\n}\n\n.va-mail__spacer { flex: 1; }\n\n\n\n.va-mail__fields {\n  padding: var(--va-s5);\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s4);\n}\n\n.va-mail__field {\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s2);\n}\n\n.va-mail__label {\n  font-size: 11.5px;\n  font-weight: 600;\n  color: var(--va-muted);\n  letter-spacing: 0.02em;\n}\n\n.va-mail__input {\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-bg);\n  color: var(--va-ink);\n  font: inherit;\n  font-size: 13.5px;\n  padding: 8px 10px;\n  transition: border-color var(--va-dur-1) var(--va-ease);\n}\n\n.va-mail__input:focus {\n  outline: none;\n  border-color: var(--va-accent);\n  box-shadow: 0 0 0 3px var(--va-accent-soft);\n}\n\n.va-mail__body { resize: vertical; min-height: 130px; line-height: 1.6; }\n\n/* 起草中骨架（共享扫光需要 keyframes —— 用 opacity 呼吸，无 tokens 依赖） */\n.va-mail__skel {\n  border-radius: var(--va-radius-s);\n  background: linear-gradient(\n    100deg,\n    var(--va-bg-subtle) 40%,\n    color-mix(in srgb, var(--va-bg-subtle) 50%, var(--va-card)) 50%,\n    var(--va-bg-subtle) 60%\n  );\n  background-size: 200% 100%;\n  animation: va-mail-sweep 1.4s linear infinite;\n}\n\n.va-mail__skel--to { height: 36px; }\n.va-mail__skel--subject { height: 36px; }\n.va-mail__skel--body { height: 170px; }\n\n@keyframes va-mail-sweep {\n  to { background-position: -200% 0; }\n}\n\n.va-mail__tones {\n  display: flex;\n  gap: var(--va-s2);\n  flex-wrap: wrap;\n}\n\n.va-mail__tone {\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-pill);\n  background: var(--va-card);\n  color: var(--va-ink-2);\n  font-size: 12px;\n  padding: 3px 12px;\n  cursor: pointer;\n  transition: all var(--va-dur-1) var(--va-ease);\n}\n\n.va-mail__tone[data-active=\"true\"] {\n  background: var(--va-ink);\n  border-color: var(--va-ink);\n  color: var(--va-card);\n}\n\n.va-mail__tone:focus-visible { outline: 2px solid var(--va-accent); outline-offset: 1px; }\n\n.va-mail__foot {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3);\n  padding: var(--va-s3) var(--va-s5);\n  border-top: 1px solid var(--va-edge);\n  background: var(--va-bg-subtle);\n}\n\n.va-mail__hint { font-size: 12px; color: var(--va-muted); }\n\n.va-mail__error {\n  margin: 0;\n  font-size: 12px;\n  color: var(--va-danger);\n}\n\n\n\n@media (prefers-reduced-motion: reduce) {\n  .va-mail__skel { animation-duration: 3s; }\n  .va-mail__input,\n  .va-mail__tone { transition: none; }\n}\n\n/* 按钮基类（自动附带） */\n/* ============================================================\n   按钮基类 —— 全库动作按钮的单一样式来源。\n   组件叠加使用：class=\"va-btn va-btn--primary va-xxx__submit\"，\n   组件自己的 CSS 只写布局/色彩覆盖（width、pill 圆角等）。\n   registry 生成器会把本文件自动内联进用了 va-btn 的组件拷贝。\n   ============================================================ */\n\n.va-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-card);\n  color: var(--va-ink-2);\n  font: inherit;\n  font-size: 13px;\n  line-height: 1.4;\n  padding: 5px 14px;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: border-color var(--va-dur-1) var(--va-ease), background var(--va-dur-1) var(--va-ease),\n    color var(--va-dur-1) var(--va-ease);\n}\n\n.va-btn:hover:not(:disabled) { border-color: var(--va-edge-strong); }\n\n.va-btn:focus-visible { outline: 2px solid var(--va-accent); outline-offset: 1px; }\n\n.va-btn:disabled { opacity: 0.45; cursor: default; }\n\n/* 尺寸 */\n.va-btn--sm { font-size: 12px; padding: 3px 10px; }\n.va-btn--lg { font-size: 14px; padding: 7px 18px; }\n\n/* 变体 */\n.va-btn--primary {\n  background: var(--va-accent);\n  border-color: var(--va-accent);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-btn--primary:hover:not(:disabled) {\n  background: var(--va-accent-hover);\n  border-color: var(--va-accent-hover);\n}\n\n.va-btn--ghost {\n  border-color: transparent;\n  background: transparent;\n}\n\n.va-btn--ghost:hover:not(:disabled) { background: var(--va-bg-subtle); }\n\n.va-btn--danger { border-color: transparent; background: transparent; color: var(--va-danger); }\n\n.va-btn--danger:hover:not(:disabled) {\n  background: color-mix(in srgb, var(--va-danger) 10%, transparent);\n  border-color: transparent;\n}\n\n/* 语义色实底（成功/危险确认场景，按需叠加） */\n.va-btn--success {\n  background: var(--va-success);\n  border-color: var(--va-success);\n  color: #fff;\n  font-weight: 600;\n}\n\n/* 墨色实底：审批/决策/应用这类\"终审\"主操作（区别于 accent 常规主操作） */\n.va-btn--ink {\n  background: var(--va-ink);\n  border-color: var(--va-ink);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-btn--ink:hover:not(:disabled) { opacity: 0.88; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-btn { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/email-draft/types.ts",
      "type": "registry:ui",
      "target": "components/ui/email-draft/types.ts",
      "content": "/** VaEmailDraft 的类型定义 */\n\nexport interface ToneOption {\n  value: string;\n  label: string;\n}\n\nexport interface EmailDraftProps {\n  /** 收件人（受控） */\n  to?: string;\n  subject?: string;\n  body?: string;\n  /** 受控三字段：配合 update 事件实现 v-model:to / subject / body */\n  /** agent 起草中：字段区显示骨架 */\n  drafting?: boolean;\n  /** 发送中（按钮禁用 + 文案） */\n  sending?: boolean;\n  /** 语气选项；提供后显示语气 chips */\n  tones?: ToneOption[];\n  /** 当前语气 value */\n  tone?: string;\n  /** 收件人/主题校验错误文案（宿主校验；空时发送按钮可用） */\n  error?: string;\n}\n\nexport interface EmailDraftEvents {\n  \"update:to\": [v: string];\n  \"update:subject\": [v: string];\n  \"update:body\": [v: string];\n  \"update:tone\": [v: string];\n  /** 点击发送（携带完整草稿） */\n  send: [draft: { to: string; subject: string; body: string; tone?: string }];\n  /** 要求 agent 重新起草 */\n  regenerate: [];\n}\n"
    }
  ]
}
