{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "stepper-form",
  "title": "Stepper Form",
  "description": "分步表单壳：步骤条 + 每步具名插槽（#step-{id}）+ 上一步/下一步导航，nextDisabled 承接宿主校验，最后一步转提交。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `steps` (StepperStep[]，默认 -)：id/title/description\n- `v-model:step` (number，默认 0)：当前步下标（哨兵受控）\n- `nextDisabled / submitting` (boolean，默认 false)：校验未过 / 提交中\n- `@next / @back / @submit` (-，默认 -)：流程回调",
  "files": [
    {
      "path": "components/ui/stepper-form/VaStepperForm.vue",
      "type": "registry:ui",
      "target": "components/ui/stepper-form/VaStepperForm.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, ref } from \"vue\";\nimport type { StepperFormEvents, StepperFormProps } from \"./types\";\nimport { VaProgressTracker } from \"../progress-tracker\";\n\nconst props = defineProps<StepperFormProps>();\n\nconst emit = defineEmits<StepperFormEvents>();\n\n/* 受控优先，touched 哨兵回落 defaultStep */\nconst touched = ref(false);\nconst innerStep = ref(props.defaultStep ?? 0);\nconst step = computed(() =>\n  props.step !== undefined || touched.value ? props.step ?? 0 : innerStep.value,\n);\n\nconst isLast = computed(() => step.value === props.steps.length - 1);\n\nfunction setStep(v: number) {\n  touched.value = true;\n  innerStep.value = v;\n  emit(\"update:step\", v);\n}\n\nfunction goNext() {\n  if (props.nextDisabled || props.submitting) return;\n  const prev = step.value;\n  if (isLast.value) {\n    emit(\"submit\", prev);\n    return;\n  }\n  emit(\"next\", prev);\n  setStep(prev + 1);\n}\n\nfunction goBack() {\n  if (step.value <= 0) return;\n  const prev = step.value;\n  emit(\"back\", prev);\n  setStep(prev - 1);\n}\n</script>\n\n<template>\n  <form class=\"va-sf\" @submit.prevent=\"goNext\">\n    <VaProgressTracker\n      class=\"va-sf__tracker\"\n      :steps=\"steps.map((s) => ({ label: s.title }))\"\n      :current=\"step\"\n      @select=\"(i) => i < step && setStep(i)\"\n    />\n\n    <p v-if=\"steps[step]?.description\" class=\"va-sf__desc\">{{ steps[step]!.description }}</p>\n\n    <!-- 每步内容：宿主用 <template #step-{id}> 提供对应内容 -->\n    <div class=\"va-sf__body\">\n      <slot :name=\"`step-${steps[step]?.id}`\" :step=\"step\" />\n    </div>\n\n    <footer class=\"va-sf__foot\">\n      <button\n        class=\"va-sf__btn\"\n        type=\"button\"\n        :disabled=\"step <= 0\"\n        @click=\"goBack\"\n      >{{ props.backLabel ?? \"上一步\" }}</button>\n      <span class=\"va-sf__spacer\" />\n      <span class=\"va-sf__pos\">{{ step + 1 }} / {{ steps.length }}</span>\n      <button\n        class=\"va-sf__btn va-sf__btn--primary\"\n        type=\"submit\"\n        :disabled=\"props.nextDisabled || props.submitting\"\n      >\n        {{ isLast ? (props.submitting ? \"提交中…\" : (props.finishLabel ?? \"提交\")) : (props.nextLabel ?? \"下一步\") }}\n      </button>\n    </footer>\n  </form>\n</template>\n\n<style>\n/* VaStepperForm — 分步表单壳 */\n\n.va-sf {\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s5);\n}\n\n.va-sf__desc {\n  margin: 0;\n  font-size: 12.5px;\n  color: var(--va-muted);\n}\n\n.va-sf__body { min-height: 80px; }\n\n.va-sf__foot {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3);\n  padding-top: var(--va-s4);\n  border-top: 1px solid var(--va-edge);\n}\n\n.va-sf__spacer { flex: 1; }\n\n.va-sf__pos {\n  font-size: 12px;\n  color: var(--va-muted);\n  font-variant-numeric: tabular-nums;\n  margin-right: var(--va-s2);\n}\n\n.va-sf__btn {\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-card);\n  color: var(--va-ink-2);\n  font-size: 13px;\n  padding: 7px 16px;\n  cursor: pointer;\n  transition: border-color var(--va-dur-1) var(--va-ease), background var(--va-dur-1) var(--va-ease);\n}\n\n.va-sf__btn:hover:not(:disabled) { border-color: var(--va-edge-strong); }\n.va-sf__btn:disabled { opacity: 0.45; cursor: default; }\n.va-sf__btn:focus-visible { outline: 2px solid var(--va-accent); outline-offset: 1px; }\n\n.va-sf__btn--primary {\n  background: var(--va-accent);\n  border-color: var(--va-accent);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-sf__btn--primary:hover:not(:disabled) { background: var(--va-accent-hover); }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-sf__btn { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/stepper-form/types.ts",
      "type": "registry:ui",
      "target": "components/ui/stepper-form/types.ts",
      "content": "/** VaStepperForm 的类型定义 */\n\nexport interface StepperStep {\n  id: string;\n  title: string;\n  /** 步骤简述（步骤条下的小字） */\n  description?: string;\n}\n\nexport interface StepperFormProps {\n  steps: StepperStep[];\n  /** 受控当前步下标（配合 @update:step 实现 v-model:step） */\n  step?: number;\n  /** 非受控初始步 */\n  defaultStep?: number;\n  /** 禁用\"下一步/提交\"（宿主校验未通过时） */\n  nextDisabled?: boolean;\n  /** 提交进行中（最后一步按钮转\"提交中…\"） */\n  submitting?: boolean;\n  /** 上一步按钮文案 */\n  backLabel?: string;\n  nextLabel?: string;\n  /** 最后一步按钮文案，默认\"提交\" */\n  finishLabel?: string;\n}\n\nexport interface StepperFormEvents {\n  \"update:step\": [index: number];\n  /** 进入下一步前（prev 为离开的步下标；可在此做校验副作用） */\n  next: [prev: number];\n  back: [prev: number];\n  /** 最后一步点提交（携带当前步下标） */\n  submit: [current: number];\n}\n"
    }
  ]
}
