{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "session-manager",
  "title": "Session Manager",
  "description": "会话管理下拉：活跃/归档分组、新建、行内重命名、归档恢复与二次确认删除。",
  "type": "registry:ui",
  "dependencies": [
    "lucide-vue-next"
  ],
  "registryDependencies": [],
  "docs": "- `sessions` (SessionItem[]，默认 -)：id/title/createdAt/updatedAt/archived\n- `activeId` (string，默认 -)：当前会话\n- `@select/@create/@rename/@archive/@remove` (-，默认 -)：生命周期回调（删除已二次确认）",
  "files": [
    {
      "path": "components/ui/session-manager/VaSessionManager.vue",
      "type": "registry:ui",
      "target": "components/ui/session-manager/VaSessionManager.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, onBeforeUnmount, onMounted, ref, useTemplateRef } from \"vue\";\nimport { Archive, ArchiveRestore, Check, ChevronDown, Pen, Plus, Trash2, X } from \"lucide-vue-next\";\nimport type { SessionItem, SessionManagerEvents, SessionManagerProps } from \"./types\";\n\nconst props = withDefaults(defineProps<SessionManagerProps>(), {\n  disabled: false,\n  ariaLabel: \"会话管理\",\n});\n\nconst emit = defineEmits<SessionManagerEvents>();\n\nconst open = ref(false);\nconst rootEl = useTemplateRef<HTMLElement>(\"root\");\n\nfunction toggle() {\n  if (props.disabled) return;\n  open.value = !open.value;\n  if (!open.value) resetEdits();\n}\n\n/** Esc 关闭 + 点击外部关闭（SSR 安全：onMounted 内挂） */\nfunction onDocMousedown(e: MouseEvent) {\n  if (open.value && rootEl.value && !rootEl.value.contains(e.target as Node)) {\n    open.value = false;\n    resetEdits();\n  }\n}\nfunction onDocKeydown(e: KeyboardEvent) {\n  if (e.key === \"Escape\" && open.value) {\n    open.value = false;\n    resetEdits();\n  }\n}\nonMounted(() => {\n  if (typeof document === \"undefined\") return;\n  document.addEventListener(\"mousedown\", onDocMousedown);\n  document.addEventListener(\"keydown\", onDocKeydown);\n});\nonBeforeUnmount(() => {\n  if (typeof document === \"undefined\") return;\n  document.removeEventListener(\"mousedown\", onDocMousedown);\n  document.removeEventListener(\"keydown\", onDocKeydown);\n});\n\n/* 行内重命名 */\nconst editingId = ref<string | null>(null);\nconst draft = ref(\"\");\nfunction startRename(s: SessionItem) {\n  editingId.value = s.id;\n  draft.value = s.title || \"未命名会话\";\n}\nfunction commitRename() {\n  if (editingId.value) {\n    const t = draft.value.trim();\n    if (t && t !== (props.sessions.find((x) => x.id === editingId.value)?.title ?? \"\")) {\n      emit(\"rename\", editingId.value, t);\n    }\n  }\n  editingId.value = null;\n}\nfunction cancelRename() {\n  editingId.value = null;\n}\n\n/* 删除二次确认 */\nconst confirmId = ref<string | null>(null);\nfunction askRemove(id: string) {\n  if (confirmId.value === id) {\n    emit(\"remove\", id);\n    confirmId.value = null;\n  } else {\n    confirmId.value = id;\n    window.setTimeout(() => {\n      if (confirmId.value === id) confirmId.value = null;\n    }, 3000);\n  }\n}\n\nfunction resetEdits() {\n  editingId.value = null;\n  confirmId.value = null;\n}\n\nfunction pick(s: SessionItem) {\n  if (s.id !== props.activeId) emit(\"select\", s.id);\n  open.value = false;\n  resetEdits();\n}\n\nfunction onCreate() {\n  emit(\"create\");\n  open.value = false;\n  resetEdits();\n}\n\nconst activeList = computed(() => props.sessions.filter((s) => !s.archived));\nconst archivedList = computed(() => props.sessions.filter((s) => s.archived));\n\nconst titleOf = (s: SessionItem) => s.title || \"未命名会话\";\nfunction fmtTime(ts: number): string {\n  const diff = Date.now() - ts;\n  if (diff < 60_000) return \"刚刚\";\n  if (diff < 3_600_000) return `${Math.floor(diff / 60_000)} 分钟前`;\n  if (diff < 86_400_000) return `${Math.floor(diff / 3_600_000)} 小时前`;\n  if (diff < 7 * 86_400_000) return `${Math.floor(diff / 86_400_000)} 天前`;\n  return new Date(ts).toLocaleDateString(\"zh-CN\");\n}\n</script>\n\n<template>\n  <div ref=\"root\" class=\"va-smn\">\n    <button\n      class=\"va-smn__trigger\"\n      type=\"button\"\n      :disabled=\"props.disabled\"\n      :aria-expanded=\"open\"\n      :aria-label=\"props.ariaLabel\"\n      @click=\"toggle\"\n    >\n      会话\n      <ChevronDown :size=\"14\" aria-hidden=\"true\" />\n    </button>\n\n    <div v-if=\"open\" class=\"va-smn__panel\" role=\"dialog\" :aria-label=\"props.ariaLabel\">\n      <header class=\"va-smn__head\">\n        <span class=\"va-smn__head-title\">会话</span>\n        <button class=\"va-smn__new\" type=\"button\" @click=\"onCreate\"><Plus :size=\"14\" aria-hidden=\"true\" />新建</button>\n      </header>\n\n      <div class=\"va-smn__list\">\n        <template v-if=\"activeList.length\">\n          <div v-for=\"s in activeList\" :key=\"s.id\" class=\"va-smn__row\" :data-active=\"s.id === props.activeId || undefined\">\n            <template v-if=\"editingId === s.id\">\n              <input\n                v-model=\"draft\"\n                class=\"va-smn__input\"\n                type=\"text\"\n                @keydown.enter.prevent=\"commitRename\"\n                @keydown.escape.prevent=\"cancelRename\"\n              />\n              <button class=\"va-smn__op\" type=\"button\" @click=\"commitRename\"><Check :size=\"14\" /></button>\n              <button class=\"va-smn__op\" type=\"button\" @click=\"cancelRename\"><X :size=\"14\" /></button>\n            </template>\n            <template v-else>\n              <button class=\"va-smn__main\" type=\"button\" :title=\"titleOf(s)\" @click=\"pick(s)\">\n                <span class=\"va-smn__title\">{{ titleOf(s) }}</span>\n                <span class=\"va-smn__time\">{{ fmtTime(s.updatedAt) }}</span>\n              </button>\n              <button class=\"va-smn__op\" type=\"button\" aria-label=\"重命名\" @click.stop=\"startRename(s)\"><Pen :size=\"13\" /></button>\n              <button class=\"va-smn__op\" type=\"button\" aria-label=\"归档\" @click.stop=\"emit('archive', s.id, true)\"><Archive :size=\"13\" /></button>\n              <button\n                class=\"va-smn__op\"\n                type=\"button\"\n                :data-danger=\"confirmId === s.id || undefined\"\n                :aria-label=\"confirmId === s.id ? '确认删除' : '删除'\"\n                @click.stop=\"askRemove(s.id)\"\n              ><span v-if=\"confirmId === s.id\" class=\"va-smn__confirm\">确认?</span><Trash2 v-else :size=\"13\" /></button>\n            </template>\n          </div>\n        </template>\n        <p v-else class=\"va-smn__empty\">还没有会话，点「＋ 新建」开始。</p>\n\n        <template v-if=\"archivedList.length\">\n          <div class=\"va-smn__group\">已归档</div>\n          <div v-for=\"s in archivedList\" :key=\"s.id\" class=\"va-smn__row\" :data-archived=\"true\">\n            <template v-if=\"editingId === s.id\">\n              <input v-model=\"draft\" class=\"va-smn__input\" type=\"text\" @keydown.enter.prevent=\"commitRename\" @keydown.escape.prevent=\"cancelRename\" />\n              <button class=\"va-smn__op\" type=\"button\" @click=\"commitRename\"><Check :size=\"14\" /></button>\n              <button class=\"va-smn__op\" type=\"button\" @click=\"cancelRename\"><X :size=\"14\" /></button>\n            </template>\n            <template v-else>\n              <span class=\"va-smn__main va-smn__main--static\">\n                <span class=\"va-smn__title\">{{ titleOf(s) }}</span>\n                <span class=\"va-smn__time\">{{ fmtTime(s.updatedAt) }}</span>\n              </span>\n              <button class=\"va-smn__op\" type=\"button\" aria-label=\"恢复\" @click.stop=\"emit('archive', s.id, false)\"><ArchiveRestore :size=\"13\" /></button>\n              <button\n                class=\"va-smn__op\"\n                type=\"button\"\n                :data-danger=\"confirmId === s.id || undefined\"\n                @click.stop=\"askRemove(s.id)\"\n              ><span v-if=\"confirmId === s.id\" class=\"va-smn__confirm\">确认?</span><Trash2 v-else :size=\"13\" /></button>\n            </template>\n          </div>\n        </template>\n      </div>\n    </div>\n  </div>\n</template>\n\n<style>\n/* VaSessionManager — 顶栏会话管理下拉 */\n.va-smn { position: relative; display: inline-flex; font-family: var(--va-font, system-ui, sans-serif); }\n\n.va-smn__trigger {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  height: 26px;\n  padding: 0 var(--va-s3, 8px);\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-pill, 999px);\n  background: var(--va-card, #fff);\n  color: var(--va-ink-2, #43413c);\n  font-size: 12px;\n  font-family: inherit;\n  cursor: pointer;\n  transition: border-color var(--va-dur-1, 120ms) ease, opacity var(--va-dur-1, 120ms) ease;\n}\n.va-smn__trigger:hover:not(:disabled) { border-color: var(--va-edge-strong, rgba(26, 25, 23, 0.22)); }\n.va-smn__trigger:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: 1px; }\n.va-smn__trigger:disabled { opacity: 0.5; cursor: default; }\n.va-smn__trigger svg { width: 14px; height: 14px; color: var(--va-muted, #6f6d66); }\n\n.va-smn__panel {\n  position: absolute;\n  top: calc(100% + 8px);\n  left: 0;\n  z-index: 40;\n  width: 300px;\n  background: var(--va-card, #fff);\n  border: 1px solid var(--va-edge-strong, rgba(26, 25, 23, 0.22));\n  border-radius: var(--va-radius-m, 10px);\n  box-shadow: var(--va-shadow-2, none);\n  padding: var(--va-s2, 4px);\n  animation: va-smn-in var(--va-dur-1, 120ms) var(--va-ease, ease);\n}\n@keyframes va-smn-in {\n  from { opacity: 0; transform: translateY(-4px); }\n}\n\n.va-smn__head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: var(--va-s2, 4px) var(--va-s3, 8px) var(--va-s3, 8px);\n  border-bottom: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  margin-bottom: var(--va-s2, 4px);\n}\n.va-smn__head-title { font-size: 13px; font-weight: 700; color: var(--va-ink, #1a1917); }\n\n.va-smn__new {\n  display: inline-flex;\n  align-items: center;\n  gap: 3px;\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-s, 8px);\n  background: var(--va-accent-soft, rgba(194, 65, 12, 0.1));\n  color: var(--va-accent, #c2410c);\n  font-size: 12px;\n  font-family: inherit;\n  padding: 3px 8px;\n  cursor: pointer;\n}\n.va-smn__new:hover { border-color: var(--va-accent, #c2410c); }\n.va-smn__new:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: -2px; }\n\n.va-smn__list { max-height: 380px; overflow-y: auto; display: flex; flex-direction: column; gap: 2px; }\n\n.va-smn__group {\n  font-size: 11px;\n  color: var(--va-muted, #6f6d66);\n  padding: 8px var(--va-s3, 8px) 2px;\n}\n\n.va-smn__row {\n  display: flex;\n  align-items: center;\n  gap: 2px;\n  border-radius: var(--va-radius-s, 8px);\n}\n.va-smn__row:hover { background: var(--va-bg-subtle, #efede7); }\n.va-smn__row[data-active=\"true\"] { background: var(--va-accent-soft, rgba(194, 65, 12, 0.08)); }\n.va-smn__row[data-archived=\"true\"] { opacity: 0.65; }\n\n.va-smn__main {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  border: 0;\n  background: none;\n  font: inherit;\n  text-align: left;\n  padding: 6px var(--va-s3, 8px);\n  cursor: pointer;\n  border-radius: var(--va-radius-s, 8px);\n}\n.va-smn__main--static { cursor: default; }\n.va-smn__main:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: -2px; }\n\n.va-smn__title {\n  font-size: 12.5px;\n  color: var(--va-ink, #1a1917);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.va-smn__row[data-active=\"true\"] .va-smn__title { font-weight: 600; color: var(--va-accent, #c2410c); }\n\n.va-smn__time { flex: none; font-size: 10.5px; color: var(--va-muted, #6f6d66); }\n\n.va-smn__op {\n  flex: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border: 0;\n  background: none;\n  font-size: 11px;\n  padding: 3px 4px;\n  border-radius: var(--va-radius-s, 8px);\n  cursor: pointer;\n  color: var(--va-muted, #6f6d66);\n}\n.va-smn__op:hover { background: var(--va-card, #fff); color: var(--va-ink, #1a1917); }\n.va-smn__op:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: -2px; }\n.va-smn__op[data-danger=\"true\"] { color: var(--va-danger, #d5484d); font-weight: 700; }\n.va-smn__confirm { white-space: nowrap; }\n\n.va-smn__input {\n  flex: 1;\n  min-width: 0;\n  border: 1px solid var(--va-accent, #c2410c);\n  border-radius: var(--va-radius-s, 8px);\n  background: var(--va-card, #fff);\n  color: var(--va-ink, #1a1917);\n  font: inherit;\n  font-size: 12.5px;\n  padding: 4px 8px;\n  margin: 2px 0 2px var(--va-s2, 4px);\n}\n.va-smn__input:focus-visible { outline: none; }\n\n.va-smn__empty { margin: 0; padding: 10px var(--va-s3, 8px); font-size: 12px; color: var(--va-muted, #6f6d66); }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-smn__panel { animation: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/session-manager/types.ts",
      "type": "registry:ui",
      "target": "components/ui/session-manager/types.ts",
      "content": "/** VaSessionManager 的类型定义（结构与协议 SessionMeta 保持一致） */\n\nexport interface SessionItem {\n  id: string;\n  /** 空串 = 未命名 */\n  title: string;\n  createdAt: number;\n  updatedAt: number;\n  archived: boolean;\n}\n\nexport interface SessionManagerProps {\n  sessions: SessionItem[];\n  /** 当前活跃会话 id */\n  activeId: string;\n  disabled?: boolean;\n  ariaLabel?: string;\n}\n\nexport interface SessionManagerEvents {\n  /** 点击行（非当前会话）→ 切换 */\n  select: [id: string];\n  /** 新建会话 */\n  create: [];\n  /** 重命名完成 */\n  rename: [id: string, title: string];\n  /** 归档（true）/ 恢复（false） */\n  archive: [id: string, archived: boolean];\n  /** 删除（面板内已二次确认） */\n  remove: [id: string];\n}\n"
    }
  ]
}
