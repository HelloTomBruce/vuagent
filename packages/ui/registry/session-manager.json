{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "session-manager",
  "title": "Session Manager",
  "description": "会话管理下拉：活跃/归档分组、新建、行内重命名、归档恢复与二次确认删除。",
  "type": "registry:ui",
  "dependencies": [
    "lucide-vue-next"
  ],
  "registryDependencies": [],
  "docs": "- `sessions` (SessionItem[]，默认 -)：id/title/createdAt/updatedAt/archived\n- `activeId` (string，默认 -)：当前会话\n- `@select/@create/@rename/@archive/@remove` (-，默认 -)：生命周期回调（删除已二次确认）",
  "files": [
    {
      "path": "components/ui/session-manager/VaSessionManager.vue",
      "type": "registry:ui",
      "target": "components/ui/session-manager/VaSessionManager.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, onBeforeUnmount, onMounted, ref, useTemplateRef } from \"vue\";\nimport { Archive, ArchiveRestore, Check, ChevronDown, Pen, Plus, Trash2, X } from \"lucide-vue-next\";\nimport type { SessionItem, SessionManagerEvents, SessionManagerProps } from \"./types\";\n\nconst props = withDefaults(defineProps<SessionManagerProps>(), {\n  disabled: false,\n  ariaLabel: \"会话管理\",\n});\n\nconst emit = defineEmits<SessionManagerEvents>();\n\nconst open = ref(false);\nconst rootEl = useTemplateRef<HTMLElement>(\"root\");\n\nfunction toggle() {\n  if (props.disabled) return;\n  open.value = !open.value;\n  if (!open.value) resetEdits();\n}\n\n/** Esc 关闭 + 点击外部关闭（SSR 安全：onMounted 内挂） */\nfunction onDocMousedown(e: MouseEvent) {\n  if (open.value && rootEl.value && !rootEl.value.contains(e.target as Node)) {\n    open.value = false;\n    resetEdits();\n  }\n}\nfunction onDocKeydown(e: KeyboardEvent) {\n  if (e.key === \"Escape\" && open.value) {\n    open.value = false;\n    resetEdits();\n  }\n}\nonMounted(() => {\n  if (typeof document === \"undefined\") return;\n  document.addEventListener(\"mousedown\", onDocMousedown);\n  document.addEventListener(\"keydown\", onDocKeydown);\n});\nonBeforeUnmount(() => {\n  if (typeof document === \"undefined\") return;\n  document.removeEventListener(\"mousedown\", onDocMousedown);\n  document.removeEventListener(\"keydown\", onDocKeydown);\n});\n\n/* 行内重命名 */\nconst editingId = ref<string | null>(null);\nconst draft = ref(\"\");\nfunction startRename(s: SessionItem) {\n  editingId.value = s.id;\n  draft.value = s.title || \"未命名会话\";\n}\nfunction commitRename() {\n  if (editingId.value) {\n    const t = draft.value.trim();\n    if (t && t !== (props.sessions.find((x) => x.id === editingId.value)?.title ?? \"\")) {\n      emit(\"rename\", editingId.value, t);\n    }\n  }\n  editingId.value = null;\n}\nfunction cancelRename() {\n  editingId.value = null;\n}\n\n/* 删除二次确认 */\nconst confirmId = ref<string | null>(null);\nfunction askRemove(id: string) {\n  if (confirmId.value === id) {\n    emit(\"remove\", id);\n    confirmId.value = null;\n  } else {\n    confirmId.value = id;\n    window.setTimeout(() => {\n      if (confirmId.value === id) confirmId.value = null;\n    }, 3000);\n  }\n}\n\nfunction resetEdits() {\n  editingId.value = null;\n  confirmId.value = null;\n}\n\nfunction pick(s: SessionItem) {\n  if (s.id !== props.activeId) emit(\"select\", s.id);\n  open.value = false;\n  resetEdits();\n}\n\nfunction onCreate() {\n  emit(\"create\");\n  open.value = false;\n  resetEdits();\n}\n\nconst activeList = computed(() => props.sessions.filter((s) => !s.archived));\nconst archivedList = computed(() => props.sessions.filter((s) => s.archived));\n\nconst titleOf = (s: SessionItem) => s.title || \"未命名会话\";\nfunction fmtTime(ts: number): string {\n  const diff = Date.now() - ts;\n  if (diff < 60_000) return \"刚刚\";\n  if (diff < 3_600_000) return `${Math.floor(diff / 60_000)} 分钟前`;\n  if (diff < 86_400_000) return `${Math.floor(diff / 3_600_000)} 小时前`;\n  if (diff < 7 * 86_400_000) return `${Math.floor(diff / 86_400_000)} 天前`;\n  return new Date(ts).toLocaleDateString(\"zh-CN\");\n}\n</script>\n\n<template>\n  <div ref=\"root\" class=\"va-smn\">\n    <button\n      class=\"va-smn__trigger\"\n      type=\"button\"\n      :disabled=\"props.disabled\"\n      :aria-expanded=\"open\"\n      :aria-label=\"props.ariaLabel\"\n      @click=\"toggle\"\n    >\n      会话\n      <ChevronDown :size=\"14\" aria-hidden=\"true\" />\n    </button>\n\n    <div v-if=\"open\" class=\"va-smn__panel\" role=\"dialog\" :aria-label=\"props.ariaLabel\">\n      <header class=\"va-smn__head\">\n        <span class=\"va-smn__head-title\">会话</span>\n        <button class=\"va-smn__new\" type=\"button\" @click=\"onCreate\"><Plus :size=\"14\" aria-hidden=\"true\" />新建</button>\n      </header>\n\n      <div class=\"va-smn__list\">\n        <template v-if=\"activeList.length\">\n          <div v-for=\"s in activeList\" :key=\"s.id\" class=\"va-smn__row\" :data-active=\"s.id === props.activeId || undefined\">\n            <template v-if=\"editingId === s.id\">\n              <input\n                v-model=\"draft\"\n                class=\"va-smn__input\"\n                type=\"text\"\n                @keydown.enter.prevent=\"commitRename\"\n                @keydown.escape.prevent=\"cancelRename\"\n              />\n              <button class=\"va-smn__op\" type=\"button\" @click=\"commitRename\"><Check :size=\"14\" /></button>\n              <button class=\"va-smn__op\" type=\"button\" @click=\"cancelRename\"><X :size=\"14\" /></button>\n            </template>\n            <template v-else>\n              <button class=\"va-smn__main\" type=\"button\" :title=\"titleOf(s)\" @click=\"pick(s)\">\n                <span class=\"va-smn__title\">{{ titleOf(s) }}</span>\n                <span class=\"va-smn__time\">{{ fmtTime(s.updatedAt) }}</span>\n              </button>\n              <button class=\"va-smn__op\" type=\"button\" aria-label=\"重命名\" @click.stop=\"startRename(s)\"><Pen :size=\"13\" /></button>\n              <button class=\"va-smn__op\" type=\"button\" aria-label=\"归档\" @click.stop=\"emit('archive', s.id, true)\"><Archive :size=\"13\" /></button>\n              <button\n                class=\"va-smn__op\"\n                type=\"button\"\n                :data-danger=\"confirmId === s.id || undefined\"\n                :aria-label=\"confirmId === s.id ? '确认删除' : '删除'\"\n                @click.stop=\"askRemove(s.id)\"\n              ><span v-if=\"confirmId === s.id\" class=\"va-smn__confirm\">确认?</span><Trash2 v-else :size=\"13\" /></button>\n            </template>\n          </div>\n        </template>\n        <p v-else class=\"va-smn__empty va-fade-in\">还没有会话，点「＋ 新建」开始。</p>\n\n        <template v-if=\"archivedList.length\">\n          <div class=\"va-smn__group\">已归档</div>\n          <div v-for=\"s in archivedList\" :key=\"s.id\" class=\"va-smn__row\" :data-archived=\"true\">\n            <template v-if=\"editingId === s.id\">\n              <input v-model=\"draft\" class=\"va-smn__input\" type=\"text\" @keydown.enter.prevent=\"commitRename\" @keydown.escape.prevent=\"cancelRename\" />\n              <button class=\"va-smn__op\" type=\"button\" @click=\"commitRename\"><Check :size=\"14\" /></button>\n              <button class=\"va-smn__op\" type=\"button\" @click=\"cancelRename\"><X :size=\"14\" /></button>\n            </template>\n            <template v-else>\n              <span class=\"va-smn__main va-smn__main--static\">\n                <span class=\"va-smn__title\">{{ titleOf(s) }}</span>\n                <span class=\"va-smn__time\">{{ fmtTime(s.updatedAt) }}</span>\n              </span>\n              <button class=\"va-smn__op\" type=\"button\" aria-label=\"恢复\" @click.stop=\"emit('archive', s.id, false)\"><ArchiveRestore :size=\"13\" /></button>\n              <button\n                class=\"va-smn__op\"\n                type=\"button\"\n                :data-danger=\"confirmId === s.id || undefined\"\n                @click.stop=\"askRemove(s.id)\"\n              ><span v-if=\"confirmId === s.id\" class=\"va-smn__confirm\">确认?</span><Trash2 v-else :size=\"13\" /></button>\n            </template>\n          </div>\n        </template>\n      </div>\n    </div>\n  </div>\n</template>\n\n<style>\n/* VaSessionManager — 顶栏会话管理下拉 */\n.va-smn { position: relative; display: inline-flex; font-family: var(--va-font, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Helvetica Neue\", sans-serif); }\n\n.va-smn__trigger {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  height: 26px;\n  padding: 0 var(--va-s3, 8px);\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-pill, 999px);\n  background: var(--va-card, #ffffff);\n  color: var(--va-ink-2, #43413c);\n  font-size: var(--va-fs-sm, 12px);\n  font-family: inherit;\n  cursor: pointer;\n  transition: border-color var(--va-dur-1, 120ms) ease, opacity var(--va-dur-1, 120ms) ease;\n}\n.va-smn__trigger:hover:not(:disabled) { border-color: var(--va-edge-strong, rgba(26, 25, 23, 0.22)); }\n.va-smn__trigger:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: 1px; }\n.va-smn__trigger:disabled { opacity: 0.5; cursor: default; }\n.va-smn__trigger svg { width: 14px; height: 14px; color: var(--va-muted, #6f6d66); }\n\n.va-smn__panel {\n  position: absolute;\n  top: calc(100% + 8px);\n  left: 0;\n  z-index: 40;\n  width: 300px;\n  background: var(--va-card, #ffffff);\n  border: 1px solid var(--va-edge-strong, rgba(26, 25, 23, 0.22));\n  border-radius: var(--va-radius-m, 10px);\n  box-shadow: var(--va-shadow-2, 0 4px 12px rgba(26, 25, 23, 0.08));\n  padding: var(--va-s2, 4px);\n  animation: va-smn-in var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n@keyframes va-smn-in {\n  from { opacity: 0; transform: translateY(-4px); }\n}\n\n.va-smn__head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: var(--va-s2, 4px) var(--va-s3, 8px) var(--va-s3, 8px);\n  border-bottom: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  margin-bottom: var(--va-s2, 4px);\n}\n.va-smn__head-title { font-size: var(--va-fs-md, 13px); font-weight: var(--va-fw-bold, 700); color: var(--va-ink, #1a1917); }\n\n.va-smn__new {\n  display: inline-flex;\n  align-items: center;\n  gap: 3px;\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-s, 8px);\n  background: var(--va-accent-soft, rgba(194, 65, 12, 0.1));\n  color: var(--va-accent, #c2410c);\n  font-size: var(--va-fs-sm, 12px);\n  font-family: inherit;\n  padding: 3px 8px;\n  cursor: pointer;\n}\n.va-smn__new:hover { border-color: var(--va-accent, #c2410c); }\n.va-smn__new:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: -2px; }\n\n.va-smn__list { max-height: 380px; overflow-y: auto; display: flex; flex-direction: column; gap: 2px; }\n\n.va-smn__group {\n  font-size: var(--va-fs-xs, 11px);\n  color: var(--va-muted, #6f6d66);\n  padding: 8px var(--va-s3, 8px) 2px;\n}\n\n.va-smn__row {\n  display: flex;\n  align-items: center;\n  gap: 2px;\n  border-radius: var(--va-radius-s, 8px);\n}\n.va-smn__row:hover { background: var(--va-bg-subtle, #efede7); }\n/* 按压口径（行级分轨）：表面朝 ink 混 15% 加深（方向随主题自适应） */\n.va-smn__row:active { background: color-mix(in srgb, var(--va-bg-subtle, #efede7) 85%, var(--va-ink, #1a1917)); }\n.va-smn__row[data-active=\"true\"] { background: var(--va-accent-soft, rgba(194, 65, 12, 0.1)); }\n/* 选中行按压：保持 accent 色相加深（不跳中性灰） */\n.va-smn__row[data-active=\"true\"]:active { background: color-mix(in srgb, var(--va-accent-soft, rgba(194, 65, 12, 0.1)) 85%, var(--va-ink, #1a1917)); }\n.va-smn__row[data-archived=\"true\"] { opacity: 0.65; }\n\n.va-smn__main {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  border: 0;\n  background: none;\n  font: inherit;\n  text-align: left;\n  padding: var(--va-s3h, 6px) var(--va-s3, 8px);\n  cursor: pointer;\n  border-radius: var(--va-radius-s, 8px);\n}\n.va-smn__main--static { cursor: default; }\n.va-smn__main:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: -2px; }\n\n.va-smn__title {\n  font-size: var(--va-fs-md, 13px);\n  color: var(--va-ink, #1a1917);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.va-smn__row[data-active=\"true\"] .va-smn__title { font-weight: var(--va-fw-semibold, 600); color: var(--va-accent, #c2410c); }\n\n.va-smn__time { flex: none; font-size: var(--va-fs-xs, 11px); color: var(--va-muted, #6f6d66); }\n\n.va-smn__op {\n  flex: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border: 0;\n  background: none;\n  font-size: var(--va-fs-xs, 11px);\n  padding: 3px 4px;\n  border-radius: var(--va-radius-s, 8px);\n  cursor: pointer;\n  color: var(--va-muted, #6f6d66);\n}\n.va-smn__op:hover { background: var(--va-card, #ffffff); color: var(--va-ink, #1a1917); }\n.va-smn__op:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: -2px; }\n.va-smn__op[data-danger=\"true\"] { color: var(--va-danger, #d5453c); font-weight: var(--va-fw-bold, 700); }\n.va-smn__confirm { white-space: nowrap; }\n\n.va-smn__input {\n  flex: 1;\n  min-width: 0;\n  border: 1px solid var(--va-accent, #c2410c);\n  border-radius: var(--va-radius-s, 8px);\n  background: var(--va-card, #ffffff);\n  color: var(--va-ink, #1a1917);\n  font: inherit;\n  font-size: var(--va-fs-md, 13px);\n  padding: 4px 8px;\n  margin: 2px 0 2px var(--va-s2, 4px);\n}\n.va-smn__input:focus-visible { outline: none; }\n\n.va-smn__empty { margin: 0; padding: var(--va-s4h, 10px) var(--va-s3, 8px); font-size: var(--va-fs-sm, 12px); color: var(--va-muted, #6f6d66); }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-smn__panel { animation: none; }\n}\n\n/* 动效工具类（自动附带，源码中来自全局 motion.css） */\n/* ============================================================\n   共享动效工具类 —— 进出场/交叉淡入的统一协议（TASK-102 动效基建）。\n   组件不逐个发明入场曲线：统一消费 --va-dur-in/--va-dur-out 骨架时长与\n   --va-dist-* 位移档；每条声明自带字面 fallback（registry 单文件拷贝分发\n   要求，与 tokens.css 门禁一致）。\n\n   接入方式二选一：\n   1. Vue <Transition>：\n      <Transition enter-active-class=\"va-enter-up\" leave-active-class=\"va-exit-up\">\n      动画 fill-mode 为 both（延迟期间保持首帧、播完停在终态），\n      无需再配 enter-from-class / leave-to-class；\n   2. 类切换重挂载：骨架 → 内容换节点时给新节点挂 .va-crossfade（纯淡入），\n      离场节点挂 .va-exit-*（更短更快）。\n\n   列表错峰：v-for 子项 :style=\"useStagger().delayStyle(i)\" 配合 .va-enter-*\n   动画类使用（animation-delay 由 composable 编排——.va-enter-* 为 CSS animation，\n   transition-delay 对其零作用，见 composables/useStagger.ts）。\n   ============================================================ */\n\n/* 入场：上浮（自下方 --va-dist-m 浮起） */\n@keyframes va-motion-in-up {\n  from { opacity: 0; transform: translateY(var(--va-dist-m, 8px)); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* 入场：左滑（自左侧 --va-dist-m 滑入） */\n@keyframes va-motion-in-left {\n  from { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n  to { opacity: 1; transform: translateX(0); }\n}\n\n/* 入场：缩放（96% 起放大至原尺寸） */\n@keyframes va-motion-in-scale {\n  from { opacity: 0; transform: scale(0.96); }\n  to { opacity: 1; transform: scale(1); }\n}\n\n/* 离场：与入场互逆（向上/向左飘出、缩回）；时长/曲线由工具类映射 --va-dur-out 骨架 */\n@keyframes va-motion-out-up {\n  from { opacity: 1; transform: translateY(0); }\n  to { opacity: 0; transform: translateY(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-left {\n  from { opacity: 1; transform: translateX(0); }\n  to { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-scale {\n  from { opacity: 1; transform: scale(1); }\n  to { opacity: 0; transform: scale(0.96); }\n}\n\n/* 交叉淡入/淡出（.va-crossfade 骨架→内容交换专用，无位移，避免占位跳变叠加） */\n@keyframes va-motion-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes va-motion-fade-out {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n/* ---- 工具类：入场走 --va-dur-in + ease-out-quart，离场走 --va-dur-out + ease-in-quad ---- */\n\n.va-enter-up {\n  animation: va-motion-in-up var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-left {\n  animation: va-motion-in-left var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-scale {\n  animation: va-motion-in-scale var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-exit-up {\n  animation: va-motion-out-up var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-left {\n  animation: va-motion-out-left var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-scale {\n  animation: va-motion-out-scale var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n/* 骨架 → 内容交叉过渡：新内容纯淡入 */\n.va-crossfade {\n  animation: va-motion-fade-in var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* 空态/轻量状态渐入（TASK-106 弱化档）：仅 opacity、时长走 --va-dur-2，\n   供列表空态提示与一次性状态块使用（空态清单见 TASK-106 报告）。\n   纯 opacity 即动效分频策略的降级终点形态，reduced-motion 下保持原样即可。 */\n.va-fade-in {\n  animation: va-motion-fade-in var(--va-dur-2, 200ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* ---- 静态光斑基类（TASK-105，决策 5「追光」路线基建）----\n   pointer 坐标由 composables/useSpotlight.ts 以 rAF 节流写入 --va-spot-x/y\n   （元素内百分比，光斑数学在 composable 内可单测）；本类只负责 radial 光斑\n   绘制与显隐（:hover 点亮，无 3D 倾斜， glare 数学对齐 VaTiltCard）。\n   --va-spot-* 为 L3 组件钩子口径（宿主可覆盖尺寸/颜色），不进 tokens.css。\n   双降级对齐 VaTiltCard glare：hover: none（触屏）与 reduced-motion 不绘制。 */\n.va-spotlight { position: relative; }\n\n/* ::after 承载光斑（避开组件自身 ::before 用途）；inset 0 + border-radius inherit\n   使光斑天然裁剪在宿主圆角内，无需 overflow: hidden。\n   注意：此 ::after radial 与 components/spotlight-card/VaSpotlightCard.css 的\n   .va-spot-card--spot::after 为 registry 单文件自含有意复制，改动需两处同步。 */\n.va-spotlight::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n  background: radial-gradient(\n    var(--va-spot-size, 240px) circle at var(--va-spot-x, 50%) var(--va-spot-y, 50%),\n    var(--va-spot-color, rgba(255, 255, 255, 0.14)),\n    transparent 65%\n  );\n}\n\n.va-spotlight:hover::after { opacity: 1; }\n\n@media (hover: none) {\n  .va-spotlight::after { display: none; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-spotlight::after { display: none; }\n}\n\n/* ---- 复制反馈标准（TASK-106）：copy→check 交叉过渡 ----\n   容器 .va-copy 为 inline-grid 双内容同格堆叠（格子宽取较宽子项，切换零跳动）：\n   __idle = copy 态内容（图标/文字），__done = check 态内容。\n   copied 置真挂 .va-copy--done：check 以 ease-spring 微弹入场（进入 done 态时\n   transform 的目标态时序换成 --va-ease-spring → 过冲回弹），交叉时长统一 --va-dur-1。\n   消费方：terminal-log（行复制）、code-diff（复制按钮）、message-actions（复制图标）。 */\n.va-copy { display: inline-grid; place-items: center; }\n\n.va-copy__idle,\n.va-copy__done {\n  grid-area: 1 / 1;\n  transition: opacity var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-copy__idle { opacity: 1; transform: scale(1); }\n.va-copy__done { opacity: 0; transform: scale(0.6); }\n\n.va-copy--done .va-copy__done {\n  opacity: 1;\n  transform: scale(1);\n  /* 时序按 transition 属性顺序映射：opacity 仍 ease，transform 换 ease-spring 微弹 */\n  transition-timing-function: var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), var(--va-ease-spring, cubic-bezier(0.34, 1.56, 0.64, 1));\n}\n\n.va-copy--done .va-copy__idle { opacity: 0; transform: scale(0.6); }\n\n@media (prefers-reduced-motion: reduce) {\n  /* 交叉过渡瞬时完成（无位移动画），copied 状态可感知性不受影响 */\n  .va-copy__idle,\n  .va-copy__done { transition: none; }\n}\n\n/* ---- 错误反馈标准（校验失败横向微振）：目标元素挂 .va-shake 播一次 ±3px 微振 ----\n   时长 --va-dur-2 × 2（两拍四峰，克制的「摇头」量级，rubric 校验失败口径）；\n   重复触发需先移除类、强制 reflow 再挂回（封装见 composables/useShake.ts）。\n   reduced-motion 降级为不播：错误状态的可感知性由错误样式本身（描边/文案）承担，\n   动效只做注意力引导——符合头注释「功能动画降级保留状态可感知」的分频策略。\n   消费方：VaStepperForm / VaOtpInput 经 useShake() 程序化触发（defineExpose shake()）；\n   宿主自绘表单可直接挂类。 */\n@keyframes va-motion-shake {\n  20% { transform: translateX(-3px); }\n  40% { transform: translateX(3px); }\n  60% { transform: translateX(-2px); }\n  80% { transform: translateX(2px); }\n}\n\n.va-shake {\n  animation: va-motion-shake calc(var(--va-dur-2, 200ms) * 2) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-shake { animation: none; }\n}\n\n/* ---- 动效分频（对齐 tokens.css 头注释策略）：\n   功能动画降级为纯 opacity——进/出场整体