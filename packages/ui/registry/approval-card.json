{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "approval-card",
  "title": "Approval Card",
  "description": "审批门：风险徽章 + 命令预览 + 倒计时自动拒绝（悬停暂停）+ Enter/Esc 快捷键，决策后 morph 成结果行。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `title` (string，默认 -)：请求文案\n- `detail` (string，默认 -)：补充说明\n- `risk` (\"low\" | \"medium\" | \"high\"，默认 \"medium\")：风险等级徽章\n- `preview` (string，默认 -)：命令/代码预览\n- `confirmLabel` (string，默认 \"批准\")：批准按钮文案\n- `denyLabel` (string，默认 \"拒绝\")：拒绝按钮文案\n- `countdown` (number，默认 -)：秒数，到 0 自动拒绝\n- `shortcuts` (boolean，默认 true)：显示快捷键提示（Enter 批准 · Esc 拒绝）\n- `status` (\"approved\" | \"denied\" | \"pending\"，默认 -)：外部受控决策状态（持久化恢复）\n- `reason` (string，默认 -)：外部传入决策原因（超时或驳回说明）\n- `collapsible` (boolean，默认 true)：是否支持折叠展开\n- `defaultCollapsed` (boolean，默认 -)：默认折叠；不传时已决策默认折叠、未决策默认展开\n- `@approve / @deny` (-，默认 -)：决策回调（deny 带原因）",
  "files": [
    {
      "path": "components/ui/approval-card/VaApprovalCard.vue",
      "type": "registry:ui",
      "target": "components/ui/approval-card/VaApprovalCard.vue",
      "content": "<script setup lang=\"ts\">\nimport type { ApprovalRisk, ApprovalResult, DenyReason } from \"./types\";\nimport { useApprovalCard } from \"./useApprovalCard\";\n\ninterface ApprovalCardProps {\n  title: string;\n  detail?: string;\n  risk?: ApprovalRisk;\n  preview?: string;\n  confirmLabel?: string;\n  denyLabel?: string;\n  countdown?: number;\n  shortcuts?: boolean;\n  /** 外部传入状态持久化支持：\"approved\" | \"denied\" | \"pending\" */\n  status?: ApprovalResult | \"pending\";\n  /** 外部传入决策原因，例如超时或用户驳回说明 */\n  reason?: string;\n  /** 是否支持折叠展开，默认 true */\n  collapsible?: boolean;\n  /** 默认是否折叠，不传时若已决策默认折叠，未决策默认展开 */\n  defaultCollapsed?: boolean;\n}\n\nconst props = withDefaults(defineProps<ApprovalCardProps>(), {\n  detail: undefined,\n  preview: undefined,\n  risk: \"medium\",\n  confirmLabel: \"批准\",\n  denyLabel: \"拒绝\",\n  countdown: undefined,\n  shortcuts: true,\n  status: undefined,\n  reason: undefined,\n  collapsible: true,\n  defaultCollapsed: undefined,\n});\n\nconst emit = defineEmits<{ approve: []; deny: [reason?: DenyReason] }>();\n\nconst {\n  result,\n  denyReason,\n  paused,\n  percent,\n  remaining,\n  riskLabel,\n  isCollapsed,\n  toggleCollapse,\n  onApprove,\n  onDeny,\n  onKeydown,\n} = useApprovalCard(props, {\n  approve: () => emit(\"approve\"),\n  deny: (reason) => emit(\"deny\", reason),\n});\n</script>\n\n<template>\n  <div\n    class=\"va-acd\"\n    :class=\"[\n      `va-acd--${props.risk}`,\n      result ? `va-acd--${result}` : '',\n      isCollapsed ? 'va-acd--collapsed' : '',\n    ]\"\n    tabindex=\"-1\"\n    role=\"alertdialog\"\n    :aria-label=\"props.title\"\n    @keydown=\"onKeydown\"\n    @pointerenter=\"paused = true\"\n    @pointerleave=\"paused = false\"\n    @focusin=\"paused = true\"\n    @focusout=\"paused = false\"\n  >\n    <!-- 倒计时进度条 (仅未决策且未折叠时展示) -->\n    <div v-if=\"props.countdown && !result && !isCollapsed\" class=\"va-acd__count\" aria-hidden=\"true\">\n      <span class=\"va-acd__count-fill\" :style=\"{ width: `${percent}%` }\" />\n    </div>\n\n    <!-- 顶部状态与摘要栏 (支持点击折叠/展开) -->\n    <header\n      class=\"va-acd__head\"\n      :class=\"{ 'va-acd__head--clickable': props.collapsible !== false }\"\n      @click=\"props.collapsible !== false ? toggleCollapse() : null\"\n    >\n      <span class=\"va-acd__risk\" :data-risk=\"props.risk\">{{ riskLabel }}</span>\n      <h4 class=\"va-acd__title\">{{ props.title }}</h4>\n\n      <!-- 未决策时的倒计时提示 -->\n      <span\n        v-if=\"props.countdown && !result\"\n        class=\"va-acd__timer\"\n        role=\"timer\"\n        aria-live=\"off\"\n      >\n        {{ Math.ceil(remaining) }}s 后自动拒绝\n      </span>\n\n      <!-- 决策后的徽标状态 -->\n      <span v-else-if=\"result\" class=\"va-acd__status-badge\" :class=\"`va-acd__status-badge--${result}`\">\n        <svg v-if=\"result === 'approved'\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" aria-hidden=\"true\">\n          <path d=\"M5.5 12.5l4 4L18.5 8\" />\n        </svg>\n        <svg v-else viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\">\n          <path d=\"m7.5 7.5 9 9m0-9-9 9\" />\n        </svg>\n        <span>{{ result === \"approved\" ? \"已批准\" : denyReason === \"timeout\" ? \"超时已拒\" : \"已拒绝\" }}</span>\n      </span>\n\n      <!-- 折叠/展开切换按钮 -->\n      <button\n        v-if=\"props.collapsible !== false\"\n        class=\"va-acd__collapse-btn\"\n        type=\"button\"\n        :title=\"isCollapsed ? '展开详情' : '收起卡片'\"\n        @click.stop=\"toggleCollapse\"\n      >\n        <svg v-if=\"isCollapsed\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\">\n          <polyline points=\"6 9 12 15 18 9\" />\n        </svg>\n        <svg v-else viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\">\n          <polyline points=\"18 15 12 9 6 15\" />\n        </svg>\n      </button>\n    </header>\n\n    <!-- 可折叠正文主体 -->\n    <div v-show=\"!isCollapsed\" class=\"va-acd__main\">\n      <p v-if=\"props.detail\" class=\"va-acd__detail\">{{ props.detail }}</p>\n      <pre v-if=\"props.preview\" class=\"va-acd__preview\">{{ props.preview }}</pre>\n\n      <!-- 待审批交互按钮组 -->\n      <div v-if=\"!result\" class=\"va-acd__actions\">\n        <button class=\"va-act va-acd__btn\" type=\"button\" @click.stop=\"onDeny\">{{ props.denyLabel }}</button>\n        <button class=\"va-act va-act--ink va-acd__btn\" type=\"button\" @click.stop=\"onApprove\">{{ props.confirmLabel }}</button>\n        <span v-if=\"props.shortcuts && !result\" class=\"va-acd__kbd-hint\">\n          <kbd>Enter</kbd> 批准 · <kbd>Esc</kbd> 拒绝\n        </span>\n      </div>\n\n      <!-- 决策后的结果状态行 (展开时补充显示细节) -->\n      <div v-else class=\"va-acd__done\" role=\"status\">\n        <span>{{ result === \"approved\" ? \"已批准执行该操作\" : denyReason === \"timeout\" ? \"超时未响应，已自动拒绝\" : \"已拒绝执行该操作\" }}</span>\n        <span v-if=\"props.detail\" class=\"va-acd__done-detail\">{{ props.detail }}</span>\n      </div>\n    </div>\n  </div>\n</template>\n\n<style>\n/* VaApprovalCard — agent 的审批门 */\n.va-acd {\n  --_card: var(--va-acd-card, var(--va-card, #ffffff));\n  --_edge: var(--va-acd-edge, var(--va-edge, rgba(26, 25, 23, 0.12)));\n  --_ink: var(--va-acd-ink, var(--va-ink, #1a1917));\n  --_muted: var(--va-acd-muted, var(--va-muted, #6f6d66));\n  --_danger: var(--va-acd-danger, var(--va-danger, #d5453c));\n  --_risk: var(--va-warning, #b45309);\n\n  position: relative;\n  background: var(--_card);\n  border: 1px solid var(--_edge);\n  border-radius: var(--va-radius-m, 10px);\n  overflow: hidden;\n  font-family: var(--va-font, system-ui, sans-serif);\n  transition: border-color var(--va-dur-2, 200ms) ease;\n}\n.va-acd--high { --_risk: var(--_danger); }\n.va-acd--low { --_risk: var(--va-success, #1a7f4b); }\n.va-acd:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: 2px; }\n\n.va-acd__timer {\n  margin-left: auto;\n  flex: none;\n  font-size: 11.5px;\n  font-variant-numeric: tabular-nums;\n  color: var(--_risk);\n  opacity: 0.9;\n}\n\n.va-acd__count {\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  height: 3px;\n  background: color-mix(in srgb, var(--_risk) 15%, transparent);\n}\n.va-acd__count-fill {\n  display: block;\n  height: 100%;\n  margin-left: auto; /* 剩余时间从右向左消退，更符合直觉 */\n  background: var(--_risk);\n  border-radius: var(--va-radius-pill, 999px) 0 0 var(--va-radius-pill, 999px);\n  transition: width 0.1s linear;\n}\n\n.va-acd__main { padding: var(--va-s3, 8px) var(--va-s4, 12px) var(--va-s4, 12px); }\n\n.va-acd__head {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3, 8px);\n  padding: var(--va-s3, 8px) var(--va-s4, 12px);\n  transition: background-color var(--va-dur-2, 200ms) ease;\n}\n\n.va-acd:not(.va-acd--collapsed) .va-acd__head {\n  border-bottom: 1px solid color-mix(in srgb, var(--_edge) 60%, transparent);\n}\n\n.va-acd__head--clickable {\n  cursor: pointer;\n  user-select: none;\n}\n.va-acd__head--clickable:hover {\n  background: color-mix(in srgb, var(--va-bg-subtle, #efede7) 50%, transparent);\n}\n\n.va-acd__status-badge {\n  margin-left: auto;\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  font-size: 11px;\n  font-weight: 600;\n  padding: 2px 8px;\n  border-radius: var(--va-radius-pill, 999px);\n}\n.va-acd__status-badge svg { width: 12px; height: 12px; }\n.va-acd__status-badge--approved {\n  color: var(--va-success, #1a7f4b);\n  background: color-mix(in srgb, var(--va-success, #1a7f4b) 12%, transparent);\n}\n.va-acd__status-badge--denied {\n  color: var(--_danger);\n  background: color-mix(in srgb, var(--_danger) 12%, transparent);\n}\n\n.va-acd__collapse-btn {\n  background: none;\n  border: none;\n  padding: 3px;\n  border-radius: 4px;\n  color: var(--_muted);\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.va-acd__collapse-btn:hover {\n  background: var(--va-bg-subtle, #efede7);\n  color: var(--_ink);\n}\n.va-acd__collapse-btn svg { width: 14px; height: 14px; }\n.va-acd__risk {\n  flex: none;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.02em;\n  color: var(--_risk);\n  background: color-mix(in srgb, var(--_risk) 12%, transparent);\n  border-radius: var(--va-radius-pill, 999px);\n  padding: 2px 8px;\n}\n.va-acd__title { margin: 0; font-size: 13.5px; font-weight: 650; color: var(--_ink); }\n.va-acd__detail { margin: var(--va-s2, 4px) 0 0; font-size: 12.5px; color: var(--_muted); }\n\n.va-acd__preview {\n  margin: var(--va-s3, 8px) 0 0;\n  padding: var(--va-s3, 8px) var(--va-s4, 12px);\n  background: var(--va-bg-subtle, #efede7);\n  border-radius: var(--va-radius-s, 8px);\n  font-family: var(--va-font-mono, monospace);\n  font-size: 12px;\n  color: var(--va-ink-2, #43413c);\n  overflow: auto;\n  white-space: pre-wrap;\n  word-break: break-all;\n}\n\n.va-acd__actions { display: flex; align-items: center; gap: var(--va-s2, 4px); margin-top: var(--va-s4, 12px); }\n/* va-act / va-act--ink 基类兜底，仅保留 30px 定高形态 */\n.va-acd__btn { height: 30px; padding: 0 var(--va-s5, 16px); border-radius: var(--va-radius-m, 10px); }\n.va-acd__btn:active { transform: scale(0.97); }\n\n.va-acd__kbd-hint { margin-left: auto; font-size: 11px; color: var(--_muted); }\n.va-acd__kbd-hint kbd {\n  font-family: var(--va-font-mono, monospace);\n  font-size: 10.5px;\n  border: 1px solid var(--_edge);\n  border-bottom-width: 2px;\n  border-radius: 4px;\n  padding: 0 4px;\n  background: var(--_card);\n}\n\n/* 决策后的结果行 */\n.va-acd__done {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s2, 4px);\n  padding: var(--va-s3, 8px) var(--va-s4, 12px);\n  font-size: 12.5px;\n  animation: va-acd-in var(--va-dur-2, 200ms) var(--va-ease, ease);\n}\n.va-acd--approved .va-acd__done { color: var(--va-success, #1a7f4b); }\n.va-acd--denied .va-acd__done { color: var(--_danger); }\n.va-acd__done svg { width: 14px; height: 14px; flex: none; }\n.va-acd__done-detail { color: var(--_muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n\n@keyframes va-acd-in {\n  from { opacity: 0; transform: translateY(2px); }\n  to { opacity: 1; transform: none; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-acd__done { animation: none; }\n  .va-acd__btn:active { transform: none; }\n}\n\n/* 按钮基类（自动附带） */\n/* ============================================================\n   按钮基类 —— 全库动作按钮的单一样式来源。\n   组件叠加使用：class=\"va-act va-act--primary va-xxx__submit\"，\n   组件自己的 CSS 只写布局/色彩覆盖（width、pill 圆角等）。\n   registry 生成器会把本文件自动内联进用了 va-act 的组件拷贝。\n   ============================================================ */\n\n.va-act {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-card);\n  color: var(--va-ink-2);\n  font: inherit;\n  font-size: 13px;\n  line-height: 1.4;\n  padding: 5px 14px;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: border-color var(--va-dur-1) var(--va-ease), background var(--va-dur-1) var(--va-ease),\n    color var(--va-dur-1) var(--va-ease);\n}\n\n.va-act:hover:not(:disabled) { border-color: var(--va-edge-strong); }\n\n.va-act:focus-visible { outline: 2px solid var(--va-accent); outline-offset: 1px; }\n\n.va-act:disabled { opacity: 0.45; cursor: default; }\n\n/* 尺寸 */\n.va-act--sm { font-size: 12px; padding: 3px 10px; }\n.va-act--lg { font-size: 14px; padding: 7px 18px; }\n\n/* 变体 */\n.va-act--primary {\n  background: var(--va-accent);\n  border-color: var(--va-accent);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-act--primary:hover:not(:disabled) {\n  background: var(--va-accent-hover);\n  border-color: var(--va-accent-hover);\n}\n\n.va-act--ghost {\n  border-color: transparent;\n  background: transparent;\n}\n\n.va-act--ghost:hover:not(:disabled) { background: var(--va-bg-subtle); }\n\n.va-act--danger { border-color: transparent; background: transparent; color: var(--va-danger); }\n\n.va-act--danger:hover:not(:disabled) {\n  background: color-mix(in srgb, var(--va-danger) 10%, transparent);\n  border-color: transparent;\n}\n\n/* 语义色实底（成功/危险确认场景，按需叠加） */\n.va-act--success {\n  background: var(--va-success);\n  border-color: var(--va-success);\n  color: #fff;\n  font-weight: 600;\n}\n\n/* 墨色实底：审批/决策/应用这类\"终审\"主操作（区别于 accent 常规主操作） */\n.va-act--ink {\n  background: var(--va-ink);\n  border-color: var(--va-ink);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-act--ink:hover:not(:disabled) { opacity: 0.88; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-act { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/approval-card/index.ts",
      "type": "registry:ui",
      "target": "components/ui/approval-card/index.ts",
      "content": "export { default as VaApprovalCard } from \"./VaApprovalCard.vue\";\nexport type {\n  ApprovalCardEvents,\n  ApprovalCardProps,\n  ApprovalResult,\n  ApprovalRisk,\n  DenyReason,\n} from \"./types\";\n"
    },
    {
      "path": "components/ui/approval-card/types.ts",
      "type": "registry:ui",
      "target": "components/ui/approval-card/types.ts",
      "content": "/** VaApprovalCard 的类型定义 */\n\nexport type ApprovalRisk = \"low\" | \"medium\" | \"high\";\nexport type ApprovalResult = \"approved\" | \"denied\";\nexport type DenyReason = \"manual\" | \"timeout\";\n\nexport interface ApprovalCardProps {\n  /** 请求文案，如\"agent 想执行一条命令\" */\n  title: string;\n  /** 补充说明 */\n  detail?: string;\n  risk?: ApprovalRisk;\n  /** 命令 / 代码预览（等宽块） */\n  preview?: string;\n  confirmLabel?: string;\n  denyLabel?: string;\n  /** 倒计时秒数，到 0 自动拒绝；0 或不传则不限时 */\n  countdown?: number;\n  /** 显示快捷键提示（Enter 批准 · Esc 拒绝） */\n  shortcuts?: boolean;\n  /** 外部传入状态持久化支持：\"approved\" | \"denied\" | \"pending\" */\n  status?: ApprovalResult | \"pending\";\n  /** 外部传入决策原因，例如超时或用户驳回说明 */\n  reason?: string;\n  /** 是否支持折叠展开，默认 true */\n  collapsible?: boolean;\n  /** 默认是否折叠，不传时若已决策默认折叠，未决策默认展开 */\n  defaultCollapsed?: boolean;\n}\n\nexport interface ApprovalCardEvents {\n  approve: [];\n  deny: [reason?: DenyReason];\n}\n"
    },
    {
      "path": "components/ui/approval-card/useApprovalCard.ts",
      "type": "registry:ui",
      "target": "components/ui/approval-card/useApprovalCard.ts",
      "content": "import { computed, ref, watch, onBeforeUnmount, type Ref } from \"vue\";\n\nimport type { ApprovalCardProps, ApprovalResult, DenyReason } from \"./types\";\n\n\n/**\n * VaApprovalCard 的状态逻辑：\n * 倒计时（悬停/聚焦暂停）→ 超时自动拒绝；Enter/Esc 快捷键；审批完成自动折叠与状态持久化。\n */\nexport function useApprovalCard(\n  props: ApprovalCardProps,\n  emit: { approve: () => void; deny: (reason?: DenyReason) => void },\n) {\n  const initialResult = props.status === \"approved\" || props.status === \"denied\" ? props.status : null;\n  const initialDenyReason: DenyReason | undefined =\n    props.reason && props.reason.toLowerCase().includes(\"timeout\") ? \"timeout\" : undefined;\n  const result = ref<ApprovalResult | null>(initialResult);\n  const denyReason = ref<DenyReason | undefined>(initialDenyReason);\n  const paused = ref(false);\n  const isCollapsed = ref<boolean>(props.defaultCollapsed ?? Boolean(initialResult));\n\n  // 监听外部持久化传入的状态变化\n  watch(\n    () => props.status,\n    (newVal) => {\n      if (newVal === \"approved\" || newVal === \"denied\") {\n        result.value = newVal;\n        if (newVal === \"denied\" && props.reason?.toLowerCase().includes(\"timeout\")) {\n          denyReason.value = \"timeout\";\n        }\n        isCollapsed.value = true;\n        stop();\n      } else if (newVal === \"pending\") {\n        result.value = null;\n        isCollapsed.value = false;\n        start();\n      }\n    }\n  );\n\n  /* ---------- 倒计时（JS 驱动，reduced-motion 下行为一致） ---------- */\n  const countdownSeconds = computed(() => (result.value ? 0 : props.countdown ?? 0));\n  const { remaining, start, stop } = useCountdown(countdownSeconds, paused, () => resolve(\"denied\", \"timeout\"));\n\n  const riskLabel = computed(() => ({ low: \"低风险\", medium: \"中风险\", high: \"高风险\" })[props.risk ?? \"medium\"]);\n  const percent = computed(() =>\n    countdownSeconds.value > 0 ? (remaining.value / countdownSeconds.value) * 100 : 0,\n  );\n\n  function resolve(r: ApprovalResult, reason?: DenyReason) {\n    if (result.value) return;\n    result.value = r;\n    denyReason.value = reason;\n    stop();\n    // 审批完成自动折叠\n    isCollapsed.value = true;\n    if (r === \"approved\") emit.approve();\n    else emit.deny(reason);\n  }\n\n  function onApprove() {\n    resolve(\"approved\");\n  }\n  function onDeny() {\n    resolve(\"denied\", \"manual\");\n  }\n\n  function toggleCollapse() {\n    isCollapsed.value = !isCollapsed.value;\n  }\n\n  /* ---------- 键盘快捷键 ---------- */\n  function onKeydown(e: KeyboardEvent) {\n    if (result.value) return;\n    const inButton = (e.target as HTMLElement | null)?.closest(\"button\") != null;\n    if (e.key === \"Enter\" && !inButton) {\n      e.preventDefault();\n      onApprove();\n    } else if (e.key === \"Escape\") {\n      e.preventDefault();\n      onDeny();\n    }\n  }\n\n  // 挂载时若未决策且有倒计时则启动\n  if (!initialResult) {\n    start();\n  }\n\n  return {\n    result,\n    denyReason,\n    paused,\n    remaining,\n    percent,\n    riskLabel,\n    isCollapsed,\n    toggleCollapse,\n    onApprove,\n    onDeny,\n    onKeydown,\n  };\n}\n\n/* ── 内联自 @vuagent/ui src/composables/useCountdown.ts（registry 单文件拷贝自包含） ── */\n/**\n * 共享倒计时：100ms 步进递减，paused 时冻结；归零触发 onEnd。\n * 供审批卡的\"超时自动拒绝\"等场景复用；reduced-motion 下行为一致（JS 驱动，不依赖 CSS 动画）。\n */\nfunction useCountdown(totalSeconds: Ref<number>, paused: Ref<boolean>, onEnd: () => void) {\n  const remaining = ref(totalSeconds.value);\n  let timer: number | undefined;\n\n  function stop() {\n    if (timer !== undefined) {\n      window.clearInterval(timer);\n      timer = undefined;\n    }\n  }\n\n  function start() {\n    stop();\n    if (typeof window === \"undefined\") return;\n    remaining.value = totalSeconds.value;\n    if (remaining.value <= 0) return;\n    timer = window.setInterval(() => {\n      if (paused.value) return;\n      remaining.value = Math.max(0, remaining.value - 0.1);\n      if (remaining.value <= 0) {\n        stop();\n        onEnd();\n      }\n    }, 100);\n  }\n\n  onBeforeUnmount(stop);\n\n  return { remaining, start, stop };\n}\n"
    }
  ]
}
