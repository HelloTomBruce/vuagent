{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "approval-card",
  "title": "Approval Card",
  "description": "审批门：风险徽章 + 命令预览 + 倒计时自动拒绝（悬停暂停）+ Enter/Esc 快捷键，决策后 morph 成结果行。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `title` (string，默认 -)：请求文案\n- `risk` (\"low\" | \"medium\" | \"high\"，默认 \"medium\")：风险等级徽章\n- `preview` (string，默认 -)：命令/代码预览\n- `countdown` (number，默认 -)：秒数，到 0 自动拒绝\n- `@approve / @deny` (-，默认 -)：决策回调（deny 带原因）",
  "files": [
    {
      "path": "components/ui/approval-card/VaApprovalCard.vue",
      "type": "registry:ui",
      "target": "components/ui/approval-card/VaApprovalCard.vue",
      "content": "<script setup lang=\"ts\">\nimport type { ApprovalCardProps, DenyReason } from \"./types\";\nimport { useApprovalCard } from \"./useApprovalCard\";\n\nconst props = withDefaults(defineProps<ApprovalCardProps>(), {\n  detail: undefined,\n  preview: undefined,\n  risk: \"medium\",\n  confirmLabel: \"批准\",\n  denyLabel: \"拒绝\",\n  countdown: undefined,\n  shortcuts: true,\n});\n\nconst emit = defineEmits<{ approve: []; deny: [reason?: DenyReason] }>();\n\nconst { result, denyReason, paused, percent, riskLabel, onApprove, onDeny, onKeydown } = useApprovalCard(props, {\n  approve: () => emit(\"approve\"),\n  deny: (reason) => emit(\"deny\", reason),\n});\n</script>\n\n<template>\n  <div\n    class=\"va-acd\"\n    :class=\"[`va-acd--${props.risk}`, result ? `va-acd--${result}` : '']\"\n    tabindex=\"-1\"\n    role=\"alertdialog\"\n    :aria-label=\"props.title\"\n    @keydown=\"onKeydown\"\n    @pointerenter=\"paused = true\"\n    @pointerleave=\"paused = false\"\n    @focusin=\"paused = true\"\n    @focusout=\"paused = false\"\n  >\n    <!-- 倒计时条 -->\n    <div v-if=\"props.countdown && !result\" class=\"va-acd__count\" aria-hidden=\"true\">\n      <span class=\"va-acd__count-fill\" :style=\"{ width: `${percent}%` }\" />\n    </div>\n\n    <div class=\"va-acd__main\">\n      <header class=\"va-acd__head\">\n        <span class=\"va-acd__risk\" :data-risk=\"props.risk\">{{ riskLabel }}</span>\n        <h4 class=\"va-acd__title\">{{ props.title }}</h4>\n      </header>\n      <p v-if=\"props.detail\" class=\"va-acd__detail\">{{ props.detail }}</p>\n      <pre v-if=\"props.preview\" class=\"va-acd__preview\">{{ props.preview }}</pre>\n\n      <div class=\"va-acd__actions\">\n        <button class=\"va-act va-acd__btn\" type=\"button\" @click=\"onDeny\">{{ props.denyLabel }}</button>\n        <button class=\"va-act va-act--ink va-acd__btn\" type=\"button\" @click=\"onApprove\">{{ props.confirmLabel }}</button>\n        <span v-if=\"props.shortcuts && !result\" class=\"va-acd__kbd-hint\">\n          <kbd>Enter</kbd> 批准 · <kbd>Esc</kbd> 拒绝\n        </span>\n      </div>\n    </div>\n\n    <!-- 决策后的结果行 -->\n    <div v-if=\"result\" class=\"va-acd__done\" role=\"status\">\n      <svg v-if=\"result === 'approved'\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" aria-hidden=\"true\">\n        <path d=\"M5.5 12.5l4 4L18.5 8\" />\n      </svg>\n      <svg v-else viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\">\n        <path d=\"m7.5 7.5 9 9m0-9-9 9\" />\n      </svg>\n      <span>{{ result === \"approved\" ? \"已批准\" : denyReason === \"timeout\" ? \"超时未响应，已自动拒绝\" : \"已拒绝\" }}</span>\n      <span v-if=\"props.detail\" class=\"va-acd__done-detail\">{{ props.detail }}</span>\n    </div>\n  </div>\n</template>\n\n<style>\n/* VaApprovalCard — agent 的审批门 */\n.va-acd {\n  --_card: var(--va-acd-card, var(--va-card, #ffffff));\n  --_edge: var(--va-acd-edge, var(--va-edge, rgba(26, 25, 23, 0.12)));\n  --_ink: var(--va-acd-ink, var(--va-ink, #1a1917));\n  --_muted: var(--va-acd-muted, var(--va-muted, #6f6d66));\n  --_danger: var(--va-acd-danger, var(--va-danger, #d5453c));\n  --_risk: var(--va-warning, #b45309);\n\n  position: relative;\n  background: var(--_card);\n  border: 1px solid var(--_edge);\n  border-radius: var(--va-radius-m, 10px);\n  overflow: hidden;\n  font-family: var(--va-font, system-ui, sans-serif);\n  transition: border-color var(--va-dur-2, 200ms) ease;\n}\n.va-acd--high { --_risk: var(--_danger); }\n.va-acd--low { --_risk: var(--va-success, #1a7f4b); }\n.va-acd:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: 2px; }\n\n.va-acd__count {\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  height: 3px;\n  background: color-mix(in srgb, var(--_risk) 15%, transparent);\n}\n.va-acd__count-fill {\n  display: block;\n  height: 100%;\n  margin-left: auto; /* 剩余时间从右向左消退，更符合直觉 */\n  background: var(--_risk);\n  border-radius: var(--va-radius-pill, 999px) 0 0 var(--va-radius-pill, 999px);\n  transition: width 0.1s linear;\n}\n\n.va-acd__main { padding: var(--va-s4, 12px); }\n\n.va-acd__head { display: flex; align-items: center; gap: var(--va-s3, 8px); }\n.va-acd__risk {\n  flex: none;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.02em;\n  color: var(--_risk);\n  background: color-mix(in srgb, var(--_risk) 12%, transparent);\n  border-radius: var(--va-radius-pill, 999px);\n  padding: 2px 8px;\n}\n.va-acd__title { margin: 0; font-size: 13.5px; font-weight: 650; color: var(--_ink); }\n.va-acd__detail { margin: var(--va-s2, 4px) 0 0; font-size: 12.5px; color: var(--_muted); }\n\n.va-acd__preview {\n  margin: var(--va-s3, 8px) 0 0;\n  padding: var(--va-s3, 8px) var(--va-s4, 12px);\n  background: var(--va-bg-subtle, #efede7);\n  border-radius: var(--va-radius-s, 8px);\n  font-family: var(--va-font-mono, monospace);\n  font-size: 12px;\n  color: var(--va-ink-2, #43413c);\n  overflow: auto;\n  white-space: pre-wrap;\n  word-break: break-all;\n}\n\n.va-acd__actions { display: flex; align-items: center; gap: var(--va-s2, 4px); margin-top: var(--va-s4, 12px); }\n/* va-act / va-act--ink 基类兜底，仅保留 30px 定高形态 */\n.va-acd__btn { height: 30px; padding: 0 var(--va-s5, 16px); border-radius: var(--va-radius-m, 10px); }\n.va-acd__btn:active { transform: scale(0.97); }\n\n.va-acd__kbd-hint { margin-left: auto; font-size: 11px; color: var(--_muted); }\n.va-acd__kbd-hint kbd {\n  font-family: var(--va-font-mono, monospace);\n  font-size: 10.5px;\n  border: 1px solid var(--_edge);\n  border-bottom-width: 2px;\n  border-radius: 4px;\n  padding: 0 4px;\n  background: var(--_card);\n}\n\n/* 决策后的结果行 */\n.va-acd__done {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s2, 4px);\n  padding: var(--va-s3, 8px) var(--va-s4, 12px);\n  font-size: 12.5px;\n  animation: va-acd-in var(--va-dur-2, 200ms) var(--va-ease, ease);\n}\n.va-acd--approved .va-acd__done { color: var(--va-success, #1a7f4b); }\n.va-acd--denied .va-acd__done { color: var(--_danger); }\n.va-acd__done svg { width: 14px; height: 14px; flex: none; }\n.va-acd__done-detail { color: var(--_muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n\n@keyframes va-acd-in {\n  from { opacity: 0; transform: translateY(2px); }\n  to { opacity: 1; transform: none; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-acd__done { animation: none; }\n  .va-acd__btn:active { transform: none; }\n}\n\n/* 按钮基类（自动附带） */\n/* ============================================================\n   按钮基类 —— 全库动作按钮的单一样式来源。\n   组件叠加使用：class=\"va-act va-act--primary va-xxx__submit\"，\n   组件自己的 CSS 只写布局/色彩覆盖（width、pill 圆角等）。\n   registry 生成器会把本文件自动内联进用了 va-act 的组件拷贝。\n   ============================================================ */\n\n.va-act {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-card);\n  color: var(--va-ink-2);\n  font: inherit;\n  font-size: 13px;\n  line-height: 1.4;\n  padding: 5px 14px;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: border-color var(--va-dur-1) var(--va-ease), background var(--va-dur-1) var(--va-ease),\n    color var(--va-dur-1) var(--va-ease);\n}\n\n.va-act:hover:not(:disabled) { border-color: var(--va-edge-strong); }\n\n.va-act:focus-visible { outline: 2px solid var(--va-accent); outline-offset: 1px; }\n\n.va-act:disabled { opacity: 0.45; cursor: default; }\n\n/* 尺寸 */\n.va-act--sm { font-size: 12px; padding: 3px 10px; }\n.va-act--lg { font-size: 14px; padding: 7px 18px; }\n\n/* 变体 */\n.va-act--primary {\n  background: var(--va-accent);\n  border-color: var(--va-accent);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-act--primary:hover:not(:disabled) {\n  background: var(--va-accent-hover);\n  border-color: var(--va-accent-hover);\n}\n\n.va-act--ghost {\n  border-color: transparent;\n  background: transparent;\n}\n\n.va-act--ghost:hover:not(:disabled) { background: var(--va-bg-subtle); }\n\n.va-act--danger { border-color: transparent; background: transparent; color: var(--va-danger); }\n\n.va-act--danger:hover:not(:disabled) {\n  background: color-mix(in srgb, var(--va-danger) 10%, transparent);\n  border-color: transparent;\n}\n\n/* 语义色实底（成功/危险确认场景，按需叠加） */\n.va-act--success {\n  background: var(--va-success);\n  border-color: var(--va-success);\n  color: #fff;\n  font-weight: 600;\n}\n\n/* 墨色实底：审批/决策/应用这类\"终审\"主操作（区别于 accent 常规主操作） */\n.va-act--ink {\n  background: var(--va-ink);\n  border-color: var(--va-ink);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-act--ink:hover:not(:disabled) { opacity: 0.88; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-act { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/approval-card/types.ts",
      "type": "registry:ui",
      "target": "components/ui/approval-card/types.ts",
      "content": "/** VaApprovalCard 的类型定义 */\n\nexport type ApprovalRisk = \"low\" | \"medium\" | \"high\";\nexport type ApprovalResult = \"approved\" | \"denied\";\nexport type DenyReason = \"manual\" | \"timeout\";\n\nexport interface ApprovalCardProps {\n  /** 请求文案，如\"agent 想执行一条命令\" */\n  title: string;\n  /** 补充说明 */\n  detail?: string;\n  risk?: ApprovalRisk;\n  /** 命令 / 代码预览（等宽块） */\n  preview?: string;\n  confirmLabel?: string;\n  denyLabel?: string;\n  /** 倒计时秒数，到 0 自动拒绝；0 或不传则不限时 */\n  countdown?: number;\n  /** 显示快捷键提示（Enter 批准 · Esc 拒绝） */\n  shortcuts?: boolean;\n}\n\nexport interface ApprovalCardEvents {\n  approve: [];\n  deny: [reason?: DenyReason];\n}\n"
    },
    {
      "path": "components/ui/approval-card/useApprovalCard.ts",
      "type": "registry:ui",
      "target": "components/ui/approval-card/useApprovalCard.ts",
      "content": "import { computed, ref } from \"vue\";\nimport type { ApprovalCardProps, ApprovalResult, DenyReason } from \"./types\";\nimport { useCountdown } from \"../../composables/useCountdown\";\n\n/**\n * VaApprovalCard 的状态逻辑：\n * 倒计时（悬停/聚焦暂停）→ 超时自动拒绝；Enter/Esc 快捷键；一次定终身。\n */\nexport function useApprovalCard(\n  props: ApprovalCardProps,\n  emit: { approve: () => void; deny: (reason?: DenyReason) => void },\n) {\n  const result = ref<ApprovalResult | null>(null);\n  const denyReason = ref<DenyReason | undefined>(undefined);\n  const paused = ref(false);\n\n  /* ---------- 倒计时（JS 驱动，reduced-motion 下行为一致） ---------- */\n  const countdownSeconds = computed(() => props.countdown ?? 0);\n  const { remaining, start, stop } = useCountdown(countdownSeconds, paused, () => resolve(\"denied\", \"timeout\"));\n\n  const riskLabel = computed(() => ({ low: \"低风险\", medium: \"中风险\", high: \"高风险\" })[props.risk ?? \"medium\"]);\n  const percent = computed(() =>\n    countdownSeconds.value > 0 ? (remaining.value / countdownSeconds.value) * 100 : 0,\n  );\n\n  function resolve(r: ApprovalResult, reason?: DenyReason) {\n    if (result.value) return;\n    result.value = r;\n    denyReason.value = reason;\n    stop();\n    if (r === \"approved\") emit.approve();\n    else emit.deny(reason);\n  }\n\n  function onApprove() {\n    resolve(\"approved\");\n  }\n  function onDeny() {\n    resolve(\"denied\", \"manual\");\n  }\n\n  /* ---------- 键盘快捷键 ---------- */\n  function onKeydown(e: KeyboardEvent) {\n    if (result.value) return;\n    const inButton = (e.target as HTMLElement | null)?.closest(\"button\") != null;\n    if (e.key === \"Enter\" && !inButton) {\n      e.preventDefault();\n      onApprove();\n    } else if (e.key === \"Escape\") {\n      e.preventDefault();\n      onDeny();\n    }\n  }\n\n  // 挂载即开始倒计时\n  start();\n\n  return {\n    result,\n    denyReason,\n    paused,\n    remaining,\n    percent,\n    riskLabel,\n    onApprove,\n    onDeny,\n    onKeydown,\n  };\n}\n"
    }
  ]
}
