{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "combobox",
  "title": "Combobox",
  "description": "可搜索下拉选择：输入过滤、↑↓ 循环高亮、Enter 选中、Esc 关闭；creatable 可把输入创建为新值。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `options` (ComboboxOption[]，默认 -)：value/label/hint/disabled\n- `v-model` (string，默认 -)：选中值\n- `creatable` (boolean，默认 false)：允许创建输入中的新值\n- `@create / @select` (-，默认 -)：创建新值 / 选中列表项",
  "files": [
    {
      "path": "components/ui/combobox/VaCombobox.vue",
      "type": "registry:ui",
      "target": "components/ui/combobox/VaCombobox.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, useTemplateRef } from \"vue\";\nimport type { ComboboxEvents, ComboboxProps } from \"./types\";\nimport { useCombobox } from \"./useCombobox\";\n\nconst props = defineProps<ComboboxProps>();\n\nconst emit = defineEmits<ComboboxEvents>();\n\nconst inputEl = useTemplateRef<HTMLInputElement>(\"input\");\nconst { query, open, activeIdx, selected, items, openMenu, close, pick, onInputKeydown } = useCombobox(\n  props,\n  inputEl,\n  {\n    \"update:modelValue\": (v) => emit(\"update:modelValue\", v),\n    create: (v) => emit(\"create\", v),\n    select: (o) => emit(\"select\", o),\n  },\n);\n\n/** 关闭态回填：优先选中项 label；creatable 新值不在 options 里则回显值本身 */\nconst displayValue = computed(() => selected.value?.label ?? props.modelValue ?? \"\");\n</script>\n\n<template>\n  <div class=\"va-cbx\">\n    <input\n      ref=\"input\"\n      class=\"va-cbx__input\"\n      type=\"text\"\n      role=\"combobox\"\n      :value=\"open ? query : displayValue\"\n      :aria-expanded=\"open\"\n      aria-controls=\"va-cbx-list\"\n      :aria-activedescendant=\"open && items[activeIdx] ? `va-cbx-opt-${activeIdx}` : undefined\"\n      :aria-label=\"props.label ?? '组合选择'\"\n      :placeholder=\"props.placeholder ?? '输入搜索或选择…'\"\n      autocomplete=\"off\"\n      @input=\"query = ($event.target as HTMLInputElement).value\"\n      @focus=\"openMenu\"\n      @keydown=\"onInputKeydown\"\n      @blur=\"close()\"\n    >\n    <svg\n      class=\"va-cbx__chev\"\n      :class=\"{ 'va-cbx__chev--open': open }\"\n      aria-hidden=\"true\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n      @mousedown.prevent\n    >\n      <polyline points=\"6 9 12 15 18 9\" />\n    </svg>\n\n    <Transition name=\"va-cbx-pop\">\n      <ul\n        v-if=\"open && items.length\"\n        id=\"va-cbx-list\"\n        class=\"va-cbx__list\"\n        role=\"listbox\"\n        @mousedown.prevent\n      >\n      <li\n        v-for=\"(o, i) in items\"\n        :id=\"`va-cbx-opt-${i}`\"\n        :key=\"o.value\"\n        class=\"va-cbx__opt\"\n        role=\"option\"\n        :aria-selected=\"o.value === props.modelValue\"\n        :data-active=\"i === activeIdx\"\n        :data-disabled=\"o.disabled\"\n        @click=\"pick(o)\"\n        @mousemove=\"activeIdx = i\"\n      >\n        <span class=\"va-cbx__label\">{{ o.label }}</span>\n        <span v-if=\"o.hint\" class=\"va-cbx__hint\">{{ o.hint }}</span>\n        <span v-else-if=\"o.value === props.modelValue\" class=\"va-cbx__hint\">✓</span>\n      </li>\n    </ul>\n    </Transition>\n    <Transition name=\"va-cbx-pop\">\n      <div v-if=\"open && !items.length\" class=\"va-cbx__empty va-fade-in\" @mousedown.prevent>\n        {{ props.emptyLabel ?? \"没有匹配项\" }}\n      </div>\n    </Transition>\n    <p v-if=\"selected && !open\" class=\"va-cbx__sr\">当前选中：{{ selected.label }}</p>\n  </div>\n</template>\n\n<style>\n/* VaCombobox — 可搜索/可创建下拉 */\n\n.va-cbx {\n  position: relative;\n  display: inline-flex;\n  min-width: 220px;\n}\n\n.va-cbx__input {\n  flex: 1;\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-s, 8px);\n  background: var(--va-card, #ffffff);\n  color: var(--va-ink, #1a1917);\n  font: inherit;\n  font-size: var(--va-fs-lg, 14px);\n  padding: 7px 28px 7px var(--va-s4h, 10px);\n  transition: border-color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-cbx__input:focus {\n  outline: none;\n  border-color: var(--va-accent, #c2410c);\n  box-shadow: 0 0 0 3px var(--va-accent-soft, rgba(194, 65, 12, 0.1));\n}\n\n.va-cbx__chev {\n  position: absolute;\n  right: 9px;\n  top: 50%;\n  transform: translateY(-50%);\n  width: 14px;\n  height: 14px;\n  color: var(--va-muted, #6f6d66);\n  cursor: pointer;\n  transition: transform var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n.va-cbx__chev--open { transform: translateY(-50%) rotate(180deg); }\n\n.va-cbx__list,\n.va-cbx__empty {\n  position: absolute;\n  top: calc(100% + 4px);\n  left: 0;\n  right: 0;\n  z-index: 20;\n  background: var(--va-card, #ffffff);\n  border: 1px solid var(--va-edge-strong, rgba(26, 25, 23, 0.22));\n  border-radius: var(--va-radius-m, 10px);\n  box-shadow: var(--va-shadow-2, 0 4px 12px rgba(26, 25, 23, 0.08));\n  padding: var(--va-s2, 4px);\n}\n\n.va-cbx__list {\n  list-style: none;\n  margin: 0;\n  max-height: 260px;\n  overflow-y: auto;\n}\n\n.va-cbx__opt {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--va-s3, 8px);\n  padding: 7px var(--va-s3, 8px);\n  border-radius: var(--va-radius-s, 8px);\n  font-size: var(--va-fs-lg, 14px);\n  color: var(--va-ink-2, #43413c);\n  cursor: pointer;\n}\n\n.va-cbx__opt[data-active=\"true\"] { background: var(--va-accent-soft, rgba(194, 65, 12, 0.1)); color: var(--va-ink, #1a1917); }\n.va-cbx__opt[aria-selected=\"true\"] { font-weight: var(--va-fw-semibold, 600); }\n.va-cbx__opt[data-disabled=\"true\"] { opacity: 0.4; cursor: default; }\n\n.va-cbx__label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n\n.va-cbx__hint {\n  flex: none;\n  font-size: var(--va-fs-xs, 11px);\n  color: var(--va-muted, #6f6d66);\n  font-family: var(--va-font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);\n}\n\n.va-cbx__empty {\n  font-size: var(--va-fs-md, 13px);\n  color: var(--va-muted, #6f6d66);\n  text-align: center;\n  padding: var(--va-s4, 12px);\n}\n\n/* 屏幕阅读器专用 */\n.va-cbx__sr {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-cbx__input,\n  .va-cbx__chev { transition: none; }\n}\n\n/* 下拉面板显隐过渡：自上方轻滑入淡入（与 VaPopover bottom 放置同构），单文件自含 */\n.va-cbx-pop-enter-active {\n  transition:\n    opacity var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-cbx-pop-leave-active {\n  transition:\n    opacity var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)),\n    transform var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2));\n}\n\n.va-cbx-pop-enter-from,\n.va-cbx-pop-leave-to {\n  opacity: 0;\n  transform: translateY(calc(var(--va-dist-m, 8px) * -1));\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-cbx-pop-enter-active,\n  .va-cbx-pop-leave-active {\n    transition: opacity var(--va-dur-1, 120ms) linear;\n    transform: none;\n  }\n\n  .va-cbx-pop-enter-from,\n  .va-cbx-pop-leave-to {\n    transform: none;\n  }\n}\n\n/* 动效工具类（自动附带，源码中来自全局 motion.css） */\n/* ============================================================\n   共享动效工具类 —— 进出场/交叉淡入的统一协议（TASK-102 动效基建）。\n   组件不逐个发明入场曲线：统一消费 --va-dur-in/--va-dur-out 骨架时长与\n   --va-dist-* 位移档；每条声明自带字面 fallback（registry 单文件拷贝分发\n   要求，与 tokens.css 门禁一致）。\n\n   接入方式二选一：\n   1. Vue <Transition>：\n      <Transition enter-active-class=\"va-enter-up\" leave-active-class=\"va-exit-up\">\n      动画 fill-mode 为 both（延迟期间保持首帧、播完停在终态），\n      无需再配 enter-from-class / leave-to-class；\n   2. 类切换重挂载：骨架 → 内容换节点时给新节点挂 .va-crossfade（纯淡入），\n      离场节点挂 .va-exit-*（更短更快）。\n\n   列表错峰：v-for 子项 :style=\"useStagger().delayStyle(i)\" 配合 .va-enter-*\n   动画类使用（animation-delay 由 composable 编排——.va-enter-* 为 CSS animation，\n   transition-delay 对其零作用，见 composables/useStagger.ts）。\n   ============================================================ */\n\n/* 入场：上浮（自下方 --va-dist-m 浮起） */\n@keyframes va-motion-in-up {\n  from { opacity: 0; transform: translateY(var(--va-dist-m, 8px)); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* 入场：左滑（自左侧 --va-dist-m 滑入） */\n@keyframes va-motion-in-left {\n  from { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n  to { opacity: 1; transform: translateX(0); }\n}\n\n/* 入场：缩放（96% 起放大至原尺寸） */\n@keyframes va-motion-in-scale {\n  from { opacity: 0; transform: scale(0.96); }\n  to { opacity: 1; transform: scale(1); }\n}\n\n/* 离场：与入场互逆（向上/向左飘出、缩回）；时长/曲线由工具类映射 --va-dur-out 骨架 */\n@keyframes va-motion-out-up {\n  from { opacity: 1; transform: translateY(0); }\n  to { opacity: 0; transform: translateY(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-left {\n  from { opacity: 1; transform: translateX(0); }\n  to { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-scale {\n  from { opacity: 1; transform: scale(1); }\n  to { opacity: 0; transform: scale(0.96); }\n}\n\n/* 交叉淡入/淡出（.va-crossfade 骨架→内容交换专用，无位移，避免占位跳变叠加） */\n@keyframes va-motion-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes va-motion-fade-out {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n/* ---- 工具类：入场走 --va-dur-in + ease-out-quart，离场走 --va-dur-out + ease-in-quad ---- */\n\n.va-enter-up {\n  animation: va-motion-in-up var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-left {\n  animation: va-motion-in-left var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-scale {\n  animation: va-motion-in-scale var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-exit-up {\n  animation: va-motion-out-up var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-left {\n  animation: va-motion-out-left var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-scale {\n  animation: va-motion-out-scale var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n/* 骨架 → 内容交叉过渡：新内容纯淡入 */\n.va-crossfade {\n  animation: va-motion-fade-in var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* 空态/轻量状态渐入（TASK-106 弱化档）：仅 opacity、时长走 --va-dur-2，\n   供列表空态提示与一次性状态块使用（空态清单见 TASK-106 报告）。\n   纯 opacity 即动效分频策略的降级终点形态，reduced-motion 下保持原样即可。 */\n.va-fade-in {\n  animation: va-motion-fade-in var(--va-dur-2, 200ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* ---- 静态光斑基类（TASK-105，决策 5「追光」路线基建）----\n   pointer 坐标由 composables/useSpotlight.ts 以 rAF 节流写入 --va-spot-x/y\n   （元素内百分比，光斑数学在 composable 内可单测）；本类只负责 radial 光斑\n   绘制与显隐（:hover 点亮，无 3D 倾斜， glare 数学对齐 VaTiltCard）。\n   --va-spot-* 为 L3 组件钩子口径（宿主可覆盖尺寸/颜色），不进 tokens.css。\n   双降级对齐 VaTiltCard glare：hover: none（触屏）与 reduced-motion 不绘制。 */\n.va-spotlight { position: relative; }\n\n/* ::after 承载光斑（避开组件自身 ::before 用途）；inset 0 + border-radius inherit\n   使光斑天然裁剪在宿主圆角内，无需 overflow: hidden。\n   注意：此 ::after radial 与 components/spotlight-card/VaSpotlightCard.css 的\n   .va-spot-card--spot::after 为 registry 单文件自含有意复制，改动需两处同步。 */\n.va-spotlight::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n  background: radial-gradient(\n    var(--va-spot-size, 240px) circle at var(--va-spot-x, 50%) var(--va-spot-y, 50%),\n    var(--va-spot-color, rgba(255, 255, 255, 0.14)),\n    transparent 65%\n  );\n}\n\n.va-spotlight:hover::after { opacity: 1; }\n\n@media (hover: none) {\n  .va-spotlight::after { display: none; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-spotlight::after { display: none; }\n}\n\n/* ---- 复制反馈标准（TASK-106）：copy→check 交叉过渡 ----\n   容器 .va-copy 为 inline-grid 双内容同格堆叠（格子宽取较宽子项，切换零跳动）：\n   __idle = copy 态内容（图标/文字），__done = check 态内容。\n   copied 置真挂 .va-copy--done：check 以 ease-spring 微弹入场（进入 done 态时\n   transform 的目标态时序换成 --va-ease-spring → 过冲回弹），交叉时长统一 --va-dur-1。\n   消费方：terminal-log（行复制）、code-diff（复制按钮）、message-actions（复制图标）。 */\n.va-copy { display: inline-grid; place-items: center; }\n\n.va-copy__idle,\n.va-copy__done {\n  grid-area: 1 / 1;\n  transition: opacity var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-copy__idle { opacity: 1; transform: scale(1); }\n.va-copy__done { opacity: 0; transform: scale(0.6); }\n\n.va-copy--done .va-copy__done {\n  opacity: 1;\n  transform: scale(1);\n  /* 时序按 transition 属性顺序映射：opacity 仍 ease，transform 换 ease-spring 微弹 */\n  transition-timing-function: var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), var(--va-ease-spring, cubic-bezier(0.34, 1.56, 0.64, 1));\n}\n\n.va-copy--done .va-copy__idle { opacity: 0; transform: scale(0.6); }\n\n@media (prefers-reduced-motion: reduce) {\n  /* 交叉过渡瞬时完成（无位移动画），copied 状态可感知性不受影响 */\n  .va-copy__idle,\n  .va-copy__done { transition: none; }\n}\n\n/* ---- 错误反馈标准（校验失败横向微振）：目标元素挂 .va-shake 播一次 ±3px 微振 ----\n   时长 --va-dur-2 × 2（两拍四峰，克制的「摇头」量级，rubric 校验失败口径）；\n   重复触发需先移除类、强制 reflow 再挂回（封装见 composables/useShake.ts）。\n   reduced-motion 降级为不播：错误状态的可感知性由错误样式本身（描边/文案）承担，\n   动效只做注意力引导——符合头注释「功能动画降级保留状态可感知」的分频策略。\n   消费方：VaStepperForm / VaOtpInput 经 useShake() 程序化触发（defineExpose shake()）；\n   宿主自绘表单可直接挂类。 */\n@keyframes va-motion-shake {\n  20% { transform: translateX(-3px); }\n  40% { transform: translateX(3px); }\n  60% { transform: translateX(-2px); }\n  80% { transform: translateX(2px); }\n}\n\n.va-shake {\n  animation: va-motion-shake calc(var(--va-dur-2, 200ms) * 2) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-shake { animation: none; }\n}\n\n/* ---- 动效分频（对齐 tokens.css 头注释策略）：\n   功能动画降级为纯 opacity——进/出场整体换成 fade keyframes，\n   位移/缩放不再出现（animation-name 顶替，时长/缓动沿用上面的声明）。 */\n@media (prefers-reduced-motion: reduce) {\n  .va-enter-up,\n  .va-enter-left,\n  .va-enter-scale,\n  .va-crossfade {\n    animation-name: va-motion-fade-in;\n  }\n\n  .va-exit-up,\n  .va-exit-left,\n  .va-exit-scale {\n    animation-name: va-motion-fade-out;\n  }\n}\n</style>\n"
    },
    {
      "path": "components/ui/combobox/index.ts",
      "type": "registry:ui",
      "target": "components/ui/combobox/index.ts",
      "content": "export { default as VaCombobox } from \"./VaCombobox.vue\";\nexport type { ComboboxEvents, ComboboxOption, ComboboxProps } from \"./types\";\n"
    },
    {
      "path": "components/ui/combobox/types.ts",
      "type": "registry:ui",
      "target": "components/ui/combobox/types.ts",
      "content": "/** VaCombobox 的类型定义 */\n\nexport interface ComboboxOption {\n  value: string;\n  label: string;\n  /** 右侧提示文案 */\n  hint?: string;\n  disabled?: boolean;\n}\n\nexport interface ComboboxProps {\n  options: ComboboxOption[];\n  /** 受控选中值（配合 @update:modelValue 实现 v-model） */\n  modelValue?: string;\n  /** 允许把输入内容创建为新值（触发 @create） */\n  creatable?: boolean;\n  placeholder?: string;\n  /** 无匹配时文案；creatable 时显示\"创建 xxx\" */\n  emptyLabel?: string;\n  /** 触发输入框的 aria-label */\n  label?: string;\n}\n\nexport interface ComboboxEvents {\n  \"update:modelValue\": [value: string];\n  /** creatable 下创建新值 */\n  create: [value: string];\n  /** 从列表选中某项（create 不触发此事件） */\n  select: [option: ComboboxOption];\n}\n"
    },
    {
      "path": "components/ui/combobox/useCombobox.ts",
      "type": "registry:ui",
      "target": "components/ui/combobox/useCombobox.ts",
      "content": "import { computed, ref, watch, type Ref } from \"vue\";\nimport type { ComboboxOption, ComboboxProps } from \"./types\";\n\n/**\n * VaCombobox：可输入过滤 + 可创建的下拉选择。\n * 键盘：↑↓ 循环高亮、Enter 选中/创建、Esc 关闭；SSR 安全（无直接 DOM 访问）。\n */\nexport function useCombobox(\n  props: ComboboxProps,\n  inputEl: Ref<HTMLInputElement | null>,\n  emit: {\n    \"update:modelValue\": (v: string) => void;\n    create: (v: string) => void;\n    select: (o: ComboboxOption) => void;\n  },\n) {\n  const query = ref(\"\");\n  const open = ref(false);\n  const activeIdx = ref(0);\n\n  const selected = computed(() => props.options.find((o) => o.value === props.modelValue));\n\n  /** 过滤结果 + creatable 时的\"创建\"伪项 */\n  const items = computed<ComboboxOption[]>(() => {\n    const q = query.value.trim().toLowerCase();\n    const base = q\n      ? props.options.filter((o) => o.label.toLowerCase().includes(q) || o.value.toLowerCase().includes(q))\n      : props.options;\n    if (props.creatable && q && !base.some((o) => o.value.toLowerCase() === q)) {\n      return [...base, { value: query.value.trim(), label: `创建「${query.value.trim()}」` }];\n    }\n    return base;\n  });\n\n  /** 项是否为\"创建新值\"伪项（不在原始 options 里） */\n  const isNewItem = (o: ComboboxOption) => !props.options.some((x) => x.value === o.value);\n\n  watch(items, () => {\n    activeIdx.value = 0;\n  });\n\n  function focusInput() {\n    inputEl.value?.focus();\n  }\n\n  function openMenu() {\n    open.value = true;\n    query.value = \"\";\n    activeIdx.value = 0;\n  }\n\n  function close() {\n    open.value = false;\n    query.value = \"\";\n  }\n\n  function pick(o: ComboboxOption) {\n    if (o.disabled) return;\n    if (isNewItem(o)) {\n      emit.create(o.value);\n    } else {\n      emit.select(o);\n    }\n    emit[\"update:modelValue\"](o.value);\n    open.value = false;\n    query.value = \"\";\n    focusInput();\n  }\n\n  function onInputKeydown(e: KeyboardEvent) {\n    if (e.key === \"ArrowDown\" || e.key === \"ArrowUp\") {\n      e.preventDefault();\n      if (!open.value) {\n        openMenu();\n        return;\n      }\n      const len = items.value.length;\n      if (!len) return;\n      activeIdx.value = (activeIdx.value + (e.key === \"ArrowDown\" ? 1 : -1) + len) % len;\n    } else if (e.key === \"Enter\") {\n      if (!open.value) return;\n      e.preventDefault();\n      const item = items.value[activeIdx.value];\n      if (item) pick(item);\n    } else if (e.key === \"Escape\" && open.value) {\n      e.preventDefault();\n      close();\n    }\n  }\n\n  return { query, open, activeIdx, selected, items, openMenu, close, pick, onInputKeydown, focusInput };\n}\n"
    }
  ]
}
