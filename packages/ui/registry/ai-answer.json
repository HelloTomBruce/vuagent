{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "ai-answer",
  "title": "AI Answer",
  "description": "带来源引用的回答卡：正文 [n] 标记渲染为可点击上标角标（无对应来源原样保留）、来源列表（序号 + 标题 + 出处）、流式光标。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `answer` (string，默认 -)：回答正文，支持 [1] 引用标记\n- `sources` (AnswerSource[]，默认 -)：id/title/url/origin\n- `question / streaming` (string / boolean，默认 - / false)：问题小字 / 流式光标\n- `@source` (-，默认 -)：点击角标或来源行",
  "files": [
    {
      "path": "components/ui/ai-answer/VaAiAnswer.vue",
      "type": "registry:ui",
      "target": "components/ui/ai-answer/VaAiAnswer.vue",
      "content": "<script setup lang=\"ts\">\nimport type { AiAnswerEvents, AiAnswerProps } from \"./types\";\nimport type { AnswerSource } from \"./types\";\nimport { useCitedText } from \"./useCitedText\";\n\nconst props = defineProps<AiAnswerProps>();\n\nconst emit = defineEmits<AiAnswerEvents>();\n\nfunction cite(index: number) {\n  const src = props.sources[index];\n  if (src) emit(\"source\", src);\n}\n\nconst { nodes } = useCitedText(\n  () => props.answer,\n  () => props.sources,\n  cite,\n);\n</script>\n\n<template>\n  <article class=\"va-ans\" :data-streaming=\"props.streaming ?? false\">\n    <p v-if=\"props.question\" class=\"va-ans__q\">{{ props.question }}</p>\n\n    <div class=\"va-ans__body\">\n      <template v-for=\"(n, i) in nodes\" :key=\"i\">\n        <component :is=\"n\" />\n      </template>\n      <span v-if=\"props.streaming\" class=\"va-ans__cursor\" aria-hidden=\"true\" />\n      <span v-if=\"props.streaming\" class=\"va-ans__sr\">{{ props.streamingLabel ?? \"正在生成回答\" }}</span>\n    </div>\n\n    <footer v-if=\"props.sources.length\" class=\"va-ans__sources\">\n      <h4 class=\"va-ans__src-title\">来源</h4>\n      <ol class=\"va-ans__list\">\n        <li v-for=\"(s, i) in props.sources\" :key=\"s.id\">\n          <button class=\"va-ans__src\" type=\"button\" @click=\"emit('source', s as AnswerSource)\">\n            <span class=\"va-ans__no\" aria-hidden=\"true\">{{ i + 1 }}</span>\n            <span class=\"va-ans__src-main\">\n              <span class=\"va-ans__src-title-text\">{{ s.title }}</span>\n              <span v-if=\"s.origin\" class=\"va-ans__origin\">{{ s.origin }}</span>\n            </span>\n          </button>\n        </li>\n      </ol>\n    </footer>\n  </article>\n</template>\n\n<style>\n/* VaAiAnswer — 带来源引用的 AI 回答卡 */\n\n.va-ans {\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-m);\n  background: var(--va-card);\n  padding: var(--va-s5);\n}\n\n.va-ans__q {\n  margin: 0 0 var(--va-s3);\n  font-size: 12.5px;\n  color: var(--va-muted);\n}\n\n.va-ans__body {\n  font-size: 14px;\n  line-height: 1.75;\n  color: var(--va-ink);\n  white-space: pre-wrap;\n  word-break: break-word;\n}\n\n/* 引用角标 */\n.va-ans__cite {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-width: 16px;\n  height: 16px;\n  margin: 0 1px;\n  border: 0;\n  border-radius: 5px;\n  background: var(--va-accent-soft);\n  color: var(--va-accent);\n  font-size: 10.5px;\n  font-weight: 700;\n  line-height: 1;\n  vertical-align: 2px;\n  cursor: pointer;\n  padding: 0 3px;\n  transform: translateY(-2px);\n}\n\n.va-ans__cite:hover { background: var(--va-accent); color: var(--va-card); }\n.va-ans__cite:focus-visible { outline: 2px solid var(--va-accent); outline-offset: 1px; }\n\n/* 流式光标 */\n.va-ans__cursor {\n  display: inline-block;\n  width: 2px;\n  height: 1em;\n  margin-left: 2px;\n  background: var(--va-accent);\n  vertical-align: -2px;\n  animation: va-ans-blink 1s steps(2) infinite;\n}\n\n@keyframes va-ans-blink {\n  50% { opacity: 0; }\n}\n\n.va-ans__sr {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n}\n\n/* 来源列表 */\n.va-ans__sources {\n  margin-top: var(--va-s5);\n  padding-top: var(--va-s4);\n  border-top: 1px solid var(--va-edge);\n}\n\n.va-ans__src-title {\n  margin: 0 0 var(--va-s3);\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.05em;\n  color: var(--va-muted);\n}\n\n.va-ans__list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.va-ans__src {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3);\n  width: 100%;\n  border: 0;\n  border-radius: var(--va-radius-s);\n  background: transparent;\n  padding: 5px var(--va-s2);\n  cursor: pointer;\n  text-align: left;\n  font: inherit;\n}\n\n.va-ans__src:hover { background: var(--va-bg-subtle); }\n.va-ans__src:focus-visible { outline: 2px solid var(--va-accent); outline-offset: -2px; }\n\n.va-ans__no {\n  flex: none;\n  width: 18px;\n  height: 18px;\n  border-radius: 5px;\n  background: var(--va-bg-subtle);\n  color: var(--va-muted);\n  font-size: 10.5px;\n  font-weight: 700;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.va-ans__src:hover .va-ans__no {\n  background: var(--va-accent-soft);\n  color: var(--va-accent);\n}\n\n.va-ans__src-main {\n  display: flex;\n  flex-direction: column;\n  gap: 1px;\n  min-width: 0;\n}\n\n.va-ans__src-title-text {\n  font-size: 12.5px;\n  color: var(--va-ink-2);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.va-ans__origin {\n  font-size: 11px;\n  color: var(--va-muted);\n  font-family: var(--va-font-mono);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-ans__cursor { animation: none; opacity: 0.6; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/ai-answer/types.ts",
      "type": "registry:ui",
      "target": "components/ui/ai-answer/types.ts",
      "content": "/** VaAiAnswer 的类型定义 */\n\nexport interface AnswerSource {\n  id: string;\n  /** 来源标题，如「Vuagent 文档 · 快速开始」 */\n  title: string;\n  /** 链接（不设则为纯文本来源） */\n  url?: string;\n  /** 域名/出处短标，如 \"vuagent.dev\" */\n  origin?: string;\n}\n\nexport interface AiAnswerProps {\n  /** 用户问题（小字展示在答案上方） */\n  question?: string;\n  /**\n   * 回答正文；支持引用标记 [1] [2]（与 sources 下标对应），\n   * 渲染为可点击上标角标\n   */\n  answer: string;\n  sources: AnswerSource[];\n  /** 流式回答中（末尾光标动画） */\n  streaming?: boolean;\n  /** 流式光标间隔风格文案占位 */\n  streamingLabel?: string;\n}\n\nexport interface AiAnswerEvents {\n  /** 点击正文中的引用角标或底部来源行 */\n  source: [source: AnswerSource];\n}\n"
    },
    {
      "path": "components/ui/ai-answer/useCitedText.ts",
      "type": "registry:ui",
      "target": "components/ui/ai-answer/useCitedText.ts",
      "content": "import { computed, h, type VNode } from \"vue\";\n\n/**\n * 回答正文解析：把 [1] / [2] 引用标记替换为可点击上标角标 VNode。\n * 角标序号即 sources 下标 + 1；无对应来源的标记按原文保留。\n */\nexport function useCitedText(\n  getText: () => string,\n  getSources: () => Array<{ id: string }>,\n  onCite: (index: number) => void,\n) {\n  const nodes = computed<VNode[]>(() => {\n    const text = getText();\n    const sources = getSources();\n    const out: VNode[] = [];\n    const re = /\\[(\\d+)\\]/g;\n    let last = 0;\n    let m: RegExpExecArray | null;\n    while ((m = re.exec(text)) !== null) {\n      if (m.index > last) out.push(m[0] ? h(\"span\", text.slice(last, m.index)) : h(\"span\"));\n      const idx = Number(m[1]) - 1;\n      if (sources[idx]) {\n        out.push(\n          h(\n            \"button\",\n            {\n              class: \"va-ans__cite\",\n              type: \"button\",\n              \"aria-label\": `查看来源 ${m[1]}`,\n              onClick: () => onCite(idx),\n            },\n            m[1],\n          ),\n        );\n      } else {\n        out.push(h(\"span\", m[0])); // 无对应来源：原样保留\n      }\n      last = m.index + m[0].length;\n    }\n    if (last < text.length) out.push(h(\"span\", text.slice(last)));\n    return out;\n  });\n\n  return { nodes };\n}\n"
    }
  ]
}
