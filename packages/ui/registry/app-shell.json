{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "app-shell",
  "title": "App Shell",
  "description": "应用外壳：品牌侧栏 + 导航（徽标/禁用/哨兵受控）+ 顶栏与主区插槽；窄屏自动抽屉化（scrim + 汉堡）。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `brand / nav` (string / NavItem[]，默认 \"Vuagent\" / -)：品牌与导航项\n- `v-model:active` (string，默认 -)：当前导航项\n- `v-model:sidebar-open` (boolean，默认 false)：窄屏抽屉态\n- `#topbar / #sidebar-foot / default` (-，默认 -)：顶栏/侧栏尾/主内容插槽",
  "files": [
    {
      "path": "components/ui/app-shell/VaAppShell.vue",
      "type": "registry:ui",
      "target": "components/ui/app-shell/VaAppShell.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, ref, watch } from \"vue\";\nimport type { AppShellEvents, AppShellProps } from \"./types\";\nimport type { NavItem } from \"./types\";\n\nconst props = defineProps<AppShellProps>();\n\nconst emit = defineEmits<AppShellEvents>();\n\n/* 当前导航（哨兵受控） */\nconst touched = ref(false);\nconst innerActive = ref(props.defaultActive ?? props.nav[0]?.id);\nconst activeId = computed(() =>\n  props.active !== undefined || touched.value ? props.active : innerActive.value,\n);\nwatch(\n  () => props.nav,\n  (nav) => {\n    if (activeId.value && !nav.some((n) => n.id === activeId.value)) {\n      touched.value = true;\n      innerActive.value = nav[0]?.id;\n      if (nav[0]) emit(\"update:active\", nav[0].id);\n    }\n  },\n);\n\n/* 窄屏抽屉 */\nconst touchedDrawer = ref(false);\nconst innerDrawer = ref(false);\nconst drawerOpen = computed(() =>\n  props.sidebarOpen !== undefined || touchedDrawer.value ? (props.sidebarOpen ?? false) : innerDrawer.value,\n);\nfunction toggleDrawer() {\n  touchedDrawer.value = true;\n  innerDrawer.value = !drawerOpen.value;\n  emit(\"update:sidebarOpen\", innerDrawer.value);\n}\n\nfunction pick(item: NavItem) {\n  if (item.disabled) return;\n  touched.value = true;\n  innerActive.value = item.id;\n  emit(\"update:active\", item.id);\n  emit(\"navigate\", item);\n  // 窄屏选完自动收抽屉\n  if (drawerOpen.value) toggleDrawer();\n}\n</script>\n\n<template>\n  <div class=\"va-shell\" :data-drawer=\"drawerOpen\">\n    <button\n      class=\"va-shell__burger\"\n      type=\"button\"\n      :aria-expanded=\"drawerOpen\"\n      aria-label=\"打开导航\"\n      @click=\"toggleDrawer\"\n    >≡</button>\n    <div\n      v-if=\"drawerOpen\"\n      class=\"va-shell__scrim\"\n      aria-hidden=\"true\"\n      @click=\"toggleDrawer\"\n    />\n\n    <aside class=\"va-shell__side\" :aria-label=\"`导航：${props.brand ?? '应用'}`\">\n      <span class=\"va-shell__brand\"><span class=\"va-shell__dot\" aria-hidden=\"true\" />{{ props.brand ?? \"Vuagent\" }}</span>\n      <nav class=\"va-shell__nav\">\n        <button\n          v-for=\"item in props.nav\"\n          :key=\"item.id\"\n          class=\"va-shell__item\"\n          type=\"button\"\n          :data-active=\"item.id === activeId\"\n          :disabled=\"item.disabled\"\n          @click=\"pick(item)\"\n        >\n          <span class=\"va-shell__item-label\">{{ item.label }}</span>\n          <span v-if=\"item.badge\" class=\"va-shell__badge\">{{ item.badge > 99 ? \"99+\" : item.badge }}</span>\n        </button>\n      </nav>\n      <div class=\"va-shell__side-foot\"><slot name=\"sidebar-foot\" /></div>\n    </aside>\n\n    <div class=\"va-shell__main\">\n      <header v-if=\"$slots.topbar\" class=\"va-shell__topbar\"><slot name=\"topbar\" /></header>\n      <main class=\"va-shell__content\">\n        <slot />\n      </main>\n    </div>\n  </div>\n</template>\n\n<style>\n/* VaAppShell — 应用外壳（侧栏 + 顶栏 + 主区） */\n\n.va-shell {\n  display: grid;\n  grid-template-columns: 220px 1fr;\n  min-height: 100%;\n  background: var(--va-bg);\n  color: var(--va-ink);\n}\n\n.va-shell__side {\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s5);\n  border-right: 1px solid var(--va-edge);\n  background: var(--va-bg-subtle);\n  padding: var(--va-s5) var(--va-s4);\n  position: sticky;\n  top: 0;\n  height: 100vh;\n  box-sizing: border-box;\n  overflow-y: auto;\n}\n\n.va-shell__brand {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--va-s3);\n  font-size: 14px;\n  font-weight: 700;\n  color: var(--va-ink);\n  padding: 0 var(--va-s2);\n}\n\n.va-shell__dot {\n  width: 9px;\n  height: 9px;\n  border-radius: 50%;\n  background: var(--va-accent);\n}\n\n.va-shell__nav { display: flex; flex-direction: column; gap: 2px; }\n\n.va-shell__item {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--va-s3);\n  border: 0;\n  border-radius: var(--va-radius-s);\n  background: transparent;\n  color: var(--va-ink-2);\n  font: inherit;\n  font-size: 13px;\n  padding: 7px var(--va-s3);\n  cursor: pointer;\n  text-align: left;\n}\n\n.va-shell__item:hover:not(:disabled) { background: var(--va-bg); color: var(--va-ink); }\n.va-shell__item:focus-visible { outline: 2px solid var(--va-accent); outline-offset: -2px; }\n.va-shell__item:disabled { opacity: 0.4; cursor: default; }\n\n.va-shell__item[data-active=\"true\"] {\n  background: var(--va-card);\n  color: var(--va-ink);\n  font-weight: 600;\n  box-shadow: var(--va-shadow-1);\n}\n\n.va-shell__badge {\n  min-width: 18px;\n  height: 18px;\n  border-radius: var(--va-radius-pill);\n  background: var(--va-accent);\n  color: var(--va-card);\n  font-size: 10.5px;\n  font-weight: 700;\n  line-height: 18px;\n  text-align: center;\n  padding: 0 5px;\n}\n\n.va-shell__side-foot { margin-top: auto; }\n\n.va-shell__main {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n}\n\n.va-shell__topbar {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s4);\n  padding: var(--va-s3) var(--va-s6);\n  border-bottom: 1px solid var(--va-edge);\n  background: color-mix(in srgb, var(--va-bg) 80%, transparent);\n  backdrop-filter: blur(8px);\n  position: sticky;\n  top: 0;\n  z-index: 10;\n}\n\n.va-shell__content {\n  flex: 1;\n  padding: var(--va-s6);\n  min-width: 0;\n}\n\n/* 汉堡与遮罩：仅窄屏出现 */\n.va-shell__burger {\n  display: none;\n  position: fixed;\n  top: var(--va-s4);\n  left: var(--va-s4);\n  z-index: 41;\n  width: 38px;\n  height: 38px;\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-card);\n  color: var(--va-ink);\n  font-size: 17px;\n  cursor: pointer;\n}\n\n.va-shell__scrim {\n  display: none;\n  position: fixed;\n  inset: 0;\n  z-index: 39;\n  background: color-mix(in srgb, var(--va-ink) 24%, transparent);\n}\n\n@media (max-width: 960px) {\n  .va-shell { grid-template-columns: 1fr; }\n\n  .va-shell__burger { display: block; }\n\n  .va-shell__side {\n    position: fixed;\n    left: 0;\n    top: 0;\n    bottom: 0;\n    z-index: 40;\n    width: 240px;\n    transform: translateX(-100%);\n    transition: transform var(--va-dur-2) var(--va-ease);\n    box-shadow: var(--va-shadow-3);\n  }\n\n  .va-shell[data-drawer=\"true\"] .va-shell__side { transform: translateX(0); }\n  .va-shell[data-drawer=\"true\"] .va-shell__scrim { display: block; }\n}\n\n@media (max-width: 960px) and (prefers-reduced-motion: reduce) {\n  .va-shell__side { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/app-shell/types.ts",
      "type": "registry:ui",
      "target": "components/ui/app-shell/types.ts",
      "content": "/** VaAppShell 的类型定义 */\n\nexport interface NavItem {\n  id: string;\n  label: string;\n  /** 徽标数（未读等） */\n  badge?: number;\n  disabled?: boolean;\n}\n\nexport interface AppShellProps {\n  /** 品牌名，侧栏顶部 */\n  brand?: string;\n  nav: NavItem[];\n  /** 受控当前导航项（配合 @update:active 实现 v-model:active） */\n  active?: string;\n  defaultActive?: string;\n  /** 窄屏（<960px）侧栏抽屉态受控 */\n  sidebarOpen?: boolean;\n}\n\nexport interface AppShellEvents {\n  \"update:active\": [id: string];\n  /** 点击导航项 */\n  navigate: [item: NavItem];\n  \"update:sidebarOpen\": [v: boolean];\n}\n"
    }
  ]
}
