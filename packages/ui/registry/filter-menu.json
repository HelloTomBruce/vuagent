{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "filter-menu",
  "title": "Filter Menu",
  "description": "过滤条件下拉：checkbox 多选组 + radio 单选组，触发按钮带激活计数徽章，一键清除全部。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `groups` (FilterGroup[]，默认 -)：id/label/type/options 过滤组\n- `v-model` (FilterValue，默认 {})：Record<groupId, string[] | string>\n- `@clear` (-，默认 -)：清除全部",
  "files": [
    {
      "path": "components/ui/filter-menu/VaFilterMenu.vue",
      "type": "registry:ui",
      "target": "components/ui/filter-menu/VaFilterMenu.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, onBeforeUnmount, onMounted, ref, useTemplateRef } from \"vue\";\nimport type { FilterMenuEvents, FilterMenuProps, FilterValue } from \"./types\";\n\nconst props = defineProps<FilterMenuProps>();\n\nconst emit = defineEmits<FilterMenuEvents>();\n\n/* 受控优先，哨兵回落 defaultValue */\nconst touched = ref(false);\nconst inner = ref<FilterValue>(props.defaultValue ?? {});\nconst value = computed<FilterValue>(() =>\n  props.modelValue !== undefined || touched.value ? (props.modelValue ?? {}) : inner.value,\n);\n\nconst open = ref(false);\nconst rootEl = useTemplateRef<HTMLElement>(\"root\");\n\nconst activeCount = computed(() => {\n  let n = 0;\n  for (const g of props.groups) {\n    const v = value.value[g.id];\n    if (Array.isArray(v)) n += v.length;\n    else if (v !== undefined && v !== \"\") n++;\n  }\n  return n;\n});\n\nfunction toggleCheckbox(groupId: string, opt: string) {\n  const cur = Array.isArray(value.value[groupId]) ? ([...value.value[groupId]] as string[]) : [];\n  const idx = cur.indexOf(opt);\n  if (idx >= 0) cur.splice(idx, 1);\n  else cur.push(opt);\n  set(groupId, cur);\n}\n\nfunction setRadio(groupId: string, opt: string, current: string | string[] | undefined) {\n  set(groupId, current === opt ? \"\" : opt);\n}\n\nfunction set(groupId: string, v: string[] | string) {\n  const next = { ...value.value, [groupId]: v };\n  touched.value = true;\n  inner.value = next;\n  emit(\"update:modelValue\", next);\n}\n\nfunction clearAll() {\n  touched.value = true;\n  inner.value = {};\n  emit(\"update:modelValue\", {});\n  emit(\"clear\");\n}\n\nfunction toggle() {\n  open.value = !open.value;\n}\n\nconst onDocMousedown = (e: MouseEvent) => {\n  if (open.value && rootEl.value && !rootEl.value.contains(e.target as Node)) open.value = false;\n};\nonMounted(() => {\n  if (typeof document !== \"undefined\") document.addEventListener(\"mousedown\", onDocMousedown);\n});\nonBeforeUnmount(() => {\n  if (typeof document !== \"undefined\") document.removeEventListener(\"mousedown\", onDocMousedown);\n});\n\nconst checked = (groupId: string, opt: string) => {\n  const v = value.value[groupId];\n  return Array.isArray(v) ? v.includes(opt) : v === opt;\n};\n</script>\n\n<template>\n  <div ref=\"root\" class=\"va-fm\">\n    <button\n      class=\"va-fm__trigger\"\n      type=\"button\"\n      :aria-expanded=\"open\"\n      aria-haspopup=\"true\"\n      @click=\"toggle\"\n      @keydown.escape.prevent=\"open = false\"\n    >\n      {{ props.triggerLabel ?? \"筛选\" }}\n      <span v-if=\"activeCount\" class=\"va-fm__count\">{{ activeCount }}</span>\n    </button>\n\n    <div v-if=\"open\" class=\"va-fm__panel\" role=\"group\" :aria-label=\"props.triggerLabel ?? '筛选'\">\n      <section v-for=\"g in props.groups\" :key=\"g.id\" class=\"va-fm__group\">\n        <h4 class=\"va-fm__label\">{{ g.label }}</h4>\n        <div class=\"va-fm__opts\">\n          <label v-for=\"opt in g.options\" :key=\"opt.value\" class=\"va-fm__opt\">\n            <input\n              class=\"va-fm__box\"\n              :type=\"g.type === 'radio' ? 'radio' : 'checkbox'\"\n              :name=\"`va-fm-${g.id}`\"\n              :checked=\"checked(g.id, opt.value)\"\n              @change=\"g.type === 'radio' ? setRadio(g.id, opt.value, value[g.id]) : toggleCheckbox(g.id, opt.value)\"\n            >\n            <span>{{ opt.label }}</span>\n          </label>\n        </div>\n      </section>\n      <footer class=\"va-fm__foot\">\n        <button class=\"va-act va-act--ghost va-act--sm va-fm__clear\" type=\"button\" :disabled=\"!activeCount\" @click=\"clearAll\">清除全部</button>\n      </footer>\n    </div>\n  </div>\n</template>\n\n<style>\n/* VaFilterMenu — 过滤条件下拉菜单 */\n\n.va-fm { position: relative; display: inline-flex; }\n\n.va-fm__trigger {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--va-s2);\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-card);\n  color: var(--va-ink-2);\n  font-size: 13px;\n  padding: 6px 12px;\n  cursor: pointer;\n  transition: border-color var(--va-dur-1) var(--va-ease);\n}\n\n.va-fm__trigger:hover { border-color: var(--va-edge-strong); }\n.va-fm__trigger:focus-visible { outline: 2px solid var(--va-accent); outline-offset: 1px; }\n.va-fm__trigger[aria-expanded=\"true\"] { border-color: var(--va-accent); }\n\n.va-fm__count {\n  min-width: 18px;\n  height: 18px;\n  border-radius: var(--va-radius-pill);\n  background: var(--va-accent);\n  color: var(--va-card);\n  font-size: 11px;\n  font-weight: 700;\n  line-height: 18px;\n  text-align: center;\n  padding: 0 5px;\n}\n\n.va-fm__panel {\n  position: absolute;\n  top: calc(100% + 6px);\n  right: 0;\n  z-index: 30;\n  min-width: 240px;\n  max-height: 340px;\n  overflow-y: auto;\n  background: var(--va-card);\n  border: 1px solid var(--va-edge-strong);\n  border-radius: var(--va-radius-m);\n  box-shadow: var(--va-shadow-2);\n  padding: var(--va-s4);\n}\n\n.va-fm__group + .va-fm__group { margin-top: var(--va-s4); }\n\n.va-fm__label {\n  margin: 0 0 var(--va-s2);\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.04em;\n  color: var(--va-muted);\n}\n\n.va-fm__opts { display: flex; flex-direction: column; gap: 2px; }\n\n.va-fm__opt {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3);\n  font-size: 13px;\n  color: var(--va-ink-2);\n  padding: 4px var(--va-s2);\n  border-radius: var(--va-radius-s);\n  cursor: pointer;\n  user-select: none;\n}\n\n.va-fm__opt:hover { background: var(--va-bg-subtle); }\n\n.va-fm__box {\n  accent-color: var(--va-accent);\n  margin: 0;\n}\n\n.va-fm__foot {\n  display: flex;\n  justify-content: flex-end;\n  margin-top: var(--va-s4);\n  padding-top: var(--va-s3);\n  border-top: 1px solid var(--va-edge);\n}\n\n\n.va-fm__clear:hover:not(:disabled) { color: var(--va-danger); background: transparent; border-color: transparent; }\n.va-fm__clear:disabled { opacity: 0.4; cursor: default; }\n\n/* 按钮基类（自动附带） */\n/* ============================================================\n   按钮基类 —— 全库动作按钮的单一样式来源。\n   组件叠加使用：class=\"va-act va-act--primary va-xxx__submit\"，\n   组件自己的 CSS 只写布局/色彩覆盖（width、pill 圆角等）。\n   registry 生成器会把本文件自动内联进用了 va-act 的组件拷贝。\n   ============================================================ */\n\n.va-act {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-card);\n  color: var(--va-ink-2);\n  font: inherit;\n  font-size: 13px;\n  line-height: 1.4;\n  padding: 5px 14px;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: border-color var(--va-dur-1) var(--va-ease), background var(--va-dur-1) var(--va-ease),\n    color var(--va-dur-1) var(--va-ease);\n}\n\n.va-act:hover:not(:disabled) { border-color: var(--va-edge-strong); }\n\n.va-act:focus-visible { outline: 2px solid var(--va-accent); outline-offset: 1px; }\n\n.va-act:disabled { opacity: 0.45; cursor: default; }\n\n/* 尺寸 */\n.va-act--sm { font-size: 12px; padding: 3px 10px; }\n.va-act--lg { font-size: 14px; padding: 7px 18px; }\n\n/* 变体 */\n.va-act--primary {\n  background: var(--va-accent);\n  border-color: var(--va-accent);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-act--primary:hover:not(:disabled) {\n  background: var(--va-accent-hover);\n  border-color: var(--va-accent-hover);\n}\n\n.va-act--ghost {\n  border-color: transparent;\n  background: transparent;\n}\n\n.va-act--ghost:hover:not(:disabled) { background: var(--va-bg-subtle); }\n\n.va-act--danger { border-color: transparent; background: transparent; color: var(--va-danger); }\n\n.va-act--danger:hover:not(:disabled) {\n  background: color-mix(in srgb, var(--va-danger) 10%, transparent);\n  border-color: transparent;\n}\n\n/* 语义色实底（成功/危险确认场景，按需叠加） */\n.va-act--success {\n  background: var(--va-success);\n  border-color: var(--va-success);\n  color: #fff;\n  font-weight: 600;\n}\n\n/* 墨色实底：审批/决策/应用这类\"终审\"主操作（区别于 accent 常规主操作） */\n.va-act--ink {\n  background: var(--va-ink);\n  border-color: var(--va-ink);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-act--ink:hover:not(:disabled) { opacity: 0.88; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-act { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/filter-menu/types.ts",
      "type": "registry:ui",
      "target": "components/ui/filter-menu/types.ts",
      "content": "/** VaFilterMenu 的类型定义 */\n\nexport type FilterGroupType = \"checkbox\" | \"radio\";\n\nexport interface FilterOption {\n  value: string;\n  label: string;\n}\n\nexport interface FilterGroup {\n  id: string;\n  label: string;\n  type?: FilterGroupType;\n  options: FilterOption[];\n}\n\n/** 过滤值：checkbox 组为 string[]，radio 组为 string（单值） */\nexport type FilterValue = Record<string, string[] | string>;\n\nexport interface FilterMenuProps {\n  groups: FilterGroup[];\n  /** 受控过滤值（配合 @update:modelValue 实现 v-model） */\n  modelValue?: FilterValue;\n  /** 触发按钮文案 */\n  triggerLabel?: string;\n  /** 非受控初始值 */\n  defaultValue?: FilterValue;\n}\n\nexport interface FilterMenuEvents {\n  \"update:modelValue\": [value: FilterValue];\n  /** 点击\"清除\"（携带空值，组件已同步） */\n  clear: [];\n}\n"
    }
  ]
}
