{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "settings-billing",
  "title": "Settings / Billing",
  "description": "设置/账单页：左侧设置导航（哨兵受控）+ 用量插槽 + 套餐卡网格（当前/推荐态、特性清单、切换回调）。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `nav / v-model:active` (NavItem[] / string，默认 - / -)：设置导航\n- `plans` (BillingPlan[]，默认 -)：name/price/features/current/recommended\n- `@choosePlan` (-，默认 -)：切换套餐\n- `#usage / #plans / default` (-，默认 -)：用量/自定义套餐/更多内容插槽",
  "files": [
    {
      "path": "components/ui/settings-billing/VaSettingsBilling.vue",
      "type": "registry:ui",
      "target": "components/ui/settings-billing/VaSettingsBilling.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, ref } from \"vue\";\nimport type { SettingsBillingEvents, SettingsBillingProps } from \"./types\";\nimport type { BillingPlan } from \"./types\";\n\nconst props = defineProps<SettingsBillingProps>();\n\nconst emit = defineEmits<SettingsBillingEvents>();\n\n/* 设置导航（哨兵受控） */\nconst touched = ref(false);\nconst innerActive = ref(props.defaultActive ?? props.nav?.[0]?.id);\nconst activeId = computed(() =>\n  props.active !== undefined || touched.value ? props.active : innerActive.value,\n);\n\nfunction pickNav(id: string) {\n  touched.value = true;\n  innerActive.value = id;\n  emit(\"update:active\", id);\n}\n</script>\n\n<template>\n  <div class=\"va-bill\">\n    <aside v-if=\"props.nav?.length\" class=\"va-bill__nav\" :aria-label=\"`设置导航`\">\n      <h3 v-if=\"props.title\" class=\"va-bill__title\">{{ props.title }}</h3>\n      <button\n        v-for=\"n in props.nav\"\n        :key=\"n.id\"\n        class=\"va-bill__item\"\n        type=\"button\"\n        :data-active=\"n.id === activeId\"\n        @click=\"pickNav(n.id)\"\n      >\n        {{ n.label }}\n        <span v-if=\"n.badge\" class=\"va-bill__badge\">{{ n.badge }}</span>\n      </button>\n    </aside>\n\n    <main class=\"va-bill__main\">\n      <slot name=\"usage\" />\n\n      <section class=\"va-bill__plans\" aria-label=\"订阅套餐\">\n        <h3 class=\"va-bill__section-title\">套餐</h3>\n        <slot name=\"plans\">\n          <div v-if=\"props.plans?.length\" class=\"va-bill__grid\">\n            <article\n              v-for=\"p in props.plans\"\n              :key=\"p.id\"\n              class=\"va-bill__plan\"\n              :data-current=\"p.current ?? false\"\n              :data-recommended=\"p.recommended ?? false\"\n            >\n              <header class=\"va-bill__plan-head\">\n                <span class=\"va-bill__plan-name\">{{ p.name }}</span>\n                <span v-if=\"p.recommended && !p.current\" class=\"va-bill__flag\">推荐</span>\n                <span v-if=\"p.current\" class=\"va-bill__flag va-bill__flag--current\">当前</span>\n              </header>\n              <strong class=\"va-bill__price\">{{ p.price }}</strong>\n              <ul class=\"va-bill__features\">\n                <li v-for=\"f in p.features\" :key=\"f\">{{ f }}</li>\n              </ul>\n              <button\n                class=\"va-act va-bill__choose\"\n                :class=\"p.current ? '' : 'va-act--primary'\"\n                type=\"button\"\n                :disabled=\"p.current\"\n                @click=\"emit('choosePlan', p as BillingPlan)\"\n              >{{ p.current ? \"使用中\" : \"切换到此套餐\" }}</button>\n            </article>\n          </div>\n        </slot>\n      </section>\n\n      <slot />\n    </main>\n  </div>\n</template>\n\n<style>\n/* VaSettingsBilling — 设置/账单页（左导航 + 用量区 + 套餐卡） */\n\n.va-bill {\n  display: grid;\n  grid-template-columns: 200px 1fr;\n  gap: var(--va-s6);\n  align-items: start;\n}\n\n.va-bill__nav {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  position: sticky;\n  top: var(--va-s5);\n}\n\n.va-bill__title {\n  margin: 0 0 var(--va-s3);\n  font-size: 13px;\n  font-weight: 700;\n  color: var(--va-ink);\n  padding: 0 var(--va-s3);\n}\n\n.va-bill__item {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--va-s3);\n  border: 0;\n  border-radius: var(--va-radius-s);\n  background: transparent;\n  color: var(--va-ink-2);\n  font: inherit;\n  font-size: 13px;\n  padding: 7px var(--va-s3);\n  cursor: pointer;\n  text-align: left;\n}\n\n.va-bill__item:hover { background: var(--va-bg-subtle); color: var(--va-ink); }\n.va-bill__item:focus-visible { outline: 2px solid var(--va-accent); outline-offset: -2px; }\n.va-bill__item[data-active=\"true\"] { background: var(--va-card); color: var(--va-ink); font-weight: 600; box-shadow: var(--va-shadow-1); }\n\n.va-bill__badge {\n  min-width: 18px;\n  height: 18px;\n  border-radius: var(--va-radius-pill);\n  background: var(--va-accent);\n  color: var(--va-card);\n  font-size: 10.5px;\n  font-weight: 700;\n  line-height: 18px;\n  text-align: center;\n  padding: 0 5px;\n}\n\n.va-bill__main {\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s6);\n  min-width: 0;\n}\n\n.va-bill__section-title {\n  margin: 0 0 var(--va-s4);\n  font-size: 14px;\n  font-weight: 700;\n  color: var(--va-ink);\n}\n\n.va-bill__grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));\n  gap: var(--va-s4);\n}\n\n.va-bill__plan {\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s3);\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-m);\n  background: var(--va-card);\n  padding: var(--va-s5);\n}\n\n.va-bill__plan[data-recommended=\"true\"] {\n  border-color: color-mix(in srgb, var(--va-accent) 45%, transparent);\n  box-shadow: 0 0 0 3px var(--va-accent-soft);\n}\n\n.va-bill__plan[data-current=\"true\"] {\n  border-color: color-mix(in srgb, var(--va-success) 45%, transparent);\n}\n\n.va-bill__plan-head {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s2);\n}\n\n.va-bill__plan-name { font-size: 13.5px; font-weight: 700; color: var(--va-ink); }\n\n.va-bill__flag {\n  font-size: 10.5px;\n  font-weight: 700;\n  padding: 1px 8px;\n  border-radius: var(--va-radius-pill);\n  background: var(--va-accent-soft);\n  color: var(--va-accent);\n}\n\n.va-bill__flag--current {\n  background: color-mix(in srgb, var(--va-success) 14%, transparent);\n  color: var(--va-success);\n}\n\n.va-bill__price {\n  font-size: 20px;\n  font-weight: 800;\n  color: var(--va-ink);\n}\n\n.va-bill__features {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s2);\n  flex: 1;\n}\n\n.va-bill__features li {\n  font-size: 12.5px;\n  color: var(--va-ink-2);\n  display: flex;\n  gap: var(--va-s2);\n}\n\n.va-bill__features li::before {\n  content: \"✓\";\n  color: var(--va-success);\n  font-weight: 700;\n}\n\n@media (max-width: 760px) {\n  .va-bill { grid-template-columns: 1fr; }\n  .va-bill__nav { position: static; flex-direction: row; flex-wrap: wrap; }\n}\n\n/* 按钮基类（自动附带） */\n/* ============================================================\n   按钮基类 —— 全库动作按钮的单一样式来源。\n   组件叠加使用：class=\"va-act va-act--primary va-xxx__submit\"，\n   组件自己的 CSS 只写布局/色彩覆盖（width、pill 圆角等）。\n   registry 生成器会把本文件自动内联进用了 va-act 的组件拷贝。\n   ============================================================ */\n\n.va-act {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-card);\n  color: var(--va-ink-2);\n  font: inherit;\n  font-size: 13px;\n  line-height: 1.4;\n  padding: 5px 14px;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: border-color var(--va-dur-1) var(--va-ease), background var(--va-dur-1) var(--va-ease),\n    color var(--va-dur-1) var(--va-ease);\n}\n\n.va-act:hover:not(:disabled) { border-color: var(--va-edge-strong); }\n\n.va-act:focus-visible { outline: 2px solid var(--va-accent); outline-offset: 1px; }\n\n.va-act:disabled { opacity: 0.45; cursor: default; }\n\n/* 尺寸 */\n.va-act--sm { font-size: 12px; padding: 3px 10px; }\n.va-act--lg { font-size: 14px; padding: 7px 18px; }\n\n/* 变体 */\n.va-act--primary {\n  background: var(--va-accent);\n  border-color: var(--va-accent);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-act--primary:hover:not(:disabled) {\n  background: var(--va-accent-hover);\n  border-color: var(--va-accent-hover);\n}\n\n.va-act--ghost {\n  border-color: transparent;\n  background: transparent;\n}\n\n.va-act--ghost:hover:not(:disabled) { background: var(--va-bg-subtle); }\n\n.va-act--danger { border-color: transparent; background: transparent; color: var(--va-danger); }\n\n.va-act--danger:hover:not(:disabled) {\n  background: color-mix(in srgb, var(--va-danger) 10%, transparent);\n  border-color: transparent;\n}\n\n/* 语义色实底（成功/危险确认场景，按需叠加） */\n.va-act--success {\n  background: var(--va-success);\n  border-color: var(--va-success);\n  color: #fff;\n  font-weight: 600;\n}\n\n/* 墨色实底：审批/决策/应用这类\"终审\"主操作（区别于 accent 常规主操作） */\n.va-act--ink {\n  background: var(--va-ink);\n  border-color: var(--va-ink);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-act--ink:hover:not(:disabled) { opacity: 0.88; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-act { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/settings-billing/types.ts",
      "type": "registry:ui",
      "target": "components/ui/settings-billing/types.ts",
      "content": "/** VaSettingsBilling 的类型定义 */\n\nexport interface BillingPlan {\n  id: string;\n  name: string;\n  /** 价格文案，如 \"$20 / 月\" */\n  price: string;\n  features: string[];\n  current?: boolean;\n  recommended?: boolean;\n}\n\nexport interface SettingsBillingProps {\n  /** 设置区导航（沿用 AppShell 的 NavItem 形状） */\n  nav?: Array<{ id: string; label: string; badge?: number }>;\n  /** 受控当前设置项 */\n  active?: string;\n  defaultActive?: string;\n  /** 页面标题 */\n  title?: string;\n  /** 套餐卡；不传则隐藏该区（宿主用 #plans 插槽自定义） */\n  plans?: BillingPlan[];\n}\n\nexport interface SettingsBillingEvents {\n  \"update:active\": [id: string];\n  /** 点击套餐卡（升级/降级） */\n  choosePlan: [plan: BillingPlan];\n}\n"
    }
  ]
}
