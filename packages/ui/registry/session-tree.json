{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "session-tree",
  "title": "Session List",
  "description": "会话侧栏：工作区为平铺分组标题（无树形折叠）、会话一列排开，支持行内重命名/归档恢复/删除二次确认（confirmMode 可交由宿主模态确认）；footer 插槽承载底部操作区。",
  "type": "registry:ui",
  "dependencies": [
    "lucide-vue-next"
  ],
  "registryDependencies": [],
  "docs": "- `workspaces` (TreeWorkspace[]，默认 -)：工作区分组标题（平铺）\n- `sessions` (TreeSession[]，默认 -)：非归档会话（按 workspaceId 归组）\n- `archived` (TreeSession[]，默认 -)：归档会话（底部折叠分区）\n- `newSession / searchable` (boolean，默认 false)：常驻新建会话钮（目标=当前工作区）/ 会话搜索框\n- `confirmMode` (\"inline\" | \"none\"，默认 \"inline\")：删除确认：行内二次确认 / 直接发 remove·removeWorkspace 事件由宿主路由到 vaConfirm 等模态确认\n- `#footer` (-，默认 -)：树底部操作区插槽（margin-top:auto 沉底，如设置入口）\n- `running / waitingApproval / pinned` (TreeSession 字段，默认 -)：行内状态点（脉冲/红点+徽标）与置顶图钉\n- `@selectSession/@createSession/@togglePin/@removeWorkspace/@rename/@archive/@remove` (-，默认 -)：操作回调",
  "files": [
    {
      "path": "components/ui/session-tree/VaSessionTree.vue",
      "type": "registry:ui",
      "target": "components/ui/session-tree/VaSessionTree.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, reactive, ref, watch } from \"vue\";\nimport { Archive, ArchiveRestore, Check, ChevronDown, ChevronRight, FolderClosed, Pen, Pin, PinOff, Plus, Search, Trash2, X } from \"lucide-vue-next\";\nimport type { SessionTreeEvents, SessionTreeProps, TreeSession } from \"./types\";\n\nconst props = withDefaults(defineProps<SessionTreeProps>(), {\n  disabled: false,\n  workspaceCreateMode: \"input\",\n  newSession: false,\n  searchable: false,\n  collapsible: false,\n  confirmMode: \"inline\",\n  hoverOps: false,\n});\n\nconst emit = defineEmits<SessionTreeEvents>();\n\n/* 工作区分组折叠（collapsible 模式）：新工作区默认展开 */\nconst expandedWs = reactive(new Set<string>());\nwatch(\n  () => props.workspaces.map((w) => w.id).join(\",\"),\n  (ids) => {\n    if (!props.collapsible) return;\n    for (const id of ids.split(\",\")) if (id) expandedWs.add(id);\n  },\n  { immediate: true }\n);\nfunction toggleWs(id: string) {\n  if (expandedWs.has(id)) expandedWs.delete(id);\n  else expandedWs.add(id);\n}\nconst wsOpen = (id: string) => !props.collapsible || expandedWs.has(id);\n\n/* 顶部常驻「＋ 新建会话」：目标 = 当前工作区（G7） */\nfunction onNewSession() {\n  if (props.disabled || !props.currentWorkspaceId) return;\n  emit(\"createSession\", props.currentWorkspaceId);\n}\n\n/* 会话搜索（G9）：组件内按标题过滤，隐藏无匹配分组 */\nconst keyword = ref(\"\");\nconst matched = (s: TreeSession) => !keyword.value.trim() || (s.title || \"未命名会话\").toLowerCase().includes(keyword.value.trim().toLowerCase());\nconst searching = computed(() => keyword.value.trim().length > 0);\n\n/* 新建工作区：input=行内输入框（Enter 创建 / Esc 取消）；picker=「＋」直接触发 createWorkspacePick */\nconst creatingWs = ref(false);\nconst wsDraft = ref(\"\");\nfunction startCreateWs() {\n  if (props.disabled) return;\n  if (props.workspaceCreateMode === \"picker\") {\n    emit(\"createWorkspacePick\");\n    return;\n  }\n  creatingWs.value = true;\n  wsDraft.value = \"\";\n}\nfunction commitCreateWs() {\n  const name = wsDraft.value.trim();\n  if (name) emit(\"createWorkspace\", name);\n  creatingWs.value = false;\n}\nfunction cancelCreateWs() {\n  creatingWs.value = false;\n}\n\n/* 行内重命名 */\nconst editingId = ref<string | null>(null);\nconst draft = ref(\"\");\nfunction startRename(s: TreeSession) {\n  if (props.disabled) return;\n  editingId.value = s.id;\n  draft.value = s.title || \"未命名会话\";\n}\nfunction commitRename() {\n  if (editingId.value) {\n    const t = draft.value.trim();\n    const prev = [...props.sessions, ...props.archived].find((x) => x.id === editingId.value)?.title ?? \"\";\n    if (t && t !== prev) emit(\"rename\", editingId.value, t);\n  }\n  editingId.value = null;\n}\nfunction cancelRename() {\n  editingId.value = null;\n}\n\n/* 删除二次确认（3s 内再次点击才生效）：会话与工作区分开记，避免 id 撞车。\n   confirmMode=\"none\"（宿主自行路由到 vaConfirm 等模态确认）时跳过行内确认直接发事件 */\nconst confirmId = ref<string | null>(null);\nlet confirmTimer: number | undefined;\nfunction armConfirm(current: string | null, set: (v: string | null) => void, id: string, fire: () => void) {\n  if (props.confirmMode === \"none\") {\n    fire();\n    return;\n  }\n  if (current === id) {\n    fire();\n    set(null);\n  } else {\n    set(id);\n    window.clearTimeout(confirmTimer);\n    confirmTimer = window.setTimeout(() => set(null), 3000);\n  }\n}\nfunction askRemove(id: string) {\n  if (props.disabled) return;\n  armConfirm(confirmId.value, (v) => (confirmId.value = v), id, () => emit(\"remove\", id));\n}\n\n/* 删除工作区（其下会话回到未分组，由宿主决定提示） */\nconst confirmWsId = ref<string | null>(null);\nfunction askRemoveWorkspace(id: string) {\n  if (props.disabled) return;\n  armConfirm(confirmWsId.value, (v) => (confirmWsId.value = v), id, () => emit(\"removeWorkspace\", id));\n}\n\n/* 平铺分区：工作区只是分组标题（无折叠无缩进），会话一列排开；搜索时过滤 */\nconst groups = computed(() =>\n  props.workspaces.map((w) => ({\n    workspace: w,\n    sessions: props.sessions.filter((s) => (s.workspaceId ?? \"\") === w.id && matched(s)),\n  })),\n);\n\nconst orphans = computed(() => props.sessions.filter((s) => !knownWorkspace(s) && matched(s)));\nfunction knownWorkspace(s: TreeSession): boolean {\n  return props.workspaces.some((w) => w.id === (s.workspaceId ?? \"\"));\n}\n\n/* 已归档分区折叠态 */\nconst archivedOpen = ref(false);\n\nconst titleOf = (s: TreeSession) => s.title || \"未命名会话\";\nfunction fmtTime(ts: number): string {\n  const diff = Date.now() - ts;\n  if (diff < 60_000) return \"刚刚\";\n  if (diff < 3_600_000) return `${Math.floor(diff / 60_000)} 分钟前`;\n  if (diff < 86_400_000) return `${Math.floor(diff / 3_600_000)} 小时前`;\n  if (diff < 7 * 86_400_000) return `${Math.floor(diff / 86_400_000)} 天前`;\n  return new Date(ts).toLocaleDateString(\"zh-CN\");\n}\n\nfunction pickSession(s: TreeSession) {\n  if (props.disabled) return;\n  if (s.id !== props.currentSessionId) emit(\"selectSession\", s.id);\n}\nfunction onCreate(wId: string) {\n  if (props.disabled) return;\n  emit(\"createSession\", wId);\n}\n</script>\n\n<template>\n  <div class=\"va-stree\" :data-hover-ops=\"props.hoverOps || undefined\">\n    <!-- 常驻新建会话（G7）：目标 = 当前工作区 -->\n    <button\n      v-if=\"props.newSession\"\n      class=\"va-stree__new-session\"\n      type=\"button\"\n      :disabled=\"props.disabled || !props.currentWorkspaceId\"\n      :title=\"props.currentWorkspaceId ? `在「${props.workspaces.find((w) => w.id === props.currentWorkspaceId)?.name ?? ''}」新建会话` : '先选择或新建工作区'\"\n      @click=\"onNewSession\"\n    ><Plus :size=\"15\" aria-hidden=\"true\" />新建会话</button>\n\n    <Transition name=\"va-stree-pop\">\n      <div v-if=\"creatingWs\" class=\"va-stree__ws-create\">\n      <input\n        v-model=\"wsDraft\"\n        class=\"va-stree__input\"\n        type=\"text\"\n        placeholder=\"本地文件夹路径，如 ~/code/my-proj\"\n        maxlength=\"60\"\n        @keydown.enter.prevent=\"commitCreateWs\"\n        @keydown.escape.prevent=\"cancelCreateWs\"\n      />\n      <button class=\"va-stree__op\" type=\"button\" aria-label=\"确认创建\" @click=\"commitCreateWs\"><Check :size=\"14\" /></button>\n      <button class=\"va-stree__op\" type=\"button\" aria-label=\"取消\" @click=\"cancelCreateWs\"><X :size=\"14\" /></button>\n    </div>\n    </Transition>\n    <button\n      v-if=\"!creatingWs\"\n      class=\"va-stree__new\"\n      type=\"button\"\n      :disabled=\"props.disabled\"\n      @click=\"startCreateWs\"\n    ><Plus :size=\"15\" aria-hidden=\"true\" />新建工作区</button>\n\n    <!-- 会话搜索（G9） -->\n    <label v-if=\"props.searchable\" class=\"va-stree__search\">\n      <Search :size=\"13\" aria-hidden=\"true\" />\n      <input v-model=\"keyword\" type=\"text\" placeholder=\"搜索会话\" aria-label=\"搜索会话\" />\n    </label>\n\n    <section\n      v-for=\"g in groups\"\n      :key=\"g.workspace.id\"\n      class=\"va-stree__group\"\n      :data-current=\"g.workspace.id === props.currentWorkspaceId || undefined\"\n    >\n      <div class=\"va-stree__head\">\n        <button\n          v-if=\"props.collapsible\"\n          class=\"va-stree__toggle\"\n          type=\"button\"\n          :aria-label=\"wsOpen(g.workspace.id) ? `收起 ${g.workspace.name} 的会话` : `展开 ${g.workspace.name} 的会话`\"\n          @click.stop=\"toggleWs(g.workspace.id)\"\n        >\n          <ChevronDown v-if=\"wsOpen(g.workspace.id)\" :size=\"13\" aria-hidden=\"true\" />\n          <ChevronRight v-else :size=\"13\" aria-hidden=\"true\" />\n        </button>\n        <span class=\"va-stree__ws\" :title=\"g.workspace.description || g.workspace.name\">\n          <span class=\"va-stree__ws-icon\" aria-hidden=\"true\"><FolderClosed :size=\"14\" /></span>\n          <span class=\"va-stree__ws-name\">{{ g.workspace.name }}</span>\n          <span class=\"va-stree__count\">{{ g.sessions.length }}</span>\n          <span v-if=\"g.workspace.id === props.currentWorkspaceId\" class=\"va-stree__tag\">当前</span>\n        </span>\n        <button class=\"va-stree__op\" type=\"button\" aria-label=\"在此工作区新建会话\" :disabled=\"props.disabled\" @click.stop=\"onCreate(g.workspace.id)\"><Plus :size=\"14\" /></button>\n        <button\n          class=\"va-stree__op\"\n          type=\"button\"\n          :data-danger=\"confirmWsId === g.workspace.id || undefined\"\n          :aria-label=\"confirmWsId === g.workspace.id ? '确认删除工作区' : '删除工作区'\"\n          :disabled=\"props.disabled\"\n          @click.stop=\"askRemoveWorkspace(g.workspace.id)\"\n        ><span v-if=\"confirmWsId === g.workspace.id\" class=\"va-stree__confirm\">确认?</span><Trash2 v-else :size=\"13\" /></button>\n      </div>\n\n      <Transition name=\"va-stree-fold\">\n        <div v-if=\"wsOpen(g.workspace.id)\" class=\"va-stree__list\">\n          <div class=\"va-stree__list-clip\">\n        <div\n          v-for=\"s in g.sessions\"\n          :key=\"s.id\"\n          class=\"va-stree__session\"\n          :data-active=\"s.id === props.currentSessionId || undefined\"\n        >\n          <template v-if=\"editingId === s.id\">\n            <input\n              v-model=\"draft\"\n              class=\"va-stree__input\"\n              type=\"text\"\n              @keydown.enter.prevent=\"commitRename\"\n              @keydown.escape.prevent=\"cancelRename\"\n            />\n            <button class=\"va-stree__op\" type=\"button\" aria-label=\"确认重命名\" @click=\"commitRename\"><Check :size=\"14\" /></button>\n            <button class=\"va-stree__op\" type=\"button\" aria-label=\"取消\" @click=\"cancelRename\"><X :size=\"14\" /></button>\n          </template>\n          <template v-else>\n            <button class=\"va-stree__session-main\" type=\"button\" :title=\"titleOf(s)\" @click=\"pickSession(s)\">\n              <span v-if=\"s.waitingApproval\" class=\"va-stree__dot va-stree__dot--warn\" aria-hidden=\"true\" />\n              <span v-else-if=\"s.running\" class=\"va-stree__dot va-stree__dot--run\" aria-hidden=\"true\" />\n              <Pin v-else-if=\"s.pinned\" class=\"va-stree__pin\" :size=\"11\" aria-hidden=\"true\" />\n              <span class=\"va-stree__session-title\">{{ titleOf(s) }}</span>\n              <span v-if=\"s.waitingApproval\" class=\"va-stree__warn-tag\">待审批</span>\n              <span class=\"va-stree__time\">{{ fmtTime(s.updatedAt) }}</span>\n            </button>\n            <button class=\"va-stree__op\" type=\"button\" :aria-label=\"s.pinned ? '取消置顶' : '置顶'\" :disabled=\"props.disabled\" @click.stop=\"emit('togglePin', s.id)\">\n              <PinOff v-if=\"s.pinned\" :size=\"13\" /><Pin v-else :size=\"13\" />\n            </button>\n            <button class=\"va-stree__op\" type=\"button\" aria-label=\"重命名\" :disabled=\"props.disabled\" @click.stop=\"startRename(s)\"><Pen :size=\"13\" /></button>\n            <button class=\"va-stree__op\" type=\"button\" aria-label=\"归档\" :disabled=\"props.disabled\" @click.stop=\"emit('archive', s.id, true)\"><Archive :size=\"13\" /></button>\n            <button\n              class=\"va-stree__op\"\n              type=\"button\"\n              :data-danger=\"confirmId === s.id || undefined\"\n              :aria-label=\"confirmId === s.id ? '确认删除' : '删除'\"\n              :disabled=\"props.disabled\"\n              @click.stop=\"askRemove(s.id)\"\n            ><span v-if=\"confirmId === s.id\" class=\"va-stree__confirm\">确认?</span><Trash2 v-else :size=\"13\" /></button>\n          </template>\n        </div>\n        <p v-if=\"g.sessions.length === 0\" class=\"va-stree__empty va-fade-in\">{{ searching ? \"无匹配会话\" : \"暂无会话\" }}</p>\n          </div>\n        </div>\n      </Transition>\n    </section>\n\n    <p v-if=\"searching && groups.every((g) => g.sessions.length === 0) && orphans.length === 0\" class=\"va-stree__empty va-stree__search-empty va-fade-in\">\n      没有匹配「{{ keyword.trim() }}」的会话\n    </p>\n\n    <section v-if=\"orphans.length\" class=\"va-stree__group\">\n      <div class=\"va-stree__head\">\n        <span class=\"va-stree__ws\">\n          <span class=\"va-stree__ws-name\">未分组</span>\n          <span class=\"va-stree__count\">{{ orphans.length }}</span>\n        </span>\n      </div>\n      <div class=\"va-stree__list\">\n        <div class=\"va-stree__list-clip\">\n          <div\n            v-for=\"s in orphans\"\n            :key=\"s.id\"\n            class=\"va-stree__session\"\n            :data-active=\"s.id === props.currentSessionId || undefined\"\n          >\n            <template v-if=\"editingId === s.id\">\n              <input\n                v-model=\"draft\"\n                class=\"va-stree__input\"\n                type=\"text\"\n                @keydown.enter.prevent=\"commitRename\"\n                @keydown.escape.prevent=\"cancelRename\"\n              />\n              <button class=\"va-stree__op\" type=\"button\" aria-label=\"确认重命名\" @click=\"commitRename\"><Check :size=\"14\" /></button>\n              <button class=\"va-stree__op\" type=\"button\" aria-label=\"取消\" @click=\"cancelRename\"><X :size=\"14\" /></button>\n            </template>\n            <template v-else>\n              <button class=\"va-stree__session-main\" type=\"button\" :title=\"titleOf(s)\" @click=\"pickSession(s)\">\n                <span v-if=\"s.waitingApproval\" class=\"va-stree__dot va-stree__dot--warn\" aria-hidden=\"true\" />\n                <span v-else-if=\"s.running\" class=\"va-stree__dot va-stree__dot--run\" aria-hidden=\"true\" />\n                <Pin v-else-if=\"s.pinned\" class=\"va-stree__pin\" :size=\"11\" aria-hidden=\"true\" />\n                <span class=\"va-stree__session-title\">{{ titleOf(s) }}</span>\n                <span v-if=\"s.waitingApproval\" class=\"va-stree__warn-tag\">待审批</span>\n                <span class=\"va-stree__time\">{{ fmtTime(s.updatedAt) }}</span>\n              </button>\n              <button class=\"va-stree__op\" type=\"button\" :aria-label=\"s.pinned ? '取消置顶' : '置顶'\" :disabled=\"props.disabled\" @click.stop=\"emit('togglePin', s.id)\">\n                <PinOff v-if=\"s.pinned\" :size=\"13\" /><Pin v-else :size=\"13\" />\n              </button>\n              <button class=\"va-stree__op\" type=\"button\" aria-label=\"重命名\" :disabled=\"props.disabled\" @click.stop=\"startRename(s)\"><Pen :size=\"13\" /></button>\n              <button class=\"va-stree__op\" type=\"button\" aria-label=\"归档\" :disabled=\"props.disabled\" @click.stop=\"emit('archive', s.id, true)\"><Archive :size=\"13\" /></button>\n              <button\n                class=\"va-stree__op\"\n                type=\"button\"\n                :data-danger=\"confirmId === s.id || undefined\"\n                :aria-label=\"confirmId === s.id ? '确认删除' : '删除'\"\n                :disabled=\"props.disabled\"\n                @click.stop=\"askRemove(s.id)\"\n              ><span v-if=\"confirmId === s.id\" class=\"va-stree__confirm\">确认?</span><Trash2 v-else :size=\"13\" /></button>\n            </template>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <div v-if=\"props.archived.length && !searching\" class=\"va-stree__archived\">\n      <button class=\"va-stree__archived-toggle\" type=\"button\" @click=\"archivedOpen = !archivedOpen\">\n        已归档（{{ props.archived.length }}）\n        <ChevronDown v-if=\"archivedOpen\" :size=\"14\" aria-hidden=\"true\" />\n        <ChevronRight v-else :size=\"14\" aria-hidden=\"true\" />\n      </button>\n      <Transition name=\"va-stree-fold\">\n        <div v-if=\"archivedOpen\" class=\"va-stree__list\">\n          <div class=\"va-stree__list-clip\">\n        <div v-for=\"s in props.archived\" :key=\"s.id\" class=\"va-stree__session\" data-archived=\"true\">\n          <span class=\"va-stree__session-main va-stree__session-main--static\">\n            <span class=\"va-stree__session-title\">{{ titleOf(s) }}</span>\n            <span class=\"va-stree__time\">{{ fmtTime(s.updatedAt) }}</span>\n          </span>\n          <button class=\"va-stree__op\" type=\"button\" aria-label=\"恢复\" :disabled=\"props.disabled\" @click.stop=\"emit('archive', s.id, false)\"><ArchiveRestore :size=\"13\" /></button>\n          <button\n            class=\"va-stree__op\"\n            type=\"button\"\n            :data-danger=\"confirmId === s.id || undefined\"\n            :aria-label=\"confirmId === s.id ? '确认删除' : '删除'\"\n            :disabled=\"props.disabled\"\n            @click.stop=\"askRemove(s.id)\"\n          ><span v-if=\"confirmId === s.id\" class=\"va-stree__confirm\">确认?</span><Trash2 v-else :size=\"13\" /></button>\n        </div>\n          </div>\n        </div>\n      </Transition>\n    </div>\n\n    <!-- 树底部操作区（宿主注入，如设置入口）；flex:1 吃掉剩余高度使 footer 恒沉底 -->\n    <footer v-if=\"$slots.footer\" class=\"va-stree__footer\">\n      <slot name=\"footer\" />\n    </footer>\n  </div>\n</template>\n\n<style>\n/* VaSessionTree — 工作区为分组标题、会话平铺一列（无树形缩进、无折叠） */\n.va-stree {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  font-family: var(--va-font, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Helvetica Neue\", sans-serif);\n  font-size: var(--va-fs-md, 13px);\n}\n\n.va-stree__new {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 4px;\n  border: 1px dashed var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-s, 8px);\n  background: transparent;\n  color: var(--va-ink-2, #43413c);\n  font: inherit;\n  font-size: var(--va-fs-md, 13px);\n  padding: 9px var(--va-s4h, 10px);\n  cursor: pointer;\n  margin-bottom: 8px;\n}\n.va-stree__new:hover:not(:disabled) { border-color: var(--va-accent, #c2410c); color: var(--va-accent, #c2410c); }\n.va-stree__new:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: -2px; }\n.va-stree__new:disabled { opacity: 0.5; cursor: default; }\n\n.va-stree__ws-create {\n  display: flex;\n  align-items: center;\n  gap: 2px;\n  margin-bottom: 8px;\n}\n\n/* 常驻新建会话（主按钮，G7） */\n.va-stree__new-session {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 5px;\n  border: 0;\n  border-radius: var(--va-radius-s, 8px);\n  background: var(--va-accent, #c2410c);\n  color: var(--va-card, #ffffff);\n  font: inherit;\n  font-size: var(--va-fs-md, 13px);\n  font-weight: var(--va-fw-semibold, 600);\n  padding: 9px var(--va-s4h, 10px);\n  cursor: pointer;\n  margin-bottom: var(--va-s3h, 6px);\n}\n.va-stree__new-session:hover:not(:disabled) { background: var(--va-accent-hover, #9a3412); }\n.va-stree__new-session:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: 2px; }\n.va-stree__new-session:disabled { opacity: 0.45; cursor: default; }\n\n/* 会话搜索框（G9） */\n.va-stree__search {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3h, 6px);\n  background: var(--va-card, #ffffff);\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-s, 8px);\n  padding: 5px 8px;\n  margin-bottom: 4px;\n  color: var(--va-muted, #6f6d66);\n}\n.va-stree__search input {\n  flex: 1;\n  min-width: 0;\n  border: 0;\n  background: none;\n  font: inherit;\n  font-size: var(--va-fs-md, 13px);\n  color: var(--va-ink, #1a1917);\n  outline: none;\n}\n\n/* 会话行状态点（G8）与置顶标记（G10） */\n.va-stree__dot { flex: none; width: 7px; height: 7px; border-radius: 50%; }\n.va-stree__dot--run { background: var(--va-warning, #b45309); animation: va-stree-pulse calc(var(--va-dur-loop, 1.8s) * 2 / 3) infinite; /* 1.2s = 底速 × 2/3 */ }\n.va-stree__dot--warn { background: var(--va-danger, #d5453c); }\n@keyframes va-stree-pulse { 50% { opacity: 0.3; } }\n@media (prefers-reduced-motion: reduce) { .va-stree__dot--run { animation: none; } }\n\n.va-stree__pin { flex: none; color: var(--va-accent, #c2410c); }\n\n.va-stree__warn-tag {\n  flex: none;\n  font-size: var(--va-fs-2xs, 10px);\n  font-weight: var(--va-fw-bold, 700);\n  color: var(--va-danger, #d5453c);\n  border: 1px solid var(--va-danger, #d5453c);\n  border-radius: var(--va-radius-pill, 999px);\n  padding: 0 5px;\n  line-height: 15px;\n}\n\n.va-stree__search-empty { padding: var(--va-s4h, 10px) 8px; text-align: center; }\n\n/* 工作区分组：平铺分组标题（非卡片）—— 标题行 + 会话行直接排在侧栏底色上，\n   当前工作区仅以文字强调（图标/名称/计数变 accent 色），不画容器 */\n.va-stree__group {\n  margin-top: var(--va-s4h, 10px);\n}\n.va-stree__group:first-child { margin-top: 2px; }\n\n.va-stree__head {\n  display: flex;\n  align-items: center;\n  gap: 2px;\n  padding: 2px 2px 1px;\n}\n\n.va-stree__ws {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3h, 6px);\n  padding: 5px var(--va-s3h, 6px);\n  text-align: left;\n}\n.va-stree__ws-icon { flex: none; display: inline-flex; color: var(--va-muted, #6f6d66); }\n.va-stree__group[data-current=\"true\"] .va-stree__ws-icon { color: var(--va-accent, #c2410c); }\n\n.va-stree__ws-name {\n  font-size: var(--va-fs-lg, 14px);\n  font-weight: var(--va-fw-bold, 700);\n  color: var(--va-ink, #1a1917);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.va-stree__group[data-current=\"true\"] .va-stree__ws-name { color: var(--va-accent, #c2410c); }\n\n.va-stree__count {\n  flex: none;\n  min-width: 18px;\n  height: 18px;\n  border-radius: var(--va-radius-pill, 999px);\n  padding: 0 5px;\n  font-size: var(--va-fs-xs, 11px);\n  font-weight: var(--va-fw-semibold, 600);\n  line-height: 18px;\n  text-align: center;\n  background: var(--va-bg-subtle, #efede7);\n  color: var(--va-muted, #6f6d66);\n}\n.va-stree__group[data-current=\"true\"] .va-stree__count {\n  background: var(--va-accent-soft, rgba(194, 65, 12, 0.1));\n  color: var(--va-accent, #c2410c);\n}\n\n.va-stree__tag {\n  flex: none;\n  font-size: var(--va-fs-xs, 11px);\n  font-weight: var(--va-fw-semibold, 600);\n  border-radius: var(--va-radius-pill, 999px);\n  padding: 0 7px;\n  line-height: 18px;\n  background: var(--va-accent-soft, rgba(194, 65, 12, 0.1));\n  color: var(--va-accent, #c2410c);\n}\n\n/* 会话平铺列表（与标题同层级，无缩进线）\n   折叠动画容器：grid-rows 0fr↔1fr 高度过渡，内层 clip 负责裁剪（min-height:0） */\n.va-stree__list {\n  display: grid;\n  grid-template-rows: 1fr;\n  min-width: 0;\n}\n\n.va-stree__list-clip {\n  min-height: 0;\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n  gap: 1px;\n}\n\n/* 工作区分组/归档分区折叠：入场 ease-out-quart、离场 ease-in-quad（离场更快更短） */\n.va-stree-fold-enter-active {\n  transition:\n    grid-template-rows var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)),\n    opacity var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-stree-fold-leave-active {\n  transition:\n    grid-template-rows var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)),\n    opacity var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2));\n}\n\n.va-stree-fold-enter-from,\n.va-stree-fold-leave-to {\n  grid-template-rows: 0fr;\n  opacity: 0;\n}\n\n/* 新建工作区内联表单：自上方轻滑入淡入 */\n.va-stree-pop-enter-active {\n  transition:\n    opacity var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-stree-pop-leave-active {\n  transition:\n    opacity var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)),\n    transform var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2));\n}\n\n.va-stree-pop-enter-from,\n.va-stree-pop-leave-to {\n  opacity: 0;\n  transform: translateY(calc(var(--va-dist-m, 8px) * -1));\n}\n\n@media (prefers-reduced-motion: reduce) {\n  /* 功能动画降级为纯 opacity（高度立即到位，保留状态可感知） */\n  .va-stree-fold-enter-active,\n  .va-stree-fold-leave-active,\n  .va-stree-pop-enter-active,\n  .va-stree-pop-leave-active {\n    transition: opacity var(--va-dur-1, 120ms) linear;\n    transform: none;\n  }\n\n  .va-stree-fold-enter-from,\n  .va-stree-fold-leave-to {\n    grid-template-rows: 1fr;\n    transform: none;\n  }\n\n  .va-stree-pop-enter-from,\n  .va-stree-pop-leave-to {\n    transform: none;\n  }\n}\n\n/* 分组内的会话列表缩进一级，建立「工作区 ⊃ 会话」层次；\n   归档分区（.va-stree__archived 下的 list）不缩进 */\n.va-stree__group .va-stree__list,\n.va-stree__group .va-stree__empty {\n  padding-left: 16px;\n}\n\n.va-stree__session {\n  display: flex;\n  align-items: center;\n  gap: 1px;\n  border-radius: var(--va-radius-s, 8px);\n  min-width: 0;\n  max-width: 100%;\n  box-sizing: border-box;\n}\n.va-stree__session:hover { background: var(--va-bg-subtle, #efede7); }\n.va-stree__session[data-active=\"true\"] { background: var(--va-accent-soft, rgba(194, 65, 12, 0.1)); }\n.va-stree__session[data-archived=\"true\"] { opacity: 0.6; }\n\n.va-stree__session-main {\n  flex: 1 1 0;\n  min-width: 0;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--va-s3h, 6px);\n  border: 0;\n  background: none;\n  font: inherit;\n  text-align: left;\n  padding: 7px 8px;\n  cursor: pointer;\n  border-radius: var(--va-radius-s, 8px);\n  overflow: hidden;\n}\n.va-stree__session-main--static { cursor: default; }\n.va-stree__session-main:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: -2px; }\n\n.va-stree__session-title {\n  flex: 1 1 0;\n  min-width: 0; /* flex 子项省略号生效前提；同时让 space-between 布局下标题紧随指示器左对齐，而非被均分到行中 */\n  font-size: var(--va-fs-md, 13px);\n  color: var(--va-ink-2, #43413c);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.va-stree__session[data-active=\"true\"] .va-stree__session-title {\n  font-weight: var(--va-fw-semibold, 600);\n  color: var(--va-accent, #c2410c);\n}\n\n.va-stree__time {\n  flex: none;\n  font-size: var(--va-fs-xs, 11px);\n  color: var(--va-muted, #6f6d66);\n  white-space: nowrap;\n}\n\n.va-stree__op {\n  flex: none;\n  flex-shrink: 0;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border: 0;\n  background: none;\n  font-size: var(--va-fs-sm, 12px);\n  padding: 4px var(--va-s3h, 6px);\n  border-radius: var(--va-radius-s, 8px);\n  cursor: pointer;\n  color: var(--va-muted, #6f6d66);\n  opacity: 0;\n  transition: opacity var(--va-dur-1, 120ms) ease;\n}\n.va-stree__head:hover .va-stree__op,\n.va-stree__session:hover .va-stree__op { opacity: 1; }\n.va-stree__op:hover:not(:disabled) { background: var(--va-bg-subtle, #efede7); color: var(--va-ink, #1a1917); opacity: 1; }\n.va-stree__op:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: -2px; opacity: 1; }\n.va-stree__op:disabled { cursor: default; }\n.va-stree__op[data-danger=\"true\"] { color: var(--va-danger, #d5453c); font-weight: var(--va-fw-bold, 700); opacity: 1; }\n.va-stree__confirm { white-space: nowrap; }\n\n.va-stree__input {\n  flex: 1;\n  min-width: 0;\n  border: 1px solid var(--va-accent, #c2410c);\n  border-radius: var(--va-radius-s, 8px);\n  background: var(--va-card, #ffffff);\n  color: var(--va-ink, #1a1917);\n  font: inherit;\n  font-size: var(--va-fs-md, 13px);\n  padding: 5px 8px;\n  margin: 2px 0;\n}\n.va-stree__input:focus-visible { outline: none; }\n\n.va-stree__empty { margin: 0; padding: 4px 8px; font-size: var(--va-fs-sm, 12px); color: var(--va-muted, #6f6d66); line-height: 1.5; }\n\n/* 已归档分区 */\n.va-stree__archived { margin-top: 12px; border-top: 1px dashed var(--va-edge, rgba(26, 25, 23, 0.12)); padding-top: var(--va-s3h, 6px); }\n.va-stree__archived-toggle {\n  display: flex;\n  align-items: center;\n  gap: 5px;\n  width: 100%;\n  border: 0;\n  background: none;\n  font: inherit;\n  font-size: var(--va-fs-md, 13px);\n  color: var(--va-muted, #6f6d66);\n  padding: var(--va-s3h, 6px) 8px;\n  cursor: pointer;\n  border-radius: var(--va-radius-s, 8px);\n  text-align: left;\n}\n.va-stree__archived-toggle:hover { background: var(--va-bg-subtle, #efede7); }\n.va-stree__archived-toggle svg { width: 13px; height: 13px; }\n\n/* 触屏/键盘可达：无 hover 时操作常显 */\n@media (hover: none) {\n  .va-stree__op { opacity: 1; }\n}\n\n/* collapsible:工作区分组折叠 chevron */\n.va-stree__toggle {\n  flex: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border: 0;\n  background: none;\n  padding: 3px;\n  border-radius: var(--va-radius-s, 8px);\n  cursor: pointer;\n  color: var(--va-muted, #6f6d66);\n}\n.va-stree__toggle:hover { background: var(--va-bg-subtle, #efede7); color: var(--va-ink, #1a1917); }\n.va-stree__toggle:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: -2px; }\n\n/* hoverOps:行操作完全移除占位,hover/focus 或确认态时才显示 */\n.va-stree[data-hover-ops=\"true\"] .va-stree__op { display: none; }\n.va-stree[data-hover-ops=\"true\"] .va-stree__head:hover .va-stree__op,\n.va-stree[data-hover-ops=\"true\"] .va-stree__head:focus-within .va-stree__op,\n.va-stree[data-hover-ops=\"true\"] .va-stree__session:hover .va-stree__op,\n.va-stree[data-hover-ops=\"true\"] .va-stree__session:focus-within .va-stree__op,\n.va-stree[data-hover-ops=\"true\"] .va-stree__op[data-danger] { display: inline-flex; }\n\n/* 当 hover-ops 下鼠标悬浮或聚焦会话行时，时间让位给操作按钮组，避免横向挤出视区或操作按钮被遮挡 */\n.va-stree[data-hover-ops=\"true\"] .va-stree__session:hover .va-stree__time,\n.va-stree[data-hover-ops=\"true\"] .va-stree__session:focus-within .va-stree__time {\n  display: none;\n}\n\n\n\n/* 树底部操作区（footer 插槽，如设置入口）：margin-top:auto 沉底；\n   宿主把 .va-stree 设为滚动容器时 sticky 保证长列表下 footer 恒可见 */\n.va-stree__footer {\n  margin-top: auto;\n  position: sticky;\n  bottom: 0;\n  z-index: 1;\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3h, 6px);\n  padding: 8px var(--va-s4h, 10px);\n  border-top: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  background: var(--va-card, #ffffff);\n}\n\n/* 动效工具类（自动附带，源码中来自全局 motion.css） */\n/* ============================================================\n   共享动效工具类 —— 进出场/交叉淡入的统一协议（TASK-102 动效基建）。\n   组件不逐个发明入场曲线：统一消费 --va-dur-in/--va-dur-out 骨架时长与\n   --va-dist-* 位移档；每条声明自带字面 fallback（registry 单文件拷贝分发\n   要求，与 tokens.css 门禁一致）。\n\n   接入方式二选一：\n   1. Vue <Transition>：\n      <Transition enter-active-class=\"va-enter-up\" leave-active-class=\"va-exit-up\">\n      动画 fill-mode 为 both（延迟期间保持首帧、播完停在终态），\n      无需再配 enter-from-class / leave-to-class；\n   2. 类切换重挂载：骨架 → 内容换节点时给新节点挂 .va-crossfade（纯淡入），\n      离场节点挂 .va-exit-*（更短更快）。\n\n   列表错峰：v-for 子项 :style=\"useStagger().delayStyle(i)\" 配合 .va-enter-*\n   动画类使用（animation-delay 由 composable 编排——.va-enter-* 为 CSS animation，\n   transition-delay 对其零作用，见 composables/useStagger.ts）。\n   ============================================================ */\n\n/* 入场：上浮（自下方 --va-dist-m 浮起） */\n@keyframes va-motion-in-up {\n  from { opacity: 0; transform: translateY(var(--va-dist-m, 8px)); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* 入场：左滑（自左侧 --va-dist-m 滑入） */\n@keyframes va-motion-in-left {\n  from { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n  to { opacity: 1; transform: translateX(0); }\n}\n\n/* 入场：缩放（96% 起放大至原尺寸） */\n@keyframes va-motion-in-scale {\n  from { opacity: 0; transform: scale(0.96); }\n  to { opacity: 1; transform: scale(1); }\n}\n\n/* 离场：与入场互逆（向上/向左飘出、缩回）；时长/曲线由工具类映射 --va-dur-out 骨架 */\n@keyframes va-motion-out-up {\n  from { opacity: 1; transform: translateY(0); }\n  to { opacity: 0; transform: translateY(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-left {\n  from { opacity: 1; transform: translateX(0); }\n  to { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-scale {\n  from { opacity: 1; transform: scale(1); }\n  to { opacity: 0; transform: scale(0.96); }\n}\n\n/* 交叉淡入/淡出（.va-crossfade 骨架→内容交换专用，无位移，避免占位跳变叠加） */\n@keyframes va-motion-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes va-motion-fade-out {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n/* ---- 工具类：入场走 --va-dur-in + ease-out-quart，离场走 --va-dur-out + ease-in-quad ---- */\n\n.va-enter-up {\n  animation: va-motion-in-up var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-left {\n  animation: va-motion-in-left var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-scale {\n  animation: va-motion-in-scale var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-exit-up {\n  animation: va-motion-out-up var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-left {\n  animation: va-motion-out-left var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-scale {\n  animation: va-motion-out-scale var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n/* 骨架 → 内容交叉过渡：新内容纯淡入 */\n.va-crossfade {\n  animation: va-motion-fade-in var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* 空态/轻量状态渐入（TASK-106 弱化档）：仅 opacity、时长走 --va-dur-2，\n   供列表空态提示与一次性状态块使用（空态清单见 TASK-106 报告）。\n   纯 opacity 即动效分频策略的降级终点形态，reduced-motion 下保持原样即可。 */\n.va-fade-in {\n  animation: va-motion-fade-in var(--va-dur-2, 200ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* ---- 静态光斑基类（TASK-105，决策 5「追光」路线基建）----\n   pointer 坐标由 composables/useSpotlight.ts 以 rAF 节流写入 --va-spot-x/y\n   （元素内百分比，光斑数学在 composable 内可单测）；本类只负责 radial 光斑\n   绘制与显隐（:hover 点亮，无 3D 倾斜， glare 数学对齐 VaTiltCard）。\n   --va-spot-* 为 L3 组件钩子口径（宿主可覆盖尺寸/颜色），不进 tokens.css。\n   双降级对齐 VaTiltCard glare：hover: none（触屏）与 reduced-motion 不绘制。 */\n.va-spotlight { position: relative; }\n\n/* ::after 承载光斑（避开组件自身 ::before 用途）；inset 0 + border-radius inherit\n   使光斑天然裁剪在宿主圆角内，无需 overflow: hidden。\n   注意：此 ::after radial 与 components/spotlight-card/VaSpotlightCard.css 的\n   .va-spot-card--spot::after 为 registry 单文件自含有意复制，改动需两处同步。 */\n.va-spotlight::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n  background: radial-gradient(\n    var(--va-spot-size, 240px) circle at var(--va-spot-x, 50%) var(--va-spot-y, 50%),\n    var(--va-spot-color, rgba(255, 255, 255, 0.14)),\n    transparent 65%\n  );\n}\n\n.va-spotlight:hover::after { opacity: 1; }\n\n@media (hover: none) {\n  .va-spotlight::after { display: none; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-spotlight::after { display: none; }\n}\n\n/* ---- 复制反馈标准（TASK-106）：copy→check 交叉过渡 ----\n   容器 .va-copy 为 inline-grid 双内容同格堆叠（格子宽取较宽子项，切换零跳动）：\n   __idle = copy 态内容（图标/文字），__done = check 态内容。\n   copied 置真挂 .va-copy--done：check 以 ease-spring 微弹入场（进入 done 态时\n   transform 的目标态时序换成 --va-ease-spring → 过冲回弹），交叉时长统一 --va-dur-1。\n   消费方：terminal-log（行复制）、code-diff（复制按钮）、message-actions（复制图标）。 */\n.va-copy { display: inline-grid; place-items: center; }\n\n.va-copy__idle,\n.va-copy__done {\n  grid-area: 1 / 1;\n  transition: opacity var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-copy__idle { opacity: 1; transform: scale(1); }\n.va-copy__done { opacity: 0; transform: scale(0.6); }\n\n.va-copy--done .va-copy__done {\n  opacity: 1;\n  transform: scale(1);\n  /* 时序按 transition 属性顺序映射：opacity 仍 ease，transform 换 ease-spring 微弹 */\n  transition-timing-function: var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), var(--va-ease-spring, cubic-bezier(0.34, 1.56, 0.64, 1));\n}\n\n.va-copy--done .va-copy__idle { opacity: 0; transform: scale(0.6); }\n\n@media (prefers-reduced-motion: reduce) {\n  /* 交叉过渡瞬时完成（无位移动画），copied 状态可感知性不受影响 */\n  .va-copy__idle,\n  .va-copy__done { transition: none; }\n}\n\n/* ---- 错误反馈标准（校验失败横向微振）：目标元素挂 .va-shake 播一次 ±3px 微振 ----\n   时长 --va-dur-2 × 2（两拍四峰，克制的「摇头」量级，rubric 校验失败口径）；\n   重复触发需先移除类、强制 reflow 再挂回（封装见 composables/useShake.ts）。\n   reduced-motion 降级为不播：错误状态的可感知性由错误样式本身（描边/文案）承担，\n   动效只做注意力引导——符合头注释「功能动画降级保留状态可感知」的分频策略。\n   消费方：VaStepperForm / VaOtpInput 经 useShake() 程序化触发（defineExpose shake()）；\n   宿主自绘表单可直接挂类。 */\n@keyframes va-motion-shake {\n  20% { transform: translateX(-3px); }\n  40% { transform: translateX(3px); }\n  60% { transform: translateX(-2px); }\n  80% { transform: translateX(2px); }\n}\n\n.va-shake {\n  animation: va-motion-shake calc(var(--va-dur-2, 200ms) * 2) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-shake { animation: none; }\n}\n\n/* ---- 动效分频（对齐 tokens.css 头注释策略）：\n   功能动画降级为纯 opacity——进/出场整体换成 fade keyframes，\n   位移/缩放不再出现（animation-name 顶替，时长/缓动沿用上面的声明）。 */\n@media (prefers-reduced-motion: reduce) {\n  .va-enter-up,\n  .va-enter-left,\n  .va-enter-scale,\n  .va-crossfade {\n    animation-name: va-motion-fade-in;\n  }\n\n  .va-exit-up,\n  .va-exit-left,\n  .va-exit-scale {\n    animation-name: va-motion-fade-out;\n  }\n}\n</style>\n"
    },
