      "target": "components/ui/session-tree/index.ts",
      "content": "export { default as VaSessionTree } from \"./VaSessionTree.vue\";\nexport type { SessionTreeEvents, SessionTreeProps, TreeSession, TreeWorkspace } from \"./types\";\n"
    },
    {
      "path": "components/ui/session-tree/types.ts",
      "type": "registry:ui",
      "target": "components/ui/session-tree/types.ts",
      "content": "/** VaSessionTree 的类型定义（结构与协议 SessionMeta / WorkspaceInfo 保持一致） */\n\nexport interface TreeWorkspace {\n  id: string;\n  name: string;\n  description?: string;\n}\n\nexport interface TreeSession {\n  id: string;\n  /** 空串 = 未命名 */\n  title: string;\n  createdAt: number;\n  updatedAt: number;\n  archived: boolean;\n  /** 所属工作区（分组依据） */\n  workspaceId?: string;\n  /** agent 运行中（琥珀脉冲点） */\n  running?: boolean;\n  /** 有待审批（红点 + 徽标） */\n  waitingApproval?: boolean;\n  /** 已置顶（图钉标记；排序由宿主负责） */\n  pinned?: boolean;\n}\n\nexport interface SessionTreeProps {\n  /** 全部工作区（平铺分组标题，按数组顺序展示） */\n  workspaces: TreeWorkspace[];\n  /** 全部非归档会话（按 workspaceId 归入对应分组） */\n  sessions: TreeSession[];\n  /** 已归档会话（收进底部「已归档」分区） */\n  archived: TreeSession[];\n  /** 当前会话所属工作区 id（仅用于分组高亮，不涉及切换） */\n  currentWorkspaceId: string;\n  /** 当前活跃会话 id */\n  currentSessionId: string;\n  disabled?: boolean;\n  /** 新建工作区模式：input=行内输入框（默认）；picker=「＋」直接触发 createWorkspacePick（宿主弹原生目录选择框） */\n  workspaceCreateMode?: \"input\" | \"picker\";\n  /** 顶部常驻「＋ 新建会话」按钮（目标 = 当前工作区；无工作区时禁用） */\n  newSession?: boolean;\n  /** 显示会话搜索框（组件内按标题过滤） */\n  searchable?: boolean;\n  /** 工作区分组可折叠（chevron 切换，默认全部展开；默认 false 平铺） */\n  collapsible?: boolean;\n  /** 行操作按钮 hover/focus 时才显示（确认态除外）；默认 false 常驻 */\n  hoverOps?: boolean;\n  /**\n   * 删除确认模式（会话/工作区删除）：\n   * - \"inline\"（默认）：行内二次确认（3s 内再次点击，「确认?」文案）\n   * - \"none\"：直接发 remove / removeWorkspace 事件，由宿主路由到 vaConfirm 等模态确认\n   */\n  confirmMode?: \"inline\" | \"none\";\n}\n\nexport interface SessionTreeEvents {\n  /** 新建工作区（input 模式：携带输入的名称，Enter 提交） */\n  createWorkspace: [name: string];\n  /** picker 模式：点击「＋ 新建工作区」立即触发（宿主弹原生选择框，无输入框） */\n  createWorkspacePick: [];\n  /** 点击会话行 → 切换会话 */\n  selectSession: [id: string];\n  /** 新建会话（在指定工作区下） */\n  createSession: [workspaceId: string];\n  /** 删除工作区（行内二次确认；其下会话回到未分组） */\n  removeWorkspace: [id: string];\n  /** 置顶/取消置顶会话（排序由宿主负责） */\n  togglePin: [id: string];\n  rename: [id: string, title: string];\n  /** 归档（true）/ 恢复（false） */\n  archive: [id: string, archived: boolean];\n  /** 删除（行内二次确认） */\n  remove: [id: string];\n}\n"
    }
