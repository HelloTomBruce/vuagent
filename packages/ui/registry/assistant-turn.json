{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "assistant-turn",
  "title": "Assistant Turn",
  "description": "助手消息轮次复合组件：整合思考链（ThoughtBox）、Markdown 正文排版、工具卡片时序穿插插槽、操作栏及流式中止状态。",
  "type": "registry:ui",
  "dependencies": [
    "lucide-vue-next"
  ],
  "registryDependencies": [
    "@vuagent/markdown",
    "@vuagent/thought-box",
    "@vuagent/message-actions"
  ],
  "docs": "- `content` (string，默认 \"\")：正文回答\n- `thought` (string，默认 \"\")：思考链过程\n- `streaming` (boolean，默认 false)：流式生成中\n- `blocks` (TurnBlockItem[]，默认 [])：时序交错分块（文本/卡片）\n- `cards` (ActionCardItem[]，默认 [])：卡片数据列表\n- `aborted` (boolean，默认 false)：任务是否中止",
  "files": [
    {
      "path": "components/ui/assistant-turn/VaAssistantTurn.vue",
      "type": "registry:ui",
      "target": "components/ui/assistant-turn/VaAssistantTurn.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from \"vue\";\nimport { Bot } from \"lucide-vue-next\";\nimport { VaMarkdown } from \"../markdown\";\nimport { VaThoughtBox } from \"../thought-box\";\nimport { VaMessageActions } from \"../message-actions\";\nimport type { ActionCardItem, AssistantTurnEvents, AssistantTurnProps, TurnBlockItem } from \"./types\";\n\nconst props = withDefaults(defineProps<AssistantTurnProps>(), {\n  content: \"\",\n  thought: \"\",\n  thoughtExpanded: true,\n  thoughtDuration: undefined,\n  processCollapsed: false,\n  canCollapseProcess: false,\n  toolCount: 0,\n  streaming: false,\n  avatar: \"bot\",\n  aborted: false,\n  abortReason: \"\",\n  blocks: () => [],\n  cards: () => [],\n  actionsEnabled: true,\n});\n\nconst emit = defineEmits<AssistantTurnEvents>();\n\nconst cardMap = computed<Record<string, ActionCardItem>>(() => {\n  const map: Record<string, ActionCardItem> = {};\n  for (const c of props.cards || []) {\n    map[c.id] = c;\n  }\n  return map;\n});\n\nconst displayBlocks = computed<TurnBlockItem[]>(() => {\n  if (props.blocks && props.blocks.length > 0) {\n    return props.blocks;\n  }\n  const blocks: TurnBlockItem[] = [];\n  if (props.content) {\n    blocks.push({ kind: \"text\", content: props.content });\n  }\n  for (const c of props.cards || []) {\n    blocks.push({ kind: \"card\", cardId: c.id });\n  }\n  return blocks;\n});\n\nconst hasThought = computed(() => Boolean(props.thought) || (props.streaming && !props.content));\n</script>\n\n<template>\n  <!-- .va-enter-up（motion.css，180ms 上浮+fade）：组件挂载即一次性入场，\n       reduced-motion 由 motion.css 媒体块降级为纯 fade；\n       流式点脉冲在本入场结束后才起（见 VaAssistantTurn.css 的 animation-delay） -->\n  <div class=\"va-assistant-turn-row va-enter-up\">\n    <div class=\"va-assistant-turn\">\n      <!-- 1. 头像 -->\n      <slot name=\"avatar\">\n        <div class=\"va-assistant-turn__avatar\">\n          <img v-if=\"props.avatar && props.avatar.startsWith('http')\" :src=\"props.avatar\" alt=\"Agent\" />\n          <Bot v-else-if=\"props.avatar === 'bot'\" :size=\"18\" />\n          <span v-else>{{ props.avatar || \"A\" }}</span>\n        </div>\n      </slot>\n\n      <div class=\"va-assistant-turn__body\">\n        <!-- 2. 思考过程 / 过程摘要折叠盒 -->\n        <slot\n          name=\"thought\"\n          :thought=\"props.thought\"\n          :expanded=\"props.thoughtExpanded\"\n          :summary-mode=\"props.processCollapsed\"\n        >\n          <VaThoughtBox\n            v-if=\"hasThought\"\n            :thought=\"props.thought\"\n            :expanded=\"props.thoughtExpanded\"\n            :duration=\"props.thoughtDuration\"\n            :streaming=\"props.streaming && !props.content\"\n            :summary-mode=\"props.processCollapsed\"\n            :tool-count=\"props.toolCount\"\n            @update:expanded=\"(val) => emit('update:thoughtExpanded', val)\"\n            @update:summary-mode=\"(val) => emit('update:processCollapsed', val)\"\n          />\n        </slot>\n\n        <!-- 3. 时序交错正文与动作卡片 -->\n        <template v-for=\"(block, idx) in displayBlocks\" :key=\"`${block.kind}-${idx}`\">\n          <!-- 文本 Markdown 渲染 -->\n          <div v-if=\"block.kind === 'text' && block.content\" class=\"va-assistant-turn__text\">\n            <VaMarkdown\n              :content=\"block.content\"\n              :streaming=\"props.streaming && idx === displayBlocks.length - 1\"\n            />\n          </div>\n\n          <!-- 卡片插槽（如工具调用卡片、审批卡片） -->\n          <div\n            v-else-if=\"!props.processCollapsed && block.kind === 'card' && block.cardId\"\n            class=\"va-assistant-turn__card-container\"\n          >\n            <slot\n              name=\"card\"\n              :card-id=\"block.cardId\"\n              :card=\"cardMap[block.cardId]\"\n              :streaming=\"props.streaming\"\n            />\n          </div>\n        </template>\n\n        <!-- 额外卡片/自定义业务组件扩展插槽 -->\n        <slot />\n        <slot name=\"extra\" />\n\n        <!-- 4. 底部消息操作条（输出完成且有正文时可用） -->\n        <div v-if=\"props.actionsEnabled && !props.streaming && props.content\" class=\"va-assistant-turn__actions\">\n          <slot name=\"actions\" :content=\"props.content\">\n            <VaMessageActions\n              :text=\"props.content\"\n              quiet\n              @regenerate=\"emit('regenerate')\"\n              @copy=\"(t) => emit('copy', t || props.content || '')\"\n              @feedback=\"(k, r) => emit('feedback', k, r)\"\n            />\n          </slot>\n        </div>\n\n        <!-- 5. 流式输出指示器 -->\n        <div v-if=\"props.streaming\" class=\"va-assistant-turn__streaming\">\n          <span class=\"va-assistant-turn__cursor-dot\" />\n          <span><slot name=\"streaming-label\">Agent 正在分析中…</slot></span>\n        </div>\n\n        <!-- 6. 任务中止徽标 -->\n        <div v-if=\"props.aborted\" class=\"va-assistant-turn__aborted\" :title=\"props.abortReason\">\n          <slot name=\"aborted-label\" :reason=\"props.abortReason\">\n            ⏹ 任务已中止<template v-if=\"props.abortReason\">（{{ props.abortReason }}）</template>\n          </slot>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<style>\n.va-assistant-turn-row {\n  display: flex;\n  justify-content: flex-start;\n  margin-bottom: 20px;\n  width: 100%;\n}\n\n.va-assistant-turn {\n  display: flex;\n  align-items: flex-start;\n  gap: 12px;\n  max-width: 92%;\n  width: 100%;\n}\n\n.va-assistant-turn__avatar {\n  width: 32px;\n  height: 32px;\n  border-radius: 50%;\n  background: var(--va-accent-soft, rgba(194, 65, 12, 0.1));\n  color: var(--va-accent, #c2410c);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  overflow: hidden;\n  border: 1px solid var(--va-accent-subtle, rgba(194, 65, 12, 0.2));\n}\n\n.va-assistant-turn__avatar img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.va-assistant-turn__body {\n  flex: 1;\n  min-width: 0;\n}\n\n/* 时序卡片容器 */\n.va-assistant-turn__card-container {\n  margin: 10px 0;\n}\n\n/* 消息操作栏 */\n.va-assistant-turn__actions {\n  margin-top: 8px;\n}\n\n/* 流式指示器 */\n.va-assistant-turn__streaming {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 12px;\n  color: var(--va-ink-muted, #78716c);\n  margin-top: 8px;\n}\n\n.va-assistant-turn__cursor-dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: var(--va-accent, #c2410c);\n  /* 脉冲延迟 = 入场时长（--va-dur-in）：行节点 .va-enter-up 与本点同帧挂载时\n     先完成 180ms 上浮入场、再起无限脉冲，避免两个动画同帧并发闪烁 */\n  animation: va-dot-pulse calc(var(--va-dur-loop, 1.8s) * 2 / 3) ease-in-out var(--va-dur-in, 180ms) infinite; /* 1.2s = 底速 × 2/3 */\n}\n\n@keyframes va-dot-pulse {\n  0%, 100% { transform: scale(0.8); opacity: 0.5; }\n  50% { transform: scale(1.4); opacity: 1; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-assistant-turn__cursor-dot { animation: none; opacity: 0.8; }\n}\n\n/* 中止状态 */\n.va-assistant-turn__aborted {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  margin-top: 8px;\n  padding: 3px 8px;\n  font-size: 11.5px;\n  border-radius: var(--va-radius-s, 8px);\n  background: var(--va-warn-soft, rgba(234, 88, 12, 0.1));\n  color: var(--va-warn, #c2410c);\n  border: 1px solid var(--va-warn-subtle, rgba(234, 88, 12, 0.2));\n}\n\n/* 动效工具类（自动附带，源码中来自全局 motion.css） */\n/* ============================================================\n   共享动效工具类 —— 进出场/交叉淡入的统一协议（TASK-102 动效基建）。\n   组件不逐个发明入场曲线：统一消费 --va-dur-in/--va-dur-out 骨架时长与\n   --va-dist-* 位移档；每条声明自带字面 fallback（registry 单文件拷贝分发\n   要求，与 tokens.css 门禁一致）。\n\n   接入方式二选一：\n   1. Vue <Transition>：\n      <Transition enter-active-class=\"va-enter-up\" leave-active-class=\"va-exit-up\">\n      动画 fill-mode 为 both（延迟期间保持首帧、播完停在终态），\n      无需再配 enter-from-class / leave-to-class；\n   2. 类切换重挂载：骨架 → 内容换节点时给新节点挂 .va-crossfade（纯淡入），\n      离场节点挂 .va-exit-*（更短更快）。\n\n   列表错峰：v-for 子项 :style=\"useStagger().delayStyle(i)\" 配合 .va-enter-*\n   动画类使用（animation-delay 由 composable 编排——.va-enter-* 为 CSS animation，\n   transition-delay 对其零作用，见 composables/useStagger.ts）。\n   ============================================================ */\n\n/* 入场：上浮（自下方 --va-dist-m 浮起） */\n@keyframes va-motion-in-up {\n  from { opacity: 0; transform: translateY(var(--va-dist-m, 8px)); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* 入场：左滑（自左侧 --va-dist-m 滑入） */\n@keyframes va-motion-in-left {\n  from { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n  to { opacity: 1; transform: translateX(0); }\n}\n\n/* 入场：缩放（96% 起放大至原尺寸） */\n@keyframes va-motion-in-scale {\n  from { opacity: 0; transform: scale(0.96); }\n  to { opacity: 1; transform: scale(1); }\n}\n\n/* 离场：与入场互逆（向上/向左飘出、缩回）；时长/曲线由工具类映射 --va-dur-out 骨架 */\n@keyframes va-motion-out-up {\n  from { opacity: 1; transform: translateY(0); }\n  to { opacity: 0; transform: translateY(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-left {\n  from { opacity: 1; transform: translateX(0); }\n  to { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-scale {\n  from { opacity: 1; transform: scale(1); }\n  to { opacity: 0; transform: scale(0.96); }\n}\n\n/* 交叉淡入/淡出（.va-crossfade 骨架→内容交换专用，无位移，避免占位跳变叠加） */\n@keyframes va-motion-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes va-motion-fade-out {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n/* ---- 工具类：入场走 --va-dur-in + ease-out-quart，离场走 --va-dur-out + ease-in-quad ---- */\n\n.va-enter-up {\n  animation: va-motion-in-up var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-left {\n  animation: va-motion-in-left var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-scale {\n  animation: va-motion-in-scale var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-exit-up {\n  animation: va-motion-out-up var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-left {\n  animation: va-motion-out-left var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-scale {\n  animation: va-motion-out-scale var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n/* 骨架 → 内容交叉过渡：新内容纯淡入 */\n.va-crossfade {\n  animation: va-motion-fade-in var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* 空态/轻量状态渐入（TASK-106 弱化档）：仅 opacity、时长走 --va-dur-2，\n   供列表空态提示与一次性状态块使用（空态清单见 TASK-106 报告）。\n   纯 opacity 即动效分频策略的降级终点形态，reduced-motion 下保持原样即可。 */\n.va-fade-in {\n  animation: va-motion-fade-in var(--va-dur-2, 200ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* ---- 静态光斑基类（TASK-105，决策 5「追光」路线基建）----\n   pointer 坐标由 composables/useSpotlight.ts 以 rAF 节流写入 --va-spot-x/y\n   （元素内百分比，光斑数学在 composable 内可单测）；本类只负责 radial 光斑\n   绘制与显隐（:hover 点亮，无 3D 倾斜， glare 数学对齐 VaTiltCard）。\n   --va-spot-* 为 L3 组件钩子口径（宿主可覆盖尺寸/颜色），不进 tokens.css。\n   双降级对齐 VaTiltCard glare：hover: none（触屏）与 reduced-motion 不绘制。 */\n.va-spotlight { position: relative; }\n\n/* ::after 承载光斑（避开组件自身 ::before 用途）；inset 0 + border-radius inherit\n   使光斑天然裁剪在宿主圆角内，无需 overflow: hidden。\n   注意：此 ::after radial 与 components/spotlight-card/VaSpotlightCard.css 的\n   .va-spot-card--spot::after 为 registry 单文件自含有意复制，改动需两处同步。 */\n.va-spotlight::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n  background: radial-gradient(\n    var(--va-spot-size, 240px) circle at var(--va-spot-x, 50%) var(--va-spot-y, 50%),\n    var(--va-spot-color, rgba(255, 255, 255, 0.14)),\n    transparent 65%\n  );\n}\n\n.va-spotlight:hover::after { opacity: 1; }\n\n@media (hover: none) {\n  .va-spotlight::after { display: none; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-spotlight::after { display: none; }\n}\n\n/* ---- 复制反馈标准（TASK-106）：copy→check 交叉过渡 ----\n   容器 .va-copy 为 inline-grid 双内容同格堆叠（格子宽取较宽子项，切换零跳动）：\n   __idle = copy 态内容（图标/文字），__done = check 态内容。\n   copied 置真挂 .va-copy--done：check 以 ease-spring 微弹入场（进入 done 态时\n   transform 的目标态时序换成 --va-ease-spring → 过冲回弹），交叉时长统一 --va-dur-1。\n   消费方：terminal-log（行复制）、code-diff（复制按钮）、message-actions（复制图标）。 */\n.va-copy { display: inline-grid; place-items: center; }\n\n.va-copy__idle,\n.va-copy__done {\n  grid-area: 1 / 1;\n  transition: opacity var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-copy__idle { opacity: 1; transform: scale(1); }\n.va-copy__done { opacity: 0; transform: scale(0.6); }\n\n.va-copy--done .va-copy__done {\n  opacity: 1;\n  transform: scale(1);\n  /* 时序按 transition 属性顺序映射：opacity 仍 ease，transform 换 ease-spring 微弹 */\n  transition-timing-function: var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), var(--va-ease-spring, cubic-bezier(0.34, 1.56, 0.64, 1));\n}\n\n.va-copy--done .va-copy__idle { opacity: 0; transform: scale(0.6); }\n\n@media (prefers-reduced-motion: reduce) {\n  /* 交叉过渡瞬时完成（无位移动画），copied 状态可感知性不受影响 */\n  .va-copy__idle,\n  .va-copy__done { transition: none; }\n}\n\n/* ---- 错误反馈标准（校验失败横向微振）：目标元素挂 .va-shake 播一次 ±3px 微振 ----\n   时长 --va-dur-2 × 2（两拍四峰，克制的「摇头」量级，rubric 校验失败口径）；\n   重复触发需先移除类、强制 reflow 再挂回（封装见 composables/useShake.ts）。\n   reduced-motion 降级为不播：错误状态的可感知性由错误样式本身（描边/文案）承担，\n   动效只做注意力引导——符合头注释「功能动画降级保留状态可感知」的分频策略。\n   消费方：VaStepperForm / VaOtpInput 经 useShake() 程序化触发（defineExpose shake()）；\n   宿主自绘表单可直接挂类。 */\n@keyframes va-motion-shake {\n  20% { transform: translateX(-3px); }\n  40% { transform: translateX(3px); }\n  60% { transform: translateX(-2px); }\n  80% { transform: translateX(2px); }\n}\n\n.va-shake {\n  animation: va-motion-shake calc(var(--va-dur-2, 200ms) * 2) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-shake { animation: none; }\n}\n\n/* ---- 动效分频（对齐 tokens.css 头注释策略）：\n   功能动画降级为纯 opacity——进/出场整体换成 fade keyframes，\n   位移/缩放不再出现（animation-name 顶替，时长/缓动沿用上面的声明）。 */\n@media (prefers-reduced-motion: reduce) {\n  .va-enter-up,\n  .va-enter-left,\n  .va-enter-scale,\n  .va-crossfade {\n    animation-name: va-motion-fade-in;\n  }\n\n  .va-exit-up,\n  .va-exit-left,\n  .va-exit-scale {\n    animation-name: va-motion-fade-out;\n  }\n}\n</style>\n"
    },
    {
      "path": "components/ui/assistant-turn/index.ts",
      "type": "registry:ui",
      "target": "components/ui/assistant-turn/index.ts",
      "content": "export { default as VaAssistantTurn } from \"./VaAssistantTurn.vue\";\nexport type {\n  AssistantTurnProps,\n  AssistantTurnEvents,\n  TurnBlockItem,\n  ActionCardItem,\n} from \"./types\";\n"
    },
    {
      "path": "components/ui/assistant-turn/types.ts",
      "type": "registry:ui",
      "target": "components/ui/assistant-turn/types.ts",
      "content": "export interface TurnBlockItem {\n  kind: \"text\" | \"card\";\n  content?: string;\n  cardId?: string;\n}\n\nexport interface ActionCardItem {\n  id: string;\n  type: string;\n  data?: any;\n}\n\nexport interface AssistantTurnProps {\n  /** 正文回答内容（无 blocks 时直接渲染） */\n  content?: string;\n  /** 思考链文本 */\n  thought?: string;\n  /** 是否展开详细思考内容（支持 v-model:thoughtExpanded） */\n  thoughtExpanded?: boolean;\n  /** 思考耗时（秒） */\n  thoughtDuration?: number;\n  /** 统一过程是否已折叠为摘要条（支持 v-model:processCollapsed） */\n  processCollapsed?: boolean;\n  /** 是否在回答结束时支持折叠为过程摘要条 */\n  canCollapseProcess?: boolean;\n  /** 工具调用次数（用于摘要条统计展示） */\n  toolCount?: number;\n  /** 是否处于流式响应中 */\n  streaming?: boolean;\n  /** 助手头像（支持图片链接、文字或 'bot'） */\n  avatar?: string;\n  /** 任务是否被中止 */\n  aborted?: boolean;\n  /** 中止成因文案（如：手动停止、超时等） */\n  abortReason?: string;\n  /** 时序交错块列表（文本与卡片穿插渲染） */\n  blocks?: TurnBlockItem[];\n  /** 卡片数据列表（与 blocks.cardId 对应） */\n  cards?: ActionCardItem[];\n  /** 是否启用底部消息操作条（复制/重发/反馈） */\n  actionsEnabled?: boolean;\n}\n\nexport interface AssistantTurnEvents {\n  (e: \"regenerate\"): void;\n  (e: \"copy\", text: string): void;\n  (e: \"feedback\", kind: \"up\" | \"down\" | null, reason?: string): void;\n  (e: \"update:thoughtExpanded\", value: boolean): void;\n  (e: \"update:processCollapsed\", value: boolean): void;\n}\n"
    }
  ]
}
