{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "composer",
  "title": "Composer",
  "description": "任务输入框：自动增高、Enter 发送（Shift+Enter 换行、中文输入法安全）、可插入模型选择等前缀。",
  "type": "registry:ui",
  "dependencies": [
    "lucide-vue-next"
  ],
  "registryDependencies": [
    "@vuagent/model-picker"
  ],
  "docs": "- `v-model:text` (string，默认 \"\")：输入内容\n- `placeholder` (string，默认 \"给 agent 一个任务…\")：占位文案\n- `busy` (boolean，默认 false)：运行中禁发\n- `@send` (-，默认 -)：携带文本",
  "files": [
    {
      "path": "components/ui/composer/VaComposer.vue",
      "type": "registry:ui",
      "target": "components/ui/composer/VaComposer.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, ref, useTemplateRef } from \"vue\";\nimport { Check, ChevronDown, FileText, Loader2, Paperclip, Shield, X, Zap } from \"lucide-vue-next\";\nimport type { ComposerEvents, ComposerProps } from \"./types\";\nimport { useComposer } from \"./useComposer\";\nimport { VaModelPicker } from \"../model-picker/index.js\";\n\nconst props = withDefaults(defineProps<ComposerProps>(), {\n  text: undefined,\n  placeholder: \"给 agent 一个任务…\",\n  disabled: false,\n  busy: false,\n  maxHeight: 160,\n  allowEmpty: false,\n  models: () => [],\n  model: \"\",\n  permissions: () => [],\n  permission: \"\",\n  attachable: false,\n  uploading: false,\n  attachments: () => [],\n  mentionPaths: () => [],\n});\n\nconst text = defineModel<string>(\"text\", { default: \"\" });\n\nconst emit = defineEmits<ComposerEvents>();\n\nconst area = useTemplateRef<HTMLTextAreaElement>(\"area\");\nconst { composing, onInput, submit, onKeydown } = useComposer(props, text, area, {\n  send: (t) => emit(\"send\", t),\n});\n\n/* ---------- 模型 / 权限 seat（G21/G22） ---------- */\nconst currentModel = computed(() => props.model || props.models[0]?.id || \"\");\nconst currentPermission = computed(() => props.permission || props.permissions[0]?.id || \"\");\nconst permOpen = ref(false);\nfunction togglePerm() {\n  permOpen.value = !permOpen.value;\n}\nfunction pickPermission(id: string) {\n  if (id !== currentPermission.value) emit(\"update:permission\", id);\n  permOpen.value = false;\n}\n/** ComposerModelOption → ModelItem（VaModelPicker 承载模型 seat，键盘可导航） */\nconst mpModels = computed(() =>\n  props.models.map((m) => ({\n    id: m.id,\n    name: m.label,\n    tag: m.meta,\n    provider: m.provider,\n    model: m.model,\n  }))\n);\nfunction onModelPicked(id: string) {\n  if (id !== currentModel.value) emit(\"update:model\", id);\n}\nconst modelLabel = computed(() => props.models.find((m) => m.id === currentModel.value)?.label ?? currentModel.value);\nconst permLabel = computed(() => props.permissions.find((p) => p.id === currentPermission.value)?.label ?? currentPermission.value);\n\n/* ---------- @引用 高亮（G23 增强）：明文 textarea 无法给子串上色，\n   用同排版背板铺底色、文本框透明叠在上层实现 ---------- */\nconst backdrop = useTemplateRef<HTMLElement>(\"backdrop\");\n\n/** 可高亮的引用路径集合（宿主传入工作区文件路径；@path 命中即铺底色） */\nconst mentionSet = computed(() => new Set(props.mentionPaths ?? []));\n\nfunction escapeHtml(input: string): string {\n  return input.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n}\n\nconst highlightedHtml = computed(() => {\n  const value = text.value;\n  if (!value) return \"\";\n  const set = mentionSet.value;\n  // 无引用路径时退化为纯转义（背板仍需存在以保持行高一致）\n  if (set.size === 0) return escapeHtml(value);\n\n  let out = \"\";\n  let cursor = 0;\n  const tokenRe = /@[^\\s@]+/g;\n  let m: RegExpExecArray | null;\n  while ((m = tokenRe.exec(value)) !== null) {\n    if (!set.has(m[0].slice(1))) continue;\n    out += escapeHtml(value.slice(cursor, m.index));\n    out += `<mark class=\"va-cmp__hl\">${escapeHtml(m[0])}</mark>`;\n    cursor = m.index + m[0].length;\n  }\n  out += escapeHtml(value.slice(cursor));\n  return out;\n});\n\n/** 文本框内部滚动时，背板跟随（内容封顶 maxHeight 后必然出现滚动错位） */\nfunction onAreaScroll() {\n  const el = area.value;\n  const bd = backdrop.value;\n  if (!el || !bd) return;\n  bd.scrollTop = el.scrollTop;\n  bd.scrollLeft = el.scrollLeft;\n}\n\n/* ---------- 附件（G23）：回形针 / 拖拽 / 粘贴 ---------- */\nconst fileInput = useTemplateRef<HTMLInputElement>(\"file\");\nconst dragging = ref(false);\nfunction onPickFiles() {\n  if (props.disabled || props.uploading) return;\n  fileInput.value?.click();\n}\nfunction onFileChange(e: Event) {\n  const files = (e.target as HTMLInputElement).files;\n  if (files?.length) emit(\"filesSelected\", Array.from(files));\n  (e.target as HTMLInputElement).value = \"\";\n}\nfunction onDrop(e: DragEvent) {\n  dragging.value = false;\n  if (!props.attachable || props.disabled) return;\n  const files = e.dataTransfer?.files;\n  if (files?.length) emit(\"filesSelected\", Array.from(files));\n}\nfunction onPaste(e: ClipboardEvent) {\n  if (!props.attachable || props.disabled) return;\n  const files = e.clipboardData?.files;\n  if (files?.length) {\n    e.preventDefault();\n    emit(\"filesSelected\", Array.from(files));\n  }\n}\n\nfunction fmtSize(n?: number): string {\n  if (!n && n !== 0) return \"\";\n  if (n < 1024) return `${n} B`;\n  if (n < 1024 * 1024) return `${(n / 1024).toFixed(0)} KB`;\n  return `${(n / 1024 / 1024).toFixed(1)} MB`;\n}\n\n/** 宿主聚焦输入区（如新建会话后自动聚焦） */\ndefineExpose({\n  focus: () => area.value?.focus(),\n});\n</script>\n\n<template>\n  <div\n    class=\"va-cmp\"\n    :class=\"{ 'va-cmp--busy': props.busy, 'va-cmp--drag': dragging }\"\n    @dragover.prevent=\"dragging = props.attachable\"\n    @dragleave=\"dragging = false\"\n    @drop=\"onDrop\"\n  >\n    <!-- 附件 rail（G23） -->\n    <div v-if=\"props.attachments.length\" class=\"va-cmp__atts\">\n      <span v-for=\"a in props.attachments\" :key=\"a.id\" class=\"va-cmp__att\">\n        <img v-if=\"a.kind === 'image' && a.previewUrl\" class=\"va-cmp__att-thumb\" :src=\"a.previewUrl\" alt=\"\" />\n        <FileText v-else :size=\"13\" aria-hidden=\"true\" />\n        <span class=\"va-cmp__att-name\" :title=\"a.name\">{{ a.name }}</span>\n        <span v-if=\"a.size !== undefined\" class=\"va-cmp__att-size\">{{ fmtSize(a.size) }}</span>\n        <button class=\"va-cmp__att-x\" type=\"button\" :aria-label=\"`移除附件 ${a.name}`\" @click=\"emit('removeAttachment', a.id)\">\n          <X :size=\"11\" aria-hidden=\"true\" />\n        </button>\n      </span>\n    </div>\n\n    <div v-if=\"$slots.prefix\" class=\"va-cmp__prefix\"><slot name=\"prefix\" /></div>\n    <div class=\"va-cmp__input-wrap\">\n      <!-- 高亮背板：与 textarea 同字同排版，仅给 @引用 令牌铺底色（文字透明，不重影） -->\n      <div ref=\"backdrop\" class=\"va-cmp__backdrop\" aria-hidden=\"true\" v-html=\"highlightedHtml\" />\n      <textarea\n        ref=\"area\"\n        class=\"va-cmp__area\"\n        :value=\"text\"\n        :placeholder=\"props.placeholder\"\n        :disabled=\"props.disabled\"\n        rows=\"1\"\n        @input=\"onInput\"\n        @keydown=\"onKeydown\"\n        @compositionstart=\"composing = true\"\n        @compositionend=\"composing = false\"\n        @paste=\"onPaste\"\n        @scroll=\"onAreaScroll\"\n      />\n    </div>\n    <div class=\"va-cmp__foot\">\n      <div class=\"va-cmp__actions\">\n        <slot name=\"actions\" />\n\n        <!-- 模型 seat（G21）：VaModelPicker 承载（键盘可导航；trigger 插槽保座位样式） -->\n        <VaModelPicker\n          v-if=\"props.models.length\"\n          class=\"va-cmp__seat-wrap\"\n          :models=\"mpModels\"\n          :selected=\"currentModel\"\n          align=\"left\"\n          :aria-label=\"`切换模型（当前 ${modelLabel}）`\"\n          @update:selected=\"onModelPicked\"\n        >\n          <template #trigger=\"{ open, toggle }\">\n            <button class=\"va-cmp__seat\" type=\"button\" :aria-expanded=\"open\" :aria-label=\"`切换模型（当前 ${modelLabel}）`\" :disabled=\"props.disabled\" @click.stop=\"toggle\">\n              <Zap :size=\"12\" aria-hidden=\"true\" />\n              <span class=\"va-cmp__seat-label\">{{ modelLabel }}</span>\n              <ChevronDown :size=\"11\" aria-hidden=\"true\" />\n            </button>\n          </template>\n        </VaModelPicker>\n\n        <!-- 权限 seat（G22） -->\n        <span v-if=\"props.permissions.length\" class=\"va-cmp__seat-wrap\">\n          <button class=\"va-cmp__seat\" type=\"button\" :aria-label=\"`权限预设（当前 ${permLabel}）`\" :disabled=\"props.disabled\" @click.stop=\"togglePerm\">\n            <Shield :size=\"12\" aria-hidden=\"true\" />\n            <span class=\"va-cmp__seat-label\">{{ permLabel }}</span>\n            <ChevronDown :size=\"11\" aria-hidden=\"true\" />\n          </button>\n          <div v-if=\"permOpen\" class=\"va-cmp__menu\" role=\"menu\" aria-label=\"权限预设\">\n            <button\n              v-for=\"p in props.permissions\"\n              :key=\"p.id\"\n              class=\"va-cmp__menu-row\"\n              type=\"button\"\n              role=\"menuitem\"\n              :data-active=\"p.id === currentPermission || undefined\"\n              @click.stop=\"pickPermission(p.id)\"\n            >\n              <Check v-if=\"p.id === currentPermission\" :size=\"13\" aria-hidden=\"true\" />\n              <span v-else class=\"va-cmp__menu-gap\" aria-hidden=\"true\" />\n              <span class=\"va-cmp__menu-col\">\n                <span class=\"va-cmp__menu-name\">{{ p.label }}</span>\n                <span v-if=\"p.desc\" class=\"va-cmp__menu-desc\">{{ p.desc }}</span>\n              </span>\n            </button>\n          </div>\n        </span>\n\n        <!-- 附件入口（G23） -->\n        <button v-if=\"props.attachable\" class=\"va-cmp__seat va-cmp__seat--icon\" type=\"button\" aria-label=\"上传附件\" title=\"上传附件（也可拖入/粘贴）\" :disabled=\"props.disabled || props.uploading\" @click=\"onPickFiles\">\n          <Loader2 v-if=\"props.uploading\" :size=\"12\" class=\"va-cmp__spin\" aria-hidden=\"true\" />\n          <Paperclip v-else :size=\"12\" aria-hidden=\"true\" />\n        </button>\n        <input ref=\"file\" class=\"va-cmp__file\" type=\"file\" multiple hidden @change=\"onFileChange\" />\n\n        <!-- 尾部操作区（宿主注入；靠右贴发送钮，如三点更多菜单） -->\n        <div v-if=\"$slots.trailing\" class=\"va-cmp__trailing\">\n          <slot name=\"trailing\" />\n        </div>\n      </div>\n      <!-- busy：发送钮变为停止钮（运行中断）；空闲：正常发送 -->\n      <button v-if=\"props.busy\" class=\"va-cmp__send va-cmp__send--stop\" type=\"button\" aria-label=\"停止运行\" title=\"停止（Esc）\" @click=\"emit('stop')\">\n        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\">\n          <rect x=\"7\" y=\"7\" width=\"10\" height=\"10\" rx=\"1.5\" />\n        </svg>\n      </button>\n      <button v-else class=\"va-cmp__send\" type=\"button\" :disabled=\"props.disabled || (!props.allowEmpty && !text.trim())\" aria-label=\"发送\" @click=\"submit\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n          <path d=\"M12 19V5M5.5 11.5 12 5l6.5 6.5\" />\n        </svg>\n      </button>\n    </div>\n  </div>\n</template>\n\n<style>\n/* VaComposer — 任务输入框 */\n.va-cmp {\n  --_edge: var(--va-cmp-edge, var(--va-edge, rgba(26, 25, 23, 0.12)));\n  --_ink: var(--va-cmp-ink, var(--va-ink, #1a1917));\n  --_muted: var(--va-cmp-muted, var(--va-muted, #6f6d66));\n  --_accent: var(--va-cmp-accent, var(--va-accent, #c2410c));\n\n  background: var(--va-card, #ffffff);\n  border: 1px solid var(--_edge);\n  border-radius: var(--va-radius-m, 10px);\n  padding: var(--va-s2, 4px) var(--va-s2, 4px) var(--va-s2, 4px) var(--va-s4, 12px);\n  display: flex;\n  flex-direction: column;\n  align-items: stretch;\n  gap: 0;\n  font-family: var(--va-font, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Helvetica Neue\", sans-serif);\n  transition: border-color var(--va-dur-2, 200ms) ease, box-shadow var(--va-dur-2, 200ms) ease;\n}\n.va-cmp:focus-within {\n  border-color: color-mix(in srgb, var(--_accent) 45%, var(--_edge));\n  box-shadow: 0 0 0 3px color-mix(in srgb, var(--_accent) 12%, transparent);\n}\n\n.va-cmp__prefix { display: inline-flex; align-items: center; padding-bottom: var(--va-s2, 4px); flex: none; }\n\n/* 输入区外层：承载「高亮背板 + 透明 textarea」两层 */\n.va-cmp__input-wrap { position: relative; flex: 1; min-width: 0; display: flex; }\n/* 背板：与 textarea 逐项对齐（字体/行高/内边距/换行策略），只负责令牌底色 */\n.va-cmp__backdrop {\n  position: absolute;\n  inset: 0;\n  padding: var(--va-s3, 8px) 0;\n  font: inherit;\n  font-size: var(--va-fs-lg, 14px);\n  line-height: 1.6;\n  white-space: pre-wrap;\n  overflow-wrap: break-word;\n  /* 文本对齐必须与 textarea 默认行为一致：宿主容器可能是 text-align:center\n     （如居中布局的欢迎页），继承会令背板色块整体偏移 */\n  text-align: start;\n  color: transparent;\n  overflow: hidden;\n  pointer-events: none;\n}\n.va-cmp__hl {\n  background: color-mix(in srgb, var(--_accent) 16%, transparent);\n  border-radius: 4px;\n  color: transparent;\n  /* 视觉留白：背板必须与 textarea 文字逐字对齐，水平 padding 用等值负 margin 抵消\n     （净位移为 0，仅让底色外扩）；垂直方向溢出不影响行盒，可安全加高 */\n  padding: 2px 4px;\n  margin: -2px -4px;\n}\n.va-cmp__area {\n  position: relative;\n  flex: 1;\n  min-width: 0;\n  border: 0;\n  outline: none;\n  resize: none;\n  background: none;\n  font: inherit;\n  font-size: var(--va-fs-lg, 14px);\n  line-height: 1.6;\n  color: var(--_ink);\n  padding: var(--va-s3, 8px) 0;\n  height: auto;\n  /* 初始约 3 行；增长封顶由 autosize JS 按 maxHeight prop 控制 */\n  min-height: 84px;\n}\n.va-cmp__area::placeholder { color: var(--_muted); }\n.va-cmp__area:disabled { cursor: not-allowed; }\n\n.va-cmp__foot { display: flex; align-items: center; gap: var(--va-s2, 4px); padding: 0 var(--va-s2, 4px) var(--va-s2, 4px); flex: none; }\n\n.va-cmp__send {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 30px;\n  height: 30px;\n  border: 0;\n  border-radius: var(--va-radius-m, 10px);\n  background: var(--_ink);\n  color: var(--va-card, #ffffff);\n  cursor: pointer;\n  transition: opacity var(--va-dur-1, 120ms) ease, transform var(--va-dur-1, 120ms) ease;\n}\n.va-cmp__send:hover:not(:disabled) { opacity: 0.88; }\n.va-cmp__send:active:not(:disabled) { transform: scale(0.95); }\n.va-cmp__send:disabled { opacity: 0.35; cursor: default; }\n.va-cmp__send:focus-visible { outline: 2px solid var(--_accent); outline-offset: 2px; }\n.va-cmp__send svg { width: 15px; height: 15px; }\n\n/* ---- M2 扩展：模型/权限 seat、菜单、附件 rail ---- */\n.va-cmp__actions { flex: 1; min-width: 0; display: flex; align-items: center; gap: var(--va-s3h, 6px); flex-wrap: wrap; position: relative; }\n/* 尾部插槽容器（#trailing）：跟随图标排布（不上推最右，紧邻附件等图标） */\n.va-cmp__trailing { display: inline-flex; align-items: center; gap: var(--va-s2, 4px); }\n\n.va-cmp__seat-wrap { position: relative; display: inline-flex; }\n.va-cmp__seat {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  height: 28px;\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  background: none;\n  color: var(--va-ink-2, #43413c);\n  font: inherit;\n  font-size: var(--va-fs-xs, 11px);\n  border-radius: var(--va-radius-pill, 999px);\n  padding: 0 var(--va-s4h, 10px);\n  cursor: pointer;\n  max-width: 220px;\n}\n.va-cmp__seat:hover:not(:disabled), .va-cmp__seat[aria-expanded=\"true\"] { border-color: var(--va-accent, #c2410c); color: var(--va-accent, #c2410c); }\n.va-cmp__seat:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: 1px; }\n.va-cmp__seat:disabled { opacity: 0.45; cursor: default; }\n.va-cmp__seat--icon { width: 28px; padding: 0; justify-content: center; }\n.va-cmp__seat-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n\n.va-cmp__menu {\n  position: absolute;\n  bottom: calc(100% + 8px);\n  left: 0;\n  z-index: 30;\n  min-width: 200px;\n  background: var(--va-card, #ffffff);\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-m, 10px);\n  box-shadow: var(--va-shadow-3, 0 12px 32px rgba(26, 25, 23, 0.12));\n  padding: 5px;\n}\n.va-cmp__menu-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  width: 100%;\n  border: 0;\n  background: none;\n  font: inherit;\n  font-size: var(--va-fs-md, 13px);\n  color: var(--va-ink-2, #43413c);\n  padding: 7px 9px;\n  border-radius: var(--va-radius-s, 8px);\n  cursor: pointer;\n  text-align: left;\n}\n.va-cmp__menu-row:hover { background: var(--va-bg-subtle, #efede7); }\n.va-cmp__menu-row[data-active=\"true\"] { background: var(--va-accent-soft, rgba(194, 65, 12, 0.1)); color: var(--va-accent, #c2410c); font-weight: var(--va-fw-semibold, 600); }\n.va-cmp__menu-row > svg { flex: none; color: var(--va-accent, #c2410c); }\n.va-cmp__menu-gap { flex: none; width: 13px; }\n.va-cmp__menu-name { font-weight: var(--va-fw-semibold, 600); }\n.va-cmp__menu-meta { margin-left: auto; font-size: var(--va-fs-xs, 11px); color: var(--va-muted, #6f6d66); font-family: var(--va-font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace); }\n.va-cmp__menu-col { display: flex; flex-direction: column; gap: 1px; min-width: 0; flex: 1; }\n.va-cmp__menu-desc { font-size: var(--va-fs-xs, 11px); font-weight: 400; color: var(--va-muted, #6f6d66); line-height: 1.45; }\n\n.va-cmp__spin { animation: va-spin calc(var(--va-dur-loop, 1.8s) * 0.5) linear infinite; }\n@keyframes va-spin { to { transform: rotate(360deg); } }\n@media (prefers-reduced-motion: reduce) { .va-cmp__spin { animation: none; } }\n\n.va-cmp__atts { display: flex; align-items: center; gap: var(--va-s3h, 6px); flex-wrap: wrap; padding: 8px 8px 0; }\n.va-cmp__att {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--va-s3h, 6px);\n  background: var(--va-bg-subtle, #efede7);\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-s, 8px);\n  padding: 4px 8px;\n  font-size: var(--va-fs-xs, 11px);\n  color: var(--va-ink-2, #43413c);\n  max-width: 240px;\n}\n.va-cmp__att > svg { flex: none; color: var(--va-muted, #6f6d66); }\n.va-cmp__att-thumb { width: 22px; height: 22px; border-radius: 5px; object-fit: cover; flex: none; }\n.va-cmp__att-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.va-cmp__att-size { flex: none; font-size: var(--va-fs-2xs, 10px); color: var(--va-muted, #6f6d66); }\n.va-cmp__att-x {\n  flex: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 16px;\n  height: 16px;\n  border: 0;\n  border-radius: 50%;\n  background: none;\n  color: var(--va-muted, #6f6d66);\n  cursor: pointer;\n}\n.va-cmp__att-x:hover { color: var(--va-danger, #d5453c); background: var(--va-card, #ffffff); }\n\n.va-cmp--drag { outline: 2px dashed var(--va-accent, #c2410c); outline-offset: -3px; }\n.va-cmp__file { display: none; }\n\n/* 运行中：发送位切换为停止钮 */\n.va-cmp__send--stop {\n  background: var(--va-danger, #d5453c);\n  color: var(--va-card, #ffffff);\n}\n.va-cmp__send--stop:hover { filter: brightness(1.06); }\n.va-cmp__send--stop svg { width: 13px; height: 13px; }\n</style>\n"
    },
    {
      "path": "components/ui/composer/index.ts",
      "type": "registry:ui",
      "target": "components/ui/composer/index.ts",
      "content": "export { default as VaComposer } from \"./VaComposer.vue\";\nexport type { ComposerAttachment, ComposerEvents, ComposerModelOption, ComposerPermissionOption, ComposerProps } from \"./types\";\n"
    },
    {
      "path": "components/ui/composer/types.ts",
      "type": "registry:ui",
      "target": "components/ui/composer/types.ts",
      "content": "/** VaComposer 的类型定义 */\n\nexport interface ComposerProps {\n  placeholder?: string;\n  disabled?: boolean;\n  /** agent 运行中：禁发并隐藏发送钮 */\n  busy?: boolean;\n  /** 输入区最大高度 px（超过后内部滚动） */\n  maxHeight?: number;\n  /** 输入为空时也允许发送 */\n  allowEmpty?: boolean;\n  /** 模型候选（G21）；非空渲染模型 seat */\n  models?: ComposerModelOption[];\n  /** 受控当前模型 id */\n  model?: string;\n  /** 权限预设（G22）；非空渲染权限 seat */\n  permissions?: ComposerPermissionOption[];\n  /** 受控当前权限 id */\n  permission?: string;\n  /** 显示附件入口（回形针 / 拖拽 / 粘贴，G23） */\n  attachable?: boolean;\n  /** 附件上传中（paperclip 禁点） */\n  uploading?: boolean;\n  /** 待发送附件 rail */\n  attachments?: ComposerAttachment[];\n  /** 可高亮的 @引用 路径白名单（不含 @ 前缀；命中者以背景色强化显示） */\n  mentionPaths?: string[];\n}\n\nexport interface ComposerEvents {\n  \"update:text\": [text: string];\n  send: [text: string];\n  /** busy 时发送钮变为停止钮（agent 运行中断）；宿主接取消逻辑 */\n  stop: [];\n  \"update:model\": [id: string];\n  \"update:permission\": [id: string];\n  /** 移除待发送附件 */\n  removeAttachment: [id: string];\n  /** 回形针/拖拽/粘贴选中的文件（上传由宿主处理） */\n  filesSelected: [files: File[]];\n}\n\nexport interface ComposerModelOption {\n  id: string;\n  label: string;\n  /** 次要说明（provider 等） */\n  meta?: string;\n  /** 所属供应商（例如 DEEPSEEK / OPENAI） */\n  provider?: string;\n  /** 底层模型标识（例如 deepseek-chat） */\n  model?: string;\n}\n\nexport interface ComposerPermissionOption {\n  id: string;\n  label: string;\n  desc?: string;\n}\n\nexport interface ComposerAttachment {\n  id: string;\n  name: string;\n  /** 字节 */\n  size?: number;\n  kind: \"image\" | \"file\";\n  /** 图片本地预览（objectURL） */\n  previewUrl?: string;\n}\n"
    },
    {
      "path": "components/ui/composer/useComposer.ts",
      "type": "registry:ui",
      "target": "components/ui/composer/useComposer.ts",
      "content": "import { nextTick, onMounted, ref, type Ref } from \"vue\";\nimport type { ComposerProps } from \"./types\";\n\n/** VaComposer 的状态逻辑：自动增高、Enter 发送（Shift+Enter 换行、IME 组合期不发送）。area 由 SFC 传入 */\nexport function useComposer(\n  props: ComposerProps,\n  text: Ref<string>,\n  area: Ref<HTMLTextAreaElement | null>,\n  emit: { send: (t: string) => void },\n) {\n  const composing = ref(false);\n\n  /** 输入后按内容调整高度，封顶 props.maxHeight */\n  async function autosize() {\n    const el = area.value;\n    if (!el) return;\n    el.style.height = \"auto\";\n    await nextTick();\n    const max = props.maxHeight ?? 160;\n    el.style.height = `${Math.min(el.scrollHeight, max)}px`;\n  }\n\n  function onInput(e: Event) {\n    text.value = (e.target as HTMLTextAreaElement).value;\n    void autosize();\n  }\n\n  function submit() {\n    const t = text.value.trim();\n    if (props.disabled) return;\n    // busy 时不拦截：宿主在 send 回调里自行决定排队语义（运行中入队）\n    if (!props.allowEmpty && !t) return;\n    emit.send(t);\n    text.value = \"\";\n    void autosize();\n  }\n\n  function onKeydown(e: KeyboardEvent) {\n    if (e.key !== \"Enter\" || e.shiftKey || composing.value) return;\n    e.preventDefault();\n    submit();\n  }\n\n  // 初始已有文本（如草稿回填）时也按内容定高\n  onMounted(() => {\n    if (text.value) void autosize();\n  });\n\n  return { composing, onInput, submit, onKeydown };\n}\n"
    }
  ]
