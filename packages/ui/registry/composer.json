{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "composer",
  "title": "Composer",
  "description": "任务输入框：自动增高、Enter 发送（Shift+Enter 换行、中文输入法安全）、可插入模型选择等前缀。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `v-model:text` (string，默认 \"\")：输入内容\n- `placeholder` (string，默认 \"给 agent 一个任务…\")：占位文案\n- `busy` (boolean，默认 false)：运行中禁发\n- `@send` (-，默认 -)：携带文本",
  "files": [
    {
      "path": "components/ui/composer/VaComposer.vue",
      "type": "registry:ui",
      "target": "components/ui/composer/VaComposer.vue",
      "content": "<script setup lang=\"ts\">\nimport { useTemplateRef } from \"vue\";\nimport type { ComposerProps } from \"./types\";\nimport { useComposer } from \"./useComposer\";\n\nconst props = withDefaults(defineProps<ComposerProps>(), {\n  text: undefined,\n  placeholder: \"给 agent 一个任务…\",\n  disabled: false,\n  busy: false,\n  maxHeight: 160,\n  allowEmpty: false,\n});\n\nconst text = defineModel<string>(\"text\", { default: \"\" });\n\nconst emit = defineEmits<{ send: [text: string] }>();\n\nconst area = useTemplateRef<HTMLTextAreaElement>(\"area\");\nconst { composing, onInput, submit, onKeydown } = useComposer(props, text, area, {\n  send: (t) => emit(\"send\", t),\n});\n</script>\n\n<template>\n  <div class=\"va-cmp\" :class=\"{ 'va-cmp--busy': props.busy }\">\n    <div v-if=\"$slots.prefix\" class=\"va-cmp__prefix\"><slot name=\"prefix\" /></div>\n    <textarea\n      ref=\"area\"\n      class=\"va-cmp__area\"\n      :value=\"text\"\n      :placeholder=\"props.placeholder\"\n      :disabled=\"props.disabled\"\n      rows=\"1\"\n      @input=\"onInput\"\n      @keydown=\"onKeydown\"\n      @compositionstart=\"composing = true\"\n      @compositionend=\"composing = false\"\n    />\n    <div class=\"va-cmp__foot\">\n      <div class=\"va-cmp__actions\"><slot name=\"actions\" /></div>\n      <button\n        class=\"va-cmp__send\"\n        type=\"button\"\n        :disabled=\"props.disabled || props.busy || (!props.allowEmpty && !text.trim())\"\n        aria-label=\"发送\"\n        @click=\"submit\"\n      >\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n          <path d=\"M12 19V5M5.5 11.5 12 5l6.5 6.5\" />\n        </svg>\n      </button>\n    </div>\n  </div>\n</template>\n\n<style>\n/* VaComposer — 任务输入框 */\n.va-cmp {\n  --_edge: var(--va-cmp-edge, var(--va-edge, rgba(26, 25, 23, 0.12)));\n  --_ink: var(--va-cmp-ink, var(--va-ink, #1a1917));\n  --_muted: var(--va-cmp-muted, var(--va-muted, #6f6d66));\n  --_accent: var(--va-cmp-accent, var(--va-accent, #c2410c));\n\n  background: var(--va-card, #fff);\n  border: 1px solid var(--_edge);\n  border-radius: var(--va-radius-m, 10px);\n  padding: var(--va-s2, 4px) var(--va-s2, 4px) var(--va-s2, 4px) var(--va-s4, 12px);\n  display: flex;\n  align-items: flex-end;\n  gap: var(--va-s3, 8px);\n  font-family: var(--va-font, system-ui, sans-serif);\n  transition: border-color var(--va-dur-2, 200ms) ease, box-shadow var(--va-dur-2, 200ms) ease;\n}\n.va-cmp:focus-within {\n  border-color: color-mix(in srgb, var(--_accent) 45%, var(--_edge));\n  box-shadow: 0 0 0 3px color-mix(in srgb, var(--_accent) 12%, transparent);\n}\n.va-cmp--busy { opacity: 0.75; }\n\n.va-cmp__prefix { display: inline-flex; align-items: center; padding-bottom: var(--va-s2, 4px); flex: none; }\n\n.va-cmp__area {\n  flex: 1;\n  min-width: 0;\n  border: 0;\n  outline: none;\n  resize: none;\n  background: none;\n  font: inherit;\n  font-size: 14px;\n  line-height: 1.6;\n  color: var(--_ink);\n  padding: var(--va-s3, 8px) 0;\n  height: auto;\n  max-height: 160px;\n}\n.va-cmp__area::placeholder { color: var(--_muted); }\n.va-cmp__area:disabled { cursor: not-allowed; }\n\n.va-cmp__foot { display: flex; align-items: flex-end; gap: var(--va-s2, 4px); padding-bottom: var(--va-s2, 4px); flex: none; }\n.va-cmp__actions { display: inline-flex; gap: 4px; }\n\n.va-cmp__send {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 30px;\n  height: 30px;\n  border: 0;\n  border-radius: var(--va-radius-m, 10px);\n  background: var(--_ink);\n  color: var(--va-card, #fff);\n  cursor: pointer;\n  transition: opacity var(--va-dur-1, 120ms) ease, transform var(--va-dur-1, 120ms) ease;\n}\n.va-cmp__send:hover:not(:disabled) { opacity: 0.88; }\n.va-cmp__send:active:not(:disabled) { transform: scale(0.95); }\n.va-cmp__send:disabled { opacity: 0.35; cursor: default; }\n.va-cmp__send:focus-visible { outline: 2px solid var(--_accent); outline-offset: 2px; }\n.va-cmp__send svg { width: 15px; height: 15px; }\n</style>\n"
    },
    {
      "path": "components/ui/composer/types.ts",
      "type": "registry:ui",
      "target": "components/ui/composer/types.ts",
      "content": "/** VaComposer 的类型定义 */\n\nexport interface ComposerProps {\n  placeholder?: string;\n  disabled?: boolean;\n  /** agent 运行中：禁发并隐藏发送钮 */\n  busy?: boolean;\n  /** 输入区最大高度 px（超过后内部滚动） */\n  maxHeight?: number;\n  /** 输入为空时也允许发送 */\n  allowEmpty?: boolean;\n}\n\nexport interface ComposerEvents {\n  \"update:text\": [text: string];\n  send: [text: string];\n}\n"
    },
    {
      "path": "components/ui/composer/useComposer.ts",
      "type": "registry:ui",
      "target": "components/ui/composer/useComposer.ts",
      "content": "import { nextTick, onMounted, ref, type Ref } from \"vue\";\nimport type { ComposerProps } from \"./types\";\n\n/** VaComposer 的状态逻辑：自动增高、Enter 发送（Shift+Enter 换行、IME 组合期不发送）。area 由 SFC 传入 */\nexport function useComposer(\n  props: ComposerProps,\n  text: Ref<string>,\n  area: Ref<HTMLTextAreaElement | null>,\n  emit: { send: (t: string) => void },\n) {\n  const composing = ref(false);\n\n  /** 输入后按内容调整高度，封顶 props.maxHeight */\n  async function autosize() {\n    const el = area.value;\n    if (!el) return;\n    el.style.height = \"auto\";\n    await nextTick();\n    const max = props.maxHeight ?? 160;\n    el.style.height = `${Math.min(el.scrollHeight, max)}px`;\n  }\n\n  function onInput(e: Event) {\n    text.value = (e.target as HTMLTextAreaElement).value;\n    void autosize();\n  }\n\n  function submit() {\n    const t = text.value.trim();\n    if (props.disabled || props.busy) return;\n    if (!props.allowEmpty && !t) return;\n    emit.send(t);\n    text.value = \"\";\n    void autosize();\n  }\n\n  function onKeydown(e: KeyboardEvent) {\n    if (e.key !== \"Enter\" || e.shiftKey || composing.value) return;\n    e.preventDefault();\n    submit();\n  }\n\n  // 初始已有文本（如草稿回填）时也按内容定高\n  onMounted(() => {\n    if (text.value) void autosize();\n  });\n\n  return { composing, onInput, submit, onKeydown };\n}\n"
    }
  ]
}
