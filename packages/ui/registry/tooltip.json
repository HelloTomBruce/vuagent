{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "tooltip",
  "title": "Tooltip",
  "description": "轻量文字提示（基于 VaPopover，无交互仅 hover/focus 展示）：delay 延迟打开 + hideDelay 延迟关闭 + Esc 立即关；触发元素自动回填 aria-describedby 指向浮层 id（触发器自带 aria-label 时跳过，避免覆盖）；role=tooltip 且 pointer-events:none 不拦截指针；inverse 默认深底白字随主题自动反转。与既有 title 属性共存时优先用 VaTooltip（title 不可样式化、各浏览器延迟与读屏播报不一致）。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [
    "@vuagent/popover"
  ],
  "docs": "- `content` (string，默认 -)：提示文案（a11y 必需；与 #content 插槽皆空时不显示）\n- `placement` (TooltipPlacement，默认 \"top\")：方位（top/bottom/left/right 及 *-start/*-end；上下空间不足自动翻转）\n- `delay / hideDelay` (number，默认 300 / 80)：hover/focus 打开延迟 / 移出关闭延迟 ms（Esc 与外部点击立即关）\n- `maxWidth / variant` (number / \"default\" | \"inverse\"，默认 280 / \"inverse\")：提示泡最大宽度 px / 视觉变体\n- `disabled` (boolean，默认 false)：禁用后不再打开；打开中置 true 立即收起\n- `@show / @hide` (-，默认 -)：实际显示 / 关闭回调\n- `#default / #content` (-，默认 -)：触发器（应可聚焦）/ 自定义提示内容",
  "files": [
    {
      "path": "components/ui/tooltip/VaTooltip.vue",
      "type": "registry:ui",
      "target": "components/ui/tooltip/VaTooltip.vue",
      "content": "<script setup lang=\"ts\">\nimport { onBeforeUnmount, ref, useId, useTemplateRef, watch } from \"vue\";\nimport { VaPopover } from \"../popover\";\nimport type { TooltipEvents, TooltipProps, TooltipSlots } from \"./types\";\n\n/**\n * VaTooltip — 轻量文字提示（基于 VaPopover，无交互，仅 hover/focus 展示）。\n *\n * 与 VaPopover 的分工：popover 是通用浮层原语（点击切换、可承载交互内容）；\n * tooltip 只做「延迟显示的只读文字提示」——\n *   - 触发：mouseenter / focusin 开（带 delay），mouseleave / focusout 关（带 hideDelay），Esc 立即关；\n *   - 触发元素自动回填 aria-describedby 指向浮层 id（触发器自带 aria-label 时跳过，避免覆盖/冗余播报）；\n *   - 浮层 role=tooltip 且 pointer-events:none（不拦截指针、不可悬停停留，因此无交互内容）；\n *   - 不用 VaPopover 的 trigger 插槽（它会绑点击切换），自渲染触发包装元素并以 anchor 形式喂给 popover。\n *\n * 与原生 title 的关系：元素同时带 title 时建议移除 title 改用本组件\n * （title 不可样式化、延迟/播报行为浏览器各异）；二者共存时本组件不处理 title，由宿主自行取舍。\n */\n\nconst props = withDefaults(defineProps<TooltipProps>(), {\n  placement: \"top\",\n  delay: 300,\n  hideDelay: 80,\n  maxWidth: 280,\n  variant: \"inverse\",\n  disabled: false,\n});\nconst emit = defineEmits<TooltipEvents>();\nconst slots = defineSlots<TooltipSlots>();\n\nconst tooltipId = `va-tip-${useId()}`;\nconst isOpen = ref(false);\nconst triggerEl = useTemplateRef<HTMLElement>(\"trigger\");\n\n/* ---------------- 延迟开关状态机 ---------------- */\n\nlet showTimer: ReturnType<typeof setTimeout> | null = null;\nlet hideTimer: ReturnType<typeof setTimeout> | null = null;\n\nfunction clearShowTimer() {\n  if (showTimer != null) {\n    clearTimeout(showTimer);\n    showTimer = null;\n  }\n}\nfunction clearHideTimer() {\n  if (hideTimer != null) {\n    clearTimeout(hideTimer);\n    hideTimer = null;\n  }\n}\n\n/** content prop 与 #content 插槽皆空时不显示（不渲染空气泡） */\nfunction hasContent() {\n  return !!props.content || !!slots.content;\n}\n\nfunction show() {\n  clearShowTimer();\n  clearHideTimer();\n  if (props.disabled || isOpen.value || !hasContent()) return;\n  isOpen.value = true;\n  emit(\"show\");\n}\n\nfunction hide() {\n  clearShowTimer();\n  clearHideTimer();\n  if (!isOpen.value) return;\n  isOpen.value = false;\n  emit(\"hide\");\n}\n\nfunction onEnter() {\n  if (props.disabled) return;\n  clearHideTimer(); // hideDelay 内回移：取消关闭，保持打开\n  if (isOpen.value || showTimer != null) return;\n  showTimer = setTimeout(() => {\n    showTimer = null;\n    show();\n  }, props.delay);\n}\n\nfunction onLeave() {\n  clearShowTimer(); // 未开先走：取消待打开\n  if (!isOpen.value || hideTimer != null) return;\n  hideTimer = setTimeout(() => {\n    hideTimer = null;\n    hide();\n  }, props.hideDelay);\n}\n\n/** popover 内部请求关闭（Esc 栈顶 / 外部 mousedown）→ 立即关，不走 hideDelay */\nfunction onPopoverUpdate(v: boolean) {\n  if (!v) hide();\n}\n\n/* 禁用即收：打开中/待打开被置 disabled 时立即关闭 */\nwatch(\n  () => props.disabled,\n  (d) => {\n    if (d) hide();\n  },\n);\n\n/* ---------------- aria-describedby 回填 ---------------- */\n\nconst FOCUSABLE_SELECTOR = \"button, [href], input, select, textarea, [tabindex]:not([tabindex='-1'])\";\n\n/** 回填目标：包装内首个可聚焦元素 → 首个子元素 → 包装元素自身 */\nfunction resolveDescribeTarget(): HTMLElement | null {\n  const wrap = triggerEl.value;\n  if (!wrap) return null;\n  return (\n    wrap.querySelector<HTMLElement>(FOCUSABLE_SELECTOR) ??\n    (wrap.firstElementChild as HTMLElement | null) ??\n    wrap\n  );\n}\n\n/** 记录实际回填的元素，关闭/卸载时精确回收（不依赖再次解析） */\nlet describedEl: HTMLElement | null = null;\n\nfunction applyDescription() {\n  const el = resolveDescribeTarget();\n  if (!el) return;\n  // 触发器自带 aria-label：可访问名已自足，不再补 describedby（避免覆盖与冗余播报）\n  if (el.hasAttribute(\"aria-label\")) return;\n  const tokens = (el.getAttribute(\"aria-describedby\") ?? \"\").split(/\\s+/).filter(Boolean);\n  if (tokens.includes(tooltipId)) return;\n  el.setAttribute(\"aria-describedby\", [...tokens, tooltipId].join(\" \"));\n  describedEl = el;\n}\n\nfunction removeDescription() {\n  const el = describedEl;\n  describedEl = null;\n  if (!el) return;\n  const tokens = (el.getAttribute(\"aria-describedby\") ?? \"\").split(/\\s+/).filter(Boolean);\n  const next = tokens.filter((t) => t !== tooltipId);\n  if (next.length) el.setAttribute(\"aria-describedby\", next.join(\" \"));\n  else el.removeAttribute(\"aria-describedby\");\n}\n\n/* 打开才回填（浮层 v-if 渲染，关闭时回填会留下悬空引用） */\nwatch(isOpen, (v) => {\n  if (v) applyDescription();\n  else removeDescription();\n});\n\nonBeforeUnmount(() => {\n  clearShowTimer();\n  clearHideTimer();\n  removeDescription();\n});\n\ndefineExpose({ show, hide });\n</script>\n\n<template>\n  <span\n    ref=\"trigger\"\n    class=\"va-tip__trigger\"\n    :data-disabled=\"props.disabled || undefined\"\n    @mouseenter=\"onEnter\"\n    @mouseleave=\"onLeave\"\n    @focusin=\"onEnter\"\n    @focusout=\"onLeave\"\n  >\n    <slot />\n  </span>\n\n  <VaPopover\n    :open=\"isOpen\"\n    :anchor=\"triggerEl\"\n    :placement=\"props.placement\"\n    :disabled=\"props.disabled\"\n    :close-on-outside-click=\"true\"\n    :close-on-escape=\"true\"\n    @update:open=\"onPopoverUpdate\"\n  >\n    <div\n      :id=\"tooltipId\"\n      class=\"va-tip\"\n      role=\"tooltip\"\n      :data-variant=\"props.variant\"\n      :style=\"{ maxWidth: `${props.maxWidth}px` }\"\n    >\n      <slot name=\"content\">{{ props.content }}</slot>\n    </div>\n  </VaPopover>\n</template>\n\n<style>\n/* VaTooltip — 轻量文字提示（token 驱动；inverse 变体随 [data-theme=\"dark\"] 自动反转） */\n\n.va-tip__trigger {\n  display: inline-block;\n}\n\n.va-tip__trigger[data-disabled] {\n  cursor: not-allowed;\n}\n\n/* tooltip 复用 VaPopover 的浮层容器做定位，但剥掉卡片外观（描边/底/阴影/滚动），\n   只保留定位与入场动画；指针穿透保证 mouseleave 后立即命中下层元素、提示不驻留 */\n.va-pop:has(> .va-tip) {\n  padding: 0;\n  border: none;\n  background: transparent;\n  box-shadow: none;\n  overflow: visible;\n  max-height: none;\n  pointer-events: none;\n}\n\n.va-tip {\n  pointer-events: none;\n  /* max-width 由内联样式（maxWidth prop，默认 280）给出，这里兜底 */\n  max-width: 280px;\n  padding: 5px var(--va-s4h, 10px);\n  border-radius: var(--va-radius-s, 8px);\n  font-family: var(--va-font, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\",\n    \"Microsoft YaHei\", \"Helvetica Neue\", sans-serif);\n  font-size: var(--va-fs-sm, 12px);\n  line-height: 1.5;\n  overflow-wrap: break-word;\n}\n\n/* inverse（默认）：深底白字；暗色主题下随 token 自动反转为浅底深字 */\n.va-tip[data-variant=\"inverse\"] {\n  background: var(--va-ink, #1a1917);\n  color: var(--va-bg, #f7f6f2);\n  box-shadow: var(--va-shadow-2, 0 4px 12px rgba(26, 25, 23, 0.08));\n}\n\n/* default：卡片底 + 描边，与 popover 面板观感一致 */\n.va-tip[data-variant=\"default\"] {\n  border: 1px solid var(--va-edge-strong, rgba(26, 25, 23, 0.22));\n  background: var(--va-card, #ffffff);\n  color: var(--va-ink, #1a1917);\n  box-shadow: var(--va-shadow-2, 0 4px 12px rgba(26, 25, 23, 0.08));\n}\n\n/* 进出淡入由 .va-pop 容器的 va-pop-enter-* 与 leave-* 过渡类承担；此处按组件冗余声明关闭，\n   保证 tooltip 样式单独分发时同样尊重 prefers-reduced-motion */\n@media (prefers-reduced-motion: reduce) {\n  .va-pop:has(> .va-tip) {\n    animation: none;\n  }\n}\n</style>\n"
    },
    {
      "path": "components/ui/tooltip/index.ts",
      "type": "registry:ui",
      "target": "components/ui/tooltip/index.ts",
      "content": "export { default as VaTooltip } from \"./VaTooltip.vue\";\nexport type { TooltipEvents, TooltipPlacement, TooltipProps, TooltipSlots, TooltipVariant } from \"./types\";\n"
    },
    {
      "path": "components/ui/tooltip/types.ts",
      "type": "registry:ui",
      "target": "components/ui/tooltip/types.ts",
      "content": "/** VaTooltip 的类型定义 */\n\nimport type { PopoverPlacement } from \"../popover/types\";\n\n/** 提示方位：复用 Popover 方位枚举（top/bottom 带 start/end 对齐，left/right 仅居中），默认 top */\nexport type TooltipPlacement = PopoverPlacement;\n\n/** 视觉变体：inverse = 深底白字（默认，随主题自动反转）；default = 卡片底描边 */\nexport type TooltipVariant = \"default\" | \"inverse\";\n\nexport interface TooltipProps {\n  /**\n   * 提示文案（a11y 必需——它是触发元素的 aria-describedby 目标内容）。\n   * 复杂内容可用 #content 插槽覆盖；两者皆空时不显示（不渲染空气泡）。\n   */\n  content?: string;\n  /** 初始方位（默认 top）；top/bottom 空间不足时自动翻转 */\n  placement?: TooltipPlacement;\n  /** hover/focus 后延迟打开 ms（默认 300，防掠过误闪） */\n  delay?: number;\n  /** 移出后延迟关闭 ms（默认 80，给指针回移留缓冲；Esc/外部点击立即关闭不走此延迟） */\n  hideDelay?: number;\n  /** 禁用：不再打开；打开中被置 true 会立即关闭 */\n  disabled?: boolean;\n  /** 提示泡最大宽度 px（默认 280） */\n  maxWidth?: number;\n  /** 视觉变体（默认 inverse：深底白字） */\n  variant?: TooltipVariant;\n}\n\nexport interface TooltipEvents {\n  /** 提示实际显示（延迟结束后） */\n  show: [];\n  /** 提示关闭（含 Esc / 外部点击 / 延迟结束） */\n  hide: [];\n}\n\nexport interface TooltipSlots {\n  /** 触发器（应当可聚焦，如 button——键盘 focusin 才会触发提示） */\n  default?: () => unknown;\n  /** 自定义提示内容（优先于 content prop） */\n  content?: () => unknown;\n}\n"
    }
  ]
}
