{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "metric-chart",
  "title": "Metric Chart",
  "description": "时序指标图：纯 SVG 折线/柱状两种形态，标题与单位内联展示，适合埋点/业务指标的趋势呈现。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `title` (string，默认 -)：图表标题\n- `chartType` (\"line\" | \"bar\"，默认 \"line\")：图表形态\n- `unit` (string，默认 -)：数值单位\n- `series` (MetricSeriesItem[]，默认 -)：数据序列（label/value）",
  "files": [
    {
      "path": "components/ui/metric-chart/VaMetricChart.vue",
      "type": "registry:ui",
      "target": "components/ui/metric-chart/VaMetricChart.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from \"vue\";\nimport type { MetricChartProps } from \"./types\";\n\nconst props = withDefaults(defineProps<MetricChartProps>(), {\n  chartType: \"bar\",\n  unit: \"\",\n  series: () => [],\n});\n\nconst maxVal = computed(() => {\n  if (props.series.length === 0) return 1;\n  const max = Math.max(...props.series.map((s) => s.value));\n  return max > 0 ? max : 1;\n});\n\nconst latestVal = computed(() => {\n  if (props.series.length === 0) return 0;\n  return props.series[props.series.length - 1].value;\n});\n\n// 折线图坐标点计算 (归一化到 300 x 100 viewBox)\nconst svgPoints = computed(() => {\n  const len = props.series.length;\n  if (len < 2) return [];\n\n  const width = 300;\n  const height = 90;\n  const paddingX = 10;\n  const paddingY = 8;\n  const usableW = width - paddingX * 2;\n  const usableH = height - paddingY * 2;\n\n  return props.series.map((item, idx) => {\n    const x = paddingX + (idx / (len - 1)) * usableW;\n    const y = height - paddingY - (item.value / maxVal.value) * usableH;\n    return { x, y, ...item };\n  });\n});\n\nconst polylineStr = computed(() => {\n  return svgPoints.value.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(\" \");\n});\n\nconst areaPathStr = computed(() => {\n  const pts = svgPoints.value;\n  if (pts.length < 2) return \"\";\n  const first = pts[0];\n  const last = pts[pts.length - 1];\n  return `M ${first.x},90 L ${polylineStr.value} L ${last.x},90 Z`;\n});\n</script>\n\n<template>\n  <div class=\"va-metric-chart\" role=\"region\" :aria-label=\"title\">\n    <!-- 头部指标信息 -->\n    <header class=\"va-chart-header\">\n      <h4 class=\"va-chart-title\">{{ title }}</h4>\n      <div class=\"va-chart-summary\">\n        <span class=\"va-chart-max-val\">{{ latestVal }}</span>\n        <span v-if=\"unit\" class=\"va-chart-unit\">{{ unit }}</span>\n      </div>\n    </header>\n\n    <!-- 模式 1：柱状图 (bar) -->\n    <template v-if=\"chartType === 'bar'\">\n      <div class=\"va-bar-container\">\n        <div\n          v-for=\"(item, idx) in series\"\n          :key=\"idx\"\n          class=\"va-bar-col\"\n        >\n          <div class=\"va-bar-tooltip\">{{ item.value }}{{ unit }}</div>\n          <div\n            class=\"va-bar-pill\"\n            :style=\"{ height: `${Math.max(4, (item.value / maxVal) * 100)}%` }\"\n          />\n        </div>\n      </div>\n      <div class=\"va-bar-labels\">\n        <span\n          v-for=\"(item, idx) in series\"\n          :key=\"idx\"\n          class=\"va-bar-label\"\n          :title=\"item.label\"\n        >\n          {{ item.label }}\n        </span>\n      </div>\n    </template>\n\n    <!-- 模式 2：SVG 平滑折线图 (line) -->\n    <template v-else-if=\"chartType === 'line'\">\n      <div class=\"va-line-container\">\n        <svg\n          class=\"va-line-svg\"\n          viewBox=\"0 0 300 100\"\n          preserveAspectRatio=\"none\"\n        >\n          <defs>\n            <linearGradient id=\"va-line-gradient\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n              <stop offset=\"0%\" stop-color=\"var(--va-accent, #c2410c)\" />\n              <stop offset=\"100%\" stop-color=\"transparent\" />\n            </linearGradient>\n          </defs>\n\n          <!-- 面积阴影 -->\n          <path :d=\"areaPathStr\" class=\"va-line-area\" />\n\n          <!-- 折线主体 -->\n          <polyline :points=\"polylineStr\" class=\"va-line-path\" />\n\n          <!-- 数据锚点 -->\n          <circle\n            v-for=\"(pt, idx) in svgPoints\"\n            :key=\"idx\"\n            :cx=\"pt.x\"\n            :cy=\"pt.y\"\n            r=\"3\"\n            class=\"va-line-dot\"\n          >\n            <title>{{ pt.label }}: {{ pt.value }}{{ unit }}</title>\n          </circle>\n        </svg>\n      </div>\n\n      <div class=\"va-bar-labels\">\n        <span\n          v-for=\"(item, idx) in series\"\n          :key=\"idx\"\n          class=\"va-bar-label\"\n          :title=\"item.label\"\n        >\n          {{ item.label }}\n        </span>\n      </div>\n    </template>\n  </div>\n</template>\n\n<style>\n/**\n * @vuagent/ui - VaMetricChart 样式\n * 遵循 Calm 暖静设计系统\n */\n\n.va-metric-chart {\n  padding: 16px;\n  background: var(--va-card, #ffffff);\n  border-radius: 8px;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.va-chart-header {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n}\n\n.va-chart-title {\n  margin: 0;\n  font-size: var(--va-fs-lg, 14px);\n  font-weight: var(--va-fw-semibold, 600);\n  color: var(--va-ink, #1a1917);\n}\n\n.va-chart-summary {\n  display: flex;\n  align-items: baseline;\n  gap: 4px;\n}\n\n.va-chart-max-val {\n  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n  font-size: var(--va-fs-xl, 16px);\n  font-weight: var(--va-fw-bold, 700);\n  color: var(--va-ink, #1a1917);\n}\n\n.va-chart-unit {\n  font-size: var(--va-fs-sm, 12px);\n  color: var(--va-muted, #6f6d66);\n}\n\n/* 柱状图模式 */\n.va-bar-container {\n  display: flex;\n  align-items: flex-end;\n  justify-content: space-between;\n  height: 120px;\n  padding: 12px 4px 0;\n  border-bottom: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  gap: 8px;\n}\n\n.va-bar-col {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  height: 100%;\n  justify-content: flex-end;\n  position: relative;\n}\n\n.va-bar-pill {\n  width: 100%;\n  max-width: 24px;\n  background: var(--va-accent, #c2410c);\n  border-radius: 3px 3px 0 0;\n  min-height: 4px;\n  transition: height var(--va-dur-3, 300ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)), opacity var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n  opacity: 0.85;\n}\n\n.va-bar-col:hover .va-bar-pill {\n  opacity: 1;\n  background: color-mix(in srgb, var(--va-accent, #c2410c) 90%, black);\n}\n\n.va-bar-tooltip {\n  position: absolute;\n  top: -24px;\n  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n  font-size: var(--va-fs-2xs, 10px);\n  color: var(--va-ink-2, #43413c);\n  opacity: 0;\n  transition: opacity var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n  pointer-events: none;\n  white-space: nowrap;\n}\n\n.va-bar-col:hover .va-bar-tooltip {\n  opacity: 1;\n}\n\n.va-bar-labels {\n  display: flex;\n  justify-content: space-between;\n  gap: 8px;\n  padding-top: var(--va-s3h, 6px);\n}\n\n.va-bar-label {\n  flex: 1;\n  text-align: center;\n  font-size: var(--va-fs-xs, 11px);\n  color: var(--va-muted, #6f6d66);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n/* 折线图模式 */\n.va-line-container {\n  width: 100%;\n  height: 120px;\n  position: relative;\n}\n\n.va-line-svg {\n  width: 100%;\n  height: 100%;\n  overflow: visible;\n}\n\n.va-line-path {\n  fill: none;\n  stroke: var(--va-accent, #c2410c);\n  stroke-width: 2.2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.va-line-area {\n  fill: url(#va-line-gradient);\n  opacity: 0.2;\n}\n\n.va-line-dot {\n  fill: var(--va-card, #ffffff);\n  stroke: var(--va-accent, #c2410c);\n  stroke-width: 2;\n  transition: r var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-line-dot:hover {\n  r: 4.5;\n}\n</style>\n"
    },
    {
      "path": "components/ui/metric-chart/index.ts",
      "type": "registry:ui",
      "target": "components/ui/metric-chart/index.ts",
      "content": "export { default as VaMetricChart } from \"./VaMetricChart.vue\";\nexport * from \"./types.js\";\n"
    },
    {
      "path": "components/ui/metric-chart/types.ts",
      "type": "registry:ui",
      "target": "components/ui/metric-chart/types.ts",
      "content": "/**\n * @vuagent/ui - VaMetricChart 类型定义\n */\n\nexport interface MetricSeriesItem {\n  label: string;\n  value: number;\n}\n\nexport interface MetricChartProps {\n  title: string;\n  chartType?: \"line\" | \"bar\";\n  unit?: string;\n  series: MetricSeriesItem[];\n}\n"
    }
  ]
}
