      "content": "/** VaEmptyHero 的类型定义：空会话时的中央引导（选工作区开会话 / 新建工作区） */\n\nexport interface HeroWorkspace {\n  id: string;\n  name: string;\n  /** 目录路径（卡片副标题） */\n  path?: string;\n}\n\nexport interface EmptyHeroProps {\n  workspaces?: HeroWorkspace[];\n  /** 新建工作区进行中（禁用卡片） */\n  creating?: boolean;\n  title?: string;\n  description?: string;\n}\n\nexport interface EmptyHeroEvents {\n  /** 点击虚线「新建工作区」卡（宿主弹原生选择框） */\n  createWorkspace: [];\n  /** 点击某工作区卡 → 在其下创建新会话 */\n  createSession: [workspaceId: string];\n}\n"
    }
