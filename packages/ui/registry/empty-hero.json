{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "empty-hero",
  "title": "Empty Hero",
  "description": "空会话引导：工作区卡片点击即建会话，虚线卡触发新建工作区。",
  "type": "registry:ui",
  "dependencies": [
    "lucide-vue-next"
  ],
  "registryDependencies": [],
  "docs": "- `workspaces` (HeroWorkspace[]，默认 [])：id/name/path\n- `creating` (boolean，默认 false)：创建中禁用\n- `@createSession / @createWorkspace` (-，默认 -)：选卡建会话 / 新建工作区",
  "files": [
    {
      "path": "components/ui/empty-hero/VaEmptyHero.vue",
      "type": "registry:ui",
      "target": "components/ui/empty-hero/VaEmptyHero.vue",
      "content": "<script setup lang=\"ts\">\nimport { FolderClosed, Plus } from \"lucide-vue-next\";\nimport type { EmptyHeroEvents, EmptyHeroProps } from \"./types\";\n\nconst props = withDefaults(defineProps<EmptyHeroProps>(), {\n  workspaces: () => [],\n  creating: false,\n  title: \"开始一个任务\",\n  description: \"选择一个工作区开启会话；agent 的文件读写都限定在其目录内。\",\n});\n\nconst emit = defineEmits<EmptyHeroEvents>();\n</script>\n\n<template>\n  <div class=\"va-hero\">\n    <span class=\"va-hero__mark\" aria-hidden=\"true\" />\n    <h3 class=\"va-hero__title\">{{ props.title }}</h3>\n    <p class=\"va-hero__desc\">{{ props.description }}</p>\n    <div class=\"va-hero__cards\">\n      <button\n        v-for=\"w in props.workspaces\"\n        :key=\"w.id\"\n        class=\"va-hero__card\"\n        type=\"button\"\n        :disabled=\"props.creating\"\n        :title=\"w.path || w.name\"\n        @click=\"emit('createSession', w.id)\"\n      >\n        <FolderClosed :size=\"18\" aria-hidden=\"true\" />\n        <span class=\"va-hero__card-name\">{{ w.name }}</span>\n        <span v-if=\"w.path\" class=\"va-hero__card-path\">{{ w.path }}</span>\n      </button>\n      <button class=\"va-hero__card va-hero__card--new\" type=\"button\" :disabled=\"props.creating\" @click=\"emit('createWorkspace')\">\n        <Plus :size=\"18\" aria-hidden=\"true\" />\n        <span class=\"va-hero__card-name\">新建工作区</span>\n        <span class=\"va-hero__card-path\">弹出系统文件夹选择框</span>\n      </button>\n    </div>\n  </div>\n</template>\n\n<style>\n/* VaEmptyHero — 空会话中央引导 */\n.va-hero {\n  max-width: 560px;\n  margin: auto;\n  padding: 24px;\n  text-align: center;\n  font-family: var(--va-font, system-ui, sans-serif);\n}\n\n.va-hero__mark {\n  display: block;\n  width: 12px;\n  height: 12px;\n  border-radius: 50%;\n  background: var(--va-accent, #c2410c);\n  margin: 0 auto 14px;\n}\n\n.va-hero__title {\n  margin: 0;\n  font-size: 20px;\n  font-weight: 700;\n  color: var(--va-ink, #1a1917);\n}\n\n.va-hero__desc {\n  margin: 6px 0 0;\n  font-size: 13px;\n  line-height: 1.6;\n  color: var(--va-muted, #6f6d66);\n}\n\n.va-hero__cards {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));\n  gap: 10px;\n  margin-top: 22px;\n}\n\n.va-hero__card {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 5px;\n  background: var(--va-card, #fff);\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-m, 10px);\n  padding: 16px 10px;\n  font: inherit;\n  cursor: pointer;\n  box-shadow: var(--va-shadow-1, 0 1px 2px rgba(26, 25, 23, 0.06));\n  min-width: 0;\n}\n.va-hero__card:hover:not(:disabled) { border-color: var(--va-accent, #c2410c); }\n.va-hero__card:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: -2px; }\n.va-hero__card:disabled { opacity: 0.5; cursor: default; }\n.va-hero__card > svg { color: var(--va-accent, #c2410c); }\n\n.va-hero__card-name {\n  font-size: 13px;\n  font-weight: 700;\n  color: var(--va-ink, #1a1917);\n  max-width: 100%;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.va-hero__card-path {\n  font-size: 11px;\n  color: var(--va-muted, #6f6d66);\n  font-family: var(--va-font-mono, ui-monospace, monospace);\n  max-width: 100%;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.va-hero__card--new {\n  border-style: dashed;\n  background: none;\n  box-shadow: none;\n}\n.va-hero__card--new > svg { color: var(--va-muted, #6f6d66); }\n.va-hero__card--new .va-hero__card-name { color: var(--va-ink-2, #43413c); }\n</style>\n"
    },
    {
      "path": "components/ui/empty-hero/types.ts",
      "type": "registry:ui",
      "target": "components/ui/empty-hero/types.ts",
      "content": "/** VaEmptyHero 的类型定义：空会话时的中央引导（选工作区开会话 / 新建工作区） */\n\nexport interface HeroWorkspace {\n  id: string;\n  name: string;\n  /** 目录路径（卡片副标题） */\n  path?: string;\n}\n\nexport interface EmptyHeroProps {\n  workspaces?: HeroWorkspace[];\n  /** 新建工作区进行中（禁用卡片） */\n  creating?: boolean;\n  title?: string;\n  description?: string;\n}\n\nexport interface EmptyHeroEvents {\n  /** 点击虚线「新建工作区」卡（宿主弹原生选择框） */\n  createWorkspace: [];\n  /** 点击某工作区卡 → 在其下创建新会话 */\n  createSession: [workspaceId: string];\n}\n"
    }
  ]
}
