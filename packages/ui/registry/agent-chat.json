{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "agent-chat",
  "title": "Agent Chat",
  "description": "对话页骨架：消息流（用户/agent 气泡 + 工具 chips）、思考态三点、贴底自动滚动、#composer 插槽接 VaComposer。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `messages` (ChatThreadMessage[]，默认 -)：id/role/text/tools\n- `thinking / thinkingLabel` (boolean / string，默认 false / 思考中…)：生成中态\n- `maxHeight` (number，默认 -)：消息区高度（缺省撑满容器）\n- `#composer / #stream-foot` (-，默认 -)：输入区/流尾部插槽",
  "files": [
    {
      "path": "components/ui/agent-chat/VaAgentChat.vue",
      "type": "registry:ui",
      "target": "components/ui/agent-chat/VaAgentChat.vue",
      "content": "<script setup lang=\"ts\">import { nextTick, onMounted, watch, useTemplateRef, getCurrentInstance, onBeforeUnmount, ref, type Ref } from \"vue\";\n\nimport type { AgentChatEvents, AgentChatProps } from \"./types\";\n\nconst props = defineProps<AgentChatProps>();\n\nconst emit = defineEmits<AgentChatEvents>();\n\nconst scrollEl = useTemplateRef<HTMLElement>(\"scroll\");\n\n/** 贴底跟随（库共享 composable）：上翻超阈值解除跟随，流式不再拽底 */\nconst { isPinned: stick, onScroll, scrollToBottom } = useStickToBottom(scrollEl, { threshold: 40 });\n\nwatch(\n  () => [props.messages.length, props.thinking],\n  () => {\n    if (!stick.value) return;\n    nextTick(() => {\n      scrollToBottom();\n      emit(\"scrollToBottom\");\n    });\n  },\n);\n\nonMounted(() => {\n  scrollToBottom({ force: true });\n});\n\nconst initials = (m: { role: string }) => (m.role === \"user\" ? \"你\" : \"A\");\n\n/* ── 内联自 @vuagent/ui src/composables/useStickToBottom.ts（registry 单文件拷贝自包含） ── */\n/**\n * 贴底跟随滚动（stick-to-bottom）：与 VaTerminalLog 的「贴底时跟随，上翻暂停」同一约定。\n *\n * 修复痛点：流式输出期间每个 SSE 数据块都无条件 scrollTop = scrollHeight，\n * 用户上翻查看历史时被持续拽回底部，滚轮与强制滚动互相打架导致「一卡一卡」。\n *\n * 行为契约：\n * - 用户处于底部（距底 < threshold px，默认 64）时，流式内容自动跟随到底；\n * - 用户主动上翻超过阈值后，流式期间不再强制滚动，阅读位置保持稳定；\n * - 用户滚回底部自动恢复跟随；发送消息 / 切换会话等场景走 force 通道强制回底；\n * - 同一帧内的多次调用经 requestAnimationFrame 合并为一次滚动。\n */\n// type 成员必须内联（import { type X }）：registry 共享模块内联器会剥整句 import type 的\n// type 语义，拷出单文件在严格 ESM 宿主会因值导入类型而报错\n\n\n/** 默认距底部多少像素以内视为「贴底」（聊天流内容较高，略宽于终端流的 32px） */\nconst BOTTOM_THRESHOLD_PX = 64;\n\ninterface ScrollToBottomOptions {\n  /** 强制滚到底（用户发送消息 / 切换会话等显式上下文），无视当前钉底状态 */\n  force?: boolean;\n}\n\ninterface UseStickToBottomOptions {\n  /** 距底部多少像素以内视为「贴底」（默认 64；终端流等密集内容可用 32） */\n  threshold?: number;\n}\n\nfunction useStickToBottom(\n  scrollRef: Ref<HTMLElement | null>,\n  options?: UseStickToBottomOptions,\n) {\n  const threshold = options?.threshold ?? BOTTOM_THRESHOLD_PX;\n\n  /** 是否钉在底部（跟随流式输出）；用户上翻超过阈值即解除 */\n  const isPinned = ref(true);\n\n  let rafId: ReturnType<typeof requestAnimationFrame> | null = null;\n  let pendingForce = false;\n\n  /** 依据当前滚动位置重算钉底状态（滚动容器 scroll 事件里调用） */\n  function updatePinned() {\n    const el = scrollRef.value;\n    if (!el) return;\n    isPinned.value = el.scrollHeight - el.scrollTop - el.clientHeight < threshold;\n  }\n\n  /** 滚动事件处理器（模板里 @scroll.passive 绑定） */\n  function onScroll() {\n    updatePinned();\n  }\n\n  /**\n   * 请求滚到底部：默认仅在钉底状态下生效（跟随模式），force 时无条件滚动。\n   * 多次调用在同一帧内合并；rAF 晚于 Vue 的 DOM patch（microtask），\n   * 执行时 scrollHeight 已是流式更新后的最新值。\n   */\n  function scrollToBottom(options?: ScrollToBottomOptions) {\n    if (options?.force) pendingForce = true;\n    if (rafId !== null) return;\n    rafId = requestAnimationFrame(() => {\n      rafId = null;\n      const force = pendingForce;\n      pendingForce = false;\n      if (!force && !isPinned.value) return;\n      const el = scrollRef.value;\n      if (el) el.scrollTop = el.scrollHeight;\n    });\n  }\n\n  function dispose() {\n    if (rafId !== null) {\n      cancelAnimationFrame(rafId);\n      rafId = null;\n      pendingForce = false;\n    }\n  }\n\n  // 仅在组件作用域内注册卸载钩子（单测等非组件环境直接调 dispose）\n  if (getCurrentInstance()) {\n    onBeforeUnmount(dispose);\n  }\n\n  return { isPinned, onScroll, updatePinned, scrollToBottom, dispose };\n}\n</script>\n\n<template>\n  <div class=\"va-chat\">\n    <header v-if=\"props.title\" class=\"va-chat__head\">{{ props.title }}</header>\n\n    <div\n      ref=\"scroll\"\n      class=\"va-chat__stream\"\n      :style=\"props.maxHeight ? { maxHeight: `${props.maxHeight}px` } : undefined\"\n      @scroll=\"onScroll\"\n    >\n      <p v-if=\"!props.messages.length && !props.thinking\" class=\"va-chat__empty va-fade-in\">\n        给 agent 一个任务开始对话。\n      </p>\n\n      <div\n        v-for=\"m in props.messages\"\n        :key=\"m.id\"\n        class=\"va-chat__msg\"\n        :data-role=\"m.role\"\n      >\n        <span class=\"va-chat__avatar\" :data-role=\"m.role\" aria-hidden=\"true\">{{ initials(m) }}</span>\n        <div class=\"va-chat__bubble\">\n          <p class=\"va-chat__text\">{{ m.text }}</p>\n          <span v-if=\"m.tools?.length\" class=\"va-chat__tools\">\n            <span v-for=\"t in m.tools\" :key=\"t\" class=\"va-chat__tool\">{{ t }}</span>\n          </span>\n        </div>\n      </div>\n\n      <div v-if=\"props.thinking\" class=\"va-chat__msg\" data-role=\"agent\">\n        <span class=\"va-chat__avatar\" data-role=\"agent\" aria-hidden=\"true\">A</span>\n        <div class=\"va-chat__bubble va-chat__bubble--thinking\">\n          <span class=\"va-chat__pulse\" aria-hidden=\"true\" /><span class=\"va-chat__pulse\" aria-hidden=\"true\" /><span class=\"va-chat__pulse\" aria-hidden=\"true\" />\n          <span class=\"va-chat__sr\">{{ props.thinkingLabel ?? \"思考中…\" }}</span>\n        </div>\n      </div>\n      <slot name=\"stream-foot\" />\n    </div>\n\n    <footer v-if=\"!props.composerless\" class=\"va-chat__composer\">\n      <slot name=\"composer\">\n        <p class=\"va-chat__composer-hint\">将 VaComposer 放入 #composer 插槽</p>\n      </slot>\n    </footer>\n  </div>\n</template>\n\n<style>\n/* VaAgentChat — agent 对话页骨架 */\n\n.va-chat {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-l, 16px);\n  background: var(--va-card, #ffffff);\n  overflow: hidden;\n}\n\n.va-chat__head {\n  padding: var(--va-s4, 12px) var(--va-s5, 16px);\n  border-bottom: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  background: var(--va-bg-subtle, #efede7);\n  font-size: var(--va-fs-lg, 14px);\n  font-weight: var(--va-fw-bold, 700);\n  color: var(--va-ink, #1a1917);\n}\n\n.va-chat__stream {\n  flex: 1;\n  overflow-y: auto;\n  padding: var(--va-s5, 16px);\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s5, 16px);\n}\n\n.va-chat__empty {\n  margin: auto;\n  font-size: var(--va-fs-md, 13px);\n  color: var(--va-muted, #6f6d66);\n}\n\n.va-chat__msg {\n  display: flex;\n  gap: var(--va-s3, 8px);\n  max-width: 86%;\n}\n\n.va-chat__msg[data-role=\"user\"] { align-self: flex-end; flex-direction: row-reverse; }\n\n.va-chat__avatar {\n  flex: none;\n  width: 30px;\n  height: 30px;\n  border-radius: 50%;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  font-size: var(--va-fs-md, 13px);\n  font-weight: var(--va-fw-bold, 700);\n}\n\n.va-chat__avatar[data-role=\"agent\"] { background: var(--va-accent-soft, rgba(194, 65, 12, 0.1)); color: var(--va-accent, #c2410c); }\n.va-chat__avatar[data-role=\"user\"] { background: var(--va-bg-subtle, #efede7); color: var(--va-ink-2, #43413c); }\n\n.va-chat__bubble {\n  border-radius: var(--va-radius-m, 10px);\n  padding: var(--va-s3, 8px) var(--va-s4, 12px);\n  font-size: var(--va-fs-lg, 14px);\n  line-height: 1.65;\n  min-width: 0;\n}\n\n.va-chat__msg[data-role=\"agent\"] .va-chat__bubble {\n  background: var(--va-bg-subtle, #efede7);\n  color: var(--va-ink, #1a1917);\n  border-top-left-radius: 4px;\n}\n\n.va-chat__msg[data-role=\"user\"] .va-chat__bubble {\n  background: var(--va-ink, #1a1917);\n  color: var(--va-card, #ffffff);\n  border-top-right-radius: 4px;\n}\n\n.va-chat__text { margin: 0; white-space: pre-wrap; word-break: break-word; }\n\n.va-chat__tools {\n  display: flex;\n  gap: var(--va-s2, 4px);\n  flex-wrap: wrap;\n  margin-top: var(--va-s3, 8px);\n}\n\n.va-chat__tool {\n  font-family: var(--va-font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);\n  font-size: var(--va-fs-xs, 11px);\n  padding: 1px 7px;\n  border-radius: var(--va-radius-pill, 999px);\n  background: var(--va-card, #ffffff);\n  color: var(--va-muted, #6f6d66);\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n}\n\n/* 思考态三点 */\n.va-chat__bubble--thinking {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  padding: var(--va-s4, 12px) var(--va-s5, 16px);\n}\n\n.va-chat__pulse {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: var(--va-muted, #6f6d66);\n  animation: va-chat-hop calc(var(--va-dur-loop, 1.8s) * 2 / 3) ease-in-out infinite; /* 1.2s = 底速 × 2/3 */\n}\n\n.va-chat__pulse:nth-child(2) { animation-delay: 0.15s; }\n.va-chat__pulse:nth-child(3) { animation-delay: 0.3s; }\n\n@keyframes va-chat-hop {\n  0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }\n  30% { transform: translateY(-4px); opacity: 1; }\n}\n\n.va-chat__sr {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n}\n\n.va-chat__composer {\n  border-top: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  padding: var(--va-s4, 12px) var(--va-s5, 16px);\n  background: var(--va-bg-subtle, #efede7);\n}\n\n.va-chat__composer-hint {\n  margin: 0;\n  font-size: var(--va-fs-sm, 12px);\n  color: var(--va-muted, #6f6d66);\n  text-align: center;\n  padding: var(--va-s2, 4px);\n  border: 1px dashed var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-s, 8px);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-chat__pulse { animation: none; opacity: 0.7; }\n}\n\n/* 动效工具类（自动附带，源码中来自全局 motion.css） */\n/* ============================================================\n   共享动效工具类 —— 进出场/交叉淡入的统一协议（TASK-102 动效基建）。\n   组件不逐个发明入场曲线：统一消费 --va-dur-in/--va-dur-out 骨架时长与\n   --va-dist-* 位移档；每条声明自带字面 fallback（registry 单文件拷贝分发\n   要求，与 tokens.css 门禁一致）。\n\n   接入方式二选一：\n   1. Vue <Transition>：\n      <Transition enter-active-class=\"va-enter-up\" leave-active-class=\"va-exit-up\">\n      动画 fill-mode 为 both（延迟期间保持首帧、播完停在终态），\n      无需再配 enter-from-class / leave-to-class；\n   2. 类切换重挂载：骨架 → 内容换节点时给新节点挂 .va-crossfade（纯淡入），\n      离场节点挂 .va-exit-*（更短更快）。\n\n   列表错峰：v-for 子项 :style=\"useStagger().delayStyle(i)\" 配合 .va-enter-*\n   动画类使用（animation-delay 由 composable 编排——.va-enter-* 为 CSS animation，\n   transition-delay 对其零作用，见 composables/useStagger.ts）。\n   ============================================================ */\n\n/* 入场：上浮（自下方 --va-dist-m 浮起） */\n@keyframes va-motion-in-up {\n  from { opacity: 0; transform: translateY(var(--va-dist-m, 8px)); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* 入场：左滑（自左侧 --va-dist-m 滑入） */\n@keyframes va-motion-in-left {\n  from { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n  to { opacity: 1; transform: translateX(0); }\n}\n\n/* 入场：缩放（96% 起放大至原尺寸） */\n@keyframes va-motion-in-scale {\n  from { opacity: 0; transform: scale(0.96); }\n  to { opacity: 1; transform: scale(1); }\n}\n\n/* 离场：与入场互逆（向上/向左飘出、缩回）；时长/曲线由工具类映射 --va-dur-out 骨架 */\n@keyframes va-motion-out-up {\n  from { opacity: 1; transform: translateY(0); }\n  to { opacity: 0; transform: translateY(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-left {\n  from { opacity: 1; transform: translateX(0); }\n  to { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-scale {\n  from { opacity: 1; transform: scale(1); }\n  to { opacity: 0; transform: scale(0.96); }\n}\n\n/* 交叉淡入/淡出（.va-crossfade 骨架→内容交换专用，无位移，避免占位跳变叠加） */\n@keyframes va-motion-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes va-motion-fade-out {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n/* ---- 工具类：入场走 --va-dur-in + ease-out-quart，离场走 --va-dur-out + ease-in-quad ---- */\n\n.va-enter-up {\n  animation: va-motion-in-up var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-left {\n  animation: va-motion-in-left var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-scale {\n  animation: va-motion-in-scale var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-exit-up {\n  animation: va-motion-out-up var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-left {\n  animation: va-motion-out-left var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-scale {\n  animation: va-motion-out-scale var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n/* 骨架 → 内容交叉过渡：新内容纯淡入 */\n.va-crossfade {\n  animation: va-motion-fade-in var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* 空态/轻量状态渐入（TASK-106 弱化档）：仅 opacity、时长走 --va-dur-2，\n   供列表空态提示与一次性状态块使用（空态清单见 TASK-106 报告）。\n   纯 opacity 即动效分频策略的降级终点形态，reduced-motion 下保持原样即可。 */\n.va-fade-in {\n  animation: va-motion-fade-in var(--va-dur-2, 200ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* ---- 静态光斑基类（TASK-105，决策 5「追光」路线基建）----\n   pointer 坐标由 composables/useSpotlight.ts 以 rAF 节流写入 --va-spot-x/y\n   （元素内百分比，光斑数学在 composable 内可单测）；本类只负责 radial 光斑\n   绘制与显隐（:hover 点亮，无 3D 倾斜， glare 数学对齐 VaTiltCard）。\n   --va-spot-* 为 L3 组件钩子口径（宿主可覆盖尺寸/颜色），不进 tokens.css。\n   双降级对齐 VaTiltCard glare：hover: none（触屏）与 reduced-motion 不绘制。 */\n.va-spotlight { position: relative; }\n\n/* ::after 承载光斑（避开组件自身 ::before 用途）；inset 0 + border-radius inherit\n   使光斑天然裁剪在宿主圆角内，无需 overflow: hidden。\n   注意：此 ::after radial 与 components/spotlight-card/VaSpotlightCard.css 的\n   .va-spot-card--spot::after 为 registry 单文件自含有意复制，改动需两处同步。 */\n.va-spotlight::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n  background: radial-gradient(\n    var(--va-spot-size, 240px) circle at var(--va-spot-x, 50%) var(--va-spot-y, 50%),\n    var(--va-spot-color, rgba(255, 255, 255, 0.14)),\n    transparent 65%\n  );\n}\n\n.va-spotlight:hover::after { opacity: 1; }\n\n@media (hover: none) {\n  .va-spotlight::after { display: none; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-spotlight::after { display: none; }\n}\n\n/* ---- 复制反馈标准（TASK-106）：copy→check 交叉过渡 ----\n   容器 .va-copy 为 inline-grid 双内容同格堆叠（格子宽取较宽子项，切换零跳动）：\n   __idle = copy 态内容（图标/文字），__done = check 态内容。\n   copied 置真挂 .va-copy--done：check 以 ease-spring 微弹入场（进入 done 态时\n   transform 的目标态时序换成 --va-ease-spring → 过冲回弹），交叉时长统一 --va-dur-1。\n   消费方：terminal-log（行复制）、code-diff（复制按钮）、message-actions（复制图标）。 */\n.va-copy { display: inline-grid; place-items: center; }\n\n.va-copy__idle,\n.va-copy__done {\n  grid-area: 1 / 1;\n  transition: opacity var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-copy__idle { opacity: 1; transform: scale(1); }\n.va-copy__done { opacity: 0; transform: scale(0.6); }\n\n.va-copy--done .va-copy__done {\n  opacity: 1;\n  transform: scale(1);\n  /* 时序按 transition 属性顺序映射：opacity 仍 ease，transform 换 ease-spring 微弹 */\n  transition-timing-function: var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), var(--va-ease-spring, cubic-bezier(0.34, 1.56, 0.64, 1));\n}\n\n.va-copy--done .va-copy__idle { opacity: 0; transform: scale(0.6); }\n\n@media (prefers-reduced-motion: reduce) {\n  /* 交叉过渡瞬时完成（无位移动画），copied 状态可感知性不受影响 */\n  .va-copy__idle,\n  .va-copy__done { transition: none; }\n}\n\n/* ---- 错误反馈标准（校验失败横向微振）：目标元素挂 .va-shake 播一次 ±3px 微振 ----\n   时长 --va-dur-2 × 2（两拍四峰，克制的「摇头」量级，rubric 校验失败口径）；\n   重复触发需先移除类、强制 reflow 再挂回（封装见 composables/useShake.ts）。\n   reduced-motion 降级为不播：错误状态的可感知性由错误样式本身（描边/文案）承担，\n   动效只做注意力引导——符合头注释「功能动画降级保留状态可感知」的分频策略。\n   消费方：VaStepperForm / VaOtpInput 经 useShake() 程序化触发（defineExpose shake()）；\n   宿主自绘表单可直接挂类。 */\n@keyframes va-motion-shake {\n  20% { transform: translateX(-3px); }\n  40% { transform: translateX(3px); }\n  60% { transform: translateX(-2px); }\n  80% { transform: translateX(2px); }\n}\n\n.va-shake {\n  animation: va-motion-shake calc(var(--va-dur-2, 200ms) * 2) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-shake { animation: none; }\n}\n\n/* ---- 动效分频（对齐 tokens.css 头注释策略）：\n   功能动画降级为纯 opacity——进/出场整体换成 fade keyframes，\n   位移/缩放不再出现（animation-name 顶替，时长/缓动沿用上面的声明）。 */\n@media (prefers-reduced-motion: reduce) {\n  .va-enter-up,\n  .va-enter-left,\n  .va-enter-scale,\n  .va-crossfade {\n    animation-name: va-motion-fade-in;\n  }\n\n  .va-exit-up,\n  .va-exit-left,\n  .va-exit-scale {\n    animation-name: va-motion-fade-out;\n  }\n}\n</style>\n"
