{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "agent-chat",
  "title": "Agent Chat",
  "description": "对话页骨架：消息流（用户/agent 气泡 + 工具 chips）、思考态三点、贴底自动滚动、#composer 插槽接 VaComposer。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `messages` (ChatMessage[]，默认 -)：id/role/text/tools\n- `thinking / thinkingLabel` (boolean / string，默认 false / 思考中…)：生成中态\n- `maxHeight` (number，默认 -)：消息区高度（缺省撑满容器）\n- `#composer / #stream-foot` (-，默认 -)：输入区/流尾部插槽",
  "files": [
    {
      "path": "components/ui/agent-chat/VaAgentChat.vue",
      "type": "registry:ui",
      "target": "components/ui/agent-chat/VaAgentChat.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, nextTick, onMounted, ref, watch, useTemplateRef } from \"vue\";\nimport type { AgentChatEvents, AgentChatProps } from \"./types\";\n\nconst props = defineProps<AgentChatProps>();\n\nconst emit = defineEmits<AgentChatEvents>();\n\nconst scrollEl = useTemplateRef<HTMLElement>(\"scroll\");\n\nconst stick = ref(true);\nfunction onScroll() {\n  const el = scrollEl.value;\n  if (!el) return;\n  stick.value = el.scrollTop + el.clientHeight >= el.scrollHeight - 40;\n}\n\nwatch(\n  () => [props.messages.length, props.thinking],\n  () => {\n    if (!stick.value) return;\n    nextTick(() => {\n      const el = scrollEl.value;\n      if (el) el.scrollTop = el.scrollHeight;\n      emit(\"scrollToBottom\");\n    });\n  },\n);\n\nonMounted(() => {\n  const el = scrollEl.value;\n  if (el) el.scrollTop = el.scrollHeight;\n});\n\nconst initials = (m: { role: string }) => (m.role === \"user\" ? \"你\" : \"A\");\n</script>\n\n<template>\n  <div class=\"va-chat\">\n    <header v-if=\"props.title\" class=\"va-chat__head\">{{ props.title }}</header>\n\n    <div\n      ref=\"scroll\"\n      class=\"va-chat__stream\"\n      :style=\"props.maxHeight ? { maxHeight: `${props.maxHeight}px` } : undefined\"\n      @scroll=\"onScroll\"\n    >\n      <p v-if=\"!props.messages.length && !props.thinking\" class=\"va-chat__empty\">\n        给 agent 一个任务开始对话。\n      </p>\n\n      <div\n        v-for=\"m in props.messages\"\n        :key=\"m.id\"\n        class=\"va-chat__msg\"\n        :data-role=\"m.role\"\n      >\n        <span class=\"va-chat__avatar\" :data-role=\"m.role\" aria-hidden=\"true\">{{ initials(m) }}</span>\n        <div class=\"va-chat__bubble\">\n          <p class=\"va-chat__text\">{{ m.text }}</p>\n          <span v-if=\"m.tools?.length\" class=\"va-chat__tools\">\n            <span v-for=\"t in m.tools\" :key=\"t\" class=\"va-chat__tool\">{{ t }}</span>\n          </span>\n        </div>\n      </div>\n\n      <div v-if=\"props.thinking\" class=\"va-chat__msg\" data-role=\"agent\">\n        <span class=\"va-chat__avatar\" data-role=\"agent\" aria-hidden=\"true\">A</span>\n        <div class=\"va-chat__bubble va-chat__bubble--thinking\">\n          <span class=\"va-chat__pulse\" aria-hidden=\"true\" /><span class=\"va-chat__pulse\" aria-hidden=\"true\" /><span class=\"va-chat__pulse\" aria-hidden=\"true\" />\n          <span class=\"va-chat__sr\">{{ props.thinkingLabel ?? \"思考中…\" }}</span>\n        </div>\n      </div>\n      <slot name=\"stream-foot\" />\n    </div>\n\n    <footer v-if=\"!props.composerless\" class=\"va-chat__composer\">\n      <slot name=\"composer\">\n        <p class=\"va-chat__composer-hint\">将 VaComposer 放入 #composer 插槽</p>\n      </slot>\n    </footer>\n  </div>\n</template>\n\n<style>\n/* VaAgentChat — agent 对话页骨架 */\n\n.va-chat {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-l);\n  background: var(--va-card);\n  overflow: hidden;\n}\n\n.va-chat__head {\n  padding: var(--va-s4) var(--va-s5);\n  border-bottom: 1px solid var(--va-edge);\n  background: var(--va-bg-subtle);\n  font-size: 14px;\n  font-weight: 700;\n  color: var(--va-ink);\n}\n\n.va-chat__stream {\n  flex: 1;\n  overflow-y: auto;\n  padding: var(--va-s5);\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s5);\n}\n\n.va-chat__empty {\n  margin: auto;\n  font-size: 13px;\n  color: var(--va-muted);\n}\n\n.va-chat__msg {\n  display: flex;\n  gap: var(--va-s3);\n  max-width: 86%;\n}\n\n.va-chat__msg[data-role=\"user\"] { align-self: flex-end; flex-direction: row-reverse; }\n\n.va-chat__avatar {\n  flex: none;\n  width: 30px;\n  height: 30px;\n  border-radius: 50%;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 12.5px;\n  font-weight: 700;\n}\n\n.va-chat__avatar[data-role=\"agent\"] { background: var(--va-accent-soft); color: var(--va-accent); }\n.va-chat__avatar[data-role=\"user\"] { background: var(--va-bg-subtle); color: var(--va-ink-2); }\n\n.va-chat__bubble {\n  border-radius: var(--va-radius-m);\n  padding: var(--va-s3) var(--va-s4);\n  font-size: 13.5px;\n  line-height: 1.65;\n  min-width: 0;\n}\n\n.va-chat__msg[data-role=\"agent\"] .va-chat__bubble {\n  background: var(--va-bg-subtle);\n  color: var(--va-ink);\n  border-top-left-radius: 4px;\n}\n\n.va-chat__msg[data-role=\"user\"] .va-chat__bubble {\n  background: var(--va-ink);\n  color: var(--va-card);\n  border-top-right-radius: 4px;\n}\n\n.va-chat__text { margin: 0; white-space: pre-wrap; word-break: break-word; }\n\n.va-chat__tools {\n  display: flex;\n  gap: var(--va-s2);\n  flex-wrap: wrap;\n  margin-top: var(--va-s3);\n}\n\n.va-chat__tool {\n  font-family: var(--va-font-mono);\n  font-size: 10.5px;\n  padding: 1px 7px;\n  border-radius: var(--va-radius-pill);\n  background: var(--va-card);\n  color: var(--va-muted);\n  border: 1px solid var(--va-edge);\n}\n\n/* 思考态三点 */\n.va-chat__bubble--thinking {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  padding: var(--va-s4) var(--va-s5);\n}\n\n.va-chat__pulse {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: var(--va-muted);\n  animation: va-chat-hop 1.2s ease-in-out infinite;\n}\n\n.va-chat__pulse:nth-child(2) { animation-delay: 0.15s; }\n.va-chat__pulse:nth-child(3) { animation-delay: 0.3s; }\n\n@keyframes va-chat-hop {\n  0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }\n  30% { transform: translateY(-4px); opacity: 1; }\n}\n\n.va-chat__sr {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n}\n\n.va-chat__composer {\n  border-top: 1px solid var(--va-edge);\n  padding: var(--va-s4) var(--va-s5);\n  background: var(--va-bg-subtle);\n}\n\n.va-chat__composer-hint {\n  margin: 0;\n  font-size: 12px;\n  color: var(--va-muted);\n  text-align: center;\n  padding: var(--va-s2);\n  border: 1px dashed var(--va-edge);\n  border-radius: var(--va-radius-s);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-chat__pulse { animation: none; opacity: 0.7; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/agent-chat/types.ts",
      "type": "registry:ui",
      "target": "components/ui/agent-chat/types.ts",
      "content": "/** VaAgentChat 的类型定义 */\n\nexport interface ChatMessage {\n  id: string;\n  role: \"user\" | \"agent\";\n  text: string;\n  /** ms 时间戳 */\n  createdAt?: number;\n  /** agent 消息附带的工具调用名列表（chips 展示） */\n  tools?: string[];\n}\n\nexport interface AgentChatProps {\n  messages: ChatMessage[];\n  /** agent 思考/生成中：消息流底部挂思考态 */\n  thinking?: boolean;\n  /** 思考文案（交给宿主传 ThinkingLoader 场景文案），默认\"思考中…\" */\n  thinkingLabel?: string;\n  /** 标题栏文案 */\n  title?: string;\n  /** 底部输入区换成具名插槽时隐藏内置占位 */\n  composerless?: boolean;\n  /** 消息区最大高度（缺省随容器滚动） */\n  maxHeight?: number;\n}\n\nexport interface AgentChatEvents {\n  /** 底部发送（组件不含输入逻辑，宿主自行接 Composer） */\n  scrollToBottom: [];\n}\n"
    }
  ]
}
