{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "illustrations",
  "title": "Voice Orb / Agent Team / Model Wheel",
  "description": "插画三件：VoiceOrb 语音球（idle/listening/speaking 三态波纹与声浪）；AgentTeam 环形悬浮徽标阵；ModelWheel 模型轮盘（缓慢自转）。纯装饰、reduced-motion 全降级。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `state` (\"idle\" | \"listening\" | \"speaking\"，默认 \"idle\")：VoiceOrb：语音状态\n- `size / color` (number / string，默认 96 / accent)：VoiceOrb：尺寸与主色\n- `agents / models` (Array<{id,name}>，默认 -)：Team/Wheel：徽标名单\n- `floating / spinning` (boolean / boolean，默认 true / true)：Team 悬浮 / Wheel 自转",
  "files": [
    {
      "path": "components/ui/illustrations/VaAgentTeam.vue",
      "type": "registry:ui",
      "target": "components/ui/illustrations/VaAgentTeam.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from \"vue\";\nimport type { AgentTeamProps } from \"./types\";\n\nconst props = defineProps<AgentTeamProps>();\n\nconst size = computed(() => props.size ?? 180);\n\n/** 环形排布角度（deg） */\nconst seatOf = (i: number, total: number) => (total <= 1 ? 0 : (360 / total) * i - 90);\nconst initials = (name: string) => name.slice(0, 1).toUpperCase();\n</script>\n\n<template>\n  <div\n    class=\"va-team\"\n    :class=\"{ 'va-team--float': props.floating !== false }\"\n    :style=\"{ width: `${size}px`, height: `${size}px` }\"\n    role=\"img\"\n    :aria-label=\"`agent 团队：${props.agents.map((a) => a.name).join('、')}`\"\n  >\n    <span class=\"va-team__hub\" aria-hidden=\"true\">✦</span>\n    <span\n      v-for=\"(a, i) in props.agents\"\n      :key=\"a.id\"\n      class=\"va-team__seat\"\n      :style=\"{ transform: `rotate(${seatOf(i, props.agents.length)}deg) translate(${size / 2 - 22}px) rotate(${-seatOf(i, props.agents.length)}deg)`, animationDelay: `${i * 0.4}s` }\"\n    >\n      <span class=\"va-team__chip\">{{ initials(a.name) }}</span>\n    </span>\n  </div>\n</template>\n\n<style>\n/* VaAgentTeam — agent 团队环形插画 */\n\n.va-team {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.va-team__hub {\n  width: 44px;\n  height: 44px;\n  border-radius: 50%;\n  background: var(--va-accent-soft);\n  color: var(--va-accent);\n  font-size: 18px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1;\n}\n\n.va-team__seat {\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  margin: -19px 0 0 -19px;\n}\n\n.va-team__chip {\n  width: 38px;\n  height: 38px;\n  border-radius: 50%;\n  border: 2px solid var(--va-card);\n  background: var(--va-bg-subtle);\n  color: var(--va-ink-2);\n  font-size: 14px;\n  font-weight: 700;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  box-shadow: var(--va-shadow-1);\n}\n\n.va-team--float .va-team__seat { animation: va-team-float 3.2s ease-in-out infinite; }\n\n@keyframes va-team-float {\n  0%, 100% { margin-top: -19px; }\n  50% { margin-top: -23px; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-team--float .va-team__seat { animation: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/illustrations/VaModelWheel.vue",
      "type": "registry:ui",
      "target": "components/ui/illustrations/VaModelWheel.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from \"vue\";\nimport type { ModelWheelProps } from \"./types\";\n\nconst props = defineProps<ModelWheelProps>();\n\nconst size = computed(() => props.size ?? 200);\n\nconst seatOf = (i: number, total: number) => (total <= 1 ? 0 : (360 / total) * i - 90);\nconst initials = (name: string) => name.slice(0, 1).toUpperCase();\n</script>\n\n<template>\n  <div\n    class=\"va-wheel\"\n    :style=\"{ width: `${size}px`, height: `${size}px` }\"\n    role=\"img\"\n    :aria-label=\"`模型轮盘：${props.models.map((m) => m.name).join('、')}`\"\n  >\n    <div class=\"va-wheel__ring\" :class=\"{ 'va-wheel__ring--spin': props.spinning !== false }\">\n      <span\n        v-for=\"(m, i) in props.models\"\n        :key=\"m.id\"\n        class=\"va-wheel__seat\"\n        :style=\"{ transform: `rotate(${seatOf(i, props.models.length)}deg) translate(${size / 2 - 26}px) rotate(${-seatOf(i, props.models.length)}deg)` }\"\n      >\n        <span class=\"va-wheel__chip\" :title=\"m.name\">{{ initials(m.name) }}</span>\n      </span>\n    </div>\n    <span v-if=\"props.centerLabel\" class=\"va-wheel__center\">{{ props.centerLabel }}</span>\n  </div>\n</template>\n\n<style>\n/* VaModelWheel — 模型轮盘插画（徽标环 + 缓慢自转） */\n\n.va-wheel {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.va-wheel__ring {\n  position: absolute;\n  inset: 26px;\n  border: 1.5px dashed var(--va-edge-strong);\n  border-radius: 50%;\n}\n\n.va-wheel__ring--spin { animation: va-wheel-spin 36s linear infinite; }\n\n@keyframes va-wheel-spin {\n  to { transform: rotate(360deg); }\n}\n\n.va-wheel__seat {\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  margin: -18px 0 0 -18px;\n}\n\n.va-wheel__chip {\n  width: 36px;\n  height: 36px;\n  border-radius: 50%;\n  background: var(--va-card);\n  border: 1px solid var(--va-edge);\n  color: var(--va-ink-2);\n  font-size: 13px;\n  font-weight: 700;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  box-shadow: var(--va-shadow-1);\n}\n\n.va-wheel__center {\n  font-size: 12.5px;\n  font-weight: 700;\n  color: var(--va-accent);\n  background: var(--va-accent-soft);\n  border-radius: var(--va-radius-pill);\n  padding: 4px 14px;\n  z-index: 1;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-wheel__ring--spin { animation: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/illustrations/VaVoiceOrb.vue",
      "type": "registry:ui",
      "target": "components/ui/illustrations/VaVoiceOrb.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from \"vue\";\nimport type { VoiceOrbProps } from \"./types\";\n\nconst props = defineProps<VoiceOrbProps>();\n\nconst size = computed(() => props.size ?? 96);\nconst color = computed(() => props.color ?? \"var(--va-accent)\");\n\nconst STATE_LABEL = { idle: \"待命\", listening: \"聆听中\", speaking: \"说话中\" } as const;\n</script>\n\n<template>\n  <div\n    class=\"va-orb\"\n    :class=\"`va-orb--${props.state ?? 'idle'}`\"\n    :style=\"{ width: `${size}px`, height: `${size}px`, '--va-orb-c': color }\"\n    role=\"img\"\n    :aria-label=\"`语音助手：${STATE_LABEL[props.state ?? 'idle']}`\"\n  >\n    <span class=\"va-orb__wave va-orb__wave--1\" aria-hidden=\"true\" />\n    <span class=\"va-orb__wave va-orb__wave--2\" aria-hidden=\"true\" />\n    <span class=\"va-orb__core\" aria-hidden=\"true\">\n      <span class=\"va-orb__bar\" /><span class=\"va-orb__bar\" /><span class=\"va-orb__bar\" /><span class=\"va-orb__bar\" />\n    </span>\n  </div>\n</template>\n\n<style>\n/* VaVoiceOrb — 语音球插画（idle 静息 / listening 微波 / speaking 声浪） */\n\n.va-orb {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.va-orb__wave {\n  position: absolute;\n  inset: 0;\n  border-radius: 50%;\n  border: 1.5px solid var(--va-orb-c, var(--va-accent));\n  opacity: 0.25;\n}\n\n.va-orb--listening .va-orb__wave--1 { animation: va-orb-ripple 2.4s ease-out infinite; }\n.va-orb--listening .va-orb__wave--2 { animation: va-orb-ripple 2.4s ease-out 1.2s infinite; }\n\n@keyframes va-orb-ripple {\n  from { transform: scale(1); opacity: 0.4; }\n  to { transform: scale(1.55); opacity: 0; }\n}\n\n.va-orb__core {\n  position: relative;\n  width: 58%;\n  height: 58%;\n  border-radius: 50%;\n  background: radial-gradient(circle at 32% 28%, color-mix(in srgb, var(--va-orb-c, var(--va-accent)) 88%, #fff 12%), var(--va-orb-c, var(--va-accent)));\n  box-shadow: 0 8px 24px color-mix(in srgb, var(--va-orb-c, var(--va-accent)) 40%, transparent);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 7%;\n  animation: va-orb-breathe 3.4s ease-in-out infinite;\n}\n\n@keyframes va-orb-breathe {\n  0%, 100% { transform: scale(1); }\n  50% { transform: scale(1.06); }\n}\n\n/* 声浪条 */\n.va-orb__bar {\n  width: 8%;\n  height: 26%;\n  border-radius: 999px;\n  background: rgba(255, 255, 255, 0.92);\n}\n\n.va-orb--speaking .va-orb__bar { animation: va-orb-eq 0.9s ease-in-out infinite; }\n.va-orb--speaking .va-orb__bar:nth-child(2) { animation-delay: 0.18s; }\n.va-orb--speaking .va-orb__bar:nth-child(3) { animation-delay: 0.36s; }\n.va-orb--speaking .va-orb__bar:nth-child(4) { animation-delay: 0.54s; }\n\n@keyframes va-orb-eq {\n  0%, 100% { height: 22%; }\n  50% { height: 54%; }\n}\n\n/* idle：声浪条静息成低条 */\n.va-orb--idle .va-orb__bar { height: 14%; opacity: 0.7; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-orb__core,\n  .va-orb__wave,\n  .va-orb__bar { animation: none !important; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/illustrations/types.ts",
      "type": "registry:ui",
      "target": "components/ui/illustrations/types.ts",
      "content": "/** 插画三件的类型定义（VaVoiceOrb / VaAgentTeam / VaModelWheel） */\n\nexport type VoiceState = \"idle\" | \"listening\" | \"speaking\";\n\nexport interface VoiceOrbProps {\n  state?: VoiceState;\n  /** 直径 px（默认 96） */\n  size?: number;\n  /** 主色（默认 accent） */\n  color?: string;\n}\n\nexport interface AgentTeamProps {\n  /** agent 名字列表（取首字母徽标） */\n  agents: Array<{ id: string; name: string }>;\n  /** 环直径 px（默认 180） */\n  size?: number;\n  /** 悬浮动画（默认 true） */\n  floating?: boolean;\n}\n\nexport interface ModelWheelProps {\n  /** 模型名列表（取首字母徽标，环形排布） */\n  models: Array<{ id: string; name: string }>;\n  /** 直径 px（默认 200） */\n  size?: number;\n  /** 缓慢自转（默认 true） */\n  spinning?: boolean;\n  /** 中心文案 */\n  centerLabel?: string;\n}\n"
    }
  ]
}
