  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `position` (\"bottom-right\" | \"top-center\"，默认 \"bottom-right\")：堆叠位置\n- `vaToaster.add()` (-，默认 -)：{ title, description?, kind?, duration? }",
  "files": [
    {
      "path": "components/ui/toaster/VaToaster.vue",
      "type": "registry:ui",
      "target": "components/ui/toaster/VaToaster.vue",
      "content": "<script setup lang=\"ts\">\nimport type { ToasterProps } from \"./types\";\nimport { vaToaster } from \"./store\";\n\nwithDefaults(defineProps<ToasterProps>(), { position: \"bottom-right\" });\n</script>\n\n<template>\n  <div class=\"va-toast\" :class=\"`va-toast--${position}`\" aria-live=\"polite\" role=\"status\">\n    <TransitionGroup name=\"va-toast\">\n      <div v-for=\"t in vaToaster.state.toasts\" :key=\"t.id\" class=\"va-toast__item\" :data-kind=\"t.kind\">\n        <span class=\"va-toast__icon\" aria-hidden=\"true\">\n          <svg v-if=\"t.kind === 'success'\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><path d=\"M5.5 12.5l4 4L18.5 8\" /></svg>\n          <svg v-else-if=\"t.kind === 'danger'\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\" /><path d=\"M12 8v4.5M12 16h.01\" /></svg>\n          <svg v-else-if=\"t.kind === 'warning'\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><path d=\"M12 9v4M12 16.5h.01M10.3 3.9 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z\" /></svg>\n          <svg v-else viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\" /><path d=\"M12 11v5M12 8h.01\" /></svg>\n        </span>\n        <div class=\"va-toast__body\">\n          <p class=\"va-toast__title\">{{ t.title }}</p>\n          <p v-if=\"t.description\" class=\"va-toast__desc\">{{ t.description }}</p>\n        </div>\n        <button class=\"va-toast__close\" type=\"button\" aria-label=\"关闭通知\" @click=\"vaToaster.dismiss(t.id)\">×</button>\n      </div>\n    </TransitionGroup>\n  </div>\n</template>\n\n<style>\n/* VaToaster — 全局通知堆叠 */\n.va-toast {\n  position: fixed;\n  z-index: 1000;\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s2, 4px);\n  pointer-events: none;\n}\n.va-toast--bottom-right { right: var(--va-s5, 16px); bottom: var(--va-s5, 16px); }\n.va-toast--top-center { top: var(--va-s5, 16px); left: 50%; transform: translateX(-50%); align-items: center; }\n\n.va-toast__item {\n  --_ink: var(--va-toast-ink, var(--va-ink, #1a1917));\n  display: flex;\n  align-items: flex-start;\n  gap: var(--va-s3, 8px);\n  min-width: 260px;\n  max-width: 360px;\n  padding: var(--va-s3, 8px) var(--va-s4, 12px);\n  background: var(--va-ink, #1a1917);\n  color: var(--va-card, #fff);\n  border-radius: var(--va-radius-m, 10px);\n  box-shadow: var(--va-shadow-3, none);\n  pointer-events: auto;\n  font-family: var(--va-font, system-ui, sans-serif);\n}\n\n.va-toast__icon {\n  flex: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 18px;\n  height: 18px;\n  margin-top: 1px;\n  color: var(--va-info, #7ab0f5);\n}\n.va-toast__icon svg { width: 16px; height: 16px; }\n.va-toast__item[data-kind=\"success\"] .va-toast__icon { color: var(--va-success, #4cc38a); }\n.va-toast__item[data-kind=\"warning\"] .va-toast__icon { color: var(--va-warning, #e5a53a); }\n.va-toast__item[data-kind=\"danger\"] .va-toast__icon { color: var(--va-danger, #f07168); }\n\n.va-toast__body { flex: 1; min-width: 0; }\n.va-toast__title { margin: 0; font-size: 13px; font-weight: 600; color: inherit; }\n.va-toast__desc { margin: 2px 0 0; font-size: 12px; opacity: 0.75; }\n\n.va-toast__close {\n  flex: none;\n  width: 18px;\n  height: 18px;\n  border: 0;\n  border-radius: var(--va-radius-s, 8px);\n  background: none;\n  color: inherit;\n  opacity: 0.6;\n  cursor: pointer;\n  font-size: 13px;\n  line-height: 1;\n  padding: 0;\n}\n.va-toast__close:hover { opacity: 1; }\n.va-toast__close:focus-visible { outline: 2px solid currentColor; }\n\n/* 进出 */\n.va-toast-enter-active, .va-toast-leave-active { transition: opacity var(--va-dur-2, 200ms) ease, transform var(--va-dur-2, 200ms) var(--va-ease, ease); }\n.va-toast-enter-from { opacity: 0; transform: translateY(8px); }\n.va-toast-leave-to { opacity: 0; transform: translateY(4px); }\n.va-toast-move { transition: transform var(--va-dur-3, 300ms) var(--va-ease, ease); }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-toast-enter-active, .va-toast-leave-active, .va-toast-move { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/toaster/store.ts",
      "type": "registry:ui",
      "target": "components/ui/toaster/store.ts",
      "content": "import { reactive } from \"vue\";\nimport type { ToastInput, ToastItem, ToastKind } from \"./types\";\n\n/** 全局通知 store：任意位置调用 vaToaster.add()，宿主 <VaToaster /> 负责渲染 */\nconst state = reactive<{ toasts: ToastItem[] }>({ toasts: [] });\nlet uid = 0;\n\nfunction dismiss(id: number) {\n  const i = state.toasts.findIndex((t) => t.id === id);\n  if (i >= 0) state.toasts.splice(i, 1);\n}\n\nfunction add(input: ToastInput): number {\n  const item: ToastItem = {\n    id: ++uid,\n    kind: \"info\" as ToastKind,\n    duration: 4200,\n    ...input,\n  };\n  state.toasts.push(item);\n  if (item.duration > 0 && typeof window !== \"undefined\") {\n    window.setTimeout(() => dismiss(item.id), item.duration);\n  }\n  return item.id;\n}\n\nexport const vaToaster = {\n  /** 通知列表（reactive，只读使用） */\n  state,\n  /** 发一条通知，返回 id */\n  add,\n  /** 手动关闭 */\n  dismiss,\n};\n\n/** 组合式别名，与 vaToaster 等价 */\nexport function useToaster() {\n  return vaToaster;\n}\n"
    },
    {
      "path": "components/ui/toaster/types.ts",
      "type": "registry:ui",
      "target": "components/ui/toaster/types.ts",
      "content": "/** VaToaster 的类型定义 */\n\nexport type ToastKind = \"info\" | \"success\" | \"warning\" | \"danger\";\n\nexport interface ToastInput {\n  title: string;\n  description?: string;\n  kind?: ToastKind;\n  /** 自动消失毫秒数；0 表示不自动消失。默认 4200 */\n  duration?: number;\n}\n\nexport interface ToastItem extends ToastInput {\n  kind: ToastKind;\n  duration: number;\n  id: number;\n}\n\nexport interface ToasterProps {\n  position?: \"bottom-right\" | \"top-center\";\n}\n"
    }
  ]
}
