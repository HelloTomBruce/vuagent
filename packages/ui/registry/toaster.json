{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "toaster",
  "title": "Toaster",
  "description": "全局通知：vaToaster.add() 任意位置发通知，宿主组件渲染堆叠，自动消失可手动关。",
