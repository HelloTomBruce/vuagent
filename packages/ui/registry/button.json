{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "button",
  "title": "Button",
  "description": "语义按钮：四变体 × 三尺寸，加载态标签微光。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `variant` (\"primary\" | \"secondary\" | \"ghost\" | \"destructive\"，默认 \"primary\")：语义变体\n- `size` (\"sm\" | \"md\" | \"lg\"，默认 \"md\")：尺寸\n- `loading` (boolean，默认 false)：加载态并阻止点击",
  "files": [
    {
      "path": "components/ui/button/VaButton.vue",
      "type": "registry:ui",
      "target": "components/ui/button/VaButton.vue",
      "content": "<script setup lang=\"ts\">\nimport { withDefaults } from \"vue\";\nimport type { ButtonProps } from \"./types\";\n\nwithDefaults(defineProps<ButtonProps>(), {\n  variant: \"primary\",\n  size: \"md\",\n  type: \"button\",\n  disabled: false,\n  loading: false,\n  block: false,\n});\n\ndefineSlots<{\n  default?: () => unknown;\n  icon?: () => unknown;\n  \"icon-right\"?: () => unknown;\n}>();\n</script>\n\n<template>\n  <button\n    class=\"va-btn\"\n    :class=\"[`va-btn--${variant}`, `va-btn--${size}`, { 'va-btn--block': block, 'va-btn--loading': loading }]\"\n    :type=\"type\"\n    :disabled=\"disabled || loading\"\n    :aria-busy=\"loading || undefined\"\n  >\n    <span v-if=\"$slots.icon\" class=\"va-btn__icon\"><slot name=\"icon\" /></span>\n    <span v-if=\"$slots.default\" class=\"va-btn__label\"><slot /></span>\n    <span v-if=\"$slots['icon-right']\" class=\"va-btn__icon\"><slot name=\"icon-right\" /></span>\n  </button>\n</template>\n\n<style>\n/* VaButton — 四变体 × 三尺寸 + 加载微光 */\n.va-btn {\n  /* 局部覆盖变量（全部带 fallback，单文件拷走可用） */\n  --_ink: var(--va-btn-ink, var(--va-ink, #1a1917));\n  --_card: var(--va-btn-card, var(--va-card, #ffffff));\n  --_edge: var(--va-btn-edge, var(--va-edge, rgba(26, 25, 23, 0.12)));\n  --_danger: var(--va-btn-danger, var(--va-danger, #d5453c));\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--va-s3, 8px);\n  border: 1px solid transparent;\n  border-radius: var(--va-radius-m, 10px);\n  font-family: var(--va-font, system-ui, sans-serif);\n  font-weight: 500;\n  line-height: 1;\n  cursor: pointer;\n  user-select: none;\n  white-space: nowrap;\n  text-decoration: none;\n  -webkit-tap-highlight-color: transparent;\n  transition:\n    background var(--va-dur-2, 200ms) var(--va-ease, ease),\n    border-color var(--va-dur-2, 200ms) var(--va-ease, ease),\n    color var(--va-dur-2, 200ms) var(--va-ease, ease),\n    box-shadow var(--va-dur-2, 200ms) var(--va-ease, ease),\n    transform var(--va-dur-1, 120ms) var(--va-ease, ease);\n}\n\n/* 尺寸 */\n.va-btn--sm { height: 30px; padding: 0 var(--va-s4, 12px); font-size: 13px; }\n.va-btn--md { height: 36px; padding: 0 var(--va-s5, 16px); font-size: 14px; }\n.va-btn--lg { height: 44px; padding: 0 var(--va-s6, 24px); font-size: 15px; }\n\n/* 变体 */\n.va-btn--primary {\n  background: var(--_ink);\n  color: var(--_card);\n  box-shadow: var(--va-shadow-1, none);\n}\n.va-btn--primary:hover:not(:disabled) { opacity: 0.88; }\n\n.va-btn--secondary {\n  background: var(--_card);\n  border-color: var(--_edge);\n  color: var(--va-ink, #1a1917);\n  box-shadow: var(--va-shadow-1, none);\n}\n.va-btn--secondary:hover:not(:disabled) { border-color: var(--va-edge-strong, rgba(26, 25, 23, 0.22)); }\n\n.va-btn--ghost {\n  background: transparent;\n  color: var(--va-ink-2, #43413c);\n}\n.va-btn--ghost:hover:not(:disabled) { background: var(--va-bg-subtle, #efede7); color: var(--va-ink, #1a1917); }\n\n.va-btn--destructive {\n  background: var(--_danger);\n  color: #fff;\n}\n.va-btn--destructive:hover:not(:disabled) { opacity: 0.9; }\n\n/* 交互 */\n.va-btn:focus-visible {\n  outline: 2px solid var(--va-accent, #c2410c);\n  outline-offset: 2px;\n}\n.va-btn:active:not(:disabled) { transform: translateY(0.5px) scale(0.985); }\n\n.va-btn:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n\n.va-btn--block { display: flex; width: 100%; }\n\n/* 图标 */\n.va-btn__icon { display: inline-flex; align-items: center; }\n.va-btn__icon svg { width: 1em; height: 1em; }\n\n/* 加载态：流内小转圈（走 flex gap 与文字对齐）+ 标签降透明（任何变体/主题下都可见） */\n.va-btn--loading { cursor: progress; }\n.va-btn--loading::before {\n  content: \"\";\n  flex: none;\n  width: 12px;\n  height: 12px;\n  border-radius: 50%;\n  border: 2px solid color-mix(in srgb, currentColor 30%, transparent);\n  border-top-color: currentColor;\n  animation: va-btn-spin 0.9s linear infinite;\n}\n/* 有 icon 插槽时用转圈顶替，避免并排 */\n.va-btn--loading .va-btn__icon { display: none; }\n.va-btn--loading .va-btn__label { opacity: 0.6; }\n\n@keyframes va-btn-spin { to { transform: rotate(360deg); } }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-btn { transition: none; }\n  .va-btn:active:not(:disabled) { transform: none; }\n  .va-btn--loading::before { animation-duration: 2s; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/button/types.ts",
      "type": "registry:ui",
      "target": "components/ui/button/types.ts",
      "content": "/** VaButton 的类型定义 */\n\nexport type ButtonVariant = \"primary\" | \"secondary\" | \"ghost\" | \"destructive\";\nexport type ButtonSize = \"sm\" | \"md\" | \"lg\";\n\nexport interface ButtonProps {\n  /** primary: 墨色实心 · secondary: 卡片+描边 · ghost: 纯文字 · destructive: 危险红 */\n  variant?: ButtonVariant;\n  size?: ButtonSize;\n  type?: \"button\" | \"submit\" | \"reset\";\n  disabled?: boolean;\n  /** 标签进入微光态并阻止点击 */\n  loading?: boolean;\n  /** 占满一行 */\n  block?: boolean;\n}\n\nexport interface ButtonSlots {\n  default?: () => unknown;\n  icon?: () => unknown;\n  \"icon-right\"?: () => unknown;\n}\n"
    }
  ]
}
