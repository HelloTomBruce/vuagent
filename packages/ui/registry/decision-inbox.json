{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "decision-inbox",
  "title": "Decision Inbox",
  "description": "业务决策收件箱：每条两个答案，选完确认并折叠离开列表。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `decisions` (Decision[]，默认 -)：id/title/detail/primary/secondary/collapsed\n- `@decide` (-，默认 -)：回调（决策与所选答案）",
  "files": [
    {
      "path": "components/ui/decision-inbox/VaDecisionInbox.vue",
      "type": "registry:ui",
      "target": "components/ui/decision-inbox/VaDecisionInbox.vue",
      "content": "<script setup lang=\"ts\">\nimport type { Decision, DecisionAnswer, DecisionInboxProps } from \"./types\";\nimport { useDecisionInbox } from \"./useDecisionInbox\";\n\nconst props = defineProps<DecisionInboxProps>();\nconst emit = defineEmits<{ decide: [decision: Decision, answer: DecisionAnswer] }>();\n\nconst { states, answer, visible, pending } = useDecisionInbox(props);\n\nfunction choose(d: Decision, which: DecisionAnswer) {\n  if (answer(d, which)) emit(\"decide\", d, which);\n}\n</script>\n\n<template>\n  <div class=\"va-dib\" :data-empty=\"!visible.length || undefined\">\n    <p v-if=\"visible.length\" class=\"va-dib__head\" role=\"status\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" aria-hidden=\"true\">\n        <path d=\"M12 9v4M12 16.5h.01M10.3 3.9 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z\" />\n      </svg>\n      {{ pending.length ? `${pending.length} 项待你拍板` : \"全部已处理\" }}\n    </p>\n\n    <TransitionGroup v-else name=\"va-dib-fade\" tag=\"div\">\n      <p key=\"empty\" class=\"va-dib__empty va-fade-in\">收件箱清空了，去忙别的吧。</p>\n    </TransitionGroup>\n\n    <TransitionGroup name=\"va-dib\" tag=\"div\" class=\"va-dib__list\">\n      <article\n        v-for=\"d in visible\"\n        :key=\"d.id\"\n        class=\"va-dib__item\"\n        :class=\"{ 'va-dib__item--folded': !states[d.id]?.open, 'va-dib__item--answered': states[d.id]?.answered }\"\n      >\n        <button\n          v-if=\"!states[d.id]?.open && !states[d.id]?.answered\"\n          class=\"va-dib__fold\"\n          type=\"button\"\n          @click=\"states[d.id]!.open = true\"\n        >\n          <span class=\"va-dib__fold-title\">{{ d.title }}</span>\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\">\n            <path d=\"m9.5 7 5 5-5 5\" />\n          </svg>\n        </button>\n\n        <template v-else>\n          <h4 class=\"va-dib__title\">{{ d.title }}</h4>\n          <p v-if=\"d.detail\" class=\"va-dib__detail\">{{ d.detail }}</p>\n\n          <div v-if=\"states[d.id]?.answered\" class=\"va-dib__confirm\" role=\"status\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" aria-hidden=\"true\">\n              <path d=\"M5.5 12.5l4 4L18.5 8\" />\n            </svg>\n            已选择「{{ states[d.id]?.answered === \"primary\" ? d.primary : d.secondary }}」\n          </div>\n          <div v-else class=\"va-dib__actions\">\n            <button class=\"va-act va-act--ink va-dib__btn\" type=\"button\" @click=\"choose(d, 'primary')\">{{ d.primary }}</button>\n            <button class=\"va-act va-dib__btn\" type=\"button\" @click=\"choose(d, 'secondary')\">{{ d.secondary }}</button>\n          </div>\n        </template>\n      </article>\n    </TransitionGroup>\n  </div>\n</template>\n\n<style>\n/* VaDecisionInbox — 需要人拍板的业务决策列表 */\n.va-dib {\n  --_card: var(--va-dib-card, var(--va-card, #ffffff));\n  --_edge: var(--va-dib-edge, var(--va-edge, rgba(26, 25, 23, 0.12)));\n  --_ink: var(--va-dib-ink, var(--va-ink, #1a1917));\n  --_muted: var(--va-dib-muted, var(--va-muted, #6f6d66));\n  --_warning: var(--va-dib-warning, var(--va-warning, #b45309));\n  font-family: var(--va-font, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Helvetica Neue\", sans-serif);\n}\n\n.va-dib__head {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s2, 4px);\n  margin: 0 0 var(--va-s3, 8px);\n  font-size: var(--va-fs-md, 13px);\n  font-weight: var(--va-fw-semibold, 600);\n  color: var(--_warning);\n}\n.va-dib__head svg { width: 15px; height: 15px; }\n\n.va-dib__empty { margin: 0; font-size: var(--va-fs-md, 13px); color: var(--_muted); }\n.va-dib[data-empty] { padding: var(--va-s3, 8px); border: 1px dashed var(--_edge); border-radius: var(--va-radius-m, 10px); }\n\n.va-dib__list { display: grid; gap: var(--va-s2, 4px); position: relative; }\n\n.va-dib__item {\n  background: var(--_card);\n  border: 1px solid var(--_edge);\n  border-radius: var(--va-radius-m, 10px);\n  padding: var(--va-s3, 8px) var(--va-s4, 12px);\n  transition: opacity var(--va-dur-2, 200ms) ease, border-color var(--va-dur-2, 200ms) ease;\n}\n.va-dib__item--folded { padding: 0; border-color: transparent; background: transparent; }\n.va-dib__item--answered { opacity: 0.75; }\n\n.va-dib__fold {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s2, 4px);\n  width: 100%;\n  padding: var(--va-s2, 4px) var(--va-s2, 4px);\n  background: none;\n  border: 0;\n  cursor: pointer;\n  font-family: inherit;\n  text-align: left;\n  color: var(--_muted);\n}\n.va-dib__fold:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: 1px; border-radius: 4px; }\n.va-dib__fold-title {\n  flex: 1;\n  font-size: var(--va-fs-md, 13px);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.va-dib__fold svg { width: 13px; height: 13px; flex: none; }\n\n.va-dib__title { margin: 0; font-size: var(--va-fs-md, 13px); font-weight: var(--va-fw-semibold, 600); color: var(--_ink); }\n.va-dib__detail { margin: 2px 0 0; font-size: var(--va-fs-sm, 12px); color: var(--_muted); }\n\n.va-dib__actions { display: flex; gap: var(--va-s2, 4px); margin-top: var(--va-s3, 8px); }\n/* va-act / va-act--ink 基类兜底，仅保留 28px 定高形态；按压反馈走基类 :active（TASK-105 迁移，原 scale(0.97) 删除） */\n.va-dib__btn { height: 28px; padding: 0 var(--va-s4, 12px); border-radius: var(--va-radius-m, 10px); font-size: var(--va-fs-md, 13px); }\n\n.va-dib__confirm {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s2, 4px);\n  margin-top: var(--va-s3, 8px);\n  font-size: var(--va-fs-md, 13px);\n  color: var(--va-success, #1a7f4b);\n}\n.va-dib__confirm svg { width: 14px; height: 14px; }\n\n/* 离场：淡出 + 后排顶上（FLIP move） */\n.va-dib-leave-active { position: absolute; left: 0; right: 0; }\n.va-dib-leave-to { opacity: 0; }\n.va-dib-leave-active { transition: opacity var(--va-dur-2, 200ms) ease; }\n.va-dib-move { transition: transform var(--va-dur-3, 300ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)); }\n.va-dib-fade-enter-active, .va-dib-fade-leave-active { transition: opacity var(--va-dur-2, 200ms) ease; }\n.va-dib-fade-enter-from, .va-dib-fade-leave-to { opacity: 0; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-dib-leave-active, .va-dib-move, .va-dib-fade-enter-active, .va-dib-fade-leave-active { transition: none; }\n  /* 按压降级由 .va-act 基类媒体块统一处理（transform: none + opacity 反馈） */\n}\n\n/* 按钮基类（自动附带） */\n/* ============================================================\n   按钮基类 —— 全库动作按钮的单一样式来源。\n   组件叠加使用：class=\"va-act va-act--primary va-xxx__submit\"，\n   组件自己的 CSS 只写布局/色彩覆盖（width、pill 圆角等）。\n   registry 生成器会把本文件自动内联进用了 va-act 的组件拷贝。\n   ============================================================ */\n\n.va-act {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--va-s3h, 6px);\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-s, 8px);\n  background: var(--va-card, #ffffff);\n  color: var(--va-ink-2, #43413c);\n  font: inherit;\n  font-size: var(--va-fs-md, 13px);\n  line-height: 1.4;\n  padding: 5px 14px;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: border-color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), background var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-act:hover:not(:disabled) { border-color: var(--va-edge-strong, rgba(26, 25, 23, 0.22)); }\n\n/* 按压反馈（TASK-105 基类口径，对齐 VaButton）：下沉 0.5px + 微缩 0.985，\n   时长走 --va-dur-1。组件不再逐个发明 :active 缩放值。 */\n.va-act:active:not(:disabled) { transform: translateY(0.5px) scale(0.985); }\n\n.va-act:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: 1px; }\n\n.va-act:disabled { opacity: 0.45; cursor: default; }\n\n/* 尺寸 */\n.va-act--sm { font-size: var(--va-fs-sm, 12px); padding: 3px var(--va-s4h, 10px); }\n.va-act--lg { font-size: var(--va-fs-lg, 14px); padding: 7px 18px; }\n\n/* 变体 */\n.va-act--primary {\n  background: var(--va-accent, #c2410c);\n  border-color: var(--va-accent, #c2410c);\n  color: var(--va-card, #ffffff);\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n.va-act--primary:hover:not(:disabled) {\n  background: var(--va-accent-hover, #9a3412);\n  border-color: var(--va-accent-hover, #9a3412);\n}\n\n.va-act--ghost {\n  border-color: transparent;\n  background: transparent;\n}\n\n.va-act--ghost:hover:not(:disabled) { background: var(--va-bg-subtle, #efede7); }\n\n.va-act--danger { border-color: transparent; background: transparent; color: var(--va-danger, #d5453c); }\n\n.va-act--danger:hover:not(:disabled) {\n  background: color-mix(in srgb, var(--va-danger, #d5453c) 10%, transparent);\n  border-color: transparent;\n}\n\n/* 语义色实底（成功/危险确认场景，按需叠加） */\n.va-act--success {\n  background: var(--va-success, #1a7f4b);\n  border-color: var(--va-success, #1a7f4b);\n  color: #fff;\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n/* 墨色实底：审批/决策/应用这类\"终审\"主操作（区别于 accent 常规主操作） */\n.va-act--ink {\n  background: var(--va-ink, #1a1917);\n  border-color: var(--va-ink, #1a1917);\n  color: var(--va-card, #ffffff);\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n.va-act--ink:hover:not(:disabled) { opacity: 0.88; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-act { transition: none; }\n  /* 按压降级：去位移，只留透明度反馈（状态可感知性保留，TASK-105 口径） */\n  .va-act:active:not(:disabled) { transform: none; opacity: 0.7; }\n}\n\n/* 动效工具类（自动附带，源码中来自全局 motion.css） */\n/* ============================================================\n   共享动效工具类 —— 进出场/交叉淡入的统一协议（TASK-102 动效基建）。\n   组件不逐个发明入场曲线：统一消费 --va-dur-in/--va-dur-out 骨架时长与\n   --va-dist-* 位移档；每条声明自带字面 fallback（registry 单文件拷贝分发\n   要求，与 tokens.css 门禁一致）。\n\n   接入方式二选一：\n   1. Vue <Transition>：\n      <Transition enter-active-class=\"va-enter-up\" leave-active-class=\"va-exit-up\">\n      动画 fill-mode 为 both（延迟期间保持首帧、播完停在终态），\n      无需再配 enter-from-class / leave-to-class；\n   2. 类切换重挂载：骨架 → 内容换节点时给新节点挂 .va-crossfade（纯淡入），\n      离场节点挂 .va-exit-*（更短更快）。\n\n   列表错峰：v-for 子项 :style=\"useStagger().delayStyle(i)\" 配合 .va-enter-*\n   动画类使用（animation-delay 由 composable 编排——.va-enter-* 为 CSS animation，\n   transition-delay 对其零作用，见 composables/useStagger.ts）。\n   ============================================================ */\n\n/* 入场：上浮（自下方 --va-dist-m 浮起） */\n@keyframes va-motion-in-up {\n  from { opacity: 0; transform: translateY(var(--va-dist-m, 8px)); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* 入场：左滑（自左侧 --va-dist-m 滑入） */\n@keyframes va-motion-in-left {\n  from { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n  to { opacity: 1; transform: translateX(0); }\n}\n\n/* 入场：缩放（96% 起放大至原尺寸） */\n@keyframes va-motion-in-scale {\n  from { opacity: 0; transform: scale(0.96); }\n  to { opacity: 1; transform: scale(1); }\n}\n\n/* 离场：与入场互逆（向上/向左飘出、缩回）；时长/曲线由工具类映射 --va-dur-out 骨架 */\n@keyframes va-motion-out-up {\n  from { opacity: 1; transform: translateY(0); }\n  to { opacity: 0; transform: translateY(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-left {\n  from { opacity: 1; transform: translateX(0); }\n  to { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-scale {\n  from { opacity: 1; transform: scale(1); }\n  to { opacity: 0; transform: scale(0.96); }\n}\n\n/* 交叉淡入/淡出（.va-crossfade 骨架→内容交换专用，无位移，避免占位跳变叠加） */\n@keyframes va-motion-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes va-motion-fade-out {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n/* ---- 工具类：入场走 --va-dur-in + ease-out-quart，离场走 --va-dur-out + ease-in-quad ---- */\n\n.va-enter-up {\n  animation: va-motion-in-up var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-left {\n  animation: va-motion-in-left var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-scale {\n  animation: va-motion-in-scale var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-exit-up {\n  animation: va-motion-out-up var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-left {\n  animation: va-motion-out-left var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-scale {\n  animation: va-motion-out-scale var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n/* 骨架 → 内容交叉过渡：新内容纯淡入 */\n.va-crossfade {\n  animation: va-motion-fade-in var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* 空态/轻量状态渐入（TASK-106 弱化档）：仅 opacity、时长走 --va-dur-2，\n   供列表空态提示与一次性状态块使用（空态清单见 TASK-106 报告）。\n   纯 opacity 即动效分频策略的降级终点形态，reduced-motion 下保持原样即可。 */\n.va-fade-in {\n  animation: va-motion-fade-in var(--va-dur-2, 200ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* ---- 静态光斑基类（TASK-105，决策 5「追光」路线基建）----\n   pointer 坐标由 composables/useSpotlight.ts 以 rAF 节流写入 --va-spot-x/y\n   （元素内百分比，光斑数学在 composable 内可单测）；本类只负责 radial 光斑\n   绘制与显隐（:hover 点亮，无 3D 倾斜， glare 数学对齐 VaTiltCard）。\n   --va-spot-* 为 L3 组件钩子口径（宿主可覆盖尺寸/颜色），不进 tokens.css。\n   双降级对齐 VaTiltCard glare：hover: none（触屏）与 reduced-motion 不绘制。 */\n.va-spotlight { position: relative; }\n\n/* ::after 承载光斑（避开组件自身 ::before 用途）；inset 0 + border-radius inherit\n   使光斑天然裁剪在宿主圆角内，无需 overflow: hidden。\n   注意：此 ::after radial 与 components/spotlight-card/VaSpotlightCard.css 的\n   .va-spot-card--spot::after 为 registry 单文件自含有意复制，改动需两处同步。 */\n.va-spotlight::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n  background: radial-gradient(\n    var(--va-spot-size, 240px) circle at var(--va-spot-x, 50%) var(--va-spot-y, 50%),\n    var(--va-spot-color, rgba(255, 255, 255, 0.14)),\n    transparent 65%\n  );\n}\n\n.va-spotlight:hover::after { opacity: 1; }\n\n@media (hover: none) {\n  .va-spotlight::after { display: none; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-spotlight::after { display: none; }\n}\n\n/* ---- 复制反馈标准（TASK-106）：copy→check 交叉过渡 ----\n   容器 .va-copy 为 inline-grid 双内容同格堆叠（格子宽取较宽子项，切换零跳动）：\n   __idle = copy 态内容（图标/文字），__done = check 态内容。\n   copied 置真挂 .va-copy--done：check 以 ease-spring 微弹入场（进入 done 态时\n   transform 的目标态时序换成 --va-ease-spring → 过冲回弹），交叉时长统一 --va-dur-1。\n   消费方：terminal-log（行复制）、code-diff（复制按钮）、message-actions（复制图标）。 */\n.va-copy { display: inline-grid; place-items: center; }\n\n.va-copy__idle,\n.va-copy__done {\n  grid-area: 1 / 1;\n  transition: opacity var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-copy__idle { opacity: 1; transform: scale(1); }\n.va-copy__done { opacity: 0; transform: scale(0.6); }\n\n.va-copy--done .va-copy__done {\n  opacity: 1;\n  transform: scale(1);\n  /* 时序按 transition 属性顺序映射：opacity 仍 ease，transform 换 ease-spring 微弹 */\n  transition-timing-function: var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), var(--va-ease-spring, cubic-bezier(0.34, 1.56, 0.64, 1));\n}\n\n.va-copy--done .va-copy__idle { opacity: 0; transform: scale(0.6); }\n\n@media (prefers-reduced-motion: reduce) {\n  /* 交叉过渡瞬时完成（无位移动画），copied 状态可感知性不受影响 */\n  .va-copy__idle,\n  .va-copy__done { transition: none; }\n}\n\n/* ---- 错误反馈标准（校验失败横向微振）：目标元素挂 .va-shake 播一次 ±3px 微振 ----\n   时长 --va-dur-2 × 2（两拍四峰，克制的「摇头」量级，rubric 校验失败口径）；\n   重复触发需先移除类、强制 reflow 再挂回（封装见 composables/useShake.ts）。\n   reduced-motion 降级为不播：错误状态的可感知性由错误样式本身（描边/文案）承担，\n   动效只做注意力引导——符合头注释「功能动画降级保留状态可感知」的分频策略。\n   消费方：VaStepperForm / VaOtpInput 经 useShake() 程序化触发（defineExpose shake()）；\n   宿主自绘表单可直接挂类。 */\n@keyframes va-motion-shake {\n  20% { transform: translateX(-3px); }\n  40% { transform: translateX(3px); }\n  60% { transform: translateX(-2px); }\n  80% { transform: translateX(2px); }\n}\n\n.va-shake {\n  animation: va-motion-shake calc(var(--va-dur-2, 200ms) * 2) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-shake { animation: none; }\n}\n\n/* ---- 动效分频（对齐 tokens.css 头注释策略）：\n   功能动画降级为纯 opacity——进/出场整体换成 fade keyframes，\n   位移/缩放不再出现（animation-name 顶替，时长/缓动沿用上面的声明）。 */\n@media (prefers-reduced-motion: reduce) {\n  .va-enter-up,\n  .va-enter-left,\n  .va-enter-scale,\n  .va-crossfade {\n    animation-name: va-motion-fade-in;\n  }\n\n  .va-exit-up,\n  .va-exit-left,\n  .va-exit-scale {\n    animation-name: va-motion-fade-out;\n  }\n}\n</style>\n"
    },
    {
      "path": "components/ui/decision-inbox/index.ts",
      "type": "registry:ui",
      "target": "components/ui/decision-inbox/index.ts",
      "content": "export { default as VaDecisionInbox } from \"./VaDecisionInbox.vue\";\nexport type {\n  Decision,\n  DecisionAnswer,\n  DecisionInboxEvents,\n  DecisionInboxProps,\n} from \"./types\";\n"
    },
    {
      "path": "components/ui/decision-inbox/types.ts",
      "type": "registry:ui",
      "target": "components/ui/decision-inbox/types.ts",
      "content": "/** VaDecisionInbox 的类型定义 */\n\nexport type DecisionAnswer = \"primary\" | \"secondary\";\n\nexport interface Decision {\n  id: string;\n  title: string;\n  /** 标题下的一句背景说明 */\n  detail?: string;\n  /** 主答案（墨色实心按钮），如\"立即发布\" */\n  primary: string;\n  /** 次答案（描边按钮），如\"再等等\" */\n  secondary: string;\n  /** 初始折叠为一行弱化文本，点击展开 */\n  collapsed?: boolean;\n}\n\nexport interface DecisionInboxProps {\n  decisions: Decision[];\n}\n\nexport interface DecisionInboxEvents {\n  decide: [decision: Decision, answer: DecisionAnswer];\n}\n"
    },
    {
      "path": "components/ui/decision-inbox/useDecisionInbox.ts",
      "type": "registry:ui",
      "target": "components/ui/decision-inbox/useDecisionInbox.ts",
      "content": "import { computed, ref, watch } from \"vue\";\nimport type { Decision, DecisionAnswer, DecisionInboxProps } from \"./types\";\n\ntype RowState = { open: boolean; answered?: DecisionAnswer; gone?: boolean };\n\n/** VaDecisionInbox 的状态逻辑：按 id 维护展开/已答/离场状态，数据变化时只增删不覆盖 */\nexport function useDecisionInbox(props: DecisionInboxProps) {\n  const states = ref<Record<string, RowState>>({});\n\n  // 数据驱动：新增的决策初始化状态，移除的清理状态；已存在的用户状态不动\n  watch(\n    () => props.decisions,\n    (list) => {\n      const seen = new Set<string>();\n      for (const d of list) {\n        seen.add(d.id);\n        if (!states.value[d.id]) {\n          states.value[d.id] = { open: !d.collapsed };\n        }\n      }\n      for (const id of Object.keys(states.value)) {\n        if (!seen.has(id)) delete states.value[id];\n      }\n    },\n    { immediate: true, deep: false },\n  );\n\n  /**\n   * 记录选择：未答过才生效，展示确认态片刻后折叠离场。\n   * 返回是否真正生效（供 SFC 决定是否向父层 emit）。\n   */\n  function answer(d: Decision, which: DecisionAnswer): boolean {\n    const s = states.value[d.id];\n    if (!s || s.answered) return false;\n    s.answered = which;\n    window.setTimeout(() => {\n      const cur = states.value[d.id];\n      if (cur?.answered === which) cur.gone = true;\n    }, 1000);\n    return true;\n  }\n\n  const visible = computed(() => props.decisions.filter((d) => !states.value[d.id]?.gone));\n  const pending = computed(() => visible.value.filter((d) => !states.value[d.id]?.answered));\n\n  return { states, answer, visible, pending };\n}\n"
    }
  ]
}
