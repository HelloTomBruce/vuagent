{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "decision-inbox",
  "title": "Decision Inbox",
  "description": "业务决策收件箱：每条两个答案，选完确认并折叠离开列表。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `decisions` (Decision[]，默认 -)：id/title/detail/primary/secondary/collapsed\n- `@decide` (-，默认 -)：回调（决策与所选答案）",
  "files": [
    {
      "path": "components/ui/decision-inbox/VaDecisionInbox.vue",
      "type": "registry:ui",
      "target": "components/ui/decision-inbox/VaDecisionInbox.vue",
      "content": "<script setup lang=\"ts\">\nimport type { Decision, DecisionAnswer, DecisionInboxProps } from \"./types\";\nimport { useDecisionInbox } from \"./useDecisionInbox\";\n\nconst props = defineProps<DecisionInboxProps>();\nconst emit = defineEmits<{ decide: [decision: Decision, answer: DecisionAnswer] }>();\n\nconst { states, answer, visible, pending } = useDecisionInbox(props);\n\nfunction choose(d: Decision, which: DecisionAnswer) {\n  if (answer(d, which)) emit(\"decide\", d, which);\n}\n</script>\n\n<template>\n  <div class=\"va-dib\" :data-empty=\"!visible.length || undefined\">\n    <p v-if=\"visible.length\" class=\"va-dib__head\" role=\"status\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" aria-hidden=\"true\">\n        <path d=\"M12 9v4M12 16.5h.01M10.3 3.9 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z\" />\n      </svg>\n      {{ pending.length ? `${pending.length} 项待你拍板` : \"全部已处理\" }}\n    </p>\n\n    <TransitionGroup v-else name=\"va-dib-fade\" tag=\"div\">\n      <p key=\"empty\" class=\"va-dib__empty\">收件箱清空了，去忙别的吧。</p>\n    </TransitionGroup>\n\n    <TransitionGroup name=\"va-dib\" tag=\"div\" class=\"va-dib__list\">\n      <article\n        v-for=\"d in visible\"\n        :key=\"d.id\"\n        class=\"va-dib__item\"\n        :class=\"{ 'va-dib__item--folded': !states[d.id]?.open, 'va-dib__item--answered': states[d.id]?.answered }\"\n      >\n        <button\n          v-if=\"!states[d.id]?.open && !states[d.id]?.answered\"\n          class=\"va-dib__fold\"\n          type=\"button\"\n          @click=\"states[d.id]!.open = true\"\n        >\n          <span class=\"va-dib__fold-title\">{{ d.title }}</span>\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\">\n            <path d=\"m9.5 7 5 5-5 5\" />\n          </svg>\n        </button>\n\n        <template v-else>\n          <h4 class=\"va-dib__title\">{{ d.title }}</h4>\n          <p v-if=\"d.detail\" class=\"va-dib__detail\">{{ d.detail }}</p>\n\n          <div v-if=\"states[d.id]?.answered\" class=\"va-dib__confirm\" role=\"status\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" aria-hidden=\"true\">\n              <path d=\"M5.5 12.5l4 4L18.5 8\" />\n            </svg>\n            已选择「{{ states[d.id]?.answered === \"primary\" ? d.primary : d.secondary }}」\n          </div>\n          <div v-else class=\"va-dib__actions\">\n            <button class=\"va-act va-act--ink va-dib__btn\" type=\"button\" @click=\"choose(d, 'primary')\">{{ d.primary }}</button>\n            <button class=\"va-act va-dib__btn\" type=\"button\" @click=\"choose(d, 'secondary')\">{{ d.secondary }}</button>\n          </div>\n        </template>\n      </article>\n    </TransitionGroup>\n  </div>\n</template>\n\n<style>\n/* VaDecisionInbox — 需要人拍板的业务决策列表 */\n.va-dib {\n  --_card: var(--va-dib-card, var(--va-card, #ffffff));\n  --_edge: var(--va-dib-edge, var(--va-edge, rgba(26, 25, 23, 0.12)));\n  --_ink: var(--va-dib-ink, var(--va-ink, #1a1917));\n  --_muted: var(--va-dib-muted, var(--va-muted, #6f6d66));\n  --_warning: var(--va-dib-warning, var(--va-warning, #b45309));\n  font-family: var(--va-font, system-ui, sans-serif);\n}\n\n.va-dib__head {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s2, 4px);\n  margin: 0 0 var(--va-s3, 8px);\n  font-size: 12.5px;\n  font-weight: 600;\n  color: var(--_warning);\n}\n.va-dib__head svg { width: 15px; height: 15px; }\n\n.va-dib__empty { margin: 0; font-size: 12.5px; color: var(--_muted); }\n.va-dib[data-empty] { padding: var(--va-s3, 8px); border: 1px dashed var(--_edge); border-radius: var(--va-radius-m, 10px); }\n\n.va-dib__list { display: grid; gap: var(--va-s2, 4px); position: relative; }\n\n.va-dib__item {\n  background: var(--_card);\n  border: 1px solid var(--_edge);\n  border-radius: var(--va-radius-m, 10px);\n  padding: var(--va-s3, 8px) var(--va-s4, 12px);\n  transition: opacity var(--va-dur-2, 200ms) ease, border-color var(--va-dur-2, 200ms) ease;\n}\n.va-dib__item--folded { padding: 0; border-color: transparent; background: transparent; }\n.va-dib__item--answered { opacity: 0.75; }\n\n.va-dib__fold {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s2, 4px);\n  width: 100%;\n  padding: var(--va-s2, 4px) var(--va-s2, 4px);\n  background: none;\n  border: 0;\n  cursor: pointer;\n  font-family: inherit;\n  text-align: left;\n  color: var(--_muted);\n}\n.va-dib__fold:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: 1px; border-radius: 4px; }\n.va-dib__fold-title {\n  flex: 1;\n  font-size: 12.5px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.va-dib__fold svg { width: 13px; height: 13px; flex: none; }\n\n.va-dib__title { margin: 0; font-size: 13px; font-weight: 600; color: var(--_ink); }\n.va-dib__detail { margin: 2px 0 0; font-size: 12px; color: var(--_muted); }\n\n.va-dib__actions { display: flex; gap: var(--va-s2, 4px); margin-top: var(--va-s3, 8px); }\n/* va-act / va-act--ink 基类兜底，仅保留 28px 定高形态 */\n.va-dib__btn { height: 28px; padding: 0 var(--va-s4, 12px); border-radius: var(--va-radius-m, 10px); font-size: 12.5px; }\n.va-dib__btn:active { transform: scale(0.97); }\n\n.va-dib__confirm {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s2, 4px);\n  margin-top: var(--va-s3, 8px);\n  font-size: 12.5px;\n  color: var(--va-success, #1a7f4b);\n}\n.va-dib__confirm svg { width: 14px; height: 14px; }\n\n/* 离场：淡出 + 后排顶上（FLIP move） */\n.va-dib-leave-active { position: absolute; left: 0; right: 0; }\n.va-dib-leave-to { opacity: 0; }\n.va-dib-leave-active { transition: opacity var(--va-dur-2, 200ms) ease; }\n.va-dib-move { transition: transform var(--va-dur-3, 300ms) var(--va-ease, ease); }\n.va-dib-fade-enter-active, .va-dib-fade-leave-active { transition: opacity var(--va-dur-2, 200ms) ease; }\n.va-dib-fade-enter-from, .va-dib-fade-leave-to { opacity: 0; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-dib-leave-active, .va-dib-move, .va-dib-fade-enter-active, .va-dib-fade-leave-active { transition: none; }\n  .va-dib__btn:active { transform: none; }\n}\n\n/* 按钮基类（自动附带） */\n/* ============================================================\n   按钮基类 —— 全库动作按钮的单一样式来源。\n   组件叠加使用：class=\"va-act va-act--primary va-xxx__submit\"，\n   组件自己的 CSS 只写布局/色彩覆盖（width、pill 圆角等）。\n   registry 生成器会把本文件自动内联进用了 va-act 的组件拷贝。\n   ============================================================ */\n\n.va-act {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-card);\n  color: var(--va-ink-2);\n  font: inherit;\n  font-size: 13px;\n  line-height: 1.4;\n  padding: 5px 14px;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: border-color var(--va-dur-1) var(--va-ease), background var(--va-dur-1) var(--va-ease),\n    color var(--va-dur-1) var(--va-ease);\n}\n\n.va-act:hover:not(:disabled) { border-color: var(--va-edge-strong); }\n\n.va-act:focus-visible { outline: 2px solid var(--va-accent); outline-offset: 1px; }\n\n.va-act:disabled { opacity: 0.45; cursor: default; }\n\n/* 尺寸 */\n.va-act--sm { font-size: 12px; padding: 3px 10px; }\n.va-act--lg { font-size: 14px; padding: 7px 18px; }\n\n/* 变体 */\n.va-act--primary {\n  background: var(--va-accent);\n  border-color: var(--va-accent);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-act--primary:hover:not(:disabled) {\n  background: var(--va-accent-hover);\n  border-color: var(--va-accent-hover);\n}\n\n.va-act--ghost {\n  border-color: transparent;\n  background: transparent;\n}\n\n.va-act--ghost:hover:not(:disabled) { background: var(--va-bg-subtle); }\n\n.va-act--danger { border-color: transparent; background: transparent; color: var(--va-danger); }\n\n.va-act--danger:hover:not(:disabled) {\n  background: color-mix(in srgb, var(--va-danger) 10%, transparent);\n  border-color: transparent;\n}\n\n/* 语义色实底（成功/危险确认场景，按需叠加） */\n.va-act--success {\n  background: var(--va-success);\n  border-color: var(--va-success);\n  color: #fff;\n  font-weight: 600;\n}\n\n/* 墨色实底：审批/决策/应用这类\"终审\"主操作（区别于 accent 常规主操作） */\n.va-act--ink {\n  background: var(--va-ink);\n  border-color: var(--va-ink);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-act--ink:hover:not(:disabled) { opacity: 0.88; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-act { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/decision-inbox/types.ts",
      "type": "registry:ui",
      "target": "components/ui/decision-inbox/types.ts",
      "content": "/** VaDecisionInbox 的类型定义 */\n\nexport type DecisionAnswer = \"primary\" | \"secondary\";\n\nexport interface Decision {\n  id: string;\n  title: string;\n  /** 标题下的一句背景说明 */\n  detail?: string;\n  /** 主答案（墨色实心按钮），如\"立即发布\" */\n  primary: string;\n  /** 次答案（描边按钮），如\"再等等\" */\n  secondary: string;\n  /** 初始折叠为一行弱化文本，点击展开 */\n  collapsed?: boolean;\n}\n\nexport interface DecisionInboxProps {\n  decisions: Decision[];\n}\n\nexport interface DecisionInboxEvents {\n  decide: [decision: Decision, answer: DecisionAnswer];\n}\n"
    },
    {
      "path": "components/ui/decision-inbox/useDecisionInbox.ts",
      "type": "registry:ui",
      "target": "components/ui/decision-inbox/useDecisionInbox.ts",
      "content": "import { computed, ref, watch } from \"vue\";\nimport type { Decision, DecisionAnswer, DecisionInboxProps } from \"./types\";\n\ntype RowState = { open: boolean; answered?: DecisionAnswer; gone?: boolean };\n\n/** VaDecisionInbox 的状态逻辑：按 id 维护展开/已答/离场状态，数据变化时只增删不覆盖 */\nexport function useDecisionInbox(props: DecisionInboxProps) {\n  const states = ref<Record<string, RowState>>({});\n\n  // 数据驱动：新增的决策初始化状态，移除的清理状态；已存在的用户状态不动\n  watch(\n    () => props.decisions,\n    (list) => {\n      const seen = new Set<string>();\n      for (const d of list) {\n        seen.add(d.id);\n        if (!states.value[d.id]) {\n          states.value[d.id] = { open: !d.collapsed };\n        }\n      }\n      for (const id of Object.keys(states.value)) {\n        if (!seen.has(id)) delete states.value[id];\n      }\n    },\n    { immediate: true, deep: false },\n  );\n\n  /**\n   * 记录选择：未答过才生效，展示确认态片刻后折叠离场。\n   * 返回是否真正生效（供 SFC 决定是否向父层 emit）。\n   */\n  function answer(d: Decision, which: DecisionAnswer): boolean {\n    const s = states.value[d.id];\n    if (!s || s.answered) return false;\n    s.answered = which;\n    window.setTimeout(() => {\n      const cur = states.value[d.id];\n      if (cur?.answered === which) cur.gone = true;\n    }, 1000);\n    return true;\n  }\n\n  const visible = computed(() => props.decisions.filter((d) => !states.value[d.id]?.gone));\n  const pending = computed(() => visible.value.filter((d) => !states.value[d.id]?.answered));\n\n  return { states, answer, visible, pending };\n}\n"
    }
  ]
}
