{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "thought-box",
  "title": "Thought Box",
  "description": "思考过程与摘要折叠：支持脑电波脉冲动效、流式思考态，以及回答结束收拢的「已完成·耗时·工具调用」单行摘要条。",
  "type": "registry:ui",
  "dependencies": [
    "lucide-vue-next"
  ],
  "registryDependencies": [],
  "docs": "- `thought` (string，默认 \"\")：思考过程正文\n- `expanded` (boolean，默认 true)：展开详细思考内容\n- `duration` (number，默认 -)：思考耗时（秒）\n- `streaming` (boolean，默认 false)：正在深度思考中\n- `summaryMode` (boolean，默认 false)：过程摘要条模式\n- `toolCount` (number，默认 0)：工具调用次数",
  "files": [
    {
      "path": "components/ui/thought-box/VaThoughtBox.vue",
      "type": "registry:ui",
      "target": "components/ui/thought-box/VaThoughtBox.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from \"vue\";\nimport { Brain, CheckCircle2, ChevronDown, ChevronUp } from \"lucide-vue-next\";\nimport type { ThoughtBoxEvents, ThoughtBoxProps } from \"./types\";\n\nconst props = withDefaults(defineProps<ThoughtBoxProps>(), {\n  thought: \"\",\n  expanded: true,\n  duration: undefined,\n  streaming: false,\n  summaryMode: false,\n  toolCount: 0,\n});\n\nconst emit = defineEmits<ThoughtBoxEvents>();\n\nconst isExpanded = computed({\n  get: () => props.expanded,\n  set: (val) => {\n    emit(\"update:expanded\", val);\n    emit(\"toggle\", val);\n  },\n});\n\nfunction toggleExpanded() {\n  isExpanded.value = !isExpanded.value;\n}\n\nfunction expandFromSummary() {\n  emit(\"update:summaryMode\", false);\n  emit(\"update:expanded\", true);\n  emit(\"toggle\", true);\n}\n</script>\n\n<template>\n  <!-- 1. 摘要条展示模式 -->\n  <button\n    v-if=\"props.summaryMode\"\n    class=\"va-thought-box__summary\"\n    type=\"button\"\n    title=\"展开过程详情\"\n    @click=\"expandFromSummary\"\n  >\n    <CheckCircle2 :size=\"14\" class=\"va-thought-box__summary-icon\" />\n    <span>\n      已完成<template v-if=\"props.duration != null\"> · 耗时 {{ props.duration }}s</template><template v-if=\"props.toolCount\"> · {{ props.toolCount }} 次工具调用</template>\n    </span>\n    <ChevronDown :size=\"13\" class=\"va-thought-box__summary-chevron\" />\n  </button>\n\n  <!-- 2. 详细思考展开盒 -->\n  <div v-else class=\"va-thought-box\">\n    <div class=\"va-thought-box__header\" @click=\"toggleExpanded\">\n      <div class=\"va-thought-box__title\">\n        <Brain :size=\"15\" :class=\"{ 'va-thought-box__pulse-icon': props.streaming }\" />\n        <span>思考过程</span>\n        <span v-if=\"props.duration != null\" class=\"va-thought-box__duration\">· 耗时 {{ props.duration }}s</span>\n        <span v-else-if=\"props.streaming\" class=\"va-thought-box__duration\">· 正在深度思考…</span>\n      </div>\n      <button class=\"va-thought-box__btn\" type=\"button\" @click.stop=\"toggleExpanded\">\n        {{ isExpanded ? \"收起\" : \"展开\" }}\n        <ChevronUp v-if=\"isExpanded\" :size=\"13\" />\n        <ChevronDown v-else :size=\"13\" />\n      </button>\n    </div>\n\n    <div v-if=\"isExpanded\" class=\"va-thought-box__content\">\n      <slot>\n        {{ props.thought || (props.streaming ? \"正在拆解任务意图，规划工具调用序列与沙箱执行路径…\" : \"暂无思考内容\") }}\n      </slot>\n    </div>\n  </div>\n</template>\n\n<style>\n.va-thought-box {\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  background: var(--va-bg-subtle, #efede7);\n  border-radius: var(--va-radius-m, 10px);\n  margin-bottom: 12px;\n  overflow: hidden;\n  font-size: 13px;\n  color: var(--va-ink-2, #43413c);\n}\n\n.va-thought-box__header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 8px 12px;\n  cursor: pointer;\n  user-select: none;\n  background: transparent;\n  transition: background var(--va-dur-1, 120ms) ease;\n}\n\n.va-thought-box__header:hover {\n  background: var(--va-bg-hover, rgba(0, 0, 0, 0.03));\n}\n\n.va-thought-box__title {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  font-weight: 500;\n  color: var(--va-ink, #1a1917);\n}\n\n.va-thought-box__pulse-icon {\n  color: var(--va-accent, #c2410c);\n  animation: va-thought-pulse calc(var(--va-dur-loop, 1.8s) * 10 / 9) cubic-bezier(0.4, 0, 0.6, 1) infinite; /* 2s = 底速 × 10/9 */\n}\n\n@keyframes va-thought-pulse {\n  0%, 100% { opacity: 1; transform: scale(1); }\n  50% { opacity: 0.5; transform: scale(0.92); }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-thought-box__pulse-icon { animation: none; }\n}\n\n.va-thought-box__duration {\n  font-size: 12px;\n  color: var(--va-ink-muted, #78716c);\n  font-weight: 400;\n}\n\n.va-thought-box__btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  background: none;\n  border: none;\n  font-size: 12px;\n  color: var(--va-ink-muted, #78716c);\n  cursor: pointer;\n  padding: 2px 4px;\n}\n\n.va-thought-box__content {\n  padding: 10px 14px;\n  border-top: 1px dashed var(--va-edge, rgba(26, 25, 23, 0.12));\n  background: var(--va-bg, #f7f6f2);\n  font-family: var(--va-font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);\n  font-size: 12px;\n  line-height: 1.6;\n  max-height: 280px;\n  overflow-y: auto;\n  color: var(--va-ink-2, #43413c);\n  white-space: pre-wrap;\n  word-break: break-word;\n}\n\n/* 过程摘要条形态 */\n.va-thought-box__summary {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 6px 12px;\n  margin-bottom: 12px;\n  border-radius: var(--va-radius-s, 8px);\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  background: var(--va-bg-subtle, #efede7);\n  font-size: 12px;\n  color: var(--va-ink-2, #43413c);\n  cursor: pointer;\n  transition: all var(--va-dur-1, 120ms) ease;\n}\n\n.va-thought-box__summary:hover {\n  background: var(--va-bg-hover, rgba(0, 0, 0, 0.04));\n  border-color: var(--va-edge-strong, rgba(26, 25, 23, 0.22));\n}\n\n.va-thought-box__summary-icon {\n  color: var(--va-success, #1a7f4b);\n}\n\n.va-thought-box__summary-chevron {\n  color: var(--va-ink-muted, #a8a29e);\n  margin-left: 2px;\n}\n</style>\n"
    },
    {
      "path": "components/ui/thought-box/index.ts",
      "type": "registry:ui",
      "target": "components/ui/thought-box/index.ts",
      "content": "export { default as VaThoughtBox } from \"./VaThoughtBox.vue\";\nexport type { ThoughtBoxProps, ThoughtBoxEvents } from \"./types\";\n"
    },
    {
      "path": "components/ui/thought-box/types.ts",
      "type": "registry:ui",
      "target": "components/ui/thought-box/types.ts",
      "content": "export interface ThoughtBoxProps {\n  /** 思考链或过程文本 */\n  thought?: string;\n  /** 是否展开详细思考内容（支持 v-model:expanded） */\n  expanded?: boolean;\n  /** 思考耗时（秒） */\n  duration?: number;\n  /** 是否处于流式思考状态中 */\n  streaming?: boolean;\n  /** 是否处于统一过程收起的单行摘要条模式（如：已完成 · 耗时 2.4s · 3 次工具调用） */\n  summaryMode?: boolean;\n  /** 工具调用次数（用于摘要条文案） */\n  toolCount?: number;\n}\n\nexport interface ThoughtBoxEvents {\n  (e: \"update:expanded\", value: boolean): void;\n  (e: \"update:summaryMode\", value: boolean): void;\n  (e: \"toggle\", value: boolean): void;\n}\n"
    }
  ]
}
