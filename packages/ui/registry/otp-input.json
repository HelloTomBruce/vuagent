{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "otp-input",
  "title": "OTP Input",
  "description": "验证码格子输入：自动跳格与选中、退格回退、整段粘贴分发、方向键移动、填满回调。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `v-model` (string，默认 \"\")：验证码字符串\n- `length` (number，默认 6)：格子数\n- `@complete` (-，默认 -)：全部填满时触发",
  "files": [
    {
      "path": "components/ui/otp-input/VaOtpInput.vue",
      "type": "registry:ui",
      "target": "components/ui/otp-input/VaOtpInput.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, useTemplateRef } from \"vue\";\nimport type { OtpInputEvents, OtpInputProps } from \"./types\";\n\nconst props = defineProps<OtpInputProps>();\n\nconst emit = defineEmits<OtpInputEvents>();\n\nconst len = computed(() => props.length ?? 6);\nconst chars = computed(() => {\n  const v = props.modelValue ?? \"\";\n  return Array.from({ length: len.value }, (_, i) => v[i] ?? \"\");\n});\nconst filled = computed(() => chars.value.every((c) => c !== \"\"));\n\nconst rootEl = useTemplateRef<HTMLElement>(\"root\");\n\nfunction update(next: string[]) {\n  const v = next.join(\"\").slice(0, len.value);\n  emit(\"update:modelValue\", v);\n  if (v.length === len.value) emit(\"complete\", v);\n}\n\nfunction at(i: number) {\n  return rootEl.value?.querySelectorAll<HTMLInputElement>(\"input\")[i];\n}\n\nfunction onInput(i: number, e: Event) {\n  const input = e.target as HTMLInputElement;\n  const raw = input.value;\n  // 单格只留首字符；多余部分（输入法/自动填充）顺移到后续空格\n  const next = [...chars.value];\n  const feed = raw.split(\"\");\n  let idx = i;\n  for (const ch of feed) {\n    if (idx >= len.value) break;\n    if (ch.trim() === \"\") { idx++; continue; }\n    next[idx] = ch;\n    idx++;\n  }\n  update(next);\n  const focusTo = Math.min(idx, len.value - 1);\n  at(focusTo)?.focus();\n  at(focusTo)?.select();\n}\n\nfunction onKeydown(i: number, e: KeyboardEvent) {\n  const next = [...chars.value];\n  if (e.key === \"Backspace\") {\n    e.preventDefault();\n    if (next[i]) next[i] = \"\";\n    else if (i > 0) {\n      next[i - 1] = \"\";\n      at(i - 1)?.focus();\n    }\n    update(next);\n  } else if (e.key === \"ArrowLeft\" && i > 0) {\n    e.preventDefault();\n    at(i - 1)?.focus();\n  } else if (e.key === \"ArrowRight\" && i < len.value - 1) {\n    e.preventDefault();\n    at(i + 1)?.focus();\n  }\n}\n\n/** 粘贴整段验证码分发到所有格子 */\nfunction onPaste(e: ClipboardEvent) {\n  e.preventDefault();\n  const text = (e.clipboardData?.getData(\"text\") ?? \"\").replace(/\\s+/g, \"\").slice(0, len.value);\n  if (!text) return;\n  const arr = Array.from({ length: len.value }, (_, i) => text[i] ?? \"\");\n  update(arr);\n  const last = Math.min(text.length, len.value) - 1;\n  at(Math.max(0, last))?.focus();\n}\n</script>\n\n<template>\n  <div\n    ref=\"root\"\n    class=\"va-otp\"\n    role=\"group\"\n    :aria-label=\"props.label ?? '验证码输入'\"\n    @paste=\"onPaste\"\n  >\n    <input\n      v-for=\"(_, i) in len\"\n      :key=\"i\"\n      class=\"va-otp__cell\"\n      :class=\"{ 'va-otp__cell--filled': chars[i] !== '' }\"\n      type=\"text\"\n      inputmode=\"numeric\"\n      autocomplete=\"one-time-code\"\n      maxlength=\"1\"\n      :value=\"chars[i]\"\n      :placeholder=\"props.placeholder ?? ''\"\n      :disabled=\"props.disabled\"\n      :aria-label=\"`第 ${i + 1} 位`\"\n      @input=\"onInput(i, $event)\"\n      @keydown=\"onKeydown(i, $event)\"\n      @focus=\"(($event.target) as HTMLInputElement).select()\"\n    >\n    <span v-if=\"filled\" class=\"va-otp__done\" aria-hidden=\"true\">✓</span>\n  </div>\n</template>\n\n<style>\n/* VaOtpInput — 验证码格子输入 */\n\n.va-otp {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--va-s3);\n}\n\n.va-otp__cell {\n  width: 42px;\n  height: 48px;\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-card);\n  color: var(--va-ink);\n  font-family: var(--va-font-mono);\n  font-size: 19px;\n  text-align: center;\n  transition: border-color var(--va-dur-1) var(--va-ease), box-shadow var(--va-dur-1) var(--va-ease);\n}\n\n.va-otp__cell:focus {\n  outline: none;\n  border-color: var(--va-accent);\n  box-shadow: 0 0 0 3px var(--va-accent-soft);\n}\n\n.va-otp__cell--filled { border-color: var(--va-edge-strong); }\n.va-otp__cell:disabled { opacity: 0.5; background: var(--va-bg-subtle); }\n\n.va-otp__done {\n  color: var(--va-success);\n  font-size: 16px;\n  font-weight: 700;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-otp__cell { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/otp-input/types.ts",
      "type": "registry:ui",
      "target": "components/ui/otp-input/types.ts",
      "content": "/** VaOtpInput 的类型定义 */\n\nexport interface OtpInputProps {\n  /** 格子数，默认 6 */\n  length?: number;\n  /** 受控值（配合 @update:modelValue 实现 v-model） */\n  modelValue?: string;\n  placeholder?: string;\n  /** 禁用 */\n  disabled?: boolean;\n  /** 完成后是否自动把焦点移出 */\n  autofocusLeave?: boolean;\n  /** 输入框组 aria-label */\n  label?: string;\n}\n\nexport interface OtpInputEvents {\n  \"update:modelValue\": [v: string];\n  /** 全部填满时触发一次（重新编辑后再满会再次触发） */\n  complete: [v: string];\n}\n"
    }
  ]
}
