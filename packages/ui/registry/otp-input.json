{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "otp-input",
  "title": "OTP Input",
  "description": "验证码格子输入：自动跳格与选中、退格回退、整段粘贴分发、方向键移动、填满回调。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `v-model` (string，默认 \"\")：验证码字符串\n- `length` (number，默认 6)：格子数\n- `@complete` (-，默认 -)：全部填满时触发",
  "files": [
    {
      "path": "components/ui/otp-input/VaOtpInput.vue",
      "type": "registry:ui",
      "target": "components/ui/otp-input/VaOtpInput.vue",
      "content": "<script setup lang=\"ts\">import { computed, useTemplateRef, toValue, type MaybeRefOrGetter } from \"vue\";\n\nimport type { OtpInputEvents, OtpInputProps } from \"./types\";\n\n\nconst props = defineProps<OtpInputProps>();\n\nconst emit = defineEmits<OtpInputEvents>();\n\nconst len = computed(() => props.length ?? 6);\nconst chars = computed(() => {\n  const v = props.modelValue ?? \"\";\n  return Array.from({ length: len.value }, (_, i) => v[i] ?? \"\");\n});\nconst filled = computed(() => chars.value.every((c) => c !== \"\"));\n\nconst rootEl = useTemplateRef<HTMLElement>(\"root\");\n\n/* 验证码错误反馈：宿主侧校验失败（服务端判定不对等）时调用，输入组横向微振一次\n   （motion.css .va-shake 标准）；错误语义建议宿主同时以文案/aria 披露 */\nconst { shake } = useShake(rootEl);\n\nfunction update(next: string[]) {\n  const v = next.join(\"\").slice(0, len.value);\n  emit(\"update:modelValue\", v);\n  if (v.length === len.value) emit(\"complete\", v);\n}\n\nfunction at(i: number) {\n  return rootEl.value?.querySelectorAll<HTMLInputElement>(\"input\")[i];\n}\n\nfunction onInput(i: number, e: Event) {\n  const input = e.target as HTMLInputElement;\n  const raw = input.value;\n  // 单格只留首字符；多余部分（输入法/自动填充）顺移到后续空格\n  const next = [...chars.value];\n  const feed = raw.split(\"\");\n  let idx = i;\n  for (const ch of feed) {\n    if (idx >= len.value) break;\n    if (ch.trim() === \"\") { idx++; continue; }\n    next[idx] = ch;\n    idx++;\n  }\n  update(next);\n  const focusTo = Math.min(idx, len.value - 1);\n  at(focusTo)?.focus();\n  at(focusTo)?.select();\n}\n\nfunction onKeydown(i: number, e: KeyboardEvent) {\n  const next = [...chars.value];\n  if (e.key === \"Backspace\") {\n    e.preventDefault();\n    if (next[i]) next[i] = \"\";\n    else if (i > 0) {\n      next[i - 1] = \"\";\n      at(i - 1)?.focus();\n    }\n    update(next);\n  } else if (e.key === \"ArrowLeft\" && i > 0) {\n    e.preventDefault();\n    at(i - 1)?.focus();\n  } else if (e.key === \"ArrowRight\" && i < len.value - 1) {\n    e.preventDefault();\n    at(i + 1)?.focus();\n  }\n}\n\n/** 粘贴整段验证码分发到所有格子 */\nfunction onPaste(e: ClipboardEvent) {\n  e.preventDefault();\n  const text = (e.clipboardData?.getData(\"text\") ?? \"\").replace(/\\s+/g, \"\").slice(0, len.value);\n  if (!text) return;\n  const arr = Array.from({ length: len.value }, (_, i) => text[i] ?? \"\");\n  update(arr);\n  const last = Math.min(text.length, len.value) - 1;\n  at(Math.max(0, last))?.focus();\n}\n\ndefineExpose({ shake });\n\n/* ── 内联自 @vuagent/ui src/composables/useShake.ts（registry 单文件拷贝自包含） ── */\n/**\n * 错误反馈横向微振编排（.va-shake 程序化触发器，motion.css 错误反馈标准的 JS 侧）：\n * 返回 shake() 供校验失败时调用（组件经 defineExpose 对宿主暴露）。\n * 动画本体在 CSS（.va-shake + va-motion-shake keyframes）——本 composable 只负责\n * 「同一元素连续触发时重启动画」：动画结束类仍挂在元素上，直接重挂类不会重播，\n * 需先移除、强制 reflow、再挂回（经典 restart 手法，同步无闪烁）。\n *\n * 目标元素二选一：传入既有 template ref（元素已有 ref 时，如 VaOtpInput 的根节点），\n * 或不传——使用组件模板里 ref=\"shake\" 的元素（如 VaStepperForm 的步骤体）。\n * reduced-motion 下 .va-shake 由 motion.css 媒体块降级为不播，本函数无需感知。\n *\n * 可感知性提示：微振只做注意力引导，错误语义应由宿主同时以文案/aria 披露\n * （如 aria-invalid + 错误描述），不能只依赖视觉动效。\n */\n\n\nfunction useShake(target?: MaybeRefOrGetter<HTMLElement | null | undefined>) {\n  const fallbackEl = useTemplateRef<HTMLElement>(\"shake\");\n\n  /** 播放一次微振：移除类 → 强制 reflow → 挂回（同一元素连续调用同样有效） */\n  function shake() {\n    const node = target !== undefined ? toValue(target) : fallbackEl.value;\n    if (!node) return;\n    node.classList.remove(\"va-shake\");\n    void node.offsetWidth; // 强制 reflow：重启 animation\n    node.classList.add(\"va-shake\");\n  }\n\n  return { shake };\n}\n</script>\n\n<template>\n  <div\n    ref=\"root\"\n    class=\"va-otp\"\n    role=\"group\"\n    :aria-label=\"props.label ?? '验证码输入'\"\n    @paste=\"onPaste\"\n  >\n    <input\n      v-for=\"(_, i) in len\"\n      :key=\"i\"\n      class=\"va-otp__cell\"\n      :class=\"{ 'va-otp__cell--filled': chars[i] !== '' }\"\n      type=\"text\"\n      inputmode=\"numeric\"\n      autocomplete=\"one-time-code\"\n      maxlength=\"1\"\n      :value=\"chars[i]\"\n      :placeholder=\"props.placeholder ?? ''\"\n      :disabled=\"props.disabled\"\n      :aria-label=\"`第 ${i + 1} 位`\"\n      @input=\"onInput(i, $event)\"\n      @keydown=\"onKeydown(i, $event)\"\n      @focus=\"(($event.target) as HTMLInputElement).select()\"\n    >\n    <span v-if=\"filled\" class=\"va-otp__done\" aria-hidden=\"true\">✓</span>\n  </div>\n</template>\n\n<style>\n/* VaOtpInput — 验证码格子输入 */\n\n.va-otp {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--va-s3, 8px);\n}\n\n.va-otp__cell {\n  width: 42px;\n  height: 48px;\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-s, 8px);\n  background: var(--va-card, #ffffff);\n  color: var(--va-ink, #1a1917);\n  font-family: var(--va-font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);\n  font-size: var(--va-fs-2xl, 20px);\n  text-align: center;\n  transition: border-color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), box-shadow var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-otp__cell:focus {\n  outline: none;\n  border-color: var(--va-accent, #c2410c);\n  box-shadow: 0 0 0 3px var(--va-accent-soft, rgba(194, 65, 12, 0.1));\n}\n\n.va-otp__cell--filled { border-color: var(--va-edge-strong, rgba(26, 25, 23, 0.22)); }\n.va-otp__cell:disabled { opacity: 0.5; background: var(--va-bg-subtle, #efede7); }\n\n.va-otp__done {\n  color: var(--va-success, #1a7f4b);\n  font-size: var(--va-fs-xl, 16px);\n  font-weight: var(--va-fw-bold, 700);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-otp__cell { transition: none; }\n}\n\n/* 动效工具类（自动附带，源码中来自全局 motion.css） */\n/* ============================================================\n   共享动效工具类 —— 进出场/交叉淡入的统一协议（TASK-102 动效基建）。\n   组件不逐个发明入场曲线：统一消费 --va-dur-in/--va-dur-out 骨架时长与\n   --va-dist-* 位移档；每条声明自带字面 fallback（registry 单文件拷贝分发\n   要求，与 tokens.css 门禁一致）。\n\n   接入方式二选一：\n   1. Vue <Transition>：\n      <Transition enter-active-class=\"va-enter-up\" leave-active-class=\"va-exit-up\">\n      动画 fill-mode 为 both（延迟期间保持首帧、播完停在终态），\n      无需再配 enter-from-class / leave-to-class；\n   2. 类切换重挂载：骨架 → 内容换节点时给新节点挂 .va-crossfade（纯淡入），\n      离场节点挂 .va-exit-*（更短更快）。\n\n   列表错峰：v-for 子项 :style=\"useStagger().delayStyle(i)\" 配合 .va-enter-*\n   动画类使用（animation-delay 由 composable 编排——.va-enter-* 为 CSS animation，\n   transition-delay 对其零作用，见 composables/useStagger.ts）。\n   ============================================================ */\n\n/* 入场：上浮（自下方 --va-dist-m 浮起） */\n@keyframes va-motion-in-up {\n  from { opacity: 0; transform: translateY(var(--va-dist-m, 8px)); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* 入场：左滑（自左侧 --va-dist-m 滑入） */\n@keyframes va-motion-in-left {\n  from { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n  to { opacity: 1; transform: translateX(0); }\n}\n\n/* 入场：缩放（96% 起放大至原尺寸） */\n@keyframes va-motion-in-scale {\n  from { opacity: 0; transform: scale(0.96); }\n  to { opacity: 1; transform: scale(1); }\n}\n\n/* 离场：与入场互逆（向上/向左飘出、缩回）；时长/曲线由工具类映射 --va-dur-out 骨架 */\n@keyframes va-motion-out-up {\n  from { opacity: 1; transform: translateY(0); }\n  to { opacity: 0; transform: translateY(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-left {\n  from { opacity: 1; transform: translateX(0); }\n  to { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-scale {\n  from { opacity: 1; transform: scale(1); }\n  to { opacity: 0; transform: scale(0.96); }\n}\n\n/* 交叉淡入/淡出（.va-crossfade 骨架→内容交换专用，无位移，避免占位跳变叠加） */\n@keyframes va-motion-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes va-motion-fade-out {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n/* ---- 工具类：入场走 --va-dur-in + ease-out-quart，离场走 --va-dur-out + ease-in-quad ---- */\n\n.va-enter-up {\n  animation: va-motion-in-up var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-left {\n  animation: va-motion-in-left var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-scale {\n  animation: va-motion-in-scale var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-exit-up {\n  animation: va-motion-out-up var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-left {\n  animation: va-motion-out-left var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-scale {\n  animation: va-motion-out-scale var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n/* 骨架 → 内容交叉过渡：新内容纯淡入 */\n.va-crossfade {\n  animation: va-motion-fade-in var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* 空态/轻量状态渐入（TASK-106 弱化档）：仅 opacity、时长走 --va-dur-2，\n   供列表空态提示与一次性状态块使用（空态清单见 TASK-106 报告）。\n   纯 opacity 即动效分频策略的降级终点形态，reduced-motion 下保持原样即可。 */\n.va-fade-in {\n  animation: va-motion-fade-in var(--va-dur-2, 200ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* ---- 静态光斑基类（TASK-105，决策 5「追光」路线基建）----\n   pointer 坐标由 composables/useSpotlight.ts 以 rAF 节流写入 --va-spot-x/y\n   （元素内百分比，光斑数学在 composable 内可单测）；本类只负责 radial 光斑\n   绘制与显隐（:hover 点亮，无 3D 倾斜， glare 数学对齐 VaTiltCard）。\n   --va-spot-* 为 L3 组件钩子口径（宿主可覆盖尺寸/颜色），不进 tokens.css。\n   双降级对齐 VaTiltCard glare：hover: none（触屏）与 reduced-motion 不绘制。 */\n.va-spotlight { position: relative; }\n\n/* ::after 承载光斑（避开组件自身 ::before 用途）；inset 0 + border-radius inherit\n   使光斑天然裁剪在宿主圆角内，无需 overflow: hidden。\n   注意：此 ::after radial 与 components/spotlight-card/VaSpotlightCard.css 的\n   .va-spot-card--spot::after 为 registry 单文件自含有意复制，改动需两处同步。 */\n.va-spotlight::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n  background: radial-gradient(\n    var(--va-spot-size, 240px) circle at var(--va-spot-x, 50%) var(--va-spot-y, 50%),\n    var(--va-spot-color, rgba(255, 255, 255, 0.14)),\n    transparent 65%\n  );\n}\n\n.va-spotlight:hover::after { opacity: 1; }\n\n@media (hover: none) {\n  .va-spotlight::after { display: none; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-spotlight::after { display: none; }\n}\n\n/* ---- 复制反馈标准（TASK-106）：copy→check 交叉过渡 ----\n   容器 .va-copy 为 inline-grid 双内容同格堆叠（格子宽取较宽子项，切换零跳动）：\n   __idle = copy 态内容（图标/文字），__done = check 态内容。\n   copied 置真挂 .va-copy--done：check 以 ease-spring 微弹入场（进入 done 态时\n   transform 的目标态时序换成 --va-ease-spring → 过冲回弹），交叉时长统一 --va-dur-1。\n   消费方：terminal-log（行复制）、code-diff（复制按钮）、message-actions（复制图标）。 */\n.va-copy { display: inline-grid; place-items: center; }\n\n.va-copy__idle,\n.va-copy__done {\n  grid-area: 1 / 1;\n  transition: opacity var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-copy__idle { opacity: 1; transform: scale(1); }\n.va-copy__done { opacity: 0; transform: scale(0.6); }\n\n.va-copy--done .va-copy__done {\n  opacity: 1;\n  transform: scale(1);\n  /* 时序按 transition 属性顺序映射：opacity 仍 ease，transform 换 ease-spring 微弹 */\n  transition-timing-function: var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), var(--va-ease-spring, cubic-bezier(0.34, 1.56, 0.64, 1));\n}\n\n.va-copy--done .va-copy__idle { opacity: 0; transform: scale(0.6); }\n\n@media (prefers-reduced-motion: reduce) {\n  /* 交叉过渡瞬时完成（无位移动画），copied 状态可感知性不受影响 */\n  .va-copy__idle,\n  .va-copy__done { transition: none; }\n}\n\n/* ---- 错误反馈标准（校验失败横向微振）：目标元素挂 .va-shake 播一次 ±3px 微振 ----\n   时长 --va-dur-2 × 2（两拍四峰，克制的「摇头」量级，rubric 校验失败口径）；\n   重复触发需先移除类、强制 reflow 再挂回（封装见 composables/useShake.ts）。\n   reduced-motion 降级为不播：错误状态的可感知性由错误样式本身（描边/文案）承担，\n   动效只做注意力引导——符合头注释「功能动画降级保留状态可感知」的分频策略。\n   消费方：VaStepperForm / VaOtpInput 经 useShake() 程序化触发（defineExpose shake()）；\n   宿主自绘表单可直接挂类。 */\n@keyframes va-motion-shake {\n  20% { transform: translateX(-3px); }\n  40% { transform: translateX(3px); }\n  60% { transform: translateX(-2px); }\n  80% { transform: translateX(2px); }\n}\n\n.va-shake {\n  animation: va-motion-shake calc(var(--va-dur-2, 200ms) * 2) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-shake { animation: none; }\n}\n\n/* ---- 动效分频（对齐 tokens.css 头注释策略）：\n   功能动画降级为纯 opacity——进/出场整体换成 fade keyframes，\n   位移/缩放不再出现（animation-name 顶替，时长/缓动沿用上面的声明）。 */\n@media (prefers-reduced-motion: reduce) {\n  .va-enter-up,\n  .va-enter-left,\n  .va-enter-scale,\n  .va-crossfade {\n    animation-name: va-motion-fade-in;\n  }\n\n  .va-exit-up,\n  .va-exit-left,\n  .va-exit-scale {\n    animation-name: va-motion-fade-out;\n  }\n}\n</style>\n"
    },
    {
      "path": "components/ui/otp-input/index.ts",
      "type": "registry:ui",
      "target": "components/ui/otp-input/index.ts",
      "content": "export { default as VaOtpInput } from \"./VaOtpInput.vue\";\nexport type { OtpInputEvents, OtpInputProps } from \"./types\";\n"
    },
    {
      "path": "components/ui/otp-input/types.ts",
      "type": "registry:ui",
      "target": "components/ui/otp-input/types.ts",
      "content": "/** VaOtpInput 的类型定义 */\n\nexport interface OtpInputProps {\n  /** 格子数，默认 6 */\n  length?: number;\n  /** 受控值（配合 @update:modelValue 实现 v-model） */\n  modelValue?: string;\n  placeholder?: string;\n  /** 禁用 */\n  disabled?: boolean;\n  /** 完成后是否自动把焦点移出 */\n  autofocusLeave?: boolean;\n  /** 输入框组 aria-label */\n  label?: string;\n}\n\nexport interface OtpInputEvents {\n  \"update:modelValue\": [v: string];\n  /** 全部填满时触发一次（重新编辑后再满会再次触发） */\n  complete: [v: string];\n}\n"
    }
  ]
}
