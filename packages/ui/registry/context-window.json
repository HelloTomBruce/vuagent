{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "context-window",
  "title": "Context Window",
  "description": "上下文可视化：按 token 占比的格子场，悬停点亮、文件可移除、压缩对话时历史微光收缩。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `parts` (ContextPart[]，默认 -)：id/label/tokens/kind(system|file|history|tools)\n- `capacity` (number，默认 -)：容量 tokens，如 128_000\n- `compacting` (boolean，默认 false)：压缩动画进行中\n- `@remove / @compact` (-，默认 -)：移除文件 / 请求压缩",
  "files": [
    {
      "path": "components/ui/context-window/VaContextWindow.vue",
      "type": "registry:ui",
      "target": "components/ui/context-window/VaContextWindow.vue",
      "content": "<script setup lang=\"ts\">\nimport type { ContextPart, ContextWindowProps } from \"./types\";\nimport { CONTEXT_KIND_LABEL } from \"./types\";\nimport { useContextWindow } from \"./useContextWindow\";\nimport { formatTokens } from \"../../utils/format\";\n\nconst props = withDefaults(defineProps<ContextWindowProps>(), {\n  compacting: false,\n  removable: true,\n});\n\nconst emit = defineEmits<{ remove: [part: ContextPart]; compact: [] }>();\n\nconst { used, percent, hasHistory, shrinking, widthOf, legendKinds } = useContextWindow(props);\n</script>\n\n<template>\n  <div class=\"va-ctx\" :class=\"{ 'va-ctx--compacting': props.compacting }\" role=\"img\" :aria-label=\"`上下文已用 ${formatTokens(used)} / ${formatTokens(props.capacity)}`\">\n    <header class=\"va-ctx__head\">\n      <span class=\"va-ctx__used\">\n        <strong>{{ formatTokens(used) }}</strong> / {{ formatTokens(props.capacity) }}\n      </span>\n      <span class=\"va-ctx__pct\">{{ Math.round(percent) }}%</span>\n      <button\n        class=\"va-ctx__compact\"\n        type=\"button\"\n        :disabled=\"props.compacting || !hasHistory\"\n        @click=\"emit('compact')\"\n      >\n        {{ props.compacting ? \"压缩中…\" : \"压缩对话\" }}\n      </button>\n    </header>\n\n    <div class=\"va-ctx__bar\" aria-hidden=\"true\">\n      <div\n        v-for=\"p in props.parts\"\n        :key=\"p.id\"\n        class=\"va-ctx__cell\"\n        :data-kind=\"p.kind\"\n        :data-shrink=\"shrinking(p) || undefined\"\n        :style=\"{ width: widthOf(p) }\"\n        tabindex=\"0\"\n      >\n        <button\n          v-if=\"props.removable && p.kind === 'file'\"\n          class=\"va-ctx__remove\"\n          type=\"button\"\n          :aria-label=\"`移除 ${p.label}`\"\n          @click.stop=\"emit('remove', p)\"\n          @keydown.enter.stop=\"emit('remove', p)\"\n        >×</button>\n        <span class=\"va-ctx__tip\">\n          <strong>{{ p.label }}</strong>\n          <em>{{ CONTEXT_KIND_LABEL[p.kind] }} · {{ formatTokens(p.tokens) }} tokens</em>\n        </span>\n      </div>\n    </div>\n\n    <footer class=\"va-ctx__legend\">\n      <span v-for=\"k in legendKinds\" :key=\"k\" class=\"va-ctx__legend-item\">\n        <i :data-kind=\"k\" />{{ CONTEXT_KIND_LABEL[k] }}\n      </span>\n    </footer>\n  </div>\n</template>\n\n<style>\n/* VaContextWindow — 模型上下文的格子场可视化 */\n.va-ctx {\n  --_edge: var(--va-ctx-edge, var(--va-edge, rgba(26, 25, 23, 0.12)));\n  --_muted: var(--va-ctx-muted, var(--va-muted, #6f6d66));\n  --_ink: var(--va-ctx-ink, var(--va-ink, #1a1917));\n  --_accent: var(--va-ctx-accent, var(--va-accent, #c2410c));\n  font-family: var(--va-font, system-ui, sans-serif);\n}\n\n.va-ctx__head { display: flex; align-items: center; gap: var(--va-s3, 8px); margin-bottom: var(--va-s3, 8px); }\n.va-ctx__used { font-size: 12.5px; color: var(--_muted); }\n.va-ctx__used strong { color: var(--_ink); font-variant-numeric: tabular-nums; }\n.va-ctx__pct { font-size: 11.5px; color: var(--_muted); font-variant-numeric: tabular-nums; }\n\n.va-ctx__compact {\n  margin-left: auto;\n  height: 26px;\n  padding: 0 var(--va-s4, 12px);\n  border-radius: var(--va-radius-pill, 999px);\n  border: 1px solid var(--_edge);\n  background: var(--va-card, #fff);\n  color: var(--_ink);\n  font-size: 12px;\n  cursor: pointer;\n  font-family: inherit;\n  transition: border-color var(--va-dur-1, 120ms) ease;\n}\n.va-ctx__compact:hover:not(:disabled) { border-color: var(--va-edge-strong, rgba(26, 25, 23, 0.22)); }\n.va-ctx__compact:disabled { opacity: 0.45; cursor: default; }\n.va-ctx__compact:focus-visible { outline: 2px solid var(--_accent); outline-offset: 1px; }\n\n/* 格子场 */\n.va-ctx__bar {\n  display: flex;\n  gap: 3px;\n  height: 34px;\n  border-radius: var(--va-radius-s, 8px);\n  overflow: hidden;\n  padding: 3px;\n  background: var(--va-bg-subtle, #efede7);\n}\n\n.va-ctx__cell {\n  position: relative;\n  min-width: 10px;\n  border-radius: 5px;\n  transition: width var(--va-dur-3, 300ms) var(--va-ease, ease), filter var(--va-dur-1, 120ms) ease;\n  background: var(--va-edge, rgba(0, 0, 0, 0.12));\n  outline: none;\n}\n.va-ctx__cell[data-kind=\"system\"] { background: color-mix(in srgb, var(--va-ink, #1a1917) 24%, transparent); }\n.va-ctx__cell[data-kind=\"file\"] { background: color-mix(in srgb, var(--_accent) 55%, transparent); }\n.va-ctx__cell[data-kind=\"history\"] { background: color-mix(in srgb, var(--va-info, #2563eb) 42%, transparent); }\n.va-ctx__cell[data-kind=\"tools\"] { background: color-mix(in srgb, var(--va-success, #1a7f4b) 42%, transparent); }\n\n.va-ctx__cell:hover, .va-ctx__cell:focus-visible { filter: brightness(1.15) saturate(1.2); }\n.va-ctx__cell:focus-visible { outline: 2px solid var(--_accent); outline-offset: -1px; }\n\n.va-ctx__cell[data-shrink] {\n  animation: va-ctx-shimmer 0.9s linear infinite;\n  transition: width 0.7s var(--va-ease, ease);\n}\n@keyframes va-ctx-shimmer {\n  0%, 100% { filter: brightness(1); }\n  50% { filter: brightness(1.6); }\n}\n\n/* 移除按钮 */\n.va-ctx__remove {\n  position: absolute;\n  top: 2px;\n  right: 2px;\n  width: 14px;\n  height: 14px;\n  border: 0;\n  border-radius: 50%;\n  background: rgba(0, 0, 0, 0.45);\n  color: #fff;\n  font-size: 10px;\n  line-height: 1;\n  cursor: pointer;\n  opacity: 0;\n  transition: opacity var(--va-dur-1, 120ms) ease;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  padding: 0;\n}\n.va-ctx__cell:hover .va-ctx__remove, .va-ctx__cell:focus-visible .va-ctx__remove { opacity: 1; }\n.va-ctx__remove:focus-visible { opacity: 1; outline: 1px solid #fff; }\n\n/* 悬停提示 */\n.va-ctx__tip {\n  position: absolute;\n  bottom: calc(100% + 6px);\n  left: 50%;\n  transform: translateX(-50%);\n  display: none;\n  flex-direction: column;\n  gap: 1px;\n  background: var(--va-ink, #1a1917);\n  color: var(--va-card, #fff);\n  border-radius: var(--va-radius-s, 8px);\n  padding: 5px 9px;\n  font-size: 11px;\n  line-height: 1.4;\n  white-space: nowrap;\n  z-index: 5;\n  pointer-events: none;\n}\n.va-ctx__tip strong { font-weight: 600; }\n.va-ctx__tip em { font-style: normal; opacity: 0.72; font-size: 10.5px; }\n.va-ctx__cell:hover .va-ctx__tip, .va-ctx__cell:focus-visible .va-ctx__tip { display: flex; }\n\n/* 图例 */\n.va-ctx__legend { display: flex; gap: var(--va-s4, 12px); margin-top: var(--va-s3, 8px); flex-wrap: wrap; }\n.va-ctx__legend-item { display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px; color: var(--_muted); }\n.va-ctx__legend-item i {\n  width: 9px;\n  height: 9px;\n  border-radius: 3px;\n  background: var(--va-edge, rgba(0, 0, 0, 0.12));\n}\n.va-ctx__legend-item i[data-kind=\"system\"] { background: color-mix(in srgb, var(--va-ink, #1a1917) 24%, transparent); }\n.va-ctx__legend-item i[data-kind=\"file\"] { background: color-mix(in srgb, var(--_accent) 55%, transparent); }\n.va-ctx__legend-item i[data-kind=\"history\"] { background: color-mix(in srgb, var(--va-info, #2563eb) 42%, transparent); }\n.va-ctx__legend-item i[data-kind=\"tools\"] { background: color-mix(in srgb, var(--va-success, #1a7f4b) 42%, transparent); }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-ctx__cell, .va-ctx__remove { transition: none; }\n  .va-ctx__cell[data-shrink] { animation: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/context-window/types.ts",
      "type": "registry:ui",
      "target": "components/ui/context-window/types.ts",
      "content": "/** VaContextWindow 的类型定义 */\n\nexport type ContextKind = \"system\" | \"file\" | \"history\" | \"tools\";\n\nexport interface ContextPart {\n  id: string;\n  /** 悬停提示的名称，如 \"router.ts\" */\n  label: string;\n  tokens: number;\n  kind: ContextKind;\n}\n\nexport interface ContextWindowProps {\n  parts: ContextPart[];\n  /** 模型上下文容量（tokens），如 128_000 */\n  capacity: number;\n  /** 压缩中：历史格子微光收缩，结束后父层替换 parts */\n  compacting?: boolean;\n  /** 是否允许移除文件格子 */\n  removable?: boolean;\n}\n\nexport interface ContextWindowEvents {\n  remove: [part: ContextPart];\n  compact: [];\n}\n\nexport const CONTEXT_KIND_LABEL: Record<ContextKind, string> = {\n  system: \"系统提示\",\n  file: \"文件\",\n  history: \"对话历史\",\n  tools: \"工具结果\",\n};\n"
    },
    {
      "path": "components/ui/context-window/useContextWindow.ts",
      "type": "registry:ui",
      "target": "components/ui/context-window/useContextWindow.ts",
      "content": "import { computed } from \"vue\";\nimport { CONTEXT_KIND_LABEL, type ContextKind, type ContextPart, type ContextWindowProps } from \"./types\";\n\n/** VaContextWindow 的状态逻辑：占用汇总、格子宽度、压缩收缩 */\nexport function useContextWindow(props: ContextWindowProps) {\n  const used = computed(() => props.parts.reduce((t, p) => t + p.tokens, 0));\n  const scale = computed(() => Math.max(props.capacity, used.value, 1));\n  const percent = computed(() => Math.min(100, (used.value / props.capacity) * 100));\n\n  const hasHistory = computed(() => props.parts.some((p) => p.kind === \"history\"));\n\n  /** 压缩中只收缩历史格子 */\n  function shrinking(p: ContextPart) {\n    return props.compacting && p.kind === \"history\";\n  }\n  function widthOf(p: ContextPart) {\n    if (shrinking(p)) return \"0%\";\n    return `${Math.max((p.tokens / scale.value) * 100, 2)}%`;\n  }\n\n  const legendKinds = Object.keys(CONTEXT_KIND_LABEL) as ContextKind[];\n\n  return { used, scale, percent, hasHistory, shrinking, widthOf, legendKinds };\n}\n"
    }
  ]
}
