{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "kpi-chart",
  "title": "KPI Chart",
  "description": "指标卡 + sparkline：手写 SVG 折线（中点平滑/面积渐变/描线入场），环比涨跌徽章（invertDelta 适配错误率类「跌=好」），aria 摘要。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `label / value / series` (string / number / number[]，默认 -)：指标名、当前值、趋势序列\n- `delta / deltaLabel` (number / string，默认 -)：环比小数（0.12=+12%）与参照文案\n- `invertDelta` (boolean，默认 false)：下跌视为好（错误率场景）\n- `width / height / color` (number / number / string，默认 120 / 36 / accent)：sparkline 尺寸与线色",
  "files": [
    {
      "path": "components/ui/kpi-chart/VaKpiChart.vue",
      "type": "registry:ui",
      "target": "components/ui/kpi-chart/VaKpiChart.vue",
      "content": "<script setup lang=\"ts\">import { computed, useAttrs } from \"vue\";\n\nimport type { KpiChartEvents, KpiChartProps } from \"./types\";\n\n\nconst props = defineProps<KpiChartProps>();\n\nconst emit = defineEmits<KpiChartEvents>();\n\nconst attrs = useAttrs();\nconst clickable = computed(() => \"onClick\" in attrs);\n\n/** 稳定 hash（SSR/水合一致，不用 Math.random） */\nfunction hash(s: string): number {\n  let h = 0;\n  for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0;\n  return h;\n}\n\nconst display = computed(() => props.value.toLocaleString(\"en-US\", props.format));\n\nconst trend = computed(() => {\n  if (props.delta === undefined) return null;\n  const up = props.delta >= 0;\n  const good = props.invertDelta ? !up : up;\n  return { up, good, text: `${up ? \"+\" : \"−\"}${Math.abs(Math.round(props.delta * 100))}%` };\n});\n\nconst geo = computed(() => sparkline(props.series, props.width ?? 120, props.height ?? 36));\n\nconst ariaSummary = computed(() => {\n  const s = props.series;\n  const trendText = trend.value ? `，${trend.value.text} ${props.deltaLabel ?? \"\"}`.trim() : \"\";\n  return `${props.label}：${display.value}${trendText}，最近 ${s.length} 个点从 ${s[0]} 到 ${s[s.length - 1]}`;\n});\n\nconst color = computed(() => props.color ?? \"var(--va-accent)\");\nconst areaId = `va-kpi-grad-${Math.abs(hash(props.label + display.value))}`;\n\n/* ── 内联自 @vuagent/ui src/utils/sparkline.ts（registry 单文件拷贝自包含） ── */\n/**\n * 零依赖 sparkline：数值序列 → SVG path（折线/平滑 + 面积闭合）。\n * 纯计算无 DOM，SSR 安全；供 KpiChart 等图表组件复用，也可独立使用。\n */\n\ninterface SparklineGeometry {\n  /** 折线 path（M/L 或平滑 Q） */\n  line: string;\n  /** 面积 path（line + 底边闭合） */\n  area: string;\n  /** 归一化后的坐标点（CSS px） */\n  points: Array<[number, number]>;\n  /** 数据的最小/最大值 */\n  min: number;\n  max: number;\n}\n\ninterface SparklineOptions {\n  /** 中点二次贝塞尔平滑（默认 true；false 为直线段） */\n  smooth?: boolean;\n  /** 上下留白 px（默认 2，防止线贴边裁切） */\n  pad?: number;\n}\n\n/** 数值序列 → SVG path 几何；空序列返回空 path */\nfunction sparkline(\n  values: number[],\n  width: number,\n  height: number,\n  opts: SparklineOptions = {},\n): SparklineGeometry {\n  const { smooth = true, pad = 2 } = opts;\n  const n = values.length;\n\n  if (n === 0) {\n    return { line: \"\", area: \"\", points: [], min: 0, max: 0 };\n  }\n\n  let min = Infinity;\n  let max = -Infinity;\n  for (const v of values) {\n    if (v < min) min = v;\n    if (v > max) max = v;\n  }\n  // 单点或全相同：画中线，避免 0 除\n  if (min === max) {\n    min -= 1;\n    max += 1;\n  }\n\n  const innerH = height - pad * 2;\n  const x = (i: number) => (n === 1 ? width / 2 : (i / (n - 1)) * width);\n  const y = (v: number) => pad + innerH - ((v - min) / (max - min)) * innerH;\n\n  const points: Array<[number, number]> = values.map((v, i) => [x(i), y(v)]);\n\n  let line: string;\n  if (!smooth || n < 3) {\n    line = points.map(([px, py], i) => `${i === 0 ? \"M\" : \"L\"}${r__va1(px)},${r__va1(py)}`).join(\" \");\n  } else {\n    // 中点平滑：Q 控制点取相邻点，落在中点上，保证曲线过每个中点且不越界\n    line = `M${r__va1(points[0]![0])},${r__va1(points[0]![1])}`;\n    for (let i = 1; i < n - 1; i++) {\n      const [cx, cy] = points[i]!;\n      const [nx, ny] = points[i + 1]!;\n      line += ` Q${r__va1(cx)},${r__va1(cy)} ${r__va1((cx + nx) / 2)},${r__va1((cy + ny) / 2)}`;\n    }\n    const [lx, ly] = points[n - 1]!;\n    line += ` L${r__va1(lx)},${r__va1(ly)}`;\n  }\n\n  const area = points.length ? `${line} L${r__va1(points[n - 1]![0])},${r__va1(height)} L${r__va1(points[0]![0])},${r__va1(height)} Z` : \"\";\n\n  return { line, area, points, min, max };\n}\n\n/** 两位小数取整（path 简短） */\nfunction r__va1(v: number): number {\n  return Math.round(v * 100) / 100;\n}\n</script>\n\n<template>\n  <div\n    class=\"va-kpi\"\n    :class=\"{ 'va-kpi--clickable': clickable }\"\n    role=\"img\"\n    :aria-label=\"ariaSummary\"\n    v-bind=\"attrs\"\n    @click=\"emit('click')\"\n  >\n    <span class=\"va-kpi__label\">{{ props.label }}</span>\n    <div class=\"va-kpi__row\">\n      <strong class=\"va-kpi__value\">{{ display }}</strong>\n      <span v-if=\"trend\" class=\"va-kpi__delta\" :data-good=\"trend.good\">\n        <span aria-hidden=\"true\">{{ trend.up ? \"↑\" : \"↓\" }}</span>{{ trend.text }}\n      </span>\n    </div>\n    <span v-if=\"props.deltaLabel && trend\" class=\"va-kpi__vs\">{{ props.deltaLabel }}</span>\n\n    <svg\n      v-if=\"geo.points.length > 1\"\n      class=\"va-kpi__spark\"\n      :viewBox=\"`0 0 ${props.width ?? 120} ${props.height ?? 36}`\"\n      :width=\"props.width ?? 120\"\n      :height=\"props.height ?? 36\"\n      aria-hidden=\"true\"\n      preserveAspectRatio=\"none\"\n    >\n      <defs>\n        <linearGradient :id=\"areaId\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n          <stop offset=\"0%\" :stop-color=\"color\" stop-opacity=\"0.22\" />\n          <stop offset=\"100%\" :stop-color=\"color\" stop-opacity=\"0\" />\n        </linearGradient>\n      </defs>\n      <path :d=\"geo.area\" :fill=\"`url(#${areaId})`\" />\n      <path :d=\"geo.line\" fill=\"none\" :stroke=\"color\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" />\n    </svg>\n  </div>\n</template>\n\n<style>\n/* VaKpiChart — KPI 指标卡 + sparkline */\n\n.va-kpi {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-m, 10px);\n  background: var(--va-card, #ffffff);\n  padding: var(--va-s4, 12px) var(--va-s5, 16px);\n  min-width: 180px;\n}\n\n.va-kpi--clickable { cursor: pointer; transition: border-color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)); }\n.va-kpi--clickable:hover { border-color: var(--va-edge-strong, rgba(26, 25, 23, 0.22)); }\n.va-kpi--clickable:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: 1px; }\n\n.va-kpi__label { font-size: var(--va-fs-sm, 12px); color: var(--va-muted, #6f6d66); }\n\n.va-kpi__row {\n  display: flex;\n  align-items: baseline;\n  gap: var(--va-s3, 8px);\n  flex-wrap: wrap;\n}\n\n.va-kpi__value {\n  font-size: 22px; /* display 豁免：KPI 数值展示，不入 scale */\n  font-weight: var(--va-fw-bold, 700);\n  color: var(--va-ink, #1a1917);\n  font-variant-numeric: tabular-nums;\n  line-height: 1.2;\n}\n\n.va-kpi__delta {\n  font-size: var(--va-fs-sm, 12px);\n  font-weight: var(--va-fw-semibold, 600);\n  font-variant-numeric: tabular-nums;\n  display: inline-flex;\n  align-items: center;\n  gap: 2px;\n}\n\n.va-kpi__delta[data-good=\"true\"] { color: var(--va-success, #1a7f4b); }\n.va-kpi__delta[data-good=\"false\"] { color: var(--va-danger, #d5453c); }\n\n.va-kpi__vs { font-size: var(--va-fs-xs, 11px); color: var(--va-muted, #6f6d66); }\n\n.va-kpi__spark {\n  margin-top: var(--va-s3, 8px);\n  display: block;\n  width: 100%;\n  overflow: visible;\n}\n\n/* 描线入场（reduced-motion 降级为直出） */\n.va-kpi__spark path[stroke] {\n  stroke-dasharray: 600;\n  stroke-dashoffset: 600;\n  animation: va-kpi-draw 1.1s var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)) forwards;\n}\n\n@keyframes va-kpi-draw {\n  to { stroke-dashoffset: 0; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-kpi__spark path[stroke] { animation: none; stroke-dashoffset: 0; }\n  .va-kpi--clickable { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/kpi-chart/index.ts",
      "type": "registry:ui",
      "target": "components/ui/kpi-chart/index.ts",
      "content": "export { default as VaKpiChart } from \"./VaKpiChart.vue\";\nexport type { KpiChartEvents, KpiChartProps } from \"./types\";\n"
    },
    {
      "path": "components/ui/kpi-chart/types.ts",
      "type": "registry:ui",
      "target": "components/ui/kpi-chart/types.ts",
      "content": "/** VaKpiChart 的类型定义 */\n\nexport interface KpiChartProps {\n  /** 指标名，如「今日 agent 运行」 */\n  label: string;\n  /** 当前值 */\n  value: number;\n  /** 数值格式化（Intl.NumberFormatOptions，如货币/百分数） */\n  format?: Intl.NumberFormatOptions;\n  /** 环比变化（小数，0.12 = +12%）；正负决定涨跌色与箭头 */\n  delta?: number;\n  /** 变化率的参照文案，如「较上周」 */\n  deltaLabel?: string;\n  /** sparkline 数据序列 */\n  series: number[];\n  /** sparkline 尺寸 px（默认 120×36） */\n  width?: number;\n  height?: number;\n  /** 线条主色（CSS 色），默认 accent */\n  color?: string;\n  /** 涨=好（默认）/跌=好（如错误率场景翻转变色） */\n  invertDelta?: boolean;\n}\n\nexport interface KpiChartEvents {\n  /** 点击卡片 */\n  click: [];\n}\n"
    }
  ]
}
