{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "kpi-chart",
  "title": "KPI Chart",
  "description": "指标卡 + sparkline：手写 SVG 折线（中点平滑/面积渐变/描线入场），环比涨跌徽章（invertDelta 适配错误率类「跌=好」），aria 摘要。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `label / value / series` (string / number / number[]，默认 -)：指标名、当前值、趋势序列\n- `delta / deltaLabel` (number / string，默认 -)：环比小数（0.12=+12%）与参照文案\n- `invertDelta` (boolean，默认 false)：下跌视为好（错误率场景）\n- `width / height / color` (number / number / string，默认 120 / 36 / accent)：sparkline 尺寸与线色",
  "files": [
    {
      "path": "components/ui/kpi-chart/VaKpiChart.vue",
      "type": "registry:ui",
      "target": "components/ui/kpi-chart/VaKpiChart.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, useAttrs } from \"vue\";\nimport type { KpiChartEvents, KpiChartProps } from \"./types\";\nimport { sparkline } from \"../../utils/sparkline\";\n\nconst props = defineProps<KpiChartProps>();\n\nconst emit = defineEmits<KpiChartEvents>();\n\nconst attrs = useAttrs();\nconst clickable = computed(() => \"onClick\" in attrs);\n\n/** 稳定 hash（SSR/水合一致，不用 Math.random） */\nfunction hash(s: string): number {\n  let h = 0;\n  for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0;\n  return h;\n}\n\nconst display = computed(() => props.value.toLocaleString(\"en-US\", props.format));\n\nconst trend = computed(() => {\n  if (props.delta === undefined) return null;\n  const up = props.delta >= 0;\n  const good = props.invertDelta ? !up : up;\n  return { up, good, text: `${up ? \"+\" : \"−\"}${Math.abs(Math.round(props.delta * 100))}%` };\n});\n\nconst geo = computed(() => sparkline(props.series, props.width ?? 120, props.height ?? 36));\n\nconst ariaSummary = computed(() => {\n  const s = props.series;\n  const trendText = trend.value ? `，${trend.value.text} ${props.deltaLabel ?? \"\"}`.trim() : \"\";\n  return `${props.label}：${display.value}${trendText}，最近 ${s.length} 个点从 ${s[0]} 到 ${s[s.length - 1]}`;\n});\n\nconst color = computed(() => props.color ?? \"var(--va-accent)\");\nconst areaId = `va-kpi-grad-${Math.abs(hash(props.label + display.value))}`;\n</script>\n\n<template>\n  <div\n    class=\"va-kpi\"\n    :class=\"{ 'va-kpi--clickable': clickable }\"\n    role=\"img\"\n    :aria-label=\"ariaSummary\"\n    v-bind=\"attrs\"\n    @click=\"emit('click')\"\n  >\n    <span class=\"va-kpi__label\">{{ props.label }}</span>\n    <div class=\"va-kpi__row\">\n      <strong class=\"va-kpi__value\">{{ display }}</strong>\n      <span v-if=\"trend\" class=\"va-kpi__delta\" :data-good=\"trend.good\">\n        <span aria-hidden=\"true\">{{ trend.up ? \"↑\" : \"↓\" }}</span>{{ trend.text }}\n      </span>\n    </div>\n    <span v-if=\"props.deltaLabel && trend\" class=\"va-kpi__vs\">{{ props.deltaLabel }}</span>\n\n    <svg\n      v-if=\"geo.points.length > 1\"\n      class=\"va-kpi__spark\"\n      :viewBox=\"`0 0 ${props.width ?? 120} ${props.height ?? 36}`\"\n      :width=\"props.width ?? 120\"\n      :height=\"props.height ?? 36\"\n      aria-hidden=\"true\"\n      preserveAspectRatio=\"none\"\n    >\n      <defs>\n        <linearGradient :id=\"areaId\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n          <stop offset=\"0%\" :stop-color=\"color\" stop-opacity=\"0.22\" />\n          <stop offset=\"100%\" :stop-color=\"color\" stop-opacity=\"0\" />\n        </linearGradient>\n      </defs>\n      <path :d=\"geo.area\" :fill=\"`url(#${areaId})`\" />\n      <path :d=\"geo.line\" fill=\"none\" :stroke=\"color\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" />\n    </svg>\n  </div>\n</template>\n\n<style>\n/* VaKpiChart — KPI 指标卡 + sparkline */\n\n.va-kpi {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-m);\n  background: var(--va-card);\n  padding: var(--va-s4) var(--va-s5);\n  min-width: 180px;\n}\n\n.va-kpi--clickable { cursor: pointer; transition: border-color var(--va-dur-1) var(--va-ease); }\n.va-kpi--clickable:hover { border-color: var(--va-edge-strong); }\n.va-kpi--clickable:focus-visible { outline: 2px solid var(--va-accent); outline-offset: 1px; }\n\n.va-kpi__label { font-size: 12px; color: var(--va-muted); }\n\n.va-kpi__row {\n  display: flex;\n  align-items: baseline;\n  gap: var(--va-s3);\n  flex-wrap: wrap;\n}\n\n.va-kpi__value {\n  font-size: 22px;\n  font-weight: 700;\n  color: var(--va-ink);\n  font-variant-numeric: tabular-nums;\n  line-height: 1.2;\n}\n\n.va-kpi__delta {\n  font-size: 12px;\n  font-weight: 600;\n  font-variant-numeric: tabular-nums;\n  display: inline-flex;\n  align-items: center;\n  gap: 2px;\n}\n\n.va-kpi__delta[data-good=\"true\"] { color: var(--va-success); }\n.va-kpi__delta[data-good=\"false\"] { color: var(--va-danger); }\n\n.va-kpi__vs { font-size: 11px; color: var(--va-muted); }\n\n.va-kpi__spark {\n  margin-top: var(--va-s3);\n  display: block;\n  width: 100%;\n  overflow: visible;\n}\n\n/* 描线入场（reduced-motion 降级为直出） */\n.va-kpi__spark path[stroke] {\n  stroke-dasharray: 600;\n  stroke-dashoffset: 600;\n  animation: va-kpi-draw 1.1s var(--va-ease) forwards;\n}\n\n@keyframes va-kpi-draw {\n  to { stroke-dashoffset: 0; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-kpi__spark path[stroke] { animation: none; stroke-dashoffset: 0; }\n  .va-kpi--clickable { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/kpi-chart/types.ts",
      "type": "registry:ui",
      "target": "components/ui/kpi-chart/types.ts",
      "content": "/** VaKpiChart 的类型定义 */\n\nexport interface KpiChartProps {\n  /** 指标名，如「今日 agent 运行」 */\n  label: string;\n  /** 当前值 */\n  value: number;\n  /** 数值格式化（Intl.NumberFormatOptions，如货币/百分数） */\n  format?: Intl.NumberFormatOptions;\n  /** 环比变化（小数，0.12 = +12%）；正负决定涨跌色与箭头 */\n  delta?: number;\n  /** 变化率的参照文案，如「较上周」 */\n  deltaLabel?: string;\n  /** sparkline 数据序列 */\n  series: number[];\n  /** sparkline 尺寸 px（默认 120×36） */\n  width?: number;\n  height?: number;\n  /** 线条主色（CSS 色），默认 accent */\n  color?: string;\n  /** 涨=好（默认）/跌=好（如错误率场景翻转变色） */\n  invertDelta?: boolean;\n}\n\nexport interface KpiChartEvents {\n  /** 点击卡片 */\n  click: [];\n}\n"
    }
  ]
}
