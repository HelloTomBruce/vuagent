{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "breakdown-chart",
  "title": "Breakdown Chart",
  "description": "横向分布条：按值降序、色板/自定义色、barScale 按最大项或总量、maxRows 折叠「其他」、行可点选。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `items` (BreakdownItem[]，默认 -)：label/value/color\n- `total / unit` (number / string，默认 求和 / -)：分母与单位\n- `barScale` (\"max\" | \"total\"，默认 \"max\")：条长基准\n- `maxRows` (number，默认 -)：超出折叠为「其他」\n- `@select` (-，默认 -)：点击行",
  "files": [
    {
      "path": "components/ui/breakdown-chart/VaBreakdownChart.vue",
      "type": "registry:ui",
      "target": "components/ui/breakdown-chart/VaBreakdownChart.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from \"vue\";\nimport type { BreakdownChartEvents, BreakdownChartProps } from \"./types\";\nimport type { BreakdownItem } from \"./types\";\n\nconst props = defineProps<BreakdownChartProps>();\n\nconst emit = defineEmits<BreakdownChartEvents>();\n\nconst PALETTE = [\"var(--va-info)\", \"var(--va-accent)\", \"var(--va-success)\", \"var(--va-warning)\", \"var(--va-muted)\"];\nconst colorOf = (i: number, item?: BreakdownItem) => item?.color ?? PALETTE[i % PALETTE.length]!;\n\n/** 排序（降序）+ 超出 maxRows 折叠为「其他」 */\nconst rows = computed<Array<BreakdownItem & { pct: number }>>(() => {\n  const sorted = [...props.items].sort((a, b) => b.value - a.value);\n  let list = sorted;\n  if (props.maxRows !== undefined && sorted.length > props.maxRows) {\n    const head = sorted.slice(0, props.maxRows - 1);\n    const rest = sorted.slice(props.maxRows - 1);\n    list = [...head, { label: \"其他\", value: rest.reduce((s, x) => s + x.value, 0) }];\n  }\n  const total = props.total ?? sorted.reduce((s, x) => s + x.value, 0);\n  return list.map((x) => ({ ...x, pct: total > 0 ? x.value / total : 0 }));\n});\n\nconst maxValue = computed(() => Math.max(1, ...rows.value.map((r) => r.value)));\nconst fmt = (v: number) => v.toLocaleString(\"en-US\");\n</script>\n\n<template>\n  <div class=\"va-bdc\" role=\"img\" :aria-label=\"`分布：${rows.map((r) => `${r.label} ${Math.round(r.pct * 100)}%`).join('，')}`\">\n    <button\n      v-for=\"(r, i) in rows\"\n      :key=\"r.label\"\n      class=\"va-bdc__row\"\n      type=\"button\"\n      @click=\"emit('select', r)\"\n    >\n      <span class=\"va-bdc__swatch\" :style=\"{ background: colorOf(i, r.label === '其他' ? undefined : r) }\" aria-hidden=\"true\" />\n      <span class=\"va-bdc__label\">{{ r.label }}</span>\n      <span class=\"va-bdc__track\" aria-hidden=\"true\">\n        <span\n          class=\"va-bdc__bar\"\n          :style=\"{\n            width: `${(props.barScale === 'total' ? r.pct : r.value / maxValue) * 100}%`,\n            background: colorOf(i, r.label === '其他' ? undefined : r),\n          }\"\n        />\n      </span>\n      <span class=\"va-bdc__value\">{{ fmt(r.value) }}{{ props.unit ? ` ${props.unit}` : \"\" }}</span>\n      <span class=\"va-bdc__pct\">{{ Math.round(r.pct * 100) }}%</span>\n    </button>\n  </div>\n</template>\n\n<style>\n/* VaBreakdownChart — 横向分布条 */\n\n.va-bdc {\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s2);\n}\n\n.va-bdc__row {\n  display: grid;\n  grid-template-columns: 10px minmax(64px, max-content) 1fr auto auto;\n  align-items: center;\n  gap: var(--va-s3);\n  border: 0;\n  border-radius: var(--va-radius-s);\n  background: transparent;\n  padding: 4px var(--va-s2);\n  cursor: pointer;\n  font: inherit;\n  text-align: left;\n}\n\n.va-bdc__row:hover { background: var(--va-bg-subtle); }\n.va-bdc__row:focus-visible { outline: 2px solid var(--va-accent); outline-offset: -2px; }\n\n.va-bdc__swatch {\n  width: 10px;\n  height: 10px;\n  border-radius: 3px;\n}\n\n.va-bdc__label {\n  font-size: 12.5px;\n  color: var(--va-ink-2);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.va-bdc__track {\n  height: 8px;\n  border-radius: var(--va-radius-pill);\n  background: var(--va-bg-subtle);\n  overflow: hidden;\n}\n\n.va-bdc__bar {\n  display: block;\n  height: 100%;\n  border-radius: inherit;\n  transition: width var(--va-dur-3) var(--va-ease);\n}\n\n.va-bdc__value {\n  font-size: 12px;\n  color: var(--va-muted);\n  font-variant-numeric: tabular-nums;\n}\n\n.va-bdc__pct {\n  font-size: 12px;\n  color: var(--va-ink-2);\n  font-variant-numeric: tabular-nums;\n  width: 4ch;\n  text-align: right;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-bdc__bar { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/breakdown-chart/types.ts",
      "type": "registry:ui",
      "target": "components/ui/breakdown-chart/types.ts",
      "content": "/** VaBreakdownChart 的类型定义 */\n\nexport interface BreakdownItem {\n  label: string;\n  value: number;\n  /** CSS 色；缺省按序取内置色板 */\n  color?: string;\n}\n\nexport interface BreakdownChartProps {\n  items: BreakdownItem[];\n  /** 总量（分母）；缺省为各项求和 */\n  total?: number;\n  /** 单位文案，如 \"次\" / \"tokens\" */\n  unit?: string;\n  /** 条长按最大项（默认）还是按总占比 */\n  barScale?: \"max\" | \"total\";\n  /** 超过该行数折叠为\"其他\"（聚合剩余）；不设则全部展示 */\n  maxRows?: number;\n}\n\nexport interface BreakdownChartEvents {\n  /** 点击某行（含折叠出的\"其他\"聚合行，label 为 \"其他\"） */\n  select: [item: BreakdownItem];\n}\n"
    }
  ]
}
