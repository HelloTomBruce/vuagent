{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "memory-panel",
  "title": "Memory Panel",
  "description": "助手记忆面板：分类过滤、就地编辑、暂停/遗忘（带撤销托盘）、总开关。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `memories` (MemoryItem[]，默认 -)：id/text/category/paused\n- `v-model:enabled` (boolean，默认 true)：记忆总开关\n- `@edit / @pause / @forget / @restore` (-，默认 -)：数据操作回调",
  "files": [
    {
      "path": "components/ui/memory-panel/VaMemoryPanel.vue",
      "type": "registry:ui",
      "target": "components/ui/memory-panel/VaMemoryPanel.vue",
      "content": "<script setup lang=\"ts\">\nimport type { MemoryItem, MemoryPanelProps } from \"./types\";\nimport { useMemoryPanel } from \"./useMemoryPanel\";\n\nconst props = withDefaults(defineProps<MemoryPanelProps>(), {\n  title: \"助手记住的\",\n  undoMs: 6000,\n});\n\nconst enabled = defineModel<boolean>(\"enabled\", { default: true });\n\nconst emit = defineEmits<{\n  edit: [id: string, text: string];\n  pause: [id: string, paused: boolean];\n  forget: [id: string];\n  restore: [items: MemoryItem[]];\n}>();\n\nconst {\n  filter,\n  categories,\n  visible,\n  editingId,\n  draft,\n  startEdit,\n  saveEdit,\n  tray,\n  forget,\n  undoForget,\n  togglePause,\n} = useMemoryPanel(props, {\n  edit: (id, text) => emit(\"edit\", id, text),\n  pause: (id, paused) => emit(\"pause\", id, paused),\n  forget: (id) => emit(\"forget\", id),\n  restore: (items) => emit(\"restore\", items),\n});\n</script>\n\n<template>\n  <div class=\"va-mem\" :data-off=\"!enabled || undefined\">\n    <header class=\"va-mem__head\">\n      <h4 class=\"va-mem__title\">{{ props.title }}</h4>\n      <button\n        class=\"va-mem__switch\"\n        type=\"button\"\n        role=\"switch\"\n        :aria-checked=\"enabled\"\n        :aria-label=\"enabled ? '关闭记忆' : '开启记忆'\"\n        @click=\"enabled = !enabled\"\n      >\n        <span class=\"va-mem__knob\" />\n      </button>\n    </header>\n\n    <template v-if=\"enabled\">\n      <div v-if=\"props.memories.length\" class=\"va-mem__filters\" role=\"tablist\" aria-label=\"记忆分类过滤\">\n        <button\n          class=\"va-mem__chip\"\n          :class=\"{ 'va-mem__chip--on': filter === '__all' }\"\n          type=\"button\"\n          role=\"tab\"\n          :aria-selected=\"filter === '__all'\"\n          @click=\"filter = '__all'\"\n        >全部 {{ props.memories.length }}</button>\n        <button\n          class=\"va-mem__chip\"\n          :class=\"{ 'va-mem__chip--on': filter === '__paused' }\"\n          type=\"button\"\n          role=\"tab\"\n          :aria-selected=\"filter === '__paused'\"\n          @click=\"filter = '__paused'\"\n        >已暂停 {{ props.memories.filter((m) => m.paused).length }}</button>\n        <button\n          v-for=\"[cat, n] in categories\"\n          :key=\"cat\"\n          class=\"va-mem__chip\"\n          :class=\"{ 'va-mem__chip--on': filter === cat }\"\n          type=\"button\"\n          role=\"tab\"\n          :aria-selected=\"filter === cat\"\n          @click=\"filter = cat\"\n        >{{ cat }} {{ n }}</button>\n      </div>\n\n      <TransitionGroup tag=\"ul\" class=\"va-mem__list\" name=\"va-mem\">\n        <li v-for=\"m in visible\" :key=\"m.id\" class=\"va-mem__row\" :data-paused=\"m.paused || undefined\">\n          <span class=\"va-mem__cat\">{{ m.category }}</span>\n\n          <input\n            v-if=\"editingId === m.id\"\n            v-model=\"draft\"\n            class=\"va-mem__input\"\n            type=\"text\"\n            @keydown.enter=\"saveEdit(m)\"\n            @keydown.esc=\"editingId = null\"\n            @blur=\"saveEdit(m)\"\n          />\n          <button v-else class=\"va-mem__text\" type=\"button\" title=\"点击编辑\" @click=\"startEdit(m)\">{{ m.text }}</button>\n\n          <span class=\"va-mem__ops\">\n            <button\n              class=\"va-btn va-btn--ghost va-mem__op\"\n              type=\"button\"\n              :aria-label=\"m.paused ? '恢复' : '暂停'\"\n              :data-on=\"m.paused || undefined\"\n              @click=\"togglePause(m)\"\n            >{{ m.paused ? \"▶\" : \"⏸\" }}</button>\n            <button class=\"va-btn va-btn--ghost va-mem__op va-mem__op--danger\" type=\"button\" aria-label=\"遗忘\" @click=\"forget(m)\">✕</button>\n          </span>\n        </li>\n      </TransitionGroup>\n\n      <p v-if=\"!visible.length\" class=\"va-mem__empty\">这个过滤条件下没有记忆。</p>\n\n      <Transition name=\"va-mem-tray\">\n        <div v-if=\"tray.length\" class=\"va-mem__tray\" role=\"status\">\n          <span>已遗忘 {{ tray.length }} 条记忆</span>\n          <button class=\"va-mem__undo\" type=\"button\" @click=\"undoForget\">撤销</button>\n        </div>\n      </Transition>\n    </template>\n\n    <p v-else class=\"va-mem__off-hint\">记忆已关闭——助手不会再记住或引用你的信息。</p>\n  </div>\n</template>\n\n<style>\n/* VaMemoryPanel — 助手记忆的管理面板 */\n.va-mem {\n  --_edge: var(--va-mem-edge, var(--va-edge, rgba(26, 25, 23, 0.12)));\n  --_muted: var(--va-mem-muted, var(--va-muted, #6f6d66));\n  --_ink: var(--va-mem-ink, var(--va-ink, #1a1917));\n  --_accent: var(--va-mem-accent, var(--va-accent, #c2410c));\n  --_danger: var(--va-mem-danger, var(--va-danger, #d5453c));\n  font-family: var(--va-font, system-ui, sans-serif);\n}\n\n.va-mem__head { display: flex; align-items: center; justify-content: space-between; gap: var(--va-s3, 8px); }\n.va-mem__title { margin: 0; font-size: 13.5px; font-weight: 650; color: var(--_ink); }\n\n/* 总开关 */\n.va-mem__switch {\n  flex: none;\n  width: 36px;\n  height: 21px;\n  border-radius: var(--va-radius-pill, 999px);\n  border: 0;\n  background: var(--va-edge, rgba(26, 25, 23, 0.12));\n  cursor: pointer;\n  position: relative;\n  transition: background var(--va-dur-2, 200ms) ease;\n}\n.va-mem__switch[aria-checked=\"true\"] { background: var(--_accent); }\n.va-mem__switch:focus-visible { outline: 2px solid var(--_accent); outline-offset: 2px; }\n.va-mem__knob {\n  position: absolute;\n  top: 2.5px;\n  left: 2.5px;\n  width: 16px;\n  height: 16px;\n  border-radius: 50%;\n  background: #fff;\n  box-shadow: var(--va-shadow-1, none);\n  transition: transform var(--va-dur-2, 200ms) var(--va-ease, ease);\n}\n.va-mem__switch[aria-checked=\"true\"] .va-mem__knob { transform: translateX(15px); }\n\n/* 过滤 chips */\n.va-mem__filters { display: flex; gap: 4px; flex-wrap: wrap; margin: var(--va-s3, 8px) 0; }\n.va-mem__chip {\n  border: 0;\n  background: none;\n  padding: 3px 9px;\n  border-radius: var(--va-radius-pill, 999px);\n  font-size: 11.5px;\n  color: var(--_muted);\n  cursor: pointer;\n  font-family: inherit;\n  transition: background var(--va-dur-1, 120ms) ease, color var(--va-dur-1, 120ms) ease;\n}\n.va-mem__chip:hover { background: var(--va-bg-subtle, #efede7); color: var(--_ink); }\n.va-mem__chip:focus-visible { outline: 2px solid var(--_accent); outline-offset: 1px; }\n.va-mem__chip--on { background: var(--va-bg-subtle, #efede7); color: var(--_ink); font-weight: 600; }\n\n/* 列表 */\n.va-mem__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--va-s2, 4px); position: relative; }\n.va-mem__row {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3, 8px);\n  padding: var(--va-s2, 4px) var(--va-s3, 8px);\n  border: 1px solid var(--_edge);\n  border-radius: var(--va-radius-m, 10px);\n  background: var(--va-card, #fff);\n}\n.va-mem__row[data-paused] { opacity: 0.55; }\n\n.va-mem__cat {\n  flex: none;\n  font-size: 10.5px;\n  color: var(--_muted);\n  background: var(--va-bg-subtle, #efede7);\n  border-radius: var(--va-radius-pill, 999px);\n  padding: 2px 8px;\n}\n\n.va-mem__text {\n  flex: 1;\n  min-width: 0;\n  text-align: left;\n  border: 0;\n  background: none;\n  font: inherit;\n  font-size: 12.5px;\n  color: var(--_ink);\n  cursor: text;\n  padding: 3px 2px;\n  border-radius: 4px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.va-mem__text:hover { background: var(--va-bg-subtle, #efede7); }\n.va-mem__text:focus-visible { outline: 2px solid var(--_accent); }\n\n.va-mem__input {\n  flex: 1;\n  min-width: 0;\n  border: 1.5px solid var(--_accent);\n  border-radius: var(--va-radius-s, 8px);\n  padding: 4px 8px;\n  font: inherit;\n  font-size: 12.5px;\n  background: var(--va-card, #fff);\n  color: var(--_ink);\n}\n.va-mem__input:focus { outline: none; }\n\n.va-mem__ops { display: inline-flex; gap: 2px; flex: none; }\n/* va-btn ghost 基类兜底，仅保留 22px 图标方钮形态 */\n.va-mem__op { width: 22px; height: 22px; padding: 0; font-size: 11px; color: var(--_muted); }\n.va-mem__op:hover { color: var(--_ink); }\n.va-mem__op--danger:hover { color: var(--_danger); }\n\n.va-mem__empty { margin: 0; font-size: 12px; color: var(--_muted); text-align: center; padding: var(--va-s3, 8px); }\n\n/* 撤销托盘 */\n.va-mem__tray {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3, 8px);\n  margin-top: var(--va-s3, 8px);\n  padding: var(--va-s2, 4px) var(--va-s4, 12px);\n  border-radius: var(--va-radius-m, 10px);\n  background: var(--va-ink, #1a1917);\n  color: var(--va-card, #fff);\n  font-size: 12px;\n}\n.va-mem__undo {\n  margin-left: auto;\n  border: 0;\n  background: none;\n  color: var(--va-accent, #e8925e);\n  font-size: 12px;\n  font-weight: 600;\n  cursor: pointer;\n  font-family: inherit;\n  padding: 2px 4px;\n  border-radius: 4px;\n}\n.va-mem__undo:focus-visible { outline: 2px solid currentColor; }\n\n.va-mem__off-hint { margin: var(--va-s3, 8px) 0 0; font-size: 12px; color: var(--_muted); }\n.va-mem[data-off] { opacity: 0.72; }\n\n/* 进出与滑动 */\n.va-mem-move { transition: transform var(--va-dur-3, 300ms) var(--va-ease, ease); }\n.va-mem-leave-active { position: absolute; left: 0; right: 0; transition: opacity var(--va-dur-2, 200ms) ease; }\n.va-mem-leave-to { opacity: 0; }\n.va-mem-tray-enter-active, .va-mem-tray-leave-active { transition: opacity var(--va-dur-2, 200ms) ease, transform var(--va-dur-2, 200ms) var(--va-ease, ease); }\n.va-mem-tray-enter-from, .va-mem-tray-leave-to { opacity: 0; transform: translateY(4px); }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-mem__switch, .va-mem__knob { transition: none; }\n  .va-mem-move, .va-mem-leave-active, .va-mem-tray-enter-active, .va-mem-tray-leave-active { transition: none; }\n}\n\n/* 按钮基类（自动附带） */\n/* ============================================================\n   按钮基类 —— 全库动作按钮的单一样式来源。\n   组件叠加使用：class=\"va-btn va-btn--primary va-xxx__submit\"，\n   组件自己的 CSS 只写布局/色彩覆盖（width、pill 圆角等）。\n   registry 生成器会把本文件自动内联进用了 va-btn 的组件拷贝。\n   ============================================================ */\n\n.va-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-card);\n  color: var(--va-ink-2);\n  font: inherit;\n  font-size: 13px;\n  line-height: 1.4;\n  padding: 5px 14px;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: border-color var(--va-dur-1) var(--va-ease), background var(--va-dur-1) var(--va-ease),\n    color var(--va-dur-1) var(--va-ease);\n}\n\n.va-btn:hover:not(:disabled) { border-color: var(--va-edge-strong); }\n\n.va-btn:focus-visible { outline: 2px solid var(--va-accent); outline-offset: 1px; }\n\n.va-btn:disabled { opacity: 0.45; cursor: default; }\n\n/* 尺寸 */\n.va-btn--sm { font-size: 12px; padding: 3px 10px; }\n.va-btn--lg { font-size: 14px; padding: 7px 18px; }\n\n/* 变体 */\n.va-btn--primary {\n  background: var(--va-accent);\n  border-color: var(--va-accent);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-btn--primary:hover:not(:disabled) {\n  background: var(--va-accent-hover);\n  border-color: var(--va-accent-hover);\n}\n\n.va-btn--ghost {\n  border-color: transparent;\n  background: transparent;\n}\n\n.va-btn--ghost:hover:not(:disabled) { background: var(--va-bg-subtle); }\n\n.va-btn--danger { border-color: transparent; background: transparent; color: var(--va-danger); }\n\n.va-btn--danger:hover:not(:disabled) {\n  background: color-mix(in srgb, var(--va-danger) 10%, transparent);\n  border-color: transparent;\n}\n\n/* 语义色实底（成功/危险确认场景，按需叠加） */\n.va-btn--success {\n  background: var(--va-success);\n  border-color: var(--va-success);\n  color: #fff;\n  font-weight: 600;\n}\n\n/* 墨色实底：审批/决策/应用这类\"终审\"主操作（区别于 accent 常规主操作） */\n.va-btn--ink {\n  background: var(--va-ink);\n  border-color: var(--va-ink);\n  color: var(--va-card);\n  font-weight: 600;\n}\n\n.va-btn--ink:hover:not(:disabled) { opacity: 0.88; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-btn { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/memory-panel/types.ts",
      "type": "registry:ui",
      "target": "components/ui/memory-panel/types.ts",
      "content": "/** VaMemoryPanel 的类型定义 */\n\nexport interface MemoryItem {\n  id: string;\n  text: string;\n  /** 分组，如 \"偏好\" / \"项目\" */\n  category: string;\n  paused?: boolean;\n}\n\nexport interface MemoryPanelProps {\n  memories: MemoryItem[];\n  title?: string;\n  /** 遗忘托盘的可撤销时长 ms */\n  undoMs?: number;\n}\n\nexport interface MemoryPanelEvents {\n  edit: [id: string, text: string];\n  pause: [id: string, paused: boolean];\n  forget: [id: string];\n  restore: [items: MemoryItem[]];\n}\n"
    },
    {
      "path": "components/ui/memory-panel/useMemoryPanel.ts",
      "type": "registry:ui",
      "target": "components/ui/memory-panel/useMemoryPanel.ts",
      "content": "import { computed, onBeforeUnmount, ref, type Ref } from \"vue\";\nimport type { MemoryItem, MemoryPanelProps } from \"./types\";\n\n/**\n * VaMemoryPanel 的状态逻辑：分类过滤、就地编辑、遗忘 + 撤销托盘。\n * 数据由父层持有，组件只发事件。\n */\nexport function useMemoryPanel(\n  props: MemoryPanelProps,\n  emit: {\n    edit: (id: string, text: string) => void;\n    pause: (id: string, paused: boolean) => void;\n    forget: (id: string) => void;\n    restore: (items: MemoryItem[]) => void;\n  },\n) {\n  /* ---------- 分类过滤 ---------- */\n  const filter = ref(\"__all\"); // \"__all\" | \"__paused\" | 分类名\n  const categories = computed(() => {\n    const map = new Map<string, number>();\n    for (const m of props.memories) map.set(m.category, (map.get(m.category) ?? 0) + 1);\n    return [...map.entries()];\n  });\n  const visible = computed(() =>\n    props.memories.filter((m) => {\n      if (filter.value === \"__all\") return true;\n      if (filter.value === \"__paused\") return m.paused;\n      return m.category === filter.value;\n    }),\n  );\n\n  /* ---------- 就地编辑 ---------- */\n  const editingId = ref<string | null>(null);\n  const draft = ref(\"\");\n  function startEdit(m: MemoryItem) {\n    editingId.value = m.id;\n    draft.value = m.text;\n  }\n  function saveEdit(m: MemoryItem) {\n    const t = draft.value.trim();\n    editingId.value = null;\n    if (!t || t === m.text) return;\n    emit.edit(m.id, t);\n  }\n\n  /* ---------- 遗忘 + 撤销托盘 ---------- */\n  const tray = ref<MemoryItem[]>([]);\n  let trayTimer: number | undefined;\n  function forget(m: MemoryItem) {\n    emit.forget(m.id);\n    tray.value.push(m);\n    if (trayTimer !== undefined) window.clearTimeout(trayTimer);\n    trayTimer = window.setTimeout(() => (tray.value = []), props.undoMs);\n  }\n  function undoForget() {\n    if (!tray.value.length) return;\n    emit.restore([...tray.value]);\n    tray.value = [];\n    if (trayTimer !== undefined) {\n      window.clearTimeout(trayTimer);\n      trayTimer = undefined;\n    }\n  }\n  onBeforeUnmount(() => {\n    if (trayTimer !== undefined) window.clearTimeout(trayTimer);\n  });\n\n  function togglePause(m: MemoryItem) {\n    emit.pause(m.id, !m.paused);\n  }\n\n  return {\n    filter,\n    categories,\n    visible,\n    editingId,\n    draft,\n    startEdit,\n    saveEdit,\n    tray,\n    forget,\n    undoForget,\n    togglePause,\n  };\n}\n\n/** v-model:enabled 的辅助类型（SFC 中 defineModel 使用） */\nexport type EnabledModel = Ref<boolean>;\n"
    }
  ]
}
