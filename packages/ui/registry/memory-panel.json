{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "memory-panel",
  "title": "Memory Panel",
  "description": "助手记忆面板：分类过滤、就地编辑、暂停/遗忘（带撤销托盘）、总开关。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `memories` (MemoryItem[]，默认 -)：id/text/category/paused\n- `v-model:enabled` (boolean，默认 true)：记忆总开关\n- `@edit / @pause / @forget / @restore` (-，默认 -)：数据操作回调",
  "files": [
    {
      "path": "components/ui/memory-panel/VaMemoryPanel.vue",
      "type": "registry:ui",
      "target": "components/ui/memory-panel/VaMemoryPanel.vue",
      "content": "<script setup lang=\"ts\">\nimport type { MemoryItem, MemoryPanelProps } from \"./types\";\nimport { useMemoryPanel } from \"./useMemoryPanel\";\n\nconst props = withDefaults(defineProps<MemoryPanelProps>(), {\n  title: \"助手记住的\",\n  undoMs: 6000,\n});\n\nconst enabled = defineModel<boolean>(\"enabled\", { default: true });\n\nconst emit = defineEmits<{\n  edit: [id: string, text: string];\n  pause: [id: string, paused: boolean];\n  forget: [id: string];\n  restore: [items: MemoryItem[]];\n}>();\n\nconst {\n  filter,\n  categories,\n  visible,\n  editingId,\n  draft,\n  startEdit,\n  saveEdit,\n  tray,\n  forget,\n  undoForget,\n  togglePause,\n} = useMemoryPanel(props, {\n  edit: (id, text) => emit(\"edit\", id, text),\n  pause: (id, paused) => emit(\"pause\", id, paused),\n  forget: (id) => emit(\"forget\", id),\n  restore: (items) => emit(\"restore\", items),\n});\n</script>\n\n<template>\n  <div class=\"va-mem\" :data-off=\"!enabled || undefined\">\n    <header class=\"va-mem__head\">\n      <h4 class=\"va-mem__title\">{{ props.title }}</h4>\n      <button\n        class=\"va-mem__switch\"\n        type=\"button\"\n        role=\"switch\"\n        :aria-checked=\"enabled\"\n        :aria-label=\"enabled ? '关闭记忆' : '开启记忆'\"\n        @click=\"enabled = !enabled\"\n      >\n        <span class=\"va-mem__knob\" />\n      </button>\n    </header>\n\n    <template v-if=\"enabled\">\n      <div v-if=\"props.memories.length\" class=\"va-mem__filters\" role=\"tablist\" aria-label=\"记忆分类过滤\">\n        <button\n          class=\"va-mem__chip\"\n          :class=\"{ 'va-mem__chip--on': filter === '__all' }\"\n          type=\"button\"\n          role=\"tab\"\n          :aria-selected=\"filter === '__all'\"\n          @click=\"filter = '__all'\"\n        >全部 {{ props.memories.length }}</button>\n        <button\n          class=\"va-mem__chip\"\n          :class=\"{ 'va-mem__chip--on': filter === '__paused' }\"\n          type=\"button\"\n          role=\"tab\"\n          :aria-selected=\"filter === '__paused'\"\n          @click=\"filter = '__paused'\"\n        >已暂停 {{ props.memories.filter((m) => m.paused).length }}</button>\n        <button\n          v-for=\"[cat, n] in categories\"\n          :key=\"cat\"\n          class=\"va-mem__chip\"\n          :class=\"{ 'va-mem__chip--on': filter === cat }\"\n          type=\"button\"\n          role=\"tab\"\n          :aria-selected=\"filter === cat\"\n          @click=\"filter = cat\"\n        >{{ cat }} {{ n }}</button>\n      </div>\n\n      <TransitionGroup tag=\"ul\" class=\"va-mem__list\" name=\"va-mem\">\n        <li v-for=\"m in visible\" :key=\"m.id\" class=\"va-mem__row\" :data-paused=\"m.paused || undefined\">\n          <span class=\"va-mem__cat\">{{ m.category }}</span>\n\n          <input\n            v-if=\"editingId === m.id\"\n            v-model=\"draft\"\n            class=\"va-mem__input\"\n            type=\"text\"\n            @keydown.enter=\"saveEdit(m)\"\n            @keydown.esc=\"editingId = null\"\n            @blur=\"saveEdit(m)\"\n          />\n          <button v-else class=\"va-mem__text\" type=\"button\" title=\"点击编辑\" @click=\"startEdit(m)\">{{ m.text }}</button>\n\n          <span class=\"va-mem__ops\">\n            <button\n              class=\"va-act va-act--ghost va-mem__op\"\n              type=\"button\"\n              :aria-label=\"m.paused ? '恢复' : '暂停'\"\n              :data-on=\"m.paused || undefined\"\n              @click=\"togglePause(m)\"\n            >{{ m.paused ? \"▶\" : \"⏸\" }}</button>\n            <button class=\"va-act va-act--ghost va-mem__op va-mem__op--danger\" type=\"button\" aria-label=\"遗忘\" @click=\"forget(m)\">✕</button>\n          </span>\n        </li>\n      </TransitionGroup>\n\n      <p v-if=\"!visible.length\" class=\"va-mem__empty va-fade-in\">这个过滤条件下没有记忆。</p>\n\n      <Transition name=\"va-mem-tray\">\n        <div v-if=\"tray.length\" class=\"va-mem__tray\" role=\"status\">\n          <span>已遗忘 {{ tray.length }} 条记忆</span>\n          <button class=\"va-mem__undo\" type=\"button\" @click=\"undoForget\">撤销</button>\n        </div>\n      </Transition>\n    </template>\n\n    <p v-else class=\"va-mem__off-hint\">记忆已关闭——助手不会再记住或引用你的信息。</p>\n  </div>\n</template>\n\n<style>\n/* VaMemoryPanel — 助手记忆的管理面板 */\n.va-mem {\n  --_edge: var(--va-mem-edge, var(--va-edge, rgba(26, 25, 23, 0.12)));\n  --_muted: var(--va-mem-muted, var(--va-muted, #6f6d66));\n  --_ink: var(--va-mem-ink, var(--va-ink, #1a1917));\n  --_accent: var(--va-mem-accent, var(--va-accent, #c2410c));\n  --_danger: var(--va-mem-danger, var(--va-danger, #d5453c));\n  font-family: var(--va-font, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Helvetica Neue\", sans-serif);\n}\n\n.va-mem__head { display: flex; align-items: center; justify-content: space-between; gap: var(--va-s3, 8px); }\n.va-mem__title { margin: 0; font-size: var(--va-fs-lg, 14px); font-weight: var(--va-fw-semibold, 600); color: var(--_ink); }\n\n/* 总开关 */\n.va-mem__switch {\n  flex: none;\n  width: 36px;\n  height: 21px;\n  border-radius: var(--va-radius-pill, 999px);\n  border: 0;\n  background: var(--va-edge, rgba(26, 25, 23, 0.12));\n  cursor: pointer;\n  position: relative;\n  transition: background var(--va-dur-2, 200ms) ease;\n}\n.va-mem__switch[aria-checked=\"true\"] { background: var(--_accent); }\n.va-mem__switch:focus-visible { outline: 2px solid var(--_accent); outline-offset: 2px; }\n.va-mem__knob {\n  position: absolute;\n  top: 2.5px;\n  left: 2.5px;\n  width: 16px;\n  height: 16px;\n  border-radius: 50%;\n  background: #fff;\n  box-shadow: var(--va-shadow-1, 0 1px 2px rgba(26, 25, 23, 0.06));\n  transition: transform var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n.va-mem__switch[aria-checked=\"true\"] .va-mem__knob { transform: translateX(15px); }\n\n/* 过滤 chips */\n.va-mem__filters { display: flex; gap: 4px; flex-wrap: wrap; margin: var(--va-s3, 8px) 0; }\n.va-mem__chip {\n  border: 0;\n  background: none;\n  padding: 3px 9px;\n  border-radius: var(--va-radius-pill, 999px);\n  font-size: var(--va-fs-xs, 11px);\n  color: var(--_muted);\n  cursor: pointer;\n  font-family: inherit;\n  transition: background var(--va-dur-1, 120ms) ease, color var(--va-dur-1, 120ms) ease;\n}\n.va-mem__chip:hover { background: var(--va-bg-subtle, #efede7); color: var(--_ink); }\n.va-mem__chip:focus-visible { outline: 2px solid var(--_accent); outline-offset: 1px; }\n.va-mem__chip--on { background: var(--va-bg-subtle, #efede7); color: var(--_ink); font-weight: var(--va-fw-semibold, 600); }\n\n/* 列表 */\n.va-mem__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--va-s2, 4px); position: relative; }\n.va-mem__row {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3, 8px);\n  padding: var(--va-s2, 4px) var(--va-s3, 8px);\n  border: 1px solid var(--_edge);\n  border-radius: var(--va-radius-m, 10px);\n  background: var(--va-card, #ffffff);\n}\n.va-mem__row[data-paused] { opacity: 0.55; }\n\n.va-mem__cat {\n  flex: none;\n  font-size: var(--va-fs-xs, 11px);\n  color: var(--_muted);\n  background: var(--va-bg-subtle, #efede7);\n  border-radius: var(--va-radius-pill, 999px);\n  padding: 2px 8px;\n}\n\n.va-mem__text {\n  flex: 1;\n  min-width: 0;\n  text-align: left;\n  border: 0;\n  background: none;\n  font: inherit;\n  font-size: var(--va-fs-md, 13px);\n  color: var(--_ink);\n  cursor: text;\n  padding: 3px 2px;\n  border-radius: 4px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.va-mem__text:hover { background: var(--va-bg-subtle, #efede7); }\n.va-mem__text:focus-visible { outline: 2px solid var(--_accent); }\n\n.va-mem__input {\n  flex: 1;\n  min-width: 0;\n  border: 1.5px solid var(--_accent);\n  border-radius: var(--va-radius-s, 8px);\n  padding: 4px 8px;\n  font: inherit;\n  font-size: var(--va-fs-md, 13px);\n  background: var(--va-card, #ffffff);\n  color: var(--_ink);\n}\n.va-mem__input:focus { outline: none; }\n\n.va-mem__ops { display: inline-flex; gap: 2px; flex: none; }\n/* va-act ghost 基类兜底，仅保留 22px 图标方钮形态 */\n.va-mem__op { width: 22px; height: 22px; padding: 0; font-size: var(--va-fs-xs, 11px); color: var(--_muted); }\n.va-mem__op:hover { color: var(--_ink); }\n.va-mem__op--danger:hover { color: var(--_danger); }\n\n.va-mem__empty { margin: 0; font-size: var(--va-fs-sm, 12px); color: var(--_muted); text-align: center; padding: var(--va-s3, 8px); }\n\n/* 撤销托盘 */\n.va-mem__tray {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3, 8px);\n  margin-top: var(--va-s3, 8px);\n  padding: var(--va-s2, 4px) var(--va-s4, 12px);\n  border-radius: var(--va-radius-m, 10px);\n  background: var(--va-ink, #1a1917);\n  color: var(--va-card, #ffffff);\n  font-size: var(--va-fs-sm, 12px);\n}\n.va-mem__undo {\n  margin-left: auto;\n  border: 0;\n  background: none;\n  color: var(--va-accent, #c2410c);\n  font-size: var(--va-fs-sm, 12px);\n  font-weight: var(--va-fw-semibold, 600);\n  cursor: pointer;\n  font-family: inherit;\n  padding: 2px 4px;\n  border-radius: 4px;\n}\n.va-mem__undo:focus-visible { outline: 2px solid currentColor; }\n\n.va-mem__off-hint { margin: var(--va-s3, 8px) 0 0; font-size: var(--va-fs-sm, 12px); color: var(--_muted); }\n.va-mem[data-off] { opacity: 0.72; }\n\n/* 进出与滑动 */\n.va-mem-move { transition: transform var(--va-dur-3, 300ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)); }\n.va-mem-leave-active { position: absolute; left: 0; right: 0; transition: opacity var(--va-dur-2, 200ms) ease; }\n.va-mem-leave-to { opacity: 0; }\n.va-mem-tray-enter-active, .va-mem-tray-leave-active { transition: opacity var(--va-dur-2, 200ms) ease, transform var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)); }\n.va-mem-tray-enter-from, .va-mem-tray-leave-to { opacity: 0; transform: translateY(4px); }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-mem__switch, .va-mem__knob { transition: none; }\n  .va-mem-move, .va-mem-leave-active, .va-mem-tray-enter-active, .va-mem-tray-leave-active { transition: none; }\n}\n\n/* 按钮基类（自动附带） */\n/* ============================================================\n   按钮基类 —— 全库动作按钮的单一样式来源。\n   组件叠加使用：class=\"va-act va-act--primary va-xxx__submit\"，\n   组件自己的 CSS 只写布局/色彩覆盖（width、pill 圆角等）。\n   registry 生成器会把本文件自动内联进用了 va-act 的组件拷贝。\n   ============================================================ */\n\n.va-act {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--va-s3h, 6px);\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-s, 8px);\n  background: var(--va-card, #ffffff);\n  color: var(--va-ink-2, #43413c);\n  font: inherit;\n  font-size: var(--va-fs-md, 13px);\n  line-height: 1.4;\n  padding: 5px 14px;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: border-color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), background var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-act:hover:not(:disabled) { border-color: var(--va-edge-strong, rgba(26, 25, 23, 0.22)); }\n\n/* 按压反馈（TASK-105 基类口径，对齐 VaButton）：下沉 0.5px + 微缩 0.985，\n   时长走 --va-dur-1。组件不再逐个发明 :active 缩放值。 */\n.va-act:active:not(:disabled) { transform: translateY(0.5px) scale(0.985); }\n\n.va-act:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: 1px; }\n\n.va-act:disabled { opacity: 0.45; cursor: default; }\n\n/* 尺寸 */\n.va-act--sm { font-size: var(--va-fs-sm, 12px); padding: 3px var(--va-s4h, 10px); }\n.va-act--lg { font-size: var(--va-fs-lg, 14px); padding: 7px 18px; }\n\n/* 变体 */\n.va-act--primary {\n  background: var(--va-accent, #c2410c);\n  border-color: var(--va-accent, #c2410c);\n  color: var(--va-card, #ffffff);\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n.va-act--primary:hover:not(:disabled) {\n  background: var(--va-accent-hover, #9a3412);\n  border-color: var(--va-accent-hover, #9a3412);\n}\n\n.va-act--ghost {\n  border-color: transparent;\n  background: transparent;\n}\n\n.va-act--ghost:hover:not(:disabled) { background: var(--va-bg-subtle, #efede7); }\n\n.va-act--danger { border-color: transparent; background: transparent; color: var(--va-danger, #d5453c); }\n\n.va-act--danger:hover:not(:disabled) {\n  background: color-mix(in srgb, var(--va-danger, #d5453c) 10%, transparent);\n  border-color: transparent;\n}\n\n/* 语义色实底（成功/危险确认场景，按需叠加） */\n.va-act--success {\n  background: var(--va-success, #1a7f4b);\n  border-color: var(--va-success, #1a7f4b);\n  color: #fff;\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n/* 墨色实底：审批/决策/应用这类\"终审\"主操作（区别于 accent 常规主操作） */\n.va-act--ink {\n  background: var(--va-ink, #1a1917);\n  border-color: var(--va-ink, #1a1917);\n  color: var(--va-card, #ffffff);\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n.va-act--ink:hover:not(:disabled) { opacity: 0.88; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-act { transition: none; }\n  /* 按压降级：去位移，只留透明度反馈（状态可感知性保留，TASK-105 口径） */\n  .va-act:active:not(:disabled) { transform: none; opacity: 0.7; }\n}\n\n/* 动效工具类（自动附带，源码中来自全局 motion.css） */\n/* ============================================================\n   共享动效工具类 —— 进出场/交叉淡入的统一协议（TASK-102 动效基建）。\n   组件不逐个发明入场曲线：统一消费 --va-dur-in/--va-dur-out 骨架时长与\n   --va-dist-* 位移档；每条声明自带字面 fallback（registry 单文件拷贝分发\n   要求，与 tokens.css 门禁一致）。\n\n   接入方式二选一：\n   1. Vue <Transition>：\n      <Transition enter-active-class=\"va-enter-up\" leave-active-class=\"va-exit-up\">\n      动画 fill-mode 为 both（延迟期间保持首帧、播完停在终态），\n      无需再配 enter-from-class / leave-to-class；\n   2. 类切换重挂载：骨架 → 内容换节点时给新节点挂 .va-crossfade（纯淡入），\n      离场节点挂 .va-exit-*（更短更快）。\n\n   列表错峰：v-for 子项 :style=\"useStagger().delayStyle(i)\" 配合 .va-enter-*\n   动画类使用（animation-delay 由 composable 编排——.va-enter-* 为 CSS animation，\n   transition-delay 对其零作用，见 composables/useStagger.ts）。\n   ============================================================ */\n\n/* 入场：上浮（自下方 --va-dist-m 浮起） */\n@keyframes va-motion-in-up {\n  from { opacity: 0; transform: translateY(var(--va-dist-m, 8px)); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* 入场：左滑（自左侧 --va-dist-m 滑入） */\n@keyframes va-motion-in-left {\n  from { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n  to { opacity: 1; transform: translateX(0); }\n}\n\n/* 入场：缩放（96% 起放大至原尺寸） */\n@keyframes va-motion-in-scale {\n  from { opacity: 0; transform: scale(0.96); }\n  to { opacity: 1; transform: scale(1); }\n}\n\n/* 离场：与入场互逆（向上/向左飘出、缩回）；时长/曲线由工具类映射 --va-dur-out 骨架 */\n@keyframes va-motion-out-up {\n  from { opacity: 1; transform: translateY(0); }\n  to { opacity: 0; transform: translateY(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-left {\n  from { opacity: 1; transform: translateX(0); }\n  to { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-scale {\n  from { opacity: 1; transform: scale(1); }\n  to { opacity: 0; transform: scale(0.96); }\n}\n\n/* 交叉淡入/淡出（.va-crossfade 骨架→内容交换专用，无位移，避免占位跳变叠加） */\n@keyframes va-motion-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes va-motion-fade-out {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n/* ---- 工具类：入场走 --va-dur-in + ease-out-quart，离场走 --va-dur-out + ease-in-quad ---- */\n\n.va-enter-up {\n  animation: va-motion-in-up var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-left {\n  animation: va-motion-in-left var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-scale {\n  animation: va-motion-in-scale var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-exit-up {\n  animation: va-motion-out-up var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-left {\n  animation: va-motion-out-left var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-scale {\n  animation: va-motion-out-scale var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n/* 骨架 → 内容交叉过渡：新内容纯淡入 */\n.va-crossfade {\n  animation: va-motion-fade-in var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* 空态/轻量状态渐入（TASK-106 弱化档）：仅 opacity、时长走 --va-dur-2，\n   供列表空态提示与一次性状态块使用（空态清单见 TASK-106 报告）。\n   纯 opacity 即动效分频策略的降级终点形态，reduced-motion 下保持原样即可。 */\n.va-fade-in {\n  animation: va-motion-fade-in var(--va-dur-2, 200ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* ---- 静态光斑基类（TASK-105，决策 5「追光」路线基建）----\n   pointer 坐标由 composables/useSpotlight.ts 以 rAF 节流写入 --va-spot-x/y\n   （元素内百分比，光斑数学在 composable 内可单测）；本类只负责 radial 光斑\n   绘制与显隐（:hover 点亮，无 3D 倾斜， glare 数学对齐 VaTiltCard）。\n   --va-spot-* 为 L3 组件钩子口径（宿主可覆盖尺寸/颜色），不进 tokens.css。\n   双降级对齐 VaTiltCard glare：hover: none（触屏）与 reduced-motion 不绘制。 */\n.va-spotlight { position: relative; }\n\n/* ::after 承载光斑（避开组件自身 ::before 用途）；inset 0 + border-radius inherit\n   使光斑天然裁剪在宿主圆角内，无需 overflow: hidden。\n   注意：此 ::after radial 与 components/spotlight-card/VaSpotlightCard.css 的\n   .va-spot-card--spot::after 为 registry 单文件自含有意复制，改动需两处同步。 */\n.va-spotlight::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n  background: radial-gradient(\n    var(--va-spot-size, 240px) circle at var(--va-spot-x, 50%) var(--va-spot-y, 50%),\n    var(--va-spot-color, rgba(255, 255, 255, 0.14)),\n    transparent 65%\n  );\n}\n\n.va-spotlight:hover::after { opacity: 1; }\n\n@media (hover: none) {\n  .va-spotlight::after { display: none; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-spotlight::after { display: none; }\n}\n\n/* ---- 复制反馈标准（TASK-106）：copy→check 交叉过渡 ----\n   容器 .va-copy 为 inline-grid 双内容同格堆叠（格子宽取较宽子项，切换零跳动）：\n   __idle = copy 态内容（图标/文字），__done = check 态内容。\n   copied 置真挂 .va-copy--done：check 以 ease-spring 微弹入场（进入 done 态时\n   transform 的目标态时序换成 --va-ease-spring → 过冲回弹），交叉时长统一 --va-dur-1。\n   消费方：terminal-log（行复制）、code-diff（复制按钮）、message-actions（复制图标）。 */\n.va-copy { display: inline-grid; place-items: center; }\n\n.va-copy__idle,\n.va-copy__done {\n  grid-area: 1 / 1;\n  transition: opacity var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-copy__idle { opacity: 1; transform: scale(1); }\n.va-copy__done { opacity: 0; transform: scale(0.6); }\n\n.va-copy--done .va-copy__done {\n  opacity: 1;\n  transform: scale(1);\n  /* 时序按 transition 属性顺序映射：opacity 仍 ease，transform 换 ease-spring 微弹 */\n  transition-timing-function: var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), var(--va-ease-spring, cubic-bezier(0.34, 1.56, 0.64, 1));\n}\n\n.va-copy--done .va-copy__idle { opacity: 0; transform: scale(0.6); }\n\n@media (prefers-reduced-motion: reduce) {\n  /* 交叉过渡瞬时完成（无位移动画），copied 状态可感知性不受影响 */\n  .va-copy__idle,\n  .va-copy__done { transition: none; }\n}\n\n/* ---- 错误反馈标准（校验失败横向微振）：目标元素挂 .va-shake 播一次 ±3px 微振 ----\n   时长 --va-dur-2 × 2（两拍四峰，克制的「摇头」量级，rubric 校验失败口径）；\n   重复触发需先移除类、强制 reflow 再挂回（封装见 composables/useShake.ts）。\n   reduced-motion 降级为不播：错误状态的可感知性由错误样式本身（描边/文案）承担，\n   动效只做注意力引导——符合头注释「功能动画降级保留状态可感知」的分频策略。\n   消费方：VaStepperForm / VaOtpInput 经 useShake() 程序化触发（defineExpose shake()）；\n   宿主自绘表单可直接挂类。 */\n@keyframes va-motion-shake {\n  20% { transform: translateX(-3px); }\n  40% { transform: translateX(3px); }\n  60% { transform: translateX(-2px); }\n  80% { transform: translateX(2px); }\n}\n\n.va-shake {\n  animation: va-motion-shake calc(var(--va-dur-2, 200ms) * 2) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-shake { animation: none; }\n}\n\n/* ---- 动效分频（对齐 tokens.css 头注释策略）：\n   功能动画降级为纯 opacity——进/出场整体换成 fade keyframes，\n   位移/缩放不再出现（animation-name 顶替，时长/缓动沿用上面的声明）。 */\n@media (prefers-reduced-motion: reduce) {\n  .va-enter-up,\n  .va-enter-left,\n  .va-enter-scale,\n  .va-crossfade {\n    animation-name: va-motion-fade-in;\n  }\n\n  .va-exit-up,\n  .va-exit-left,\n  .va-exit-scale {\n    animation-name: va-motion-fade-out;\n  }\n}\n</style>\n"
    },
