{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "profile-menu",
  "title": "Profile Menu",
  "description": "头像账户菜单：首字母色块头像、未读徽标、用户信息头 + 菜单列表（danger 项）、Esc/外部点击关闭。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `name / email / avatar` (string，默认 -)：账户信息\n- `items` (ProfileMenuItem[]，默认 -)：菜单项（danger 标红）\n- `@select` (-，默认 -)：点击菜单项",
  "files": [
    {
      "path": "components/ui/profile-menu/VaProfileMenu.vue",
      "type": "registry:ui",
      "target": "components/ui/profile-menu/VaProfileMenu.vue",
      "content": "<script setup lang=\"ts\">\nimport { onBeforeUnmount, onMounted, ref, useTemplateRef } from \"vue\";\nimport type { ProfileMenuEvents, ProfileMenuProps } from \"./types\";\n\nconst props = defineProps<ProfileMenuProps>();\n\nconst emit = defineEmits<ProfileMenuEvents>();\n\nconst open = ref(false);\nconst rootEl = useTemplateRef<HTMLElement>(\"root\");\n\nfunction toggle() {\n  open.value = !open.value;\n}\n\n/** Esc 关闭 + 点击外部关闭（SSR 安全：onMounted 内挂） */\nfunction onDocMousedown(e: MouseEvent) {\n  if (open.value && rootEl.value && !rootEl.value.contains(e.target as Node)) open.value = false;\n}\nfunction onDocKeydown(e: KeyboardEvent) {\n  if (e.key === \"Escape\" && open.value) {\n    open.value = false;\n    rootEl.value?.querySelector<HTMLElement>(\".va-pm__trigger\")?.focus();\n  }\n}\nonMounted(() => {\n  if (typeof document === \"undefined\") return;\n  document.addEventListener(\"mousedown\", onDocMousedown);\n  document.addEventListener(\"keydown\", onDocKeydown);\n});\nonBeforeUnmount(() => {\n  if (typeof document === \"undefined\") return;\n  document.removeEventListener(\"mousedown\", onDocMousedown);\n  document.removeEventListener(\"keydown\", onDocKeydown);\n});\n\nconst AVATAR_HUES = [16, 145, 210, 268];\nconst hue = (props.name.length % AVATAR_HUES.length);\n</script>\n\n<template>\n  <div ref=\"root\" class=\"va-pm\">\n    <button\n      class=\"va-pm__trigger\"\n      type=\"button\"\n      :aria-expanded=\"open\"\n      aria-haspopup=\"menu\"\n      @click=\"toggle\"\n    >\n      <img v-if=\"props.avatar\" class=\"va-pm__avatar\" :src=\"props.avatar\" :alt=\"props.name\">\n      <span\n        v-else\n        class=\"va-pm__avatar va-pm__avatar--text\"\n        :style=\"{ background: `hsl(${AVATAR_HUES[hue]} 45% 88%)`, color: `hsl(${AVATAR_HUES[hue]} 45% 30%)` }\"\n        aria-hidden=\"true\"\n      >{{ props.initials ?? props.name.slice(0, 1).toUpperCase() }}</span>\n      <span v-if=\"props.badge\" class=\"va-pm__badge\">{{ props.badge > 99 ? \"99+\" : props.badge }}</span>\n    </button>\n\n    <Transition name=\"va-pm-pop\">\n      <div\n        v-if=\"open\"\n        class=\"va-pm__menu\"\n        role=\"menu\"\n        :aria-label=\"`账户菜单：${props.name}`\"\n    >\n      <header class=\"va-pm__head\">\n        <span class=\"va-pm__name\">{{ props.name }}</span>\n        <span v-if=\"props.email\" class=\"va-pm__email\">{{ props.email }}</span>\n      </header>\n      <button\n        v-for=\"item in props.items ?? []\"\n        :key=\"item.id\"\n        class=\"va-pm__item\"\n        type=\"button\"\n        role=\"menuitem\"\n        :data-danger=\"item.danger\"\n        :disabled=\"item.disabled\"\n        @click=\"emit('select', item)\"\n      >\n        {{ item.label }}\n      </button>\n    </div>\n    </Transition>\n  </div>\n</template>\n\n<style>\n/* VaProfileMenu — 头像账户菜单 */\n\n.va-pm { position: relative; display: inline-flex; }\n\n.va-pm__trigger {\n  position: relative;\n  border: 0;\n  background: transparent;\n  padding: 2px;\n  border-radius: 50%;\n  cursor: pointer;\n  line-height: 0;\n}\n\n.va-pm__trigger:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: 2px; }\n\n.va-pm__avatar {\n  width: 34px;\n  height: 34px;\n  border-radius: 50%;\n  object-fit: cover;\n}\n\n.va-pm__avatar--text {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  font-size: var(--va-fs-lg, 14px);\n  font-weight: var(--va-fw-bold, 700);\n  line-height: 1;\n}\n\n.va-pm__badge {\n  position: absolute;\n  right: -2px;\n  bottom: -2px;\n  min-width: 17px;\n  height: 17px;\n  border-radius: var(--va-radius-pill, 999px);\n  background: var(--va-danger, #d5453c);\n  color: var(--va-danger-contrast, #fff);\n  font-size: var(--va-fs-2xs, 10px);\n  font-weight: var(--va-fw-bold, 700);\n  line-height: 17px;\n  text-align: center;\n  padding: 0 4px;\n  border: 2px solid var(--va-card, #ffffff);\n  box-sizing: content-box;\n}\n\n.va-pm__menu {\n  position: absolute;\n  top: calc(100% + 8px);\n  right: 0;\n  z-index: 30;\n  min-width: 220px;\n  background: var(--va-card, #ffffff);\n  border: 1px solid var(--va-edge-strong, rgba(26, 25, 23, 0.22));\n  border-radius: var(--va-radius-m, 10px);\n  box-shadow: var(--va-shadow-2, 0 4px 12px rgba(26, 25, 23, 0.08));\n  padding: var(--va-s2, 4px);\n  animation: va-pm-in var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n@keyframes va-pm-in {\n  from { opacity: 0; transform: translateY(-4px); }\n}\n\n.va-pm__head {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  padding: var(--va-s2, 4px) var(--va-s3, 8px) var(--va-s4, 12px);\n  border-bottom: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  margin-bottom: var(--va-s2, 4px);\n}\n\n.va-pm__name { font-size: var(--va-fs-lg, 14px); font-weight: var(--va-fw-bold, 700); color: var(--va-ink, #1a1917); }\n.va-pm__email { font-size: var(--va-fs-sm, 12px); color: var(--va-muted, #6f6d66); overflow: hidden; text-overflow: ellipsis; }\n\n.va-pm__item {\n  display: block;\n  width: 100%;\n  border: 0;\n  border-radius: var(--va-radius-s, 8px);\n  background: transparent;\n  color: var(--va-ink-2, #43413c);\n  font-size: var(--va-fs-md, 13px);\n  text-align: left;\n  padding: 7px var(--va-s3, 8px);\n  cursor: pointer;\n}\n\n.va-pm__item:hover:not(:disabled) { background: var(--va-bg-subtle, #efede7); }\n.va-pm__item:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: -2px; }\n.va-pm__item:disabled { opacity: 0.4; cursor: default; }\n.va-pm__item[data-danger=\"true\"] { color: var(--va-danger, #d5453c); }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-pm__menu { animation: none; }\n}\n\n/* 下拉面板显隐过渡：自上方轻滑入淡入（与 VaPopover bottom 放置同构），单文件自含 */\n.va-pm-pop-enter-active {\n  transition:\n    opacity var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-pm-pop-leave-active {\n  transition:\n    opacity var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)),\n    transform var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2));\n}\n\n.va-pm-pop-enter-from,\n.va-pm-pop-leave-to {\n  opacity: 0;\n  transform: translateY(calc(var(--va-dist-m, 8px) * -1));\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-pm-pop-enter-active,\n  .va-pm-pop-leave-active {\n    transition: opacity var(--va-dur-1, 120ms) linear;\n    transform: none;\n  }\n\n  .va-pm-pop-enter-from,\n  .va-pm-pop-leave-to {\n    transform: none;\n  }\n}\n</style>\n"
    },
    {
      "path": "components/ui/profile-menu/index.ts",
      "type": "registry:ui",
      "target": "components/ui/profile-menu/index.ts",
      "content": "export { default as VaProfileMenu } from \"./VaProfileMenu.vue\";\nexport type { ProfileMenuEvents, ProfileMenuItem, ProfileMenuProps } from \"./types\";\n"
    },
    {
      "path": "components/ui/profile-menu/types.ts",
      "type": "registry:ui",
      "target": "components/ui/profile-menu/types.ts",
      "content": "/** VaProfileMenu 的类型定义 */\n\nexport interface ProfileMenuItem {\n  id: string;\n  label: string;\n  /** 危险操作（如退出登录，红色） */\n  danger?: boolean;\n  disabled?: boolean;\n}\n\nexport interface ProfileMenuProps {\n  name: string;\n  email?: string;\n  /** 头像图片地址；缺省用首字母色块 */\n  avatar?: string;\n  initials?: string;\n  items?: ProfileMenuItem[];\n  /** 右上角未读徽标数 */\n  badge?: number;\n}\n\nexport interface ProfileMenuEvents {\n  select: [item: ProfileMenuItem];\n}\n"
    }
  ]
}
