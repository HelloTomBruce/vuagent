{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "code-diff",
  "title": "Code Diff",
  "description": "文件级代码 diff：±行渲染、行内词级高亮、上下文折叠与展开、+N −M 统计、复制新文件——agent 改代码的验收主界面。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `oldText / newText` (string，默认 -)：旧/新版本全文（LCS 行级 diff）\n- `fileName` (string，默认 -)：头部文件名（等宽）\n- `context` (number，默认 3)：变更行保留的上下文行数，其余折叠\n- `wordLevel` (boolean，默认 true)：配对的 del/add 行内词级高亮\n- `defaultExpandAll` (boolean，默认 false)：初始不折叠\n- `@copy` (-，默认 -)：复制新文件内容",
  "files": [
    {
      "path": "components/ui/code-diff/VaCodeDiff.vue",
      "type": "registry:ui",
      "target": "components/ui/code-diff/VaCodeDiff.vue",
      "content": "<script setup lang=\"ts\">\nimport type { CodeDiffEvents, CodeDiffProps } from \"./types\";\nimport { useCodeDiff } from \"./useCodeDiff\";\nimport { useCopyable } from \"../../composables/useCopyable\";\n\nconst props = defineProps<CodeDiffProps>();\n\nconst emit = defineEmits<CodeDiffEvents>();\n\nconst { render, stats, hasCollapsed, expandAll, toggleExpand, empty } = useCodeDiff(props);\n\nconst { copied, copy } = useCopyable(() => props.newText, (t) => emit(\"copy\", t));\n\nconst signOf = (t: string) => (t === \"add\" ? \"+\" : t === \"del\" ? \"−\" : \"\");\n</script>\n\n<template>\n  <figure class=\"va-cdiff\">\n    <header class=\"va-cdiff__head\">\n      <span v-if=\"props.fileName\" class=\"va-cdiff__file\">{{ props.fileName }}</span>\n      <span class=\"va-cdiff__stats\" role=\"status\">\n        <template v-if=\"!empty\">+{{ stats.additions }} −{{ stats.deletions }}</template>\n        <template v-else>无变更</template>\n      </span>\n      <span class=\"va-cdiff__spacer\" />\n      <button\n        v-if=\"hasCollapsed\"\n        class=\"va-cdiff__btn\"\n        type=\"button\"\n        :aria-pressed=\"expandAll\"\n        @click=\"expandAll = !expandAll\"\n      >\n        {{ expandAll ? \"折叠上下文\" : \"全部展开\" }}\n      </button>\n      <button class=\"va-cdiff__btn\" type=\"button\" :aria-label=\"copied ? '已复制' : '复制新文件内容'\" @click=\"copy\">\n        {{ copied ? \"已复制 ✓\" : \"复制新文件\" }}\n      </button>\n    </header>\n\n    <div\n      class=\"va-cdiff__body\"\n      :style=\"props.maxHeight ? { maxHeight: `${props.maxHeight}px` } : undefined\"\n      tabindex=\"0\"\n      role=\"region\"\n      :aria-label=\"`代码差异${props.fileName ? `：${props.fileName}` : ''}`\"\n    >\n      <p v-if=\"empty\" class=\"va-cdiff__empty\">两个版本内容一致。</p>\n      <template v-for=\"(r, i) in render\" :key=\"i\">\n        <div v-if=\"r.kind === 'row'\" class=\"va-cdiff__row\" :data-type=\"r.row.type\">\n          <span class=\"va-cdiff__no\" aria-hidden=\"true\">{{ r.row.oldNo ?? \"\" }}</span>\n          <span class=\"va-cdiff__no\" aria-hidden=\"true\">{{ r.row.newNo ?? \"\" }}</span>\n          <span class=\"va-cdiff__sign\" aria-hidden=\"true\">{{ signOf(r.row.type) }}</span>\n          <code class=\"va-cdiff__code\">\n            <template v-if=\"r.inline\">\n              <span\n                v-for=\"(seg, si) in r.row.type === 'del' ? r.inline.del : r.inline.add\"\n                :key=\"si\"\n                class=\"va-cdiff__seg\"\n                :data-seg=\"seg.kind\"\n              >{{ seg.text }}</span>\n            </template>\n            <template v-else>{{ r.row.text }}</template>\n          </code>\n        </div>\n        <button\n          v-else\n          class=\"va-cdiff__expand\"\n          type=\"button\"\n          :aria-expanded=\"false\"\n          :title=\"`展开第 ${r.from}–${r.to} 行`\"\n          @click=\"toggleExpand(r)\"\n        >\n          ⋯ 展开隐藏的 {{ r.count }} 行\n        </button>\n      </template>\n    </div>\n  </figure>\n</template>\n\n<style>\n/* VaCodeDiff — 文件级代码差异视图 */\n\n.va-cdiff {\n  margin: 0;\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-m);\n  background: var(--va-card);\n  overflow: hidden;\n}\n\n.va-cdiff__head {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s4);\n  padding: var(--va-s2) var(--va-s4);\n  border-bottom: 1px solid var(--va-edge);\n  background: var(--va-bg-subtle);\n}\n\n.va-cdiff__file {\n  font-family: var(--va-font-mono);\n  font-size: 12.5px;\n  color: var(--va-ink-2);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.va-cdiff__stats {\n  font-family: var(--va-font-mono);\n  font-size: 12px;\n  color: var(--va-muted);\n  white-space: nowrap;\n}\n\n.va-cdiff__spacer { flex: 1; }\n\n.va-cdiff__btn {\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-card);\n  color: var(--va-ink-2);\n  font-size: 12px;\n  padding: 3px 10px;\n  cursor: pointer;\n  transition: background var(--va-dur-1) var(--va-ease), border-color var(--va-dur-1) var(--va-ease);\n}\n\n.va-cdiff__btn:hover { border-color: var(--va-edge-strong); }\n.va-cdiff__btn[aria-pressed=\"true\"] { background: var(--va-accent-soft); border-color: transparent; color: var(--va-accent); }\n\n.va-cdiff__body {\n  overflow: auto;\n  font-family: var(--va-font-mono);\n  font-size: 12.5px;\n  line-height: 20px;\n}\n\n.va-cdiff__body:focus-visible {\n  outline: 2px solid var(--va-accent);\n  outline-offset: -2px;\n}\n\n.va-cdiff__empty {\n  margin: 0;\n  padding: var(--va-s5);\n  color: var(--va-muted);\n  font-family: var(--va-font);\n  font-size: 13px;\n}\n\n/* 行：旧行号 | 新行号 | 符号 | 代码 */\n.va-cdiff__row {\n  display: grid;\n  grid-template-columns: repeat(2, 3.5ch) 2ch 1fr;\n  align-items: baseline;\n  min-height: 20px;\n}\n\n.va-cdiff__no {\n  padding: 0 4px;\n  text-align: right;\n  color: var(--va-muted);\n  opacity: 0.7;\n  user-select: none;\n  font-variant-numeric: tabular-nums;\n}\n\n.va-cdiff__sign {\n  text-align: center;\n  user-select: none;\n  font-weight: 600;\n}\n\n.va-cdiff__code {\n  padding-right: var(--va-s4);\n  white-space: pre;\n  tab-size: 2;\n  color: var(--va-ink);\n}\n\n.va-cdiff__row[data-type=\"del\"] { background: color-mix(in srgb, var(--va-danger) 10%, transparent); }\n.va-cdiff__row[data-type=\"del\"] .va-cdiff__sign,\n.va-cdiff__row[data-type=\"del\"] .va-cdiff__no { color: var(--va-danger); }\n\n.va-cdiff__row[data-type=\"add\"] { background: color-mix(in srgb, var(--va-success) 10%, transparent); }\n.va-cdiff__row[data-type=\"add\"] .va-cdiff__sign,\n.va-cdiff__row[data-type=\"add\"] .va-cdiff__no { color: var(--va-success); }\n\n.va-cdiff__row:hover .va-cdiff__code { background: color-mix(in srgb, var(--va-ink) 3%, transparent); }\n\n/* 行内词级高亮：变更加深一档 */\n.va-cdiff__seg[data-seg=\"del\"] { background: color-mix(in srgb, var(--va-danger) 26%, transparent); border-radius: 2px; }\n.va-cdiff__seg[data-seg=\"add\"] { background: color-mix(in srgb, var(--va-success) 28%, transparent); border-radius: 2px; }\n\n.va-cdiff__expand {\n  display: block;\n  width: 100%;\n  border: 0;\n  border-top: 1px dashed var(--va-edge);\n  border-bottom: 1px dashed var(--va-edge);\n  background: var(--va-bg-subtle);\n  color: var(--va-info);\n  font-family: var(--va-font-mono);\n  font-size: 11.5px;\n  line-height: 24px;\n  cursor: pointer;\n  transition: background var(--va-dur-1) var(--va-ease);\n}\n\n.va-cdiff__expand:hover { background: color-mix(in srgb, var(--va-info) 8%, var(--va-bg-subtle)); }\n.va-cdiff__expand:focus-visible { outline: 2px solid var(--va-accent); outline-offset: -2px; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-cdiff__btn,\n  .va-cdiff__expand { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/code-diff/types.ts",
      "type": "registry:ui",
      "target": "components/ui/code-diff/types.ts",
      "content": "/** VaCodeDiff 的类型定义 */\n\nexport interface CodeDiffProps {\n  /** 旧版本文本（按行 diff） */\n  oldText: string;\n  /** 新版本文本 */\n  newText: string;\n  /** 文件名/路径，头部展示（等宽） */\n  fileName?: string;\n  /** 变更行前后保留的上下文行数，其余折叠；0 = 只显示变更行 */\n  context?: number;\n  /** 行内词级高亮（配对的 del/add 行做词级 diff） */\n  wordLevel?: boolean;\n  /** 初始全部展开（不折叠上下文） */\n  defaultExpandAll?: boolean;\n  /** 内容区最大高度 px，超出滚动 */\n  maxHeight?: number;\n}\n\nexport interface CodeDiffStats {\n  additions: number;\n  deletions: number;\n}\n\nexport interface CodeDiffEvents {\n  /** 点击复制按钮（携带复制的完整新文本） */\n  copy: [text: string];\n}\n"
    },
    {
      "path": "components/ui/code-diff/useCodeDiff.ts",
      "type": "registry:ui",
      "target": "components/ui/code-diff/useCodeDiff.ts",
      "content": "import { computed, ref, watch } from \"vue\";\nimport { expandKey, groupHunks, lineDiff, pairInline } from \"../../utils/lineDiff\";\nimport type { RenderRow } from \"../../utils/lineDiff\";\nimport type { CodeDiffProps, CodeDiffStats } from \"./types\";\n\n/** VaCodeDiff 的渲染管线：LCS 行 diff → 行内词级配对 → hunk 折叠 */\nexport function useCodeDiff(props: CodeDiffProps) {\n  const context = computed(() =>\n    props.defaultExpandAll ? Number.POSITIVE_INFINITY : (props.context ?? 3),\n  );\n\n  const rows = computed(() => lineDiff(props.oldText, props.newText));\n  const inline = computed(() => pairInline(rows.value, props.wordLevel !== false));\n\n  const stats = computed<CodeDiffStats>(() => {\n    let additions = 0;\n    let deletions = 0;\n    for (const r of rows.value) {\n      if (r.type === \"add\") additions++;\n      else if (r.type === \"del\") deletions++;\n    }\n    return { additions, deletions };\n  });\n\n  /** 已展开的折叠段 key；源文本变化时重置 */\n  const expanded = ref<Set<string>>(new Set());\n  watch([() => props.oldText, () => props.newText], () => {\n    expanded.value = new Set();\n  });\n\n  const render = computed<RenderRow[]>(() =>\n    groupHunks(rows.value, context.value, inline.value, expanded.value),\n  );\n\n  const hasCollapsed = computed(() => render.value.some((r) => r.kind === \"expand\"));\n  /** 头部\"全部展开\"开关：切换整体 context（折叠态 ↔ ∞） */\n  const expandAll = ref(props.defaultExpandAll ?? false);\n  watch(expandAll, (v) => {\n    if (!v) expanded.value = new Set();\n  });\n\n  function toggleExpand(e: { from: number; to: number }) {\n    const next = new Set(expanded.value);\n    next.add(expandKey(e));\n    expanded.value = next;\n  }\n\n  const empty = computed(\n    () => rows.value.length === 0 || stats.value.additions + stats.value.deletions === 0,\n  );\n\n  return { render, stats, hasCollapsed, expandAll, toggleExpand, empty };\n}\n"
    }
  ]
}
