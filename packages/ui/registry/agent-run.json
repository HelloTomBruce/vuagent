      "path": "components/ui/agent-run/VaAgentRun.vue",
      "type": "registry:ui",
      "target": "components/ui/agent-run/VaAgentRun.vue",
      "content": "<script setup lang=\"ts\">\n\nimport type { AgentRunProps } from \"./types\";\n\n\nconst props = defineProps<AgentRunProps>();\n\nconst STATUS_TEXT = { running: \"运行中\", success: \"已完成\", error: \"失败\" } as const;\n\n/* ── 内联自 @vuagent/ui src/utils/format.ts（registry 单文件拷贝自包含） ── */\n/** 共享格式化工具（零依赖，SSR 安全） */\n\n/** 1420 → \"1.4s\" · 830 → \"830ms\" · 65_000 → \"1m 05s\" · 3_600_000 → \"1h 00m\" */\nfunction formatMs(ms: number): string {\n  if (!Number.isFinite(ms) || ms < 0) return \"0ms\";\n  if (ms < 1000) return `${Math.round(ms)}ms`;\n  const s = ms / 1000;\n  if (s < 60) return `${s < 10 ? s.toFixed(1) : Math.round(s)}s`;\n  const m = Math.floor(s / 60);\n  if (m < 60) return `${m}m ${String(Math.round(s % 60)).padStart(2, \"0\")}s`;\n  const h = Math.floor(m / 60);\n  if (h < 24) return `${h}h ${String(m % 60).padStart(2, \"0\")}m`;\n  return `${Math.floor(h / 24)}d ${h % 24}h`;\n}\n\n/** 980 → \"980\" · 12_400 → \"12.4K\" · 99_500 → \"99.5K\" · 1_240_000 → \"1.2M\" */\nfunction formatTokens(n: number): string {\n  if (!Number.isFinite(n) || n < 0) return \"0\";\n  if (n < 1000) return String(Math.round(n));\n  if (n < 1_000_000) {\n    const k = n / 1000;\n    const text = k < 100 ? k.toFixed(1).replace(/\\.0$/, \"\") : String(Math.round(k));\n    return `${text}K`;\n  }\n  const m = n / 1_000_000;\n  return m < 100 ? m.toFixed(1).replace(/\\.0$/, \"\") + \"M\" : `${Math.round(m)}M`;\n}\n\n/** 任意值 → 可展示文本：对象美化、JSON 字符串解析后美化、其余原样 */\nfunction toDisplayText(v: unknown): string {\n  if (v == null) return \"\";\n  if (typeof v === \"string\") {\n    const t = v.trim();\n    if (t.startsWith(\"{\") || t.startsWith(\"[\")) {\n      try {\n        return JSON.stringify(JSON.parse(t), null, 2);\n      } catch {\n        return v;\n      }\n    }\n    return v;\n  }\n  if (typeof v === \"object\") {\n    try {\n      return JSON.stringify(v, null, 2);\n    } catch {\n      return String(v);\n    }\n  }\n  return String(v);\n}\n</script>\n\n<template>\n  <section class=\"va-run\" :class=\"{ 'va-run--compact': props.compact }\">\n    <header class=\"va-run__head\">\n      <span class=\"va-run__title\">{{ props.title ?? \"Agent 运行\" }}</span>\n      <span\n        v-if=\"props.status\"\n        class=\"va-run__status\"\n        :data-status=\"props.status\"\n        role=\"status\"\n      >{{ props.statusLabel ?? STATUS_TEXT[props.status] }}</span>\n      <span class=\"va-run__spacer\" />\n      <span v-if=\"props.duration !== undefined\" class=\"va-run__time\">{{ formatMs(props.duration) }}</span>\n      <div v-if=\"$slots.actions\" class=\"va-run__actions\"><slot name=\"actions\" /></div>\n    </header>\n\n    <div class=\"va-run__grid\">\n      <section class=\"va-run__col va-run__col--plan\" :aria-label=\"`计划`\">\n        <h3 class=\"va-run__col-title\">计划</h3>\n        <slot name=\"plan\" />\n      </section>\n      <section class=\"va-run__col va-run__col--stream\" aria-label=\"执行流\">\n        <h3 class=\"va-run__col-title\">执行流</h3>\n        <slot />\n      </section>\n      <section class=\"va-run__col va-run__col--aside\" aria-label=\"上下文\">\n        <h3 class=\"va-run__col-title\">上下文</h3>\n        <slot name=\"aside\" />\n      </section>\n    </div>\n  </section>\n</template>\n\n<style>\n/* VaAgentRun — agent 运行页骨架（计划 | 执行流 | 上下文） */\n\n.va-run {\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s5);\n}\n\n.va-run__head {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s4);\n  flex-wrap: wrap;\n}\n\n.va-run__title { font-size: var(--va-fs-xl, 16px); font-weight: var(--va-fw-bold, 700); color: var(--va-ink); }\n\n.va-run__status {\n  font-size: var(--va-fs-xs, 11px);\n  font-weight: var(--va-fw-semibold, 600);\n  padding: 2px var(--va-s4h, 10px);\n  border-radius: var(--va-radius-pill);\n}\n\n.va-run__status[data-status=\"running\"] { background: var(--va-accent-soft); color: var(--va-accent); }\n.va-run__status[data-status=\"success\"] { background: color-mix(in srgb, var(--va-success) 14%, transparent); color: var(--va-success); }\n.va-run__status[data-status=\"error\"] { background: color-mix(in srgb, var(--va-danger) 12%, transparent); color: var(--va-danger); }\n\n.va-run__spacer { flex: 1; }\n\n.va-run__time {\n  font-family: var(--va-font-mono);\n  font-size: var(--va-fs-md, 13px);\n  color: var(--va-muted);\n  font-variant-numeric: tabular-nums;\n}\n\n.va-run__actions { display: flex; gap: var(--va-s2); }\n\n.va-run__grid {\n  display: grid;\n  grid-template-columns: minmax(240px, 1fr) minmax(0, 2.2fr) minmax(220px, 1fr);\n  gap: var(--va-s5);\n  align-items: start;\n}\n\n.va-run--compact .va-run__grid { grid-template-columns: 1fr; }\n\n.va-run__col {\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s3);\n  min-width: 0;\n}\n\n.va-run__col-title {\n  margin: 0;\n  font-size: var(--va-fs-xs, 11px);\n  font-weight: var(--va-fw-bold, 700);\n  letter-spacing: var(--va-tracking-wider, 0.06em);\n  text-transform: uppercase;\n  color: var(--va-muted);\n}\n\n@media (max-width: 1200px) {\n  .va-run__grid { grid-template-columns: 1fr 1fr; }\n  .va-run__col--stream { grid-column: 1 / -1; order: -1; }\n}\n\n@media (max-width: 760px) {\n  .va-run__grid { grid-template-columns: 1fr; }\n}\n</style>\n"
    },
