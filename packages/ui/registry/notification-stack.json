{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "notification-stack",
  "title": "Notification Stack",
  "description": "通知中心列表：未读徽标与未读点、语义 icon（info/success/warning/danger/agent）、相对时间、单条/全部已读。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [
    "@vuagent/checkpoint-list"
  ],
  "docs": "- `notifications` (NotificationItem[]，默认 -)：id/title/body/kind/unread/createdAt\n- `@open / @read / @allRead` (-，默认 -)：打开 / 标记已读",
  "files": [
    {
      "path": "components/ui/notification-stack/VaNotificationStack.vue",
      "type": "registry:ui",
      "target": "components/ui/notification-stack/VaNotificationStack.vue",
      "content": "<script setup lang=\"ts\">import { computed, onBeforeUnmount, ref, watch, type Ref } from \"vue\";\n\nimport type { NotificationStackEvents, NotificationStackProps } from \"./types\";\nimport { formatRelative } from \"../checkpoint-list/useCheckpointList\";\n\n\nconst props = withDefaults(defineProps<NotificationStackProps>(), { relativeTime: true });\n\nconst emit = defineEmits<NotificationStackEvents>();\n\nconst alive = computed(() => props.notifications.length > 0);\nconst now = useNow(30_000, alive);\n\nconst unread = computed(() => props.notifications.filter((n) => n.unread).length);\n\nconst ICON: Record<string, string> = {\n  info: \"i\",\n  success: \"✓\",\n  warning: \"!\",\n  danger: \"✕\",\n  agent: \"✦\",\n};\n\nfunction onOpen(id: string) {\n  const item = props.notifications.find((n) => n.id === id);\n  if (!item) return;\n  if (item.unread) emit(\"read\", id);\n  emit(\"open\", item);\n}\n\n/* ── 内联自 @vuagent/ui src/composables/useNow.ts（registry 单文件拷贝自包含） ── */\n/**\n * 共享实时时钟：enabled 为 true 期间按 interval 更新 now（ms 时间戳）。\n * 供工具卡计时、计划计时、收件箱时钟等场景复用；SSR 安全。\n */\nfunction useNow(intervalMs: number, enabled: Ref<boolean>): Readonly<Ref<number>> {\n  const now = ref(Date.now());\n  let timer: number | undefined;\n\n  function start() {\n    if (timer !== undefined || typeof window === \"undefined\") return;\n    now.value = Date.now();\n    timer = window.setInterval(() => (now.value = Date.now()), intervalMs);\n  }\n  function stop() {\n    if (timer !== undefined) {\n      window.clearInterval(timer);\n      timer = undefined;\n    }\n  }\n\n  watch(enabled, (v) => (v ? start() : stop()), { immediate: true });\n  onBeforeUnmount(stop);\n\n  return now as Readonly<Ref<number>>;\n}\n</script>\n\n<template>\n  <section class=\"va-ns\" :aria-label=\"props.title ?? '通知'\">\n    <header class=\"va-ns__head\">\n      <h3 class=\"va-ns__title\">\n        {{ props.title ?? \"通知\" }}\n        <span v-if=\"unread\" class=\"va-ns__count\">{{ unread }}</span>\n      </h3>\n      <button\n        v-if=\"unread\"\n        class=\"va-ns__allread\"\n        type=\"button\"\n        @click=\"emit('allRead')\"\n      >全部已读</button>\n    </header>\n\n    <p v-if=\"!props.notifications.length\" class=\"va-ns__empty va-fade-in\">{{ props.emptyLabel ?? \"没有新通知\" }}</p>\n    <TransitionGroup\n      v-else\n      tag=\"ul\"\n      name=\"va-ns\"\n      class=\"va-ns__list\"\n      :style=\"props.maxHeight ? { maxHeight: `${props.maxHeight}px` } : undefined\"\n    >\n      <li\n        v-for=\"n in props.notifications\"\n        :key=\"n.id\"\n        class=\"va-ns__item\"\n        :data-kind=\"n.kind ?? 'info'\"\n        :data-unread=\"n.unread ?? false\"\n      >\n        <button class=\"va-ns__main\" type=\"button\" @click=\"onOpen(n.id)\">\n          <span class=\"va-ns__icon\" aria-hidden=\"true\">{{ ICON[n.kind ?? \"info\"] }}</span>\n          <span class=\"va-ns__text\">\n            <span class=\"va-ns__t\">{{ n.title }}</span>\n            <span v-if=\"n.body\" class=\"va-ns__b\">{{ n.body }}</span>\n            <span v-if=\"n.createdAt && props.relativeTime\" class=\"va-ns__time\">\n              {{ formatRelative(n.createdAt, now) }}\n            </span>\n          </span>\n        </button>\n        <span v-if=\"n.unread\" class=\"va-ns__dot\" aria-label=\"未读\" />\n      </li>\n    </TransitionGroup>\n  </section>\n</template>\n\n<style>\n/* VaNotificationStack — 通知中心列表 */\n\n.va-ns {\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-m, 10px);\n  background: var(--va-card, #ffffff);\n  overflow: hidden;\n}\n\n.va-ns__head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: var(--va-s3, 8px) var(--va-s4, 12px);\n  border-bottom: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  background: var(--va-bg-subtle, #efede7);\n}\n\n.va-ns__title {\n  margin: 0;\n  font-size: var(--va-fs-md, 13px);\n  font-weight: var(--va-fw-bold, 700);\n  color: var(--va-ink, #1a1917);\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3, 8px);\n}\n\n.va-ns__count {\n  min-width: 18px;\n  height: 18px;\n  border-radius: var(--va-radius-pill, 999px);\n  background: var(--va-accent, #c2410c);\n  color: var(--va-card, #ffffff);\n  font-size: var(--va-fs-xs, 11px);\n  font-weight: var(--va-fw-bold, 700);\n  line-height: 18px;\n  text-align: center;\n  padding: 0 5px;\n}\n\n.va-ns__allread {\n  border: 0;\n  background: transparent;\n  color: var(--va-info, #2563eb);\n  font-size: var(--va-fs-sm, 12px);\n  cursor: pointer;\n}\n\n.va-ns__allread:hover { text-decoration: underline; }\n.va-ns__allread:focus-visible { outline: 2px solid var(--va-accent, #c2410c); }\n\n.va-ns__list {\n  /* 离场项 position:absolute 的包含块：缺它会让 width:100% 退化到视口，动画期间宽度突跳 */\n  position: relative;\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  overflow-y: auto;\n}\n\n.va-ns__item {\n  display: flex;\n  align-items: stretch;\n  border-bottom: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n}\n\n.va-ns__item:last-child { border-bottom: 0; }\n.va-ns__item[data-unread=\"true\"] { background: color-mix(in srgb, var(--va-accent, #c2410c) 4%, transparent); }\n\n.va-ns__main {\n  flex: 1;\n  display: flex;\n  align-items: flex-start;\n  gap: var(--va-s3, 8px);\n  border: 0;\n  background: transparent;\n  padding: var(--va-s3, 8px) var(--va-s4, 12px);\n  cursor: pointer;\n  text-align: left;\n  font: inherit;\n  min-width: 0;\n  transition: background var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-ns__main:hover { background: var(--va-bg-subtle, #efede7); }\n/* 按压口径（行级分轨）：hover 面朝 ink 混 15% 加深，方向随主题自适应 */\n.va-ns__main:active { background: color-mix(in srgb, var(--va-bg-subtle, #efede7) 85%, var(--va-ink, #1a1917)); }\n.va-ns__main:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: -2px; }\n\n.va-ns__icon {\n  flex: none;\n  width: 22px;\n  height: 22px;\n  border-radius: 50%;\n  font-size: var(--va-fs-xs, 11px);\n  font-weight: var(--va-fw-bold, 700);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  margin-top: 1px;\n}\n\n.va-ns__item[data-kind=\"info\"] .va-ns__icon { background: color-mix(in srgb, var(--va-info, #2563eb) 14%, transparent); color: var(--va-info, #2563eb); }\n.va-ns__item[data-kind=\"success\"] .va-ns__icon { background: color-mix(in srgb, var(--va-success, #1a7f4b) 14%, transparent); color: var(--va-success, #1a7f4b); }\n.va-ns__item[data-kind=\"warning\"] .va-ns__icon { background: color-mix(in srgb, var(--va-warning, #b45309) 16%, transparent); color: var(--va-warning, #b45309); }\n.va-ns__item[data-kind=\"danger\"] .va-ns__icon { background: color-mix(in srgb, var(--va-danger, #d5453c) 14%, transparent); color: var(--va-danger, #d5453c); }\n.va-ns__item[data-kind=\"agent\"] .va-ns__icon { background: var(--va-accent-soft, rgba(194, 65, 12, 0.1)); color: var(--va-accent, #c2410c); }\n\n.va-ns__text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }\n\n.va-ns__t { font-size: var(--va-fs-md, 13px); font-weight: var(--va-fw-semibold, 600); color: var(--va-ink, #1a1917); }\n.va-ns__b { font-size: var(--va-fs-sm, 12px); color: var(--va-ink-2, #43413c); line-height: 1.5; }\n.va-ns__time { font-size: var(--va-fs-xs, 11px); color: var(--va-muted, #6f6d66); margin-top: 2px; }\n\n.va-ns__dot {\n  flex: none;\n  align-self: center;\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: var(--va-accent, #c2410c);\n  margin-right: var(--va-s4, 12px);\n}\n\n.va-ns__empty {\n  margin: 0;\n  padding: var(--va-s6, 24px) var(--va-s4, 12px);\n  text-align: center;\n  font-size: var(--va-fs-md, 13px);\n  color: var(--va-muted, #6f6d66);\n}\n\n/* ---------- 进出编排（Vue <TransitionGroup name=\"va-ns\">） ----------\n   入场：自上方 -dist-m 滑入；离场：向右 dist-s 滑出并让位（absolute 使\n   move 重排即时生效，列表项平滑上移）；移动：transform 过渡。 */\n.va-ns-enter-active,\n.va-ns-leave-active {\n  transition:\n    opacity var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1));\n}\n.va-ns-leave-active {\n  transition-duration: var(--va-dur-out, 140ms);\n  transition-timing-function: var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2));\n  position: absolute;\n  width: 100%;\n}\n.va-ns-enter-from {\n  opacity: 0;\n  transform: translateY(calc(var(--va-dist-m, 8px) * -1));\n}\n.va-ns-leave-to {\n  opacity: 0;\n  transform: translateX(var(--va-dist-s, 4px));\n}\n.va-ns-move {\n  transition: transform var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-ns-enter-active,\n  .va-ns-leave-active,\n  .va-ns-move {\n    transition: opacity var(--va-dur-1, 120ms) linear;\n    transform: none;\n  }\n  /* 显式压掉 enter-from/leave-to 的位移（不依赖源码顺序覆盖，更稳） */\n  .va-ns-enter-from,\n  .va-ns-leave-to {\n    transform: none;\n  }\n}\n\n/* 动效工具类（自动附带，源码中来自全局 motion.css） */\n/* ============================================================\n   共享动效工具类 —— 进出场/交叉淡入的统一协议（TASK-102 动效基建）。\n   组件不逐个发明入场曲线：统一消费 --va-dur-in/--va-dur-out 骨架时长与\n   --va-dist-* 位移档；每条声明自带字面 fallback（registry 单文件拷贝分发\n   要求，与 tokens.css 门禁一致）。\n\n   接入方式二选一：\n   1. Vue <Transition>：\n      <Transition enter-active-class=\"va-enter-up\" leave-active-class=\"va-exit-up\">\n      动画 fill-mode 为 both（延迟期间保持首帧、播完停在终态），\n      无需再配 enter-from-class / leave-to-class；\n   2. 类切换重挂载：骨架 → 内容换节点时给新节点挂 .va-crossfade（纯淡入），\n      离场节点挂 .va-exit-*（更短更快）。\n\n   列表错峰：v-for 子项 :style=\"useStagger().delayStyle(i)\" 配合 .va-enter-*\n   动画类使用（animation-delay 由 composable 编排——.va-enter-* 为 CSS animation，\n   transition-delay 对其零作用，见 composables/useStagger.ts）。\n   ============================================================ */\n\n/* 入场：上浮（自下方 --va-dist-m 浮起） */\n@keyframes va-motion-in-up {\n  from { opacity: 0; transform: translateY(var(--va-dist-m, 8px)); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* 入场：左滑（自左侧 --va-dist-m 滑入） */\n@keyframes va-motion-in-left {\n  from { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n  to { opacity: 1; transform: translateX(0); }\n}\n\n/* 入场：缩放（96% 起放大至原尺寸） */\n@keyframes va-motion-in-scale {\n  from { opacity: 0; transform: scale(0.96); }\n  to { opacity: 1; transform: scale(1); }\n}\n\n/* 离场：与入场互逆（向上/向左飘出、缩回）；时长/曲线由工具类映射 --va-dur-out 骨架 */\n@keyframes va-motion-out-up {\n  from { opacity: 1; transform: translateY(0); }\n  to { opacity: 0; transform: translateY(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-left {\n  from { opacity: 1; transform: translateX(0); }\n  to { opacity: 0; transform: translateX(calc(-1 * var(--va-dist-m, 8px))); }\n}\n\n@keyframes va-motion-out-scale {\n  from { opacity: 1; transform: scale(1); }\n  to { opacity: 0; transform: scale(0.96); }\n}\n\n/* 交叉淡入/淡出（.va-crossfade 骨架→内容交换专用，无位移，避免占位跳变叠加） */\n@keyframes va-motion-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes va-motion-fade-out {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n/* ---- 工具类：入场走 --va-dur-in + ease-out-quart，离场走 --va-dur-out + ease-in-quad ---- */\n\n.va-enter-up {\n  animation: va-motion-in-up var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-left {\n  animation: va-motion-in-left var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-enter-scale {\n  animation: va-motion-in-scale var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n.va-exit-up {\n  animation: va-motion-out-up var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-left {\n  animation: va-motion-out-left var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n.va-exit-scale {\n  animation: va-motion-out-scale var(--va-dur-out, 140ms) var(--va-ease-in-quad, cubic-bezier(0.55, 0, 0.55, 0.2)) both;\n}\n\n/* 骨架 → 内容交叉过渡：新内容纯淡入 */\n.va-crossfade {\n  animation: va-motion-fade-in var(--va-dur-in, 180ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* 空态/轻量状态渐入（TASK-106 弱化档）：仅 opacity、时长走 --va-dur-2，\n   供列表空态提示与一次性状态块使用（空态清单见 TASK-106 报告）。\n   纯 opacity 即动效分频策略的降级终点形态，reduced-motion 下保持原样即可。 */\n.va-fade-in {\n  animation: va-motion-fade-in var(--va-dur-2, 200ms) var(--va-ease-out-quart, cubic-bezier(0.22, 1, 0.36, 1)) both;\n}\n\n/* ---- 静态光斑基类（TASK-105，决策 5「追光」路线基建）----\n   pointer 坐标由 composables/useSpotlight.ts 以 rAF 节流写入 --va-spot-x/y\n   （元素内百分比，光斑数学在 composable 内可单测）；本类只负责 radial 光斑\n   绘制与显隐（:hover 点亮，无 3D 倾斜， glare 数学对齐 VaTiltCard）。\n   --va-spot-* 为 L3 组件钩子口径（宿主可覆盖尺寸/颜色），不进 tokens.css。\n   双降级对齐 VaTiltCard glare：hover: none（触屏）与 reduced-motion 不绘制。 */\n.va-spotlight { position: relative; }\n\n/* ::after 承载光斑（避开组件自身 ::before 用途）；inset 0 + border-radius inherit\n   使光斑天然裁剪在宿主圆角内，无需 overflow: hidden。\n   注意：此 ::after radial 与 components/spotlight-card/VaSpotlightCard.css 的\n   .va-spot-card--spot::after 为 registry 单文件自含有意复制，改动需两处同步。 */\n.va-spotlight::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity var(--va-dur-2, 200ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n  background: radial-gradient(\n    var(--va-spot-size, 240px) circle at var(--va-spot-x, 50%) var(--va-spot-y, 50%),\n    var(--va-spot-color, rgba(255, 255, 255, 0.14)),\n    transparent 65%\n  );\n}\n\n.va-spotlight:hover::after { opacity: 1; }\n\n@media (hover: none) {\n  .va-spotlight::after { display: none; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-spotlight::after { display: none; }\n}\n\n/* ---- 复制反馈标准（TASK-106）：copy→check 交叉过渡 ----\n   容器 .va-copy 为 inline-grid 双内容同格堆叠（格子宽取较宽子项，切换零跳动）：\n   __idle = copy 态内容（图标/文字），__done = check 态内容。\n   copied 置真挂 .va-copy--done：check 以 ease-spring 微弹入场（进入 done 态时\n   transform 的目标态时序换成 --va-ease-spring → 过冲回弹），交叉时长统一 --va-dur-1。\n   消费方：terminal-log（行复制）、code-diff（复制按钮）、message-actions（复制图标）。 */\n.va-copy { display: inline-grid; place-items: center; }\n\n.va-copy__idle,\n.va-copy__done {\n  grid-area: 1 / 1;\n  transition: opacity var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-copy__idle { opacity: 1; transform: scale(1); }\n.va-copy__done { opacity: 0; transform: scale(0.6); }\n\n.va-copy--done .va-copy__done {\n  opacity: 1;\n  transform: scale(1);\n  /* 时序按 transition 属性顺序映射：opacity 仍 ease，transform 换 ease-spring 微弹 */\n  transition-timing-function: var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), var(--va-ease-spring, cubic-bezier(0.34, 1.56, 0.64, 1));\n}\n\n.va-copy--done .va-copy__idle { opacity: 0; transform: scale(0.6); }\n\n@media (prefers-reduced-motion: reduce) {\n  /* 交叉过渡瞬时完成（无位移动画），copied 状态可感知性不受影响 */\n  .va-copy__idle,\n  .va-copy__done { transition: none; }\n}\n\n/* ---- 错误反馈标准（校验失败横向微振）：目标元素挂 .va-shake 播一次 ±3px 微振 ----\n   时长 --va-dur-2 × 2（两拍四峰，克制的「摇头」量级，rubric 校验失败口径）；\n   重复触发需先移除类、强制 reflow 再挂回（封装见 composables/useShake.ts）。\n   reduced-motion 降级为不播：错误状态的可感知性由错误样式本身（描边/文案）承担，\n   动效只做注意力引导——符合头注释「功能动画降级保留状态可感知」的分频策略。\n   消费方：VaStepperForm / VaOtpInput 经 useShake() 程序化触发（defineExpose shake()）；\n   宿主自绘表单可直接挂类。 */\n@keyframes va-motion-shake {\n  20% { transform: translateX(-3px); }\n  40% { transform: translateX(3px); }\n  60% { transform: translateX(-2px); }\n  80% { transform: translateX(2px); }\n}\n\n.va-shake {\n  animation: va-motion-shake calc(var(--va-dur-2, 200ms) * 2) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-shake { animation: none; }\n}\n\n/* ---- 动效分频（对齐 tokens.css 头注释策略）：\n   功能动画降级为纯 opacity——进/出场整体换成 fade keyframes，\n   位移/缩放不再出现（animation-name 顶替，时长/缓动沿用上面的声明）。 */\n@media (prefers-reduced-motion: reduce) {\n  .va-enter-up,\n  .va-enter-left,\n  .va-enter-scale,\n  .va-crossfade {\n    animation-name: va-motion-fade-in;\n  }\n\n  .va-exit-up,\n  .va-exit-left,\n  .va-exit-scale {\n    animation-name: va-motion-fade-out;\n  }\n}\n</style>\n"
    },
