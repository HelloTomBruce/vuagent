{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "notification-stack",
  "title": "Notification Stack",
  "description": "通知中心列表：未读徽标与未读点、语义 icon（info/success/warning/danger/agent）、相对时间、单条/全部已读。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `notifications` (NotificationItem[]，默认 -)：id/title/body/kind/unread/createdAt\n- `@open / @read / @allRead` (-，默认 -)：打开 / 标记已读",
  "files": [
    {
      "path": "components/ui/notification-stack/VaNotificationStack.vue",
      "type": "registry:ui",
      "target": "components/ui/notification-stack/VaNotificationStack.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from \"vue\";\nimport type { NotificationStackEvents, NotificationStackProps } from \"./types\";\nimport { formatRelative } from \"../checkpoint-list/useCheckpointList\";\nimport { useNow } from \"../../composables/useNow\";\n\nconst props = withDefaults(defineProps<NotificationStackProps>(), { relativeTime: true });\n\nconst emit = defineEmits<NotificationStackEvents>();\n\nconst alive = computed(() => props.notifications.length > 0);\nconst now = useNow(30_000, alive);\n\nconst unread = computed(() => props.notifications.filter((n) => n.unread).length);\n\nconst ICON: Record<string, string> = {\n  info: \"i\",\n  success: \"✓\",\n  warning: \"!\",\n  danger: \"✕\",\n  agent: \"✦\",\n};\n\nfunction onOpen(id: string) {\n  const item = props.notifications.find((n) => n.id === id);\n  if (!item) return;\n  if (item.unread) emit(\"read\", id);\n  emit(\"open\", item);\n}\n</script>\n\n<template>\n  <section class=\"va-ns\" :aria-label=\"props.title ?? '通知'\">\n    <header class=\"va-ns__head\">\n      <h3 class=\"va-ns__title\">\n        {{ props.title ?? \"通知\" }}\n        <span v-if=\"unread\" class=\"va-ns__count\">{{ unread }}</span>\n      </h3>\n      <button\n        v-if=\"unread\"\n        class=\"va-ns__allread\"\n        type=\"button\"\n        @click=\"emit('allRead')\"\n      >全部已读</button>\n    </header>\n\n    <p v-if=\"!props.notifications.length\" class=\"va-ns__empty\">{{ props.emptyLabel ?? \"没有新通知\" }}</p>\n    <ul\n      v-else\n      class=\"va-ns__list\"\n      :style=\"props.maxHeight ? { maxHeight: `${props.maxHeight}px` } : undefined\"\n    >\n      <li\n        v-for=\"n in props.notifications\"\n        :key=\"n.id\"\n        class=\"va-ns__item\"\n        :data-kind=\"n.kind ?? 'info'\"\n        :data-unread=\"n.unread ?? false\"\n      >\n        <button class=\"va-ns__main\" type=\"button\" @click=\"onOpen(n.id)\">\n          <span class=\"va-ns__icon\" aria-hidden=\"true\">{{ ICON[n.kind ?? \"info\"] }}</span>\n          <span class=\"va-ns__text\">\n            <span class=\"va-ns__t\">{{ n.title }}</span>\n            <span v-if=\"n.body\" class=\"va-ns__b\">{{ n.body }}</span>\n            <span v-if=\"n.createdAt && props.relativeTime\" class=\"va-ns__time\">\n              {{ formatRelative(n.createdAt, now) }}\n            </span>\n          </span>\n        </button>\n        <span v-if=\"n.unread\" class=\"va-ns__dot\" aria-label=\"未读\" />\n      </li>\n    </ul>\n  </section>\n</template>\n\n<style>\n/* VaNotificationStack — 通知中心列表 */\n\n.va-ns {\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-m);\n  background: var(--va-card);\n  overflow: hidden;\n}\n\n.va-ns__head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: var(--va-s3) var(--va-s4);\n  border-bottom: 1px solid var(--va-edge);\n  background: var(--va-bg-subtle);\n}\n\n.va-ns__title {\n  margin: 0;\n  font-size: 13px;\n  font-weight: 700;\n  color: var(--va-ink);\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3);\n}\n\n.va-ns__count {\n  min-width: 18px;\n  height: 18px;\n  border-radius: var(--va-radius-pill);\n  background: var(--va-accent);\n  color: var(--va-card);\n  font-size: 11px;\n  font-weight: 700;\n  line-height: 18px;\n  text-align: center;\n  padding: 0 5px;\n}\n\n.va-ns__allread {\n  border: 0;\n  background: transparent;\n  color: var(--va-info);\n  font-size: 12px;\n  cursor: pointer;\n}\n\n.va-ns__allread:hover { text-decoration: underline; }\n.va-ns__allread:focus-visible { outline: 2px solid var(--va-accent); }\n\n.va-ns__list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  overflow-y: auto;\n}\n\n.va-ns__item {\n  display: flex;\n  align-items: stretch;\n  border-bottom: 1px solid var(--va-edge);\n}\n\n.va-ns__item:last-child { border-bottom: 0; }\n.va-ns__item[data-unread=\"true\"] { background: color-mix(in srgb, var(--va-accent) 4%, transparent); }\n\n.va-ns__main {\n  flex: 1;\n  display: flex;\n  align-items: flex-start;\n  gap: var(--va-s3);\n  border: 0;\n  background: transparent;\n  padding: var(--va-s3) var(--va-s4);\n  cursor: pointer;\n  text-align: left;\n  font: inherit;\n  min-width: 0;\n}\n\n.va-ns__main:hover { background: var(--va-bg-subtle); }\n.va-ns__main:focus-visible { outline: 2px solid var(--va-accent); outline-offset: -2px; }\n\n.va-ns__icon {\n  flex: none;\n  width: 22px;\n  height: 22px;\n  border-radius: 50%;\n  font-size: 11px;\n  font-weight: 700;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  margin-top: 1px;\n}\n\n.va-ns__item[data-kind=\"info\"] .va-ns__icon { background: color-mix(in srgb, var(--va-info) 14%, transparent); color: var(--va-info); }\n.va-ns__item[data-kind=\"success\"] .va-ns__icon { background: color-mix(in srgb, var(--va-success) 14%, transparent); color: var(--va-success); }\n.va-ns__item[data-kind=\"warning\"] .va-ns__icon { background: color-mix(in srgb, var(--va-warning) 16%, transparent); color: var(--va-warning); }\n.va-ns__item[data-kind=\"danger\"] .va-ns__icon { background: color-mix(in srgb, var(--va-danger) 14%, transparent); color: var(--va-danger); }\n.va-ns__item[data-kind=\"agent\"] .va-ns__icon { background: var(--va-accent-soft); color: var(--va-accent); }\n\n.va-ns__text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }\n\n.va-ns__t { font-size: 13px; font-weight: 600; color: var(--va-ink); }\n.va-ns__b { font-size: 12px; color: var(--va-ink-2); line-height: 1.5; }\n.va-ns__time { font-size: 11px; color: var(--va-muted); margin-top: 2px; }\n\n.va-ns__dot {\n  flex: none;\n  align-self: center;\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: var(--va-accent);\n  margin-right: var(--va-s4);\n}\n\n.va-ns__empty {\n  margin: 0;\n  padding: var(--va-s6) var(--va-s4);\n  text-align: center;\n  font-size: 12.5px;\n  color: var(--va-muted);\n}\n</style>\n"
    },
    {
      "path": "components/ui/notification-stack/types.ts",
      "type": "registry:ui",
      "target": "components/ui/notification-stack/types.ts",
      "content": "/** VaNotificationStack 的类型定义 */\n\nexport type NotificationKind = \"info\" | \"success\" | \"warning\" | \"danger\" | \"agent\";\n\nexport interface NotificationItem {\n  id: string;\n  title: string;\n  body?: string;\n  kind?: NotificationKind;\n  /** ms 时间戳 */\n  createdAt?: number;\n  unread?: boolean;\n  /** 点击通知主体 */\n  href?: string;\n}\n\nexport interface NotificationStackProps {\n  notifications: NotificationItem[];\n  /** 标题，默认\"通知\" */\n  title?: string;\n  /** 显示相对时间 */\n  relativeTime?: boolean;\n  /** 空态文案 */\n  emptyLabel?: string;\n  /** 列表最大高度 px */\n  maxHeight?: number;\n}\n\nexport interface NotificationStackEvents {\n  /** 点击通知（href 存在时也会触发） */\n  open: [item: NotificationItem];\n  /** 单条标记已读 */\n  read: [id: string];\n  /** 全部标记已读 */\n  allRead: [];\n}\n"
    }
  ]
}
