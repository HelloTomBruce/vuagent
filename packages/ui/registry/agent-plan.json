      "content": "/** VaAgentPlan 的类型定义 */\n\nexport type PlanStepStatus = \"pending\" | \"running\" | \"done\" | \"error\";\n\nexport interface PlanStep {\n  id: string;\n  title: string;\n  detail?: string;\n  status?: PlanStepStatus;\n  /** running 态的计时起点（ms 时间戳） */\n  startedAt?: number;\n  /** done 态的最终耗时 ms */\n  duration?: number;\n}\n\nexport interface AgentPlanProps {\n  steps: PlanStep[];\n  /** 审阅编辑模式：可重命名 / 排序 / 增删步骤 */\n  editable?: boolean;\n  title?: string;\n}\n\nexport interface AgentPlanEvents {\n  \"update:steps\": [steps: PlanStep[]];\n  retry: [step: PlanStep];\n}\n"
    },
    {
      "path": "components/ui/agent-plan/useAgentPlan.ts",
      "type": "registry:ui",
      "target": "components/ui/agent-plan/useAgentPlan.ts",
      "content": "import { computed, ref, onBeforeUnmount, watch, type Ref } from \"vue\";\n\nimport type { AgentPlanProps, PlanStep } from \"./types\";\n\n\n/**\n * VaAgentPlan 的状态逻辑：\n * - 运行视图：hasRunning 驱动共享时钟 → 每个步骤的实时计时\n * - 编辑视图：就地重命名 / 上下移 / 增删，全部以 update:steps 交还父层\n */\nexport function useAgentPlan(\n  props: AgentPlanProps,\n  emit: { \"update:steps\": (steps: PlanStep[]) => void },\n) {\n  /* ---------- 运行态：实时计时 ---------- */\n  const hasRunning = computed(() => props.steps.some((s) => s.status === \"running\"));\n  const now = useNow(500, hasRunning);\n\n  function elapsedOf(s: PlanStep): number | undefined {\n    if (s.status === \"running\") return s.startedAt != null ? now.value - s.startedAt : undefined;\n    if (s.status === \"done\") return s.duration;\n    return undefined;\n  }\n  const doneCount = computed(() => props.steps.filter((s) => s.status === \"done\").length);\n  const anyError = computed(() => props.steps.some((s) => s.status === \"error\"));\n\n  /* ---------- 编辑态 ---------- */\n  let uid = 0;\n  const editingId = ref<string | null>(null);\n  const draft = ref(\"\");\n  const addDraft = ref(\"\");\n\n  function write(next: PlanStep[]) {\n    emit[\"update:steps\"](next);\n  }\n  function startRename(step: PlanStep) {\n    editingId.value = step.id;\n    draft.value = step.title;\n  }\n  function rename(step: PlanStep) {\n    const t = draft.value.trim();\n    editingId.value = null;\n    if (!t || t === step.title) return;\n    write(props.steps.map((s) => (s.id === step.id ? { ...s, title: t } : s)));\n  }\n  function move(i: number, dir: -1 | 1) {\n    const j = i + dir;\n    if (j < 0 || j >= props.steps.length) return;\n    const next = [...props.steps];\n    const [item] = next.splice(i, 1);\n    next.splice(j, 0, item!);\n    write(next);\n  }\n  function remove(step: PlanStep) {\n    write(props.steps.filter((s) => s.id !== step.id));\n  }\n  function add() {\n    const t = addDraft.value.trim();\n    if (!t) return;\n    write([...props.steps, { id: `step-${Date.now()}-${uid++}`, title: t }]);\n    addDraft.value = \"\";\n  }\n\n  return {\n    now,\n    elapsedOf,\n    doneCount,\n    anyError,\n    editingId,\n    draft,\n    addDraft,\n    startRename,\n    rename,\n    move,\n    remove,\n    add,\n  };\n}\n\n/* ── 内联自 @vuagent/ui src/composables/useNow.ts（registry 单文件拷贝自包含） ── */\n/**\n * 共享实时时钟：enabled 为 true 期间按 interval 更新 now（ms 时间戳）。\n * 供工具卡计时、计划计时、收件箱时钟等场景复用；SSR 安全。\n */\nfunction useNow(intervalMs: number, enabled: Ref<boolean>): Readonly<Ref<number>> {\n  const now = ref(Date.now());\n  let timer: number | undefined;\n\n  function start() {\n    if (timer !== undefined || typeof window === \"undefined\") return;\n    now.value = Date.now();\n    timer = window.setInterval(() => (now.value = Date.now()), intervalMs);\n  }\n  function stop() {\n    if (timer !== undefined) {\n      window.clearInterval(timer);\n      timer = undefined;\n    }\n  }\n\n  watch(enabled, (v) => (v ? start() : stop()), { immediate: true });\n  onBeforeUnmount(stop);\n\n  return now as Readonly<Ref<number>>;\n}\n"
    }
  ]
