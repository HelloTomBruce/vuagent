{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "agent-plan",
  "title": "Agent Plan",
  "description": "执行计划：编辑态可重命名/排序/增删，运行态逐项计时打勾、失败可重试。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `steps` (PlanStep[]，默认 -)：步骤（id/title/detail/status/startedAt/duration）\n- `editable` (boolean，默认 false)：审阅编辑模式\n- `@update:steps` (-，默认 -)：编辑后的完整步骤数组\n- `@retry` (-，默认 -)：点击失败步骤的重试",
  "files": [
    {
      "path": "components/ui/agent-plan/VaAgentPlan.vue",
      "type": "registry:ui",
      "target": "components/ui/agent-plan/VaAgentPlan.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from \"vue\";\nimport type { AgentPlanProps, PlanStep } from \"./types\";\nimport { useAgentPlan } from \"./useAgentPlan\";\nimport { formatMs } from \"../../utils/format\";\n\nconst props = withDefaults(defineProps<AgentPlanProps>(), { editable: false, title: \"执行计划\" });\n\nconst emit = defineEmits<{ \"update:steps\": [steps: PlanStep[]]; retry: [step: PlanStep] }>();\n\nconst {\n  elapsedOf,\n  doneCount,\n  anyError,\n  editingId,\n  draft,\n  addDraft,\n  startRename,\n  rename,\n  move,\n  remove,\n  add,\n} = useAgentPlan(props, {\n  \"update:steps\": (steps) => emit(\"update:steps\", steps),\n});\n\nconst timeOf = computed(() => (s: PlanStep) => {\n  const ms = elapsedOf(s);\n  return ms === undefined ? undefined : formatMs(ms);\n});\n</script>\n\n<template>\n  <div class=\"va-plan\" :class=\"props.editable ? 'va-plan--edit' : ''\">\n    <header class=\"va-plan__head\">\n      <h4 class=\"va-plan__title\">{{ props.title }}</h4>\n      <span v-if=\"!props.editable && props.steps.length\" class=\"va-plan__progress\" :data-error=\"anyError || undefined\">\n        {{ doneCount }}/{{ props.steps.length }} 步\n        <template v-if=\"anyError\"> · 有失败</template>\n      </span>\n      <span v-else-if=\"props.editable\" class=\"va-plan__progress\">可调整后交给 agent 执行</span>\n    </header>\n\n    <TransitionGroup tag=\"ol\" class=\"va-plan__list\" name=\"va-plan\">\n      <li v-for=\"(s, i) in props.steps\" :key=\"s.id\" class=\"va-plan__item\" :data-status=\"s.status ?? 'pending'\">\n        <!-- 编辑模式 -->\n        <template v-if=\"props.editable\">\n          <div class=\"va-plan__edit-row\">\n            <span class=\"va-plan__idx\">{{ i + 1 }}</span>\n            <input\n              v-if=\"editingId === s.id\"\n              v-model=\"draft\"\n              class=\"va-plan__input\"\n              type=\"text\"\n              autofocus\n              @keydown.enter=\"rename(s)\"\n              @keydown.esc=\"editingId = null\"\n              @blur=\"rename(s)\"\n            />\n            <button v-else class=\"va-plan__rename\" type=\"button\" title=\"点击重命名\" @click=\"startRename(s)\">\n              {{ s.title }}\n            </button>\n            <span class=\"va-plan__ops\">\n              <button class=\"va-plan__op\" type=\"button\" aria-label=\"上移\" :disabled=\"i === 0\" @click=\"move(i, -1)\">↑</button>\n              <button class=\"va-plan__op\" type=\"button\" aria-label=\"下移\" :disabled=\"i === props.steps.length - 1\" @click=\"move(i, 1)\">↓</button>\n              <button class=\"va-plan__op va-plan__op--danger\" type=\"button\" aria-label=\"删除步骤\" @click=\"remove(s)\">✕</button>\n            </span>\n          </div>\n        </template>\n\n        <!-- 运行模式 -->\n        <template v-else>\n          <span class=\"va-plan__node\" aria-hidden=\"true\">\n            <span v-if=\"s.status === 'running'\" class=\"va-plan__spin\" />\n            <svg v-else-if=\"s.status === 'done'\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\">\n              <path d=\"M5.5 12.5l4 4L18.5 8\" />\n            </svg>\n            <svg v-else-if=\"s.status === 'error'\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\">\n              <path d=\"M12 8v4.5M12 16h.01\" />\n            </svg>\n            <span v-else class=\"va-plan__dot\" />\n          </span>\n          <div class=\"va-plan__body\">\n            <span class=\"va-plan__step-title\" :data-done=\"s.status === 'done' || undefined\">{{ s.title }}</span>\n            <span v-if=\"s.detail\" class=\"va-plan__step-detail\">{{ s.detail }}</span>\n          </div>\n          <div class=\"va-plan__side\">\n            <span v-if=\"timeOf(s) !== undefined\" class=\"va-plan__time\">{{ timeOf(s) }}</span>\n            <button v-if=\"s.status === 'error'\" class=\"va-plan__retry\" type=\"button\" @click=\"emit('retry', s)\">↻ 重试</button>\n          </div>\n        </template>\n      </li>\n    </TransitionGroup>\n\n    <div v-if=\"props.editable\" class=\"va-plan__add\">\n      <input\n        v-model=\"addDraft\"\n        class=\"va-plan__input\"\n        type=\"text\"\n        placeholder=\"添加步骤…\"\n        @keydown.enter=\"add\"\n      />\n      <button class=\"va-plan__add-btn\" type=\"button\" :disabled=\"!addDraft.trim()\" @click=\"add\">＋ 添加</button>\n    </div>\n  </div>\n</template>\n\n<style>\n/* VaAgentPlan — agent 执行计划（编辑态 / 运行态时间线） */\n.va-plan {\n  --_edge: var(--va-plan-edge, var(--va-edge, rgba(26, 25, 23, 0.12)));\n  --_muted: var(--va-plan-muted, var(--va-muted, #6f6d66));\n  --_ink: var(--va-plan-ink, var(--va-ink, #1a1917));\n  --_accent: var(--va-plan-accent, var(--va-accent, #c2410c));\n  --_success: var(--va-plan-success, var(--va-success, #1a7f4b));\n  --_danger: var(--va-plan-danger, var(--va-danger, #d5453c));\n  font-family: var(--va-font, system-ui, sans-serif);\n}\n\n.va-plan__head { display: flex; align-items: baseline; gap: var(--va-s3, 8px); margin-bottom: var(--va-s3, 8px); }\n.va-plan__title { margin: 0; font-size: 13.5px; font-weight: 650; color: var(--_ink); }\n.va-plan__progress { font-size: 12px; color: var(--_muted); }\n.va-plan__progress[data-error] { color: var(--_danger); }\n\n.va-plan__list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: grid;\n  gap: var(--va-s2, 4px);\n  position: relative;\n}\n\n/* 运行模式：时间线 */\n.va-plan__item { display: flex; align-items: flex-start; gap: var(--va-s3, 8px); position: relative; padding: 2px 0; }\n.va-plan:not(.va-plan--edit) .va-plan__item::before {\n  content: \"\";\n  position: absolute;\n  left: 10px;\n  top: 22px;\n  bottom: -6px;\n  width: 1.5px;\n  background: var(--_edge);\n}\n.va-plan__item:last-child::before { display: none; }\n.va-plan__item[data-status=\"done\"]::before { background: color-mix(in srgb, var(--_success) 40%, transparent); }\n\n.va-plan__node {\n  position: relative;\n  z-index: 1;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 21px;\n  height: 21px;\n  flex: none;\n  border-radius: 50%;\n  background: var(--va-card, #fff);\n  border: 1.5px solid var(--_edge);\n  color: var(--va-card, #fff);\n}\n.va-plan__item[data-status=\"done\"] .va-plan__node { background: var(--_success); border-color: var(--_success); }\n.va-plan__item[data-status=\"error\"] .va-plan__node { background: var(--_danger); border-color: var(--_danger); }\n.va-plan__item[data-status=\"running\"] .va-plan__node { border-color: var(--_accent); }\n.va-plan__node svg { width: 12px; height: 12px; }\n\n.va-plan__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--_edge); }\n\n.va-plan__spin {\n  width: 11px;\n  height: 11px;\n  border-radius: 50%;\n  border: 2px solid color-mix(in srgb, var(--_accent) 25%, transparent);\n  border-top-color: var(--_accent);\n  animation: va-plan-spin 0.9s linear infinite;\n}\n@keyframes va-plan-spin { to { transform: rotate(360deg); } }\n\n.va-plan__body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; padding-top: 2px; }\n.va-plan__step-title { font-size: 13px; color: var(--_ink); }\n.va-plan__step-title[data-done] { color: var(--_muted); text-decoration: line-through; text-decoration-color: color-mix(in srgb, var(--_muted) 50%, transparent); }\n.va-plan__step-detail { font-size: 12px; color: var(--_muted); }\n\n.va-plan__side { display: flex; align-items: center; gap: var(--va-s2, 4px); padding-top: 2px; flex: none; }\n.va-plan__time { font-family: var(--va-font-mono, monospace); font-size: 11.5px; color: var(--_muted); font-variant-numeric: tabular-nums; }\n.va-plan__retry {\n  border: 1px solid color-mix(in srgb, var(--_danger) 40%, transparent);\n  background: var(--va-card, #fff);\n  color: var(--_danger);\n  border-radius: var(--va-radius-pill, 999px);\n  font-size: 12px;\n  padding: 2px 10px;\n  cursor: pointer;\n  font-family: inherit;\n}\n.va-plan__retry:hover { background: color-mix(in srgb, var(--_danger) 10%, transparent); }\n.va-plan__retry:focus-visible { outline: 2px solid var(--_danger); outline-offset: 1px; }\n\n/* 编辑模式 */\n.va-plan--edit .va-plan__item {\n  background: var(--va-card, #fff);\n  border: 1px solid var(--_edge);\n  border-radius: var(--va-radius-m, 10px);\n  padding: var(--va-s2, 4px) var(--va-s3, 8px);\n}\n.va-plan__edit-row { display: flex; align-items: center; gap: var(--va-s3, 8px); width: 100%; }\n.va-plan__idx {\n  flex: none;\n  width: 18px;\n  height: 18px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: 50%;\n  background: var(--va-bg-subtle, #efede7);\n  font-size: 11px;\n  color: var(--_muted);\n}\n.va-plan__rename {\n  flex: 1;\n  min-width: 0;\n  text-align: left;\n  border: 0;\n  background: none;\n  font: inherit;\n  font-size: 13px;\n  color: var(--_ink);\n  cursor: text;\n  padding: 4px 2px;\n  border-radius: 4px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.va-plan__rename:hover { background: var(--va-bg-subtle, #efede7); }\n.va-plan__rename:focus-visible { outline: 2px solid var(--_accent); }\n.va-plan__input {\n  flex: 1;\n  min-width: 0;\n  border: 1.5px solid var(--_accent);\n  border-radius: var(--va-radius-s, 8px);\n  padding: 5px 8px;\n  font: inherit;\n  font-size: 13px;\n  background: var(--va-card, #fff);\n  color: var(--_ink);\n}\n.va-plan__input:focus { outline: none; }\n.va-plan__ops { display: inline-flex; gap: 2px; flex: none; }\n.va-plan__op {\n  width: 22px;\n  height: 22px;\n  border: 0;\n  border-radius: var(--va-radius-s, 8px);\n  background: none;\n  color: var(--_muted);\n  cursor: pointer;\n  font-size: 12px;\n  line-height: 1;\n}\n.va-plan__op:hover:not(:disabled) { background: var(--va-bg-subtle, #efede7); color: var(--_ink); }\n.va-plan__op:disabled { opacity: 0.3; cursor: default; }\n.va-plan__op--danger:hover { color: var(--_danger); }\n.va-plan__op:focus-visible { outline: 2px solid var(--_accent); }\n\n.va-plan__add { display: flex; gap: var(--va-s2, 4px); margin-top: var(--va-s3, 8px); }\n.va-plan__add-btn {\n  flex: none;\n  border: 1px solid var(--_edge);\n  background: var(--va-card, #fff);\n  color: var(--_ink);\n  border-radius: var(--va-radius-m, 10px);\n  padding: 5px var(--va-s4, 12px);\n  font-size: 13px;\n  cursor: pointer;\n  font-family: inherit;\n}\n.va-plan__add-btn:disabled { opacity: 0.4; cursor: default; }\n.va-plan__add-btn:focus-visible { outline: 2px solid var(--_accent); outline-offset: 1px; }\n\n/* FLIP 与离场 */\n.va-plan-move { transition: transform var(--va-dur-3, 300ms) var(--va-ease, ease); }\n.va-plan-leave-active { position: absolute; left: 0; right: 0; transition: opacity var(--va-dur-2, 200ms) ease; }\n.va-plan-leave-to { opacity: 0; }\n.va-plan-enter-active { transition: opacity var(--va-dur-2, 200ms) ease; }\n.va-plan-enter-from { opacity: 0; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-plan-move, .va-plan-leave-active, .va-plan-enter-active { transition: none; }\n  .va-plan__spin { animation-duration: 2s; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/agent-plan/types.ts",
      "type": "registry:ui",
      "target": "components/ui/agent-plan/types.ts",
      "content": "/** VaAgentPlan 的类型定义 */\n\nexport type PlanStepStatus = \"pending\" | \"running\" | \"done\" | \"error\";\n\nexport interface PlanStep {\n  id: string;\n  title: string;\n  detail?: string;\n  status?: PlanStepStatus;\n  /** running 态的计时起点（ms 时间戳） */\n  startedAt?: number;\n  /** done 态的最终耗时 ms */\n  duration?: number;\n}\n\nexport interface AgentPlanProps {\n  steps: PlanStep[];\n  /** 审阅编辑模式：可重命名 / 排序 / 增删步骤 */\n  editable?: boolean;\n  title?: string;\n}\n\nexport interface AgentPlanEvents {\n  \"update:steps\": [steps: PlanStep[]];\n  retry: [step: PlanStep];\n}\n"
    },
    {
      "path": "components/ui/agent-plan/useAgentPlan.ts",
      "type": "registry:ui",
      "target": "components/ui/agent-plan/useAgentPlan.ts",
      "content": "import { computed, ref } from \"vue\";\nimport type { AgentPlanProps, PlanStep } from \"./types\";\nimport { useNow } from \"../../composables/useNow\";\n\n/**\n * VaAgentPlan 的状态逻辑：\n * - 运行视图：hasRunning 驱动共享时钟 → 每个步骤的实时计时\n * - 编辑视图：就地重命名 / 上下移 / 增删，全部以 update:steps 交还父层\n */\nexport function useAgentPlan(\n  props: AgentPlanProps,\n  emit: { \"update:steps\": (steps: PlanStep[]) => void },\n) {\n  /* ---------- 运行态：实时计时 ---------- */\n  const hasRunning = computed(() => props.steps.some((s) => s.status === \"running\"));\n  const now = useNow(500, hasRunning);\n\n  function elapsedOf(s: PlanStep): number | undefined {\n    if (s.status === \"running\") return s.startedAt != null ? now.value - s.startedAt : undefined;\n    if (s.status === \"done\") return s.duration;\n    return undefined;\n  }\n  const doneCount = computed(() => props.steps.filter((s) => s.status === \"done\").length);\n  const anyError = computed(() => props.steps.some((s) => s.status === \"error\"));\n\n  /* ---------- 编辑态 ---------- */\n  let uid = 0;\n  const editingId = ref<string | null>(null);\n  const draft = ref(\"\");\n  const addDraft = ref(\"\");\n\n  function write(next: PlanStep[]) {\n    emit[\"update:steps\"](next);\n  }\n  function startRename(step: PlanStep) {\n    editingId.value = step.id;\n    draft.value = step.title;\n  }\n  function rename(step: PlanStep) {\n    const t = draft.value.trim();\n    editingId.value = null;\n    if (!t || t === step.title) return;\n    write(props.steps.map((s) => (s.id === step.id ? { ...s, title: t } : s)));\n  }\n  function move(i: number, dir: -1 | 1) {\n    const j = i + dir;\n    if (j < 0 || j >= props.steps.length) return;\n    const next = [...props.steps];\n    const [item] = next.splice(i, 1);\n    next.splice(j, 0, item!);\n    write(next);\n  }\n  function remove(step: PlanStep) {\n    write(props.steps.filter((s) => s.id !== step.id));\n  }\n  function add() {\n    const t = addDraft.value.trim();\n    if (!t) return;\n    write([...props.steps, { id: `step-${Date.now()}-${uid++}`, title: t }]);\n    addDraft.value = \"\";\n  }\n\n  return {\n    now,\n    elapsedOf,\n    doneCount,\n    anyError,\n    editingId,\n    draft,\n    addDraft,\n    startRename,\n    rename,\n    move,\n    remove,\n    add,\n  };\n}\n"
    }
  ]
}
