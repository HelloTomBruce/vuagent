{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "agent-plan",
  "title": "Agent Plan",
  "description": "执行计划：编辑态可重命名/排序/增删，运行态逐项计时打勾、失败可重试。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `steps` (PlanStep[]，默认 -)：步骤（id/title/detail/status/startedAt/duration）\n- `editable` (boolean，默认 false)：审阅编辑模式\n- `@update:steps` (-，默认 -)：编辑后的完整步骤数组\n- `@retry` (-，默认 -)：点击失败步骤的重试",
  "files": [
    {
      "path": "components/ui/agent-plan/VaAgentPlan.vue",
      "type": "registry:ui",
      "target": "components/ui/agent-plan/VaAgentPlan.vue",
      "content": "<script setup lang=\"ts\">import { computed } from \"vue\";\n\nimport type { AgentPlanProps, PlanStep } from \"./types\";\nimport { useAgentPlan } from \"./useAgentPlan\";\n\n\nconst props = withDefaults(defineProps<AgentPlanProps>(), { editable: false, title: \"执行计划\" });\n\nconst emit = defineEmits<{ \"update:steps\": [steps: PlanStep[]]; retry: [step: PlanStep] }>();\n\nconst {\n  elapsedOf,\n  doneCount,\n  anyError,\n  editingId,\n  draft,\n  addDraft,\n  startRename,\n  rename,\n  move,\n  remove,\n  add,\n} = useAgentPlan(props, {\n  \"update:steps\": (steps) => emit(\"update:steps\", steps),\n});\n\nconst timeOf = computed(() => (s: PlanStep) => {\n  const ms = elapsedOf(s);\n  return ms === undefined ? undefined : formatMs(ms);\n});\n\n/* ── 内联自 @vuagent/ui src/utils/format.ts（registry 单文件拷贝自包含） ── */\n/** 共享格式化工具（零依赖，SSR 安全） */\n\n/** 1420 → \"1.4s\" · 830 → \"830ms\" · 65_000 → \"1m 05s\" · 3_600_000 → \"1h 00m\" */\nfunction formatMs(ms: number): string {\n  if (!Number.isFinite(ms) || ms < 0) return \"0ms\";\n  if (ms < 1000) return `${Math.round(ms)}ms`;\n  const s = ms / 1000;\n  if (s < 60) return `${s < 10 ? s.toFixed(1) : Math.round(s)}s`;\n  const m = Math.floor(s / 60);\n  if (m < 60) return `${m}m ${String(Math.round(s % 60)).padStart(2, \"0\")}s`;\n  const h = Math.floor(m / 60);\n  if (h < 24) return `${h}h ${String(m % 60).padStart(2, \"0\")}m`;\n  return `${Math.floor(h / 24)}d ${h % 24}h`;\n}\n\n/** 980 → \"980\" · 12_400 → \"12.4K\" · 99_500 → \"99.5K\" · 1_240_000 → \"1.2M\" */\nfunction formatTokens(n: number): string {\n  if (!Number.isFinite(n) || n < 0) return \"0\";\n  if (n < 1000) return String(Math.round(n));\n  if (n < 1_000_000) {\n    const k = n / 1000;\n    const text = k < 100 ? k.toFixed(1).replace(/\\.0$/, \"\") : String(Math.round(k));\n    return `${text}K`;\n  }\n  const m = n / 1_000_000;\n  return m < 100 ? m.toFixed(1).replace(/\\.0$/, \"\") + \"M\" : `${Math.round(m)}M`;\n}\n\n/** 任意值 → 可展示文本：对象美化、JSON 字符串解析后美化、其余原样 */\nfunction toDisplayText(v: unknown): string {\n  if (v == null) return \"\";\n  if (typeof v === \"string\") {\n    const t = v.trim();\n    if (t.startsWith(\"{\") || t.startsWith(\"[\")) {\n      try {\n        return JSON.stringify(JSON.parse(t), null, 2);\n      } catch {\n        return v;\n      }\n    }\n    return v;\n  }\n  if (typeof v === \"object\") {\n    try {\n      return JSON.stringify(v, null, 2);\n    } catch {\n      return String(v);\n    }\n  }\n  return String(v);\n}\n</script>\n\n<template>\n  <div class=\"va-plan\" :class=\"props.editable ? 'va-plan--edit' : ''\">\n    <header class=\"va-plan__head\">\n      <h4 class=\"va-plan__title\">{{ props.title }}</h4>\n      <span v-if=\"!props.editable && props.steps.length\" class=\"va-plan__progress\" :data-error=\"anyError || undefined\">\n        {{ doneCount }}/{{ props.steps.length }} 步\n        <template v-if=\"anyError\"> · 有失败</template>\n      </span>\n      <span v-else-if=\"props.editable\" class=\"va-plan__progress\">可调整后交给 agent 执行</span>\n    </header>\n\n    <TransitionGroup tag=\"ol\" class=\"va-plan__list\" name=\"va-plan\">\n      <li v-for=\"(s, i) in props.steps\" :key=\"s.id\" class=\"va-plan__item\" :data-status=\"s.status ?? 'pending'\">\n        <!-- 编辑模式 -->\n        <template v-if=\"props.editable\">\n          <div class=\"va-plan__edit-row\">\n            <span class=\"va-plan__idx\">{{ i + 1 }}</span>\n            <input\n              v-if=\"editingId === s.id\"\n              v-model=\"draft\"\n              class=\"va-plan__input\"\n              type=\"text\"\n              autofocus\n              @keydown.enter=\"rename(s)\"\n              @keydown.esc=\"editingId = null\"\n              @blur=\"rename(s)\"\n            />\n            <button v-else class=\"va-plan__rename\" type=\"button\" title=\"点击重命名\" @click=\"startRename(s)\">\n              {{ s.title }}\n            </button>\n            <span class=\"va-plan__ops\">\n              <button class=\"va-act va-act--ghost va-plan__op\" type=\"button\" aria-label=\"上移\" :disabled=\"i === 0\" @click=\"move(i, -1)\">↑</button>\n              <button class=\"va-act va-act--ghost va-plan__op\" type=\"button\" aria-label=\"下移\" :disabled=\"i === props.steps.length - 1\" @click=\"move(i, 1)\">↓</button>\n              <button class=\"va-act va-act--ghost va-plan__op va-plan__op--danger\" type=\"button\" aria-label=\"删除步骤\" @click=\"remove(s)\">✕</button>\n            </span>\n          </div>\n        </template>\n\n        <!-- 运行模式 -->\n        <template v-else>\n          <span class=\"va-plan__node\" aria-hidden=\"true\">\n            <span v-if=\"s.status === 'running'\" class=\"va-plan__spin\" />\n            <svg v-else-if=\"s.status === 'done'\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\">\n              <path d=\"M5.5 12.5l4 4L18.5 8\" />\n            </svg>\n            <svg v-else-if=\"s.status === 'error'\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\">\n              <path d=\"M12 8v4.5M12 16h.01\" />\n            </svg>\n            <span v-else class=\"va-plan__dot\" />\n          </span>\n          <div class=\"va-plan__body\">\n            <span class=\"va-plan__step-title\" :data-done=\"s.status === 'done' || undefined\">{{ s.title }}</span>\n            <span v-if=\"s.detail\" class=\"va-plan__step-detail\">{{ s.detail }}</span>\n          </div>\n          <div class=\"va-plan__side\">\n            <span v-if=\"timeOf(s) !== undefined\" class=\"va-plan__time\">{{ timeOf(s) }}</span>\n            <button v-if=\"s.status === 'error'\" class=\"va-act va-act--sm va-act--danger va-plan__retry\" type=\"button\" @click=\"emit('retry', s)\">↻ 重试</button>\n          </div>\n        </template>\n      </li>\n    </TransitionGroup>\n\n    <div v-if=\"props.editable\" class=\"va-plan__add\">\n      <input\n        v-model=\"addDraft\"\n        class=\"va-plan__input\"\n        type=\"text\"\n        placeholder=\"添加步骤…\"\n        @keydown.enter=\"add\"\n      />\n      <button class=\"va-plan__add-btn\" type=\"button\" :disabled=\"!addDraft.trim()\" @click=\"add\">＋ 添加</button>\n    </div>\n  </div>\n</template>\n\n<style>\n/* VaAgentPlan — agent 执行计划（编辑态 / 运行态时间线） */\n.va-plan {\n  --_edge: var(--va-plan-edge, var(--va-edge, rgba(26, 25, 23, 0.12)));\n  --_muted: var(--va-plan-muted, var(--va-muted, #6f6d66));\n  --_ink: var(--va-plan-ink, var(--va-ink, #1a1917));\n  --_accent: var(--va-plan-accent, var(--va-accent, #c2410c));\n  --_success: var(--va-plan-success, var(--va-success, #1a7f4b));\n  --_danger: var(--va-plan-danger, var(--va-danger, #d5453c));\n  font-family: var(--va-font, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Helvetica Neue\", sans-serif);\n}\n\n.va-plan .va-plan__head { display: flex; align-items: baseline; gap: var(--va-s3, 8px); margin-bottom: var(--va-s3, 8px); }\n.va-plan .va-plan__title {\n  margin: 0;\n  font-size: var(--va-fs-lg, 14px);\n  line-height: var(--va-lh-tight, 1.3);\n  letter-spacing: normal;\n  font-weight: var(--va-fw-semibold, 600);\n  color: var(--_ink);\n  position: static; /* 防宿主 heading 样式（如 .vp-doc h4）注入 margin/line-height */\n}\n.va-plan .va-plan__progress { font-size: var(--va-fs-sm, 12px); color: var(--_muted); }\n.va-plan .va-plan__progress[data-error] { color: var(--_danger); }\n\n.va-plan .va-plan__list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: grid;\n  gap: var(--va-s2, 4px);\n  position: relative;\n}\n\n/* 运行模式：时间线 */\n.va-plan .va-plan__item { display: flex; align-items: flex-start; gap: var(--va-s3, 8px); position: relative; padding: 2px 0; margin: 0; /* 防宿主 li 规则（如 .vp-doc li + li）注入间距 */ }\n.va-plan:not(.va-plan--edit) .va-plan__item::before {\n  content: \"\";\n  position: absolute;\n  left: 10px;\n  top: 22px;\n  bottom: -6px;\n  width: 1.5px;\n  background: var(--_edge);\n}\n.va-plan .va-plan__item:last-child::before { display: none; }\n.va-plan .va-plan__item[data-status=\"done\"]::before { background: color-mix(in srgb, var(--_success) 40%, transparent); }\n\n.va-plan .va-plan__node {\n  position: relative;\n  z-index: 1;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 21px;\n  height: 21px;\n  flex: none;\n  border-radius: 50%;\n  background: var(--va-card, #ffffff);\n  border: 1.5px solid var(--_edge);\n  color: var(--va-card, #ffffff);\n}\n.va-plan .va-plan__item[data-status=\"done\"] .va-plan__node { background: var(--_success); border-color: var(--_success); }\n.va-plan .va-plan__item[data-status=\"error\"] .va-plan__node { background: var(--_danger); border-color: var(--_danger); }\n.va-plan .va-plan__item[data-status=\"running\"] .va-plan__node { border-color: var(--_accent); }\n.va-plan .va-plan__node svg { width: 12px; height: 12px; }\n\n.va-plan .va-plan__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--_edge); }\n\n.va-plan .va-plan__spin {\n  width: 11px;\n  height: 11px;\n  border-radius: 50%;\n  border: 2px solid color-mix(in srgb, var(--_accent) 25%, transparent);\n  border-top-color: var(--_accent);\n  animation: va-spin calc(var(--va-dur-loop, 1.8s) * 0.5) linear infinite;\n}\n@keyframes va-spin { to { transform: rotate(360deg); } }\n\n.va-plan .va-plan__body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; padding-top: 2px; }\n.va-plan .va-plan__step-title { font-size: var(--va-fs-md, 13px); color: var(--_ink); }\n.va-plan .va-plan__step-title[data-done] { color: var(--_muted); text-decoration: line-through; text-decoration-color: color-mix(in srgb, var(--_muted) 50%, transparent); }\n.va-plan .va-plan__step-detail { font-size: var(--va-fs-sm, 12px); color: var(--_muted); }\n\n.va-plan .va-plan__side { display: flex; align-items: center; gap: var(--va-s2, 4px); padding-top: 2px; flex: none; }\n.va-plan .va-plan__time { font-family: var(--va-font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace); font-size: var(--va-fs-xs, 11px); color: var(--_muted); font-variant-numeric: tabular-nums; }\n/* va-act danger 基类兜底，仅保留危险 pill 形态 */\n.va-plan .va-plan__retry {\n  border-radius: var(--va-radius-pill, 999px);\n  border-color: color-mix(in srgb, var(--_danger) 40%, transparent);\n}\n.va-plan .va-plan__retry:hover:not(:disabled) { background: color-mix(in srgb, var(--_danger) 10%, transparent); }\n\n/* 编辑模式 */\n.va-plan--edit .va-plan__item {\n  background: var(--va-card, #ffffff);\n  border: 1px solid var(--_edge);\n  border-radius: var(--va-radius-m, 10px);\n  padding: var(--va-s2, 4px) var(--va-s3, 8px);\n}\n.va-plan .va-plan__edit-row { display: flex; align-items: center; gap: var(--va-s3, 8px); width: 100%; }\n.va-plan .va-plan__idx {\n  flex: none;\n  width: 18px;\n  height: 18px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: 50%;\n  background: var(--va-bg-subtle, #efede7);\n  font-size: var(--va-fs-xs, 11px);\n  color: var(--_muted);\n}\n.va-plan .va-plan__rename {\n  flex: 1;\n  min-width: 0;\n  text-align: left;\n  border: 0;\n  background: none;\n  font: inherit;\n  font-size: var(--va-fs-md, 13px);\n  color: var(--_ink);\n  cursor: text;\n  padding: 4px 2px;\n  border-radius: 4px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.va-plan .va-plan__rename:hover { background: var(--va-bg-subtle, #efede7); }\n.va-plan .va-plan__rename:focus-visible { outline: 2px solid var(--_accent); }\n.va-plan .va-plan__input {\n  flex: 1;\n  min-width: 0;\n  border: 1.5px solid var(--_accent);\n  border-radius: var(--va-radius-s, 8px);\n  padding: 5px 8px;\n  font: inherit;\n  font-size: var(--va-fs-md, 13px);\n  background: var(--va-card, #ffffff);\n  color: var(--_ink);\n}\n.va-plan .va-plan__input:focus { outline: none; }\n.va-plan .va-plan__ops { display: inline-flex; gap: 2px; flex: none; }\n/* va-act ghost 基类兜底，仅保留 22px 图标方钮形态 */\n.va-plan .va-plan__op { width: 22px; height: 22px; padding: 0; font-size: var(--va-fs-sm, 12px); color: var(--_muted); }\n.va-plan .va-plan__op:hover:not(:disabled) { color: var(--_ink); }\n.va-plan .va-plan__op--danger:hover { color: var(--_danger); }\n\n.va-plan .va-plan__add { display: flex; gap: var(--va-s2, 4px); margin-top: var(--va-s3, 8px); }\n.va-plan .va-plan__add-btn {\n  flex: none;\n  border: 1px solid var(--_edge);\n  background: var(--va-card, #ffffff);\n  color: var(--_ink);\n  border-radius: var(--va-radius-m, 10px);\n  padding: 5px var(--va-s4, 12px);\n  font-size: var(--va-fs-md, 13px);\n  cursor: pointer;\n  font-family: inherit;\n}\n.va-plan .va-plan__add-btn:disabled { opacity: 0.4; cursor: default; }\n.va-plan .va-plan__add-btn:focus-visible { outline: 2px solid var(--_accent); outline-offset: 1px; }\n\n/* FLIP 与离场 */\n.va-plan-move { transition: transform var(--va-dur-3, 300ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)); }\n.va-plan-leave-active { position: absolute; left: 0; right: 0; transition: opacity var(--va-dur-2, 200ms) ease; }\n.va-plan-leave-to { opacity: 0; }\n.va-plan-enter-active { transition: opacity var(--va-dur-2, 200ms) ease; }\n.va-plan-enter-from { opacity: 0; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-plan-move, .va-plan-leave-active, .va-plan-enter-active { transition: none; }\n  /* 减速不停：加载态必须保持可感知（2s = 底速 × 10/9） */\n  .va-plan .va-plan__spin { animation-duration: calc(var(--va-dur-loop, 1.8s) * 10 / 9); }\n}\n\n/* 按钮基类（自动附带） */\n/* ============================================================\n   按钮基类 —— 全库动作按钮的单一样式来源。\n   组件叠加使用：class=\"va-act va-act--primary va-xxx__submit\"，\n   组件自己的 CSS 只写布局/色彩覆盖（width、pill 圆角等）。\n   registry 生成器会把本文件自动内联进用了 va-act 的组件拷贝。\n   ============================================================ */\n\n.va-act {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--va-s3h, 6px);\n  border: 1px solid var(--va-edge, rgba(26, 25, 23, 0.12));\n  border-radius: var(--va-radius-s, 8px);\n  background: var(--va-card, #ffffff);\n  color: var(--va-ink-2, #43413c);\n  font: inherit;\n  font-size: var(--va-fs-md, 13px);\n  line-height: 1.4;\n  padding: 5px 14px;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: border-color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)), background var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    color var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1)),\n    transform var(--va-dur-1, 120ms) var(--va-ease, cubic-bezier(0.22, 1, 0.36, 1));\n}\n\n.va-act:hover:not(:disabled) { border-color: var(--va-edge-strong, rgba(26, 25, 23, 0.22)); }\n\n/* 按压反馈（TASK-105 基类口径，对齐 VaButton）：下沉 0.5px + 微缩 0.985，\n   时长走 --va-dur-1。组件不再逐个发明 :active 缩放值。 */\n.va-act:active:not(:disabled) { transform: translateY(0.5px) scale(0.985); }\n\n.va-act:focus-visible { outline: 2px solid var(--va-accent, #c2410c); outline-offset: 1px; }\n\n.va-act:disabled { opacity: 0.45; cursor: default; }\n\n/* 尺寸 */\n.va-act--sm { font-size: var(--va-fs-sm, 12px); padding: 3px var(--va-s4h, 10px); }\n.va-act--lg { font-size: var(--va-fs-lg, 14px); padding: 7px 18px; }\n\n/* 变体 */\n.va-act--primary {\n  background: var(--va-accent, #c2410c);\n  border-color: var(--va-accent, #c2410c);\n  color: var(--va-card, #ffffff);\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n.va-act--primary:hover:not(:disabled) {\n  background: var(--va-accent-hover, #9a3412);\n  border-color: var(--va-accent-hover, #9a3412);\n}\n\n.va-act--ghost {\n  border-color: transparent;\n  background: transparent;\n}\n\n.va-act--ghost:hover:not(:disabled) { background: var(--va-bg-subtle, #efede7); }\n\n.va-act--danger { border-color: transparent; background: transparent; color: var(--va-danger, #d5453c); }\n\n.va-act--danger:hover:not(:disabled) {\n  background: color-mix(in srgb, var(--va-danger, #d5453c) 10%, transparent);\n  border-color: transparent;\n}\n\n/* 语义色实底（成功/危险确认场景，按需叠加） */\n.va-act--success {\n  background: var(--va-success, #1a7f4b);\n  border-color: var(--va-success, #1a7f4b);\n  color: #fff;\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n/* 墨色实底：审批/决策/应用这类\"终审\"主操作（区别于 accent 常规主操作） */\n.va-act--ink {\n  background: var(--va-ink, #1a1917);\n  border-color: var(--va-ink, #1a1917);\n  color: var(--va-card, #ffffff);\n  font-weight: var(--va-fw-semibold, 600);\n}\n\n.va-act--ink:hover:not(:disabled) { opacity: 0.88; }\n\n@media (prefers-reduced-motion: reduce) {\n  .va-act { transition: none; }\n  /* 按压降级：去位移，只留透明度反馈（状态可感知性保留，TASK-105 口径） */\n  .va-act:active:not(:disabled) { transform: none; opacity: 0.7; }\n}\n</style>\n"
    },
