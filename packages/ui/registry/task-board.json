{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "task-board",
  "title": "Task Board",
  "description": "任务看板：列 × 卡片（优先级色点、负责人首字母、角标 meta），列计数自动、卡片哨兵受控选中。",
  "type": "registry:ui",
  "dependencies": [],
  "registryDependencies": [],
  "docs": "- `columns / tasks` (BoardColumn[] / BoardTask[]，默认 -)：列与任务（columnId 关联）\n- `v-model:selected` (string，默认 -)：选中任务 id\n- `@open` (-，默认 -)：点击卡片（携带任务）",
  "files": [
    {
      "path": "components/ui/task-board/VaTaskBoard.vue",
      "type": "registry:ui",
      "target": "components/ui/task-board/VaTaskBoard.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, ref } from \"vue\";\nimport type { TaskBoardEvents, TaskBoardProps } from \"./types\";\nimport type { BoardTask } from \"./types\";\n\nconst props = defineProps<TaskBoardProps>();\n\nconst emit = defineEmits<TaskBoardEvents>();\n\nconst touched = ref(false);\nconst inner = ref<string | undefined>(props.defaultSelected);\nconst selectedId = computed(() =>\n  props.selected !== undefined || touched.value ? props.selected : inner.value,\n);\n\nconst byColumn = (colId: string) => props.tasks.filter((t) => t.columnId === colId);\n\nfunction open(task: BoardTask) {\n  touched.value = true;\n  inner.value = task.id;\n  emit(\"update:selected\", task.id);\n  emit(\"open\", task);\n}\n</script>\n\n<template>\n  <div class=\"va-board\" role=\"list\" aria-label=\"任务看板\">\n    <section v-for=\"col in props.columns\" :key=\"col.id\" class=\"va-board__col\" :aria-label=\"col.title\">\n      <header class=\"va-board__col-head\">\n        <span class=\"va-board__col-title\">{{ col.title }}</span>\n        <span class=\"va-board__count\">{{ col.hint ?? byColumn(col.id).length }}</span>\n      </header>\n      <div class=\"va-board__cards\">\n        <p v-if=\"!byColumn(col.id).length\" class=\"va-board__none\">空</p>\n        <button\n          v-for=\"t in byColumn(col.id)\"\n          :key=\"t.id\"\n          class=\"va-board__card\"\n          type=\"button\"\n          :data-selected=\"t.id === selectedId\"\n          @click=\"open(t)\"\n        >\n          <span class=\"va-board__card-title\">{{ t.title }}</span>\n          <span class=\"va-board__card-foot\">\n            <span v-if=\"t.priority\" class=\"va-board__prio\" :data-priority=\"t.priority\" :aria-label=\"`优先级：${t.priority}`\" />\n            <span v-if=\"t.meta\" class=\"va-board__meta\">{{ t.meta }}</span>\n            <span v-if=\"t.assignee\" class=\"va-board__assignee\" :aria-label=\"`负责人 ${t.assignee}`\">{{ t.assignee.slice(0, 1) }}</span>\n          </span>\n        </button>\n      </div>\n    </section>\n  </div>\n</template>\n\n<style>\n/* VaTaskBoard — 任务看板（列 × 卡片） */\n\n.va-board {\n  display: grid;\n  grid-auto-flow: column;\n  grid-auto-columns: minmax(220px, 1fr);\n  gap: var(--va-s4);\n  overflow-x: auto;\n  align-items: start;\n}\n\n.va-board__col {\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s3);\n  border-radius: var(--va-radius-m);\n  background: var(--va-bg-subtle);\n  padding: var(--va-s3);\n  min-height: 160px;\n}\n\n.va-board__col-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 var(--va-s2);\n}\n\n.va-board__col-title { font-size: 12px; font-weight: 700; color: var(--va-ink-2); }\n\n.va-board__count {\n  font-size: 11px;\n  color: var(--va-muted);\n  background: var(--va-card);\n  border-radius: var(--va-radius-pill);\n  padding: 0 7px;\n  line-height: 17px;\n  font-variant-numeric: tabular-nums;\n}\n\n.va-board__cards { display: flex; flex-direction: column; gap: var(--va-s2); }\n\n.va-board__none {\n  margin: 0;\n  padding: var(--va-s4);\n  text-align: center;\n  font-size: 11.5px;\n  color: var(--va-muted);\n  border: 1px dashed var(--va-edge);\n  border-radius: var(--va-radius-s);\n}\n\n.va-board__card {\n  display: flex;\n  flex-direction: column;\n  gap: var(--va-s3);\n  border: 1px solid var(--va-edge);\n  border-radius: var(--va-radius-s);\n  background: var(--va-card);\n  padding: var(--va-s3) var(--va-s4);\n  cursor: pointer;\n  text-align: left;\n  font: inherit;\n  transition: border-color var(--va-dur-1) var(--va-ease), box-shadow var(--va-dur-1) var(--va-ease);\n}\n\n.va-board__card:hover { border-color: var(--va-edge-strong); box-shadow: var(--va-shadow-1); }\n.va-board__card:focus-visible { outline: 2px solid var(--va-accent); outline-offset: -2px; }\n.va-board__card[data-selected=\"true\"] { border-color: var(--va-accent); box-shadow: 0 0 0 3px var(--va-accent-soft); }\n\n.va-board__card-title {\n  font-size: 13px;\n  color: var(--va-ink);\n  line-height: 1.45;\n}\n\n.va-board__card-foot {\n  display: flex;\n  align-items: center;\n  gap: var(--va-s3);\n}\n\n.va-board__prio {\n  width: 8px;\n  height: 8px;\n  border-radius: 2px;\n}\n\n.va-board__prio[data-priority=\"high\"] { background: var(--va-danger); }\n.va-board__prio[data-priority=\"medium\"] { background: var(--va-warning); }\n.va-board__prio[data-priority=\"low\"] { background: var(--va-success); }\n\n.va-board__meta { font-size: 11px; color: var(--va-muted); flex: 1; }\n\n.va-board__assignee {\n  width: 20px;\n  height: 20px;\n  border-radius: 50%;\n  background: var(--va-accent-soft);\n  color: var(--va-accent);\n  font-size: 10.5px;\n  font-weight: 700;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .va-board__card { transition: none; }\n}\n</style>\n"
    },
    {
      "path": "components/ui/task-board/types.ts",
      "type": "registry:ui",
      "target": "components/ui/task-board/types.ts",
      "content": "/** VaTaskBoard 的类型定义 */\n\nexport interface BoardColumn {\n  id: string;\n  title: string;\n  /** 列头徽标文案（如计数），缺省自动为列内任务数 */\n  hint?: string;\n}\n\nexport type TaskPriority = \"low\" | \"medium\" | \"high\";\n\nexport interface BoardTask {\n  id: string;\n  columnId: string;\n  title: string;\n  assignee?: string;\n  priority?: TaskPriority;\n  /** 截止/耗时等角标文案 */\n  meta?: string;\n}\n\nexport interface TaskBoardProps {\n  columns: BoardColumn[];\n  tasks: BoardTask[];\n  /** 受控选中任务 id */\n  selected?: string;\n  defaultSelected?: string;\n}\n\nexport interface TaskBoardEvents {\n  \"update:selected\": [id: string | undefined];\n  /** 点击卡片（携带任务） */\n  open: [task: BoardTask];\n}\n"
    }
  ]
}
