# ============================================================
# @vuagent/server 环境变量模板
#
# ⚠️ 本仓库不自动加载 .env 文件（无 dotenv 依赖）：
#    以下变量需以 shell 环境注入，例如：
#      export REDIS_URL=redis://127.0.0.1:6379
#      pnpm --filter @vuagent/server start
#    或由部署平台（docker -e / k8s env / pm2）注入。
#    完整语义见 packages/server/README.md「启动与部署」与「安全模型」。
# ============================================================

# ---------- 运行 ----------
# HTTP 监听端口（缺省 6880）
#PORT=6880
# HTTP 监听网卡（缺省 127.0.0.1 仅本机可达；对外部署需显式设置，如 0.0.0.0 或内网 IP）
#VUAGENT_HOST=
# SQLite 数据库文件路径（缺省 .vuagent/harness.db）
#DB_PATH=.vuagent/harness.db
# 本副本实例标识：Redis 租约的归属与清扫目标（缺省 os.hostname()，建议 pod 名）
#VUAGENT_INSTANCE_ID=

# ---------- 模型凭据（兜底：未在设置页登记任何模型档案时使用） ----------
#OPENAI_API_KEY=
#OPENAI_BASE_URL=https://api.openai.com/v1
#DEFAULT_MODEL=gpt-4o
# Anthropic 原生档案（provider=anthropic 且未设 baseUrl）的密钥兜底
#ANTHROPIC_API_KEY=

# ---------- Redis 分布式形态（可选） ----------
# 设置后：存储实体跨副本共享 + 同会话跨副本轮次租约（互斥/心跳防双主/启动清扫）
# 部署前先验证：pnpm --filter @vuagent/server verify:redis "$REDIS_URL"
#REDIS_URL=redis://127.0.0.1:6379

# ---------- 可观测（可选） ----------
# 设置后运维事件以 OTLP Logs JSON 推送到该端点（fail-open）
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/logs
# 设置后按 OTLP Traces JSON 推送 span 树（turn→step→tool_call；默认关；入站 traceparent 透传）
#OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
# 日志可见度门控：error/warn/info/debug（缺省 info；未设或非法值回落 info）
#LOG_LEVEL=info

# ---------- 安全模型（缺省 = 本地单用户零配置即安全） ----------
# Bearer 令牌：设置后 /api/* 与 /metrics 全部要求 Authorization: Bearer <token>；
# 令牌即本机执行权，请勿提交仓库或打进日志。前端注入方式见 server README 安全模型一节。
#VUAGENT_TOKEN=
# 绑定闸门豁免：对外绑定（VUAGENT_HOST 非回环）且未配置 VUAGENT_TOKEN 时默认拒绝启动；
# 仅限隔离网络联调时显式豁免（把 bash 执行权暴露给网络可达者，自担风险）
#VUAGENT_ALLOW_UNSAFE_NETWORK=1
# 工作区 rootPath 前缀白名单（逗号分隔绝对路径）：配置后创建工作区只能落在允许目录内
#VUAGENT_WORKSPACE_ROOTS=
# bash_run 子进程环境策略：safe（白名单，默认）/ strict（最小集）/ inherit（完整继承，密钥可被模型读出）
#VUAGENT_BASH_ENV_POLICY=
# HTTP 限流（每分钟每 IP+令牌指纹）：0 = 关闭对应作用域；探测类端点（discover/verify）独立更严
#VUAGENT_RATE_LIMIT_GLOBAL=240
#VUAGENT_RATE_LIMIT_PROBE=12
# 反代部署显式开关：设 1 后限流的客户端 IP 取 X-Forwarded-For【末段】（最近一跳
# 可信代理追加的真实来源，伪造前段不生效）；默认 false 一律取 socket 地址（直连
# 形态 XFF 可伪造，采信即限流可被换头绕过）
#VUAGENT_TRUST_PROXY=0
# 追加放行的 CORS Origin（逗号分隔；仅限你完全控制的受控内网）
#VUAGENT_CORS_ORIGINS=
# 显式开启「自备供应商」：放行前端携带 providerConfig/baseUrl（SSRF 与凭据外带面扩大，慎开）
#VUAGENT_ALLOW_BYO_PROVIDER=1
# 放行 web_fetch 访问私网/本机地址（SSRF 面扩大，仅内网联调时开）
#VUAGENT_ALLOW_PRIVATE_FETCH=1
