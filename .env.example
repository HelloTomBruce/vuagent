# ============================================================
# @vuagent/server 环境变量模板
#
# ⚠️ 本仓库不自动加载 .env 文件（无 dotenv 依赖）：
#    以下变量需以 shell 环境注入，例如：
#      export REDIS_URL=redis://127.0.0.1:6379
#      pnpm --filter @vuagent/server start
#    或由部署平台（docker -e / k8s env / pm2）注入。
#    完整语义见 packages/server/README.md「启动与部署」与「安全模型」。
# ============================================================

# ---------- 运行 ----------
# HTTP 监听端口（缺省 3001）
#PORT=3001
# SQLite 数据库文件路径（缺省 .vuagent/harness.db）
#DB_PATH=.vuagent/harness.db
# 本副本实例标识：Redis 租约的归属与清扫目标（缺省 os.hostname()，建议 pod 名）
#VUAGENT_INSTANCE_ID=

# ---------- 模型凭据（兜底：未在设置页登记任何模型档案时使用） ----------
#OPENAI_API_KEY=
#OPENAI_BASE_URL=https://api.openai.com/v1
#DEFAULT_MODEL=gpt-4o
# Anthropic 原生档案（provider=anthropic 且未设 baseUrl）的密钥兜底
#ANTHROPIC_API_KEY=

# ---------- Redis 分布式形态（可选） ----------
# 设置后：存储实体跨副本共享 + 同会话跨副本轮次租约（互斥/心跳防双主/启动清扫）
# 部署前先验证：pnpm --filter @vuagent/server verify:redis "$REDIS_URL"
#REDIS_URL=redis://127.0.0.1:6379

# ---------- 可观测（可选） ----------
# 设置后运维事件以 OTLP Logs JSON 推送到该端点（fail-open）
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/logs

# ---------- 安全模型（缺省 = 本地单用户零配置即安全） ----------
# Bearer 令牌：设置后 /api/* 与 /metrics 全部要求 Authorization: Bearer <token>；
# 令牌即本机执行权，请勿提交仓库或打进日志。前端注入方式见 server README 安全模型一节。
#VUAGENT_TOKEN=
# 追加放行的 CORS Origin（逗号分隔；仅限你完全控制的受控内网）
#VUAGENT_CORS_ORIGINS=
# 显式开启「自备供应商」：放行前端携带 providerConfig/baseUrl（SSRF 与凭据外带面扩大，慎开）
#VUAGENT_ALLOW_BYO_PROVIDER=1
# 放行 web_fetch 访问私网/本机地址（SSRF 面扩大，仅内网联调时开）
#VUAGENT_ALLOW_PRIVATE_FETCH=1
