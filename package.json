{
  "name": "vuagent-monorepo",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "build": "pnpm --filter @vuagent/protocol build && pnpm --filter @vuagent/server build && pnpm --filter @vuagent/ui build && pnpm --filter @vuagent/playground build",
    "prepublish:check": "pnpm typecheck && pnpm test && pnpm build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @vuagent/protocol test && pnpm --filter @vuagent/ui test && pnpm --filter @vuagent/server test && pnpm --filter @vuagent/playground test && pnpm --filter @vuagent/cli test",
    "protocol:sync-check": "node scripts/check-protocol-sync.mjs",
    "server:dev": "pnpm --filter @vuagent/server dev",
    "registry": "node scripts/build-registry.mjs",
    "registry:check": "pnpm tokens:check && node scripts/check-registry.mjs",
    "tokens:check": "node scripts/check-tokens.mjs",
    "llms": "node scripts/build-llms.mjs",
    "docs:dev": "pnpm --filter @vuagent/docs dev",
    "docs:build": "pnpm --filter @vuagent/docs build",
    "dev": "pnpm --filter @vuagent/playground dev",
    "console": "concurrently -k -n server,web -c yellow,cyan \"pnpm --filter @vuagent/server dev\" \"pnpm --filter @vuagent/playground dev\"",
    "example:server": "pnpm --filter @examples/server dev",
    "example:gallery": "concurrently -k -n server,client -c yellow,green \"pnpm --filter @examples/server dev\" \"pnpm --filter @examples/agent-gallery dev\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HelloTomBruce/vuagent.git"
  },
  "homepage": "https://hellotombruce.github.io/vuagent",
  "bugs": {
    "url": "https://github.com/HelloTomBruce/vuagent/issues"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "concurrently": "^9.1.2"
  }
}
