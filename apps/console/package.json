{
  "name": "@vuagent/console",
  "version": "0.7.0",
  "description": "Vuagent Console — the web console for a Vuagent harness server (static bundle consumed by @vuagent/cli)",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    "./dist/index.html": "./dist/index.html",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HelloTomBruce/vuagent.git",
    "directory": "apps/console"
  },
  "homepage": "https://hellotombruce.github.io/vuagent",
  "bugs": {
    "url": "https://github.com/HelloTomBruce/vuagent/issues"
  },
  "keywords": [
